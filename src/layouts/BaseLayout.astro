---
import '../styles/global.css';
import '../styles/phosphor-subset.css';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarometerDownloadBox from '../components/BarometerDownloadBox.astro';
import ContactFormHandler from '../components/ContactFormHandler.astro';
import CookieConsent from '../components/CookieConsent.astro';

type OgType = 'website' | 'article';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: OgType;
  articlePublishedTime?: Date | string;
  articleModifiedTime?: Date | string;
  articleAuthor?: string;
  articleSection?: string;
  extraStylesheets?: string[];
  schema?: object | (object | null)[]; // JSON-LD de la page
}
const {
  title,
  description,
  lang = 'fr',
  ogImage,
  canonical,
  noindex = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  extraStylesheets = [],
  schema,
} = Astro.props;
const fontStylesheet = 'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap';
const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const showBarometerBox =
  normalizedPath === '/expertises' ||
  normalizedPath.startsWith('/expertises/') ||
  normalizedPath === '/en/expertises' ||
  normalizedPath.startsWith('/en/expertises/') ||
  normalizedPath === '/secteurs' ||
  normalizedPath.startsWith('/secteurs/') ||
  normalizedPath === '/en/sectors' ||
  normalizedPath.startsWith('/en/sectors/');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PZMG94FV');
    </script>
    <!-- End Google Tag Manager -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline define:vars={{ fontStylesheet }}>
      (() => {
        const loadFonts = () => {
          if (document.querySelector('link[data-richmedia-fonts]')) return;
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = fontStylesheet;
          link.dataset.richmediaFonts = 'true';
          document.head.appendChild(link);
        };

        const scheduleFontLoad = () => {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadFonts, { timeout: 1800 });
          } else {
            setTimeout(loadFonts, 900);
          }
        };

        if (document.readyState === 'complete') {
          scheduleFontLoad();
        } else {
          window.addEventListener('load', scheduleFontLoad, { once: true });
        }
      })();
    </script>
    <noscript><link href={fontStylesheet} rel="stylesheet" /></noscript>
    {extraStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      lang={lang}
      noindex={noindex}
      ogType={ogType}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
      articleSection={articleSection}
    />
    {schema && <JsonLd schema={schema} />}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PZMG94FV"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot />
    </main>
    {showBarometerBox && <BarometerDownloadBox lang={lang} />}
    <Footer />
    <ContactFormHandler />
    <CookieConsent lang={lang} />
    <script is:inline>
      (() => {
        const hydrateEmailLinks = () => {
          document.querySelectorAll('[data-email-link]').forEach((link) => {
            const user = link.getAttribute('data-email-user');
            const domain = link.getAttribute('data-email-domain');
            if (!user || !domain) return;

            const email = `${user}@${domain}`;
            link.setAttribute('href', `mailto:${email}`);
            link.querySelectorAll('[data-email-address]').forEach((node) => {
              node.textContent = email;
            });
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', hydrateEmailLinks, { once: true });
        } else {
          hydrateEmailLinks();
        }
      })();
    </script>
  </body>
</html>
