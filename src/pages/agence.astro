---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localBusiness, breadcrumbs } from '../lib/schema';
import { SITE } from '../consts';

const schema = [localBusiness(), breadcrumbs([
  { name: 'Accueil', url: SITE.url },
  { name: "L'agence", url: `${SITE.url}/agence` },
])];

const metrics = [
  { icon: 'ph ph-chart-line-up', value: '+156', label: 'projets réalisés', text: 'pour des marques locales, nationales et internationales.' },
  { icon: 'ph ph-users-three', value: '+117', label: 'clients accompagnés', text: 'dans des secteurs exigeants.' },
  { icon: 'ph ph-buildings', value: '4', label: 'bureaux', text: 'Casablanca, Dubaï, Montréal et Strasbourg.' },
];

const approach = [
  {
    number: '01',
    icon: 'ph ph-target',
    title: 'Stratégie claire',
    text: 'Nous cadrons les objectifs, les audiences, les messages, les canaux et les indicateurs pour aligner vision, budget et exécution.',
  },
  {
    number: '02',
    icon: 'ph ph-note-pencil',
    title: 'Création utile',
    text: 'Nous concevons des contenus, interfaces et expériences qui attirent l’attention, rassurent les publics et facilitent la conversion.',
  },
  {
    number: '03',
    icon: 'ph ph-chart-line-up',
    title: 'Pilotage continu',
    text: 'Nous activons, mesurons et optimisons en continu les campagnes pour améliorer la performance, le coût d’acquisition et le ROI.',
  },
];

const values = [
  { icon: 'ph ph-users-three', title: "Esprit d'équipe", text: 'Des profils complémentaires réunis autour du résultat client.' },
  { icon: 'ph ph-lightbulb', title: 'Exigence & qualité', text: 'Une attention forte portée au détail, à la cohérence et à la fiabilité.' },
  { icon: 'ph ph-heart', title: 'Culture du résultat', text: 'Des idées créatives pensées pour produire un impact mesurable.' },
];

const milestones = [
  { year: '2012', title: 'Création de Richmedia à Casablanca', text: 'L’agence naît avec une ambition simple : relier stratégie digitale, création et performance.' },
  { year: '2015', title: 'Extension des expertises', text: 'Média, social media, contenu, web et dispositifs orientés acquisition deviennent des piliers de l’agence.' },
  { year: '2018', title: 'Ouverture internationale', text: 'Richmedia accompagne des clients au Maroc et à l’international, avec une présence à Dubaï.' },
  { year: '2021', title: 'Montréal et Strasbourg', text: 'L’agence se rapproche de nouveaux marchés et de partenaires créatifs, média et technologiques.' },
  { year: '2024', title: 'Data, IA & automatisation', text: 'Les parcours WhatsApp, CRM, SEO/GEO et IA renforcent la mesure et l’efficacité des campagnes.' },
];

const businessLinks = [
  {
    href: '/expertises/media-performance',
    label: 'Performance digitale',
    title: 'Agence performance digitale Maroc',
    text: 'Acquisition, tracking, CRM, Social Ads, Google Ads et reporting pour relier budgets et croissance.',
  },
  {
    href: '/insights/cout-campagne-google-ads-maroc',
    label: 'Budget Google Ads',
    title: 'Prix campagne Google Ads Maroc',
    text: 'Comprendre budget média, honoraires, concurrence, landing page et coût par lead.',
  },
  {
    href: '/expertises/referencement-seo',
    label: 'SEO / GEO',
    title: 'Agence SEO Maroc',
    text: 'Audit technique, contenus, maillage, SEO local, preuves et visibilité dans les moteurs IA.',
  },
  {
    href: '/expertises/achat-media',
    label: 'Paid social',
    title: 'Campagnes paid social',
    text: 'Campagnes Meta, Instagram, TikTok et LinkedIn pilotées par la donnée et la création social-first.',
  },
  {
    href: '/secteurs',
    label: 'Secteurs',
    title: 'Cas clients, chiffres, preuves et FAQ',
    text: 'Des pages sectorielles pour relier les leviers digitaux aux enjeux éducation, retail, auto, FMCG et plus.',
  },
];

const references = [
  { name: 'UIR', src: '/assets/richmedia-home/logos/references/uir.jpg' },
  { name: 'Amana', src: '/assets/richmedia-home/logos/references/amana.jpg' },
  { name: 'Don Simon', src: '/assets/richmedia-home/logos/references/don-simon.jpg' },
  { name: 'Terroir du Maroc', src: '/assets/richmedia-home/logos/references/terroir-du-maroc.jpg' },
  { name: 'Electroplanet', src: '/assets/richmedia-home/logos/references/electroplanet.jpg' },
  { name: 'KITEA', src: '/assets/richmedia-home/logos/references/kitea.jpg' },
  { name: 'Carrefour Market', src: '/assets/richmedia-home/logos/references/carrefour-market.jpg' },
  { name: 'Asswak Assalam', src: '/assets/richmedia-home/logos/references/asswak-assalam.jpg' },
  { name: 'Lesieur Cristal', src: '/assets/richmedia-home/logos/references/lesieur-cristal.jpg' },
  { name: 'Maroc Telecom', src: '/assets/richmedia-home/logos/references/maroc-telecom.jpg' },
  { name: 'Prestigia', src: '/assets/richmedia-home/logos/campaigns/prestigia.jpg' },
  { name: 'Tramway Rabat-Salé', src: '/assets/richmedia-home/logos/campaigns/tramway-rabat.jpg' },
  { name: 'TBS Education', src: '/assets/richmedia-home/logos/campaigns/tbs-education.jpg' },
  { name: 'CMR', src: '/assets/richmedia-home/logos/campaigns/cmr.jpg' },
  { name: 'Moul Pounj', src: '/assets/richmedia-home/logos/campaigns/moul-pounj.jpg' },
  { name: 'Ryad Al Andalous', src: '/assets/richmedia-home/logos/campaigns/ryad-al-andalous.jpg' },
  { name: 'Rabat Riviera', src: '/assets/richmedia-home/logos/campaigns/rabat-riviera.jpg' },
  { name: 'BED', src: '/assets/richmedia-home/logos/campaigns/beed.jpg' },
];

const referenceLoop = [...references, ...references];
---

<BaseLayout
  title="Agence digitale à Casablanca | Richmedia"
  description="Découvrez Richmedia, agence digitale basée à Casablanca : stratégie, création, média, SEO/GEO, web, CRM et IA pour les marques au Maroc."
  canonical={`${SITE.url}/agence`}
  schema={schema}
>
  <article class="agency-page">
    <section class="agency-hero" aria-labelledby="agency-title">
      <div class="agency-hero-copy">
        <span class="section-kicker">À propos de Richmedia</span>
        <h1 id="agency-title">
          L’agence digitale qui transforme les idées en <strong>croissance mesurable.</strong>
        </h1>
        <p>
          Depuis Casablanca, Richmedia aide les marques, institutions et réseaux à grandir au Maroc et à
          l’international grâce à la stratégie digitale, au média, au web, au SEO/GEO et à l’automation.
        </p>
        <a class="agency-play-link" href="/realisations">
          <span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></span>
          Découvrir Richmedia en 90s
        </a>
      </div>

      <figure class="agency-hero-visual">
        <img
          src="/assets/richmedia-agence/agence-hero-office.webp"
          alt="Studio Richmedia, agence digitale à Casablanca"
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="agency-experience-card">
          <strong>12</strong>
          <span>ans d’expérience au service de la croissance</span>
        </figcaption>
        <div class="agency-caption-card">Stratégie. Création. Médias. Web. Automation.</div>
      </figure>
    </section>

    <section class="agency-metrics" aria-label="Chiffres clés Richmedia">
      <div class="metrics-grid">
        {metrics.map((metric) => (
          <article>
            <i class={metric.icon} aria-hidden="true"></i>
            <div>
              <strong data-count-value={metric.value}>{metric.value}</strong>
              <span>{metric.label}</span>
              <p>{metric.text}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="metrics-map" aria-hidden="true">
        <img src="/assets/richmedia-home/world-map-natural-earth.svg" alt="" loading="lazy" decoding="async" width="1000" height="520" />
        <span class="map-arc arc-casa-montreal"></span>
        <span class="map-arc arc-casa-strasbourg"></span>
        <span class="map-arc arc-casa-dubai"></span>
        <span class="pin pin-casa"><b>Casablanca</b><small>Maroc</small></span>
        <span class="pin pin-dubai"><b>Dubaï</b><small>UAE</small></span>
        <span class="pin pin-montreal"><b>Montréal</b><small>Canada</small></span>
        <span class="pin pin-strasbourg"><b>Strasbourg</b><small>France</small></span>
      </div>
    </section>

    <section class="agency-approach" aria-labelledby="approach-title">
      <div class="section-intro">
        <span class="section-kicker">Notre approche</span>
        <h2 id="approach-title">Ce qui nous différencie.</h2>
        <p>
          Une méthode claire, des livrables utiles et un pilotage continu pour transformer vos objectifs marketing en
          résultats mesurables.
        </p>
      </div>
      <div class="approach-grid">
        {approach.map((item) => (
          <article>
            <i class={item.icon} aria-hidden="true"></i>
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="agency-business" aria-labelledby="agency-business-title">
      <div class="section-intro">
        <span class="section-kicker">Agence digitale Casablanca</span>
        <h2 id="agency-business-title">Les sujets business que nous relions.</h2>
        <p>
          Richmedia structure la visibilité et la conversion autour des requêtes qui portent une vraie intention :
          performance, SEO, social ads, budget média et preuves par secteur.
        </p>
      </div>
      <div class="business-grid">
        {businessLinks.map((item) => (
          <a href={item.href}>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </section>

    <section class="agency-studio" aria-labelledby="studio-title">
      <div class="studio-copy">
        <span class="section-kicker">Notre studio</span>
        <h2 id="studio-title">Des talents passionnés, au service de vos défis.</h2>
        <p>
          Stratèges, créatifs, développeurs, media buyers, social media managers, data analysts et profils IA
          collaborent pour créer des dispositifs digitaux adaptés à vos ambitions au Maroc, au Maghreb et à
          l’international.
        </p>
        <div class="value-grid">
          {values.map((value) => (
            <article>
              <i class={value.icon} aria-hidden="true"></i>
              <strong>{value.title}</strong>
              <p>{value.text}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="studio-media">
        <img class="studio-main" src="/assets/richmedia-agence/agence-studio-meeting.webp" alt="Équipe Richmedia en atelier stratégie digitale" width="1280" height="720" loading="lazy" decoding="async" />
        <img class="studio-small studio-small-top" src="/assets/richmedia-agence/agence-collaboration-small.webp" alt="Collaboration créative et digitale chez Richmedia" width="720" height="405" loading="lazy" decoding="async" />
        <img class="studio-small studio-small-bottom" src="/assets/richmedia-agence/agence-studio-meeting-small.webp" alt="Studio digital Richmedia et équipe projet" width="720" height="405" loading="lazy" decoding="async" />
        <a class="studio-floating" href="/equipe">
          Une culture de collaboration et d’impact.
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <section class="agency-history" aria-labelledby="history-title">
      <div class="section-intro">
        <span class="section-kicker">Notre histoire</span>
        <h2 id="history-title">Une trajectoire de croissance.</h2>
      </div>
      <ol class="history-timeline">
        {milestones.map((item, index) => (
          <li style={`--history-delay: ${index * 120}ms`}>
            <time>{item.year}</time>
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="agency-references" aria-labelledby="references-title">
      <span class="section-kicker">Ils nous font confiance</span>
      <h2 id="references-title">Des références solides au Maroc et à l’international.</h2>
      <div class="reference-strip" aria-label="Références Richmedia">
        <div class="reference-track">
          {referenceLoop.map((item, index) => (
            <figure aria-hidden={index >= references.length ? 'true' : 'false'}>
              <img src={item.src} alt={index >= references.length ? '' : `Logo ${item.name}`} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="agency-cta" aria-labelledby="agency-cta-title">
      <h2 id="agency-cta-title">Parlons de votre prochaine croissance digitale.</h2>
      <p>
        Un projet, une idée ou un défi ? Discutons de vos objectifs et construisons une stratégie digitale claire,
        créative et mesurable.
      </p>
      <a class="button button-primary" href="/contact">
        Discutons de votre projet
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </article>
</BaseLayout>

<script>
  const countValues = () => {
    const counters = document.querySelectorAll<HTMLElement>('[data-count-value]');
    const animate = (counter: HTMLElement) => {
      if (counter.dataset.counted === 'true') return;
      counter.dataset.counted = 'true';
      const raw = counter.dataset.countValue || counter.textContent || '';
      const prefix = raw.trim().startsWith('+') ? '+' : '';
      const target = Number(raw.replace(/[^\d]/g, ''));
      if (!Number.isFinite(target)) return;
      const duration = 1100;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        counter.textContent = `${prefix}${Math.round(target * eased)}`;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (!('IntersectionObserver' in window)) {
      counters.forEach(animate);
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        animate(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.35 });

    counters.forEach((counter) => observer.observe(counter));
  };

  countValues();
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .agency-page {
    --purple: #8c52ff;
    --purple-soft: #b985ff;
    --line: rgba(255, 255, 255, 0.13);
    --panel: rgba(10, 11, 20, 0.78);
    --muted: rgba(232, 237, 245, 0.72);
    width: min(100% - 3rem, 1320px);
    margin: 0 auto;
    padding: clamp(8rem, 9vw, 9.8rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .agency-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(520px, 1.14fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
    color: var(--purple-soft);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    display: inline-block;
    width: 1.55rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .agency-hero h1,
  .section-intro h2,
  .studio-copy h2,
  .agency-references h2,
  .agency-cta h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    letter-spacing: 0;
  }

  .agency-hero h1 {
    max-width: 36rem;
    font-size: clamp(3.15rem, 6.6vw, 5.8rem);
    line-height: 0.96;
  }

  .agency-hero h1 strong {
    color: var(--purple);
    font-weight: inherit;
  }

  .agency-hero-copy > p,
  .section-intro p,
  .studio-copy > p,
  .agency-cta p {
    color: var(--muted);
    line-height: 1.78;
  }

  .agency-hero-copy > p {
    max-width: 34rem;
    margin: 1.45rem 0 0;
    font-size: 1rem;
  }

  .agency-play-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    color: var(--purple-soft);
    font-weight: 800;
    text-decoration: none;
  }

  .agency-play-link span {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(185, 133, 255, 0.64);
    border-radius: 999px;
    background: rgba(124, 60, 255, 0.08);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .agency-play-link:hover span {
    box-shadow: 0 0 1.5rem rgba(124, 60, 255, 0.35);
    transform: scale(1.06);
  }

  .agency-hero-visual {
    position: relative;
    min-height: clamp(25rem, 44vw, 36rem);
    margin: 0;
  }

  .agency-hero-visual > img {
    position: absolute;
    inset: 4% 9% 8% 0;
    width: 74%;
    height: 78%;
    border: 1px solid var(--line);
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 1.6rem 5rem rgba(0, 0, 0, 0.4);
  }

  .agency-hero-visual::before {
    position: absolute;
    inset: 18% 18% 8% 6%;
    border: 1px solid rgba(140, 82, 255, 0.34);
    border-radius: 8px;
    background: rgba(124, 60, 255, 0.12);
    box-shadow: 0 0 3rem rgba(124, 60, 255, 0.18);
    content: "";
    transform: rotate(-31deg);
  }

  .agency-experience-card,
  .agency-caption-card {
    position: absolute;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(10, 10, 18, 0.72);
    backdrop-filter: blur(18px);
    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.34);
  }

  .agency-experience-card {
    right: 1.5rem;
    top: 24%;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(5.6rem, 0.72fr);
    gap: 0.9rem;
    align-items: end;
    width: min(16rem, calc(100% - 2rem));
    max-width: none;
    padding: 1.25rem;
  }

  .agency-experience-card strong {
    color: var(--purple);
    font-family: var(--font-display);
    font-size: clamp(4.4rem, 8vw, 7rem);
    line-height: 0.78;
  }

  .agency-experience-card span {
    color: #fff;
    min-width: 0;
    font-size: clamp(0.68rem, 1.05vw, 0.78rem);
    font-weight: 900;
    line-height: 1.18;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .agency-caption-card {
    left: 1rem;
    bottom: 17%;
    max-width: 15rem;
    padding: 1.25rem;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.65;
  }

  .agency-metrics {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: 2rem;
    align-items: center;
    margin-top: clamp(3rem, 5vw, 5.4rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.55rem 1.7rem;
    background: rgba(10, 11, 20, 0.64);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .metrics-grid article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 0 1.45rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .metrics-grid article:first-child {
    padding-left: 0;
  }

  .metrics-grid article:last-child {
    border-right: 0;
  }

  .metrics-grid i,
  .approach-grid i,
  .value-grid i {
    color: var(--purple-soft);
    font-size: 2.2rem;
  }

  .metrics-grid i {
    display: grid;
    width: 3.35rem;
    height: 3.35rem;
    place-items: center;
    border: 1px solid rgba(185, 133, 255, 0.26);
    border-radius: 8px;
    background: rgba(124, 60, 255, 0.12);
  }

  .metrics-grid strong {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 0.92;
  }

  .metrics-grid span {
    display: block;
    margin-top: 0.3rem;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .metrics-grid p {
    margin: 0.45rem 0 0;
    color: rgba(232, 237, 245, 0.62);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .metrics-map {
    position: relative;
    min-height: 12.2rem;
    overflow: hidden;
    border: 1px solid rgba(162, 104, 255, 0.18);
    border-radius: 8px;
    background:
      radial-gradient(circle at 49% 62%, rgba(124, 60, 255, 0.34), transparent 24%),
      radial-gradient(circle at 60% 45%, rgba(124, 60, 255, 0.18), transparent 30%),
      linear-gradient(180deg, rgba(12, 10, 24, 0.82), rgba(5, 7, 13, 0.94));
  }

  .metrics-map img {
    width: 100%;
    height: 100%;
    min-height: 12.2rem;
    object-fit: contain;
    opacity: 0.58;
    filter: invert(1) sepia(1) saturate(1.5) hue-rotate(210deg) brightness(0.72);
  }

  .pin {
    position: absolute;
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.88);
    background: var(--purple-soft);
    box-shadow: 0 0 1rem var(--purple), 0 0 0 0.55rem rgba(124, 60, 255, 0.18), 0 0 0 1.15rem rgba(124, 60, 255, 0.08);
  }

  .pin b,
  .pin small {
    position: absolute;
    left: 1.1rem;
    display: block;
    white-space: nowrap;
    text-shadow: 0 0.25rem 0.8rem rgba(0, 0, 0, 0.65);
  }

  .pin b {
    top: -0.4rem;
    color: #fff;
    font-size: 0.68rem;
    line-height: 1;
  }

  .pin small {
    top: 0.35rem;
    color: #b985ff;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .map-arc {
    position: absolute;
    height: 3.8rem;
    border: 1px solid rgba(169, 133, 255, 0.28);
    border-color: rgba(169, 133, 255, 0.3) transparent transparent transparent;
    border-radius: 50%;
    pointer-events: none;
  }

  .arc-casa-montreal {
    left: 28%;
