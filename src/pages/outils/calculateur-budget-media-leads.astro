---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BudgetLeadsCalculator from '../../components/BudgetLeadsCalculator.astro';
import { SITE } from '../../consts';
import { breadcrumbs, localBusiness, webApplicationSchema } from '../../lib/schema';

const pageUrl = `${SITE.url}/outils/calculateur-budget-media-leads/`;
const pageDescription =
  'Estimez le budget média ou le volume de leads attendu selon votre secteur et vos canaux, à partir des fourchettes observées par Richmedia.';

const schema = [
  localBusiness(),
  webApplicationSchema({
    id: 'calculator',
    name: 'Calculateur Budget Média & Leads',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'fr',
    featureList: [
      'Estimation du budget média',
      'Projection du volume de leads',
      'Simulation par secteur et canaux marketing',
    ],
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Outils & ressources', url: `${SITE.url}/outils` },
    { name: 'Calculateur Budget Média & Leads', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Calculateur Budget Média & Leads | Richmedia"
  description={pageDescription}
  canonical={pageUrl}
  schema={schema}
>
  <BudgetLeadsCalculator lang="fr" />
</BaseLayout>
