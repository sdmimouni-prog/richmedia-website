---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppCampaignEstimator from '../../components/WhatsAppCampaignEstimator.astro';
import { SITE } from '../../consts';
import { breadcrumbs, localBusiness, webApplicationSchema } from '../../lib/schema';

const pageUrl = `${SITE.url}/outils/estimateur-campagne-whatsapp/`;
const pageDescription =
  'Estimez le budget, le nombre de pushes, les lectures, clics et conversions potentielles de votre campagne WhatsApp avec Richmedia.';

const schema = [
  localBusiness(),
  webApplicationSchema({
    id: 'estimator',
    name: 'Estimateur Campagne WhatsApp',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'fr',
    featureList: [
      'Estimation du budget WhatsApp',
      'Estimation du nombre de pushes',
      'Projection des lectures, clics, réponses, conversions et opt-out',
    ],
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Outils & ressources', url: `${SITE.url}/outils` },
    { name: 'Estimateur Campagne WhatsApp', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Estimateur Campagne WhatsApp | Richmedia"
  description={pageDescription}
  canonical={pageUrl}
  schema={schema}
>
  <WhatsAppCampaignEstimator />
</BaseLayout>
