---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Faq from '../../components/Faq.astro';
import { articleSchema, breadcrumbs } from '../../lib/schema';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const url = `${SITE.url}/ressources/${entry.data.slug ?? entry.id}`;
const schema = [
  articleSchema({
    title: entry.data.title, description: entry.data.metaDescription, url,
    author: entry.data.auteur, datePublished: entry.data.datePublication, dateModified: entry.data.dateModification,
    image: entry.data.ogImage,
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Ressources', url: `${SITE.url}/ressources` },
    { name: entry.data.title, url },
  ]),
];
---
<BaseLayout title={entry.data.metaTitle ?? entry.data.title} description={entry.data.metaDescription} canonical={url} schema={schema}>
  <article>
    <h1>{entry.data.title}</h1>
    <QuickAnswer text={entry.data.quickAnswer} />
    <Content />
  </article>
  <Faq faq={entry.data.faq} />
</BaseLayout>
