---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime());
---
<BaseLayout title="Ressources — Blog marketing digital | Richmedia" description="Guides SEO, media, social et growth pour le marché marocain.">
  <h1>Ressources</h1>
  <ul>
    {articles.map((a) => (
      <li><a href={`/ressources/${a.data.slug ?? a.id}`}>{a.data.title}</a> — {a.data.categorie}</li>
    ))}
  </ul>
</BaseLayout>
