---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditLanding from '../components/AuditLanding.astro';
import { SITE } from '../consts';
import { breadcrumbs, localBusiness, serviceSchema } from '../lib/schema';

const pageDescription =
  'Réservez un audit digital 360 avec Richmedia : réseaux sociaux, site web, SEO, campagnes, conversion, data et e-réputation.';

const schema = [
  localBusiness(),
  serviceSchema({
    name: 'Audit digital 360',
    description: pageDescription,
    url: `${SITE.url}/reserver-un-audit`,
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Réserver un audit', url: `${SITE.url}/reserver-un-audit` },
  ]),
];
---
<BaseLayout
  title="Audit digital 360 au Maroc | Richmedia"
  description={pageDescription}
  canonical={`${SITE.url}/reserver-un-audit`}
  schema={schema}
>
  <AuditLanding lang="fr" />
</BaseLayout>
