---
import Faq from '../components/Faq.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS, SITE } from '../consts';
import { breadcrumbs, faqSchema, localBusiness, serviceSchema } from '../lib/schema';

const pagePath = '/agence-de-communication-maroc';
const pageUrl = `${SITE.url}${pagePath}`;
const title = 'Agence de communication au Maroc | Richmedia';
const description =
  'Richmedia est une agence de communication au Maroc spécialisée en stratégie, branding, social media, influence, media, performance, technologie, data et IA.';

const heroImages = [
  {
    src: '/assets/richmedia-realizations/prestigia-riad-al-andalous-acquisition-2026-triptych.webp',
    alt: 'Campagne Prestigia Riad Al Andalous au Maroc par Richmedia',
    width: 1894,
    height: 1074,
  },
  {
    src: '/assets/richmedia-home/campaign-wide-donsimon.webp',
    alt: 'Campagne Don Simon au Maroc par Richmedia',
    width: 1600,
    height: 900,
  },
  {
    src: '/assets/richmedia-home/campaign-wide-amana-tram.webp',
    alt: 'Campagne Amana Tramway par Richmedia',
    width: 1600,
    height: 900,
  },
];

const proofs = [
  { icon: 'ph ph-chart-line-up', value: '+156', label: 'projets réalisés', text: 'pour des marques locales, nationales et internationales.' },
  { icon: 'ph ph-users-three', value: '+117', label: 'clients accompagnés', text: 'dans des secteurs exigeants.' },
  { icon: 'ph ph-certificate', value: String(BUSINESS.accreditations.length), label: 'accréditations', text: 'Google, Meta, HubSpot, IAB, Semrush et Analytics.' },
];

const expertises = [
  {
    href: '/expertises/strategie-digitale',
    icon: 'ph ph-target',
    label: 'Stratégie & Branding',
    text: 'Positionnement, stratégie de marque, campagnes créatives, identité visuelle, brand content et production.',
  },
  {
    href: '/expertises/influence',
    icon: 'ph ph-users-three',
    label: 'Social, Influence & UGC',
    text: 'Social media, community management, contenu, influence, UGC, social listening et e-réputation.',
  },
  {
    href: '/expertises/media-performance',
    icon: 'ph ph-chart-line-up',
    label: 'Media & Performance',
    text: 'Meta Ads, Google Ads, TikTok Ads, génération de leads, acquisition, programmatique et optimisation du ROI.',
  },
  {
    href: '/expertises/ia-automation',
    icon: 'ph ph-cpu',
    label: 'Tech, IA & Expérience',
    text: 'Sites web, UX/UI, CRM, WhatsApp Business, chatbots, marketing automation, data et intelligence artificielle.',
  },
];

const coverage = ['Casablanca', 'Rabat', 'Marrakech', 'Tanger', 'Agadir', 'Fès', 'Meknès', 'Oujda'];

const nationalLevers = [
  'campagnes média nationales',
  'géotargeting',
  'influence locale',
  'drive-to-store',
  'génération de leads',
  'contenus & social media',
];

const whyRichmedia = [
  {
    icon: 'ph ph-sparkle',
    title: 'Créativité + performance',
    text: 'La création doit servir des objectifs business mesurables.',
  },
  {
    icon: 'ph ph-circles-three-plus',
    title: 'Une équipe intégrée',
    text: 'Stratégie, création, media, influence, technologie et data travaillent ensemble.',
  },
  {
    icon: 'ph ph-map-pin',
    title: 'Expertise du marché marocain',
    text: 'Compréhension des audiences, usages, plateformes et comportements locaux.',
  },
  {
    icon: 'ph ph-brain',
    title: 'Data & technologie',
    text: "Utilisation de la data, de l'automatisation et de l'IA pour améliorer la performance.",
  },
];

const activation = [
  { title: 'Villes & zones', text: 'Adapter les messages, budgets et formats selon les zones prioritaires.' },
  { title: 'Audiences', text: 'Différencier les segments, intentions, langues, plateformes et comportements.' },
  { title: 'Points de vente', text: 'Relier visibilité digitale, trafic qualifié, WhatsApp et actions terrain.' },
  { title: 'Objectifs business', text: 'Piloter notoriété, leads, conversion, engagement ou fidélisation.' },
];

const works = [
  {
    href: '/realisations/prestigia-riad-al-andalous-acquisition-2026',
    image: '/assets/richmedia-realizations/prestigia-riad-al-andalous-acquisition-2026-triptych.webp',
    width: 1894,
    height: 1074,
    category: 'Immobilier',
    client: 'Prestigia',
    title: 'Riad Al Andalous',
  },
  {
    href: '/realisations/don-simon-back-to-school-2025',
    image: '/assets/richmedia-home/campaign-wide-donsimon.webp',
    width: 1600,
    height: 900,
    category: 'FMCG',
    client: 'Don Simon',
    title: 'Back to School',
  },
  {
    href: '/realisations/maserati-levante-whatsapp-leads-2025',
    image: '/assets/richmedia-realizations/maserati-levante-push-whatsapp.webp',
    width: 960,
    height: 1200,
    category: 'Automobile',
    client: 'Maserati',
    title: 'Levante WhatsApp leads',
  },
  {
    href: '/realisations/amana-tramway-phygital-2022',
    image: '/assets/richmedia-home/campaign-wide-amana-tram.webp',
    width: 1600,
    height: 900,
    category: 'Mobilité',
    client: 'Amana / Tramway',
    title: 'Activation phygitale',
  },
];

const sectors = [
  { href: '/secteurs/immobilier', label: 'Immobilier' },
  { href: '/secteurs/education', label: 'Éducation' },
  { href: '/secteurs/automobile', label: 'Automobile' },
  { href: '/secteurs/retail-ecommerce', label: 'Retail & e-commerce' },
  { href: '/secteurs/fmcg', label: 'FMCG' },
  { href: '/secteurs/institutionnel', label: 'Institutionnel' },
];

const process = [
  { number: '01', title: 'Comprendre', text: 'Objectifs, marché, audiences, concurrence.' },
  { number: '02', title: 'Concevoir', text: 'Stratégie, concept, contenus, parcours.' },
  { number: '03', title: 'Déployer', text: 'Media, social, influence, web et activations.' },
  { number: '04', title: 'Mesurer & optimiser', text: 'Data, reporting, tests et optimisation.' },
];

const faq = [
  {
    question: 'Quels services propose une agence de communication au Maroc ?',
    answer:
      'Une agence accompagne la stratégie, le branding, la création, le social media, l’influence, l’achat média, le web, la data, l’automation et la mesure des performances.',
  },
  {
    question: 'Comment choisir une agence de communication au Maroc ?',
    answer:
      'Il faut évaluer les réalisations, la méthode, la connaissance du marché, la qualité de l’équipe et la capacité à relier création, média et résultats business.',
  },
  {
    question: 'Quelle est la différence entre une agence de communication et une agence digitale ?',
    answer:
      'Une agence de communication travaille la marque, les messages et les campagnes. Une agence digitale ajoute les leviers web, media, CRM, data, automation et performance en ligne.',
  },
  {
    question: 'Richmedia accompagne-t-elle des marques dans tout le Maroc ?',
    answer:
      'Oui. Richmedia conçoit et déploie des dispositifs digitaux nationaux, multi-villes ou géolocalisés selon les audiences, les zones et les objectifs commerciaux.',
  },
  {
    question: 'Richmedia travaille-t-elle avec des marques internationales ?',
    answer:
      'Oui. Richmedia accompagne des marques marocaines et internationales qui souhaitent se développer au Maroc avec une approche locale, créative et mesurable.',
  },
];

const schema = [
  { ...localBusiness(), url: pageUrl, description, inLanguage: 'fr' },
  serviceSchema({ name: 'Agence de communication au Maroc', description, url: pageUrl }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: "L'agence", url: `${SITE.url}/agence` },
    { name: 'Agence de communication au Maroc', url: pageUrl },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage="/assets/richmedia-realizations/prestigia-riad-al-andalous-acquisition-2026-triptych.webp"
  schema={schema}
>
  <article class="national-page">
    <section class="national-hero" aria-labelledby="national-title">
      <div class="national-hero-copy">
        <span class="section-kicker">Marché marocain, croissance mesurable</span>
        <h1 id="national-title">Agence de communication au Maroc</h1>
        <p>
          Richmedia accompagne les marques marocaines et internationales dans leur stratégie de communication, leur
          acquisition digitale et leur croissance sur le marché marocain.
        </p>
        <strong class="hero-signature">Stratégie · Création · Social Media · Influence · Media · Tech & IA</strong>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Parler à un expert
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir nos réalisations
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-gallery" aria-label="Réalisations Richmedia au Maroc">
        {heroImages.map((image, index) => (
          <figure class:list={['hero-card', index === 0 && 'hero-card-main']}>
            <img
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={index === 0 ? 'high' : 'low'}
              sizes="(max-width: 760px) 88vw, (max-width: 1100px) 42vw, 360px"
            />
          </figure>
        ))}
      </div>
    </section>

    <section class="proof-section" aria-labelledby="positioning-title">
      <div class="section-intro">
        <span class="section-kicker">Positionnement</span>
        <h2 id="positioning-title">Une agence pensée pour le marché marocain</h2>
        <p>
          Richmedia est une agence de communication et de marketing digital basée au Maroc. Nous accompagnons
          entreprises, institutions et marques dans la conception et le déploiement de stratégies intégrées combinant
          conseil, création, social media, influence, media, technologie et data. Découvrez aussi <a href="/agence">l’agence Richmedia</a> et notre guide pour
          <a href="/insights/comment-choisir-agence-communication">choisir une agence de communication</a>.
        </p>
      </div>
      <div class="metrics-grid" aria-label="Preuves Richmedia">
        {proofs.map((proof) => (
          <article>
            <i class={proof.icon} aria-hidden="true"></i>
            <strong>{proof.value}</strong>
            <span>{proof.label}</span>
            <p>{proof.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="expertise-section" aria-labelledby="expertise-title">
      <div class="section-intro compact">
        <span class="section-kicker">Expertises</span>
        <h2 id="expertise-title">Une agence. Plusieurs expertises pour accélérer votre croissance.</h2>
      </div>
      <div class="expertise-grid">
        {expertises.map((expertise) => (
          <a class="expertise-card" href={expertise.href}>
            <i class={expertise.icon} aria-hidden="true"></i>
            <h3>{expertise.label}</h3>
            <p>{expertise.text}</p>
            <span>Découvrir <i class="ph ph-arrow-up-right" aria-hidden="true"></i></span>
          </a>
        ))}
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="market-title">
      <div>
        <span class="section-kicker">Lecture du marché</span>
        <h2 id="market-title">Comprendre le Maroc pour mieux communiquer</h2>
      </div>
      <p>
        Le Maroc est un marché culturellement riche, multilingue et mobile-first, où les comportements varient selon les
        audiences, les villes, les usages et les moments de consommation. Les marques doivent composer avec des parcours
        hybrides : découverte sur les réseaux sociaux, influence des créateurs, recherche d’avis, conversations WhatsApp,
        visites en magasin et décisions souvent nourries par la proximité. Une stratégie efficace ne peut donc pas se
        limiter à adapter un message général. Elle doit comprendre les codes locaux, choisir les bons canaux, produire des
        contenus crédibles et mesurer ce qui génère réellement de l’attention, de la confiance et de la conversion.
        Richmedia combine connaissance locale, créativité, technologie, data et performance pour construire des campagnes
        utiles aux marques comme aux audiences.
      </p>
    </section>

    <section class="coverage-section" aria-labelledby="coverage-title">
      <div class="section-intro">
        <span class="section-kicker">Portée nationale</span>
        <h2 id="coverage-title">Une connaissance locale. Une portée nationale.</h2>
        <p>
          Richmedia conçoit des dispositifs capables de vivre à l’échelle du pays, puis de s’adapter aux villes, aux
          régions, aux points de vente et aux communautés qui comptent pour chaque marque.
        </p>
      </div>
      <div class="coverage-panel">
        <div class="city-pills" aria-label="Exemples de villes couvertes">
          {coverage.map((city) => <span>{city}</span>)}
        </div>
        <div class="lever-grid">
          {nationalLevers.map((lever) => <span>{lever}</span>)}
        </div>
      </div>
    </section>

    <section class="why-section" aria-labelledby="why-title">
      <div class="section-intro">
        <span class="section-kicker">Pourquoi Richmedia</span>
        <h2 id="why-title">Plus qu'une agence de communication. Un partenaire de croissance.</h2>
      </div>
      <div class="why-grid">
        {whyRichmedia.map((item) => (
          <article>
            <i class={item.icon} aria-hidden="true"></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="activation-section" aria-labelledby="activation-title">
      <div class="section-intro">
        <span class="section-kicker">Activation</span>
        <h2 id="activation-title">De la stratégie nationale à l'activation locale</h2>
        <p>
          Une stratégie nationale gagne en efficacité lorsqu’elle reste adaptable. Richmedia relie le cadrage central aux
          réalités terrain : villes, zones, audiences, points de vente, communautés et objectifs business.
        </p>
      </div>
      <div class="activation-grid">
        {activation.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="work-section" aria-labelledby="work-title">
      <div class="section-intro compact">
        <span class="section-kicker">Réalisations</span>
        <h2 id="work-title">Des campagnes qui parlent mieux que nous</h2>
      </div>
      <div class="work-grid">
        {works.map((work) => (
          <a class="work-card" href={work.href} aria-label={`Voir la réalisation ${work.client}`}>
            <img
              src={work.image}
              alt={`Campagne ${work.client} — ${work.title}`}
              width={work.width}
              height={work.height}
              loading="lazy"
              decoding="async"
              sizes="(max-width: 760px) 92vw, (max-width: 1100px) 45vw, 25vw"
            />
            <span>{work.category}</span>
            <div>
              <strong>{work.client}</strong>
              <small>{work.title}</small>
            </div>
          </a>
        ))}
      </div>
      <a class="text-link" href="/realisations">
        Voir toutes les réalisations
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
    </section>

    <section class="sectors-section" aria-labelledby="sectors-title">
      <div class="section-intro compact">
        <span class="section-kicker">Secteurs</span>
        <h2 id="sectors-title">Une expérience multi-sectorielle</h2>
      </div>
      <div class="sector-grid">
        {sectors.map((sector) => (
          <a href={sector.href}>{sector.label}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        ))}
      </div>
    </section>

    <section class="method-section" aria-labelledby="method-title">
      <div class="section-intro compact">
        <span class="section-kicker">Méthode</span>
        <h2 id="method-title">De la stratégie aux résultats</h2>
      </div>
      <ol class="method-grid">
        {process.map((step) => (
          <li>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="faq-section">
      <Faq faq={faq} title="Questions fréquentes sur les agences de communication au Maroc" emitSchema={false} />
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div>
        <h2 id="final-cta-title">Vous avez un projet de communication au Maroc ?</h2>
        <p>Parlons de vos objectifs, de votre marché et des résultats que vous souhaitez atteindre.</p>
      </div>
      <a class="button button-primary" href="/contact">
        Parler à un expert
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </article>
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .national-page {
    --purple: #8c52ff;
    --purple-soft: #b985ff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(232, 237, 245, 0.72);
    width: min(100% - 3rem, 1320px);
    margin: 0 auto;
    padding: clamp(8rem, 9vw, 9.8rem) 0 clamp(3rem, 6vw, 5rem);
    color: #fff;
  }

  .national-hero,
  .proof-section,
  .coverage-section,
  .why-section,
  .activation-section,
  .editorial-section,
  .final-cta {
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 12% 0%, rgba(140, 82, 255, 0.25), transparent 28rem),
      linear-gradient(145deg, rgba(13, 14, 23, 0.9), rgba(7, 8, 13, 0.92));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .national-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    min-height: clamp(34rem, 54vw, 45rem);
    padding: clamp(1.2rem, 4vw, 3.6rem);
    overflow: hidden;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
    color: var(--purple-soft);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    display: inline-block;
    width: 1.55rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--font-display);
    letter-spacing: 0;
  }

  .national-hero h1 {
    max-width: 40rem;
    font-size: clamp(3.05rem, 6.1vw, 6rem);
    line-height: 0.96;
  }

  .national-hero-copy p {
    max-width: 36rem;
    margin: 1.45rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.78;
  }

  .hero-signature {
    display: block;
    max-width: 34rem;
    margin-top: 1.4rem;
    color: #fff;
    font-size: 0.86rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.4rem;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.95rem 1.35rem;
    color: #fff;
    font-weight: 900;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.28);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .hero-gallery {
    display: grid;
    grid-template-columns: 1fr 0.78fr;
    grid-template-rows: 1fr 1fr;
    gap: 1rem;
    min-width: 0;
  }

  .hero-card {
    position: relative;
    min-height: 13rem;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: #050609;
    box-shadow: 0 1.4rem 4rem rgba(0, 0, 0, 0.35);
  }

  .hero-card-main {
    grid-row: span 2;
    min-height: 29rem;
  }

  .hero-card img,
  .work-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-card::after,
  .work-card::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, 0.72)),
      radial-gradient(circle at 22% 20%, rgba(124, 60, 255, 0.18), transparent 42%);
    content: "";
    pointer-events: none;
  }

  .proof-section,
  .coverage-section,
  .why-section,
  .activation-section {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-top: 1.35rem;
    padding: clamp(1.35rem, 4vw, 3rem);
  }

  .section-intro h2,
  .editorial-section h2,
  .final-cta h2 {
    max-width: 54rem;
    font-size: clamp(2.1rem, 4.6vw, 4.5rem);
    line-height: 0.98;
  }

  .section-intro p,
  .editorial-section p,
  .final-cta p {
    max-width: 48rem;
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.78;
  }

  .section-intro a {
    color: #fff;
    font-weight: 800;
    text-decoration-color: rgba(185, 133, 255, 0.68);
    text-underline-offset: 0.18em;
  }

  .compact {
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
  }

  .metrics-grid,
  .expertise-grid,
  .why-grid,
  .activation-grid,
  .method-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .metrics-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .metrics-grid article,
  .expertise-card,
  .why-grid article,
  .activation-grid article,
  .method-grid li {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 10% 0%, rgba(140, 82, 255, 0.18), transparent 16rem),
