---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS, CONTACT_FORM, SITE } from '../consts';
import { breadcrumbs, localBusiness } from '../lib/schema';

const assetBase = '/assets/richmedia-home';

const schema = [
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Contact', url: `${SITE.url}/contact` },
  ]),
];

const formatPhone = (tel: string) => tel.replace(/(\+212)(\d{3})(\d{3})(\d{3})/, '$1 $2 $3 $4');

const subjectOptions = [
  'Stratégie digitale',
  'Achat média',
  'Social, influence & UGC',
  'Web & SI',
  'WhatsApp & IA',
  'Événementiel / Phygital',
  'Demande d’audit',
  'Autre projet',
];

const contactHighlights = [
  {
    icon: 'ph-envelope-simple',
    title: 'Email',
    lines: [BUSINESS.email],
    href: `mailto:${BUSINESS.email}`,
  },
  {
    icon: 'ph-phone-call',
    title: 'Téléphone',
    lines: [formatPhone(BUSINESS.tels[0]), formatPhone(BUSINESS.tels[1])],
    href: `tel:${BUSINESS.tels[0]}`,
  },
  {
    icon: 'ph-map-pin',
    title: 'Nos bureaux',
    lines: ['Casablanca, Maroc', 'Dubaï, UAE', 'Montréal, Canada', 'Strasbourg, France'],
    href: '#contact-map',
  },
  {
    icon: 'ph-clock',
    title: 'Horaires',
    lines: ['Lun. - Ven.', '9h00 - 18h00'],
    href: '#contact-form',
  },
];

const heroCards = [
  {
    icon: 'ph-envelope-simple',
    title: 'Email',
    lines: [BUSINESS.email],
  },
  {
    icon: 'ph-phone-call',
    title: 'Téléphone',
    lines: [formatPhone(BUSINESS.tels[0]), formatPhone(BUSINESS.tels[1])],
  },
  {
    icon: 'ph-clock',
    title: 'Réponse sous 24h',
    lines: ['jours ouvrés'],
  },
  {
    icon: 'ph-map-pin',
    title: 'Casablanca',
    lines: ['Dubaï / Montréal', 'Strasbourg'],
  },
];

const officeMarkers = [
  { city: 'Montréal', country: 'Canada', x: 33.79, y: 24.44, heroX: 34.7, heroY: 24.6, className: 'office-montreal' },
  { city: 'Strasbourg', country: 'France', x: 51.68, y: 22.8, heroX: 59.2, heroY: 22.2, className: 'office-strasbourg' },
  { city: 'Casablanca', country: 'Maroc', x: 48.24, y: 30.94, heroX: 54.0, heroY: 37.6, className: 'office-casablanca' },
  { city: 'Dubaï', country: 'UAE', x: 63.15, y: 35.54, heroX: 74.7, heroY: 33.9, className: 'office-dubai' },
];

const processSteps = [
  {
    number: '1',
    icon: 'ph-briefcase',
    title: '1. Prise de brief',
    text: 'Nous comprenons votre besoin, vos enjeux et vos objectifs.',
  },
  {
    number: '2',
    icon: 'ph-lightbulb',
    title: '2. Recommandation',
    text: 'Nous proposons un dispositif adapté, clair et réaliste.',
  },
  {
    number: '3',
    icon: 'ph-target',
    title: '3. Plan d’action',
    text: 'Nous définissons les canaux, les livrables et le calendrier.',
  },
  {
    number: '4',
    icon: 'ph-rocket-launch',
    title: '4. Lancement',
    text: 'Nous activons, suivons et optimisons vos campagnes.',
  },
];

const faqs = [
  {
    icon: 'ph-clock',
    question: 'Sous quel délai revenez-vous ?',
    answer: 'Réponse rapide sous 24h ouvrées, avec un premier cadrage clair.',
  },
  {
    icon: 'ph-briefcase',
    question: 'Pouvez-vous gérer stratégie + créa + média ?',
    answer: 'Oui, notre approche est intégrée : stratégie, production, achat média, tracking et optimisation.',
  },
  {
    icon: 'ph-map-pin',
    question: 'Travaillez-vous uniquement au Maroc ?',
    answer: 'Non, nous accompagnons aussi des projets à l’international depuis nos bureaux et relais.',
  },
  {
    icon: 'ph-chat-circle-dots',
    question: 'Peut-on vous contacter pour un audit ou une recommandation ?',
    answer: 'Oui, nous pouvons démarrer par un échange de cadrage avant toute proposition.',
  },
];
---

<BaseLayout
  title="Contact agence digitale | Richmedia"
  description="Contactez Richmedia pour cadrer une campagne, un dispositif digital, un projet média, web ou IA. Casablanca · Dubaï · Montréal · Strasbourg."
  canonical={`${SITE.url}/contact`}
  schema={schema}
>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="hero-copy">
        <span class="section-kicker">Contactez-nous</span>
        <h1 id="contact-title">Parlons de votre <span>prochain projet.</span></h1>
        <p>
          Que vous cherchiez à générer plus de leads, lancer une campagne, améliorer vos performances digitales
          ou imaginer une nouvelle expérience de marque, notre équipe est prête à vous accompagner.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contact-form">
            Démarrer un projet
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir nos réalisations
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Carte mondiale et coordonnées Richmedia">
        <div class="hero-map-stage">
          <img
            src={`${assetBase}/optimized/world-map-natural-earth.webp`}
            alt=""
            width="1000"
            height="520"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <span class="hero-glow hero-glow-core"></span>
          <span class="hero-route hero-route-1"></span>
          <span class="hero-route hero-route-2"></span>
          <span class="hero-route hero-route-3"></span>
          {officeMarkers.map((office) => (
            <span
              class:list={['hero-pin', office.className]}
              style={`--x:${office.heroX ?? office.x}%; --y:${office.heroY ?? office.y}%;`}
            >
              <span class="hero-pin-pulse" aria-hidden="true"></span>
              <span class="hero-pin-core" aria-hidden="true"></span>
              <span class="hero-pin-label">
                <strong>{office.city}</strong>
                <small>{office.country}</small>
              </span>
            </span>
          ))}
          <div class="holo-card holo-card-performance">
            <i class="ph ph-target" aria-hidden="true"></i>
            <span>Performance</span>
            <strong>72%</strong>
          </div>
          <div class="holo-card holo-card-brief">
            <i class="ph ph-chat-circle-dots" aria-hidden="true"></i>
            <span>Brief projet</span>
            <strong>En cours</strong>
          </div>
          <div class="hero-platform"></div>
        </div>

        <div class="hero-contact-cards">
          {heroCards.map((card) => (
            <article class="hero-contact-card">
              <span class="icon-box">
                <i class:list={['ph', card.icon]} aria-hidden="true"></i>
              </span>
              <div>
                <strong>{card.title}</strong>
                {card.lines.map((line) => <span>{line}</span>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-strip" aria-label="Coordonnées rapides">
      {contactHighlights.map((item) => (
        <a class="contact-strip-card hover-card" href={item.href}>
          <span class="icon-box">
            <i class:list={['ph', item.icon]} aria-hidden="true"></i>
          </span>
          <span class="strip-content">
            <strong>{item.title}</strong>
            {item.lines.map((line) => <span>{line}</span>)}
          </span>
          <i class="ph ph-arrow-right strip-arrow" aria-hidden="true"></i>
        </a>
      ))}
    </section>

    <section class="contact-main-grid" aria-label="Formulaire et carte des bureaux">
      <article class="contact-form-panel hover-card" id="contact-form">
        <h2>Envoyez-nous votre demande</h2>
        <form
          action={CONTACT_FORM.action}
          method="post"
          data-contact-endpoint={CONTACT_FORM.ajaxAction}
          data-contact-form
          data-sending-message="Envoi de votre demande..."
          data-success-message="Votre demande a bien été envoyée. Nous revenons vers vous rapidement."
          data-error-message="L’envoi n’a pas abouti. Appelez-nous ou écrivez-nous directement."
        >
          <input type="hidden" name="_form" value="Contact FR" />
          <label class="form-honeypot" aria-hidden="true">
            <span>Site web</span>
            <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
          </label>

          <label class="field">
            <span class="sr-only">Nom</span>
            <span class="field-shell">
              <i class="ph ph-users" aria-hidden="true"></i>
              <input type="text" name="Nom complet" autocomplete="name" placeholder="Nom" required />
            </span>
          </label>
          <label class="field">
            <span class="sr-only">Entreprise</span>
            <span class="field-shell">
              <i class="ph ph-briefcase" aria-hidden="true"></i>
              <input type="text" name="Entreprise" autocomplete="organization" placeholder="Entreprise" />
            </span>
          </label>
          <label class="field">
            <span class="sr-only">Email</span>
            <span class="field-shell">
              <i class="ph ph-envelope-simple" aria-hidden="true"></i>
              <input type="email" name="Email" autocomplete="email" placeholder="Email" required />
            </span>
          </label>
          <label class="field">
            <span class="sr-only">Téléphone</span>
            <span class="field-shell">
              <i class="ph ph-phone-call" aria-hidden="true"></i>
              <input type="tel" name="Téléphone" autocomplete="tel" placeholder="Téléphone" />
            </span>
          </label>
          <label class="field field-wide">
            <span class="sr-only">Sujet</span>
            <span class="field-shell">
              <i class="ph ph-cursor-click" aria-hidden="true"></i>
              <select name="Sujet" required>
                <option value="">Sujet</option>
                {subjectOptions.map((subject) => <option value={subject}>{subject}</option>)}
              </select>
            </span>
          </label>
          <label class="field field-wide">
            <span class="sr-only">Message</span>
            <span class="field-shell field-shell-textarea">
              <textarea name="Message" rows="5" placeholder="Message" required></textarea>
            </span>
          </label>
          <label class="consent field-wide">
            <input type="checkbox" name="Consentement" value="Oui" required />
            <span>J’accepte d’être contacté(e) par Richmedia.</span>
          </label>
          <button class="button button-primary field-wide" type="submit">
            Envoyer ma demande
            <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
          </button>
          <p class="form-status field-wide" data-form-status role="status" aria-live="polite"></p>
        </form>
      </article>

      <article class="office-map-panel hover-card" id="contact-map">
        <h2>Une présence internationale <span>pour accompagner vos projets au Maroc et à l’international.</span></h2>
        <div class="office-map-stage" aria-label="Carte lumineuse des bureaux Richmedia">
          <img
            src={`${assetBase}/optimized/world-map-natural-earth.webp`}
            alt=""
            width="1000"
            height="520"
            loading="lazy"
            decoding="async"
          />
          <span class="map-route map-route-1"></span>
          <span class="map-route map-route-2"></span>
          <span class="map-route map-route-3"></span>
          <span class="map-route map-route-4"></span>
          {officeMarkers.map((office) => (
            <span
              class:list={['office-pin', office.className]}
              style={`--x:${office.x}%; --y:${office.y}%;`}
            >
              <span class="pin-pulse"></span>
              <span class="pin-core"></span>
              <span class="pin-label">
                <strong>{office.city}</strong>
                <small>{office.country}</small>
              </span>
            </span>
          ))}
        </div>
      </article>
    </section>

    <section class="next-section" aria-labelledby="next-title">
      <div class="section-heading">
        <span></span>
        <h2 id="next-title">Comment se passe la suite ?</h2>
        <span></span>
      </div>
      <div class="process-grid">
        {processSteps.map((step, index) => (
          <article class="process-card hover-card">
            <span class="step-badge">{step.number}</span>
            <i class:list={['ph', step.icon]} aria-hidden="true"></i>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            {index < processSteps.length - 1 && (
              <span class="process-arrow" aria-hidden="true">
                <i class="ph ph-arrow-right"></i>
              </span>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <h2 id="faq-title">Vos questions, nos réponses</h2>
      <div class="faq-grid">
        {faqs.map((item) => (
          <details class="faq-item hover-card">
            <summary>
              <span class="icon-box">
                <i class:list={['ph', item.icon]} aria-hidden="true"></i>
              </span>
              <span>
                <strong>{item.question}</strong>
                <em>{item.answer}</em>
              </span>
              <b aria-hidden="true">+</b>
            </summary>
          </details>
        ))}
      </div>
    </section>

    <section class="contact-cta hover-card" aria-label="Appel à l’action">
      <div>
        <h2>Prêt à faire grandir votre marque&nbsp;?</h2>
        <p>Échangeons sur vos objectifs et construisons ensemble un dispositif efficace.</p>
      </div>
      <a class="button button-light" href={`tel:${BUSINESS.tels[0]}`}>
        Parler à un expert
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .contact-page {
    --bg: #02040a;
    --panel: rgba(14, 15, 28, 0.78);
    --line: rgba(255, 255, 255, 0.14);
    --muted: rgba(255, 255, 255, 0.68);
    --soft: rgba(255, 255, 255, 0.82);
    --purple: #8a4dff;
    --purple-2: #6c24ff;
    --purple-soft: #b084ff;
    position: relative;
    box-sizing: border-box;
    overflow: hidden;
    width: 100%;
    color: #fff;
    background:
      radial-gradient(circle at 76% 4%, rgba(105, 50, 255, 0.18), transparent 24rem),
      radial-gradient(circle at 4% 18%, rgba(126, 68, 255, 0.15), transparent 18rem),
      linear-gradient(rgba(255, 255, 255, 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.026) 1px, transparent 1px),
      var(--bg);
    background-size: auto, auto, 78px 78px, 78px 78px, auto;
    padding: clamp(7.5rem, 8.4vw, 9rem) max(1.2rem, calc((100vw - 1500px) / 2)) clamp(3.6rem, 6vw, 5.5rem);
  }

  .contact-page *,
  .contact-page *::before,
  .contact-page *::after {
    box-sizing: border-box;
  }

  .contact-page::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(138, 77, 255, 0.1), transparent 32rem),
      linear-gradient(180deg, rgba(2, 4, 10, 0), rgba(2, 4, 10, 0.86) 44%, #02040a 100%);
    content: '';
    pointer-events: none;
  }

  .contact-page > * {
    position: relative;
    z-index: 1;
    width: min(100% - 6rem, 1500px);
    margin-inline: auto;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--purple-soft);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .section-kicker::after {
    width: 3rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--purple), transparent);
    content: '';
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.55rem;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 1.45rem;
    font-size: 1.0625rem;
    font-weight: 850;
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease, box-shadow 220ms ease;
    cursor: pointer;
  }

  .button i {
    font-size: 1.05em;
    transition: transform 220ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-3px);
  }

  .button:hover i,
  .button:focus-visible i {
    transform: translate(3px, -3px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9b5cff 0%, #6e29ff 100%);
    box-shadow: 0 1.1rem 2.6rem rgba(108, 36, 255, 0.35);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.035);
  }

  .button-light {
    min-width: 260px;
    color: #6c24ff;
    background: #fff;
    box-shadow: 0 1rem 2.4rem rgba(10, 2, 30, 0.2);
  }

  .hover-card {
    position: relative;
    overflow: hidden;
    transition: transform 260ms ease, border-color 260ms ease, background 260ms ease, box-shadow 260ms ease;
  }

  .hover-card::before {
    position: absolute;
    inset: -1px;
    z-index: -1;
    opacity: 0;
    background:
      radial-gradient(circle at 22% 0%, rgba(138, 77, 255, 0.25), transparent 16rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0));
    content: '';
    transition: opacity 260ms ease;
  }

  .hover-card:hover,
  .hover-card:focus-within {
    transform: translateY(-5px);
    border-color: rgba(176, 132, 255, 0.58);
    box-shadow: 0 1.4rem 3.6rem rgba(0, 0, 0, 0.28), 0 0 2.4rem rgba(138, 77, 255, 0.12);
  }

  .hover-card:hover::before,
  .hover-card:focus-within::before {
    opacity: 1;
  }

  .icon-box {
    display: inline-grid;
    width: 3.9rem;
    height: 3.9rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(138, 77, 255, 0.3);
    border-radius: 8px;
    background:
      radial-gradient(circle at 45% 25%, rgba(185, 137, 255, 0.28), transparent 52%),
      rgba(110, 41, 255, 0.12);
    color: var(--purple-soft);
    font-size: 1.78rem;
    box-shadow: 0 0 1.5rem rgba(138, 77, 255, 0.16);
    transition: transform 260ms ease, box-shadow 260ms ease;
  }

  .hover-card:hover .icon-box {
    transform: rotate(-5deg) scale(1.05);
    box-shadow: 0 0 2.2rem rgba(138, 77, 255, 0.35);
  }

  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(620px, 1.05fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: clamp(660px, 47vw, 790px);
    padding-block: clamp(1rem, 2vw, 2rem);
  }

  .hero-copy {
    max-width: 660px;
  }

  .hero-copy h1 {
    margin-top: 1.25rem;
    font-size: clamp(4rem, 5.4vw, 6.65rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .hero-copy h1 span {
    display: block;
    color: transparent;
    background: linear-gradient(110deg, #9e64ff 0%, #6f2bff 55%, #b992ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    text-shadow: 0 0 2.4rem rgba(138, 77, 255, 0.24);
  }

  .hero-copy p {
    max-width: 640px;
    margin-top: 1.6rem;
    color: var(--muted);
    font-size: clamp(1.08rem, 1.45vw, 1.32rem);
    line-height: 1.62;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero-visual {
    position: relative;
    min-height: clamp(540px, 38vw, 680px);
  }

  .hero-map-stage {
    position: absolute;
    inset: 0 6rem 0 0;
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 72%, rgba(138, 77, 255, 0.3), transparent 14rem),
      rgba(5, 6, 15, 0.36);
    isolation: isolate;
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.72), #000 18%, #000 82%, rgba(0, 0, 0, 0.6));
  }

  .hero-map-stage img {
    position: absolute;
    inset: 2rem 2rem 5rem;
    width: calc(100% - 4rem);
    height: calc(100% - 7rem);
    object-fit: contain;
    opacity: 0.78;
    filter: saturate(1.35) contrast(1.18) drop-shadow(0 0 1.6rem rgba(138, 77, 255, 0.25));
    mix-blend-mode: screen;
  }

  .hero-glow-core {
    position: absolute;
    left: 51%;
    bottom: 15%;
    width: 12rem;
    height: 4rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(170, 114, 255, 0.66) 24%, transparent 72%);
    filter: blur(2px);
    transform: translateX(-50%);
    animation: heroGlow 2.6s ease-in-out infinite alternate;
  }

  .hero-platform {
    position: absolute;
    left: 51%;
    bottom: 5%;
    width: min(44%, 430px);
    height: 8rem;
    border: 1px solid rgba(138, 77, 255, 0.28);
    border-radius: 50%;
    background:
      radial-gradient(ellipse at center, rgba(144, 86, 255, 0.3), rgba(30, 14, 78, 0.2) 45%, transparent 68%),
      repeating-radial-gradient(ellipse at center, rgba(138, 77, 255, 0.26) 0 1px, transparent 1px 24px);
    transform: translateX(-50%) rotateX(66deg);
    box-shadow: 0 0 5rem rgba(138, 77, 255, 0.18);
  }

  .hero-route,
  .map-route {
    position: absolute;
    pointer-events: none;
    border-top: 1px solid rgba(176, 132, 255, 0.52);
    border-radius: 50%;
    filter: drop-shadow(0 0 0.8rem rgba(138, 77, 255, 0.55));
    animation: routePulse 3.6s ease-in-out infinite;
  }

  .hero-route-1 {
    left: 24%;
    top: 34%;
    width: 42%;
    height: 25%;
    transform: rotate(18deg);
  }

  .hero-route-2 {
    left: 41%;
    top: 30%;
    width: 35%;
