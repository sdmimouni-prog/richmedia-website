---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS, SITE } from '../consts';
import { breadcrumbs, localBusiness } from '../lib/schema';

const assetBase = '/assets/richmedia-home';

const schema = [
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Contact', url: `${SITE.url}/contact` },
  ]),
];

const formatPhone = (tel: string) => tel.replace(/(\+212)(\d{3})(\d{3})(\d{3})/, '$1 $2 $3 $4');

const contactMethods = [
  {
    icon: 'ph-envelope-simple',
    label: 'Email direct',
    value: BUSINESS.email,
    href: `mailto:${BUSINESS.email}`,
  },
  {
    icon: 'ph-phone',
    label: 'Téléphone',
    value: formatPhone(BUSINESS.tels[0]),
    href: `tel:${BUSINESS.tels[0]}`,
  },
  {
    icon: 'ph-phone-call',
    label: 'Ligne directe',
    value: formatPhone(BUSINESS.tels[1]),
    href: `tel:${BUSINESS.tels[1]}`,
  },
  {
    icon: 'ph-clock',
    label: 'Horaires',
    value: 'Lun. - Ven. : 9 h 00 - 18 h 00',
    note: 'Sam. - Dim. : fermé',
  },
];

const projectTypes = [
  'Campagne 360°',
  'Acquisition de leads',
  'Réseaux sociaux & UGC',
  'Achat média',
  'Site web / SI',
  'WhatsApp & IA',
  'Activation terrain',
  'Brand content',
];

const quickSteps = [
  {
    step: '01',
    title: 'Cadrer',
    text: 'Objectifs, audience, contraintes et priorités.',
  },
  {
    step: '02',
    title: 'Construire',
    text: 'Stratégie, canaux, planning et ressources.',
  },
  {
    step: '03',
    title: 'Activer',
    text: 'Campagne, tracking, reporting et optimisation.',
  },
];

const quickLinks = [
  { href: '#contact-form', label: 'Formulaire', value: '1 min' },
  { href: `tel:${BUSINESS.tels[0]}`, label: 'Appeler', value: 'Direct' },
  { href: '#contact-methods', label: 'Coordonnées', value: '4 accès' },
  { href: '#contact-offices', label: 'Bureaux', value: '4 villes' },
];

const officeMarkers = [
  { city: 'Montréal', x: 33.79, y: 24.44, className: 'office-marker-montreal' },
  { city: 'Strasbourg', x: 51.68, y: 22.8, className: 'office-marker-strasbourg' },
  { city: 'Casablanca', x: 48.24, y: 30.94, className: 'office-marker-casablanca' },
  { city: 'Dubaï', x: 63.15, y: 35.54, className: 'office-marker-dubai' },
];
---

<BaseLayout
  title="Contact Richmedia — Parlons de votre projet"
  description="Contactez Richmedia pour cadrer une campagne, un dispositif digital, un projet média, web ou IA. Casablanca · Dubaï · Montréal · Strasbourg."
  canonical={`${SITE.url}/contact`}
  schema={schema}
>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="contact-copy">
        <span class="section-kicker">Contact Richmedia</span>
        <h1 id="contact-title">Parlons de votre prochain projet.</h1>
        <p>
          Un brief, une campagne, une plateforme ou une idée à transformer en croissance mesurable.
        </p>
        <div class="contact-actions">
          <a class="button button-primary" href={`mailto:${BUSINESS.email}`}>
            Nous écrire
            <i class="ph ph-envelope-simple" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href={`tel:${BUSINESS.tels[0]}`}>
            Appeler
            <i class="ph ph-phone" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <aside class="contact-form-card" id="contact-form" aria-label="Formulaire de contact">
        <span class="form-label">Démarrer maintenant</span>
        <h2>Envoyez-nous quelques informations.</h2>
        <form action={`mailto:${BUSINESS.email}`} method="post" enctype="text/plain">
          <label>
            <span>Nom complet</span>
            <input type="text" name="Nom complet" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="Email" autocomplete="email" required />
          </label>
          <label>
            <span>Téléphone</span>
            <input type="tel" name="Téléphone" autocomplete="tel" />
          </label>
          <label>
            <span>Type de projet</span>
            <select name="Type de projet" required>
              <option value="">Sélectionner</option>
              {projectTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </label>
          <label class="field-wide">
            <span>Message</span>
            <textarea name="Message" rows="4" placeholder="Votre objectif, votre timing, votre marché..."></textarea>
          </label>
          <button class="button button-primary field-wide" type="submit">
            Envoyer la demande
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </button>
        </form>
      </aside>
    </section>

    <nav class="mobile-page-nav" aria-label="Navigation de la page Contact">
      {quickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="contact-methods" id="contact-methods" aria-label="Coordonnées Richmedia">
      {contactMethods.map((method) => {
        const content = (
          <>
            <span class="method-icon"><i class:list={['ph', method.icon]} aria-hidden="true"></i></span>
            <span>
              <small>{method.label}</small>
              <strong>{method.value}</strong>
              {method.note && <em>{method.note}</em>}
            </span>
          </>
        );

        return method.href ? (
          <a class="method-card" href={method.href}>{content}</a>
        ) : (
          <div class="method-card">{content}</div>
        );
      })}
    </section>

    <section class="contact-workflow" id="contact-brief" aria-labelledby="workflow-title">
      <article class="project-card">
        <span class="section-kicker">Brief projet</span>
        <h2 id="workflow-title">Ce qu’on peut cadrer ensemble.</h2>
        <div class="type-cloud" aria-label="Types de projets">
          {projectTypes.map((type) => <span>{type}</span>)}
        </div>
        <div class="steps-list">
          {quickSteps.map((item) => (
            <div class="step-row">
              <span>{item.step}</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </article>

      <article class="map-card" aria-labelledby="map-title">
        <span class="map-label">Présence internationale</span>
        <h2 id="map-title">4 bureaux pour accompagner vos projets.</h2>
        <div class="map-stage" aria-label="Carte du monde avec les bureaux Richmedia">
          <img
            class="world-map-img"
            src={`${assetBase}/world-map-natural-earth.svg`}
            alt=""
            loading="lazy"
            decoding="async"
          />
          {officeMarkers.map((office) => (
            <span class:list={['office-marker', office.className]} style={`--x: ${office.x}%; --y: ${office.y}%`}>
              <span class="office-dot"></span>
              <span class="office-label">{office.city}</span>
            </span>
          ))}
        </div>
        <div class="office-pills" aria-label="Bureaux Richmedia">
          {BUSINESS.areaServed.map((office) => <span>{office}</span>)}
        </div>
      </article>
    </section>

    <section class="office-strip" id="contact-offices" aria-label="Nos bureaux">
      {BUSINESS.areaServed.map((office) => (
        <article>
          <span>{office}</span>
          <p>{office === 'Casablanca' ? BUSINESS.adresse : 'Bureau Richmedia'}</p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .contact-page {
    --purple: #7c3cff;
    --purple-soft: #a46cff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.66);
    width: min(100% - 3rem, 1320px);
    margin: 0 auto;
    padding: clamp(8.5rem, 11vw, 10.5rem) 0 clamp(3rem, 6vw, 5.5rem);
    background:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 84px 84px;
  }

  .contact-form-card,
  .contact-methods,
  .contact-workflow,
  .office-strip {
    scroll-margin-top: 6rem;
  }

  .mobile-page-nav {
    display: none;
  }

  .contact-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(420px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: stretch;
    overflow: hidden;
    min-height: 620px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: clamp(2rem, 5vw, 4.5rem);
    background:
      radial-gradient(circle at 8% 38%, rgba(124, 60, 255, 0.22), transparent 26rem),
      radial-gradient(circle at 86% 8%, rgba(124, 60, 255, 0.12), transparent 20rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.012));
  }

  .contact-hero::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(124, 60, 255, 0.08), transparent 46%);
    content: '';
    pointer-events: none;
  }

  .contact-copy,
  .contact-form-card {
    position: relative;
    z-index: 1;
  }

  .contact-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .section-kicker,
  .form-label,
  .map-label {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.65rem;
    color: var(--purple-soft);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2rem;
    height: 2px;
    background: var(--purple);
    content: '';
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    max-width: 760px;
    margin-top: 1.1rem;
    --h1-size: clamp(3rem, 6vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .contact-copy p {
    max-width: 560px;
    margin-top: 1.3rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.45vw, 1.22rem);
    line-height: 1.58;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.2rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1.25rem;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
    cursor: pointer;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.28);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.035);
  }

  .contact-form-card {
    display: grid;
    align-content: start;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.026)),
      rgba(3, 4, 7, 0.72);
    box-shadow: 0 1.6rem 4rem rgba(0, 0, 0, 0.34);
    backdrop-filter: blur(16px);
  }

  .contact-form-card h2 {
    margin-top: 0.85rem;
    --h2-size: clamp(1.6rem, 2.4vw, 2.5rem);
    font-size: var(--h2-size);
    line-height: 1.07;
  }

  form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  label {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  label span {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.78rem;
    font-weight: 700;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 7px;
    padding: 0.9rem 0.95rem;
    background: rgba(0, 0, 0, 0.28);
    color: #fff;
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  textarea {
    resize: vertical;
  }

  select {
    color-scheme: dark;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: rgba(124, 60, 255, 0.7);
    background: rgba(0, 0, 0, 0.42);
    box-shadow: 0 0 0 4px rgba(124, 60, 255, 0.12);
  }

  .field-wide {
    grid-column: 1 / -1;
  }

  .contact-methods {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
    margin-top: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.018);
  }

  .method-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    min-height: 8rem;
    border-right: 1px solid var(--line);
    padding: 1.2rem;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    transition: background 190ms ease, transform 190ms ease;
  }

  .method-card:last-child {
    border-right: 0;
  }

  a.method-card:hover,
  a.method-card:focus-visible {
    background: rgba(124, 60, 255, 0.08);
  }

  .method-icon {
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgba(124, 60, 255, 0.4);
    border-radius: 8px;
    background: rgba(124, 60, 255, 0.12);
    color: var(--purple-soft);
    font-size: 1.35rem;
  }

  .method-card small {
    display: block;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .method-card strong {
    display: block;
    margin-top: 0.18rem;
    color: #fff;
    font-size: clamp(0.95rem, 1.2vw, 1.12rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .method-card em {
    display: block;
    margin-top: 0.15rem;
    color: rgba(255, 255, 255, 0.62);
    font-style: normal;
    font-size: 0.9rem;
  }

  .contact-workflow {
    display: grid;
    grid-template-columns: minmax(360px, 0.72fr) minmax(420px, 1fr);
    gap: 1.2rem;
    margin-top: 1.2rem;
  }

  .project-card,
  .map-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 14% 0%, rgba(124, 60, 255, 0.16), transparent 18rem),
      rgba(255, 255, 255, 0.018);
  }

  .project-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }

  .project-card h2,
  .map-card h2 {
    margin-top: 0.85rem;
    --h2-size: clamp(1.65rem, 2.7vw, 2.8rem);
    font-size: var(--h2-size);
    line-height: 1.08;
  }

  .type-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.4rem;
  }

  .type-cloud span {
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 999px;
    padding: 0.55rem 0.72rem;
    background: rgba(255, 255, 255, 0.035);
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .steps-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .step-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.95rem;
    align-items: start;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 0.85rem;
  }

  .step-row > span {
    color: var(--purple-soft);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .step-row strong {
    color: #fff;
    font-size: 1rem;
  }

  .step-row p {
    margin-top: 0.18rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .map-card {
    position: relative;
    min-height: 480px;
    padding: clamp(1.1rem, 2.2vw, 1.6rem);
  }

  .map-label {
    position: relative;
    z-index: 6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 0.5rem 0.72rem;
    background: rgba(3, 4, 7, 0.72);
    backdrop-filter: blur(12px);
  }

  .map-card h2 {
    position: relative;
    z-index: 6;
    max-width: 420px;
    --h2-size: clamp(1.45rem, 2.15vw, 2.2rem);
    font-size: var(--h2-size);
  }

  .map-stage {
    position: absolute;
    inset: 9.4rem 1rem 4.6rem;
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 45%, rgba(124, 60, 255, 0.11), transparent 17rem),
      #030407;
  }

  .map-stage::before {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(3, 4, 7, 0.28), transparent 18%, transparent 82%, rgba(3, 4, 7, 0.28)),
      linear-gradient(180deg, rgba(3, 4, 7, 0.12), transparent 35%, rgba(3, 4, 7, 0.22));
    content: '';
    pointer-events: none;
  }

  .world-map-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    opacity: 0.96;
    filter: saturate(1.12) contrast(1.06) drop-shadow(0 0 1.8rem rgba(124, 60, 255, 0.18));
  }

  .office-marker {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transform: translate(-0.5rem, -50%);
    white-space: nowrap;
  }

  .office-dot {
    display: block;
    width: 0.68rem;
    height: 0.68rem;
    border: 2px solid rgba(255, 255, 255, 0.82);
    border-radius: 999px;
    background: var(--purple);
    box-shadow: 0 0 0 0.38rem rgba(124, 60, 255, 0.16), 0 0 1.25rem rgba(124, 60, 255, 0.95);
  }

  .office-label {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 0.28rem 0.52rem;
    background: rgba(3, 4, 7, 0.76);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1;
    backdrop-filter: blur(12px);
  }

  .office-marker-montreal .office-label,
  .office-marker-strasbourg .office-label {
    transform: translateY(-0.75rem);
  }

  .office-marker-casablanca .office-label {
    transform: translate(-5.85rem, 1.25rem);
  }

  .office-marker-dubai .office-label {
    transform: translateY(0.9rem);
  }

  .office-pills {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .office-pills span {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    min-height: 2.15rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 999px;
    padding: 0 0.75rem;
    background: rgba(3, 4, 7, 0.72);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.78rem;
    font-weight: 700;
    backdrop-filter: blur(12px);
  }

  .office-pills span::before {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--purple);
    box-shadow: 0 0 0.8rem rgba(124, 60, 255, 0.75);
    content: '';
  }

  .office-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.2rem;
  }

  .office-strip article {
    min-height: 8rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.1rem;
    background: rgba(255, 255, 255, 0.022);
    transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
  }

  .office-strip article:hover {
    border-color: rgba(124, 60, 255, 0.44);
    background: rgba(124, 60, 255, 0.055);
    transform: translateY(-3px);
  }

  .office-strip span {
    color: #fff;
    font-size: 1.12rem;
    font-weight: 800;
  }

  .office-strip p {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  @media (max-width: 1080px) {
    .contact-hero,
    .contact-workflow {
      grid-template-columns: 1fr;
    }

    .contact-form-card {
      max-width: 680px;
    }

    .contact-methods,
    .office-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .method-card:nth-child(2) {
      border-right: 0;
    }

    .method-card:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 720px) {
    .contact-page {
      width: min(100% - 1.25rem, 1320px);
      padding-top: 5.75rem;
      padding-bottom: 3rem;
      background-size: 68px 68px;
    }

    .contact-form-card,
    .contact-methods,
    .contact-workflow,
    .office-strip {
      scroll-margin-top: 13.5rem;
    }

