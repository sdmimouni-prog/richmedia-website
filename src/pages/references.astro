---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleLogoSlide from '../components/ParticleLogoSlide.astro';
import { SITE } from '../consts';
import { breadcrumbs, localBusiness } from '../lib/schema';

const assetBase = '/assets/richmedia-home';
const realisationsBase = '/assets/richmedia-realizations';

const schema = [
  localBusiness(),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Références', url: `${SITE.url}/references` },
  ]),
];

const references = [
  { name: 'UIR', sector: 'Éducation', image: 'logos/references/uir.jpg', proof: 'Admissions & lead generation' },
  { name: 'HEM', sector: 'Éducation', image: '/assets/richmedia-sector-education/logos/hem-logo.webp', proof: 'Campagnes admissions' },
  { name: 'TBS Education', sector: 'Éducation', image: 'logos/campaigns/tbs-education.jpg', proof: 'Acquisition' },
  { name: 'Euromed', sector: 'Éducation', image: '/assets/richmedia-sector-education/logos/euromed-logo.webp', proof: 'Notoriété & programmes' },
  { name: 'UPM', sector: 'Éducation', image: '/assets/richmedia-sector-education/logos/upm-logo.webp', proof: 'Génération de leads' },
  { name: 'Amana', sector: 'Mobilité & retail', image: 'logos/references/amana.jpg', proof: 'Campagne 360° & DOOH' },
  { name: 'Don Simon', sector: 'Food & beverage', image: 'logos/references/don-simon.jpg', proof: 'Social media & influence' },
  { name: 'Terroir du Maroc', sector: 'Produits locaux', image: 'logos/references/terroir-du-maroc.jpg', proof: 'Stratégie digitale' },
  { name: 'Electroplanet', sector: 'Retail', image: 'logos/references/electroplanet.jpg', proof: 'Activation commerciale' },
  { name: 'KITEA', sector: 'Home retail', image: 'logos/references/kitea.jpg', proof: 'Communication digitale' },
  { name: 'Carrefour Market', sector: 'Grande distribution', image: 'logos/references/carrefour-market.jpg', proof: 'Campagnes retail' },
  { name: 'Carrefour', sector: 'GMS', image: '/assets/richmedia-sector-gms/logos/carrefour-normalized.png', proof: 'Activation locale' },
  { name: 'Marjane', sector: 'GMS', image: '/assets/richmedia-sector-gms/logos/marjane-normalized.png', proof: 'Promotions & drive-to-store' },
  { name: 'Kazyon', sector: 'GMS', image: '/assets/richmedia-sector-gms/logos/kazyon-normalized.png', proof: 'Retail discount' },
  { name: 'Asswak Assalam', sector: 'Grande distribution', image: 'logos/references/asswak-assalam.jpg', proof: 'Dispositifs de proximité' },
  { name: 'Lesieur Cristal', sector: 'FMCG', image: 'logos/references/lesieur-cristal.jpg', proof: 'Brand content' },
  { name: 'SANGO', sector: 'FMCG', image: '/assets/richmedia-sector-fmcg/logos/sango-normalized.png', proof: 'Grande consommation' },
  { name: 'Lesaffre', sector: 'FMCG', image: '/assets/richmedia-sector-fmcg/logos/lesaffre-normalized.png', proof: 'Brand content' },
  { name: 'Yara', sector: 'FMCG', image: '/assets/richmedia-sector-fmcg/logos/yara-normalized.png', proof: 'Communication agricole' },
  { name: 'Maroc Telecom', sector: 'Télécom', image: 'logos/references/maroc-telecom.jpg', proof: 'Communication digitale' },
  { name: 'Prestigia', sector: 'Immobilier', image: 'logos/campaigns/prestigia.jpg', proof: 'Création & performance' },
  { name: 'ADDOHA', sector: 'Immobilier', image: '/assets/richmedia-sector-immobilier/logos/addoha-normalized.png', proof: 'Promotion immobilière' },
  { name: 'Excelia', sector: 'Immobilier', image: '/assets/richmedia-sector-immobilier/logos/excelia-normalized.png', proof: 'Lancement de projets' },
  { name: 'Lazrek Immobilier', sector: 'Immobilier', image: '/assets/richmedia-sector-immobilier/logos/lazrak-normalized.png', proof: 'Génération de leads' },
  { name: 'Al Omrane', sector: 'Immobilier', image: '/assets/richmedia-sector-immobilier/logos/al-omrane-normalized.png', proof: 'Aménagement & habitat' },
  { name: 'Tramway Rabat', sector: 'Mobilité', image: 'logos/campaigns/tramway-rabat.jpg', proof: 'Campagnes usagers' },
  { name: 'Agence de développement agricole', sector: 'Institution', image: 'logos/campaigns/ada.jpg', proof: 'Communication publique' },
  { name: 'SONARGES', sector: 'Institution', image: '/assets/richmedia-sector-institutionnel/logos/sonarges-normalized.png', proof: 'Communication institutionnelle' },
  { name: 'DGI', sector: 'Institution', image: '/assets/richmedia-sector-institutionnel/logos/dgi-normalized.png', proof: 'Information publique' },
  { name: 'CMR', sector: 'Institution', image: 'logos/campaigns/cmr.jpg', proof: 'Dispositif digital' },
  { name: 'Moul Pounj', sector: 'Home retail', image: 'logos/campaigns/moul-pounj.jpg', proof: 'Média & conversion' },
  { name: 'Massinart', sector: 'Retail & marketplace', image: '/assets/richmedia-sector-retail/logos/massinart.svg', proof: 'Commerce connecté' },
  { name: 'Glovo', sector: 'Quick commerce', image: '/assets/richmedia-sector-retail/logos/glovo-normalized.png', proof: 'Acquisition locale' },
  { name: 'Bringo', sector: 'Commerce connecté', image: '/assets/richmedia-sector-retail/logos/bringo-normalized.png', proof: 'Quick commerce' },
  { name: 'Maserati', sector: 'Automobile', image: '/assets/richmedia-sector-automobile/logos/maserati-normalized.png', proof: 'Premium automobile' },
  { name: 'Range Rover', sector: 'Automobile', image: '/assets/richmedia-sector-automobile/logos/range-rover-normalized.png', proof: 'SUV premium' },
  { name: 'Jaguar', sector: 'Automobile', image: '/assets/richmedia-sector-automobile/logos/jaguar-normalized.png', proof: 'Leads & showrooms' },
  { name: 'Barceló', sector: 'Tourisme & hôtellerie', image: '/assets/richmedia-sector-hotellerie/logos/barcelo-normalized.png', proof: 'Réservation & notoriété' },
  { name: 'Banyan Tree', sector: 'Tourisme & hôtellerie', image: '/assets/richmedia-sector-hotellerie/logos/banyan-tree-normalized.png', proof: 'Luxury hospitality' },
  { name: 'Ryad Al Andalous', sector: 'Immobilier', image: 'logos/campaigns/ryad-al-andalous.jpg', proof: 'Brand campaign' },
  { name: 'Rabat Riviera', sector: 'Immobilier', image: 'logos/campaigns/rabat-riviera.jpg', proof: 'Lancement projet' },
  { name: 'BED', sector: 'Literie', image: 'logos/campaigns/beed.jpg', proof: 'Identité & contenu' },
];

const resolveReferenceImage = (image: string) => image.startsWith('/') ? image : `${assetBase}/${image}`;

const referenceLoop = [...references, ...references];

const sectors = [
  { label: 'Éducation', count: '5', text: 'Admissions, réputation et acquisition qualifiée.' },
  { label: 'Retail & GMS', count: '12', text: 'Drive-to-store, activation, conversion et contenus.' },
  { label: 'Immobilier', count: '7', text: 'Lancements, storytelling et campagnes de performance.' },
  { label: 'Institutions', count: '4', text: 'Plateformes, information utile et dispositifs publics.' },
  { label: 'FMCG', count: '5', text: 'Brand content, influence, activation retail et reporting.' },
  { label: 'Auto & tourisme', count: '5', text: 'Leads, réservation, notoriété et parcours locaux.' },
];

const accreditations = [
  { image: 'logos/accreditations-svg/google-ads.svg', name: 'Google Ads', label: 'Certified' },
  { image: 'logos/accreditations-svg/google-analytics.svg', name: 'Google Analytics', label: 'Certified' },
  { image: 'logos/accreditations-svg/hubspot.svg', name: 'HubSpot', label: 'Certified' },
  { image: 'logos/accreditations-svg/iab-rich-media.svg', name: 'IAB Rich Media', label: 'Certified' },
  { image: 'logos/accreditations-svg/meta-blueprint.svg', name: 'Meta Blueprint', label: 'Certified' },
  { image: 'logos/accreditations-svg/semrush.svg', name: 'Semrush', label: 'Certified' },
];

const featuredCases = [
  {
    client: 'Amana',
    title: 'Tramway wrapping',
    image: `${assetBase}/campaign-wide-amana-tram.webp`,
    type: 'Campagne 360°',
    metric: '20M impressions',
  },
  {
    client: 'UIR',
    title: 'Ouverture des inscriptions',
    image: `${assetBase}/campaign-portfolio-uir.webp`,
    type: 'Acquisition de leads',
    metric: '+34K diplômés recrutés',
  },
  {
    client: 'Moul Pounj',
    title: 'Média & conversion',
    image: `${realisationsBase}/moul-pounj-world-cup.webp`,
    type: 'Campagne retail',
    metric: '4,8M vues',
  },
  {
    client: 'Don Simon',
    title: 'Shooting produit & contenus social media',
    image: `${assetBase}/campaign-wide-donsimon.webp`,
    type: 'Campagne réseaux sociaux',
    metric: '14M vues · 8,1% engagement',
  },
];
---

<BaseLayout
  title="Références clients & marques | Richmedia"
  description="Découvrez les marques, institutions, campagnes et accréditations qui structurent l’écosystème Richmedia au Maroc et à l’international."
  canonical={`${SITE.url}/references`}
  schema={schema}
>
  <div class="references-page">
    <section class="references-hero" aria-labelledby="references-title">
      <div class="hero-copy">
        <span class="section-kicker">Références Richmedia</span>
        <h1 id="references-title">Des marques solides nous confient leur croissance.</h1>
        <p>Une sélection de clients, institutions et plateformes accompagnés au Maroc et à l’international.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/realisations">
            Voir les réalisations
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/contact">
            Parler d’un projet
            <i class="ph ph-envelope-simple" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-proof" aria-label="Aperçu des références">
        <ParticleLogoSlide />
      </div>
    </section>

    <section class="logo-marquee" aria-label="Logos des références">
      <div class="marquee-track">
        {referenceLoop.map((item, index) => (
          <figure aria-hidden={index >= referenceLoop.length / 2 ? 'true' : 'false'}>
            <img src={resolveReferenceImage(item.image)} alt={index >= referenceLoop.length / 2 ? '' : item.name} loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </section>

    <section class="sectors-grid" aria-labelledby="sectors-title">
      <div class="section-heading">
        <span class="section-kicker">Terrains d’action</span>
        <h2 id="sectors-title">Des références dans des marchés exigeants.</h2>
      </div>
      <div class="sector-cards">
        {sectors.map((sector) => (
          <article>
            <span>{sector.count}</span>
            <h3>{sector.label}</h3>
            <p>{sector.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="reference-wall" aria-labelledby="wall-title">
      <div class="section-heading">
        <span class="section-kicker">Marques accompagnées</span>
        <h2 id="wall-title">Clients, campagnes et institutions.</h2>
      </div>
      <div class="reference-grid">
        {references.map((item) => (
          <article class="reference-card">
            <figure>
              <img src={resolveReferenceImage(item.image)} alt={item.name} loading="lazy" decoding="async" />
            </figure>
            <div>
              <span>{item.sector}</span>
              <h3>{item.name}</h3>
              <p>{item.proof}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="featured-cases" aria-labelledby="featured-title">
      <div class="section-heading">
        <span class="section-kicker">Preuves terrain</span>
        <h2 id="featured-title">Quelques campagnes associées.</h2>
      </div>
      <div class="case-grid">
        {featuredCases.map((item) => (
          <a class="case-card" href="/realisations">
            <img src={item.image} alt={`${item.client} — ${item.title}`} loading="lazy" decoding="async" />
            <div>
              <span>{item.type}</span>
              <h3>{item.client}</h3>
              <p>{item.title}</p>
              <strong>{item.metric}</strong>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="accreditations-panel" aria-labelledby="accreditations-title">
      <div class="accreditations-copy">
        <span class="section-kicker">Certifications</span>
        <h2 id="accreditations-title">Nos accréditations.</h2>
        <p>Des plateformes certifiées pour structurer, mesurer et optimiser vos performances.</p>
      </div>
      <div class="cert-grid">
        {accreditations.map((badge) => (
          <figure class="cert-card">
            <img src={`${assetBase}/${badge.image}`} alt={`${badge.name} ${badge.label}`} loading="lazy" decoding="async" />
            <figcaption>
              <strong>{badge.name}</strong>
              <span>{badge.label}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .references-page {
    --purple: #7c3cff;
    --purple-soft: #a46cff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.66);
    width: min(100% - 3rem, 1320px);
    margin: 0 auto;
    padding: clamp(8.25rem, 10vw, 10rem) 0 clamp(3rem, 6vw, 5.5rem);
    background:
      linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
    background-size: 84px 84px;
  }

  .references-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 0.8fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
    min-height: 620px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: clamp(2rem, 5vw, 4.5rem);
    background:
      radial-gradient(circle at 9% 42%, rgba(124, 60, 255, 0.25), transparent 25rem),
      radial-gradient(circle at 84% 12%, rgba(124, 60, 255, 0.15), transparent 22rem),
      rgba(255, 255, 255, 0.018);
  }

  .references-hero::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(124, 60, 255, 0.08), transparent 46%);
    content: '';
    pointer-events: none;
  }

  .hero-copy,
  .hero-proof {
    position: relative;
    z-index: 1;
  }

  .section-kicker {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.65rem;
    color: var(--purple-soft);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2rem;
    height: 2px;
    background: var(--purple);
    content: '';
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 {
    max-width: 640px;
    margin-top: 1rem;
    --h1-size: clamp(2.15rem, 3.6vw, 3.85rem);
    line-height: 1.02;
    letter-spacing: 0;
  }

  .hero-copy p {
    max-width: 610px;
    margin-top: 1.3rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1.0625rem, 1.4vw, 1.18rem);
    line-height: 1.58;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.2rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1.25rem;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.28);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-proof {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(circle at 52% 48%, rgba(124, 60, 255, 0.18), transparent 34%),
      #000;
    box-shadow: none;
  }

  .hero-proof :global(.particle-logo-slide) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }

  .logo-marquee {
    position: relative;
    overflow: hidden;
    margin-top: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.018);
  }

  .logo-marquee::before,
  .logo-marquee::after {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 7rem;
    content: '';
    pointer-events: none;
  }

  .logo-marquee::before {
    left: 0;
    background: linear-gradient(90deg, #030407, transparent);
  }

  .logo-marquee::after {
    right: 0;
    background: linear-gradient(270deg, #030407, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    gap: 0.85rem;
    padding: 1rem;
    animation: logo-slide 30s linear infinite;
  }

  .logo-marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track figure {
    display: grid;
    width: 11rem;
    height: 6.2rem;
    flex: 0 0 auto;
    place-items: center;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: #05060a;
  }

  .marquee-track img {
    width: 78%;
    max-height: 3.5rem;
    object-fit: contain;
  }

  .section-heading {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1.2rem;
  }

  .section-heading h2,
  .accreditations-copy h2 {
    max-width: 760px;
    --h2-size: clamp(2rem, 3.7vw, 4rem);
    font-size: var(--h2-size);
    line-height: 1.02;
  }

  .sectors-grid,
  .reference-wall,
  .featured-cases,
  .accreditations-panel {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .sector-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .sector-cards article {
    min-height: 13rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.1rem;
    background:
      radial-gradient(circle at 16% 0%, rgba(124, 60, 255, 0.14), transparent 12rem),
      rgba(255, 255, 255, 0.02);
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .sector-cards article:hover {
    border-color: rgba(124, 60, 255, 0.45);
    background: rgba(124, 60, 255, 0.055);
    transform: translateY(-4px);
  }

  .sector-cards span {
    color: var(--purple-soft);
    font-size: 3rem;
    font-weight: 900;
    line-height: 0.9;
  }

  .sector-cards h3 {
    margin-top: 1.3rem;
    color: #fff;
    font-size: 1.25rem;
  }

  .sector-cards p {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .reference-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .reference-card {
    display: grid;
    min-height: 15rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .reference-card:hover {
    border-color: rgba(124, 60, 255, 0.46);
    background: rgba(124, 60, 255, 0.05);
    transform: translateY(-4px);
  }

  .reference-card figure {
    display: grid;
    min-height: 7.4rem;
    place-items: center;
    margin: 0;
    background: #05060a;
  }

  .reference-card img {
    width: 74%;
    max-height: 4.2rem;
    object-fit: contain;
  }

  .reference-card div {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 0.95rem;
  }

  .reference-card span,
  .case-card span {
    color: var(--purple-soft);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reference-card h3 {
    color: #fff;
    font-size: 1.0625rem;
    line-height: 1.15;
  }

  .reference-card p {
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .case-card {
    position: relative;
    min-height: 360px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .case-card:hover {
    border-color: rgba(124, 60, 255, 0.5);
    transform: translateY(-4px);
  }

  .case-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.02) brightness(0.78);
    transition: transform 500ms ease, filter 500ms ease;
  }

  .case-card:hover img {
    filter: saturate(1.08) brightness(0.88);
    transform: scale(1.045);
  }

  .case-card::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 28%, rgba(3, 4, 7, 0.84));
    content: '';
  }

  .case-card div {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(3, 4, 7, 0.72);
    backdrop-filter: blur(14px);
  }

  .case-card h3 {
    margin-top: 0.35rem;
    font-size: clamp(1.55rem, 2.7vw, 2.4rem);
    line-height: 1;
  }

  .case-card p {
    margin-top: 0.35rem;
    color: rgba(255, 255, 255, 0.72);
  }

