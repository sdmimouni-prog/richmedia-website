---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChecklistLandingPageConversionPage from '../../../components/ChecklistLandingPageConversionPage.astro';
import { SITE } from '../../../consts';
import { breadcrumbs, localBusiness } from '../../../lib/schema';

const pageUrl = `${SITE.url}/en/tools/landing-page-conversion-checklist/`;
const pageDescription =
  'Download the free Richmedia checklist: 35 checks to optimize your landing page, form, CTA, mobile, tracking and conversion.';
const downloadHref = '/downloads/checklist_landing_page_conversion_richmedia.pdf';
const downloadFilename = 'checklist_landing_page_conversion_richmedia.pdf';
const ogImage = '/assets/richmedia-tools/checklist-landing-page-conversion/checklist-landing-page-page-1.webp';

const schema = [
  {
    ...localBusiness(),
    url: pageUrl,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'DigitalDocument',
    '@id': `${pageUrl}#checklist`,
    name: 'Landing Page Conversion Checklist — Richmedia',
    description: pageDescription,
    url: pageUrl,
    encodingFormat: 'application/pdf',
    inLanguage: 'en',
    publisher: { '@id': `${SITE.url}/#organization` },
    isAccessibleForFree: true,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'MAD',
      availability: 'https://schema.org/InStock',
    },
  },
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Tools & resources', url: `${SITE.url}/en/tools` },
    { name: 'Landing Page Conversion Checklist', url: pageUrl },
  ]),
];
---

<BaseLayout
  lang="en"
  title="Landing Page Conversion Checklist | Richmedia"
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
  schema={schema}
>
  <ChecklistLandingPageConversionPage lang="en" downloadHref={downloadHref} downloadFilename={downloadFilename} />
</BaseLayout>
