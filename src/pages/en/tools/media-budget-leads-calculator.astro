---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BudgetLeadsCalculator from '../../../components/BudgetLeadsCalculator.astro';
import { SITE } from '../../../consts';
import { breadcrumbs, localBusiness, webApplicationSchema } from '../../../lib/schema';

const pageUrl = `${SITE.url}/en/tools/media-budget-leads-calculator/`;
const pageDescription =
  'Estimate your media budget or expected lead volume by sector and channel, using ranges observed by Richmedia.';

const schema = [
  localBusiness(),
  webApplicationSchema({
    id: 'calculator',
    name: 'Media Budget & Leads Calculator',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'en',
    featureList: [
      'Media budget estimate',
      'Lead volume projection',
      'Simulation by sector and marketing channels',
    ],
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Tools & resources', url: `${SITE.url}/en/tools` },
    { name: 'Media Budget & Leads Calculator', url: pageUrl },
  ]),
];
---

<BaseLayout
  lang="en"
  title="Media Budget & Leads Calculator | Richmedia"
  description={pageDescription}
  canonical={pageUrl}
  schema={schema}
>
  <BudgetLeadsCalculator lang="en" />
</BaseLayout>
