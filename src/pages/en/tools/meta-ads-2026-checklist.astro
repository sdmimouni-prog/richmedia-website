---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChecklistMetaAds2026Page from '../../../components/ChecklistMetaAds2026Page.astro';
import { SITE } from '../../../consts';
import { breadcrumbs, localBusiness } from '../../../lib/schema';

const pageUrl = `${SITE.url}/en/tools/meta-ads-2026-checklist/`;
const pageDescription =
  'Download the Richmedia checklist: 40 checks to optimize tracking, audiences, creatives, Lead Ads, CRM and Meta Ads performance.';
const downloadHref = '/downloads/checklist_meta_ads_2026_richmedia.pdf';
const downloadFilename = 'checklist_meta_ads_2026_richmedia.pdf';
const ogImage = '/assets/richmedia-tools/checklist-meta-ads-2026/checklist-meta-ads-page-1.webp';

const schema = [
  {
    ...localBusiness(),
    url: pageUrl,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'DigitalDocument',
    '@id': `${pageUrl}#checklist`,
    name: 'Meta Ads 2026 Checklist — Richmedia',
    description: pageDescription,
    url: pageUrl,
    encodingFormat: 'application/pdf',
    inLanguage: 'en',
    publisher: { '@id': `${SITE.url}/#organization` },
    isAccessibleForFree: true,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'MAD',
      availability: 'https://schema.org/InStock',
    },
  },
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Tools & resources', url: `${SITE.url}/en/tools` },
    { name: 'Meta Ads 2026 Checklist', url: pageUrl },
  ]),
];
---

<BaseLayout
  lang="en"
  title="Meta Ads 2026 Checklist | Facebook & Instagram | Richmedia"
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
  schema={schema}
>
  <ChecklistMetaAds2026Page lang="en" downloadHref={downloadHref} downloadFilename={downloadFilename} />
</BaseLayout>
