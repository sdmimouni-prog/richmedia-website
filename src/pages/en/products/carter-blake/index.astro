---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CarterBlakeLanding from '../../../../components/CarterBlakeLanding.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, localBusiness, serviceSchema, webPageSchema } from '../../../../lib/schema';

const pageUrl = `${SITE.url}/en/products/carter-blake/`;
const pageDescription =
  'Discover Carter & Blake, the political strategy and marketing firm for campaigns, opinion, social listening, influence and crisis communication.';

const schema = [
  localBusiness(),
  webPageSchema({
    name: 'Carter & Blake | Political Marketing',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'en',
  }),
  serviceSchema({
    name: 'Carter & Blake - Political marketing',
    description: pageDescription,
    url: pageUrl,
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Carter & Blake', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Carter & Blake | Political Marketing"
  description={pageDescription}
  canonical={pageUrl}
  lang="en"
  schema={schema}
>
  <CarterBlakeLanding lang="en" />
</BaseLayout>
