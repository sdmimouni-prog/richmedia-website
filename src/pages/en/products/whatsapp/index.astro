---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import WhatsAppLegacyLandingEn from '../../../../components/WhatsAppLegacyLandingEn.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, localBusiness, serviceSchema } from '../../../../lib/schema';

const pageDescription =
  'Discover Richmedia WhatsApp push solution: campaigns, follow-ups, data targeting, chatbots, reporting and compliant activation to convert faster.';

const schema = [
  {
    ...localBusiness(),
    url: `${SITE.url}/en/products/whatsapp`,
    description: pageDescription,
    inLanguage: 'en',
  },
  {
    ...serviceSchema({
      name: 'WhatsApp push solution',
      description: pageDescription,
      url: `${SITE.url}/en/products/whatsapp`,
    }),
    inLanguage: 'en',
  },
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Products', url: `${SITE.url}/en/products/whatsapp` },
    { name: 'WhatsApp push solution', url: `${SITE.url}/en/products/whatsapp` },
  ]),
];
---

<BaseLayout
  title="WhatsApp push solution - Richmedia"
  description={pageDescription}
  canonical={`${SITE.url}/en/products/whatsapp`}
  lang="en"
  schema={schema}
>
  <WhatsAppLegacyLandingEn />
</BaseLayout>
