---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import WhatsAppLegacyLandingEn from '../../../../components/WhatsAppLegacyLandingEn.astro';
import whatsappLegacyStylesheet from '../../../../styles/whatsapp-legacy.css?url';
import { SITE } from '../../../../consts';
import { breadcrumbs, localBusiness, serviceSchema, webPageSchema } from '../../../../lib/schema';

const pageUrl = `${SITE.url}/en/products/whatsapp/`;
const pageDescription =
  'Discover Richmedia WhatsApp push solution: campaigns, follow-ups, data targeting, chatbots, reporting and compliant activation to convert faster.';

const schema = [
  localBusiness(),
  webPageSchema({
    name: 'WhatsApp Campaign Push Solution | Richmedia',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'en',
  }),
  serviceSchema({
    name: 'WhatsApp push solution',
    description: pageDescription,
    url: pageUrl,
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'WhatsApp push solution', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="WhatsApp Campaign Push Solution | Richmedia"
  description={pageDescription}
  canonical={pageUrl}
  lang="en"
  extraStylesheets={[whatsappLegacyStylesheet]}
  schema={schema}
>
  <WhatsAppLegacyLandingEn />
</BaseLayout>
