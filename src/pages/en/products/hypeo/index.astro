---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import HypeoLanding from '../../../../components/HypeoLanding.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, localBusiness, serviceSchema, webPageSchema } from '../../../../lib/schema';

const pageUrl = `${SITE.url}/en/products/hypeo/`;
const pageDescription =
  'Discover Hypeo.ai, the AI influencer platform to match the right creators, generate briefs, manage campaigns and measure performance.';

const schema = [
  localBusiness(),
  webPageSchema({
    name: 'Hypeo.ai | AI Influencer Platform',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'en',
  }),
  serviceSchema({
    name: 'Hypeo.ai - AI influencer platform',
    description: pageDescription,
    url: pageUrl,
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Hypeo.ai', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Hypeo.ai | AI Influencer Platform"
  description={pageDescription}
  canonical={pageUrl}
  lang="en"
  schema={schema}
>
  <HypeoLanding lang="en" />
</BaseLayout>
