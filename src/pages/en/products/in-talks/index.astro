---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InTalksLanding from '../../../../components/InTalksLanding.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, localBusiness, serviceSchema, webPageSchema } from '../../../../lib/schema';

const pageUrl = `${SITE.url}/en/products/in-talks/`;
const pageDescription =
  'Discover In Talks, the Moroccan social listening platform to monitor mentions, analyze sentiment, track competitors and protect your online reputation.';

const schema = [
  localBusiness(),
  webPageSchema({
    name: 'In Talks | Social Listening Platform',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'en',
  }),
  serviceSchema({
    name: 'In Talks - Social listening platform',
    description: pageDescription,
    url: pageUrl,
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'In Talks', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="In Talks | Social Listening Platform"
  description={pageDescription}
  canonical={pageUrl}
  lang="en"
  schema={schema}
>
  <InTalksLanding lang="en" />
</BaseLayout>
