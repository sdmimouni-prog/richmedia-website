---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getInsightFilters, getInsightTopicCounts } from '../../../lib/insights';
import { breadcrumbs } from '../../../lib/schema';
import { SITE } from '../../../consts';

const pageUrl = `${SITE.url}/en/insights`;
const contentEntries = await getCollection('articles', ({ data }) => !data.draft && data.lang === 'en');
const caseEntries = await getCollection('cas', ({ data }) => !data.draft && data.lang === 'en');
const articleBySlug = new Map(
  contentEntries.map((entry) => [entry.data.slug ?? entry.id, {
    slug: entry.data.slug ?? entry.id,
    title: entry.data.title,
    description: entry.data.metaDescription,
    category: entry.data.categorie,
    filterGroups: getInsightFilters(entry),
    searchText: [
      entry.data.title,
      entry.data.metaDescription,
      entry.data.categorie,
      entry.data.keywordPrincipal,
      ...entry.data.keywordsSecondaires,
    ].join(' '),
    date: entry.data.datePublication,
    readingTime: entry.data.tempsLecture ?? 6,
  }])
);

const articleImages: Record<string, string> = {
  'digital-priorities-2026-profitable-growth': '/assets/richmedia-digital-strategy/strategy-workshop.webp',
  'data-for-decisions-performance-strategy': '/assets/richmedia-achat-media/media-traffic-manager.webp',
  'seo-vs-geo-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'meta-campaigns-2026-best-practices': '/assets/richmedia-achat-media/media-creative-tests.webp',
  'whatsapp-business-conversion-channel': '/assets/richmedia-ia-automation/whatsapp-agent.webp',
  'creators-brands-durable-collaborations': '/assets/richmedia-influence/creator-lifestyle.webp',
  'digital-acquisition-plan-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'employer-brand-digital-attractiveness': '/assets/richmedia-agence/agence-collaboration.webp',
  'google-ads-campaign-cost-morocco': '/assets/richmedia-achat-media/achat-media-hero.webp',
  'quality-content-durable-seo': '/assets/richmedia-brand-content/brand-content-hero.webp',
  'crm-automation-marketing-sales-alignment': '/assets/richmedia-ia-automation/crm-automation.webp',
};

const categoryLabels = {
  Growth: 'Strategy',
  Media: 'Media & performance',
  SEO: 'SEO / GEO',
  Social: 'Influence & social media',
  Secteur: 'Guides',
};

const articleOrder = [
  'digital-priorities-2026-profitable-growth',
  'data-for-decisions-performance-strategy',
  'seo-vs-geo-2026',
  'meta-campaigns-2026-best-practices',
  'whatsapp-business-conversion-channel',
  'creators-brands-durable-collaborations',
  'digital-acquisition-plan-2026',
  'employer-brand-digital-attractiveness',
  'google-ads-campaign-cost-morocco',
  'quality-content-durable-seo',
  'crm-automation-marketing-sales-alignment',
];

const articles = articleOrder
  .map((slug) => articleBySlug.get(slug))
  .filter((article): article is NonNullable<typeof article> => Boolean(article))
  .map((article) => ({
    ...article,
    href: `/en/insights/${article.slug}`,
    image: articleImages[article.slug] ?? '/og-default.jpg',
    displayCategory: categoryLabels[article.category] ?? article.category,
  }));

const topArticle = articles[0];
const featuredArticle = articles[1];
const gridArticles = articles.slice(2, 6);
const listArticles = articles.slice(6, 11);
const chips = [
  { label: 'All', filter: 'all' },
  { label: 'Strategy', filter: 'Growth' },
  { label: 'Media & performance', filter: 'Media' },
  { label: 'SEO / GEO', filter: 'SEO' },
  { label: 'WhatsApp & automation', filter: 'Automation' },
  { label: 'Influence & social media', filter: 'Social' },
  { label: 'Guides', filter: 'Secteur' },
  { label: 'Case studies', href: '/en/case-studies' },
];
const topicCounts = getInsightTopicCounts(contentEntries, caseEntries);
const topics = [
  ['Digital strategy', topicCounts.Growth],
  ['Media & performance', topicCounts.Media],
  ['SEO / GEO', topicCounts.SEO],
  ['WhatsApp & automation', topicCounts.Automation],
  ['Influence & social media', topicCounts.Social],
  ['Guides', topicCounts.Secteur],
  ['Case studies', topicCounts.Case],
];
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);
const schema = [breadcrumbs([
  { name: 'Home', url: `${SITE.url}/en` },
  { name: 'Insights', url: pageUrl },
])];
---

<BaseLayout
  title="Digital Marketing Insights in Morocco | Richmedia"
  description="Guides and analysis on digital strategy, media, SEO/GEO, WhatsApp, automation, influence, social media and growth in Morocco."
  canonical={pageUrl}
  lang="en"
  schema={schema}
>
  <div class="insights-page">
    <section class="insights-hero" aria-labelledby="insights-title">
      <div class="hero-copy">
        <span class="section-kicker">Richmedia Insights</span>
        <h1 id="insights-title">All insights</h1>
        <p>
          Articles, analysis, guides and field notes to understand the levers that accelerate digital performance:
          strategy, media, SEO/GEO, social media, WhatsApp, automation and growth.
        </p>
        <div class="hero-actions">
          <a class="primary-btn" href="/en/contact">Discuss a project <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          <a class="ghost-btn" href="/en/references">View our work <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>

      <a
        class="top-feature"
        href={topArticle.href}
        aria-label={`Read ${topArticle.title}`}
        data-article-card
        data-category={topArticle.category}
        data-filters={topArticle.filterGroups.join(' ')}
        data-title={topArticle.searchText}
      >
        <figure><img src={topArticle.image} alt="" width="620" height="420" loading="eager" decoding="async" fetchpriority="high" /></figure>
        <div>
          <span>{topArticle.displayCategory}</span>
          <h2>{topArticle.title}</h2>
          <p>{topArticle.description}</p>
          <small><i class="ph ph-clock" aria-hidden="true"></i>{topArticle.readingTime} min read <i class="ph ph-calendar-blank" aria-hidden="true"></i>{formatDate(topArticle.date)}</small>
        </div>
      </a>
    </section>

    <section class="insight-controls" aria-label="Search and filters">
      <label class="search-field">
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
        <input type="search" data-insight-search placeholder="Search an article, topic or keyword..." />
      </label>
      <button class="filter-button" type="button"><i class="ph ph-sliders-horizontal" aria-hidden="true"></i> Filters</button>
    </section>

    <nav class="chip-row" aria-label="Insight categories">
      {chips.map((chip) => (
        'href' in chip ? (
          <a class="chip" href={chip.href}>{chip.label}</a>
        ) : (
          <button type="button" class:list={['chip', chip.filter === 'all' && 'is-active']} data-filter={chip.filter}>{chip.label}</button>
        )
      ))}
    </nav>

    <section
      class="editorial-feature"
      id="featured"
      aria-labelledby="featured-title"
      data-article-card
      data-category={featuredArticle.category}
      data-filters={featuredArticle.filterGroups.join(' ')}
      data-title={featuredArticle.searchText}
    >
      <img src={featuredArticle.image} alt="" width="560" height="330" loading="lazy" decoding="async" />
      <div>
        <span class="section-kicker">Featured article</span>
        <h2 id="featured-title">{featuredArticle.title}</h2>
        <p>{featuredArticle.description}</p>
        <small><i class="ph ph-clock" aria-hidden="true"></i>{featuredArticle.readingTime} min read <i class="ph ph-calendar-blank" aria-hidden="true"></i>{formatDate(featuredArticle.date)}</small>
      </div>
      <a class="outline-link" href={featuredArticle.href}>Read article <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </section>

    <section class="article-section" id="all-articles" aria-labelledby="articles-title">
      <div class="section-heading">
        <h2 id="articles-title">All articles</h2>
        <a href="/en/insights#more-articles">View all articles <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="article-grid">
        {gridArticles.map((article) => (
          <a class="article-card" href={article.href} data-article-card data-category={article.category} data-filters={article.filterGroups.join(' ')} data-title={article.searchText}>
            <img src={article.image} alt="" width="420" height="230" loading="lazy" decoding="async" />
            <div>
              <span>{article.displayCategory}</span>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
              <small><i class="ph ph-clock" aria-hidden="true"></i>{article.readingTime} min <i class="ph ph-calendar-blank" aria-hidden="true"></i>{formatDate(article.date)}</small>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="more-layout" id="more-articles" aria-label="More articles">
      <div class="more-list">
        <div class="more-list-heading">
          <span class="section-kicker">Keep reading</span>
          <h2>More articles</h2>
        </div>
        {listArticles.map((article) => (
          <a class="more-row" href={article.href} data-article-card data-category={article.category} data-filters={article.filterGroups.join(' ')} data-title={article.searchText}>
            <img src={article.image} alt="" width="128" height="82" loading="lazy" decoding="async" />
            <div>
              <span>{article.displayCategory}</span>
              <strong>{article.title}</strong>
              <p>{article.description}</p>
              <small><i class="ph ph-clock" aria-hidden="true"></i>{article.readingTime} min read <i class="ph ph-calendar-blank" aria-hidden="true"></i>{formatDate(article.date)}</small>
            </div>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        ))}
      </div>

      <aside class="insights-sidebar">
        <section class="sidebar-card">
          <h2>Popular topics</h2>
          <ul>{topics.map(([topic, count]) => <li><span>{topic}</span><strong>{count}</strong></li>)}</ul>
        </section>
        <section class="sidebar-card newsletter">
          <h2>Stay up to date</h2>
          <p>Get our latest insights, trends and case studies.</p>
          <form action="/api/contact" method="post" data-contact-form>
            <input type="hidden" name="form" value="newsletter insights en" />
            <input type="email" name="email" placeholder="your@email.com" required />
            <button type="submit">Subscribe</button>
          </form>
          <small>No spam. One-click unsubscribe.</small>
        </section>
      </aside>
    </section>

    <section class="insights-cta">
      <div>
        <span class="section-kicker">Let's talk growth</span>
        <h2>Questions about your digital strategy?<br />Talk to our experts.</h2>
      </div>
      <div class="cta-actions">
        <a class="primary-btn" href="/en/contact">Discuss a project <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        <a class="ghost-btn" href="/en/expertises">Explore our expertise <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) { width: min(100% - 3rem, 1320px); max-width: 1320px; }
  .insights-page { --panel: rgba(13,14,22,.82); --line: rgba(255,255,255,.12); --muted: rgba(255,255,255,.68); display: grid; gap: clamp(1.6rem,3vw,2.8rem); padding-top: clamp(1rem,3vw,2.2rem); }
  h1, h2, h3, p { margin: 0; }
  .section-kicker { display: inline-flex; align-items: center; gap: .75rem; color: #a985ff; font-size: .78rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .section-kicker::before { content: ""; width: 3.8rem; height: 2px; background: linear-gradient(90deg,#8a4dff,#b864ff); }
  .insights-hero { display: grid; grid-template-columns: minmax(0,.85fr) minmax(560px,1.15fr); gap: clamp(2rem,5vw,7rem); align-items: center; min-height: 380px; }
  .hero-copy { display: grid; gap: 1.35rem; max-width: 580px; }
  .hero-copy h1 { color: #fff; font-size: clamp(3.2rem,6vw,6.4rem); font-weight: 900; letter-spacing: 0; line-height: .94; }
  .hero-copy p, .top-feature p, .editorial-feature p, .article-card p, .newsletter p { color: var(--muted); font-size: 1rem; line-height: 1.65; }
  .hero-actions, .cta-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .4rem; }
  .primary-btn, .ghost-btn, .outline-link, .filter-button { display: inline-flex; max-width: 100%; min-height: 3.1rem; align-items: center; justify-content: center; gap: .65rem; border-radius: 8px; padding: 0 1.15rem; color: #fff; font-size: clamp(.82rem,.95vw,.94rem); font-weight: 850; line-height: 1; text-decoration: none; white-space: nowrap; transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease; }
  .primary-btn i, .ghost-btn i, .outline-link i, .filter-button i { flex: 0 0 auto; font-size: 1.08em; }
  .primary-btn { border: 1px solid rgba(168,108,255,.7); background: linear-gradient(135deg,#8b4cff,#6426f4); box-shadow: 0 18px 42px rgba(117,62,255,.28); }
  .ghost-btn, .outline-link, .filter-button { border: 1px solid var(--line); background: rgba(255,255,255,.035); }
  .primary-btn:hover, .ghost-btn:hover, .outline-link:hover, .filter-button:hover { transform: translateY(-2px); border-color: rgba(168,108,255,.72); box-shadow: 0 18px 40px rgba(121,75,255,.18); }
  .top-feature { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(260px,.95fr); min-height: 330px; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: radial-gradient(circle at 72% 10%,rgba(139,76,255,.16),transparent 18rem), var(--panel); color: #fff; text-decoration: none; transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease; }
  .top-feature:hover, .top-feature:focus-visible, .article-card:hover, .article-card:focus-visible, .more-row:hover, .more-row:focus-visible, .editorial-feature:hover { transform: translateY(-4px); border-color: rgba(168,108,255,.5); box-shadow: 0 24px 60px rgba(105,55,255,.18); }
  .top-feature figure, .top-feature img, .editorial-feature > img { width: 100%; height: 100%; }
  .article-card > img, .more-row img { width: 100%; }
  .top-feature figure { margin: 0; overflow: hidden; }
  .top-feature img, .editorial-feature > img, .article-card > img, .more-row img { display: block; object-fit: cover; }
  .top-feature > div { display: grid; align-content: center; gap: .85rem; padding: clamp(1.2rem,2vw,1.8rem); }
  .top-feature span, .article-card span, .more-row span { color: #a985ff; font-size: .68rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  .top-feature h2 { color: #fff; font-size: clamp(1.55rem,2.1vw,2.25rem); line-height: 1.12; }
  small { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; color: rgba(255,255,255,.55); font-weight: 700; }
  .insight-controls { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 1rem; }
  .search-field { display: flex; min-height: 3.2rem; align-items: center; gap: .75rem; border: 1px solid var(--line); border-radius: 8px; padding: 0 1rem; background: rgba(255,255,255,.035); color: rgba(255,255,255,.72); }
  .search-field input { width: 100%; border: 0; outline: 0; background: transparent; color: #fff; font: inherit; }
  .search-field input::placeholder { color: rgba(255,255,255,.45); }
  .chip-row { display: flex; flex-wrap: wrap; gap: .7rem; }
  .chip { display: inline-flex; align-items: center; justify-content: center; min-height: 2.5rem; border: 1px solid var(--line); border-radius: 8px; padding: 0 1rem; background: rgba(255,255,255,.04); color: rgba(255,255,255,.78); cursor: pointer; font: inherit; font-size: .86rem; font-weight: 800; line-height: 1; text-decoration: none; white-space: nowrap; transition: background .18s ease, border-color .18s ease, transform .18s ease; }
  .chip:hover, .chip.is-active { border-color: rgba(168,108,255,.75); background: linear-gradient(135deg,rgba(139,76,255,.95),rgba(100,38,244,.95)); color: #fff; transform: translateY(-1px); }
  .editorial-feature { display: grid; grid-template-columns: .44fr minmax(0,1fr) auto; gap: clamp(1.2rem,3vw,3rem); align-items: center; border: 1px solid var(--line); border-radius: 8px; padding: clamp(1rem,2vw,1.55rem); background: radial-gradient(circle at 88% 18%,rgba(139,76,255,.13),transparent 20rem), var(--panel); transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease; }
  .editorial-feature > img { height: clamp(220px,22vw,330px); aspect-ratio: 16 / 9; border-radius: 6px; }
  .editorial-feature div { display: grid; gap: .8rem; }
  .editorial-feature h2 { color: #fff; font-size: clamp(1.55rem,2.6vw,2.45rem); line-height: 1.1; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
  .section-heading h2, .more-list h2, .sidebar-card h2 { color: #fff; font-size: clamp(1.45rem,2.3vw,2rem); line-height: 1.1; }
  .section-heading a { color: #a985ff; font-weight: 850; text-decoration: none; }
  .article-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1rem; }
  .article-card { display: grid; grid-template-rows: auto 1fr; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); color: #fff; text-decoration: none; transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease; }
  .article-card > img { height: auto; aspect-ratio: 1.7 / 1; object-fit: cover; }
  .article-card > div { display: grid; gap: .55rem; padding: 1rem; }
  .article-card h3 { color: #fff; font-size: 1.22rem; line-height: 1.14; }
  .more-layout { display: grid; grid-template-columns: minmax(0,1fr) minmax(280px,360px); gap: clamp(1rem,2.4vw,1.8rem); align-items: start; }
  .more-list { display: grid; gap: .9rem; border: 1px solid var(--line); border-radius: 8px; padding: clamp(1rem,2vw,1.35rem); background: radial-gradient(circle at 92% 10%,rgba(139,76,255,.16),transparent 18rem), var(--panel); }
  .more-list-heading { display: grid; gap: .55rem; margin-bottom: .15rem; }
  .more-list-heading .section-kicker { font-size: .68rem; }
  .more-list-heading .section-kicker::before { width: 2.6rem; }
  .more-row { display: grid; grid-template-columns: minmax(104px,.18fr) minmax(0,1fr) 2.45rem; gap: 1rem; align-items: center; min-height: 118px; border: 1px solid rgba(255,255,255,.1); border-radius: 8px; padding: .75rem; background: rgba(255,255,255,.035); color: #fff; text-decoration: none; transition: transform .18s ease, background .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .more-row img { width: 100%; height: 100%; min-height: 92px; aspect-ratio: 1.35 / 1; border-radius: 6px; object-fit: cover; }
  .more-row div { display: grid; align-content: center; gap: .35rem; min-width: 0; }
  .more-row strong { max-width: 46rem; font-size: clamp(1.05rem,1.45vw,1.3rem); line-height: 1.18; }
  .more-row p { display: -webkit-box; overflow: hidden; margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .more-row > i { display: grid; width: 2.45rem; height: 2.45rem; place-items: center; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.035); color: rgba(255,255,255,.55); font-size: 1rem; transition: transform .18s ease, color .18s ease, border-color .18s ease; }
  .more-row:hover > i, .more-row:focus-visible > i { transform: translate(2px,-2px); border-color: rgba(168,108,255,.55); color: #fff; }
  .insights-sidebar { position: sticky; top: 6rem; display: grid; gap: 1rem; }
  .sidebar-card { display: grid; gap: 1rem; border: 1px solid var(--line); border-radius: 8px; padding: 1.2rem; background: var(--panel); }
  .sidebar-card ul { display: grid; gap: .65rem; margin: 0; padding: 0; list-style: none; }
  .sidebar-card li { display: flex; justify-content: space-between; gap: 1rem; color: rgba(255,255,255,.72); }
  .sidebar-card li strong { min-width: 2rem; border: 1px solid var(--line); border-radius: 6px; color: #fff; font-size: .8rem; text-align: center; }
  .newsletter form { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: .6rem; }
  .newsletter input, .newsletter button { min-height: 2.8rem; border-radius: 8px; font: inherit; }
  .newsletter input { border: 1px solid var(--line); padding: 0 .85rem; background: rgba(255,255,255,.04); color: #fff; }
  .newsletter button { border: 1px solid rgba(168,108,255,.7); padding: 0 1rem; background: linear-gradient(135deg,#8b4cff,#6426f4); color: #fff; font-weight: 850; white-space: nowrap; }
  .newsletter small { color: rgba(255,255,255,.45); }
  .insights-cta { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; overflow: hidden; border: 1px solid rgba(168,108,255,.25); border-radius: 8px; padding: clamp(1.2rem,3vw,2rem); background: radial-gradient(circle at 88% 58%,rgba(137,74,255,.44),transparent 16rem), linear-gradient(135deg,rgba(90,35,176,.42),rgba(13,14,22,.92)); }
  .insights-cta > div:first-child { min-width: 0; }
  .insights-cta .cta-actions { flex: 0 0 auto; justify-content: flex-end; }
  .insights-cta h2 { margin-top: .8rem; color: #fff; font-size: clamp(1.65rem,3vw,2.8rem); line-height: 1.05; }
  [data-article-card].is-hidden { display: none; }
  @media (max-width: 1180px) { .insights-hero, .top-feature, .editorial-feature, .more-layout { grid-template-columns: 1fr; } .insights-sidebar { position: static; grid-template-columns: repeat(2,minmax(0,1fr)); } .article-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .outline-link { width: fit-content; } .editorial-feature > img { height: 260px; } }
  @media (max-width: 700px) { .insights-page { gap: 1.6rem; } .insights-hero { min-height: auto; } .hero-copy h1 { font-size: clamp(2.7rem,15vw,4.4rem); } .insight-controls, .article-grid, .insights-sidebar, .newsletter form { grid-template-columns: 1fr; } .more-list { padding: 1rem; } .more-row { grid-template-columns: 82px minmax(0,1fr); gap: .85rem; min-height: auto; padding: .65rem; } .more-row img { min-height: 72px; } .more-row p { display: none; } .more-row > i { display: none; } .editorial-feature > img { height: 210px; } .insights-cta, .section-heading { align-items: flex-start; flex-direction: column; } .hero-actions, .cta-actions, .insights-cta .cta-actions { width: 100%; } .primary-btn, .ghost-btn, .outline-link, .filter-button { min-height: 2.9rem; padding-inline: .85rem; font-size: clamp(.72rem,3.2vw,.86rem); } .insights-cta .primary-btn, .insights-cta .ghost-btn { width: 100%; } }
</style>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('[data-insight-search]');
  const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
  const cards = Array.from(document.querySelectorAll('[data-article-card]'));
  let activeFilter = 'all';
  const normalize = (value: string) => value.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
  const applyFilters = () => {
    const term = normalize(searchInput?.value ?? '');
    cards.forEach((card) => {
      const filters = (card.getAttribute('data-filters') ?? card.getAttribute('data-category') ?? '').split(' ');
      const haystack = normalize(card.getAttribute('data-title') ?? '');
      const matchesFilter = activeFilter === 'all' || filters.includes(activeFilter);
      const matchesSearch = !term || haystack.includes(term);
      card.classList.toggle('is-hidden', !(matchesFilter && matchesSearch));
    });
  };
  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.getAttribute('data-filter') ?? 'all';
      filterButtons.forEach((item) => item.classList.toggle('is-active', item === button));
      applyFilters();
    });
  });
  searchInput?.addEventListener('input', applyFilters);
</script>
