---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleDetailPage from '../../../components/ArticleDetailPage.astro';
import { articleSchema, authorCanonicalUrl, authorPersonId, breadcrumbs } from '../../../lib/schema';
import { getEditorialAuthor, getEditorialAuthorPath, getEditorialAuthorStrict, SITE } from '../../../consts';

const categoryLabels: Record<string, string> = {
  Growth: 'Strategy',
  Media: 'Media & performance',
  SEO: 'SEO / GEO',
  Social: 'Influence & social media',
  Secteur: 'Sectors',
};

const articleImages: Record<string, string> = {
  'how-to-choose-communication-agency': '/assets/richmedia-agence/agence-collaboration.webp',
  'digital-priorities-2026-profitable-growth': '/assets/richmedia-digital-strategy/strategy-workshop.webp',
  'digital-acquisition-plan-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'meta-campaigns-2026-best-practices': '/assets/richmedia-achat-media/media-creative-tests.webp',
  'seo-vs-geo-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'whatsapp-business-conversion-channel': '/assets/richmedia-ia-automation/whatsapp-agent.webp',
  'creators-brands-durable-collaborations': '/assets/richmedia-influence/creator-lifestyle.webp',
  'how-much-does-an-influencer-cost-in-morocco': '/assets/richmedia-influence/influence-hero.webp',
  'data-for-decisions-performance-strategy': '/assets/richmedia-achat-media/media-traffic-manager.webp',
  'employer-brand-digital-attractiveness': '/assets/richmedia-agence/agence-collaboration.webp',
  'quality-content-durable-seo': '/assets/richmedia-brand-content/brand-content-hero.webp',
  'crm-automation-marketing-sales-alignment': '/assets/richmedia-ia-automation/crm-automation.webp',
  'google-ads-campaign-cost-morocco': '/assets/richmedia-achat-media/achat-media-hero.webp',
  'cost-per-lead-morocco-industry-benchmarks': '/assets/richmedia-tools/hero-dashboard.webp',
};

const toArticleCard = (entry: any) => {
  const slug = entry.data.slug ?? entry.id;
  return {
    href: `/en/insights/${slug}`,
    title: entry.data.title,
    description: entry.data.metaDescription,
    category: categoryLabels[entry.data.categorie] ?? entry.data.categorie,
    image: articleImages[slug] ?? entry.data.ogImage ?? '/og-default.jpg',
    readingTime: entry.data.tempsLecture ?? 6,
    date: entry.data.datePublication,
  };
};

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft && data.lang === 'en');
  return entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.data.slug ?? entry.id;
const url = `${SITE.url}/en/insights/${slug}`;
const image = articleImages[slug] ?? entry.data.ogImage ?? '/og-default.jpg';
const allEntries = (await getCollection('articles', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime());
const otherEntries = allEntries.filter((article) => (article.data.slug ?? article.id) !== slug);
const recentArticles = otherEntries.slice(0, 4).map(toArticleCard);
const relatedArticles = otherEntries
  .filter((article) => article.data.categorie === entry.data.categorie)
  .slice(0, 4)
  .map(toArticleCard);
const fallbackRelated = relatedArticles.length > 0 ? relatedArticles : recentArticles.slice(0, 4);
const categoryLabel = categoryLabels[entry.data.categorie] ?? entry.data.categorie;
const schemaImage = image.startsWith('/') ? `${SITE.url}${image}` : image;
const influenceCostArticle = slug === 'how-much-does-an-influencer-cost-in-morocco';
const ctaTitle = influenceCostArticle
  ? 'Planning an influencer campaign in Morocco?'
  : 'Questions about your digital strategy? Let’s talk with our experts.';
const ctaPrimary = influenceCostArticle ? 'Explore our Influence expertise' : 'Discuss a project';
const ctaPrimaryHref = influenceCostArticle ? '/influencer-marketing-morocco' : '/en/contact';
const ctaSecondary = influenceCostArticle ? 'Contact the Richmedia team' : 'Explore our expertise';
const ctaSecondaryHref = influenceCostArticle ? '/en/contact' : '/en/expertises';
const authorProfile = getEditorialAuthorStrict(entry.data.auteur, `article "${slug}"`) ?? getEditorialAuthor();
const authorImage = authorProfile.image.startsWith('/') ? `${SITE.url}${authorProfile.image}` : authorProfile.image;
const schema = [
  articleSchema({
    title: entry.data.title,
    description: entry.data.metaDescription,
    url,
    author: {
      '@type': 'Person',
      '@id': authorPersonId(authorProfile.slug),
      name: authorProfile.name,
      url: authorCanonicalUrl(authorProfile.slug),
      image: authorImage,
    },
    datePublished: entry.data.datePublication,
    dateModified: entry.data.dateModification,
    image: schemaImage,
    citation: entry.data.sources.map((source) => source.url),
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Insights', url: `${SITE.url}/en/insights` },
    { name: entry.data.title, url },
  ]),
];
---

<BaseLayout
  title={entry.data.metaTitle ?? entry.data.title}
  description={entry.data.metaDescription}
  canonical={url}
  ogImage={schemaImage}
  lang="en"
  ogType="article"
  articlePublishedTime={entry.data.datePublication}
  articleModifiedTime={entry.data.dateModification}
  articleAuthor={authorProfile.name}
  articleSection={entry.data.categorie}
  schema={schema}
>
  <ArticleDetailPage
    lang="en"
    breadcrumbLabel="Insights"
    breadcrumbHref="/en/insights"
    categoryLabel={categoryLabel}
    title={entry.data.title}
    description={entry.data.metaDescription}
    author={authorProfile.name}
    authorRole={authorProfile.role.en}
    authorBio={authorProfile.bio.en}
    authorImage={authorProfile.image}
    authorUrl={getEditorialAuthorPath(entry.data.auteur, 'en')}
    date={entry.data.datePublication}
    readingTime={entry.data.tempsLecture ?? 6}
    image={image}
    quickAnswer={entry.data.quickAnswer}
    tags={[entry.data.keywordPrincipal, ...entry.data.keywordsSecondaires].slice(0, 4)}
    recentArticles={recentArticles}
    relatedArticles={fallbackRelated}
    faq={entry.data.faq}
    sources={entry.data.sources}
    ctaTitle={ctaTitle}
    ctaPrimary={ctaPrimary}
    ctaPrimaryHref={ctaPrimaryHref}
    ctaSecondary={ctaSecondary}
    ctaSecondaryHref={ctaSecondaryHref}
    newsletterTitle="Stay in the loop"
    newsletterDescription="Receive our latest insights, trends and case studies."
    newsletterButton="Subscribe"
    relatedTitle="Related articles"
    recentTitle="Recent articles"
    authorTitle="About the author"
  >
    <Content />
  </ArticleDetailPage>
</BaseLayout>
