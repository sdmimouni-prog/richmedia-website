---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { authorProfileSchema, breadcrumbs } from '../../../lib/schema';
import { EDITORIAL_AUTHOR_LIST, SITE, getEditorialAuthorBySlug } from '../../../consts';

const categoryLabels: Record<string, string> = {
  Growth: 'Strategy',
  Media: 'Media & performance',
  SEO: 'SEO / GEO',
  Social: 'Influence & social media',
  Secteur: 'Guides',
};

const articleImages: Record<string, string> = {
  'digital-priorities-2026-profitable-growth': '/assets/richmedia-digital-strategy/strategy-workshop.webp',
  'digital-acquisition-plan-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'meta-campaigns-2026-best-practices': '/assets/richmedia-achat-media/media-creative-tests.webp',
  'seo-vs-geo-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'whatsapp-business-conversion-channel': '/assets/richmedia-ia-automation/whatsapp-agent.webp',
  'creators-brands-durable-collaborations': '/assets/richmedia-influence/creator-lifestyle.webp',
  'data-for-decisions-performance-strategy': '/assets/richmedia-achat-media/media-traffic-manager.webp',
  'employer-brand-digital-attractiveness': '/assets/richmedia-agence/agence-collaboration.webp',
  'quality-content-durable-seo': '/assets/richmedia-brand-content/brand-content-hero.webp',
  'crm-automation-marketing-sales-alignment': '/assets/richmedia-ia-automation/crm-automation.webp',
  'google-ads-campaign-cost-morocco': '/assets/richmedia-achat-media/achat-media-hero.webp',
};

const expertiseIcons = ['ph-target', 'ph-chart-line-up', 'ph-magnifying-glass', 'ph-chat-circle-text', 'ph-database', 'ph-rocket-launch'];

export async function getStaticPaths() {
  return EDITORIAL_AUTHOR_LIST.map((author) => ({
    params: { slug: author.slug },
    props: { authorSlug: author.slug },
  }));
}

const { authorSlug } = Astro.props;
const author = getEditorialAuthorBySlug(authorSlug);
const pageUrl = `${SITE.url}/en/authors/${author.slug}`;
const authorSeoDescriptions: Record<string, string> = {
  'salah-eddine-mimouni': 'Salah Eddine MIMOUNI shares insights on digital strategy, media, SEO/GEO, WhatsApp, CRM and automation for growing brands.',
  'amal-amazouz': 'Amal AMAZOUZ shares insights on digital strategy, content, social media and influence to turn ideas into measurable action plans.',
  'tarik-el-abbadi': 'Tarik EL ABBADI shares insights on communication, events, employer brand and consistent brand experiences.',
};
const seoDescription = authorSeoDescriptions[author.slug] ?? author.bio.en;
const allEntries = (await getCollection('articles', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime());
const authorEntries = allEntries.filter((entry) => entry.data.auteur === author.name);
const recommendedEntries = allEntries.filter((entry) => entry.data.auteur !== author.name).slice(0, 4);
const categoryCount = new Set(authorEntries.map((entry) => entry.data.categorie)).size;
const articleCount = authorEntries.length;
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'short', year: 'numeric' }).format(date);
const toArticleCard = (entry: (typeof allEntries)[number]) => {
  const slug = entry.data.slug ?? entry.id;
  return {
    href: `/en/insights/${slug}`,
    title: entry.data.title,
    description: entry.data.metaDescription,
    category: categoryLabels[entry.data.categorie] ?? entry.data.categorie,
    image: articleImages[slug] ?? entry.data.ogImage ?? '/og-default.jpg',
    readingTime: entry.data.tempsLecture ?? 6,
    date: entry.data.datePublication,
  };
};
const authorArticles = authorEntries.map(toArticleCard);
const recommendedArticles = recommendedEntries.map(toArticleCard);
const topicRows = author.topics.en.map((topic) => ({
  label: topic,
  count: authorEntries.filter((entry) => (categoryLabels[entry.data.categorie] ?? entry.data.categorie) === topic).length,
}));
const schema = [
  authorProfileSchema({
    author,
    lang: 'en',
    profileUrl: pageUrl,
    profileName: `${author.name} | Richmedia author`,
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Insights', url: `${SITE.url}/en/insights` },
    { name: author.name, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={`${author.name} - Richmedia author`}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${author.portrait}`}
  lang="en"
  schema={schema}
>
  <div class="author-page">
    <nav class="author-breadcrumb" aria-label="Breadcrumb">
      <a href="/en/insights">Insights</a>
      <span>/</span>
      <span>Author</span>
    </nav>

    <header class="author-hero">
      <div class="author-hero-copy">
        <span class="section-kicker">Richmedia author</span>
        <h1>{author.name}</h1>
        <p class="author-role">{author.role.en}</p>
        <p class="author-intro">{author.hero.en}</p>

        <div class="author-stats" aria-label="Author indicators">
          <article>
            <i class="ph ph-note-pencil" aria-hidden="true"></i>
            <strong>{articleCount}</strong>
            <span>{articleCount === 1 ? 'published article' : 'published articles'}</span>
          </article>
          <article>
            <i class="ph ph-target" aria-hidden="true"></i>
            <strong>{categoryCount}</strong>
            <span>{categoryCount === 1 ? 'topic covered' : 'topics covered'}</span>
          </article>
          <article>
            <i class="ph ph-calendar-blank" aria-hidden="true"></i>
            <strong>{author.experience}</strong>
            <span>years of experience</span>
          </article>
        </div>

        <div class="author-socials" aria-label="Author links">
          <a href={author.linkedIn} target="_blank" rel="noreferrer" aria-label={`${author.name} LinkedIn`}><i class="ph ph-linkedin-logo" aria-hidden="true"></i></a>
          <a href="/en" aria-label="Richmedia website"><i class="ph ph-house-line" aria-hidden="true"></i></a>
          <a href={`mailto:${author.email}`} aria-label={`Contact ${author.name}`}><i class="ph ph-envelope-simple" aria-hidden="true"></i></a>
        </div>
      </div>

      <figure class="author-portrait">
        <img src={author.portrait} alt={author.name} width="640" height="800" loading="eager" decoding="async" fetchpriority="high" />
      </figure>
    </header>

    <div class="author-layout">
      <main class="author-main">
        <section class="author-panel about-panel">
          <h2>About</h2>
          {author.about.en.map((paragraph) => <p>{paragraph}</p>)}
          <ul class="credentials-list">
            {author.credentials.en.map((credential) => <li>{credential}</li>)}
          </ul>
        </section>

        <section class="article-section" aria-labelledby="published-title">
          <div class="section-heading">
            <h2 id="published-title">Published articles</h2>
            <a href="/en/insights">View all articles <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          </div>
          {authorArticles.length > 0 ? (
            <div class="article-grid">
              {authorArticles.map((article) => (
                <a class="article-card" href={article.href}>
                  <img src={article.image} alt="" width="420" height="240" loading="lazy" decoding="async" />
                  <div>
                    <span>{article.category}</span>
                    <h3>{article.title}</h3>
                    <p>{article.description}</p>
                    <small><i class="ph ph-clock" aria-hidden="true"></i>{article.readingTime} min read <i class="ph ph-calendar-blank" aria-hidden="true"></i>{formatDate(article.date)}</small>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-state">This author's articles will be available soon.</p>
          )}
        </section>

        {recommendedArticles.length > 0 && (
          <section class="recommended-section" aria-labelledby="recommended-title">
            <h2 id="recommended-title">Articles recommended by {author.name.split(' ')[0]}</h2>
            <div class="recommended-grid">
              {recommendedArticles.map((article) => (
                <a class="recommended-card" href={article.href}>
                  <img src={article.image} alt="" width="260" height="150" loading="lazy" decoding="async" />
                  <span>{article.category}</span>
                  <strong>{article.title}</strong>
                  <small><i class="ph ph-clock" aria-hidden="true"></i>{article.readingTime} min</small>
                </a>
              ))}
            </div>
          </section>
        )}
      </main>

      <aside class="author-sidebar" aria-label="Author expertise">
        <section class="author-panel expertise-panel">
          <h2>Expertise areas</h2>
          <div>
            {author.expertise.en.map((item, index) => (
              <article>
                <i class:list={['ph', expertiseIcons[index % expertiseIcons.length]]} aria-hidden="true"></i>
                <span>{item}</span>
              </article>
            ))}
          </div>
        </section>

        <section class="author-panel topics-panel">
          <h2>Favorite topics</h2>
          <ul>
            {topicRows.map((topic) => (
              <li>
                <span>{topic.label}</span>
                {topic.count > 0 ? <strong>{topic.count}</strong> : <em>focus</em>}
              </li>
            ))}
          </ul>
        </section>

        <section class="author-panel newsletter-panel">
          <div class="newsletter-head">
            <span class="newsletter-icon" aria-hidden="true"><i class="ph ph-paper-plane-tilt"></i></span>
            <h2>Stay in the loop</h2>
          </div>
          <p>Receive our latest insights, trends and case studies.</p>
          <form action="/api/contact" method="post" data-contact-form>
            <input type="hidden" name="form" value="newsletter author en" />
            <input type="email" name="email" placeholder="your@email.com" required />
            <button type="submit">Subscribe</button>
          </form>
          <small>No spam. Unsubscribe in one click.</small>
        </section>
      </aside>
    </div>

    <section class="author-cta">
      <div>
        <span>Let’s talk growth</span>
        <h2>A project, a question, a strategy to clarify? Let’s talk.</h2>
      </div>
      <div>
        <a class="primary-btn" href="/en/contact">Discuss a project <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        <a class="ghost-btn" href="/en/expertises">Explore our expertise</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    width: min(100% - 3rem, 1320px);
    max-width: 1320px;
  }

  .author-page {
    --panel: rgba(13, 15, 24, 0.82);
    --line: rgba(255, 255, 255, 0.12);
    --muted: rgba(255, 255, 255, 0.68);
    display: grid;
    gap: clamp(1.15rem, 2.2vw, 2rem);
    padding-top: clamp(0.35rem, 1.4vw, 1rem);
    color: #fff;
  }

  h1,
  h2,
  h3,
  p,
  figure {
    margin: 0;
  }

  .author-breadcrumb {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 750;
  }

  .author-breadcrumb a {
    color: rgba(255, 255, 255, 0.74);
    text-decoration: none;
  }

  .author-breadcrumb span:last-child,
  .section-kicker,
  .article-card span,
  .recommended-card span {
    color: #a985ff;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    content: "";
    width: 2.8rem;
    height: 2px;
    background: currentColor;
  }

  .author-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.34fr);
    gap: clamp(1.2rem, 3.3vw, 3.4rem);
    align-items: center;
  }

  .author-hero-copy {
    display: grid;
    gap: 0.72rem;
    max-width: 700px;
  }

  .author-hero h1 {
    font-size: clamp(3.2rem, 6vw, 6rem);
    font-weight: 900;
    line-height: 0.95;
  }

  .author-role {
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(1.15rem, 2vw, 1.7rem);
    font-weight: 650;
  }

  .author-intro,
  .author-panel p,
  .newsletter-panel small {
    color: var(--muted);
    line-height: 1.65;
  }

  .author-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin-top: 0.35rem;
  }

  .author-stats article,
  .author-panel,
  .article-card,
  .recommended-card,
  .author-cta {
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 86% 10%, rgba(137, 76, 255, 0.14), transparent 14rem),
      var(--panel);
  }

  .author-stats article {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto minmax(2.25em, auto);
    gap: 0.25rem 0.65rem;
    align-items: center;
    align-content: center;
    min-height: 5rem;
    padding: 0.8rem 0.9rem;
    box-shadow: 0 0 0 rgba(137, 76, 255, 0);
    transform: translateY(0);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .author-stats article::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    opacity: 0;
    background:
      radial-gradient(circle at 18% 20%, rgba(169, 133, 255, 0.24), transparent 8rem),
      linear-gradient(135deg, rgba(137, 76, 255, 0.2), rgba(61, 214, 176, 0.07));
    transition: opacity 180ms ease;
  }

  .author-stats article:hover {
    border-color: rgba(169, 133, 255, 0.58);
    box-shadow: 0 18px 42px rgba(95, 55, 190, 0.22);
    transform: translateY(-4px);
  }

  .author-stats article:hover::before {
    opacity: 1;
  }

  .author-stats i,
  .expertise-panel i {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 8px;
    background: rgba(139, 76, 255, 0.16);
    color: #a985ff;
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .author-stats article:hover i {
    background: rgba(169, 133, 255, 0.26);
    color: #d9ccff;
    transform: translateY(-2px) scale(1.08) rotate(-4deg);
  }

  .author-stats strong {
    font-size: 1.2rem;
    line-height: 1;
    transition: color 180ms ease, transform 180ms ease;
  }

  .author-stats article:hover strong {
    color: #fff;
    transform: translateX(2px);
  }

  .author-stats span {
    grid-column: 2;
    display: flex;
    min-height: 2.25em;
    align-items: flex-start;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.82rem;
    line-height: 1.25;
    transition: color 180ms ease;
  }

  .author-stats article:hover span {
    color: rgba(255, 255, 255, 0.82);
  }

  .author-socials {
    display: flex;
    gap: 0.7rem;
    margin-top: 0.15rem;
  }

  .author-socials a {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, background 180ms ease;
  }

  .author-socials a:hover,
  .author-socials a:focus-visible {
    border-color: rgba(169, 133, 255, 0.7);
    background: rgba(169, 133, 255, 0.1);
    transform: translateY(-2px);
    outline: none;
  }

  .author-portrait {
    overflow: hidden;
    width: min(100%, 360px);
    justify-self: end;
    border: 1px solid rgba(169, 133, 255, 0.35);
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 15%, rgba(139, 76, 255, 0.32), transparent 16rem),
      #080911;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.34);
  }

  .author-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    filter: grayscale(1) contrast(1.08) brightness(0.96);
    object-fit: cover;
    object-position: center 18%;
  }

  .author-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.34fr);
    gap: 1.2rem;
    align-items: start;
    margin-top: clamp(-0.45rem, -0.9vw, -0.15rem);
  }

  .author-main,
  .author-sidebar,
  .about-panel,
  .article-section,
  .recommended-section {
    display: grid;
    gap: 1rem;
  }

  .author-sidebar {
    align-self: start;
  }

  .author-panel {
    padding: clamp(1.1rem, 2vw, 1.5rem);
  }

  .author-panel h2,
  .article-section h2,
  .recommended-section h2 {
    font-size: clamp(1.45rem, 2vw, 2rem);
    line-height: 1.1;
  }

  .expertise-panel h2 {
    font-size: clamp(1.45rem, 1.75vw, 1.75rem);
    line-height: 1;
    white-space: nowrap;
  }

  .credentials-list {
    display: grid;
    gap: 0.55rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .credentials-list li {
    position: relative;
    padding-left: 1.1rem;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.45;
  }

  .credentials-list li::before {
    content: "";
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #a985ff;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-heading a {
    color: #a985ff;
    font-weight: 850;
    text-decoration: none;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-card,
  .recommended-card {
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .article-card:hover,
  .article-card:focus-visible,
  .recommended-card:hover,
  .recommended-card:focus-visible,
  .author-panel:hover {
    border-color: rgba(169, 133, 255, 0.52);
    box-shadow: 0 1.5rem 3.5rem rgba(95, 50, 210, 0.16);
    transform: translateY(-3px);
    outline: none;
  }

  .article-card img,
  .recommended-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1.65 / 1;
    object-fit: cover;
  }

  .article-card div {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
  }

  .article-card span,
  .recommended-card span {
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-card h3,
  .recommended-card strong {
    font-size: 1.08rem;
    line-height: 1.13;
  }

  .article-card p {
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .article-card small,
  .recommended-card small {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem 0.75rem;
    align-items: center;
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .expertise-panel > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .expertise-panel article {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 0.55rem;
    justify-items: center;
    min-height: 6.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.85rem 0.65rem;
    background: rgba(255, 255, 255, 0.035);
    text-align: center;
    transform: translateY(0);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .expertise-panel article::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    opacity: 0;
    background:
      radial-gradient(circle at 50% 18%, rgba(169, 133, 255, 0.26), transparent 5.6rem),
      linear-gradient(145deg, rgba(137, 76, 255, 0.18), rgba(61, 214, 176, 0.06));
    transition: opacity 180ms ease;
  }

  .expertise-panel article:hover {
    border-color: rgba(169, 133, 255, 0.58);
    background: rgba(137, 76, 255, 0.08);
    box-shadow: 0 16px 34px rgba(95, 55, 190, 0.2);
    transform: translateY(-4px);
  }

  .expertise-panel article:hover::before {
    opacity: 1;
  }

  .expertise-panel article:hover i {
    background: rgba(169, 133, 255, 0.28);
    color: #ded2ff;
    transform: translateY(-2px) scale(1.08) rotate(-4deg);
  }

  .expertise-panel span {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.76rem;
    font-weight: 800;
    line-height: 1.25;
    transition: color 180ms ease, transform 180ms ease;
  }

  .expertise-panel article:hover span {
    color: #fff;
    transform: translateY(-1px);
  }

  .topics-panel ul {
    display: grid;
    gap: 0.15rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .topics-panel li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.65rem 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.9rem;
  }

  .topics-panel strong,
  .topics-panel em {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.12rem 0.45rem;
    color: #fff;
    font-size: 0.76rem;
    font-style: normal;
  }

  .recommended-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .recommended-card {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 0.8rem;
  }

  .recommended-card span,
  .recommended-card strong,
  .recommended-card small {
    margin-inline: 0.8rem;
  }

  .newsletter-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
