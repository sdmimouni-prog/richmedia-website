---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbs, localBusiness } from '../../lib/schema';
import { SITE } from '../../consts';

const assetBase = '/assets/richmedia-home/team-carousel';
const pageDescription =
  'Join Richmedia in Casablanca across digital strategy, creative, media, SEO/GEO, web, CRM, WhatsApp, AI and production roles.';

const schema = [
  {
    ...localBusiness(),
    url: `${SITE.url}/en/careers`,
    description: pageDescription,
    inLanguage: 'en',
  },
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Careers', url: `${SITE.url}/en/careers` },
  ]),
];

const heroPeople = [
  { image: 'amal.webp', name: 'Amal Amazouz' },
  { image: 'tarik.webp', name: 'Tarik El Abbadi' },
  { image: 'oussama.webp', name: 'Oussama TAHTAH' },
  { image: 'halima-felloui.webp', name: 'FELLIOUI Halima' },
  { image: 'oumaima-lassri.webp', name: 'Oumaima LASSRI' },
  { image: 'elhoussine-bw.webp', name: 'Elhoussine Essmami' },
  { image: 'ikram-bw.webp', name: 'Ikram Dehiri' },
  { image: 'safwane.webp', name: 'Safwane MOUSTAINE' },
  { image: 'malak-billaore.webp', name: 'Malak BILLAORE' },
  { image: 'salah.webp', name: 'Salah-Eddine Mimouni', className: 'mosaic-feature' },
  { image: 'rachid-oualla.webp?v=black-d71ec18', name: 'Rachid OUALLA' },
  { image: 'rachid.webp', name: 'Rachid Hlalma' },
  { image: 'abdelkader.webp', name: 'Abdelkader El Bouhaddouti' },
  { image: 'youssef.webp', name: 'Youssef Amazouz' },
  { image: 'wail.webp', name: 'Wail El Asri' },
  { image: 'ghita-mimouni.webp', name: 'Ghita MIMOUNI' },
  { image: 'marwane.webp', name: 'Marwane Jouay', className: 'portrait-focus-low' },
  { image: 'soukaina-sammouni.webp', name: 'Soukaina SAMMOUNI' },
  { image: 'zakaria.webp', name: 'Zakaria Mouchtati' },
  { image: 'zouhair-bw.webp', name: 'Zouhair Lyzouli' },
  { image: 'yasmine-ouazzani-touhamy.webp?v=black-yasmine-ab487fe', name: 'Yasmine Ouazzani Touhamy' },
  { image: 'wafaa.webp', name: 'Yassmine Boudial' },
  { image: 'ayoub.webp', name: 'Ayoub Es-Samlali' },
  { image: 'yassine.webp', name: 'Mohamed Yassine Dargal' },
];

const team = [
  { image: 'salah.webp', name: 'Salah-Eddine Mimouni', role: 'CEO & CTO', group: 'Executive' },
  { image: 'amal.webp', name: 'Amal Amazouz', role: 'COO & CDO', group: 'Executive' },
  { image: 'tarik.webp', name: 'Tarik El Abbadi', role: 'Communication & Event Director', group: 'Executive' },
  { image: 'elhoussine-bw.webp', name: 'Elhoussine Essmami', role: 'Strategic Planner', group: 'Strategy' },
  { image: 'ikram-bw.webp', name: 'Ikram Dehiri', role: 'Senior Account Manager', group: 'Account Management' },
  { image: 'oussama.webp', name: 'Oussama TAHTAH', role: 'Senior Account Manager', group: 'Account Management' },
  { image: 'oumaima-lassri.webp', name: 'Oumaima LASSRI', role: 'Senior Account Manager', group: 'Account Management' },
  { image: 'halima-felloui.webp', name: 'FELLIOUI Halima', role: 'Account Manager', group: 'Account Management' },
  { image: 'soukaina-sammouni.webp', name: 'Soukaina SAMMOUNI', role: 'Account Manager', group: 'Account Management' },
  { image: 'yasmine-ouazzani-touhamy.webp?v=black-yasmine-ab487fe', name: 'Yasmine Ouazzani Touhamy', role: 'Account Manager', group: 'Account Management' },
  { image: 'zouhair-bw.webp', name: 'Zouhair Lyzouli', role: 'Senior Full Stack Developer', group: 'Development' },
  { image: 'zakaria.webp', name: 'Zakaria Mouchtati', role: 'Senior Full Stack Developer', group: 'Development' },
  { image: 'yassmine.webp?v=black-wafaa-1', name: 'Wafae Lamsabni', role: 'Project Manager', group: 'Project Management' },
  { image: 'yassine.webp', name: 'Mohamed Yassine Dargal', role: 'Project Manager', group: 'Project Management' },
  { image: 'ayoub.webp', name: 'Ayoub Es-Samlali', role: 'Project Manager', group: 'Project Management' },
  { image: 'wafaa.webp', name: 'Yassmine Boudial', role: 'Project Manager', group: 'Project Management' },
  { image: 'safwane.webp', name: 'Safwane MOUSTAINE', role: 'Senior Traffic Manager', group: 'Marketing' },
  { image: 'malak-billaore.webp', name: 'Malak BILLAORE', role: 'Administrative Manager', group: 'Administration' },
  { image: 'rachid-oualla.webp?v=black-d71ec18', name: 'Rachid OUALLA', role: 'Art Director', group: 'Creative' },
  { image: 'rachid.webp', name: 'Rachid Hlalma', role: 'Art Director', group: 'Creative' },
  { image: 'abdelkader.webp', name: 'Abdelkader El Bouhaddouti', role: 'Graphic Final Artist', group: 'Design' },
  { image: 'youssef.webp', name: 'Youssef Amazouz', role: 'Graphic Final Artist', group: 'Design' },
  { image: 'wail.webp', name: 'Wail El Asri', role: 'Graphic Final Artist', group: 'Design' },
  { image: 'ghita-mimouni.webp', name: 'Ghita MIMOUNI', role: 'Junior Design Scout', group: 'Design' },
  { image: 'marwane.webp', name: 'Marwane Jouay', role: 'Video Director & Editor', group: 'Production' },
];

const teamLoop = [...team, ...team];

const poles = [
  { label: '01', title: 'Strategy', text: 'Positioning, planning, campaign architecture and business vision.' },
  { label: '02', title: 'Creation', text: 'Art direction, design, video, brand content and storytelling.' },
  { label: '03', title: 'Performance', text: 'Paid media, tracking, CRM, lead generation and continuous optimization.' },
  { label: '04', title: 'Technology', text: 'Web development, platforms, automation, AI and connected systems.' },
];

const stats = [
  { value: String(team.length), label: 'integrated profiles' },
  { value: '8', label: 'specialist units' },
  { value: '+156', label: 'completed projects' },
  { value: '4', label: 'connected offices' },
];

const quickLinks = [
  { href: '#team-proof', label: 'Proof', value: `${team.length} profiles` },
  { href: '#team-poles', label: 'Units', value: '4 axes' },
  { href: '#hall-of-fame', label: 'Team', value: String(team.length) },
  { href: '#team-contact', label: 'Contact', value: 'Brief' },
];
---
<BaseLayout
  title="Digital Agency Careers in Casablanca | Richmedia"
  description={pageDescription}
  canonical={`${SITE.url}/en/careers`}
  lang="en"
  schema={schema}
>
  <div class="team-page">
    <section class="team-hero" aria-labelledby="team-title">
      <div class="team-hero-copy">
        <span class="section-kicker">Dream Team</span>
        <h1 id="team-title">A senior team built to move brands forward.</h1>
        <p>
          Richmedia brings together strategy, creative, media, technology and production profiles to turn ideas
          into useful, visible and measurable campaigns.
        </p>
        <div class="team-actions">
          <a class="button button-primary" href="#hall-of-fame">
            Meet the team
            <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/contact">
            Work with us
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-portraits" aria-label="Richmedia team portraits">
        {heroPeople.map((person, index) => (
          <figure class:list={['hero-portrait', person.className]}>
            <img
              src={`${assetBase}/${person.image}`}
              alt={person.name}
              width="420"
              height="520"
              loading={index < 8 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <figcaption>{person.name}</figcaption>
          </figure>
        ))}
        <a class="hero-portrait hero-join-card" href="/en/contact" aria-label="Join us">
          <span class="join-plus" aria-hidden="true">+</span>
          <span class="join-label">Join us</span>
        </a>
      </div>
    </section>

    <nav class="mobile-page-nav" aria-label="Team page navigation">
      {quickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="team-stats" id="team-proof" aria-label="Team key figures">
      {stats.map((stat) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </section>

    <section class="team-marquee" id="team-portraits" aria-label="Richmedia team portraits">
      <div class="marquee-row marquee-row-forward">
        {teamLoop.map((member) => (
          <figure>
            <img src={`${assetBase}/${member.image}`} alt="" width="640" height="800" loading="lazy" decoding="async" />
            <figcaption>
              <strong>{member.name}</strong>
              <span>{member.group}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="marquee-row marquee-row-reverse">
        {[...teamLoop].reverse().map((member) => (
          <figure>
            <img src={`${assetBase}/${member.image}`} alt="" width="640" height="800" loading="lazy" decoding="async" />
            <figcaption>
              <strong>{member.name}</strong>
              <span>{member.group}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="team-poles" id="team-poles" aria-labelledby="poles-title">
      <div>
        <span class="section-kicker">Organization</span>
        <h2 id="poles-title">Our units.</h2>
      </div>
      <div class="poles-grid">
        {poles.map((pole) => (
          <article>
            <span>{pole.label}</span>
            <h3>{pole.title}</h3>
            <p>{pole.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="hall-section" id="hall-of-fame" aria-label="Richmedia team">
      <div class="hall-head">
        <span class="section-kicker">Team roster</span>
      </div>

      <div class="team-grid">
        {team.map((member, index) => (
          <article class:list={['member-card', index < 3 && 'member-card-featured']}>
            <div class="member-image">
              <img src={`${assetBase}/${member.image}`} alt={member.name} width="640" height="800" loading="lazy" decoding="async" />
            </div>
            <div class="member-info">
              <span>{member.group}</span>
              <h3>{member.name}</h3>
              <p>{member.role}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="team-closing" id="team-contact" aria-labelledby="closing-title">
      <div>
        <span class="section-kicker">Ready to scale?</span>
        <h2 id="closing-title">The right team changes how fast a project moves.</h2>
      </div>
      <a class="button button-primary" href="/en/contact">
        Talk to the team
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .team-page {
    --container: min(100% - 3rem, 1320px);
    --purple: #7c3cff;
    --purple-2: #a36bff;
    --line: rgba(255,255,255,0.14);
    --muted: rgba(255,255,255,0.68);
    overflow: hidden;
    background:
      radial-gradient(circle at 16% 6%, rgba(124,60,255,0.28), transparent 26rem),
      radial-gradient(circle at 90% 36%, rgba(124,60,255,0.16), transparent 25rem),
      linear-gradient(180deg, #030407 0%, #050507 52%, #030407 100%);
    color: #fff;
  }

  .team-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.014) 1px, transparent 1px);
    background-size: 64px 64px;
    content: "";
    pointer-events: none;
  }

  .team-hero,
  .team-stats,
  .team-marquee,
  .team-poles,
  .hall-section,
  .team-closing {
    position: relative;
    z-index: 1;
    width: var(--container);
    margin-inline: auto;
  }

  .team-stats,
  .team-marquee,
  .team-poles,
  .hall-section,
  .team-closing {
    scroll-margin-top: 6rem;
  }

  .mobile-page-nav {
    display: none;
  }

  .team-hero {
    display: grid;
    grid-template-columns: minmax(380px, 0.82fr) minmax(560px, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: 760px;
    padding: 9rem 0 4rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--purple-2);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.2rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .team-hero h1 {
    max-width: 720px;
    margin: 1.25rem 0 0;
    --h1-size: clamp(2rem, 3vw, 3.125rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .team-hero-copy p {
    max-width: 610px;
    margin: 1.45rem 0 0;
    color: rgba(255,255,255,0.74);
    font-size: clamp(1.0625rem, 1.35vw, 1.18rem);
    line-height: 1.58;
  }

  .team-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.15rem;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0 1.25rem;
    font-weight: 800;
    text-decoration: none;
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border-color: rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.035);
  }

  .hero-portraits {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: clamp(86px, 7.2vw, 112px);
    gap: 5px;
    align-self: center;
    min-height: 0;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background:
      linear-gradient(145deg, rgba(124, 60, 255, 0.12), transparent 34%),
      rgba(255, 255, 255, 0.028);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.42);
    isolation: isolate;
  }

  .hero-portraits::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: radial-gradient(circle at 50% 42%, rgba(124, 60, 255, 0.16), transparent 48%);
    opacity: 0.9;
    content: "";
    pointer-events: none;
  }

  .hero-portrait {
    position: relative;
    z-index: 1;
    overflow: hidden;
    margin: 0;
    min-width: 0;
    border: 1px solid rgba(124, 60, 255, 0.22);
    border-radius: 4px;
    background: #08090f;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.025);
    transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease, filter 260ms ease;
  }

  .hero-portrait:hover {
    z-index: 10;
    transform: translateY(-6px) scale(1.045);
    border-color: rgba(165, 107, 255, 0.82);
    box-shadow: 0 18px 54px rgba(124, 60, 255, 0.3);
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1) contrast(1.08);
    transform: scale(1.01);
    transition: filter 300ms ease, transform 300ms ease;
  }

  .hero-portrait:hover img {
    filter: grayscale(0.18) saturate(1.08) contrast(1.04);
    transform: scale(1.08);
  }

  .hero-portrait figcaption {
    position: absolute;
    right: 0.5rem;
    bottom: 0.45rem;
    left: 0.5rem;
    z-index: 2;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    line-height: 1.06;
    opacity: 0;
    transform: translateY(0.35rem);
    transition: opacity 240ms ease, transform 240ms ease;
  }

  .hero-portrait::after {
    position: absolute;
    inset: auto 0 0;
    height: 58%;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.78));
    opacity: 0;
    transition: opacity 240ms ease;
    content: "";
  }

  .hero-portrait:hover::after,
  .hero-portrait:hover figcaption {
    opacity: 1;
    transform: translateY(0);
  }

  .mosaic-feature {
    border-color: rgba(165, 107, 255, 0.58);
  }

  .portrait-focus-low img {
    object-fit: contain;
    object-position: center;
    transform: scale(1);
  }

  .portrait-focus-low:hover img {
    transform: scale(1.04);
  }

  .hero-join-card {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    background:
      radial-gradient(circle at 50% 22%, rgba(165, 107, 255, 0.36), transparent 48%),
      linear-gradient(145deg, rgba(124, 60, 255, 0.2), rgba(255, 255, 255, 0.035));
  }

  .hero-join-card::after {
    inset: 0;
    height: auto;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(124, 60, 255, 0.18));
    opacity: 0.34;
  }

  .join-plus {
    position: relative;
    z-index: 2;
    color: #a56bff;
    font-size: clamp(3.25rem, 5.3vw, 5.2rem);
    font-weight: 300;
    line-height: 0.72;
    text-shadow: 0 0 28px rgba(124, 60, 255, 0.64);
    transition: color 260ms ease, transform 260ms ease;
  }

  .join-label {
    position: relative;
    z-index: 2;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    transition: color 260ms ease, transform 260ms ease;
  }

  .hero-join-card:hover .join-plus {
    color: #fff;
    transform: rotate(90deg) scale(1.08);
  }

  .hero-join-card:hover .join-label {
    color: #c5a4ff;
    transform: translateY(-0.1rem);
  }

  .founder-panel {
    display: grid;
    grid-template-columns: minmax(210px, 0.58fr) minmax(0, 1fr);
    gap: clamp(0.75rem, 1.4vw, 1.05rem);
    align-items: center;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    padding: 0.6rem;
    background:
      radial-gradient(circle at 20% 8%, rgba(124,60,255,0.28), transparent 16rem),
      rgba(255,255,255,0.032);
    box-shadow: 0 2rem 5rem rgba(0,0,0,0.42);
  }

  .founder-panel-link {
    color: inherit;
    text-decoration: none;
    transition: transform 320ms ease, border-color 320ms ease, box-shadow 320ms ease;
  }

  .founder-panel-link:hover,
  .founder-panel-link:focus-visible {
    border-color: rgba(124,60,255,0.66);
    box-shadow: 0 2.4rem 5rem rgba(0,0,0,0.48), 0 0 2rem rgba(124,60,255,0.2);
    transform: translateY(-6px);
    outline: none;
  }

  .founder-panel-link:hover .founder-photo img,
  .founder-panel-link:focus-visible .founder-photo img {
    transform: scale(1.035);
  }

  .founder-photo {
    position: relative;
    align-self: center;
    height: clamp(238px, 25.2vw, 329px);
    overflow: hidden;
    border-radius: 8px;
    background: #08080d;
  }

  .founder-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1);
    transition: transform 520ms ease;
  }

  .founder-photo::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(0,0,0,0.62), transparent 45%),
      linear-gradient(135deg, rgba(124,60,255,0.24), transparent 44%);
    content: "";
  }

  .founder-copy {
    align-self: center;
    padding: clamp(0.55rem, 1.1vw, 0.85rem);
  }

  .founder-copy > span {
    color: var(--purple-2);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .founder-copy h2 {
    margin: 0.5rem 0 0;
    max-width: 100%;
    --h2-size: clamp(1.35rem, 1.9vw, 1.95rem);
    font-size: var(--h2-size);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .founder-copy strong {
    display: block;
    margin-top: 0.4rem;
    color: rgba(255,255,255,0.7);
    font-size: 1.0625rem;
    font-weight: 800;
  }

  .founder-copy p {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.36;
  }

  .founder-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
    margin-top: 0.65rem;
  }

  .founder-facts span {
    display: flex;
    min-height: 1.9rem;
    align-items: center;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    padding: 0.34rem 0.52rem;
    background: rgba(0,0,0,0.32);
    color: rgba(255,255,255,0.82);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .team-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255,255,255,0.035);
  }

  .team-stats article {
    min-height: 120px;
    padding: 1.4rem;
    background: rgba(0,0,0,0.34);
  }

  .team-stats article + article {
    border-left: 1px solid var(--line);
  }

  .team-stats strong {
    display: block;
