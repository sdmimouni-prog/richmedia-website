---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { SITE } from '../../consts';
import { breadcrumbs } from '../../lib/schema';

const pageUrl = `${SITE.url}/en/sitemap`;
const schema = [breadcrumbs([
  { name: 'Home', url: `${SITE.url}/en` },
  { name: 'Sitemap', url: pageUrl },
])];

const groups = [
  {
    title: 'Main pages',
    links: [
      { href: '/en', label: 'Home', text: 'Richmedia overview, expertise, references and contact.' },
      { href: '/en/agency', label: 'Agency', text: 'About Richmedia, approach, history and offices.' },
      { href: '/en/expertises', label: 'Expertise', text: 'Strategy, content, media, web, influence, phygital, events and AI.' },
      { href: '/en/sectors', label: 'Sectors', text: 'Sector pages for education, retail, real estate, institutions and more.' },
      { href: '/en/insights', label: 'Insights', text: 'Guides, analysis and digital marketing methods.' },
      { href: '/en/insights/morocco-digital-marketing-barometer-2026', label: 'Morocco Digital Marketing Barometer 2026', text: 'Richmedia benchmark based on campaigns managed in Morocco.' },
      { href: '/en/tools', label: 'Tools & resources', text: 'Calculators, templates and checklists for digital marketing planning.' },
      { href: '/en/tools/media-budget-leads-calculator', label: 'Media Budget & Leads Calculator', text: 'Estimate media budget or lead volume by sector and channel.' },
      { href: '/en/tools/whatsapp-campaign-estimator', label: 'WhatsApp Campaign Estimator', text: 'Estimate pushes, reads, clicks and conversions for a WhatsApp campaign.' },
      { href: '/en/tools/digital-media-plan-template', label: 'Digital Media Plan Template 2026', text: 'Excel template to plan media budgets and compare forecast with actuals.' },
      { href: '/en/case-studies', label: 'Case studies', text: 'Portfolio and client cases.' },
      { href: '/en/references', label: 'References', text: 'Clients, sectors and certifications.' },
      { href: '/en/team', label: 'Team', text: 'Profiles and organization.' },
      { href: '/en/careers', label: 'Careers', text: 'Open profiles and Richmedia culture.' },
      { href: '/en/contact', label: 'Contact', text: 'Contact details and contact form.' },
      { href: '/en/book-audit', label: 'Book an audit', text: 'Request a 360 digital audit.' },
    ],
  },
  {
    title: 'Expertise',
    links: [
      { href: '/en/expertises/strategie-digitale', label: 'Digital strategy', text: 'Positioning, targeting and measurable action plan.' },
      { href: '/en/expertises/brand-content', label: 'Brand content', text: 'Storytelling, social-first content, photo and video.' },
      { href: '/en/expertises/web-si', label: 'Web & systems', text: 'Web platforms, tracking, SEO and connected systems.' },
      { href: '/en/expertises/media-performance', label: 'Media & performance', text: 'Digital performance, acquisition, tracking, SEO/GEO and CRM.' },
      { href: '/en/expertises/achat-media', label: 'Media buying', text: 'Google Ads, Meta Ads, programmatic and performance.' },
      { href: '/en/expertises/seo-geo', label: 'SEO / GEO', text: 'Organic search, local SEO and AI visibility.' },
      { href: '/en/expertises/google-ads-morocco', label: 'Google Ads Morocco', text: 'Search, Performance Max, tracking and landing pages.' },
      { href: '/en/expertises/meta-ads-morocco', label: 'Meta Ads Morocco', text: 'Facebook, Instagram, creative testing, Pixel and CAPI.' },
      { href: '/en/expertises/lead-generation-morocco', label: 'Lead generation Morocco', text: 'Connect media, landing pages, WhatsApp, CRM and qualification.' },
      { href: '/en/expertises/social-media-morocco', label: 'Social media Morocco', text: 'Editorial strategy, content, communities and reporting.' },
      { href: '/en/expertises/tiktok-ads-morocco', label: 'TikTok Ads Morocco', text: 'Native creative, Spark Ads, UGC and retargeting.' },
      { href: '/en/expertises/whatsapp-marketing-morocco', label: 'WhatsApp marketing Morocco', text: 'Opt-in, templates, automation, CRM and reporting.' },
      { href: '/en/expertises/crm-marketing-automation-morocco', label: 'CRM & marketing automation Morocco', text: 'Lead scoring, routing, workflows and commercial follow-up.' },
      { href: '/en/expertises/influencer-marketing-morocco', label: 'Influencer marketing Morocco', text: 'Creator selection, UGC, briefs, rights and amplification.' },
      { href: '/en/expertises/social-listening-morocco', label: 'Social listening Morocco', text: 'Conversation monitoring, reputation, competitors and trends.' },
      { href: '/en/expertises/geofencing-drive-to-store-morocco', label: 'Geofencing & drive-to-store Morocco', text: 'Local media and physical conversion journeys.' },
      { href: '/en/expertises/influence', label: 'Influence', text: 'Creators, UGC, activation and reporting.' },
      { href: '/en/expertises/phygital', label: 'Phygital', text: 'Field activation, retail and connected experiences.' },
      { href: '/en/expertises/evenementiel', label: 'Events', text: 'Event concept, production and amplification.' },
      { href: '/en/expertises/ia-automation', label: 'AI & automation', text: 'CRM, WhatsApp, AI agents and workflows.' },
    ],
  },
  {
    title: 'Sectors',
    links: [
      { href: '/en/sectors/education', label: 'Education', text: 'Admissions, reputation and qualified lead generation.' },
      { href: '/en/sectors/real-estate', label: 'Real estate', text: 'Project launches, appointments and local demand.' },
      { href: '/en/sectors/retail-ecommerce', label: 'Retail & e-commerce', text: 'Traffic, conversion and CRM.' },
      { href: '/en/sectors/grocery-retail', label: 'Grocery retail', text: 'Promotions, catalogues and drive-to-store.' },
      { href: '/en/sectors/institutional', label: 'Institutional', text: 'Public communication and impact.' },
      { href: '/en/sectors/tourism-hospitality', label: 'Tourism & hospitality', text: 'Bookings, destination visibility and CRM.' },
      { href: '/en/sectors/automotive', label: 'Automotive', text: 'Model launches, showrooms and qualified leads.' },
      { href: '/en/sectors/fmcg', label: 'FMCG', text: 'Awareness, retail activation and social-first content.' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/en/legal-notice', label: 'Legal notice', text: 'Publisher, hosting and intellectual property.' },
      { href: '/en/privacy', label: 'Privacy policy', text: 'Personal data processing.' },
      { href: '/en/cookies', label: 'Cookie policy', text: 'Cookies, trackers and preferences.' },
      { href: '/en/sitemap', label: 'HTML sitemap', text: 'Human-readable sitemap.' },
      { href: '/sitemap-index.xml', label: 'XML sitemap', text: 'Technical sitemap for search engines.' },
    ],
  },
];
---

<BaseLayout
  title="English Sitemap | Richmedia"
  description="Richmedia sitemap: main pages, expertise, sectors, products, case studies, insights and legal pages."
  canonical={pageUrl}
  lang="en"
  schema={schema}
>
  <LegalPage eyebrow="Navigation" title="Sitemap" intro="Find the main English pages of the Richmedia website and the XML sitemap for search engines.">
    {groups.map((group) => (
      <nav aria-labelledby={`sitemap-${group.title.toLowerCase().replaceAll(' ', '-')}`}>
        <h2 id={`sitemap-${group.title.toLowerCase().replaceAll(' ', '-')}`}>{group.title}</h2>
        <ul class="route-grid">
          {group.links.map((link) => (
            <li>
              <a href={link.href}>
                <strong>{link.label}</strong>
                <span>{link.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </LegalPage>
</BaseLayout>
