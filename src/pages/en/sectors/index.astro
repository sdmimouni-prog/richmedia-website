---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../../components/SeoSiloLinks.astro';
import { breadcrumbs } from '../../../lib/schema';
import { enSiloLinks } from '../../../lib/seo-silos';
import { SITE } from '../../../consts';

const pageUrl = `${SITE.url}/en/sectors`;
const sectors = [
  {
    slug: 'education',
    title: 'Education',
    image: '/assets/richmedia-sector-education/education-hero-campus.webp',
  },
  {
    slug: 'real-estate',
    title: 'Real estate',
    image: '/assets/richmedia-sector-immobilier/hero-real-estate-premium.webp',
  },
  {
    slug: 'retail-ecommerce',
    title: 'Retail & e-commerce',
    image: '/assets/richmedia-sector-retail/case-moul-pounj-commerce-connected.webp',
  },
  {
    slug: 'grocery-retail',
    title: 'Grocery retail',
    image: '/assets/richmedia-sector-gms/hero-gms-retail.webp',
  },
  {
    slug: 'institutional',
    title: 'Institutional',
    image: '/assets/richmedia-sector-institutionnel/hero-building-ministere-maroc.webp',
  },
  {
    slug: 'tourism-hospitality',
    title: 'Tourism / hospitality',
    image: '/assets/richmedia-sector-hotellerie/hero-hotellerie-resort.webp',
  },
  {
    slug: 'automotive',
    title: 'Automotive',
    image: '/assets/richmedia-sector-automobile/hero-premium-showroom.webp',
  },
  {
    slug: 'fmcg',
    title: 'FMCG',
    image: '/assets/richmedia-sector-fmcg/hero-fmcg-products.webp',
  },
];

const schema = [
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Sectors', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Digital marketing sectors supported by Richmedia"
  description="Explore the sectors supported by Richmedia: education, real estate, retail, grocery retail, institutional, tourism, automotive and FMCG."
  canonical={pageUrl}
  lang="en"
  schema={schema}
>
  <div class="sectors-page">
    <section class="sectors-hero" aria-labelledby="sectors-title">
      <span class="section-kicker">Sectors</span>
      <h1 id="sectors-title">Digital systems adapted to each market.</h1>
      <p>
        Richmedia connects strategy, creative, media, web, data and AI to each sector's realities:
        decision cycle, proof, seasonality, acquisition, trust and conversion.
      </p>
    </section>

    <section class="sectors-grid" aria-label="Richmedia sectors">
      {sectors.map((sector) => (
        <a href={`/en/sectors/${sector.slug}`} class="sector-card" aria-label={`View the ${sector.title} sector`}>
          <img src={sector.image} alt="" loading="lazy" decoding="async" />
          <h2>{sector.title}</h2>
        </a>
      ))}
    </section>

    <SeoSiloLinks
      title="Explore industry silos"
      intro="Each market links to the most useful expertises, proof points and campaigns to create a coherent SEO journey."
      links={enSiloLinks.sectorsHub}
    />

    <section class="sectors-cta" aria-labelledby="sectors-cta-title">
      <div>
        <span class="section-kicker">SEO mesh</span>
        <h2 id="sectors-cta-title">Each sector connects expertise, proof and offers.</h2>
      </div>
      <a class="button button-primary" href="/en/contact">
        Talk to the team
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .sectors-page {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .sectors-hero {
    display: grid;
    max-width: 780px;
    gap: 1rem;
    padding-top: clamp(1rem, 4vw, 3rem);
  }

  .sectors-hero h1,
  .sectors-cta h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.7rem, 6.6vw, 5.8rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.96;
  }

  .sectors-hero p {
    max-width: 62ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.7;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .sector-card {
    position: relative;
    display: block;
    min-height: 19rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: #090a10;
    color: #fff;
    isolation: isolate;
    text-decoration: none;
    transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }

  .sector-card::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, transparent 22%, rgba(3, 3, 6, 0.18) 48%, rgba(3, 3, 6, 0.92) 100%),
      radial-gradient(circle at 18% 12%, rgba(124, 60, 255, 0.18), transparent 18rem);
    content: "";
    pointer-events: none;
  }

  .sector-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transform: scale(1.01);
    transition: opacity 260ms ease, transform 420ms ease;
  }

  .sector-card h2 {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 2;
    margin: 0;
    color: #fff;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.05;
    text-shadow: 0 0.9rem 1.8rem rgba(0, 0, 0, 0.72);
    text-wrap: balance;
  }

  .sector-card:hover,
  .sector-card:focus-visible {
    border-color: rgba(156, 109, 255, 0.64);
    box-shadow: 0 1.4rem 3rem rgba(0, 0, 0, 0.28);
    outline: 0;
    transform: translateY(-4px);
  }

  .sector-card:hover img,
  .sector-card:focus-visible img {
    opacity: 1;
    transform: scale(1.06);
  }

  .sectors-cta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  .sectors-cta h2 {
    max-width: 780px;
    font-size: clamp(2rem, 4.4vw, 4.2rem);
  }

  @media (max-width: 980px) {
    .sectors-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sectors-cta {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .sectors-grid {
      grid-template-columns: 1fr;
    }

    .sector-card {
      min-height: 14rem;
    }
  }
</style>
