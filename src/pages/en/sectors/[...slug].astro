  .education-case-card {
    position: relative;
    overflow: hidden;
    min-height: 18.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #080a10;
    box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.28);
  }

  .education-case-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .education-case-card::after {
    background:
      linear-gradient(90deg, rgba(3, 4, 8, 0.36), rgba(3, 4, 8, 0.16) 48%, rgba(3, 4, 8, 0.28)),
      linear-gradient(180deg, rgba(3, 4, 8, 0.08), rgba(3, 4, 8, 0.36));
  }

  .education-case-content {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 18.5rem;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.42fr);
    align-items: end;
    gap: 1.1rem;
    max-width: none;
    padding: 1.2rem;
  }

  .education-case-main {
    display: grid;
    max-width: 28rem;
    gap: 1rem;
    align-content: end;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 8px;
    padding: 1rem;
    background: linear-gradient(135deg, rgba(10, 12, 20, 0.68), rgba(10, 12, 20, 0.38));
    backdrop-filter: blur(10px);
  }

  .education-case-main > span {
    color: #a985ff;
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .education-case-main h3 {
    color: #fff;
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    line-height: 1.08;
  }

  .education-case-main p {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .education-case-main .education-button {
    width: fit-content;
    min-height: 2.55rem;
    padding-inline: 1rem;
  }

  .education-case-metrics {
    display: grid;
    gap: 0.6rem;
    align-self: stretch;
  }

  .education-case-metrics strong {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: center;
    gap: 0.12rem;
    min-height: 4.25rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.72rem 0.8rem;
    background: rgba(3, 4, 8, 0.46);
    color: #fff;
    font-family: var(--font-numeric);
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    font-weight: 900;
    line-height: 1;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    transform: translateZ(0);
    transition: transform 280ms cubic-bezier(.2,.8,.2,1), border-color 280ms ease, box-shadow 280ms ease, background 280ms ease;
    will-change: transform;
  }

  .education-case-metrics strong::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 4%, rgba(255, 255, 255, 0.14) 42%, transparent 68%),
      radial-gradient(circle at 88% 20%, rgba(154, 93, 255, 0.24), transparent 34%);
    content: "";
    opacity: 0;
    transform: translateX(-22%);
    transition: opacity 240ms ease, transform 520ms ease;
  }

  .education-case-metrics strong:hover,
  .education-case-metrics strong:focus-within {
    border-color: rgba(174, 112, 255, 0.74);
    background:
      radial-gradient(circle at 18% 20%, rgba(154, 93, 255, 0.18), transparent 52%),
      rgba(10, 11, 18, 0.7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.13),
      0 1.05rem 2.2rem rgba(0, 0, 0, 0.3),
      0 0 2.4rem rgba(124, 60, 255, 0.22);
    transform: translateX(-6px) scale(1.035);
  }

  .education-case-metrics strong:hover::before,
  .education-case-metrics strong:focus-within::before {
    opacity: 1;
    transform: translateX(0);
  }

  .education-case-metrics strong > * {
    position: relative;
    z-index: 1;
  }

  .education-case-metrics span {
    color: rgba(255, 255, 255, 0.68);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 760;
    line-height: 1.2;
  }

  .education-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 1rem;
  }

  .education-faq-grid details {
    overflow: hidden;
  }

  .education-faq-grid summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.78rem 0.9rem;
    color: #fff;
    cursor: pointer;
    font-size: 1.0625rem;
    font-weight: 780;
    list-style: none;
  }

  .education-faq-grid summary::-webkit-details-marker {
    display: none;
  }

  .education-faq-grid summary span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid #9a5dff;
    border-radius: 999px;
    background: rgba(124, 60, 255, 0.24);
    color: #fff;
    font-family: var(--font-numeric);
  }

  .education-faq-grid summary i {
    color: #9a5dff;
    transition: transform 180ms ease;
  }

  .education-faq-grid details[open] summary i {
    transform: rotate(180deg);
  }

  .education-faq-grid p {
    padding: 0 0.9rem 0.9rem 3.65rem;
  }

  .education-bottom-cta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    min-width: 0;
    gap: 1.2rem;
    align-items: center;
    padding: 1.15rem;
  }

  .education-bottom-cta > i {
    display: grid;
    width: 4.2rem;
    height: 4.2rem;
    place-items: center;
    border: 1px solid #9a5dff;
    border-radius: 8px;
    background: rgba(124, 60, 255, 0.12);
  }

  .education-bottom-cta > i::before {
    width: 2.05rem;
    height: 2.05rem;
