const { page } = Astro.props;
const slug = Astro.params.slug;
const pageUrl = `${SITE.url}/en/sectors/${slug}`;
const sectorSeo: Record<string, { title: string; description: string }> = {
  education: {
    title: 'Education Digital Marketing in Morocco | Richmedia',
    description: 'Attract qualified candidates with landing pages, WhatsApp, SEO/GEO, paid media campaigns and admissions reporting.',
  },
  'real-estate': {
    title: 'Real Estate Digital Marketing in Morocco | Richmedia',
    description: 'Generate qualified property leads with local SEO, landing pages, WhatsApp, CRM, visits and commercial reporting.',
  },
  'retail-ecommerce': {
    title: 'Retail & E-commerce Marketing in Morocco | Richmedia',
    description: 'Grow traffic, sales and loyalty with acquisition, social commerce, local SEO, WhatsApp, CRM and conversion campaigns.',
  },
  'grocery-retail': {
    title: 'Grocery Retail Marketing in Morocco | Richmedia',
    description: 'Activate promotions, digital catalogues, drive-to-store, WhatsApp, CRM, couponing, retail media and reporting for grocery retail.',
  },
  institutional: {
    title: 'Institutional Communication in Morocco | Richmedia',
    description: 'Structure public campaigns, educational content, SEO/GEO, web platforms, social media and reporting for institutions.',
  },
  'tourism-hospitality': {
    title: 'Tourism Marketing in Morocco | Richmedia',
    description: 'Grow bookings and destination image with SEO, immersive content, travel influence, media campaigns, CRM and reporting.',
  },
  automotive: {
    title: 'Automotive Marketing in Morocco | Richmedia',
    description: 'Launch models and offers with qualified leads, test-drive requests, showroom visibility, WhatsApp, CRM and local SEO.',
  },
  fmcg: {
    title: 'FMCG Marketing in Morocco | Richmedia',
    description: 'Build preference and product launches with brand content, social media, influence, UGC, retail activation and reporting.',
  },
};
const seo = sectorSeo[page.slug] ?? { title: `${page.title} | Richmedia`, description: page.description };
const sectorSiloLinks = sectorSiloLinksEn[page.slug as keyof typeof sectorSiloLinksEn] ?? enSiloLinks.sectorsHub;
const schema = [
  {
    ...serviceSchema({ name: page.title, description: page.quick || page.description, url: pageUrl }),
    '@id': `${pageUrl}#service`,
    inLanguage: 'en',
    serviceType: page.label,
    category: 'Sector digital marketing',
    keywords: page.levers,
  },
  faqSchema(page.faq),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Sectors', url: `${SITE.url}/en/sectors` },
    { name: page.label, url: pageUrl },
  ]),
];
---

<BaseLayout title={seo.title} description={seo.description} canonical={pageUrl} lang="en" schema={schema}>
  <article class="sector-detail">
    <section class="sector-hero" aria-labelledby="sector-title">
      <div class="sector-hero-copy">
        <span class="section-kicker">Sector / {page.label}</span>
        <h1 id="sector-title">{page.h1}</h1>
        <p>{page.description}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/en/contact">
            Talk to an expert
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/sectors">
            All sectors
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      <figure class="sector-hero-visual">
        <img src={page.heroImage} alt={`${page.label} digital marketing in Morocco`} width="1280" height="900" loading="eager" decoding="async" fetchpriority="high" />
        <figcaption>
          <span>References</span>
          <div>{page.clients.map((client) => <strong>{client}</strong>)}</div>
        </figcaption>
      </figure>
    </section>

    <QuickAnswer text={page.quick} />

    <section class="sector-section" aria-labelledby="challenges-title">
      <div class="section-heading">
        <span class="section-kicker">Challenges</span>
        <h2 id="challenges-title">Priority sector challenges.</h2>
      </div>
      <div class="card-grid">
        {page.challenges.map((item) => (
          <article class="motion-card">
            <i class={`ph ${item.icon}`} aria-hidden="true"></i>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sector-section method-section" aria-labelledby="method-title">
      <div class="section-heading">
        <span class="section-kicker">Method</span>
        <h2 id="method-title">{page.methodTitle}.</h2>
      </div>
      <div class="method-layout">
        <div class="method-timeline">
          {page.method.map((step, index) => (
            <article class="motion-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <i class={`ph ${step.icon}`} aria-hidden="true"></i>
              <h3>{step.title}</h3>
              <ul>
                {step.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <aside class="levers-panel motion-card" aria-label={`${page.label} key levers`}>
          <i class="ph ph-lightning" aria-hidden="true"></i>
          <h3>Key levers</h3>
          <ul>{page.levers.map((lever) => <li>{lever}</li>)}</ul>
        </aside>
      </div>
    </section>

    <section class="sector-section" aria-labelledby="campaigns-title">
      <div class="section-heading">
        <span class="section-kicker">Campaigns</span>
        <h2 id="campaigns-title">Campaigns we know how to run.</h2>
      </div>
      <div class="campaign-grid">
        {page.campaigns.map((campaign) => (
          <article class="campaign-card">
            <img src={campaign.image} alt={`${campaign.title} campaign for ${page.label}`} width="800" height="520" loading="lazy" decoding="async" />
            <div>
              <i class={`ph ${campaign.icon}`} aria-hidden="true"></i>
              <h3>{campaign.title}</h3>
              <p>{campaign.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="case-panel" aria-labelledby="case-title">
      <img src={page.caseImage} alt={`${page.caseTitle} - ${page.label}`} width="1280" height="720" loading="lazy" decoding="async" />
      <div>
        <span class="section-kicker">References</span>
        <h2 id="case-title">{page.caseTitle}.</h2>
        <p>{page.caseText}</p>
        <div class="reference-pills">{page.clients.map((client) => <span>{client}</span>)}</div>
      </div>
    </section>

    <section class="sector-cta" aria-labelledby="cta-title">
      <div>
        <span class="section-kicker">Next step</span>
        <h2 id="cta-title">{page.cta}?</h2>
      </div>
      <a class="button button-primary" href="/en/contact">
        Start the discussion
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>

    <Faq faq={page.faq} lang="en" emitSchema={false} />
  </article>
  <SeoSiloLinks
    title="Connect this sector to the right levers"
    intro="These pathways link each business need to the closest expertises, content and proof points."
    links={sectorSiloLinks}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    max-width: 1280px;
  }

  .sector-detail {
    display: grid;
    gap: clamp(2rem, 5vw, 4.6rem);
  }

  .sector-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1.05fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-top: clamp(1rem, 4vw, 3.5rem);
  }

  .sector-hero-copy,
  .sector-section,
  .method-layout,
  .sector-cta {
    display: grid;
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 {
    color: #fff;
    font-size: clamp(2.7rem, 6.5vw, 5.9rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.95;
    text-wrap: balance;
  }

  h2 {
    color: #fff;
    font-size: clamp(2rem, 4.5vw, 4.2rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
    text-wrap: balance;
  }

  h3 {
    color: #fff;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.14;
  }

  p {
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.7;
  }

  .sector-hero-copy > p {
    max-width: 65ch;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }

  .sector-hero-visual {
    position: relative;
    min-height: clamp(23rem, 36vw, 34rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: #07070c;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.32);
  }

  .sector-hero-visual::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 44%, rgba(3, 3, 8, 0.9)),
      radial-gradient(circle at 15% 10%, rgba(139, 88, 255, 0.18), transparent 18rem);
    content: "";
    pointer-events: none;
  }

  .sector-hero-visual > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }

  .sector-hero-visual figcaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 1;
    display: grid;
    gap: 0.85rem;
  }

  .sector-hero-visual figcaption > span {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sector-hero-visual figcaption div,
  .reference-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .sector-hero-visual strong,
  .reference-pills span {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(5, 5, 10, 0.62);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 0.58rem 0.72rem;
    text-transform: uppercase;
  }

  .section-heading {
    display: grid;
    gap: 0.7rem;
    max-width: 820px;
  }

  .card-grid,
  .campaign-grid,
  .method-timeline {
    display: grid;
    gap: 0.9rem;
  }

  .card-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .motion-card,
  .campaign-card,
  .case-panel,
  .sector-cta {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background:
      radial-gradient(circle at 12% 0%, rgba(124, 60, 255, 0.18), transparent 14rem),
      rgba(255, 255, 255, 0.035);
  }

  .motion-card,
  .campaign-card {
    position: relative;
    overflow: hidden;
    transform: translateZ(0);
    transition:
      transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 280ms ease,
      box-shadow 280ms ease,
      background 280ms ease;
  }

  .motion-card {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    min-height: 12.5rem;
    padding: 1.15rem;
  }

  .motion-card::before,
  .campaign-card::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 4%, rgba(255, 255, 255, 0.14) 42%, transparent 68%),
      radial-gradient(circle at 86% 18%, rgba(154, 93, 255, 0.22), transparent 38%);
    content: "";
    opacity: 0;
    transform: translateX(-24%);
    transition: opacity 240ms ease, transform 520ms ease;
    pointer-events: none;
  }

  .motion-card:hover,
  .motion-card:focus-within,
  .campaign-card:hover,
  .campaign-card:focus-within {
    border-color: rgba(174, 112, 255, 0.7);
