---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../../../components/SeoSiloLinks.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../../../lib/schema';
import { enSiloLinks } from '../../../../lib/seo-silos';

const assetBase = '/assets/richmedia-phygital';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/en/expertises/phygital`;

const seoTitle = 'Phygital agency in Casablanca - street marketing, retail & data | Richmedia';
const seoDescription =
  'Richmedia designs phygital activations in Morocco: street marketing, pop-up retail, QR/NFC, sampling, gamification, lead capture and field ROI reporting.';

const phygitalTools = [
  { name: 'Google Tag Manager', logo: 'google-tag-manager.svg', note: 'QR, events & tracking' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Journeys & conversions' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'Activation dashboard' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'UX post-scan' },
  { name: 'Zapier', logo: 'zapier.svg', note: 'Leads to CRM' },
  { name: 'Meta', logo: 'meta.svg', note: 'Social amplification' },
  { name: 'Google Trends', logo: 'google-trends.png', note: 'Local demand signals' },
  { name: 'JavaScript', logo: 'javascript.svg', note: 'Web experiences' },
];

const proofCards = [
  {
    metric: 'Field',
    title: 'Activations that truly stop passersby',
    text: 'We design clear, visible and human street marketing setups: ambassadors, stands, sampling, demos and fast journeys.',
  },
  {
    metric: 'QR / NFC',
    title: 'Every interaction becomes measurable',
    text: 'Scan, game, coupon, form, WhatsApp or mobile page: the field feeds usable data for your marketing and sales teams.',
  },
  {
    metric: 'Retail',
    title: 'Pop-up, point of sale and connected commerce',
    text: 'We connect activation, product availability, local offer, CRM, retargeting and social content to extend impact after the visit.',
  },
  {
    metric: 'ROI',
    title: 'Field reporting, not just event photos',
    text: 'Generated traffic, opt-in leads, scans, participation, coupons, sales, UGC, cost per contact and insights are tracked to decide what comes next.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    label: 'Hybrid by design',
    title: 'Physical experiences need a native digital extension',
    text: 'In 2026, a high-performing field activation is designed with QR, social content, CRM, retargeting, coupons and mobile journeys from the concept stage.',
  },
  {
    label: 'Participation',
    title: 'People want to do, not only watch',
    text: 'Games, challenges, product trials, badges, prize wheels, instant wins and shareable content increase time spent, recall and UGC.',
  },
  {
    label: 'First-party data',
    title: 'Consented data becomes a major deliverable',
    text: 'A phygital setup must collect useful signals: preferences, opt-in, location, participation, intent and lead quality.',
  },
  {
    label: 'Unified commerce',
    title: 'Connected retail replaces isolated experiences',
    text: 'Stock, POS, CRM, e-commerce, customer service and campaigns must work together so people move naturally from stand to purchase.',
  },
  {
    label: 'Micro-experiences',
    title: 'Local formats often beat heavy static setups',
    text: 'Tours, light pop-ups, campuses, malls, beaches, stations and high-traffic neighborhoods make it possible to test, learn and scale precisely.',
  },
  {
    label: 'SEO / GEO',
    title: 'Activations must leave a citable trace for AI engines',
    text: 'Landing pages, FAQs, proof, structured data, field content and local mentions strengthen Google discovery and generative answers.',
  },
];

const activationFormats = [
  {
    image: 'activation-sampling.webp',
    type: 'Connected sampling',
    place: 'Shopping street',
    title: 'Make people try, scan and convert',
    text: 'Mobile stand, instant offer, QR opt-in, coupon, WhatsApp, tracking and CRM follow-up after the product trial.',
    formats: ['Sampling', 'Coupon', 'Lead opt-in'],
  },
  {
    image: 'activation-game.webp',
    type: 'Field gamification',
    place: 'Mall / public square',
    title: 'Turn stopping into participation',
    text: 'Prize wheel, challenge, digital badge, instant win, leaderboard or photo moment to create engagement and shareable content.',
    formats: ['Game', 'QR/NFC', 'UGC'],
  },
  {
    image: 'activation-popup.webp',
    type: 'Pop-up retail',
    place: 'Casablanca / Marrakech',
    title: 'Create a premium contact point',
    text: 'Modular booth, demo, screen, check-in, staffing and post-scan journey to connect experience and commerce.',
    formats: ['Pop-up', 'Demo', 'Retail media'],
  },
];

const services = [
  {
    kicker: 'Concept',
    title: 'Phygital strategy and activation mechanics',
    text: 'Goals, target, location, message, journey, incentive, QR/NFC mechanics, social plan and field KPIs before any production.',
    items: ['Journey', 'Concept', 'KPIs', 'Budget'],
  },
  {
    kicker: 'Production',
    title: 'Street marketing, pop-up and field logistics',
    text: 'Stands, signage, sampling, ambassadors, permits, planning, mission sheets, coordination and live supervision.',
    items: ['Booth', 'Sampling', 'Staff', 'Ops'],
  },
  {
    kicker: 'Data',
    title: 'QR, NFC, landing pages and CRM',
    text: 'Mobile pages, forms, UTMs, tracking, opt-in, WhatsApp, coupons, dashboards and connection to commercial tools.',
    items: ['QR/NFC', 'CRM', 'UTM', 'Coupons'],
  },
  {
    kicker: 'Amplification',
    title: 'Social, influence and post-activation retargeting',
    text: 'Capture, social-first content, local influence, paid social, retargeting and reporting to extend the experience beyond the field.',
    items: ['UGC', 'Paid', 'Influence', 'ROI'],
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Framing',
    text: 'Goal, target, locations, traffic flows, offer, seasonality, field constraints, available data and brand rules.',
  },
  {
    step: '02',
    title: 'Concept',
    text: 'Stopping mechanic, story, QR/NFC journey, incentive, social content, data architecture and measurable KPIs.',
  },
  {
    step: '03',
    title: 'Production',
    text: 'Booth, signage, ambassador scripts, permits, material, landing pages, tracking and field rehearsal.',
  },
  {
    step: '04',
    title: 'Activation',
    text: 'Deployment, supervision, quality control, live adjustments, content capture, field feedback and flow optimization.',
  },
  {
    step: '05',
    title: 'Measurement',
    text: 'Dashboard, scans, leads, coupons, sales, generated content, audience feedback, cost per interaction and scaling recommendations.',
  },
];

const deliverables = [
  'Field and competitor audit',
  'Phygital activation concept',
  'QR/NFC or WhatsApp journey',
  'Location and flow plan',
  'Ambassador brief',
  'Booth and signage design',
  'Landing page mobile',
  'Opt-in forms and coupons',
  'UTM / event tracking kit',
  'Social and local influence plan',
  'Field performance dashboard',
  'ROI recap and recommendations',
];

const sources = [
  {
    title: 'Shopify Omnichannel Retail 2026',
    text: 'Customer journeys move across physical and digital channels, with customer data, stock, order and service connected behind the scenes.',
    href: 'https://www.shopify.com/il/enterprise/blog/omni-channel-retail-strategy',
  },
  {
    title: 'Shopify Digital Transformation 2026',
    text: 'Unified commerce becomes the base of phygital: one real-time data layer for stores, e-commerce, POS and new channels.',
    href: 'https://www.shopify.com/blog/digital-transformation-trends-in-retail',
  },
  {
    title: 'commercetools Commerce Megatrends',
    text: 'Unified commerce turns stores into immersive showrooms, service hubs and personalized touchpoints.',
    href: 'https://commercetools.com/blog/trends-that-define-retail-success',
  },
  {
    title: 'Cvent Experiential Marketing 2026',
    text: 'Experiential marketing is maturing: budget, engagement, hybrid formats, technology and measurement become standards.',
    href: 'https://www.cvent.com/en/blog/events/experiential-marketing-statistics',
  },
  {
    title: 'Farias Experiential Trends 2026',
    text: 'Hybrid experiences, micro-experiences, real-time data, sustainability and community are redefining activations.',
    href: 'https://farias.co/insights/experiential-marketing-trends-2026',
  },
  {
    title: 'Seeker Experiential Trends 2026',
    text: 'Active participation, first-party data, AI, gamification and hybrid formats shape modern activations.',
    href: 'https://seeker.io/blog/experiential-marketing-trends/',
  },
];

const faq = [
  {
    question: 'What is a phygital agency?',
    answer:
      'A phygital agency designs experiences that connect field and digital: street marketing, pop-ups, QR/NFC, landing pages, CRM, data, social content and reporting to turn a physical interaction into a measurable journey.',
  },
  {
    question: 'What is the difference between street marketing and phygital?',
    answer:
      'Street marketing creates the physical contact. Phygital adds a measurable digital layer: QR scan, signup, coupon, WhatsApp, game, social content, retargeting and CRM tracking.',
  },
  {
    question: 'How do you measure the ROI of a phygital activation?',
    answer:
      'We track traffic, scans, participation, opt-in leads, coupons used, sales, cost per contact, generated content, lead quality and field insights.',
  },
  {
    question: 'Which phygital formats are relevant in Morocco?',
    answer:
      'The most effective formats include connected sampling, retail pop-ups, mall activations, campus, beach, urban tours, QR/NFC games, WhatsApp couponing, mobile showrooms and social-first content.',
  },
  {
    question: 'Why optimize a phygital page for SEO/GEO?',
    answer:
      'Because search engines and AI engines cite clear, structured and credible pages. FAQs, structured data, proof, sources and local content strengthen offer discoverability.',
  },
];

const schema = [
  serviceSchema({
    name: 'Phygital and street marketing',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Expertise', url: `${SITE.url}/en/expertises` },
    { name: 'Phygital', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: 'Live' },
  { href: '#trends', label: 'Trends', value: '2026' },
  { href: '#formats', label: 'Formats', value: 'Field' },
  { href: '#phygital-cta', label: 'Project', value: 'Activate' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/phygital-hero.webp`}
  schema={schema}
  lang="en"
>
  <div class="phygital-page">
    <section class="phygital-hero" aria-labelledby="phygital-title">
      <div class="hero-copy">
        <span class="eyebrow">Richmedia expertise</span>
        <h1 id="phygital-title">Measurable phygital & street marketing.</h1>
        <p class="hero-lead">
          Richmedia creates field activations that connect the street, retail, mobile, CRM and data:
          sampling, pop-ups, QR/NFC, gamification, social content and ROI reporting.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/en/contact">
            Design an activation
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/case-studies">
            View case studies
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual phygital-hover-lab" aria-label="Richmedia phygital street marketing activation">
        <img src={`${assetBase}/phygital-hero.webp`} alt="Phygital street marketing activation with booth, QR code and brand ambassadors" />
        <div class="signal-card signal-card-top">
          <span>Street</span>
          <strong>Booth + ambassadors</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>Scan</span>
          <strong>QR / NFC / WhatsApp</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>Data</span>
          <strong>Leads + coupons</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-phygital-nav" aria-label="Phygital page navigation">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section id="cockpit" class="phygital-cockpit" aria-label="Richmedia phygital promises">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Field cockpit</strong>
          <small>live activation</small>
        </div>
        <div class="cockpit-zero">
          <span>LIVE</span>
          <div>
            <p>{proofCards[0].metric} activated</p>
            <h2>Create the stop, capture the signal and connect the field to CRM.</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 91%">
            <span>Qualified field flow</span>
            <i></i>
          </div>
          <div style="--value: 84%">
            <span>Usable QR / NFC scans</span>
            <i></i>
          </div>
          <div style="--value: 76%">
            <span>Tracked leads and coupons</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="answer" class="quick-answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Quick answer</span>
        <h2 id="quick-answer-title">In 2026, a field activation must generate attention and data.</h2>
      </div>
      <p>
        Phygital is not a booth with a QR code placed on top. It is a complete journey: stop the right
        audience, create a useful interaction, collect a consented signal, follow up intelligently and measure
        what truly created value.
      </p>
    </section>

    <section id="trends" class="trend-section" aria-labelledby="trend-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Phygital trends 2026</span>
          <h2 id="trend-title">What brands must master now.</h2>
        </div>
        <p>
          Winning activations combine physical impact, participatory experience, first-party data,
          unified commerce, social content and real-time optimization.
        </p>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="formats" class="activation-section" aria-labelledby="activation-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Field formats</span>
          <h2 id="activation-title">Street marketing activations designed to be experienced, scanned and shared.</h2>
        </div>
        <p>
          Every format is designed to create a real moment, then extend that moment into digital channels:
          landing page, WhatsApp, CRM, social content and retargeting.
        </p>
      </div>
      <div class="activation-grid">
        {activationFormats.map((activation) => (
          <article>
            <div class="activation-photo">
              <img src={`${assetBase}/${activation.image}`} alt={`${activation.title} - ${activation.place}`} loading="eager" decoding="async" />
            </div>
            <div class="activation-copy">
              <span>{activation.type} / {activation.place}</span>
              <h3>{activation.title}</h3>
              <p>{activation.text}</p>
              <div>
                {activation.formats.map((format) => <small>{format}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="system" class="phygital-system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-top">
            <span></span><span></span><span></span>
            <strong>richmedia / field-growth</strong>
          </div>
          <div class="screen-body">
            <div class="data-card data-card-a">
              <span>live_scan_rate</span>
              <strong>1,248 interactions</strong>
              <small>QR / coupon / WhatsApp / CRM</small>
            </div>
            <div class="data-card data-card-b">
              <span>field_roi</span>
              <strong>Qualified leads +32%</strong>
              <small>UTM tracking / dashboard / retargeting</small>
            </div>
            <div class="phygital-flow">
              <span>Street</span>
              <i></i>
              <span>Mobile</span>
              <i></i>
              <span>CRM</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Our phygital system</span>
        <h2 id="system-title">A phygital agency that connects field production, digital and performance.</h2>
        <p>
          We orchestrate the full activation: strategy, concept, production, field teams,
          mobile experience, tracking, content, amplification and reporting. The result: a physical presence
          that keeps working after the event.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="tool-stack" aria-labelledby="tool-title">
      <div class="section-heading compact">
        <span class="eyebrow">Tools & measurement</span>
        <h2 id="tool-title">The stack that turns a field activation into usable data.</h2>
      </div>
      <div class="logo-marquee" aria-label="Phygital, tracking and reporting tools">
        <div class="logo-track">
          {[0, 1].map((loopIndex) => (
            <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
              {phygitalTools.map((tool) => (
                <figure>
                  <span>
                    <img
                      src={`${logoBase}/${tool.logo}`}
                      alt={loopIndex === 0 ? `Logo ${tool.name}` : ''}
                      loading="eager"
                      decoding="async"
                    />
                  </span>
                  <figcaption>{tool.name}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {phygitalTools.map((tool) => (
          <figure>
            <span>
              <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="eager" decoding="async" />
            </span>
            <figcaption>
              <strong>{tool.name}</strong>
              <small>{tool.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Richmedia method</span>
          <h2 id="roadmap-title">From field concept to dashboard, every step is controlled.</h2>
        </div>
        <p>
          Our method secures the field, smooths the user experience, equips ambassadors and gives
          marketing teams a clear reading of impact.
        </p>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="deliverables" class="deliverables-section" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Deliverables</span>
        <h2 id="deliverables-title">What you receive to manage the field without blind spots.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section id="sources" class="sources-section" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">2026 watch</span>
        <h2 id="sources-title">Market signals integrated into our approach.</h2>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noopener">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
            <small>Read the source <i class="ph ph-arrow-up-right" aria-hidden="true"></i></small>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Frequently asked questions.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="phygital-cta" class="phygital-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Ready to activate the field?</span>
        <h2 id="cta-title">Turn your physical contacts into measurable digital journeys.</h2>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/en/contact">
          Talk to Richmedia
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Connect field, media and CRM"
    intro="Phygital activations perform when they connect traffic, points of sale, QR, WhatsApp and measurement."
    links={enSiloLinks.phygital}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .phygital-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 60, 255, 0.18), transparent 28rem),
      radial-gradient(circle at 12% 30%, rgba(124, 60, 255, 0.1), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
  }

  .phygital-hero,
  .mobile-phygital-nav,
  .phygital-cockpit,
  .quick-answer,
  .trend-section,
  .activation-section,
  .phygital-system,
  .tool-stack,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .phygital-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .phygital-cockpit,
  .quick-answer,
  .trend-section,
  .activation-section,
  .phygital-system,
  .tool-stack,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .phygital-cta {
    scroll-margin-top: 6rem;
  }

  .mobile-phygital-nav {
    display: none;
  }

  .phygital-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    min-height: 94vh;
    padding: clamp(7rem, 11vw, 10rem) 0 5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-2);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.1rem;
    height: 2px;
    content: "";
