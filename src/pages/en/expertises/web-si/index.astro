    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
    transition: border-color 220ms ease, background 220ms ease, box-shadow 220ms ease;
  }

  .system-flow span::before {
    position: absolute;
    inset: 0;
    content: "";
    background:
      radial-gradient(circle at 50% 0, rgba(169, 119, 255, 0.32), transparent 58%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.1), transparent 62%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .system-flow i {
    position: relative;
    overflow: hidden;
    width: 2rem;
    height: 1px;
    background: linear-gradient(90deg, rgba(169, 119, 255, 0.2), rgba(169, 119, 255, 0.9));
  }

  .system-flow i::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(90deg, transparent, #fff, rgba(169, 119, 255, 0.95));
    opacity: 0;
    transform: translateX(-110%);
