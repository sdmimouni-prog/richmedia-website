  .code-panel::before {
    position: absolute;
    inset: -46% -18%;
    content: "";
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(169, 119, 255, 0.06) 42%,
      rgba(255, 255, 255, 0.22) 50%,
      rgba(169, 119, 255, 0.06) 58%,
