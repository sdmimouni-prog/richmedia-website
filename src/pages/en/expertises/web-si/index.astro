  @media (hover: hover) and (pointer: fine) {
    .browser-shell:hover {
      border-color: rgba(169, 119, 255, 0.56);
      box-shadow:
        0 2.4rem 6rem rgba(0, 0, 0, 0.52),
        0 0 0 1px rgba(169, 119, 255, 0.16),
        0 0 4.2rem rgba(124, 60, 255, 0.24);
      transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(-8px) scale(1.015);
    }

    .browser-shell:hover::before {
      border-color: rgba(169, 119, 255, 0.18);
      filter: drop-shadow(0 0 1.6rem rgba(124, 60, 255, 0.18));
      opacity: 0.95;
    }

    .browser-shell:hover::after {
      opacity: 1;
      animation: browser-aurora 4.8s linear infinite;
    }

    .browser-shell:hover .browser-top span {
      background: rgba(169, 119, 255, 0.75);
      box-shadow: 0 0 1.1rem rgba(169, 119, 255, 0.42);
      animation: browser-dot-pop 720ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .browser-shell:hover .browser-top span:nth-child(2) {
      animation-delay: 70ms;
    }

    .browser-shell:hover .browser-top span:nth-child(3) {
      animation-delay: 140ms;
    }

    .browser-shell:hover .browser-top strong {
      color: rgba(255, 255, 255, 0.86);
      transform: translateX(3px);
    }

    .browser-shell:hover .code-panel {
      border-color: rgba(200, 169, 255, 0.82);
      background: rgba(7, 9, 18, 0.92);
      box-shadow:
        0 1.6rem 3.8rem rgba(0, 0, 0, 0.46),
        0 0 2.2rem rgba(124, 60, 255, 0.23);
      transform: translate3d(0, -6px, 58px) scale(1.025);
    }

    .browser-shell:hover .code-panel::before {
      opacity: 1;
      animation: code-panel-scan 1.15s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    .browser-shell:hover .code-panel span {
      color: #cbb1ff;
      text-shadow: 0 0 1rem rgba(169, 119, 255, 0.58);
    }

    .browser-shell:hover .code-panel strong {
      text-shadow: 0 0 1.4rem rgba(255, 255, 255, 0.18);
    }

    .browser-shell:hover .system-flow span {
      border-color: rgba(169, 119, 255, 0.45);
      background: rgba(169, 119, 255, 0.12);
      box-shadow: 0 0 1.8rem rgba(124, 60, 255, 0.16);
      animation: flow-node-pulse 860ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .browser-shell:hover .system-flow span::before {
      opacity: 1;
    }

    .browser-shell:hover .system-flow span:nth-of-type(2) {
      animation-delay: 160ms;
    }

    .browser-shell:hover .system-flow span:nth-of-type(3) {
      animation-delay: 320ms;
    }

    .browser-shell:hover .system-flow i::after {
      opacity: 1;
      animation: flow-line-pass 760ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .browser-shell:hover .system-flow i:nth-of-type(2)::after {
      animation-delay: 190ms;
    }
  }

  @keyframes browser-aurora {
    0% {
      filter: hue-rotate(0deg);
      transform: translate3d(-1%, -1%, 0) scale(1);
    }

    50% {
      filter: hue-rotate(16deg);
      transform: translate3d(1.5%, 1%, 0) scale(1.03);
    }

    100% {
      filter: hue-rotate(0deg);
      transform: translate3d(-1%, -1%, 0) scale(1);
    }
  }

  @keyframes browser-dot-pop {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    45% {
      transform: translateY(-2px) scale(1.18);
    }
  }

  @keyframes code-panel-scan {
    0% {
      transform: translateX(-120%) rotate(8deg);
    }

    100% {
      transform: translateX(120%) rotate(8deg);
    }
  }

  @keyframes flow-node-pulse {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    45% {
      transform: translateY(-5px) scale(1.035);
    }
  }

  @keyframes flow-line-pass {
    0% {
      transform: translateX(-110%);
    }

    100% {
      transform: translateX(110%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .browser-shell,
    .browser-shell::before,
    .browser-shell::after,
    .browser-top span,
    .browser-top strong,
    .code-panel,
    .code-panel::before,
    .code-panel span,
    .code-panel strong,
    .system-flow span,
    .system-flow span::before,
    .system-flow i::after,
