---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../../../lib/schema';

const assetBase = '/assets/richmedia-web-si';
const logoBase = `${assetBase}/logos`;

const seoTitle = 'Web & IS agency in Casablanca - websites, platforms, CRM & GEO | Richmedia';
const seoDescription =
  'Richmedia designs websites, platforms and connected systems in Casablanca: UX/UI, SEO/GEO, CRM, tracking, security and performance.';
const pageUrl = `${SITE.url}/en/expertises/web-si`;

const trends = [
  {
    label: 'AI search',
    title: 'Pages readable by Google and AI engines',
    text: 'Clear structure, direct answers, FAQs, JSON-LD, static HTML and expert content designed to be understood, reused and cited.',
  },
  {
    label: 'Owned media',
    title: 'The website becomes the content hub again',
    text: 'Social, video and creator campaigns need to land in a fast, measurable and reusable owned space.',
  },
  {
    label: 'First-party data',
    title: 'Personalization without platform dependency',
    text: 'Forms, CRM, WhatsApp, consent and scoring turn visits into useful and actionable first-party data.',
  },
  {
    label: 'Proof content',
    title: 'Proof replaces generic claims',
    text: 'Case studies, reviews, demos, figures and field content give both visitors and AI engines trust signals.',
  },
  {
    label: 'Composable',
    title: 'Connected IS blocks instead of one frozen platform',
    text: 'CMS, APIs, back offices, dashboards and automations are designed to evolve without rebuilding the whole platform.',
  },
  {
    label: 'Performance',
    title: 'Speed, accessibility and security from the brief',
    text: 'A strong web system protects search visibility, conversion, compliance and mobile experience quality.',
  },
];

const systemModules = [
  {
    kicker: 'UX/UI',
    title: 'Useful websites and interfaces',
    text: 'Information architecture, design system, SEO/GEO pages, landing pages, forms and mobile-first journeys.',
    items: ['Showcase site', 'Landing pages', 'Design system', 'Accessibility'],
  },
  {
    kicker: 'Platform',
    title: 'CMS, back office and connected spaces',
    text: 'Editable spaces to publish, manage content, handle leads or connect a business service.',
    items: ['CMS', 'Back office', 'Portal', 'E-commerce'],
  },
  {
    kicker: 'Marketing IS',
    title: 'CRM, WhatsApp, API and automation',
    text: 'The website becomes an entry point into the commercial system: qualification, routing, nurturing and follow-up.',
    items: ['CRM', 'API', 'WhatsApp', 'Automation'],
  },
  {
    kicker: 'Measurement',
    title: 'Tracking, dashboards and continuous QA',
    text: 'Tagging plan, key events, tests, user feedback and dashboards to make faster, better decisions.',
    items: ['GTM', 'Analytics', 'Marker.io', 'Reporting'],
  },
];

const deliverables = [
  'UX, SEO/GEO and technical audit',
  'Information architecture',
  'Wireframes and UI mockups',
  'Web design system',
  'SEO/GEO optimized pages',
  'Front-end development',
  'Back office or CMS',
  'CRM & API integrations',
  'Tracking plan',
  'Responsive testing',
  'Security & performance QA',
  'Delivery documentation',
];

const toolGroups = [
  {
    title: 'Front-end & experience',
    tools: [
      { name: 'HTML5', logo: 'html5.png', note: 'Semantic structure' },
      { name: 'JavaScript', logo: 'javascript.png', note: 'Interactions and tracking' },
      { name: 'React', logo: 'react.png', note: 'Dynamic interfaces' },
    ],
  },
  {
    title: 'Back-end, data & IS',
    tools: [
      { name: 'Node.js', logo: 'nodejs.png', note: 'APIs and services' },
      { name: 'PHP', logo: 'php.png', note: 'CMS ecosystems' },
      { name: 'Laravel', logo: 'laravel.png', note: 'Business applications' },
      { name: 'SQL', logo: 'sql.png', note: 'Structured data' },
    ],
  },
  {
    title: 'Quality, collaboration & delivery',
    tools: [
      { name: 'GitHub', logo: 'github.png', note: 'Versioning and delivery' },
      { name: 'Marker.io', logo: 'markerio.png', note: 'QA and feedback' },
    ],
  },
];

const heroTools = toolGroups.flatMap((group) => group.tools);

const roadmap = [
  {
    step: '01',
    title: 'Frame',
    text: 'Business goals, audiences, content, IS constraints, SEO/GEO priorities and conversion journeys.',
  },
  {
    step: '02',
    title: 'Architect',
    text: 'Page plan, data structure, components, integrations, tracking and governance rules.',
  },
  {
    step: '03',
    title: 'Build',
    text: 'Design, development, content, CMS, forms, APIs and automations with short validation cycles.',
  },
  {
    step: '04',
    title: 'Verify',
    text: 'Responsive tests, performance, accessibility, security, technical SEO, markup and business QA.',
  },
  {
    step: '05',
    title: 'Optimize',
    text: 'Signal analysis, fixes, A/B tests, content enrichment, automations and continuous reporting.',
  },
];

const sourceNotes = [
  {
    title: 'AI search & helpful content',
    text: 'Visibility depends on pages that are clear, original, technically accessible and structured for both traditional and AI engines.',
    href: 'https://developers.google.com/search/docs/fundamentals/creating-helpful-content',
  },
  {
    title: 'Marketing 2026',
    text: 'Marketing teams are accelerating around AI, personalization, short-form video, measurement and multi-channel experiences.',
    href: 'https://blog.hubspot.com/marketing/hubspot-blog-marketing-industry-trends-report',
  },
  {
    title: 'B2B content',
    text: 'High-performing content combines expertise, trust, distribution, owned media and concrete proof.',
    href: 'https://contentmarketinginstitute.com/b2b-research/b2b-content-marketing-trends-research/',
  },
  {
    title: 'Creators & video',
    text: 'Creator content is becoming a media channel tracked like the others, with a growing need for landing pages and measurable proof.',
    href: 'https://www.marketingdive.com/news/creator-marketing-now-a-core-media-channel-while-search-slows-iab/817832/',
  },
];

const faq = [
  {
    question: 'What is Richmedia Web & IS expertise?',
    answer:
      'Web & IS covers the design of websites, platforms, CMS, back offices and integrations that connect user experience with CRM, data, tracking and business systems.',
  },
  {
    question: 'Why connect a website to the information system?',
    answer:
      'A connected website qualifies leads better, avoids duplicate entry, improves measurement reliability, automates follow-ups and turns campaigns into owned assets.',
  },
  {
    question: 'How can a Web & IS page be optimized for SEO/GEO?',
    answer:
      'It must clearly answer audience questions, use clean HTML structure, JSON-LD, FAQs, proof, canonical URLs and content precise enough to be cited by AI engines.',
  },
  {
    question: 'Does Richmedia only build showcase websites?',
    answer:
      'No. Richmedia can create premium showcase websites, landing pages, web platforms, back offices, CRM integrations, WhatsApp journeys, dashboards and QA systems.',
  },
];

const schema = [
  serviceSchema({
    name: 'Web & IS',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Expertise', url: `${SITE.url}/en/expertises` },
    { name: 'Web & IS', url: pageUrl },
  ]),
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${logoBase}/contact-sheet.png`}
  lang="en"
  schema={schema}
>
  <div class="web-si-page">
    <section class="web-hero" aria-labelledby="web-si-title">
      <div class="hero-copy">
        <span class="eyebrow">Richmedia expertise</span>
        <h1 id="web-si-title">Web & IS connected to growth.</h1>
        <p class="hero-lead">
          We design websites, platforms and connected systems that turn your content,
          campaigns and data into visible, measurable journeys your teams can activate.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/en/contact">
            Frame your web project
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/case-studies">
            View case studies
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-system" aria-label="Richmedia Web & IS interface">
        <div class="browser-shell" data-web-si-hover-card>
          <div class="browser-top" aria-hidden="true">
            <span></span><span></span><span></span>
            <strong>richmedia.ma / web-si</strong>
          </div>
          <div class="browser-body">
            <div class="code-panel">
              <span>&lt;section type="growth-system"&gt;</span>
              <strong>SEO/GEO + CRM + tracking</strong>
              <small>Fast pages, clean data, useful integrations.</small>
            </div>
            <div class="system-flow" aria-hidden="true">
              <span>Content</span>
              <i></i>
              <span>Data</span>
              <i></i>
              <span>CRM</span>
            </div>
          </div>
        </div>
        <div class="hero-logo-cloud" aria-label="Technologies used">
          <div class="logo-track">
            {[0, 1].map((loopIndex) => (
              <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
                {heroTools.map((tool) => (
                  <figure>
                    <span>
                      <img
                        src={`${logoBase}/${tool.logo}`}
                        alt={loopIndex === 0 ? `Logo ${tool.name}` : ''}
                        loading="eager"
                        decoding="async"
                      />
                    </span>
                    <figcaption>{tool.name}</figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="quick-answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Quick answer</span>
        <h2 id="quick-answer-title">In 2026, a website must be an acquisition system.</h2>
      </div>
      <p>
        A high-performing Web & IS system connects content, SEO/GEO, CRM, tracking, user feedback
        and automations to create visibility, convert the right prospects and learn faster.
      </p>
    </section>

    <section class="trend-section" aria-labelledby="trend-title">
      <div class="section-heading">
        <span class="eyebrow">Web & IS trends 2026</span>
        <h2 id="trend-title">What we integrate into web architecture.</h2>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="system-section" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="stack-card stack-card-main">
          <span>Web platform</span>
          <strong>UX, content, SEO/GEO</strong>
        </div>
        <div class="stack-card stack-card-left">
          <span>Marketing IS</span>
          <strong>CRM / API / WhatsApp</strong>
        </div>
        <div class="stack-card stack-card-right">
          <span>Measurement</span>
          <strong>Tracking / QA / dashboards</strong>
        </div>
        <div class="stack-lines"></div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">The Richmedia system</span>
        <h2 id="system-title">Beautiful interfaces, but above all operable ones.</h2>
        <p>
          We build the web as a business asset: clear for visitors, indexable by search engines,
          connected to commercial tools and easy to evolve after launch.
        </p>
        <div class="module-grid">
          {systemModules.map((module) => (
            <article>
              <span>{module.kicker}</span>
              <h3>{module.title}</h3>
              <p>{module.text}</p>
              <div>
                {module.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="deliverables-section" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Deliverables</span>
        <h2 id="deliverables-title">What delivery must make manageable.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="tool-stack" aria-labelledby="tool-stack-title">
      <div class="section-heading compact">
        <span class="eyebrow">Partners & tools</span>
        <h2 id="tool-stack-title">A clear stack to design, develop, connect and test.</h2>
      </div>
      {toolGroups.map((group) => (
        <div class="tool-row">
          <h3>{group.title}</h3>
          <div class="tool-grid">
            {group.tools.map((tool) => (
              <figure>
                <span>
                  <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
                </span>
                <figcaption>
                  <strong>{tool.name}</strong>
                  <small>{tool.note}</small>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <span class="eyebrow">Method</span>
        <h2 id="roadmap-title">A web project framed like a digital product.</h2>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sources-section" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">2026 watch</span>
        <h2 id="sources-title">The signals used to frame this page.</h2>
      </div>
      <div class="source-grid">
        {sourceNotes.map((source) => (
          <a href={source.href} target="_blank" rel="noopener noreferrer">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Frequently asked questions.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="web-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Ready to connect?</span>
        <h2 id="cta-title">Let's create a website that serves your content, teams and sales.</h2>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/en/contact">
          Start a project
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const webSiHoverCards = document.querySelectorAll('[data-web-si-hover-card]');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canHover && !reduceMotion) {
    webSiHoverCards.forEach((card) => {
      if (!(card instanceof HTMLElement) || card.dataset.hoverReady === 'true') return;
      card.dataset.hoverReady = 'true';

      const resetCard = () => {
        card.style.setProperty('--mouse-x', '72%');
        card.style.setProperty('--mouse-y', '22%');
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
      };

      const moveCard = (event: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        const x = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
        const y = Math.min(Math.max((event.clientY - rect.top) / rect.height, 0), 1);

        card.style.setProperty('--mouse-x', `${(x * 100).toFixed(2)}%`);
        card.style.setProperty('--mouse-y', `${(y * 100).toFixed(2)}%`);
        card.style.setProperty('--tilt-x', `${((0.5 - y) * 7).toFixed(2)}deg`);
        card.style.setProperty('--tilt-y', `${((x - 0.5) * 9).toFixed(2)}deg`);
      };

      resetCard();
      card.addEventListener('pointermove', moveCard);
      card.addEventListener('pointerleave', resetCard);
      card.addEventListener('pointercancel', resetCard);
    });
  }
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .web-si-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.68);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 9%, rgba(124, 60, 255, 0.2), transparent 28rem),
      radial-gradient(circle at 12% 32%, rgba(124, 60, 255, 0.14), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
  }

  .web-hero,
  .quick-answer,
  .trend-section,
  .system-section,
  .deliverables-section,
  .tool-stack,
  .roadmap-section,
  .sources-section,
  .faq-section,
  .web-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .web-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(460px, 1.12fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(8rem, 12vw, 10.5rem) 0 clamp(3rem, 7vw, 5.5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-2);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.6rem;
    height: 2px;
    content: "";
    background: currentColor;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .web-hero h1 {
    max-width: 760px;
    margin-top: 1.2rem;
    --h1-size: clamp(2.45rem, 4.8vw, 3.125rem);
    line-height: 1;
    text-wrap: balance;
  }

  .hero-lead,
  .quick-answer p,
  .system-copy > p,
  .roadmap p,
  .faq-list p,
  .source-grid span {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.7;
  }

  .hero-lead {
    max-width: 680px;
    margin-top: 1.45rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    border-radius: 8px;
    padding: 0.9rem 1.25rem;
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9655ff, #6425f4);
    box-shadow: 0 1.1rem 2.8rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-system {
    position: relative;
    min-height: clamp(430px, 38vw, 560px);
    perspective: 1200px;
    perspective-origin: 55% 34%;
  }

  .browser-shell {
    --mouse-x: 72%;
    --mouse-y: 22%;
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    position: absolute;
    inset: 0 0 6rem;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background:
      radial-gradient(circle at var(--mouse-x) var(--mouse-y), rgba(169, 119, 255, 0.24), transparent 17rem),
      radial-gradient(circle at 78% 18%, rgba(124, 60, 255, 0.2), transparent 18rem),
      #07080d;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.42);
    transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(0) scale(1);
    transform-style: preserve-3d;
    transition:
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 260ms ease,
      box-shadow 260ms ease;
    will-change: transform;
  }

  .browser-shell::before {
    position: absolute;
    inset: 3.8rem 1.15rem 1.15rem;
    z-index: 0;
    content: "";
    border: 1px solid rgba(255, 255, 255, 0.09);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    transition: border-color 260ms ease, filter 260ms ease, opacity 260ms ease;
  }

  .browser-shell::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    background:
      radial-gradient(circle at var(--mouse-x) var(--mouse-y), rgba(169, 119, 255, 0.34), transparent 18rem),
      linear-gradient(115deg, transparent 18%, rgba(255, 255, 255, 0.08) 42%, transparent 62%);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .browser-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
    padding: 0 1rem;
    background: rgba(255, 255, 255, 0.035);
  }

  .browser-top span {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.26);
    transition: background 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .browser-top strong {
    margin-left: 0.6rem;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.78rem;
    font-weight: 700;
    transition: color 220ms ease, transform 220ms ease;
  }

  .browser-body {
    position: relative;
    z-index: 2;
    min-height: calc(100% - 3.25rem);
    transform-style: preserve-3d;
  }

  .code-panel {
    position: absolute;
    top: 16%;
    left: 6%;
    z-index: 2;
    display: grid;
    gap: 0.72rem;
    max-width: 23rem;
    overflow: hidden;
    border: 1px solid rgba(169, 119, 255, 0.42);
    border-radius: 8px;
    padding: clamp(1rem, 2vw, 1.4rem);
    background: rgba(5, 7, 15, 0.84);
    box-shadow: 0 1.25rem 3.4rem rgba(0, 0, 0, 0.34);
    transform: translate3d(0, 0, 34px);
    transition:
      transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 260ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
    will-change: transform;
