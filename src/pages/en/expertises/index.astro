---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ParticleLogoSlide from '../../../components/ParticleLogoSlide.astro';
import SeoSiloLinks from '../../../components/SeoSiloLinks.astro';
import { breadcrumbs } from '../../../lib/schema';
import { enSiloLinks } from '../../../lib/seo-silos';
import { SITE } from '../../../consts';

const assetBase = '/assets/richmedia-home';
const pageDescription =
  'Explore Richmedia expertise: digital strategy, brand content, web platforms, media buying, influence, phygital, events, AI and automation.';

const accreditationBadges = [
  { image: 'logos/accreditations-svg/google-ads.svg', name: 'Google Ads', label: 'Certified' },
  { image: 'logos/accreditations-svg/google-analytics.svg', name: 'Google Analytics', label: 'Certified' },
  { image: 'logos/accreditations-svg/hubspot.svg', name: 'HubSpot', label: 'Certified' },
  { image: 'logos/accreditations-svg/iab-rich-media.svg', name: 'IAB Rich Media', label: 'Certified' },
  { image: 'logos/accreditations-svg/meta-blueprint.svg', name: 'Meta Blueprint', label: 'Certified' },
  { image: 'logos/accreditations-svg/semrush.svg', name: 'Semrush', label: 'Certified' },
];

const schema = [breadcrumbs([
  { name: 'Home', url: `${SITE.url}/en` },
  { name: 'Expertise', url: `${SITE.url}/en/expertises` },
])];

const journey = [
  {
    step: '01 / Clarify',
    title: 'Strategy',
    text: 'Positioning, segmentation, goals and a concrete action plan.',
  },
  {
    step: '02 / Create',
    title: 'Creation',
    text: 'Storytelling, social-first content, design, photography, video and experiences.',
  },
  {
    step: '03 / Amplify',
    title: 'Amplification',
    text: 'Media, influence, performance, data and continuous optimization.',
  },
  {
    step: '04 / Convert',
    title: 'Technology',
    text: 'Websites, CRM, automation, AI and smoother customer journeys.',
  },
];

const expertises = [
  {
    number: '01',
    slug: 'strategie-digitale',
    image: 'expertise-story-branding.webp',
    label: 'Strategy',
    title: 'Digital Strategy',
    alt: 'Richmedia digital strategy to align brand positioning, audiences, channels and business goals',
    text: 'A clear roadmap to align positioning, audiences, channels and business goals.',
    tags: ['Segmentation', 'Targeting', 'Action plan', 'SMART goals'],
    outcome: 'Faster decisions',
    size: 'large',
  },
  {
    number: '02',
    slug: 'brand-content',
    image: 'expertise-story-social.webp',
    label: 'Creation',
    title: 'Brand content',
    alt: 'Richmedia social-first brand content for storytelling, video and useful content',
    text: 'Useful, memorable content adapted to every channel and audience.',
    tags: ['Storytelling', 'Photo & video', 'Social-first'],
    size: 'medium',
  },
  {
    number: '03',
    slug: 'web-si',
    image: 'expertise-story-tech.webp',
    label: 'Tech',
    title: 'Web & IS',
    alt: 'Richmedia web and information systems expertise for fast platforms, tracking and SEO',
    text: 'UX/UI, web platforms, tracking, SEO/GEO and connected systems.',
    tags: ['UX/UI', 'CMS', 'E-commerce'],
    size: 'small',
  },
  {
    number: '04',
    slug: 'achat-media',
    image: 'expertise-story-media.webp',
    label: 'Performance',
    title: 'Media Buying',
    alt: 'Richmedia media buying for data-led Google, Meta, TikTok and YouTube campaigns',
    text: 'Data-led media plans optimized in real time for business performance.',
    tags: ['Meta', 'TikTok', 'Google', 'YouTube'],
    size: 'medium',
  },
  {
    number: '05',
    slug: 'influence',
    image: 'expertise-card-influence-ai.webp',
    label: 'Influence',
    title: 'Influence',
    alt: 'Richmedia influencer marketing with creators, UGC and performance reporting',
    text: 'Creator selection, activation, negotiation and performance tracking.',
    tags: ['UGC', 'Creators', 'Reporting'],
    size: 'small',
  },
  {
    number: '06',
    slug: 'phygital',
    image: 'expertise-story-phygital.webp',
    label: 'Experience',
    title: 'Phygital',
    alt: 'Richmedia phygital activation connecting field, retail, mobile and data',
    text: 'Connecting field and digital through omnichannel, hybrid and measurable experiences.',
    tags: ['Activation', 'Retail', 'AR', 'Mobile apps'],
    outcome: 'Visible field impact',
    size: 'wide',
  },
  {
    number: '07',
    slug: 'evenementiel',
    image: 'hero-film-04.webp',
    label: 'Activation',
    title: 'Events',
    alt: 'Richmedia events expertise for production, logistics and live content',
    text: 'Concept, production, logistics and communication before, during and after the event.',
    tags: ['Production', 'Logistics', 'Live content'],
    size: 'stack',
  },
  {
    number: '08',
    slug: 'ia-automation',
    image: 'story-tech.webp',
    label: 'AI',
    title: 'AI & Automation',
    alt: 'Richmedia AI and automation for CRM, chatbots and lead scoring',
    text: 'Marketing automation, chatbots, social listening and predictive scoring.',
    tags: ['CRM', 'Chatbots', 'Lead scoring'],
    size: 'stack',
  },
];

const ops = [
  {
    label: 'Social',
    title: 'Social Media Management',
    text: 'Community management, moderation, editorial planning and engagement.',
  },
  {
    label: 'Design',
    title: 'Creative & Web Design',
    text: 'Visual identity, UI, key visuals, adaptations and graphic production.',
  },
  {
    label: 'Media',
    title: 'Media, Traffic & CRM',
    text: 'Acquisition, paid campaigns, tracking and optimization.',
  },
  {
    label: 'Dev',
    title: 'IS & Web Development',
    text: 'Websites, platforms, integrations and digital infrastructure.',
  },
  {
    label: 'Data',
    title: 'CRM & Lead Scoring',
    text: 'Automation, qualification, nurturing and conversion.',
  },
];
---
<BaseLayout
  title="Digital Marketing Expertise in Morocco | Richmedia"
  description={pageDescription}
  canonical={`${SITE.url}/en/expertises`}
  lang="en"
  schema={schema}
>
  <div class="expertise-page">
    <section class="expertise-hero" aria-labelledby="expertise-hero-title">
      <div class="expertise-hero-copy">
        <span class="section-kicker">Richmedia Expertise</span>
        <h1 id="expertise-hero-title">Build <span>growth.</span></h1>
        <p>
          From strategy to conversion, Richmedia connects creativity, media, technology and AI to turn
          attention into measurable business results.
        </p>
        <div class="expertise-actions">
          <a class="button button-primary" href="#expertise-catalog">
            Explore expertise
            <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/case-studies">Explore case studies</a>
        </div>
      </div>

      <div class="expertise-hero-board" aria-label="Richmedia expertise preview">
        <ParticleLogoSlide />
      </div>
    </section>

    <nav class="expertise-quick-nav" aria-label="Quick access to expertise">
      {expertises.map((item) => <a href={`#${item.slug}`}>{item.title}</a>)}
    </nav>

    <section class="expertise-journey" aria-label="Richmedia method">
      {journey.map((item) => (
        <article>
          <span>{item.step}</span>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="expertise-catalog" id="expertise-catalog" aria-labelledby="expertise-catalog-title">
      <div class="expertise-section-head">
        <h2 id="expertise-catalog-title">All our areas of expertise</h2>
      </div>

      <div class="expertise-grid">
        {expertises.map((item) => (
          <a
            href={['strategie-digitale', 'brand-content', 'web-si', 'achat-media', 'influence', 'phygital', 'evenementiel', 'ia-automation'].includes(item.slug) ? `/en/expertises/${item.slug}` : `/en/expertises#${item.slug}`}
            id={item.slug}
            class:list={['expertise-card', `expertise-card-${item.size}`]}
          >
            <img src={`${assetBase}/${item.image}`} alt={item.alt} loading="lazy" decoding="async" />
            <span class="card-number">{item.number}</span>
            <div class="expertise-card-copy">
              <span class="expertise-pill">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <div class="expertise-tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="expertise-ops" aria-labelledby="ops-title">
      <div class="expertise-ops-head">
        <h2 id="ops-title">Our teams in action</h2>
      </div>
      <div class="ops-grid">
        {ops.map((item) => (
          <article>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="expertise-closing" aria-labelledby="closing-title">
      <div>
        <h2 id="closing-title">No expertise works in isolation.</h2>
      </div>
      <a class="button button-primary" href="/en/contact">
        Talk to the team
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>

    <SeoSiloLinks
      title="Explore complementary growth levers"
      intro="Each expertise fits into a system: strategy, acquisition, SEO, content, CRM and industry-specific priorities."
      links={enSiloLinks.expertisesHub}
    />

    <section class="expertise-accreditations" aria-labelledby="expertise-accreditations-title">
      <div class="accreditation-copy">
        <span>Certifications</span>
        <h2 id="expertise-accreditations-title">Our accreditations</h2>
        <p>Recognized credentials for structuring, measuring and optimizing your performance.</p>
      </div>
      <div class="accreditation-grid" aria-label="Richmedia accreditations">
        {accreditationBadges.map((badge) => (
          <figure class="accreditation-card">
            <img src={`${assetBase}/${badge.image}`} alt={`${badge.name} ${badge.label}`} loading="lazy" decoding="async" />
            <figcaption>
              <strong>{badge.name}</strong>
              <span>{badge.label}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .expertise-page {
    --container: min(100% - 3rem, 1320px);
    --purple: #7c3cff;
    --purple-2: #a36bff;
    --line: rgba(255, 255, 255, 0.14);
    --muted: rgba(255, 255, 255, 0.68);
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 7%, rgba(124, 60, 255, 0.25), transparent 24rem),
      radial-gradient(circle at 88% 42%, rgba(124, 60, 255, 0.14), transparent 23rem),
      linear-gradient(180deg, #050508 0%, #030407 46%, #050507 100%);
    color: #fff;
  }

  .expertise-page::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.016) 1px, transparent 1px);
    background-size: 56px 56px;
    content: "";
    opacity: 0.42;
    pointer-events: none;
  }

  .expertise-hero,
  .expertise-journey,
  .expertise-catalog,
  .expertise-ops,
  .expertise-closing,
  .expertise-accreditations {
    position: relative;
    z-index: 1;
    width: var(--container);
    margin-inline: auto;
  }

  .expertise-hero {
    display: grid;
    grid-template-columns: minmax(430px, 0.88fr) minmax(520px, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    min-height: 610px;
    padding: 7rem 0 2.4rem;
  }

  .expertise-hero-copy,
  .expertise-hero-board {
    min-width: 0;
    max-width: 100%;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.75rem;
    color: var(--purple-2);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.4rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .expertise-hero h1 {
    max-width: 670px;
    margin: 0;
    --h1-size: clamp(2.7rem, 3.2vw, 3.125rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .expertise-hero h1 span {
    color: var(--purple);
  }

  .expertise-hero-copy p {
    max-width: 620px;
    margin: 1.55rem 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    overflow-wrap: break-word;
  }

  .expertise-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.15rem;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0 1.35rem;
    font-weight: 700;
    text-decoration: none;
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
  }

  .expertise-hero-board {
    position: relative;
    min-height: 455px;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(circle at 52% 48%, rgba(124, 60, 255, 0.18), transparent 34%),
      #000;
    box-shadow: none;
  }

  .expertise-hero-board :global(.particle-logo-slide) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }

  .expertise-hero-board::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at 58% 47%, transparent 0%, rgba(124,60,255,0.04) 34%, rgba(0,0,0,0.72) 100%),
      linear-gradient(90deg, rgba(0,0,0,0.66) 0%, rgba(0,0,0,0.1) 44%, rgba(0,0,0,0.46) 100%),
      linear-gradient(0deg, rgba(0,0,0,0.58), transparent 52%);
    content: "";
    pointer-events: none;
  }

  .hero-metrics {
    position: absolute;
    z-index: 2;
    top: 1.35rem;
    right: 1.35rem;
    display: grid;
    gap: 0.72rem;
    width: 210px;
  }

  .hero-metrics span {
    display: block;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(18px);
  }

  .hero-metrics strong {
    display: block;
    color: #fff;
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1;
  }

  .hero-metrics small {
    display: block;
    margin-top: 0.35rem;
    color: rgba(255,255,255,0.68);
    font-size: 1.0625rem;
    line-height: 1.25;
  }

  .board-caption {
    position: absolute;
    z-index: 2;
    right: 2rem;
    bottom: 2rem;
    left: 2rem;
    max-width: 420px;
  }

  .board-caption strong {
    display: block;
    color: #fff;
    font-size: clamp(1.0625rem, 1.55vw, 1.35rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .board-caption p {
    max-width: 390px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.72);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .expertise-journey {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 8px;
    background: rgba(255,255,255,0.13);
  }

  .expertise-journey article {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 150px;
    padding: 1.55rem;
    background: rgba(5,5,8,0.88);
    transition:
      transform 260ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
  }

  .expertise-journey article + article {
    border-left: 1px solid rgba(255,255,255,0.13);
  }

  .expertise-journey article::before {
    position: absolute;
    inset: -35% -22%;
    z-index: -1;
    background:
      radial-gradient(circle at 18% 20%, rgba(124, 60, 255, 0.34), transparent 28%),
      linear-gradient(115deg, transparent 0 38%, rgba(255, 255, 255, 0.16) 48%, transparent 60% 100%);
    content: "";
    opacity: 0;
    transform: translateX(-30%) rotate(8deg);
    transition: opacity 260ms ease, transform 520ms ease;
  }

  .expertise-journey article::after {
    position: absolute;
    right: 1.55rem;
    bottom: 1.25rem;
    left: 1.55rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--purple-2), rgba(124, 60, 255, 0));
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 220ms ease, transform 320ms ease;
  }

  .expertise-journey article:hover {
    z-index: 2;
    background: rgba(11, 9, 18, 0.96);
    box-shadow: inset 0 0 0 1px rgba(169, 119, 255, 0.36), 0 1.4rem 3rem rgba(0, 0, 0, 0.34);
    transform: translateY(-8px) scale(1.015);
  }

  .expertise-journey article:hover::before {
    opacity: 1;
    transform: translateX(18%) rotate(8deg);
  }

  .expertise-journey article:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .expertise-journey span {
    position: relative;
    display: inline-block;
    color: var(--purple-2);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    transition: color 220ms ease, transform 220ms ease;
  }

  .expertise-journey h2 {
    margin: 1rem 0 0;
    color: #fff;
    --h2-size: 1.35rem;
    font-size: var(--h2-size);
    font-weight: 700;
    line-height: 1.1;
    transition: transform 220ms ease, text-shadow 220ms ease;
  }

  .expertise-journey p {
    max-width: 260px;
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.46;
    transition: color 220ms ease, transform 220ms ease;
  }

  .expertise-journey article:hover span {
    color: #c6a2ff;
    transform: translateY(-3px);
  }

  .expertise-journey article:hover h2 {
    text-shadow: 0 0 1.3rem rgba(124, 60, 255, 0.42);
    transform: translateX(4px);
  }

  .expertise-journey article:hover p {
    color: rgba(255, 255, 255, 0.78);
    transform: translateX(4px);
  }

  .expertise-catalog {
    margin-top: clamp(2.4rem, 4vw, 3.4rem);
    scroll-margin-top: 6rem;
  }

  .expertise-card {
    scroll-margin-top: 6rem;
  }

  .expertise-quick-nav {
    display: none;
  }

  .expertise-section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .expertise-section-head h2 {
    margin: 0;
    color: #fff;
    --h2-size: clamp(2rem, 3vw, 3.05rem);
    font-size: var(--h2-size);
    font-weight: 800;
    line-height: 1;
  }

  .expertise-section-head p {
    max-width: 460px;
    margin: 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .expertise-card {
    position: relative;
    display: block;
    min-height: clamp(220px, 18vw, 265px);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 8px;
    background: #09090d;
    color: inherit;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
    isolation: isolate;
    text-decoration: none;
  }

  .expertise-card-large {
    grid-column: auto;
    grid-row: auto;
  }

  .expertise-card-medium {
    grid-column: auto;
    grid-row: auto;
  }

  .expertise-card-small {
    grid-column: auto;
    grid-row: auto;
  }

  .expertise-card-wide {
    grid-column: auto;
    grid-row: auto;
  }

  .expertise-card-stack {
    grid-column: auto;
    grid-row: auto;
  }

  .expertise-card img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.001);
    transition: transform 700ms ease, filter 700ms ease;
  }

  .expertise-card::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.26) 38%, rgba(0,0,0,0.9) 100%),
      linear-gradient(90deg, rgba(0,0,0,0.55), rgba(0,0,0,0.04) 48%, rgba(0,0,0,0.35));
    content: "";
  }

  .expertise-card:hover img {
    filter: saturate(1.08) contrast(1.04);
    transform: scale(1.045);
  }

  .card-number {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    right: 0.9rem;
    color: rgba(255,255,255,0.28);
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
  }

  .expertise-card-copy {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    left: 0.9rem;
    z-index: 3;
  }

  .expertise-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.05rem;
    border-radius: 6px;
    padding: 0 0.38rem;
    background: var(--purple);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .expertise-card h3 {
    max-width: 92%;
    margin: 0.55rem 0 0;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.12;
  }

  .expertise-card-large h3 {
