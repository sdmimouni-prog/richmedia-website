---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { breadcrumbs } from '../../../lib/schema';
import { SITE } from '../../../consts';

const assetBase = '/assets/richmedia-home';
const pageDescription =
  'Explore Richmedia expertise: digital strategy, brand content, web platforms, media buying, influence, phygital activations, events, AI and automation for measurable growth.';

const accreditationBadges = [
  { image: 'logos/accreditations-svg/google-ads.svg', name: 'Google Ads', label: 'Certified' },
  { image: 'logos/accreditations-svg/google-analytics.svg', name: 'Google Analytics', label: 'Certified' },
  { image: 'logos/accreditations-svg/hubspot.svg', name: 'HubSpot', label: 'Certified' },
  { image: 'logos/accreditations-svg/iab-rich-media.svg', name: 'IAB Rich Media', label: 'Certified' },
  { image: 'logos/accreditations-svg/meta-blueprint.svg', name: 'Meta Blueprint', label: 'Certified' },
  { image: 'logos/accreditations-svg/semrush.svg', name: 'Semrush', label: 'Certified' },
];

const schema = [breadcrumbs([
  { name: 'Home', url: `${SITE.url}/en` },
  { name: 'Expertise', url: `${SITE.url}/en/expertises` },
])];

const journey = [
  {
    step: '01 / Clarify',
    title: 'Strategy',
    text: 'Positioning, segmentation, goals and a concrete action plan.',
  },
  {
    step: '02 / Create',
    title: 'Creation',
    text: 'Storytelling, social-first content, design, photography, video and experiences.',
  },
  {
    step: '03 / Amplify',
    title: 'Amplification',
    text: 'Media, influence, performance, data and continuous optimization.',
  },
  {
    step: '04 / Convert',
    title: 'Technology',
    text: 'Websites, CRM, automation, AI and smoother customer journeys.',
  },
];

const expertises = [
  {
    number: '01',
    slug: 'strategie-digitale',
    image: 'expertise-story-branding.webp',
    label: 'Strategy',
    title: 'Digital Strategy',
    text: 'A clear roadmap to align positioning, audiences, channels and business goals.',
    tags: ['Segmentation', 'Targeting', 'Action plan', 'SMART goals'],
    outcome: 'Faster decisions',
    size: 'large',
  },
  {
    number: '02',
    slug: 'brand-content',
    image: 'expertise-story-social.webp',
    label: 'Creation',
    title: 'Brand content',
    text: 'Useful, memorable content adapted to every channel and audience.',
    tags: ['Storytelling', 'Photo & video', 'Social-first'],
    size: 'medium',
  },
  {
    number: '03',
    slug: 'web-si',
    image: 'expertise-story-tech.webp',
    label: 'Tech',
    title: 'Web & IS',
    text: 'UX/UI, web platforms, tracking, SEO/GEO and connected systems.',
    tags: ['UX/UI', 'CMS', 'E-commerce'],
    size: 'small',
  },
  {
    number: '04',
    slug: 'achat-media',
    image: 'expertise-story-media.webp',
    label: 'Performance',
    title: 'Media Buying',
    text: 'Data-led media plans optimized in real time for business performance.',
    tags: ['Meta', 'TikTok', 'Google', 'YouTube'],
    size: 'medium',
  },
  {
    number: '05',
    slug: 'influence',
    image: 'case-influence.webp',
    label: 'Influence',
    title: 'Influence',
    text: 'Creator selection, activation, negotiation and performance tracking.',
    tags: ['UGC', 'Creators', 'Reporting'],
    size: 'small',
  },
  {
    number: '06',
    slug: 'phygital',
    image: 'expertise-story-phygital.webp',
    label: 'Experience',
    title: 'Phygital',
    text: 'Connecting field and digital through omnichannel, hybrid and measurable experiences.',
    tags: ['Activation', 'Retail', 'AR', 'Mobile apps'],
    outcome: 'Visible field impact',
    size: 'wide',
  },
  {
    number: '07',
    slug: 'evenementiel',
    image: 'hero-film-04.webp',
    label: 'Activation',
    title: 'Events',
    text: 'Concept, production, logistics and communication before, during and after the event.',
    tags: ['Production', 'Logistics', 'Live content'],
    size: 'stack',
  },
  {
    number: '08',
    slug: 'ia-automation',
    image: 'story-tech.webp',
    label: 'AI',
    title: 'AI & Automation',
    text: 'Marketing automation, chatbots, social listening and predictive scoring.',
    tags: ['CRM', 'Chatbots', 'Lead scoring'],
    size: 'stack',
  },
];

const ops = [
  {
    label: 'Social',
    title: 'Social Media Management',
    text: 'Community management, moderation, editorial planning and engagement.',
  },
  {
    label: 'Design',
    title: 'Creative & Web Design',
    text: 'Visual identity, UI, key visuals, adaptations and graphic production.',
  },
  {
    label: 'Media',
    title: 'Media, Traffic & CRM',
    text: 'Acquisition, paid campaigns, tracking and optimization.',
  },
  {
    label: 'Dev',
    title: 'IS & Web Development',
    text: 'Websites, platforms, integrations and digital infrastructure.',
  },
  {
    label: 'Data',
    title: 'CRM & Lead Scoring',
    text: 'Automation, qualification, nurturing and conversion.',
  },
];
---
<BaseLayout
  title="Richmedia Expertise — Strategy, content, media, AI and growth"
  description={pageDescription}
  canonical={`${SITE.url}/en/expertises`}
  lang="en"
  schema={schema}
>
  <div class="expertise-page">
    <section class="expertise-hero" aria-labelledby="expertise-hero-title">
      <div class="expertise-hero-copy">
        <span class="section-kicker">Richmedia Expertise</span>
        <h1 id="expertise-hero-title">Build <span>growth.</span></h1>
        <p>
          From strategy to conversion, Richmedia connects creativity, media, technology and AI to turn
          attention into measurable business results.
        </p>
        <div class="expertise-actions">
          <a class="button button-primary" href="/en/contact">
            Discuss your growth plan
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/case-studies">Explore case studies</a>
        </div>
      </div>

      <div class="expertise-hero-board" aria-label="Richmedia expertise preview">
        <canvas class="particle-slider" data-particle-slider aria-hidden="true"></canvas>
      </div>
    </section>

    <section class="expertise-journey" aria-label="Richmedia method">
      {journey.map((item) => (
        <article>
          <span>{item.step}</span>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </section>

    <section class="expertise-catalog" aria-labelledby="expertise-catalog-title">
      <div class="expertise-section-head">
        <h2 id="expertise-catalog-title">All our areas of expertise</h2>
      </div>

      <div class="expertise-grid">
        {expertises.map((item) => (
          <a
            href={['strategie-digitale', 'brand-content', 'web-si', 'achat-media', 'influence', 'phygital', 'evenementiel', 'ia-automation'].includes(item.slug) ? `/en/expertises/${item.slug}` : `/en/expertises#${item.slug}`}
            id={item.slug}
            class:list={['expertise-card', `expertise-card-${item.size}`]}
          >
            <img src={`${assetBase}/${item.image}`} alt="" loading="lazy" decoding="async" />
            <span class="card-number">{item.number}</span>
            <div class="expertise-card-copy">
              <span class="expertise-pill">{item.label}</span>
              <h3>{item.title}</h3>
              <div class="expertise-tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="expertise-ops" aria-labelledby="ops-title">
      <div class="expertise-ops-head">
        <h2 id="ops-title">Our teams in action</h2>
      </div>
      <div class="ops-grid">
        {ops.map((item) => (
          <article>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="expertise-closing" aria-labelledby="closing-title">
      <div>
        <h2 id="closing-title">No expertise works in isolation.</h2>
      </div>
      <a class="button button-primary" href="/en/contact">
        Talk to the team
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>

    <section class="expertise-accreditations" aria-labelledby="expertise-accreditations-title">
      <div class="accreditation-copy">
        <span>Certifications</span>
        <h2 id="expertise-accreditations-title">Our accreditations</h2>
        <p>Recognized credentials for structuring, measuring and optimizing your performance.</p>
      </div>
      <div class="accreditation-grid" aria-label="Richmedia accreditations">
        {accreditationBadges.map((badge) => (
          <figure class="accreditation-card">
            <img src={`${assetBase}/${badge.image}`} alt={`${badge.name} ${badge.label}`} loading="lazy" decoding="async" />
            <figcaption>
              <strong>{badge.name}</strong>
              <span>{badge.label}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  type Particle = {
    u: number;
    band: number;
    lane: number;
    drift: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    alpha: number;
  };

  type Point = {
    x: number;
    y: number;
  };

  const initParticleSliders = () => {
    const canvases = document.querySelectorAll('[data-particle-slider]');

    canvases.forEach((canvas) => {
      if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.particleReady === 'true') return;
      canvas.dataset.particleReady = 'true';

      const context = canvas.getContext('2d', { alpha: false });
      if (!context) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pointer = { x: 0.5, y: 0.5, active: false };
      const tau = Math.PI * 2;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let particles: Particle[] = [];
      let animationFrame = 0;
      let renderUntil = 0;

      const random = (seed: number) => {
        const value = Math.sin(seed * 12.9898) * 43758.5453;
        return value - Math.floor(value);
      };

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        width = Math.max(1, Math.floor(rect.width));
        height = Math.max(1, Math.floor(rect.height));
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        context.setTransform(dpr, 0, 0, dpr, 0, 0);

        const density = width < 720 ? 54 : 38;
        const count = Math.floor(Math.min(12500, Math.max(5200, (width * height) / density)));
        const startTime = performance.now();
        particles = Array.from({ length: count }, (_, index) => {
          const particle = {
            u: random(index + 1),
            band: Math.sign(random(index + 19) - 0.5) * Math.pow(random(index + 23), 0.55),
            lane: random(index + 31),
            drift: random(index + 37),
            x: 0,
            y: 0,
            vx: 0,
            vy: 0,
            size: 0.85 + random(index + 59) * 1.55,
            alpha: 0.62 + random(index + 83) * 0.38,
          };
          const origin = particleShapePoint(particle, startTime, 0);
          particle.x = origin.x;
          particle.y = origin.y;
          return particle;
        });
      };

      const ease = (value: number) => value * value * (3 - 2 * value);

      const lerp = (from: number, to: number, amount: number) => from + (to - from) * amount;

      const particleShapePoint = (particle: Particle, _time: number, pose: number): Point => {
        const posePhase = pose * 0.72;
        const flow = (particle.u + pose * 0.042) % 1;
        const ribbon = particle.band;
        const wobble = Math.sin(particle.drift * tau + posePhase) * 0.035;
        const breathing = Math.sin(posePhase) * 0.035;

        let x = 0.5;
        let y = 0.5;

        if (particle.lane < 0.12) {
          const t = ease((flow + pose * 0.08) % 1);
          const side = particle.lane < 0.06 ? -1 : 1;
          x = 0.47 + side * 0.045 + ribbon * 0.045 + Math.sin(t * Math.PI + posePhase) * 0.035;
          y = 0.2 + t * 0.56 + Math.sin(t * tau + posePhase) * 0.035;
        } else if (flow < 0.52) {
          const t = flow / 0.52;
          const theta = lerp(-2.2, 1.1, t) + breathing;
          const thickness = 0.09 + Math.sin(t * Math.PI) * 0.08;
          const radiusX = 0.2 + ribbon * thickness;
          const radiusY = 0.28 + ribbon * thickness * 1.05;
          x = 0.51 + Math.cos(theta) * radiusX + Math.sin(theta * 2.1 + posePhase) * 0.035;
          y = 0.36 + Math.sin(theta) * radiusY + wobble;
        } else {
          const t = (flow - 0.52) / 0.48;
          const theta = lerp(-1.0, 1.78, t) - breathing;
          const taper = 1 - Math.max(0, t - 0.78) * 2.8;
          const thickness = (0.105 + Math.sin(t * Math.PI) * 0.095) * Math.max(0.45, taper);
          const radiusX = 0.27 + ribbon * thickness;
          const radiusY = 0.31 + ribbon * thickness;
          x = 0.58 + Math.cos(theta) * radiusX + Math.sin(theta * 1.45 + posePhase) * 0.038;
          y = 0.63 + Math.sin(theta) * radiusY + Math.cos(theta * 1.2 + posePhase) * 0.03;
        }

        const tilt = Math.sin(posePhase) * 0.045;
        const centeredX = x - 0.52;
        const centeredY = y - 0.52;

        return {
          x: (0.54 + centeredX * (1.02 + breathing) - centeredY * tilt) * width,
          y: (0.52 + centeredY * (1.02 - breathing * 0.65) + centeredX * tilt) * height,
        };
      };

      const draw = (time = 0) => {
        animationFrame = 0;
        context.fillStyle = '#000';
        context.fillRect(0, 0, width, height);

        const glow = context.createRadialGradient(width * 0.55, height * 0.48, 0, width * 0.55, height * 0.48, width * 0.62);
        glow.addColorStop(0, 'rgba(124, 60, 255, 0.24)');
        glow.addColorStop(0.48, 'rgba(163, 107, 255, 0.08)');
        glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
        context.fillStyle = glow;
        context.fillRect(0, 0, width, height);

        const now = performance.now();
        const recentMotion = pointer.active && now < renderUntil;
        const slideProgress = pointer.active ? Math.min(2.999, Math.max(0, pointer.x * 3)) : 0;
        const pose = Math.floor(slideProgress);
        const nextPose = (pose + 1) % 3;
        const easedMorph = ease(slideProgress - pose);
        const pointerX = pointer.x * width;
        const pointerY = pointer.y * height;
        const ambientMotion = recentMotion ? 1 : 0;

        for (let index = 0; index < particles.length; index += 1) {
          const particle = particles[index];
          const a = particleShapePoint(particle, time, pose);
          const b = particleShapePoint(particle, time, nextPose);
          const targetX = a.x + (b.x - a.x) * easedMorph;
          const targetY = a.y + (b.y - a.y) * easedMorph;

          particle.vx = (particle.vx + (targetX - particle.x) * 0.045) * 0.72;
          particle.vy = (particle.vy + (targetY - particle.y) * 0.045) * 0.72;
          particle.x += particle.vx + Math.sin(time * 0.0011 + particle.drift * 9) * 0.12 * ambientMotion;
          particle.y += particle.vy + Math.cos(time * 0.001 + particle.drift * 7) * 0.1 * ambientMotion;

          if (pointer.active) {
            const dx = particle.x - pointerX;
            const dy = particle.y - pointerY;
            const distance = Math.max(1, Math.hypot(dx, dy));
            if (distance < 155) {
              const force = (1 - distance / 155) * 1.8;
              particle.vx += (dx / distance) * force + (-dy / distance) * force * 0.36;
              particle.vy += (dy / distance) * force + (dx / distance) * force * 0.36;
            }
          }

          const flicker = recentMotion ? 0.78 + Math.sin(time * 0.002 + particle.drift * 14) * 0.22 : 1;
          const shade = 132 + Math.floor(particle.drift * 62);
          context.fillStyle = `rgba(${shade}, ${78 + Math.floor(particle.drift * 46)}, 255, ${particle.alpha * flicker})`;
          context.fillRect(particle.x, particle.y, particle.size, particle.size);
        }

        if (!reduceMotion && performance.now() < renderUntil) {
          animationFrame = window.requestAnimationFrame(draw);
        }
      };

      const requestDraw = () => {
        if (!reduceMotion && !animationFrame) {
          animationFrame = window.requestAnimationFrame(draw);
        }
      };

      canvas.addEventListener('pointermove', (event) => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = (event.clientX - rect.left) / rect.width;
        pointer.y = (event.clientY - rect.top) / rect.height;
        pointer.active = true;
        renderUntil = performance.now() + 700;
        requestDraw();
      });

      canvas.addEventListener('pointerleave', () => {
        pointer.active = false;
        renderUntil = performance.now() + 900;
        requestDraw();
      });

      const resizeObserver = new ResizeObserver(() => {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        resize();
        draw(performance.now());
      });

      resizeObserver.observe(canvas);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParticleSliders, { once: true });
  } else {
    initParticleSliders();
  }
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .expertise-page {
    --container: min(100% - 3rem, 1320px);
    --purple: #7c3cff;
    --purple-2: #a36bff;
    --line: rgba(255, 255, 255, 0.14);
    --muted: rgba(255, 255, 255, 0.68);
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 7%, rgba(124, 60, 255, 0.25), transparent 24rem),
      radial-gradient(circle at 88% 42%, rgba(124, 60, 255, 0.14), transparent 23rem),
      linear-gradient(180deg, #050508 0%, #030407 46%, #050507 100%);
    color: #fff;
  }

  .expertise-page::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.016) 1px, transparent 1px);
    background-size: 56px 56px;
    content: "";
    opacity: 0.42;
    pointer-events: none;
  }

  .expertise-hero,
  .expertise-journey,
  .expertise-catalog,
  .expertise-ops,
  .expertise-closing,
  .expertise-accreditations {
    position: relative;
    z-index: 1;
    width: var(--container);
    margin-inline: auto;
  }

  .expertise-hero {
    display: grid;
    grid-template-columns: minmax(430px, 0.88fr) minmax(520px, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    min-height: 610px;
    padding: 7rem 0 2.4rem;
  }

  .expertise-hero-copy,
  .expertise-hero-board {
    min-width: 0;
    max-width: 100%;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.75rem;
    color: var(--purple-2);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.4rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .expertise-hero h1 {
    max-width: 670px;
    margin: 0;
    --h1-size: clamp(2.7rem, 3.2vw, 3.125rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .expertise-hero h1 span {
    color: var(--purple);
  }

  .expertise-hero-copy p {
    max-width: 620px;
    margin: 1.55rem 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    overflow-wrap: break-word;
  }

  .expertise-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.15rem;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0 1.35rem;
    font-weight: 700;
    text-decoration: none;
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
  }

  .expertise-hero-board {
    position: relative;
    min-height: 455px;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(circle at 52% 48%, rgba(124, 60, 255, 0.18), transparent 34%),
      #000;
    box-shadow: none;
  }

  .particle-slider {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
    background: #000;
  }

  .expertise-hero-board::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at 58% 47%, transparent 0%, rgba(124,60,255,0.04) 34%, rgba(0,0,0,0.72) 100%),
      linear-gradient(90deg, rgba(0,0,0,0.66) 0%, rgba(0,0,0,0.1) 44%, rgba(0,0,0,0.46) 100%),
      linear-gradient(0deg, rgba(0,0,0,0.58), transparent 52%);
    content: "";
    pointer-events: none;
  }

  .hero-metrics {
    position: absolute;
    z-index: 2;
    top: 1.35rem;
    right: 1.35rem;
    display: grid;
    gap: 0.72rem;
    width: 210px;
  }

  .hero-metrics span {
    display: block;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(18px);
  }

  .hero-metrics strong {
    display: block;
    color: #fff;
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1;
  }

  .hero-metrics small {
    display: block;
    margin-top: 0.35rem;
    color: rgba(255,255,255,0.68);
    font-size: 0.75rem;
    line-height: 1.25;
  }

  .board-caption {
    position: absolute;
    z-index: 2;
    right: 2rem;
    bottom: 2rem;
    left: 2rem;
    max-width: 420px;
  }

  .board-caption strong {
    display: block;
    color: #fff;
    font-size: clamp(1.05rem, 1.55vw, 1.35rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .board-caption p {
    max-width: 390px;
    margin: 1rem 0 0;
    color: rgba(255,255,255,0.72);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .expertise-journey {
    display: grid;
