---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../../../lib/schema';

const assetBase = '/assets/richmedia-ia-automation';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/en/expertises/ia-automation`;

const seoTitle = 'AI & Automation agency in Casablanca - CRM, WhatsApp and AI agents | Richmedia';
const seoDescription =
  'Richmedia designs AI and automation systems in Morocco: CRM, WhatsApp Business, AI agents, lead scoring, automated workflows, reporting and human safeguards.';

const automationTools = [
  { name: 'Zapier', logo: 'zapier.svg', note: 'Workflows & connectors' },
  { name: 'Zoho', logo: 'zoho.svg', note: 'CRM & social ops' },
  { name: 'Google Tag Manager', logo: 'google-tag-manager.svg', note: 'Events & tracking' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Journeys & conversions' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'Dashboards ROI' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'UX & sessions' },
  { name: 'JavaScript', logo: 'javascript.svg', note: 'Scripts & integrations' },
  { name: 'Meta', logo: 'meta.svg', note: 'Social & messaging' },
];

const proofCards = [
  {
    metric: 'CRM',
    title: 'Clean data before automation',
    text: 'We structure sources, properties, statuses, scoring, lifecycle stages and qualification rules to avoid unusable workflows.',
  },
  {
    metric: 'WhatsApp',
    title: 'Respond, qualify and follow up faster',
    text: 'WhatsApp becomes a conversion channel: assisted replies, qualification, appointment booking, human handoff and measurable follow-ups.',
  },
  {
    metric: 'AI Agents',
    title: 'Useful, framed and supervised agents',
    text: 'We design AI agents connected to your data, rules, tools and human approvals so they can execute real operational tasks.',
  },
  {
    metric: 'ROI',
    title: 'Automate what truly improves business',
    text: 'Every scenario is tied to a KPI: response time, lead quality, conversion rate, cost per opportunity and attributable revenue.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    label: 'Agentic AI',
    title: 'Agents move from prototype to business workflows',
    text: 'In 2026, AI agents are no longer just assistants: they plan, use tools, follow rules and execute multi-step tasks.',
  },
  {
    label: 'CRM context',
    title: 'Context becomes more important than the prompt',
    text: 'Performance comes from accessible data: CRM, history, catalogs, FAQs, consent, tickets, sales status and an up-to-date knowledge base.',
  },
  {
    label: 'WhatsApp first',
    title: 'Messaging becomes an automated sales channel',
    text: 'Questions, recommendations, appointment booking, qualification and human handoff are moving to WhatsApp, Messenger and mobile conversations.',
  },
  {
    label: 'Human-in-loop',
    title: 'Safeguards make the difference in production',
    text: 'A reliable agent needs permissions, thresholds, logs, escalation rules and human approval for sensitive decisions.',
  },
  {
    label: 'Growth engine',
    title: 'Marketing becomes continuous orchestration',
    text: 'Insights, creation, personalization, conversational commerce and optimization connect inside a system that learns every week.',
  },
  {
    label: 'SEO / GEO',
    title: 'AI answers need structured content',
    text: 'Pages, FAQs, schema, sources, proof and readable content help Google and generative engines understand and cite your offer.',
  },
];

const useCases = [
  {
    image: 'crm-automation.webp',
    type: 'CRM & lead scoring',
    title: 'Qualify leads without losing the sales signal',
    text: "Centralized forms, statuses, scoring, segmentation, sales alerts and follow-ups based on the prospect's actual intent.",
    formats: ['CRM', 'Lead scoring', 'Sales alerts'],
  },
  {
    image: 'whatsapp-agent.webp',
    type: 'WhatsApp agent',
    title: 'Reply 24/7 with a clear human handoff',
    text: 'Conversational agent, qualification, FAQ, catalog, appointments, follow-up messages and transfer rules for your teams.',
    formats: ['WhatsApp', 'Handoff', 'Appointments'],
  },
  {
    image: 'agent-workflows.webp',
    type: 'Automated journeys',
    title: 'Connect acquisition, CRM, service and reporting',
    text: 'One click becomes a conversation, a CRM record, a sales action, a follow-up and a metric in your dashboard.',
    formats: ['Workflows', 'Reporting', 'Ops'],
  },
];

const services = [
  {
    kicker: 'Architecture',
    title: 'CRM, data and automatable journey audit',
    text: 'Mapping of sources, forms, inboxes, CRM, statuses, messages, manual tasks, risks and automation opportunities.',
    items: ['CRM', 'Data', 'Journeys', 'Risks'],
  },
  {
    kicker: 'Messaging',
    title: 'WhatsApp Business, qualification and assisted support',
    text: 'Scripts, knowledge base, conversation scenarios, human handoff, tags, consent, follow-ups and conversational reporting.',
    items: ['WhatsApp', 'FAQ', 'Handoff', 'Opt-in'],
  },
  {
    kicker: 'Agents',
    title: 'AI agents connected to your business tools',
    text: 'Agents for qualification, support, research, summaries, reporting, sales follow-up, ticket creation and brief preparation.',
    items: ['AI agents', 'Knowledge base', 'Actions', 'Logs'],
  },
  {
    kicker: 'Management',
    title: 'Dashboards, safeguards and continuous improvement',
    text: 'Measurement of replies, delays, errors, conversions, escalations, costs, lead quality and optimization recommendations.',
    items: ['Looker', 'KPI', 'QA', 'ROI'],
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Diagnosis',
    text: 'CRM, WhatsApp, forms, scripts, request volumes, data quality, team maturity and friction points.',
  },
  {
    step: '02',
    title: 'Design',
    text: 'Target journey, business rules, messages, knowledge base, agent permissions, human handoff and KPIs.',
  },
  {
    step: '03',
    title: 'Build',
    text: 'Connectors, automations, dashboards, system prompts, WhatsApp scenarios, triggers and tracking.',
  },
  {
    step: '04',
    title: 'Test',
    text: 'Test sets, edge cases, answer quality, security, consent, escalations and team validation.',
  },
  {
    step: '05',
    title: 'Scale',
    text: 'Progressive rollout, training, monitoring, weekly optimization and extension to new journeys.',
  },
];

const deliverables = [
  'Audit CRM & automation',
  'Customer journey mapping',
  'Data architecture & statuses',
  'WhatsApp Business scenarios',
  'AI agent knowledge base',
  'System prompts & safeguards',
  'Qualification workflows',
  'Lead scoring & sales alerts',
  'Human handoff plan',
  'Tracking events & conversions',
  'Dashboard automation ROI',
  'Management documentation',
];

const sources = [
  {
    title: 'Gartner — enterprise AI agents 2026',
    text: 'Gartner expects strong integration of task-specific AI agents into enterprise applications by the end of 2026.',
    href: 'https://www.gartner.com/en/newsroom/press-releases/2025-08-26-gartner-predicts-40-percent-of-enterprise-apps-will-feature-task-specific-ai-agents-by-2026-up-from-less-than-5-percent-in-2025',
  },
  {
    title: 'McKinsey — State of AI',
    text: 'AI usage is expanding, but value depends on moving from pilots to truly redesigned and scaled workflows.',
    href: 'https://www.mckinsey.com/capabilities/quantumblack/our-insights/the-state-of-ai',
  },
  {
    title: 'McKinsey — marketing AI 2026',
    text: 'The future of marketing connects insights, creation, personalization, agentic commerce and orchestration inside a continuous growth engine.',
    href: 'https://www.mckinsey.com/capabilities/growth-marketing-and-sales/our-insights/from-campaigns-to-continuous-growth-ai-capabilities-shaping-marketing',
  },
  {
    title: 'Meta — Business Agent WhatsApp',
    text: 'Meta presents WhatsApp Business agents for replies, recommendations, lead qualification, selling and handoff to humans.',
    href: 'https://whatsappbusiness.com/blog/introducing-meta-business-agent-ai/',
  },
  {
    title: 'OpenAI — agentic workflows',
    text: 'Agents can reason, act, connect to company tools and follow team rules with the right approvals.',
    href: 'https://openai.com/solutions/use-case/agents/',
  },
  {
    title: 'Salesforce — AI agents 2026',
    text: '2026 trends emphasize context engineering, deterministic safeguards, headless CRM and production reliability.',
    href: 'https://www.salesforce.com/blog/ai-agent-trends-2026/',
  },
];

const faq = [
  {
    question: 'What is an AI & automation agency?',
    answer:
      'An AI & automation agency designs systems that connect CRM, WhatsApp, AI agents, workflows, tracking and dashboards to automate repetitive tasks while keeping human safeguards.',
  },
  {
    question: 'Which processes can Richmedia automate?',
    answer:
      'We automate lead qualification, WhatsApp replies, follow-ups, scoring, ticket creation, sales alerts, summaries, reporting and selected nurturing journeys.',
  },
  {
    question: 'Can an AI agent replace a sales team?',
    answer:
      'No. A well-designed AI agent assists the team: it handles repetitive requests, collects context, qualifies and prepares actions. Sensitive decisions and important opportunities remain human-supervised.',
  },
  {
    question: 'How do you prevent AI agent errors?',
    answer:
      'We implement a knowledge base, permissions, system prompts, deterministic rules, logs, tests, escalation thresholds, human approval and continuous monitoring.',
  },
  {
    question: 'Why optimize an AI & automation page for SEO/GEO?',
    answer:
      'Because search engines and generative engines favor clear, structured, sourced and useful pages. FAQs, JSON-LD schema, sources and use cases make the offer easier to understand and cite.',
  },
];

const schema = [
  serviceSchema({
    name: 'AI & Automation',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Expertise', url: `${SITE.url}/en/expertises` },
    { name: 'AI & Automation', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: 'AI' },
  { href: '#trends', label: 'Trends', value: '2026' },
  { href: '#usecases', label: 'Use', value: 'CRM' },
  { href: '#automation-cta', label: 'Project', value: 'Brief' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/ia-automation-hero.webp`}
  lang="en"
  schema={schema}
>
  <div class="automation-page">
    <section class="automation-hero" aria-labelledby="automation-title">
      <div class="hero-copy">
        <span class="eyebrow">Richmedia Expertise</span>
        <h1 id="automation-title">AI & automation to convert faster.</h1>
        <p class="hero-lead">
          Richmedia connects CRM, WhatsApp, AI agents, workflows and reporting to turn requests, leads and
          conversations into automated, measurable and supervised journeys.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/en/contact">
            Automate your journeys
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/case-studies">
            View case studies
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual automation-hover-lab" aria-label="Richmedia AI and automation system">
        <img src={`${assetBase}/ia-automation-hero.webp`} alt="Marketing team managing an automated CRM, WhatsApp and AI agent system" />
        <div class="signal-card signal-card-top">
          <span>CRM</span>
          <strong>Clean data</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>WhatsApp</span>
          <strong>Reply + qualification</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>AI Agents</span>
          <strong>Supervised actions</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-automation-nav" aria-label="AI and automation page navigation">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section id="cockpit" class="automation-cockpit" aria-label="Richmedia AI and automation promises">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Automation cockpit</strong>
          <small>supervised agents</small>
        </div>
        <div class="cockpit-zero">
          <span>AI</span>
          <div>
            <p>{proofCards[0].metric} clean</p>
            <h2>Automate without losing control of data and human approvals.</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 94%">
            <span>Structured CRM data</span>
            <i></i>
          </div>
          <div style="--value: 88%">
            <span>Assisted WhatsApp replies</span>
            <i></i>
          </div>
          <div style="--value: 79%">
            <span>Framed human handoff</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="answer" class="quick-answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Quick answer</span>
        <h2 id="quick-answer-title">In 2026, automation performs when it is connected to CRM and framed by humans.</h2>
      </div>
      <p>
        AI tools are everywhere, but value comes from a concrete system: clean data, useful scenarios, agents connected
        to the right tools, controlled permissions, human handoff, tracking and continuous improvement.
      </p>
    </section>

    <section id="trends" class="trend-section" aria-labelledby="trend-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">AI & automation trends 2026</span>
          <h2 id="trend-title">What brands must master now.</h2>
        </div>
        <p>
          Companies are moving from isolated chatbots to agents connected to CRM, WhatsApp conversations,
          business workflows and decision dashboards.
        </p>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="usecases" class="usecase-section" aria-labelledby="usecase-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Use cases</span>
          <h2 id="usecase-title">Automations your customers can feel and your teams can actually use.</h2>
        </div>
        <p>
          Our priority is to automate the moments where you lose time, leads or response quality.
        </p>
      </div>
      <div class="usecase-grid">
        {useCases.map((item) => (
          <article>
            <div class="usecase-photo">
              <img src={`${assetBase}/${item.image}`} alt={item.title} loading="lazy" decoding="async" />
            </div>
            <div class="usecase-copy">
              <span>{item.type}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <div>
                {item.formats.map((format) => <small>{format}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="system" class="automation-system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-top">
            <span></span><span></span><span></span>
            <strong>richmedia.ma / ai-automation</strong>
          </div>
          <div class="screen-body">
            <div class="data-card data-card-a">
              <span>input</span>
              <strong>Qualified WhatsApp lead</strong>
            </div>
            <div class="data-card data-card-b">
              <span>agent_rules</span>
              <strong>Reply + CRM + handoff</strong>
            </div>
            <div class="automation-flow">
              <span>Ads</span>
              <i></i>
              <span>WhatsApp</span>
              <i></i>
              <span>CRM</span>
              <i></i>
              <span>Sales</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Our AI system</span>
        <h2 id="system-title">An AI stack that executes, measures and knows when to hand off.</h2>
        <p>
          We do not sell a chatbot dropped onto a page. We build automation journeys connected to your goals:
          acquisition, qualification, service, follow-up, sales and reporting.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="tool-stack" aria-labelledby="tool-title">
      <div class="section-heading compact">
        <span class="eyebrow">Tools & integrations</span>
        <h2 id="tool-title">The automation, CRM and reporting stack to manage your scenarios.</h2>
      </div>
      <div class="logo-marquee" aria-label="AI automation CRM and reporting tools">
        <div class="logo-track">
          {[0, 1].map((loopIndex) => (
            <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
              {automationTools.map((tool) => (
                <figure>
                  <span>
                    <img
                      src={`${logoBase}/${tool.logo}`}
                      alt={loopIndex === 0 ? `Logo ${tool.name}` : ''}
                      loading="eager"
                      decoding="async"
                    />
                  </span>
                  <figcaption>{tool.name}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {automationTools.map((tool) => (
          <figure>
            <span>
              <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
            </span>
            <figcaption>
              <strong>{tool.name}</strong>
              <small>{tool.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Richmedia method</span>
          <h2 id="roadmap-title">From diagnosis to scaling, every automation is tested.</h2>
        </div>
        <p>
          We start small, prove value, then extend agents and workflows where the impact is most visible.
        </p>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="deliverables" class="deliverables-section" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Deliverables</span>
        <h2 id="deliverables-title">What you receive to manage without a black box.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section id="sources" class="sources-section" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">Sources 2026</span>
        <h2 id="sources-title">The signals that structure our AI & automation approach.</h2>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noreferrer">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Frequently asked questions about AI, CRM and automation.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="automation-cta" class="automation-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Let's talk system</span>
        <h2 id="cta-title">Let's turn your conversations and leads into automated journeys.</h2>
        <p>
          CRM audit, WhatsApp, AI agents, scoring, workflows and dashboards: we frame the first
          automations with business impact.
        </p>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/en/contact">
          Frame your automation
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .automation-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 60, 255, 0.2), transparent 28rem),
      radial-gradient(circle at 12% 30%, rgba(124, 60, 255, 0.12), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
  }

  .automation-hero,
  .mobile-automation-nav,
  .automation-cockpit,
  .quick-answer,
  .trend-section,
  .usecase-section,
  .automation-system,
  .tool-stack,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .automation-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .mobile-automation-nav {
    display: none;
  }

  .automation-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    min-height: 94vh;
    padding: clamp(7rem, 11vw, 10rem) 0 5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-2);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.1rem;
    height: 2px;
    content: "";
    background: var(--purple-2);
  }

  .hero-copy h1 {
    --h1-size: clamp(2.75rem, 5.2vw, 3.125rem);
    max-width: 760px;
    margin-top: 1.1rem;
    font-size: var(--h1-size);
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero-copy p,
  .section-heading p,
  .quick-answer p,
  .system-copy > p,
  .automation-cta p {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.7;
  }

  .hero-lead {
    max-width: 690px;
    margin-top: 1.45rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    border-radius: 8px;
    padding: 0.9rem 1.25rem;
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9655ff, #6425f4);
    box-shadow: 0 1.1rem 2.8rem rgba(124, 60, 255, 0.32);
  }

