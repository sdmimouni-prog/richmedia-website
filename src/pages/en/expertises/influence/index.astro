    margin-top: 1rem;
    color: var(--purple-2);
    font-size: 1.0625rem;
    font-weight: 850;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.2rem;
  }

  .faq-list details {
    padding: 1rem 1.1rem;
  }

  .faq-list summary {
    cursor: pointer;
    font-weight: 850;
    line-height: 1.35;
  }

  .influence-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    margin-bottom: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.4rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at 8% 10%, rgba(124, 60, 255, 0.28), transparent 24rem),
