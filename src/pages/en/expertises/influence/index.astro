  .logo-marquee img {
    width: 78%;
    height: 2.1rem;
    object-fit: contain;
  }

  .logo-marquee figcaption {
    margin-top: 0.45rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .tool-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .tool-grid figure {
    grid-template-columns: 4.4rem minmax(0, 1fr);
    align-items: center;
    justify-items: start;
    gap: 1rem;
    min-height: 6.2rem;
    padding: 1rem;
