---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../../../components/SeoSiloLinks.astro';
import InfluenceVideoStrip from '../../../../components/InfluenceVideoStrip.astro';
import { SITE } from '../../../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../../../lib/schema';
import { enSiloLinks } from '../../../../lib/seo-silos';

const assetBase = '/assets/richmedia-influence';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/en/expertises/influence`;

const seoTitle = 'Influencer Marketing Agency in Morocco | Richmedia';
const seoDescription =
  'Manage influencer campaigns with creator casting, UGC, negotiation, paid amplification, brand safety and impact measurement.';

const influenceTools = [
  { name: 'Meta', logo: 'meta.svg', note: 'Instagram, Reels & paid social' },
  { name: 'TikTok / Social-first', logo: 'later.png', note: 'Short formats & calendar' },
  { name: 'Influencer Marketing Hub', logo: 'influencer-marketing-hub.png', note: 'Creator intelligence' },
  { name: 'Google Trends', logo: 'google-trends.png', note: 'Demand signals' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Conversions & journeys' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'ROI reporting' },
  { name: 'Zapier', logo: 'zapier.svg', note: 'Automations & leads' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'Post-click UX' },
];

const proofCards = [
  {
    metric: 'Casting',
    title: 'Qualified Moroccan creators',
    text: 'We select profiles aligned with your brand, their real audience, editorial territory and ability to produce credible content.',
  },
  {
    metric: 'UGC',
    title: 'Reusable content assets',
    text: 'Creators produce assets that live on their accounts, your pages, your landing pages and your paid campaigns.',
  },
  {
    metric: 'Brand safety',
    title: 'Rights, briefs and compliance',
    text: 'Briefs, approvals, partnership mentions, usage rights, exclusivity and editorial guardrails are framed before production.',
  },
  {
    metric: 'ROI',
    title: 'Measurement beyond likes',
    text: 'We track useful reach, qualitative engagement, traffic, leads, sales, promo codes, UTMs, CPA and creative learnings.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    image: 'trends/trend-creator-economy.webp',
    label: 'Creator economy',
    title: 'Influence becomes a media channel',
    text: 'Budgets, rights, brand safety and ROI are becoming structured.',
  },
  {
    image: 'trends/trend-micro-communautes.webp',
    label: 'Micro-communities',
    title: 'The right creator beats bigger reach',
    text: 'Nano and micro-profiles win through proximity and credibility.',
  },
  {
    image: 'trends/trend-ugc-flywheel.webp',
    label: 'UGC flywheel',
    title: 'Creator content feeds paid media',
    text: 'Hooks, reviews, videos and photos become ad-ready assets.',
  },
  {
    image: 'trends/trend-long-term.webp',
    label: 'Long-term',
    title: 'Ambassadors replace one-shots',
    text: 'Series and recurring collaborations build more trust.',
  },
  {
    image: 'trends/trend-ai-matching.webp',
    label: 'AI matching',
    title: 'AI helps with matching',
    text: 'Scoring accelerates the shortlist, but judgment stays human.',
  },
  {
    image: 'trends/trend-seo-geo.webp',
    label: 'SEO / GEO',
    title: 'Campaigns become citable',
    text: 'FAQs, proof, reviews and UGC strengthen Google and AI engines.',
  },
];

const creatorProfiles = [
  {
    image: 'creator-lifestyle.webp',
    type: 'Lifestyle & beauty',
    city: 'Casablanca',
    title: 'Premium lifestyle creator',
    text: 'Ideal for beauty, fashion, retail, skincare, product launches and natural Reels with product demonstration.',
    formats: ['Reels', 'Stories', 'UGC ads'],
  },
  {
    image: 'creator-food.webp',
    type: 'Food & family',
    city: 'Marrakech / Rabat',
    title: 'Food and everyday-life creator',
    text: 'Built for FMCG, restaurants, tourism, family moments, recipes, local experiences and close-community storytelling.',
    formats: ['Shorts', 'Recipes', 'Reviews'],
  },
  {
    image: 'creator-urban.webp',
    type: 'Urban culture',
    city: 'Casablanca',
    title: 'Sport, tech and urban culture creator',
    text: 'Designed for telecom, apps, mobility, sports, events, active youth and dynamic outdoor content.',
    formats: ['TikTok', 'Reels', 'Lives'],
  },
];

const services = [
  {
    kicker: 'Strategy',
    title: 'Influence plan and campaign architecture',
    text: 'Goals, audiences, territories, messages, formats, timeline, KPIs, budget and each creator role in the funnel.',
    items: ['Goals', 'Audiences', 'KPIs', 'Budget'],
  },
  {
    kicker: 'Casting',
    title: 'Moroccan influencer selection',
    text: 'Qualified shortlist by audience, brand affinity, content quality, history, tone, credibility and brand-safety risk.',
    items: ['Nano', 'Micro', 'Macro', 'Niche'],
  },
  {
    kicker: 'Production',
    title: 'Briefs, scripts, UGC and approval',
    text: 'Creative brief, hooks, claims, storytelling, vertical formats, usage rights and quality control before publication.',
    items: ['UGC', 'Reels', 'Stories', 'Scripts'],
  },
  {
    kicker: 'Performance',
    title: 'Paid amplification and ROI reporting',
    text: 'Boosting top content, UTM tracking, codes, dashboards, learnings, CPA, sales and optimization for the next waves.',
    items: ['Paid boost', 'UTM', 'CPA', 'ROI'],
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Framing',
    text: 'Business goal, audience, offer, regulatory constraints, budget, brand tone and approval rules.',
  },
  {
    step: '02',
    title: 'Casting',
    text: 'Shortlist, scoring, qualitative review, negotiation, availability, formats, rights and timeline.',
  },
  {
    step: '03',
    title: 'Creative brief',
    text: 'Message, angles, hooks, proof, CTAs, required mentions, deliverables and controlled editorial freedom.',
  },
  {
    step: '04',
    title: 'Activation',
    text: 'Production, approval, publication, real-time monitoring, community responses and paid amplification.',
  },
  {
    step: '05',
    title: 'Measurement',
    text: 'Useful reach, engagement, traffic, conversions, winning content, audience insights and recommendations.',
  },
];

const deliverables = [
  'Influence and competitor audit',
  'Morocco audience mapping',
  'Qualified influencer shortlist',
  'Brand-safety scoring',
  'Creative brief and content angles',
  'Scripts, hooks and CTAs',
  'Negotiation and contracts',
  'UGC usage rights',
  'Publication calendar',
  'UTM / code tracking kit',
  'Paid amplification of top posts',
  'Performance and ROI dashboard',
];

const sources = [
  {
    title: 'Kantar Marketing Trends 2026',
    text: 'Creators must prove both ROI and brand impact, with long-term creative platforms, clear guardrails and stronger metrics.',
    href: 'https://www.kantar.com/campaigns/marketing-trends',
  },
  {
    title: 'Kantar North America 2026',
    text: 'Most marketers expect to increase creator investments, but brand fit and measurement remain the real challenge.',
    href: 'https://www.kantar.com/north-america/Company-news/Kantars-2026-Marketing-Trends',
  },
  {
    title: 'IAB Global Creator Week 2026',
    text: 'The creator economy is structuring around trust, governance, measurable impact and brand building.',
    href: 'https://www.iab.com/news/iab-global-creator-week-launches/',
  },
  {
    title: 'impact.com Influencer Trends 2026',
    text: 'Micro-creators, hybrid partnerships, AI matching, reusable content and performance accountability are becoming campaign standards.',
    href: 'https://impact.com/influencer/influencer-marketing-trends-performance/',
  },
];

const faq = [
  {
    question: 'What is an influencer marketing agency in Morocco?',
    answer:
      'An influencer marketing agency in Morocco designs, selects, negotiates, manages and measures collaborations with Moroccan influencers to generate awareness, content, traffic, leads or sales.',
  },
  {
    question: 'How does Richmedia choose the right influencers?',
    answer:
      'We analyze audience, editorial territory, content quality, real engagement, brand fit, brand-safety risks, available formats and the potential to reuse content as UGC.',
  },
  {
    question: 'Should we work with nano, micro or macro-influencers?',
    answer:
      'The choice depends on the goal. Nano and micro-creators are useful for trust and niches, larger profiles for reach, and hybrid mixes for credibility, volume and performance.',
  },
  {
    question: 'How is influencer campaign ROI measured?',
    answer:
      'We track useful impressions, qualitative engagement, UTM traffic, promo codes, leads, sales, cost per result, UGC value produced and the content worth amplifying through paid media.',
  },
  {
    question: 'Why talk about SEO/GEO on an influence page?',
    answer:
      'Because search engines and AI engines cross-check content, mentions, reviews, FAQs, structured pages and social signals. A well-documented influence campaign can strengthen brand discoverability.',
  },
];

const schema = [
  serviceSchema({
    name: 'Influencer marketing',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Expertise', url: `${SITE.url}/en/expertises` },
    { name: 'Influence', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: 'Fit' },
  { href: '#trends', label: 'Trends', value: '2026' },
  { href: '#creators', label: 'Talent', value: 'Profiles' },
  { href: '#influence-cta', label: 'Project', value: 'Activate' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/influence-hero.webp`}
  schema={schema}
  lang="en"
>
  <div class="influence-page">
    <section class="influence-hero" aria-labelledby="influence-title">
      <div class="hero-copy">
        <span class="eyebrow">Richmedia expertise</span>
        <h1 id="influence-title">Moroccan influence built to sell.</h1>
        <p class="hero-lead">
          Richmedia selects, frames, activates and measures your campaigns with relevant Moroccan influencers:
          credible content, reusable UGC, paid amplification and ROI-driven reporting.
          For a market-focused view, explore our approach to
          <a href="/influencer-marketing-morocco">influencer marketing in Morocco</a>.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/en/contact">
            Frame an influence campaign
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/case-studies">
            View case studies
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual creator-hover-lab" aria-label="Richmedia influence campaign in Morocco">
        <img
          src={`${assetBase}/influence-hero.webp`}
          alt="Fictional Moroccan creators preparing an influencer marketing campaign"
          width="1586"
          height="992"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="signal-card signal-card-top">
          <span>Casting</span>
          <strong>Qualified creators</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>UGC</span>
          <strong>Reusable content</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>Measurement</span>
          <strong>ROI + brand lift</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-influence-nav" aria-label="Influence page navigation">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section id="cockpit" class="influence-cockpit" aria-label="Richmedia influence promises">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Creator cockpit</strong>
          <small>active brand fit</small>
        </div>
        <div class="cockpit-zero">
          <span>FIT</span>
          <div>
            <p>{proofCards[0].metric} qualified</p>
            <h2>The right creator, the right rights and the right indicators before activation.</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 92%">
            <span>Real audience verified</span>
            <i></i>
          </div>
          <div style="--value: 86%">
            <span>UGC rights framed</span>
            <i></i>
          </div>
          <div style="--value: 78%">
            <span>ROI tracking ready</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="answer" class="quick-answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Quick answer</span>
        <h2 id="quick-answer-title">In 2026, influence performs when it is managed like media.</h2>
      </div>
      <p>
        Brands can no longer buy a single post and hope for the best. They need a system:
        the right casting, precise briefs, editorial freedom, UGC rights, tracking, paid amplification
        and business reading. That is where Richmedia turns influence into a measurable growth lever.
      </p>
    </section>

    <InfluenceVideoStrip lang="en" />

    <section id="trends" class="trend-section" aria-labelledby="trend-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Influence trends 2026</span>
          <h2 id="trend-title" class="trend-title-two-line">
            <span>What brands must</span>
            <span>master now.</span>
          </h2>
        </div>
        <p>
          A structured creator economy, micro-communities, amplifiable UGC, AI matching, compliance
          and ROI measurement redefine the role of a true influencer marketing agency.
        </p>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <div class="trend-media">
              <img src={`${assetBase}/${trend.image}`} alt={trend.title} loading="lazy" decoding="async" />
            </div>
            <div class="trend-copy">
              <span>{trend.label}</span>
              <h3>{trend.title}</h3>
              <p>{trend.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="creators" class="creator-section" aria-labelledby="creator-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Creator network</span>
          <h2 id="creator-title">Moroccan profiles matched to the message, not only to reach.</h2>
        </div>
      </div>
      <div class="creator-grid">
        {creatorProfiles.map((creator) => (
          <article>
            <div class="creator-photo">
              <img src={`${assetBase}/${creator.image}`} alt={`${creator.title} in ${creator.city}`} loading="lazy" decoding="async" />
            </div>
            <div class="creator-copy">
              <span>{creator.type} / {creator.city}</span>
              <h3>{creator.title}</h3>
              <p>{creator.text}</p>
              <div>
                {creator.formats.map((format) => <small>{format}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="system" class="influence-system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-top">
            <span></span><span></span><span></span>
            <strong>richmedia / creator-growth</strong>
          </div>
          <div class="screen-body">
            <div class="creator-card creator-card-a">
              <span>match_score</span>
              <strong>Audience fit 92%</strong>
              <small>Beauty / Casablanca / Reels</small>
            </div>
            <div class="creator-card creator-card-b">
              <span>ugc_rights</span>
              <strong>Paid boost ready</strong>
              <small>3 hooks / 5 assets / 30 days</small>
            </div>
            <div class="influence-flow">
              <span>Brief</span>
              <i></i>
              <span>Creator</span>
              <i></i>
              <span>ROI</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Our influence system</span>
        <h2 id="system-title">An influencer agency that connects creators, media and data.</h2>
        <p>
          We do not deliver a simple list of influencers. We build a complete operating system:
          selecting the right profiles, briefing, rights, production, publication, amplification and reporting
          that marketing, sales and leadership teams can actually use.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="tool-stack" aria-labelledby="tool-title">
      <div class="section-heading compact">
        <span class="eyebrow">Partners & tools</span>
        <h2 id="tool-title">The stack used to manage influence, UGC, tracking and amplification.</h2>
      </div>
      <div class="logo-marquee" aria-label="Influence and performance tools">
        <div class="logo-track">
          {[0, 1].map((loopIndex) => (
            <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
              {influenceTools.map((tool) => (
                <figure>
                  <span>
                    <img
                      src={`${logoBase}/${tool.logo}`}
                      alt={`Logo ${tool.name}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <figcaption>{tool.name}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {influenceTools.map((tool) => (
          <figure>
            <span>
              <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
            </span>
            <figcaption>
              <strong>{tool.name}</strong>
              <small>{tool.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Richmedia method</span>
          <h2 id="roadmap-title">From casting to reporting, every decision is managed.</h2>
        </div>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="deliverables" class="deliverables-section" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Deliverables</span>
        <h2 id="deliverables-title">What you receive to manage without blind spots.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section id="sources" class="sources-section" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">2026 watch</span>
        <h2 id="sources-title">Market signals integrated into our approach.</h2>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noopener">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
            <small>Read the source <i class="ph ph-arrow-up-right" aria-hidden="true"></i></small>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Frequently asked questions.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="influence-cta" class="influence-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Ready to activate?</span>
        <h2 id="cta-title">Launch an influence campaign with credible creators and clear measurement.</h2>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/en/contact">
          Talk to Richmedia
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Connect influence, content and amplification"
    intro="An influence campaign is stronger when it connects to brand content, paid media and sector objectives."
    links={enSiloLinks.influence}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .influence-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 60, 255, 0.18), transparent 28rem),
      radial-gradient(circle at 12% 30%, rgba(124, 60, 255, 0.1), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
  }

  .influence-hero,
  .mobile-influence-nav,
  .influence-cockpit,
  .quick-answer,
  .trend-section,
  .creator-section,
  .influence-system,
  .tool-stack,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .influence-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .influence-cockpit,
  .quick-answer,
  .trend-section,
  .creator-section,
  .influence-system,
  .tool-stack,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .influence-cta {
    scroll-margin-top: 6rem;
  }

  .mobile-influence-nav {
    display: none;
  }

  .influence-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    min-height: 94vh;
    padding: clamp(7rem, 11vw, 10rem) 0 5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-2);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.1rem;
    height: 2px;
    content: "";
    background: var(--purple-2);
  }

  .hero-copy h1 {
    --h1-size: clamp(2.75rem, 5.2vw, 3.125rem);
    max-width: 760px;
    margin-top: 1.1rem;
    font-size: var(--h1-size);
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero-copy p,
  .section-heading p,
  .quick-answer p,
  .system-copy > p,
