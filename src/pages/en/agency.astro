---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localBusiness, breadcrumbs } from '../../lib/schema';
import { SITE } from '../../consts';

const pageUrl = `${SITE.url}/en/agency`;
const pageDescription =
  'Discover Richmedia, a Casablanca-based digital agency combining strategy, creative, media, SEO/GEO, web, CRM and AI for brands in Morocco.';

const schema = [
  { ...localBusiness(), url: pageUrl, description: pageDescription, inLanguage: 'en' },
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Agency', url: pageUrl },
  ]),
];

const metrics = [
  { icon: 'ph ph-chart-line-up', value: '+156', label: 'completed projects', text: 'for local, national and international brands.' },
  { icon: 'ph ph-users-three', value: '+117', label: 'clients supported', text: 'across demanding sectors.' },
  { icon: 'ph ph-buildings', value: '4', label: 'offices', text: 'Casablanca, Dubai, Montreal and Strasbourg.' },
];

const approach = [
  {
    number: '01',
    icon: 'ph ph-target',
    title: 'Clear strategy',
    text: 'We frame goals, audiences, messages, channels and indicators to align vision, budget and execution.',
  },
  {
    number: '02',
    icon: 'ph ph-note-pencil',
    title: 'Useful creative',
    text: 'We design content, interfaces and experiences that attract attention, reassure audiences and make conversion easier.',
  },
  {
    number: '03',
    icon: 'ph ph-chart-line-up',
    title: 'Continuous steering',
    text: 'We activate, measure and continuously optimize campaigns to improve performance, acquisition cost and ROI.',
  },
];

const values = [
  { icon: 'ph ph-users-three', title: 'Team spirit', text: 'Complementary profiles united around client results.' },
  { icon: 'ph ph-lightbulb', title: 'Standards & quality', text: 'Strong attention to detail, consistency and reliability.' },
  { icon: 'ph ph-heart', title: 'Results culture', text: 'Creative ideas designed to produce measurable impact.' },
];

const milestones = [
  { year: '2012', title: 'Richmedia is founded in Casablanca', text: 'The agency starts with a simple ambition: connect digital strategy, creative and performance.' },
  { year: '2015', title: 'Expertise expansion', text: 'Media, social media, content, web and acquisition-driven systems become core agency pillars.' },
  { year: '2018', title: 'International opening', text: 'Richmedia supports clients in Morocco and internationally, with a presence in Dubai.' },
  { year: '2021', title: 'Montreal and Strasbourg', text: 'The agency gets closer to new markets and creative, media and technology partners.' },
  { year: '2024', title: 'Data, AI & automation', text: 'WhatsApp journeys, CRM, SEO/GEO and AI strengthen campaign measurement and efficiency.' },
];

const references = [
  { name: 'UIR', src: '/assets/richmedia-home/logos/references/uir.jpg' },
  { name: 'Amana', src: '/assets/richmedia-home/logos/references/amana.jpg' },
  { name: 'Don Simon', src: '/assets/richmedia-home/logos/references/don-simon.jpg' },
  { name: 'Terroir du Maroc', src: '/assets/richmedia-home/logos/references/terroir-du-maroc.jpg' },
  { name: 'Electroplanet', src: '/assets/richmedia-home/logos/references/electroplanet.jpg' },
  { name: 'KITEA', src: '/assets/richmedia-home/logos/references/kitea.jpg' },
  { name: 'Carrefour Market', src: '/assets/richmedia-home/logos/references/carrefour-market.jpg' },
  { name: 'Asswak Assalam', src: '/assets/richmedia-home/logos/references/asswak-assalam.jpg' },
  { name: 'Lesieur Cristal', src: '/assets/richmedia-home/logos/references/lesieur-cristal.jpg' },
  { name: 'Maroc Telecom', src: '/assets/richmedia-home/logos/references/maroc-telecom.jpg' },
  { name: 'Prestigia', src: '/assets/richmedia-home/logos/campaigns/prestigia.jpg' },
  { name: 'Tramway Rabat-Salé', src: '/assets/richmedia-home/logos/campaigns/tramway-rabat.jpg' },
  { name: 'TBS Education', src: '/assets/richmedia-home/logos/campaigns/tbs-education.jpg' },
  { name: 'CMR', src: '/assets/richmedia-home/logos/campaigns/cmr.jpg' },
  { name: 'Moul Pounj', src: '/assets/richmedia-home/logos/campaigns/moul-pounj.jpg' },
  { name: 'Ryad Al Andalous', src: '/assets/richmedia-home/logos/campaigns/ryad-al-andalous.jpg' },
  { name: 'Rabat Riviera', src: '/assets/richmedia-home/logos/campaigns/rabat-riviera.jpg' },
  { name: 'BED', src: '/assets/richmedia-home/logos/campaigns/beed.jpg' },
];

const referenceLoop = [...references, ...references];
---

<BaseLayout
  title="Digital Agency in Casablanca | Richmedia"
  description={pageDescription}
  canonical={pageUrl}
  lang="en"
  schema={schema}
>
  <article class="agency-page">
    <section class="agency-hero" aria-labelledby="agency-title">
      <div class="agency-hero-copy">
        <span class="section-kicker">About Richmedia</span>
        <h1 id="agency-title">
          The digital agency that turns ideas into <strong>measurable growth.</strong>
        </h1>
        <p>
          From Casablanca, Richmedia helps brands, institutions and networks grow in Morocco and internationally
          through digital strategy, media, web, SEO/GEO and automation.
        </p>
        <a class="agency-play-link" href="/en/case-studies">
          <span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></span>
          Discover Richmedia in 90s
        </a>
      </div>

      <figure class="agency-hero-visual">
        <img
          src="/assets/richmedia-agence/agence-hero-office.webp"
          alt="Richmedia studio, digital agency in Casablanca"
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="agency-experience-card">
          <strong>12</strong>
          <span>years of experience serving growth</span>
        </figcaption>
        <div class="agency-caption-card">Strategy. Creative. Media. Web. Automation.</div>
      </figure>
    </section>

    <section class="agency-metrics" aria-label="Richmedia key figures">
      <div class="metrics-grid">
        {metrics.map((metric) => (
          <article>
            <i class={metric.icon} aria-hidden="true"></i>
            <div>
              <strong data-count-value={metric.value}>{metric.value}</strong>
              <span>{metric.label}</span>
              <p>{metric.text}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="metrics-map" aria-hidden="true">
        <img src="/assets/richmedia-home/optimized/world-map-natural-earth.webp" alt="" loading="lazy" decoding="async" width="1000" height="520" />
        <span class="map-route map-route-1"></span>
        <span class="map-route map-route-2"></span>
        <span class="map-route map-route-3"></span>
        <span class="map-route map-route-4"></span>
        <span class="office-pin office-montreal" style="--x:33.79%; --y:24.44%;">
          <span class="pin-pulse"></span>
          <span class="pin-core"></span>
          <span class="pin-label"><strong>Montreal</strong><small>Canada</small></span>
        </span>
        <span class="office-pin office-strasbourg" style="--x:51.68%; --y:22.8%;">
          <span class="pin-pulse"></span>
          <span class="pin-core"></span>
          <span class="pin-label"><strong>Strasbourg</strong><small>France</small></span>
        </span>
        <span class="office-pin office-casablanca" style="--x:48.24%; --y:30.94%;">
          <span class="pin-pulse"></span>
          <span class="pin-core"></span>
          <span class="pin-label"><strong>Casablanca</strong><small>Morocco</small></span>
        </span>
        <span class="office-pin office-dubai" style="--x:63.15%; --y:35.54%;">
          <span class="pin-pulse"></span>
          <span class="pin-core"></span>
          <span class="pin-label"><strong>Dubai</strong><small>UAE</small></span>
        </span>
      </div>
    </section>

    <section class="agency-approach" aria-labelledby="approach-title">
      <div class="section-intro">
        <span class="section-kicker">Our approach</span>
        <h2 id="approach-title">What makes us different.</h2>
        <p>
          A clear method, useful deliverables and continuous steering to turn your marketing goals into measurable
          results.
        </p>
      </div>
      <div class="approach-grid">
        {approach.map((item) => (
          <article>
            <i class={item.icon} aria-hidden="true"></i>
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="agency-studio" aria-labelledby="studio-title">
      <div class="studio-copy">
        <span class="section-kicker">Our studio</span>
        <h2 id="studio-title">Passionate talent serving your challenges.</h2>
        <p>
          Strategists, creatives, developers, media buyers, social media managers, data analysts and AI profiles work
          together to create digital systems tailored to your ambitions in Morocco, the Maghreb and internationally.
        </p>
        <div class="value-grid">
          {values.map((value) => (
            <article>
              <i class={value.icon} aria-hidden="true"></i>
              <strong>{value.title}</strong>
              <p>{value.text}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="studio-media">
        <img class="studio-main" src="/assets/richmedia-agence/agence-studio-meeting.webp" alt="Richmedia team in a digital strategy workshop" width="1280" height="720" loading="lazy" decoding="async" />
        <img class="studio-small studio-small-top" src="/assets/richmedia-agence/agence-collaboration-small.webp" alt="Creative and digital collaboration at Richmedia" width="720" height="405" loading="lazy" decoding="async" />
        <img class="studio-small studio-small-bottom" src="/assets/richmedia-agence/agence-studio-meeting-small.webp" alt="Richmedia digital studio and project team" width="720" height="405" loading="lazy" decoding="async" />
        <a class="studio-floating" href="/en/team">
          A culture of collaboration and impact.
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <section class="agency-history" aria-labelledby="history-title">
      <div class="section-intro">
        <span class="section-kicker">Our story</span>
        <h2 id="history-title">A growth trajectory.</h2>
      </div>
      <ol class="history-timeline">
        {milestones.map((item, index) => (
          <li style={`--history-delay: ${index * 120}ms`}>
            <time>{item.year}</time>
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="agency-references" aria-labelledby="references-title">
      <span class="section-kicker">They trust us</span>
      <h2 id="references-title">Solid references in Morocco and internationally.</h2>
      <div class="reference-strip" aria-label="Richmedia references">
        <div class="reference-track">
          {referenceLoop.map((item, index) => (
            <figure aria-hidden={index >= references.length ? 'true' : 'false'}>
              <img src={item.src} alt={index >= references.length ? '' : `${item.name} logo`} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="agency-cta" aria-labelledby="agency-cta-title">
      <h2 id="agency-cta-title">Let's talk about your next digital growth.</h2>
      <p>
        A project, an idea or a challenge? Let's discuss your goals and build a clear, creative and measurable digital
        strategy.
      </p>
      <a class="button button-primary" href="/en/contact">
        Let's discuss your project
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </article>
</BaseLayout>

<script>
  const countValues = () => {
    const counters = document.querySelectorAll<HTMLElement>('[data-count-value]');
    const animate = (counter: HTMLElement) => {
      if (counter.dataset.counted === 'true') return;
      counter.dataset.counted = 'true';
      const raw = counter.dataset.countValue || counter.textContent || '';
      const prefix = raw.trim().startsWith('+') ? '+' : '';
      const target = Number(raw.replace(/[^\d]/g, ''));
      if (!Number.isFinite(target)) return;
      const duration = 1100;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        counter.textContent = `${prefix}${Math.round(target * eased)}`;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (!('IntersectionObserver' in window)) {
      counters.forEach(animate);
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        animate(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.35 });

    counters.forEach((counter) => observer.observe(counter));
  };

  countValues();
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .agency-page {
    --purple: #8c52ff;
    --purple-soft: #b985ff;
    --line: rgba(255, 255, 255, 0.13);
    --panel: rgba(10, 11, 20, 0.78);
    --muted: rgba(232, 237, 245, 0.72);
    width: min(100% - 3rem, 1320px);
    margin: 0 auto;
    padding: clamp(8rem, 9vw, 9.8rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .agency-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(520px, 1.14fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
    color: var(--purple-soft);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    display: inline-block;
    width: 1.55rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .agency-hero h1,
  .section-intro h2,
  .studio-copy h2,
  .agency-references h2,
  .agency-cta h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    letter-spacing: 0;
  }

  .agency-hero h1 {
    max-width: 36rem;
    font-size: clamp(3.15rem, 6.6vw, 5.8rem);
    line-height: 0.96;
  }

  .agency-hero h1 strong {
    color: var(--purple);
    font-weight: inherit;
  }

  .agency-hero-copy > p,
  .section-intro p,
  .studio-copy > p,
  .agency-cta p {
    color: var(--muted);
    line-height: 1.78;
  }

  .agency-hero-copy > p {
    max-width: 34rem;
    margin: 1.45rem 0 0;
    font-size: 1rem;
  }

  .agency-play-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    color: var(--purple-soft);
    font-weight: 800;
    text-decoration: none;
  }

  .agency-play-link span {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(185, 133, 255, 0.64);
    border-radius: 999px;
    background: rgba(124, 60, 255, 0.08);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .agency-play-link:hover span {
    box-shadow: 0 0 1.5rem rgba(124, 60, 255, 0.35);
    transform: scale(1.06);
  }

  .agency-hero-visual {
    --hover-x: 0px;
    --hover-y: 0px;
    position: relative;
    min-height: clamp(25rem, 44vw, 36rem);
    margin: 0;
    isolation: isolate;
    perspective: 1200px;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1), filter 520ms ease;
  }

  .agency-hero-visual > img {
    position: absolute;
    inset: 4% 9% 8% 0;
    width: 74%;
    height: 78%;
    border: 1px solid var(--line);
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 1.6rem 5rem rgba(0, 0, 0, 0.4);
    transform: translate(0, 0);
    transition:
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 620ms ease,
      box-shadow 620ms ease,
      border-color 620ms ease;
  }

  .agency-hero-visual::before {
    position: absolute;
    inset: 18% 18% 8% 6%;
    border: 1px solid rgba(140, 82, 255, 0.34);
    border-radius: 8px;
    background: rgba(124, 60, 255, 0.12);
    box-shadow: 0 0 3rem rgba(124, 60, 255, 0.18);
    content: "";
    transform: rotate(-31deg);
    transition:
      transform 760ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 620ms ease,
      background 620ms ease,
      box-shadow 620ms ease;
  }

  .agency-hero-visual::after {
    position: absolute;
    z-index: 1;
    inset: 4% 9% 8% 0;
    border-radius: 8px;
    background:
      linear-gradient(112deg, transparent 0 34%, rgba(255, 255, 255, 0.08) 42%, rgba(185, 119, 255, 0.34) 49%, transparent 58% 100%),
      radial-gradient(circle at 22% 20%, rgba(124, 60, 255, 0.28), transparent 30%);
    content: "";
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-22%) skewX(-12deg);
    transition:
      opacity 420ms ease,
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .agency-experience-card,
  .agency-caption-card {
    position: absolute;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(10, 10, 18, 0.72);
    backdrop-filter: blur(18px);
    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.34);
    transition:
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 420ms ease,
      background 420ms ease,
      box-shadow 420ms ease;
  }

  .agency-experience-card {
    right: 1.5rem;
    top: 24%;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(5.6rem, 0.72fr);
    gap: 0.9rem;
    align-items: end;
    width: min(16rem, calc(100% - 2rem));
    max-width: none;
    padding: 1.25rem;
  }

  .agency-experience-card strong {
    color: var(--purple);
    font-family: var(--font-display);
    font-size: clamp(4.4rem, 8vw, 7rem);
    line-height: 0.78;
    transition: text-shadow 420ms ease, transform 420ms ease;
  }

  .agency-experience-card span {
    color: #fff;
    min-width: 0;
    font-size: clamp(0.68rem, 1.05vw, 0.78rem);
    font-weight: 900;
    line-height: 1.18;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .agency-caption-card {
    left: 1rem;
    bottom: 17%;
    max-width: 15rem;
    padding: 1.25rem;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.65;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .agency-hero-visual:hover {
      transform: translateY(-0.35rem);
      filter: drop-shadow(0 2rem 3.5rem rgba(75, 35, 180, 0.22));
    }

    .agency-hero-visual:hover > img {
      border-color: rgba(169, 112, 255, 0.52);
      filter: saturate(1.12) contrast(1.06);
      transform: translate(-0.55rem, -0.45rem) scale(1.035);
      box-shadow: 0 2.4rem 6.4rem rgba(0, 0, 0, 0.52), 0 0 3rem rgba(124, 60, 255, 0.18);
    }

    .agency-hero-visual:hover::before {
      border-color: rgba(169, 112, 255, 0.58);
      background: rgba(124, 60, 255, 0.18);
      box-shadow: 0 0 4.2rem rgba(124, 60, 255, 0.32);
      transform: translate(1.1rem, -1rem) rotate(-24deg) scale(1.04);
    }

    .agency-hero-visual:hover::after {
      opacity: 1;
      transform: translateX(26%) skewX(-12deg);
    }

    .agency-hero-visual:hover .agency-experience-card {
      border-color: rgba(169, 112, 255, 0.58);
      background: rgba(14, 14, 24, 0.84);
      transform: translate(1rem, -1.2rem) scale(1.025);
      box-shadow: 0 1.8rem 4rem rgba(0, 0, 0, 0.44), 0 0 2.4rem rgba(124, 60, 255, 0.2);
    }

    .agency-hero-visual:hover .agency-caption-card {
      border-color: rgba(169, 112, 255, 0.48);
      background: rgba(14, 14, 24, 0.82);
      transform: translate(-0.85rem, 0.75rem);
      box-shadow: 0 1.6rem 3.6rem rgba(0, 0, 0, 0.42), 0 0 2rem rgba(124, 60, 255, 0.14);
    }

    .agency-hero-visual:hover .agency-experience-card strong {
      text-shadow: 0 0 1rem rgba(124, 60, 255, 0.42), 0 0 2.4rem rgba(185, 119, 255, 0.28);
      transform: translateY(-0.08em);
    }
  }

  .agency-metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.35rem;
    align-items: center;
    margin-top: clamp(3rem, 5vw, 5.4rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.55rem 1.7rem;
    background: rgba(10, 11, 20, 0.64);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .metrics-grid article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 0 1.45rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .metrics-grid article:first-child {
    padding-left: 0;
  }

  .metrics-grid article:last-child {
    border-right: 0;
  }

  .metrics-grid i,
  .approach-grid i,
  .value-grid i {
    color: var(--purple-soft);
    font-size: 2.2rem;
  }

  .metrics-grid i {
    display: grid;
    width: 3.35rem;
    height: 3.35rem;
    place-items: center;
    border: 1px solid rgba(185, 133, 255, 0.26);
    border-radius: 8px;
    background: rgba(124, 60, 255, 0.12);
  }

  .metrics-grid strong {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 0.92;
  }

  .metrics-grid span {
    display: block;
    margin-top: 0.3rem;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .metrics-grid p {
    margin: 0.45rem 0 0;
    color: rgba(232, 237, 245, 0.62);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .metrics-map {
    position: relative;
    min-height: clamp(24rem, 35vw, 32rem);
    overflow: hidden;
    border: 1px solid rgba(176, 132, 255, 0.35);
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 48%, rgba(138, 77, 255, 0.2), transparent 21rem),
      radial-gradient(circle at 44% 64%, rgba(124, 60, 255, 0.28), transparent 18rem),
      linear-gradient(180deg, rgba(3, 4, 10, 0.96), rgba(4, 5, 13, 0.98));
    isolation: isolate;
    box-shadow: inset 0 0 4rem rgba(124, 60, 255, 0.08), 0 1.6rem 4rem rgba(0, 0, 0, 0.26);
  }

  .metrics-map img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.84;
    filter: saturate(1.35) contrast(1.18) drop-shadow(0 0 2rem rgba(138, 77, 255, 0.22));
    mix-blend-mode: screen;
    transition: opacity 260ms ease, filter 260ms ease, transform 420ms ease;
  }

  .metrics-map:hover img {
    opacity: 0.95;
    filter: saturate(1.5) contrast(1.24) drop-shadow(0 0 2.4rem rgba(174, 124, 255, 0.34));
    transform: scale(1.015);
  }

  .metrics-map::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(7, 8, 17, 0.56), transparent 18%, transparent 82%, rgba(7, 8, 17, 0.62)),
      linear-gradient(180deg, rgba(7, 8, 17, 0.08), transparent 48%, rgba(7, 8, 17, 0.5));
    content: "";
    pointer-events: none;
  }

  .map-route {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    border-top: 1px solid rgba(176, 132, 255, 0.52);
    border-radius: 50%;
    filter: drop-shadow(0 0 0.8rem rgba(138, 77, 255, 0.55));
    animation: routePulse 3.6s ease-in-out infinite;
  }

  .map-route-1 {
    left: 26%;
    top: 38%;
    width: 30%;
    height: 25%;
    transform: rotate(12deg);
  }

  .map-route-2 {
    left: 47%;
    top: 36%;
    width: 22%;
    height: 17%;
    transform: rotate(-13deg);
    animation-delay: 0.3s;
  }

  .map-route-3 {
    left: 46%;
    top: 48%;
    width: 21%;
    height: 15%;
    transform: rotate(18deg);
    animation-delay: 0.7s;
  }

  .map-route-4 {
    left: 50%;
    top: 34%;
    width: 15%;
    height: 18%;
    transform: rotate(-8deg);
    animation-delay: 1s;
  }

  .office-pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 4;
    transform: translate(-50%, -50%);
  }

  .office-pin:hover {
    z-index: 8;
  }

  .pin-core {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.15rem;
    height: 1.15rem;
    border: 2px solid rgba(255, 255, 255, 0.86);
    border-radius: 999px;
    background: linear-gradient(135deg, #b68cff, #7a34ff);
    box-shadow: 0 0 1.4rem rgba(138, 77, 255, 1), 0 0 3rem rgba(138, 77, 255, 0.46);
    transform: translate(-50%, -50%);
    transition: border-color 220ms ease, background 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .pin-pulse {
    position: absolute;
    left: 0;
    top: 0;
    width: 4.2rem;
    height: 4.2rem;
    border: 1px solid rgba(174, 124, 255, 0.7);
    border-radius: 999px;
    transform: translate(-50%, -50%);
    animation: pinPulse 2.4s ease-out infinite;
    transition: border-color 220ms ease, opacity 220ms ease;
  }

  .pin-label {
    position: absolute;
    left: 0.9rem;
    top: -3.6rem;
    display: grid;
    gap: 0.12rem;
    min-width: 132px;
    border: 1px solid rgba(176, 132, 255, 0.45);
    border-radius: 8px;
    padding: 0.65rem 0.78rem;
    background: rgba(8, 8, 18, 0.84);
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.25), 0 0 1.8rem rgba(138, 77, 255, 0.13);
    backdrop-filter: blur(14px);
    transform-origin: left bottom;
    transition: border-color 220ms ease, background 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .office-pin:hover .pin-core {
    border-color: #fff;
    background: linear-gradient(135deg, #fff 0%, #cdb4ff 38%, #7a34ff 100%);
    box-shadow:
      0 0 1.8rem rgba(255, 255, 255, 0.72),
      0 0 3.8rem rgba(138, 77, 255, 0.9),
      0 0 0 0.65rem rgba(138, 77, 255, 0.18);
    transform: translate(-50%, -50%) scale(1.32);
  }

  .office-pin:hover .pin-pulse {
    border-color: rgba(255, 255, 255, 0.9);
    opacity: 0.95;
    animation-duration: 1.2s;
  }

  .office-pin:hover .pin-label {
    border-color: rgba(207, 178, 255, 0.82);
    background: rgba(12, 10, 26, 0.94);
    box-shadow:
      0 1.2rem 2.7rem rgba(0, 0, 0, 0.34),
      0 0 2.8rem rgba(138, 77, 255, 0.42),
      inset 0 0 1.4rem rgba(176, 132, 255, 0.12);
    transform: translate3d(0, -0.55rem, 0) scale(1.04);
  }

  .pin-label strong {
    color: #fff;
    font-size: 1.02rem;
    line-height: 1;
  }

  .pin-label small {
    color: var(--purple-soft);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .office-casablanca .pin-label {
    top: 1.1rem;
    left: -7.4rem;
  }

  .office-dubai .pin-label {
    top: 1rem;
  }

  .agency-approach,
  .agency-studio,
  .agency-history,
  .agency-references,
  .agency-cta {
    margin-top: clamp(3.4rem, 6vw, 5.2rem);
  }

  .agency-approach {
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
    gap: 2.2rem;
    align-items: start;
  }

  .section-intro h2,
  .studio-copy h2 {
    max-width: 28rem;
    font-size: clamp(2.2rem, 4.2vw, 3.55rem);
    line-height: 1.03;
  }

  .section-intro p {
    max-width: 22rem;
    margin: 1.1rem 0 0;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .approach-grid article {
    min-height: 18rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 2.1rem 1.7rem;
    background:
      radial-gradient(circle at 82% 12%, rgba(124, 60, 255, 0.28), transparent 42%),
      var(--panel);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .approach-grid article:hover {
    border-color: rgba(185, 133, 255, 0.42);
    box-shadow: 0 1.2rem 3rem rgba(124, 60, 255, 0.12);
    transform: translateY(-4px);
  }

  .approach-grid span {
    display: block;
    margin-top: 0.35rem;
    color: var(--purple-soft);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 900;
  }

  .approach-grid h3 {
    margin: 2.1rem 0 0.8rem;
    color: #fff;
    font-size: 1.35rem;
  }

  .approach-grid p,
  .value-grid p,
  .history-timeline p {
    color: rgba(232, 237, 245, 0.68);
    line-height: 1.65;
  }

  .agency-studio {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(520px, 1.22fr);
    gap: 3rem;
    align-items: center;
  }

  .studio-copy > p {
    max-width: 31rem;
    margin: 1.1rem 0 0;
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.2rem;
  }

  .value-grid i {
    display: block;
    margin-bottom: 0.8rem;
  }

  .value-grid strong {
    color: #fff;
    font-size: 0.92rem;
  }

  .value-grid p {
    margin: 0.45rem 0 0;
    font-size: 0.76rem;
  }

  .studio-media {
    position: relative;
    min-height: 28rem;
    perspective: 1200px;
    isolation: isolate;
  }

  .studio-media::before {
    position: absolute;
    inset: 12% 8% 8% 18%;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(124, 60, 255, 0.28), transparent 62%);
    content: "";
    opacity: 0;
    filter: blur(18px);
    transform: scale(0.82);
    transition: opacity 360ms ease, transform 520ms ease;
  }

  .studio-media img {
    position: absolute;
    border: 1px solid var(--line);
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 1.3rem 3.5rem rgba(0, 0, 0, 0.32);
    transform: translateZ(0);
    transition:
      transform 520ms cubic-bezier(.2,.8,.2,1),
      border-color 320ms ease,
      box-shadow 320ms ease,
      filter 320ms ease;
    will-change: transform;
  }

  .studio-main {
    left: 0;
    bottom: 2rem;
    width: 58%;
    height: 63%;
  }

  .studio-small-top {
    right: 14%;
    top: 1rem;
    width: 36%;
    height: 31%;
  }

  .studio-small-bottom {
    right: 0;
    bottom: 1.1rem;
    width: 43%;
    height: 36%;
  }

  .studio-floating {
    position: absolute;
    right: 16%;
    bottom: 0;
    z-index: 2;
    display: inline-flex;
    max-width: 15rem;
    align-items: end;
    gap: 0.9rem;
    border: 1px solid rgba(185, 133, 255, 0.35);
    border-radius: 8px;
    padding: 1.05rem 1.15rem;
    background: linear-gradient(135deg, rgba(124, 60, 255, 0.7), rgba(54, 28, 100, 0.9));
    color: #fff;
    font-weight: 800;
    line-height: 1.4;
    text-decoration: none;
    box-shadow: 0 1rem 2.2rem rgba(75, 35, 180, 0.24);
    transform: translateZ(0);
    transition:
      transform 420ms cubic-bezier(.2,.8,.2,1),
      border-color 280ms ease,
      box-shadow 280ms ease,
      background 280ms ease;
  }

  .studio-floating i {
    transition: transform 260ms ease;
  }

  .studio-media:hover::before,
  .studio-media:focus-within::before {
    opacity: 1;
    transform: scale(1);
  }

  .studio-media:hover img,
  .studio-media:focus-within img {
    border-color: rgba(185, 133, 255, 0.42);
    filter: saturate(1.08) contrast(1.04);
  }

  .studio-media:hover .studio-main,
  .studio-media:focus-within .studio-main {
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.38), 0 0 2.4rem rgba(124, 60, 255, 0.14);
    transform: translate3d(-0.45rem, -0.35rem, 0) rotate(-1.2deg) scale(1.018);
  }

  .studio-media:hover .studio-small-top,
  .studio-media:focus-within .studio-small-top {
    box-shadow: 0 1.3rem 3.2rem rgba(0, 0, 0, 0.36), 0 0 2rem rgba(124, 60, 255, 0.18);
    transform: translate3d(0.45rem, -0.7rem, 0) rotate(1.8deg) scale(1.035);
  }

  .studio-media:hover .studio-small-bottom,
  .studio-media:focus-within .studio-small-bottom {
    box-shadow: 0 1.3rem 3.2rem rgba(0, 0, 0, 0.36), 0 0 2rem rgba(124, 60, 255, 0.16);
    transform: translate3d(0.65rem, 0.25rem, 0) rotate(1.1deg) scale(1.025);
  }

  .studio-media:hover .studio-floating,
  .studio-media:focus-within .studio-floating,
  .studio-floating:hover,
  .studio-floating:focus-visible {
    border-color: rgba(220, 194, 255, 0.58);
    background: linear-gradient(135deg, rgba(147, 86, 255, 0.88), rgba(60, 28, 116, 0.94));
    box-shadow: 0 1.2rem 2.6rem rgba(75, 35, 180, 0.34), 0 0 2.2rem rgba(124, 60, 255, 0.22);
    transform: translate3d(0.25rem, -0.55rem, 0) scale(1.025);
  }

  .studio-floating:hover i,
  .studio-floating:focus-visible i,
  .studio-media:hover .studio-floating i,
  .studio-media:focus-within .studio-floating i {
    transform: translate(0.2rem, -0.2rem);
  }

  .agency-history {
    display: grid;
    grid-template-columns: minmax(15rem, 0.6fr) minmax(0, 1.4fr);
    gap: 2.6rem;
    align-items: start;
  }

  .history-timeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .history-timeline li {
    position: relative;
    padding-top: 1rem;
    opacity: 0;
    transform: translateY(1rem);
    animation: historyItemIn 720ms cubic-bezier(.2,.8,.2,1) forwards;
    animation-delay: calc(220ms + var(--history-delay, 0ms));
    transition: filter 260ms ease, translate 260ms ease;
    will-change: filter, translate;
  }

  .history-timeline li::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(185, 133, 255, 0.8), rgba(185, 133, 255, 0.18));
    background-position: 100% 0;
    background-size: 190% 100%;
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    animation: historyLineIn 820ms cubic-bezier(.2,.8,.2,1) forwards;
    animation-delay: calc(420ms + var(--history-delay, 0ms));
    transition: background-position 460ms ease, box-shadow 260ms ease, height 260ms ease;
  }

  .history-timeline li::before {
    position: absolute;
    top: -0.42rem;
    left: 0;
    width: 0.78rem;
    height: 0.78rem;
    border-radius: 999px;
    background: var(--purple);
    box-shadow: 0 0 0 0.32rem rgba(124, 60, 255, 0.18);
    content: "";
    z-index: 1;
    opacity: 0;
    transform: scale(0.55);
    animation: historyDotIn 620ms cubic-bezier(.2,.8,.2,1) forwards, historyDotPulse 2200ms ease-in-out infinite;
    animation-delay: calc(560ms + var(--history-delay, 0ms)), calc(1250ms + var(--history-delay, 0ms));
    transition: background 260ms ease, box-shadow 260ms ease, scale 260ms ease;
  }

  .history-timeline time {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 900;
    transition: color 240ms ease, text-shadow 240ms ease, translate 240ms ease;
  }

  .history-timeline strong {
    display: block;
    margin-top: 0.45rem;
    color: #fff;
    line-height: 1.35;
    transition: color 240ms ease, translate 240ms ease;
  }

  .history-timeline p {
    margin: 0.45rem 0 0;
    font-size: 0.82rem;
    transition: color 240ms ease, translate 240ms ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .history-timeline:hover li:not(:hover) {
      filter: saturate(0.7) brightness(0.72);
    }

    .history-timeline li:hover {
      filter: drop-shadow(0 1.2rem 2.6rem rgba(0, 0, 0, 0.28));
      translate: 0 -0.36rem;
    }

    .history-timeline li:hover::after {
      height: 2px;
      background-image: linear-gradient(90deg, #8b4dff 0%, #d8c4ff 42%, rgba(185, 133, 255, 0.2) 100%);
      background-position: 0 0;
      box-shadow: 0 0 1.4rem rgba(139, 77, 255, 0.72);
    }

    .history-timeline li:hover::before {
      background: linear-gradient(135deg, #ffffff 0%, #cdb4ff 38%, #8b4dff 100%);
      box-shadow:
        0 0 0 0.5rem rgba(124, 60, 255, 0.2),
        0 0 1.2rem rgba(255, 255, 255, 0.5),
        0 0 2.4rem rgba(124, 60, 255, 0.72);
      scale: 1.28;
    }

    .history-timeline li:hover time {
      color: #fff;
      text-shadow: 0 0 1.1rem rgba(139, 77, 255, 0.48);
      translate: 0 -0.06rem;
    }

    .history-timeline li:hover strong,
    .history-timeline li:hover p {
      translate: 0 -0.04rem;
    }

    .history-timeline li:hover p {
      color: rgba(232, 237, 245, 0.86);
    }
  }

  @keyframes historyItemIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes historyLineIn {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes historyDotIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes historyDotPulse {
    0%, 100% {
      box-shadow: 0 0 0 0.32rem rgba(124, 60, 255, 0.18), 0 0 0 rgba(124, 60, 255, 0);
    }
    50% {
      box-shadow: 0 0 0 0.42rem rgba(124, 60, 255, 0.24), 0 0 1.4rem rgba(124, 60, 255, 0.32);
    }
  }

  .agency-references h2 {
    max-width: 46rem;
    margin-bottom: 1.2rem;
    font-size: clamp(1.55rem, 3vw, 2.35rem);
  }

  .reference-strip {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(10, 11, 20, 0.72);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .reference-track {
    display: flex;
    width: max-content;
    gap: 0.85rem;
    padding: 1rem;
