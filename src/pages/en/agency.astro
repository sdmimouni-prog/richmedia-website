  }

  .reference-strip figure {
    display: grid;
    width: clamp(9.5rem, 12vw, 12rem);
    height: 5.6rem;
    flex: 0 0 auto;
    place-items: center;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
    transition:
      transform 0.32s ease,
      border-color 0.32s ease,
      background 0.32s ease,
      box-shadow 0.32s ease;
  }

  .reference-strip figure:hover {
    transform: translateY(-0.35rem);
    border-color: rgba(185, 133, 255, 0.42);
    background: rgba(124, 60, 255, 0.1);
    box-shadow: 0 1rem 2.2rem rgba(124, 60, 255, 0.18);
  }

  .reference-strip img {
    width: 76%;
    max-height: 3.45rem;
    object-fit: contain;
    filter: grayscale(1) brightness(1.2) contrast(0.96);
    opacity: 0.82;
    transition:
      transform 0.32s ease,
      filter 0.32s ease,
      opacity 0.32s ease;
  }

  .reference-strip figure:hover img {
    transform: scale(1.06);
    filter: grayscale(0) brightness(1.08) contrast(1);
    opacity: 1;
  }

  @keyframes agencyReferenceSlide {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes pinPulse {
    0% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(0.32);
    }
    80%,
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.18);
    }
