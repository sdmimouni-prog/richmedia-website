---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyModel from '../../../components/CaseStudyModel.astro';
import { SITE } from '../../../consts';
import { articleSchema, breadcrumbs } from '../../../lib/schema';

const pageUrl = `${SITE.url}/en/case-studies/uir-acquisition-campaign-2023-2024`;
const assetBase = '/assets/richmedia-case-study';
const uirProofBase = `${assetBase}/uir-acquisition-2023-2024`;
const publishedAt = new Date('2026-08-23T00:00:00.000Z');
const pageTitle = 'UIR Acquisition Campaign 2023/2024 | Richmedia';
const pageDescription =
  'See how Richmedia supported UIR with a full-funnel multichannel strategy generating 70,000 leads across Bachelor, Master and Continuing Education.';

const content = {
  backHref: '/en/case-studies',
  backLabel: 'Case studies',
  eyebrow: 'A full-funnel approach built to turn student demand into qualified leads.',
  client: 'UIR',
  clientLong: 'UIR — International University of Rabat',
  category: 'Education',
  period: '2023–2024',
  scope: 'Meta Ads / Google Search / Performance Max / YouTube / LinkedIn Ads / WhatsApp / Emailing / CRM',
  title: 'The Result',
  subtitle:
    'For the 2023/2024 acquisition campaign of the International University of Rabat, Richmedia deployed a full-funnel system designed to accelerate applications, recruit new students and support priority programs in Morocco and Sub-Saharan Africa.',
  heroImage: `${assetBase}/result-hero-clean-hq.webp`,
  metaItems: [
    { label: 'Client', value: 'UIR — International University of Rabat' },
    { label: 'Sector', value: 'Education' },
    { label: 'Period', value: '2023–2024' },
    { label: 'Region', value: 'Morocco + Sub-Saharan Africa' },
    { label: 'Channels', value: 'Meta / Google Search / PMax / YouTube / LinkedIn / WhatsApp / Email / CRM' },
    { label: 'Budget', value: 'Confidential' },
  ],
  metrics: [
    { value: '70,000', label: 'leads generated', icon: 'ph ph-users' },
    { value: '40,000', label: 'Bachelor leads', note: 'CPL 20–40 MAD', noteTrend: false, icon: 'ph ph-graduation-cap' },
    { value: '25,000', label: 'Master leads', note: 'CPL 30–70 MAD', noteTrend: false, icon: 'ph ph-shield-check' },
    { value: '5,000', label: 'Continuing Ed. / MBA', note: 'CPL 40–120 MAD', noteTrend: false, icon: 'ph ph-briefcase' },
  ],
  deliverables: [
    'Acquisition strategy',
    'Multichannel media plan',
    'Audience segmentation',
    'Creative adaptation',
    'Dedicated landing pages',
    'Tracking & optimization',
    'Retargeting',
    'WhatsApp / CRM',
    'Performance reporting',
  ],
  work: [
    {
      eyebrow: '01',
      title: 'Funnel & segmentation',
      text: 'Full-funnel strategy and segmentation by audience.',
      bullets: [
        'Full-funnel strategy: desire, acquisition, conversion.',
        'Separate campaigns for Bachelor, Master and Continuing Education / MBA.',
        'Targeting across Morocco and Sub-Saharan Africa.',
      ],
      icon: 'ph ph-funnel',
    },
    {
      eyebrow: '02',
      title: 'Dedicated messages & journeys',
      text: 'Adaptation by audience, program and level of intent.',
      bullets: [
        'Messages adapted by target audience and program.',
        'Dedicated landing pages by segment.',
        'Differentiated journeys based on intent level.',
      ],
      icon: 'ph ph-path',
    },
    {
      eyebrow: '03',
      title: 'Multichannel deployment',
      text: 'Media activation across priority channels.',
      bullets: [
        'Meta Ads, Google Search, Performance Max and YouTube.',
        'LinkedIn Ads for advanced audiences.',
        'Lookalike and retargeting to amplify warm signals.',
      ],
      icon: 'ph ph-megaphone',
    },
    {
      eyebrow: '04',
      title: 'Follow-up & conversion',
      text: 'Handling warm audiences after lead generation.',
      bullets: [
        'Search to capture the most qualified leads.',
        'Retargeting on warm audiences.',
        'WhatsApp, emailing and CRM to follow up and convert.',
      ],
      icon: 'ph ph-chat-circle-dots',
    },
  ],
  proof: {
    eyebrow: 'Block 3',
    title: 'The Proof',
	    intro: 'A selection of real visuals from the UIR acquisition campaign.',
	    items: [
	      { image: `${assetBase}/proof-social-feed.webp`, label: 'Enrollment opening', format: 'Social feed', size: 'feed' as const },
	      { image: `${assetBase}/proof-story.webp`, label: 'Bachelor 2023–2024', format: 'Vertical story', size: 'story' as const },
	      { image: `${assetBase}/proof-banner.webp`, label: 'UIR entrance campaign', format: 'Banner', size: 'banner' as const },
	      { image: `${uirProofBase}/uir-caravane-orientation-tanger.webp`, label: 'UIR orientation caravan in Tangier', format: 'Campaign creative', size: 'dashboard' as const },
	      { image: `${assetBase}/proof-event.webp`, label: 'Orientation caravan', format: 'Activation', size: 'event' as const },
	      { image: `${assetBase}/proof-engineering.webp`, label: 'Priority program', format: 'Vertical format', size: 'engineering' as const },
	      { image: `${assetBase}/proof-parcours.webp`, label: 'Dedicated journey', format: 'Vertical format', size: 'parcours' as const },
	      { image: `${assetBase}/proof-ready.png`, label: 'Enrollment campaign', format: 'Vertical format', size: 'ready' as const },
	      { image: `${uirProofBase}/uir-inscriptions-ouvertes-concours.webp`, label: 'UIR entrance registrations open', format: 'Campaign creative', size: 'landing' as const },
	      { image: `${uirProofBase}/uir-concours-medecine-dentaire.webp`, label: 'Medicine and dental medicine entrance exam', format: 'Entrance campaign creative', size: 'quote' as const },
	    ],
    kpi: {
      value: '70,000',
      label: 'leads generated',
      breakdown: ['40K Bachelor', '25K Master', '5K Continuing Education'],
      note: 'Search = most qualified leads',
    },
    conclusion:
      'The system’s performance relied on three levers working together: clear audience segmentation, dedicated journeys by program and continuous conversion steering after lead generation.',
    links: [
      { href: '/en/sectors/education/', label: 'Education sector' },
      { href: '/en/expertises/lead-generation-morocco/', label: 'Lead generation' },
      { href: '/en/expertises/google-ads-morocco/', label: 'Google Ads' },
      { href: '/en/expertises/meta-ads-morocco/', label: 'Meta Ads' },
      { href: '/en/expertises/whatsapp-marketing-morocco/', label: 'WhatsApp Marketing' },
    ],
  },
  quote:
    'Performance comes from segmentation, dedicated journeys and continuous steering after lead generation.',
  ctaLabel: 'Speak to an expert',
  ctaHref: '/en/contact',
  secondaryLabel: 'See Education expertise',
  secondaryHref: '/en/sectors/education/',
  ui: {
    resultsLabel: 'Case study results',
    metaLabel: 'Case study summary',
    workLabel: 'Block 2',
    workTitle: 'What We Did',
    proofLabel: 'Visual proof',
    quoteLabel: 'Case study internal links',
    deliverablesTitle: 'Deliverables',
  },
};

const schema = [
  articleSchema({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    author: 'Richmedia',
    authorType: 'Organization',
    datePublished: publishedAt,
    dateModified: publishedAt,
    image: `${SITE.url}${content.heroImage}`,
  }),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Case studies', url: `${SITE.url}/en/case-studies` },
    { name: 'UIR Acquisition Campaign 2023/2024', url: pageUrl },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${content.heroImage}`}
  lang="en"
  schema={schema}
>
  <CaseStudyModel content={content} />
</BaseLayout>
