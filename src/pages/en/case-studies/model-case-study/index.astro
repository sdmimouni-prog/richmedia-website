const schema = [
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Case studies', url: `${SITE.url}/en/case-studies` },
    { name: 'Case study model', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="UIR Admissions Case Study Model | Richmedia"
  description="Explore a Richmedia case study page model around UIR admissions, with result, method and visual proof blocks."
  canonical={pageUrl}
  ogImage={`${SITE.url}${content.heroImage}`}
  lang="en"
  schema={schema}
>
  <CaseStudyModel content={content} />
</BaseLayout>
