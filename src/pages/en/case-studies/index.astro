const heroSliderCases = caseStudies.slice(0, 4);
const featuredCase = caseStudies[1];
const caseLoop = [...caseStudies.slice(0, 10), ...caseStudies.slice(0, 10)];
---
<BaseLayout
  title="Richmedia Case Studies — Campaigns, digital activations and measurable growth"
  description={pageDescription}
  canonical={`${SITE.url}/en/case-studies`}
  lang="en"
  schema={schema}
>
  <div class="realisations-page">
    <section class="works-hero" aria-labelledby="works-title">
      <div class="works-hero-copy">
        <span class="section-kicker">Portfolio Richmedia</span>
        <h1 id="works-title">Our <span>case studies.</span></h1>
        <p>
          A selection of campaigns, field activations and brand assets designed to be measured,
          documented and reused as proof of growth.
        </p>
        <div class="works-actions">
          <a class="button button-primary" href="#case-board">
            Explore case studies
            <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/contact">
            Discuss a project
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-showcase" data-featured-slider aria-label="Richmedia case studies preview">
        <article class="featured-work">
          <a data-featured-link href={featuredCase.href ?? `/en/case-studies#${featuredCase.slug}`} aria-label={`View the ${featuredCase.client} case study - ${featuredCase.title}`}>
            <figure>
              <img data-featured-image src={featuredCase.image} alt={`${featuredCase.client} — ${featuredCase.title}`} loading="eager" decoding="async" />
            </figure>
            <div class="featured-work-copy">
              <span>Featured case</span>
              <h2 data-featured-title>{featuredCase.title}</h2>
              <p data-featured-summary>An urban media format turned into a visible, memorable and measurable brand presence.</p>
              <dl>
                <div>
                  <dt>Client</dt>
                  <dd data-featured-client>{featuredCase.client}</dd>
                </div>
                <div>
                  <dt>Visibility</dt>
                  <dd data-featured-visibility>{featuredCase.visibility}</dd>
                </div>
                <div>
                  <dt>Engagement</dt>
                  <dd data-featured-engagement>{featuredCase.engagement}</dd>
                </div>
              </dl>
            </div>
          </a>
        </article>

        <div class="hero-mini-grid" aria-label="Change the featured case study">
          {heroSliderCases.map((item) => (
            <button
              type="button"
              class:list={['hero-mini-card', item.slug === featuredCase.slug && 'is-active']}
              data-featured-thumb
              data-slug={item.slug}
              data-client={item.client}
              data-title={item.title}
              data-summary={`${item.type} for ${item.client}, designed to create visible and measurable proof of growth.`}
              data-image={item.image}
              data-href={item.href ?? `/en/case-studies#${item.slug}`}
              data-visibility={item.visibility}
              data-engagement={item.engagement}
              aria-pressed={item.slug === featuredCase.slug ? 'true' : 'false'}
            >
              <img src={item.image} alt="" loading="eager" decoding="async" />
              <span class="hero-mini-caption">
                <strong>{item.client}</strong>
                <span>{item.category}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="proof-strip" aria-label="Portfolio indicators">
      {featuredStats.map((stat) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </section>

    <section class="case-board" id="case-board" aria-labelledby="case-board-title">
      <div class="case-board-head">
        <div>
          <span class="section-kicker">Case study board</span>
          <h2 id="case-board-title">Latest case studies</h2>
        </div>
        <div class="category-pills" aria-label="Case study categories">
          {categories.map((category) => <span>{category}</span>)}
        </div>
      </div>

      <div class="work-grid">
        {caseStudies.map((item) => (
          <article
            id={item.slug}
            class:list={['work-card', `work-card-${item.format}`, `work-accent-${item.accent}`]}
            data-case-slug={item.slug}
          >
            <a href={item.href ?? `/en/case-studies#${item.slug}`} aria-label={`View the ${item.client} case study - ${item.title}`}>
              <div class="work-media">
                <img class="media-main" src={item.image} alt={`${item.client} — ${item.title}`} loading="lazy" decoding="async" />
              </div>
              <div class="work-copy">
                <div class="work-topline">
                  <span>{item.category}</span>
                  <small>{item.year}</small>
                </div>
                <h3>{item.client}</h3>
                <p>{item.title}</p>
                <dl>
                  <div>
                    <dt>Type</dt>
                    <dd>{item.type}</dd>
                  </div>
                  <div>
                    <dt>Visibility</dt>
                    <dd>{item.visibility}</dd>
                  </div>
                  <div>
                    <dt>Engagement</dt>
                    <dd>{item.engagement}</dd>
                  </div>
                </dl>
                <strong class="case-status">{item.status}</strong>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="case-marquee" aria-label="Campaign film">
      <div class="case-marquee-head">
        <span class="section-kicker">Campaign film</span>
      </div>
      <div class="case-marquee-window">
        <div class="case-marquee-track">
          {caseLoop.map((item) => (
            <figure class:list={['marquee-frame', `marquee-frame-${item.format}`]}>
              <img src={item.image} alt="" loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="case-method" aria-labelledby="case-method-title">
      <div>
        <span class="section-kicker">Case study format</span>
        <h2 id="case-method-title">Case study format.</h2>
      </div>
      <div class="method-grid">
        <article>
          <span>01</span>
          <h3>Context & objective</h3>
          <p>The business issue, target audience, timing and client constraints.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Setup & channels</h3>
          <p>The creative concept, formats, media, field activation or CRM journey.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Results & learnings</h3>
          <p>The key metrics, insights and the next logical step to scale.</p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  type FeaturedCasePayload = {
    client: string;
    title: string;
    summary: string;
    image: string;
    href: string;
    visibility: string;
    engagement: string;
  };

  const initFeaturedCaseSlider = () => {
    const sliders = document.querySelectorAll('[data-featured-slider]');

    sliders.forEach((slider) => {
      if (!(slider instanceof HTMLElement) || slider.dataset.sliderReady === 'true') return;
      slider.dataset.sliderReady = 'true';

      const link = slider.querySelector('[data-featured-link]');
      const image = slider.querySelector('[data-featured-image]');
      const title = slider.querySelector('[data-featured-title]');
      const summary = slider.querySelector('[data-featured-summary]');
      const client = slider.querySelector('[data-featured-client]');
      const visibility = slider.querySelector('[data-featured-visibility]');
      const engagement = slider.querySelector('[data-featured-engagement]');
      const thumbs = [...slider.querySelectorAll('[data-featured-thumb]')];
      const featured = slider.querySelector('.featured-work');

      const setActiveCase = (button: Element) => {
        if (!(button instanceof HTMLButtonElement)) return;

        const next: FeaturedCasePayload = {
          client: button.dataset.client || '',
          title: button.dataset.title || '',
          summary: button.dataset.summary || '',
          image: button.dataset.image || '',
          href: button.dataset.href || '#',
          visibility: button.dataset.visibility || '',
          engagement: button.dataset.engagement || '',
        };

        featured?.classList.add('is-switching');

        window.setTimeout(() => {
          if (link instanceof HTMLAnchorElement) {
            link.href = next.href;
            link.setAttribute('aria-label', `View the ${next.client} case study - ${next.title}`);
          }

          if (image instanceof HTMLImageElement) {
            image.src = next.image;
            image.alt = `${next.client} — ${next.title}`;
          }

          if (title) title.textContent = next.title;
          if (summary) summary.textContent = next.summary;
          if (client) client.textContent = next.client;
          if (visibility) visibility.textContent = next.visibility;
          if (engagement) engagement.textContent = next.engagement;

          thumbs.forEach((thumb) => {
            const isActive = thumb === button;
            thumb.classList.toggle('is-active', isActive);
            if (thumb instanceof HTMLElement) {
              thumb.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            }
          });

          window.setTimeout(() => featured?.classList.remove('is-switching'), 90);
        }, 120);
      };

      thumbs.forEach((button) => {
        button.addEventListener('click', () => setActiveCase(button));
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeaturedCaseSlider, { once: true });
  } else {
    initFeaturedCaseSlider();
  }
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .realisations-page {
    --container: min(100% - 3rem, 1320px);
    --purple: #7c3cff;
    --purple-soft: #a46cff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.68);
    overflow: hidden;
    background:
      radial-gradient(circle at 14% 12%, rgba(124, 60, 255, 0.22), transparent 26rem),
      radial-gradient(circle at 88% 8%, rgba(124, 60, 255, 0.18), transparent 24rem),
      linear-gradient(180deg, #030407 0%, #050507 56%, #020306 100%);
    color: #fff;
  }

  .realisations-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 68px 68px;
    content: "";
    pointer-events: none;
  }

  .works-hero,
  .proof-strip,
  .case-board,
  .case-marquee,
  .case-method {
    position: relative;
    z-index: 1;
    width: var(--container);
    margin-inline: auto;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-soft);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.1rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .works-hero {
    display: grid;
    grid-template-columns: minmax(340px, 0.78fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.8vw, 4.75rem);
    align-items: center;
    min-height: 760px;
    padding: 8.4rem 0 3.5rem;
  }

  .works-hero-copy {
    min-width: 0;
  }

  .works-hero h1 {
    max-width: 650px;
    margin: 1.15rem 0 0;
    --h1-size: clamp(3.2rem, 5.4vw, 5.9rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .works-hero h1 span {
    color: var(--purple);
  }

  .works-hero p {
    max-width: 560px;
    margin: 1.35rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.22vw, 1.14rem);
    line-height: 1.58;
  }

  .works-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.05rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1.25rem;
    color: #fff;
    font-weight: 850;
    text-decoration: none;
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-showcase {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .featured-work {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    background:
      radial-gradient(circle at 20% 0%, rgba(124, 60, 255, 0.18), transparent 18rem),
      rgba(255, 255, 255, 0.035);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.45);
    transition: border-color 240ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .featured-work.is-switching {
    border-color: rgba(124, 60, 255, 0.48);
    opacity: 0.82;
    transform: translateY(2px);
  }

  .featured-work a {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
    min-height: 420px;
    color: inherit;
    text-decoration: none;
  }

  .featured-work figure {
    position: relative;
    min-height: 100%;
    margin: 0;
    overflow: hidden;
    background: #050507;
  }

  .featured-work img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .featured-work:hover img {
    transform: scale(1.035);
  }

  .featured-work-copy {
    display: grid;
    align-content: end;
    gap: 0.9rem;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    padding: clamp(1.1rem, 2vw, 1.55rem);
    background:
      linear-gradient(145deg, rgba(124, 60, 255, 0.18), transparent 46%),
      rgba(3, 3, 6, 0.9);
  }

  .featured-work-copy > span {
    color: var(--purple-soft);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured-work-copy h2 {
    margin: 0;
    max-width: 100%;
    --h2-size: clamp(1.45rem, 2.25vw, 2.25rem);
    font-size: var(--h2-size);
    font-weight: 850;
    line-height: 1.02;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .featured-work-copy p {
    margin: 0;
    max-width: 34rem;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  .featured-work-copy dl {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
    margin: 0.35rem 0 0;
  }

  .featured-work-copy dl div {
    border-left: 2px solid var(--purple);
    padding-left: 0.65rem;
  }

  .featured-work-copy dt,
  .work-copy dt {
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-work-copy dd,
  .work-copy dd {
    margin: 0.25rem 0 0;
    color: #fff;
    font-size: 0.83rem;
    font-weight: 850;
    line-height: 1.25;
  }

  .hero-mini-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .hero-mini-card {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: border-color 240ms ease, box-shadow 240ms ease, transform 240ms ease;
  }

  .hero-mini-card:hover,
  .hero-mini-card:focus-visible {
    border-color: rgba(124, 60, 255, 0.72);
    box-shadow: 0 0 0 1px rgba(124, 60, 255, 0.2), 0 1rem 2.2rem rgba(0, 0, 0, 0.32);
    outline: 0;
