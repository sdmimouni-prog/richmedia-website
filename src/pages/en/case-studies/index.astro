---
<BaseLayout
  title="Digital Case Studies in Morocco | Richmedia"
  description={pageDescription}
  canonical={`${SITE.url}/en/case-studies`}
  lang="en"
  schema={schema}
>
  <div class="realisations-page">
    <section class="works-hero" aria-labelledby="works-title">
      <div class="works-hero-copy">
        <span class="section-kicker">Portfolio Richmedia</span>
        <h1 id="works-title">Our <span>case studies.</span></h1>
        <p>
          A selection of campaigns, field activations and brand assets designed to be measured,
          documented and reused as proof of growth.
        </p>
        <div class="works-actions">
          <a class="button button-primary" href="#case-board">
            Explore case studies
            <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/en/contact">
            Discuss a project
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-showcase" data-featured-slider aria-label="Richmedia case studies preview">
        <article class="featured-work">
          <div class="featured-work-frame" aria-label={`${featuredCase.client} - ${featuredCase.title}`}>
            <figure>
              <img
                data-featured-image
                src={featuredCase.image}
                alt={`${featuredCase.client} — ${featuredCase.title}`}
                width={getCaseImageDimensions(featuredCase.image).width}
                height={getCaseImageDimensions(featuredCase.image).height}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </figure>
            <div class="featured-work-copy">
              <span>Featured case</span>
              <h2 data-featured-title>{featuredCase.title}</h2>
              <p data-featured-summary>An urban media format turned into a visible, memorable and measurable brand presence.</p>
              <dl>
                <div>
                  <dt>Client</dt>
                  <dd data-featured-client>{featuredCase.client}</dd>
                </div>
                <div>
                  <dt>Visibility</dt>
                  <dd data-featured-visibility>{featuredCase.visibility}</dd>
                </div>
                <div>
                  <dt>Engagement</dt>
                  <dd data-featured-engagement>{featuredCase.engagement}</dd>
                </div>
              </dl>
            </div>
          </div>
        </article>

        <div class="hero-mini-grid" aria-label="Featured case studies preview">
          {heroSliderCases.map((item) => (
            <article
              class:list={['hero-mini-card', item.slug === featuredCase.slug && 'is-active']}
            >
              <img
                src={item.image}
                alt=""
                width={getCaseImageDimensions(item.image).width}
                height={getCaseImageDimensions(item.image).height}
                loading="eager"
                decoding="async"
              />
              <span class="hero-mini-caption">
                <strong>{item.client}</strong>
                <span>{item.category}</span>
              </span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <nav class="mobile-page-nav" aria-label="Case studies page navigation">
      {quickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="proof-strip" id="case-proof" aria-label="Portfolio indicators">
      {featuredStats.map((stat) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </section>

    <section class="case-board" id="case-board" aria-labelledby="case-board-title" data-case-board>
      <div class="case-board-head">
        <div>
          <span class="section-kicker">Case study board</span>
          <h2 id="case-board-title">Latest case studies</h2>
        </div>
        <div class="category-pills" aria-label="Filter case studies">
          {categories.map((category, index) => (
            <button
              type="button"
              class:list={[index === 0 && 'is-active']}
              data-case-filter={category}
              data-case-filter-all={index === 0 ? 'true' : 'false'}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="work-grid">
        {caseStudies.map((item) => (
          <article
            id={item.slug}
            class:list={['work-card', `work-card-${item.format}`, `work-accent-${item.accent}`]}
            data-case-slug={item.slug}
            data-case-category={item.category}
          >
            <div class="work-card-body">
              <div class="work-media">
                <img
                  class="media-main"
                  src={item.image}
                  alt={`${item.client} — ${item.title}`}
                  width={getCaseImageDimensions(item.image).width}
                  height={getCaseImageDimensions(item.image).height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="work-copy">
                <div class="work-topline">
                  <span>{item.category}</span>
                  <small>{item.year}</small>
                </div>
                <h3>{item.client}</h3>
                <p>{item.title}</p>
                <dl>
                  <div>
                    <dt>Type</dt>
                    <dd>{item.type}</dd>
                  </div>
                  <div>
                    <dt>Visibility</dt>
                    <dd>{item.visibility}</dd>
                  </div>
                  <div>
                    <dt>Engagement</dt>
                    <dd>{item.engagement}</dd>
                  </div>
                </dl>
                {item.status && <strong class="case-status">{item.status}</strong>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <SeoSiloLinks
      title="Connect case studies to expertises"
      intro="These campaigns combine complementary levers: content, media, automation, industries and measurement."
      links={enSiloLinks.casesHub}
    />

    <CaseProofLinks
      eyebrow="Proof & case studies"
      title="Each proof connects to the right silo"
      intro="Each Richmedia case study points to its industry, main expertise and contact path so proof becomes the next growth system."
      cases={proofCaseLinksEn}
    />

    <section class="case-marquee" id="case-film" aria-label="Campaign film">
      <div class="case-marquee-head">
        <span class="section-kicker">Campaign film</span>
      </div>
      <div class="case-marquee-window">
        <div class="case-marquee-track">
          {caseLoop.map((item) => (
            <figure class:list={['marquee-frame', `marquee-frame-${item.format}`]}>
              <img
                src={item.image}
                alt=""
                width={getCaseImageDimensions(item.image).width}
                height={getCaseImageDimensions(item.image).height}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="case-cta" id="case-cta" aria-labelledby="case-cta-title">
      <div class="case-cta-copy">
        <span class="section-kicker">Ready to frame?</span>
        <h2 id="case-cta-title">Let’s turn your digital presence into a growth system.</h2>
        <div class="works-actions case-cta-actions">
          <a class="button button-primary" href="/en/contact">
            Start a project
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
        </div>
      </div>
      <div class="case-cta-visual" aria-hidden="true">
        <ParticleLogoSlide />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const initCaseFilters = () => {
    const boards = document.querySelectorAll('[data-case-board]');

    boards.forEach((board) => {
      if (!(board instanceof HTMLElement) || board.dataset.filtersReady === 'true') return;
      board.dataset.filtersReady = 'true';

      const buttons = [...board.querySelectorAll('[data-case-filter]')];
      const cards = [...board.querySelectorAll('[data-case-category]')];

      const setActiveFilter = (button: Element) => {
        if (!(button instanceof HTMLButtonElement)) return;

        const selectedCategory = button.dataset.caseFilter || '';
        const showAll = button.dataset.caseFilterAll === 'true';

        buttons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle('is-active', isActive);
          if (item instanceof HTMLElement) {
            item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          }
        });

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          card.hidden = !showAll && card.dataset.caseCategory !== selectedCategory;
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => setActiveFilter(button));
      });
    });
  };

  const initRealisationsInteractions = () => {
    initCaseFilters();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRealisationsInteractions, { once: true });
  } else {
    initRealisationsInteractions();
  }
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .realisations-page {
    --container: min(100% - 3rem, 1320px);
    --purple: #7c3cff;
    --purple-soft: #a46cff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.68);
    overflow: hidden;
    background:
      radial-gradient(circle at 14% 12%, rgba(124, 60, 255, 0.22), transparent 26rem),
      radial-gradient(circle at 88% 8%, rgba(124, 60, 255, 0.18), transparent 24rem),
      linear-gradient(180deg, #030407 0%, #050507 56%, #020306 100%);
    color: #fff;
  }

  .realisations-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 68px 68px;
    content: "";
    pointer-events: none;
  }

  .works-hero,
  .proof-strip,
  .case-board,
  .case-marquee,
  .case-cta {
    position: relative;
    z-index: 1;
    width: var(--container);
    margin-inline: auto;
  }

  .proof-strip,
  .case-board,
  .case-marquee,
  .case-cta {
    scroll-margin-top: 6rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-soft);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.1rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .works-hero {
    display: grid;
    grid-template-columns: minmax(340px, 0.78fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.8vw, 4.75rem);
    align-items: center;
    min-height: 760px;
    padding: 8.4rem 0 3.5rem;
  }

  .works-hero-copy {
    min-width: 0;
  }

  .works-hero h1 {
    max-width: 650px;
    margin: 1.15rem 0 0;
    --h1-size: clamp(3.2rem, 5.4vw, 5.9rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .works-hero h1 span {
    color: var(--purple);
  }

  .works-hero p {
    max-width: 560px;
    margin: 1.35rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.22vw, 1.14rem);
    line-height: 1.58;
  }

  .works-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.05rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1.25rem;
    color: #fff;
    font-weight: 850;
    text-decoration: none;
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-showcase {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .mobile-page-nav {
    display: none;
  }

  .featured-work {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    background:
      radial-gradient(circle at 20% 0%, rgba(124, 60, 255, 0.18), transparent 18rem),
      rgba(255, 255, 255, 0.035);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.45);
    transition: border-color 240ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .featured-work:hover {
    border-color: rgba(164, 108, 255, 0.72);
    box-shadow: 0 2.4rem 5.4rem rgba(0, 0, 0, 0.48), 0 0 2.4rem rgba(124, 60, 255, 0.16);
    transform: translateY(-4px);
  }

  .featured-work.is-switching {
    border-color: rgba(124, 60, 255, 0.48);
    opacity: 0.82;
    transform: translateY(2px);
  }

  .featured-work-frame {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
    min-height: 420px;
    color: inherit;
    text-decoration: none;
  }

  .featured-work figure {
    position: relative;
    min-height: 100%;
    margin: 0;
    overflow: hidden;
    background: #050507;
  }

  .featured-work img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .featured-work:hover img {
    transform: scale(1.035);
  }

  .featured-work-copy {
    display: grid;
    align-content: end;
    gap: 0.9rem;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    padding: clamp(1.1rem, 2vw, 1.55rem);
    background:
      linear-gradient(145deg, rgba(124, 60, 255, 0.18), transparent 46%),
      rgba(3, 3, 6, 0.9);
  }

  .featured-work-copy > span {
    color: var(--purple-soft);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured-work-copy h2 {
    margin: 0;
    max-width: 100%;
    --h2-size: clamp(1.45rem, 2.25vw, 2.25rem);
    font-size: var(--h2-size);
    font-weight: 850;
    line-height: 1.02;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .featured-work-copy p {
    margin: 0;
    max-width: 34rem;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  .featured-work-copy dl {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
    margin: 0.35rem 0 0;
  }

  .featured-work-copy dl div {
    border-left: 2px solid var(--purple);
    padding-left: 0.65rem;
  }

  .featured-work-copy dt,
  .work-copy dt {
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-work-copy dd,
  .work-copy dd {
    min-width: 0;
    margin: 0.25rem 0 0;
    color: #fff;
    font-size: 0.83rem;
    font-weight: 850;
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  .hero-mini-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .hero-mini-card {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
    color: inherit;
    transition: border-color 240ms ease, box-shadow 240ms ease, transform 240ms ease;
  }

  .hero-mini-card:hover {
    border-color: rgba(124, 60, 255, 0.72);
    box-shadow: 0 0 0 1px rgba(124, 60, 255, 0.2), 0 1rem 2.2rem rgba(0, 0, 0, 0.32);
    outline: 0;
    transform: translateY(-3px);
  }

  .hero-mini-card.is-active {
    border-color: rgba(124, 60, 255, 0.95);
    box-shadow: inset 0 0 0 1px rgba(124, 60, 255, 0.32), 0 0 1.3rem rgba(124, 60, 255, 0.22);
  }

  .hero-mini-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 240ms ease, transform 360ms ease;
  }

  .hero-mini-card:hover img,
  .hero-mini-card.is-active img {
    opacity: 1;
    transform: scale(1.035);
  }

  .hero-mini-caption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.86));
  }

  .hero-mini-grid strong {
    font-size: 0.82rem;
    line-height: 1;
  }

  .hero-mini-grid span {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.66rem;
    font-weight: 750;
  }

  .proof-strip {
    counter-reset: proof-stat;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .proof-strip article {
    position: relative;
    display: grid;
    min-height: 132px;
    align-content: space-between;
    gap: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    padding: clamp(1.1rem, 2vw, 1.55rem);
    background:
      radial-gradient(circle at 12% 0%, rgba(139, 92, 246, 0.26), transparent 12rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025) 46%, rgba(0, 0, 0, 0.42));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 1.2rem 2.4rem rgba(0, 0, 0, 0.22);
    counter-increment: proof-stat;
  }

  .proof-strip article::before {
    content: "";
    width: 3.4rem;
    height: 0.2rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #7c3cff, #b18cff);
    box-shadow: 0 0 1rem rgba(124, 60, 255, 0.42);
  }

  .proof-strip article::after {
    content: "0" counter(proof-stat);
    position: absolute;
    top: 1.15rem;
    right: 1.2rem;
    color: rgba(255, 255, 255, 0.18);
    font-size: 0.72rem;
    font-weight: 850;
  }

  .proof-strip strong {
    display: block;
    margin-top: 0.55rem;
    font-size: clamp(2.45rem, 5vw, 4.35rem);
    font-weight: 900;
    line-height: 0.9;
  }

  .proof-strip span {
    display: block;
    max-width: 310px;
    color: var(--muted);
    font-size: clamp(0.82rem, 1.05vw, 1rem);
    font-weight: 650;
    line-height: 1.35;
  }

  .case-board {
    padding: clamp(3rem, 6.5vw, 5.2rem) 0 0;
  }

  .case-board-head {
    display: grid;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.6rem;
  }

  .case-board h2 {
    margin: 0.95rem 0 0;
    --h2-size: clamp(2.35rem, 4.4vw, 4.7rem);
    font-size: var(--h2-size);
    font-weight: 850;
    line-height: 0.96;
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.62rem;
    max-width: 1180px;
    margin: 0 auto;
  }

  .category-pills button {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 0 1.05rem;
    background: rgba(255, 255, 255, 0.035);
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(0.78rem, 0.9vw, 0.92rem);
    font-weight: 850;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .category-pills button:hover,
  .category-pills button:focus-visible,
  .category-pills button.is-active {
    border-color: rgba(164, 108, 255, 0.72);
    background: rgba(124, 60, 255, 0.18);
    color: #fff;
    outline: 0;
  }

  .category-pills button:focus-visible {
    box-shadow: 0 0 0 3px rgba(124, 60, 255, 0.25);
  }

  .category-pills button:hover {
    transform: translateY(-1px);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .work-card {
    --accent: var(--purple);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.035);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.055);
    transition: transform 320ms ease, border-color 320ms ease, box-shadow 320ms ease, background 320ms ease;
  }

  .work-card::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(115deg, transparent 0 38%, rgba(255, 255, 255, 0.14) 48%, transparent 58% 100%),
      radial-gradient(circle at 20% 0%, color-mix(in srgb, var(--accent) 34%, transparent), transparent 18rem);
    opacity: 0;
    transform: translateX(-28%);
    transition: opacity 320ms ease, transform 650ms ease;
  }

  .work-card[hidden] {
    display: none;
  }

  .work-card:hover {
    border-color: color-mix(in srgb, var(--accent) 72%, rgba(255, 255, 255, 0.18));
    background: rgba(255, 255, 255, 0.05);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 1.25rem 3.2rem rgba(0, 0, 0, 0.42),
      0 0 2.4rem color-mix(in srgb, var(--accent) 28%, transparent);
    transform: translateY(-7px) scale(1.01);
  }

  .work-card:hover::before {
    opacity: 1;
    transform: translateX(22%);
  }

  .work-card-body {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto auto;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .work-media {
    position: relative;
    height: clamp(210px, 18vw, 285px);
    min-height: 0;
    overflow: hidden;
    background: #050507;
  }

  .work-card-square .work-media,
  .work-card-creative .work-media,
  .work-card-poster .work-media,
  .work-card-phone .work-media {
    height: clamp(210px, 18vw, 285px);
  }

  .media-main {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .media-main {
    z-index: 1;
    transition: transform 650ms ease, filter 650ms ease;
  }

  .work-card:hover .media-main {
    filter: saturate(1.08) contrast(1.04);
    transform: scale(1.045);
  }

  .work-copy {
    display: grid;
    align-content: start;
    gap: 0.58rem;
    padding: 0.9rem;
    background:
      linear-gradient(135deg, rgba(124, 60, 255, 0.1), transparent 44%),
      rgba(5, 5, 8, 0.95);
  }

  .work-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .work-topline span,
  .case-status {
    display: inline-flex;
    width: fit-content;
    min-height: 1.58rem;
    align-items: center;
    border-radius: 6px;
    padding: 0 0.55rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work-topline small {
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.68rem;
    font-weight: 800;
    text-align: right;
  }

  .work-copy h3 {
    margin: 0;
    font-size: clamp(1.42rem, 1.86vw, 1.9rem);
    font-weight: 850;
    line-height: 0.98;
  }

  .work-copy p {
    min-height: 0;
    margin: -0.12rem 0 0.12rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.86rem;
    line-height: 1.34;
  }

  .work-copy dl {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 1.08fr) minmax(0, 0.98fr);
    gap: 0.62rem;
    margin: 0.18rem 0 0;
  }

  .work-copy dl div {
    min-width: 0;
    border-left: 2px solid var(--accent);
    padding-left: 0.58rem;
  }

  .case-status {
    border: 1px solid rgba(255, 255, 255, 0.13);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.78);
    transition: border-color 260ms ease, background 260ms ease, color 260ms ease, transform 260ms ease;
  }

  .work-card:hover .case-status {
    border-color: color-mix(in srgb, var(--accent) 64%, rgba(255, 255, 255, 0.18));
    background: color-mix(in srgb, var(--accent) 18%, rgba(255, 255, 255, 0.04));
    color: #fff;
    transform: translateY(-1px);
  }

  .work-accent-blue { --accent: #246dff; }
  .work-accent-orange { --accent: #f06423; }
  .work-accent-yellow { --accent: #d4a514; }
  .work-accent-green { --accent: #20a66a; }
  .work-accent-sand { --accent: #c49a5c; }
  .work-accent-cyan { --accent: #19a7d8; }
  .work-accent-red { --accent: #e53248; }
  .work-accent-magenta { --accent: #b347ff; }

  .case-marquee {
    margin-top: clamp(3rem, 6vw, 5rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: clamp(1rem, 2vw, 1.4rem);
    background:
      radial-gradient(circle at 0% 0%, rgba(124, 60, 255, 0.18), transparent 24rem),
      rgba(255, 255, 255, 0.025);
  }

  .case-marquee-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  .case-marquee-head p {
    max-width: 390px;
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
    text-align: right;
  }

  .case-marquee-window {
    overflow: hidden;
  }

  .case-marquee-track {
    display: flex;
    width: max-content;
    gap: 0.9rem;
    animation: caseMarquee 38s linear infinite;
  }

  .marquee-frame {
    position: relative;
    width: 250px;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #07070a;
  }

  .marquee-frame img {
    width: 100%;
    height: 150px;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.03);
  }

  .marquee-frame-phone {
    width: 118px;
  }

  .marquee-frame-phone img {
    height: 188px;
  }

  @keyframes caseMarquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .case-cta {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.58fr) minmax(360px, 0.42fr);
    gap: clamp(1.3rem, 3vw, 2.6rem);
    align-items: center;
    min-height: clamp(290px, 25vw, 380px);
    overflow: hidden;
    margin-top: clamp(3rem, 6vw, 5rem);
    margin-bottom: 4.5rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: clamp(1.35rem, 3vw, 2.5rem);
    background:
      radial-gradient(circle at 0 100%, rgba(124, 60, 255, 0.34), transparent 28rem),
      radial-gradient(circle at 78% 46%, rgba(124, 60, 255, 0.16), transparent 22rem),
      linear-gradient(rgba(255, 255, 255, 0.036) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.036) 1px, transparent 1px),
      linear-gradient(135deg, rgba(124, 60, 255, 0.14), rgba(255, 255, 255, 0.025));
    background-size: auto, auto, 84px 84px, 84px 84px, auto;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  .case-cta::before {
    position: absolute;
    inset: 0;
    content: "";
    background:
      linear-gradient(90deg, rgba(124, 60, 255, 0.14), transparent 55%),
      radial-gradient(circle at 12% 88%, rgba(124, 60, 255, 0.22), transparent 18rem);
    pointer-events: none;
  }

  .case-cta-copy,
  .case-cta-visual {
    position: relative;
    z-index: 1;
  }

  .case-cta h2 {
    max-width: 680px;
    margin: 0.8rem 0 0;
    --h2-size: clamp(2.05rem, 4vw, 3.65rem);
    font-size: var(--h2-size);
    font-weight: 850;
    line-height: 1.02;
    text-wrap: balance;
  }

  .case-cta-actions {
    margin-top: clamp(1.05rem, 2.1vw, 1.55rem);
  }

  .case-cta-visual {
    min-height: clamp(180px, 18vw, 280px);
    overflow: hidden;
    background: #000;
  }

  .case-cta-visual :global(.particle-logo-slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .case-cta-visual :global(.particle-logo-slide__hint) {
    display: none;
  }

  @media (max-width: 1120px) {
    .works-hero,
    .case-board-head,
    .case-cta {
      grid-template-columns: 1fr;
    }

    .works-hero {
      min-height: auto;
      padding-top: 8rem;
    }

    .featured-work-frame {
      grid-template-columns: 1fr;
    }

    .featured-work figure {
      min-height: 360px;
    }

    .category-pills {
      justify-content: center;
    }

    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-cta-visual {
      min-height: 18rem;
    }
  }

  @media (max-width: 720px) {
    .realisations-page {
      --container: min(100% - 1.25rem, 1320px);
      background:
        radial-gradient(circle at 18% 4%, rgba(124, 60, 255, 0.18), transparent 18rem),
        linear-gradient(180deg, #030407 0%, #06070c 54%, #020306 100%);
    }

    .works-hero {
      gap: 1.15rem;
      padding-top: 5.8rem;
      padding-bottom: 1.1rem;
    }

    .works-hero h1 {
      --h1-size: clamp(2.42rem, 12.4vw, 3.35rem);
      max-width: 10ch;
      margin-top: 0.82rem;
      line-height: 0.96;
    }

    .works-hero p {
      margin-top: 1rem;
      font-size: 0.96rem;
      line-height: 1.55;
    }

    .works-actions {
      flex-direction: column;
      gap: 0.62rem;
      margin-top: 1.25rem;
    }

    .button {
      width: 100%;
      min-height: 3.15rem;
      padding-inline: 1rem;
    }

    .featured-work-frame {
      min-height: auto;
    }

    .featured-work figure {
      min-height: 214px;
    }

    .featured-work-copy {
      gap: 0.68rem;
      padding: 0.9rem;
    }

    .featured-work-copy > span {
      font-size: 0.62rem;
    }

    .featured-work-copy h2 {
      --h2-size: clamp(1.28rem, 7vw, 1.7rem);
      line-height: 1.05;
    }

    .featured-work-copy p {
      font-size: 0.78rem;
    }

    .featured-work-copy dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.45rem;
    }

    .featured-work-copy dl div,
    .work-copy dl div {
      padding-left: 0.48rem;
    }

    .work-copy dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.45rem;
    }

    .hero-mini-grid {
      display: flex;
      gap: 0.65rem;
      overflow-x: auto;
      margin-inline: -0.625rem;
      padding: 0 0.625rem 0.28rem;
      scroll-padding-inline: 0.625rem;
      scroll-snap-type: x mandatory;
    }

    .hero-mini-card {
      flex: 0 0 10.4rem;
      aspect-ratio: 5 / 3;
      scroll-snap-align: start;
    }

    .hero-mini-caption {
      padding: 0.62rem;
    }

    .mobile-page-nav {
      position: sticky;
      top: 4.35rem;
      z-index: 12;
      display: flex;
      gap: 0.48rem;
      overflow-x: auto;
      width: var(--container);
      margin: 0.75rem auto 1rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 8px;
      padding: 0.42rem;
      background: rgba(5, 7, 15, 0.86);
      box-shadow: 0 0.9rem 2rem rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(16px);
    }

    .mobile-page-nav a {
      display: grid;
      min-width: 5.9rem;
      min-height: 3rem;
      align-content: center;
      gap: 0.12rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 7px;
      padding: 0.45rem 0.62rem;
      background: rgba(255, 255, 255, 0.045);
      color: #fff;
      text-decoration: none;
      scroll-snap-align: start;
    }

    .mobile-page-nav span {
      color: rgba(255, 255, 255, 0.62);
      font-size: 0.62rem;
      font-weight: 850;
      letter-spacing: 0.08em;
      line-height: 1;
      text-transform: uppercase;
