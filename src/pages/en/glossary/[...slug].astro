---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuickAnswer from '../../../components/QuickAnswer.astro';
import { definedTerm, faqSchema, breadcrumbs } from '../../../lib/schema';
import { SITE } from '../../../consts';

const publicGlossarySlug = (slug: string) => slug.replace(/^en\//, '');

export async function getStaticPaths() {
  const entries = await getCollection('glossaire', ({ data }) => !data.draft && data.lang === 'en');
  return entries.map((entry) => ({
    params: { slug: (entry.data.slug ?? entry.id).replace(/^en\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = publicGlossarySlug(entry.data.slug ?? entry.id);
const url = `${SITE.url}/en/glossary/${slug}`;
const categoryLabels = {
  'SEO/GEO': 'SEO/GEO',
  Média: 'Media',
  'Social & Influence': 'Social & Influence',
  'CRM & Data': 'CRM & Data',
  'Web & Tech': 'Web & Tech',
  'Growth & Stratégie': 'Growth & Strategy',
} as const;
const categoryLabel = categoryLabels[entry.data.categorie];
const glossaryEntries = await getCollection('glossaire', ({ data }) => !data.draft && data.lang === 'en');
const glossaryById = new Map(glossaryEntries.map((item) => [item.id, item]));
const relatedTerms = entry.data.termesLies.map((ref) => {
  const relatedEntry = glossaryById.get(ref.id);
  const relatedSlug = publicGlossarySlug(relatedEntry?.data.slug ?? ref.id);
  return {
    href: `/en/glossary/${relatedSlug}`,
    label: relatedEntry?.data.title ?? relatedSlug,
    category: relatedEntry ? categoryLabels[relatedEntry.data.categorie] : 'Glossary',
    acronym: relatedEntry?.data.acronyme,
  };
});
const expertiseMap = {
  'referencement-seo': {
    href: '/en/expertises/seo-geo',
    title: 'SEO / GEO',
  },
  'media-performance': {
    href: '/en/expertises/media-performance',
    title: 'Media & performance',
  },
} as const;
const expertiseId = entry.data.expertiseLiee?.id as keyof typeof expertiseMap | undefined;
const expertise = expertiseId ? expertiseMap[expertiseId] : undefined;
const formattedDate = entry.data.dateModification.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const termSchema = {
  ...definedTerm({
    name: entry.data.title,
    description: entry.data.quickAnswer,
    url,
    acronym: entry.data.acronyme,
    synonyms: entry.data.synonymes,
  }),
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    '@id': `${SITE.url}/en/glossary/#set`,
    name: 'Digital marketing glossary — Richmedia',
    url: `${SITE.url}/en/glossary`,
  },
};
const schema = [
  termSchema,
  faqSchema(entry.data.faq),
  breadcrumbs([
    { name: 'Home', url: `${SITE.url}/en` },
    { name: 'Glossary', url: `${SITE.url}/en/glossary` },
    { name: entry.data.title, url },
  ]),
];
---

<BaseLayout
  lang="en"
  title={entry.data.metaTitle ?? entry.data.title}
  description={entry.data.metaDescription}
  canonical={url}
  schema={schema}
>
  <div class="term-page">
    <a class="term-back" href="/en/glossary">
      <i class="ph ph-arrow-left" aria-hidden="true"></i>
      Back to glossary
    </a>

    <section class="term-hero" aria-labelledby="term-title">
      <div class="term-hero-copy">
        <span class="section-kicker">{categoryLabel}</span>
        <h1 id="term-title">{entry.data.title}</h1>
        {entry.data.acronyme && <p class="term-acronym">{entry.data.acronyme}</p>}
      </div>

      <aside class="term-meta" aria-label="Term information">
        <span>Content type</span>
        <strong>GEO definition</strong>
        <dl>
          <div>
            <dt>Category</dt>
            <dd>{categoryLabel}</dd>
          </div>
          <div>
            <dt>Updated</dt>
            <dd>{formattedDate}</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section class="term-answer-card" aria-labelledby="term-answer-title">
      <span class="section-kicker">Short definition</span>
      <h2 id="term-answer-title">The simple answer</h2>
      <QuickAnswer text={entry.data.quickAnswer} />
    </section>

    <article class="term-body">
      <Content />
    </article>

    {entry.data.faq.length > 0 && (
      <section class="term-faq" aria-labelledby="term-faq-title">
        <span class="section-kicker">FAQ</span>
        <h2 id="term-faq-title">Frequently asked questions</h2>
        <div class="term-faq-grid">
          {entry.data.faq.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {(relatedTerms.length > 0 || expertise) && (
      <section class="term-next-grid" aria-label="Additional resources">
        {relatedTerms.length > 0 && (
          <nav class="term-related" aria-label="See also">
            <span class="section-kicker">See also</span>
            <h2>Related terms</h2>
            <div>
              {relatedTerms.map((term) => (
                <a href={term.href}>
                  <small>{term.category}</small>
                  <strong>
                    {term.label}
                    {term.acronym && <em>{term.acronym}</em>}
                  </strong>
                  <i class="ph ph-arrow-right" aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </nav>
        )}

        {expertise && (
          <aside class="term-pillar">
            <span class="section-kicker">Related expertise</span>
            <h2>{expertise.title}</h2>
            <p>Connect this definition to a Richmedia service page, with methods, channels and practical use cases.</p>
            <a href={expertise.href}>
              View expertise
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </aside>
        )}
      </section>
    )}

    <section class="term-prefooter" aria-labelledby="term-prefooter-title">
      <div>
        <span class="section-kicker">Audit & growth</span>
        <h2 id="term-prefooter-title">Turn these definitions into an action plan.</h2>
        <p>
          Richmedia connects SEO/GEO, media, CRM and conversion work to turn visibility into qualified demand.
        </p>
      </div>
      <div class="term-prefooter-actions">
        <a class="primary-btn" href="/en/book-audit">
          Book an audit
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
        <a class="ghost-btn" href="/en/expertises">
          View expertise
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .term-page {
    width: min(calc(100% - 2rem), 1180px);
    margin: 0 auto;
    padding: 4rem 0 5.5rem;
    color: #fff;
  }

  .term-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.45rem;
    margin-bottom: 1.8rem;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.0625rem;
    font-weight: 800;
    text-decoration: none;
  }

  .term-back:hover {
    color: #fff;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #a985ff;
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .section-kicker::before {
    content: "";
    width: 38px;
    height: 3px;
    border-radius: 999px;
    background: currentColor;
  }

  .term-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.32fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 1.4rem;
  }

  .term-hero-copy,
  .term-meta,
  .term-answer-card,
  .term-faq,
  .term-related,
  .term-pillar,
  .term-prefooter {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background:
      radial-gradient(circle at 92% 12%, rgba(137, 76, 255, 0.14), transparent 18rem),
      rgba(12, 12, 18, 0.88);
  }

  .term-hero-copy {
    display: grid;
    align-content: end;
    min-height: 20rem;
    padding: 2rem;
  }

  .term-hero h1 {
    max-width: 12ch;
    margin: 1rem 0 0;
    color: #fff;
    font-size: clamp(3rem, 7vw, 4.75rem);
    line-height: 0.96;
  }

  .term-acronym {
    width: fit-content;
    margin: 1.1rem 0 0;
    border: 1px solid rgba(169, 133, 255, 0.42);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    color: #d7c8ff;
    background: rgba(137, 76, 255, 0.14);
    font-size: 1.0625rem;
    font-weight: 900;
  }

  .term-meta {
    display: grid;
    align-content: space-between;
    gap: 1.6rem;
    padding: 1.35rem;
  }

  .term-meta > span {
    color: #a985ff;
    font-size: 1.0625rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .term-meta > strong {
    color: #fff;
    font-size: 1.55rem;
    line-height: 1.1;
  }

  .term-meta dl {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .term-meta div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 0.75rem;
  }

  .term-meta dt,
  .term-meta dd {
    margin: 0;
  }

  .term-meta dt {
    color: rgba(255, 255, 255, 0.52);
  }

  .term-meta dd {
    color: #fff;
    font-weight: 800;
    text-align: right;
  }

  .term-answer-card {
    margin-bottom: 1.6rem;
    padding: 1.5rem 1.7rem;
  }

  .term-answer-card h2 {
    margin: 0.75rem 0 0;
    color: #fff;
    font-size: 2rem;
    line-height: 1.08;
  }

  .term-answer-card :global(.quick-answer) {
    max-width: 72ch;
    margin: 1rem 0 0;
    border-left-color: #8f59ff;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.12rem;
  }

  .term-body {
    display: grid;
    gap: 0.9rem;
    max-width: 80ch;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.08rem;
    line-height: 1.78;
  }

  .term-body :global(p),
  .term-body :global(ul),
  .term-body :global(ol) {
    margin: 0;
  }

  .term-body :global(a) {
    color: #b99cff;
    font-weight: 850;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .term-faq {
    margin-top: 2rem;
    padding: 1.5rem;
  }

  .term-faq h2 {
    margin: 0.8rem 0 1rem;
    color: #fff;
    font-size: 2rem;
    line-height: 1.08;
  }

  .term-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .term-faq article {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.035);
  }

  .term-faq h3 {
    margin: 0 0 0.55rem;
    color: #fff;
    font-size: 1.0625rem;
    line-height: 1.25;
  }

  .term-faq p {
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.65;
  }

  .term-next-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.38fr);
    gap: 1rem;
    align-items: stretch;
    margin-top: 1.5rem;
  }

  .term-related,
  .term-pillar {
    padding: 1.35rem;
  }

  .term-related h2,
  .term-pillar h2 {
    margin: 0.75rem 0 1rem;
    color: #fff;
    font-size: 1.65rem;
    line-height: 1.1;
  }

  .term-related > div {
    display: grid;
    gap: 0.7rem;
  }

  .term-related a,
  .term-pillar a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.85rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.035);
    text-decoration: none;
  }

  .term-related small {
    display: block;
    color: #a985ff;
    font-size: 1.0625rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .term-related strong {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    margin-top: 0.25rem;
    line-height: 1.22;
  }

  .term-related em {
    color: #c9b7ff;
    font-style: normal;
    font-size: 1.0625rem;
  }

  .term-pillar p {
    margin: 0 0 1rem;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.65;
  }

  .term-prefooter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    margin-top: 1.6rem;
    padding: 1.5rem;
  }

  .term-prefooter h2 {
    margin: 0.7rem 0 0.5rem;
    color: #fff;
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    line-height: 1.08;
  }

  .term-prefooter p {
    max-width: 62ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    line-height: 1.6;
  }

  .term-prefooter-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: flex-end;
  }

  .primary-btn,
  .ghost-btn {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 8px;
    padding: 0 1rem;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary-btn {
    background: linear-gradient(135deg, #8f59ff, #6d35ff);
    color: #fff;
    box-shadow: 0 16px 40px rgba(109, 53, 255, 0.24);
  }

  .ghost-btn {
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }

  @media (max-width: 820px) {
    .term-page {
      width: min(calc(100% - 1.1rem), 1180px);
      padding: 2rem 0 4rem;
    }

    .term-hero,
    .term-next-grid,
    .term-prefooter {
      grid-template-columns: 1fr;
    }

    .term-hero-copy {
      min-height: auto;
      padding: 1.35rem;
    }

    .term-hero h1 {
      max-width: none;
    }

    .term-faq-grid {
      grid-template-columns: 1fr;
    }

    .term-prefooter-actions {
      justify-content: flex-start;
    }
  }
</style>
