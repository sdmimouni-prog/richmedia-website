---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppLegacyLanding from '../../components/WhatsAppLegacyLanding.astro';
import whatsappLegacyStylesheet from '../../styles/whatsapp-legacy.css?url';
import { SITE } from '../../consts';
import { breadcrumbs, localBusiness, serviceSchema } from '../../lib/schema';

const pageDescription =
  'Activez des campagnes WhatsApp pour relancer, qualifier et convertir vos contacts avec un dispositif connecté au CRM et au reporting.';

const schema = [
  localBusiness(),
  serviceSchema({
    name: 'Solution de push WhatsApp',
    description: pageDescription,
    url: `${SITE.url}/produits/whatsapp`,
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Produits', url: `${SITE.url}/produits/whatsapp` },
    { name: 'Solution de push WhatsApp', url: `${SITE.url}/produits/whatsapp` },
  ]),
];
---

<BaseLayout
  title="Push WhatsApp pour campagnes | Richmedia"
  description={pageDescription}
  canonical={`${SITE.url}/produits/whatsapp`}
  extraStylesheets={[whatsappLegacyStylesheet]}
  schema={schema}
>
  <WhatsAppLegacyLanding />
</BaseLayout>
