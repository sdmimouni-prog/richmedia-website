---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import { articleSchema, breadcrumbs } from '../../lib/schema';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('cas', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const url = `${SITE.url}/realisations/${entry.data.slug ?? entry.id}`;

const schema = [
  articleSchema({
    title: entry.data.title,
    description: entry.data.metaDescription,
    url,
    author: 'Richmedia',
    datePublished: entry.data.datePublication,
    dateModified: entry.data.dateModification,
    image: entry.data.ogImage,
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Réalisations', url: `${SITE.url}/realisations` },
    { name: entry.data.title, url },
  ]),
];
---
<BaseLayout title={entry.data.metaTitle ?? entry.data.title} description={entry.data.metaDescription} canonical={url} schema={schema}>
  <h1>{entry.data.title}</h1>
  <QuickAnswer text={entry.data.quickAnswer} />
  <dl class="kpis">
    {entry.data.kpis.map((k) => (<><dt>{k.valeur}</dt><dd>{k.libelle}</dd></>))}
  </dl>
  <Content />
</BaseLayout>
