---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyModel from '../../components/CaseStudyModel.astro';
import { SITE } from '../../consts';
import { breadcrumbs } from '../../lib/schema';

const pageUrl = `${SITE.url}/realisations/modele-case-study`;
const assetBase = '/assets/richmedia-case-study';

const content = {
  backHref: '/realisations',
  backLabel: 'Retour aux cas clients',
  eyebrow: 'Une approche end-to-end pensée pour performer à chaque étape du parcours.',
  client: 'UIR',
  clientLong: 'Université Internationale de Rabat',
  category: 'Éducation',
  period: 'Juin - Septembre 2024',
  scope: 'Social / Performance / Landing page',
  title: 'Le Résultat',
  subtitle:
    "Pour la campagne d'inscriptions 2024 de l’UIR, nous avons conçu un dispositif digital full-funnel qui a propulsé la notoriété et généré des inscriptions qualifiées à grande échelle.",
  heroImage: `${assetBase}/result-hero-clean-hq.webp`,
  metaItems: [
    { label: 'Client', value: 'UIR' },
    { label: 'Secteur', value: 'Éducation' },
    { label: 'Période', value: 'Juin - Septembre 2024' },
    { label: 'Canal', value: 'Social / Performance / Landing page' },
  ],
  metrics: [
    { value: '34K', label: 'Leads qualifiés', note: '+162%', icon: 'ph ph-users' },
    { value: '20M', label: 'Impressions', note: '+188%', icon: 'ph ph-eye' },
    { value: '6.2%', label: "Taux d'engagement", note: '+2.4 pts', icon: 'ph ph-chart-line-up' },
    { value: '2.8x', label: 'Uplift inscriptions', note: 'vs. 2023', icon: 'ph ph-rocket-launch' },
  ],
  deliverables: [
    'Stratégie & plan média',
    'Identité créative',
    'Kits formats (15+)',
    'Landing page',
    'Tracking & dashboards',
    'Rapport de performance',
  ],
  work: [
    {
      eyebrow: '01',
      title: 'Insight',
      text: 'Analyse des parcours étudiants et des tendances digitales.',
      bullets: ['Analyse des parcours étudiants et des tendances digitales.', 'Segmentation fine par profils et canaux.'],
      icon: 'ph ph-magnifying-glass',
    },
    {
      eyebrow: '02',
      title: 'Concept créatif',
      text: 'Territoire “Lance ton avenir” porteur et inspirant.',
      bullets: ['Territoire “Lance ton avenir” porteur et inspirant.', 'Formats multi, vidéos & stories pensés mobile-first.'],
      icon: 'ph ph-lightbulb',
    },
    {
      eyebrow: '03',
      title: 'Déploiement média',
      text: 'Mix social, display, vidéo et search.',
      bullets: ['Mix social, display, vidéo et search.', 'Landing page dédiée & CRM d’inscription.'],
      icon: 'ph ph-megaphone',
    },
    {
      eyebrow: '04',
      title: 'Optimisation',
      text: 'Pilotage data en temps réel.',
      bullets: ['Pilotage data en temps réel.', 'Tests créatifs et audiences pour maximiser la conversion.'],
      icon: 'ph ph-chart-line-up',
    },
  ],
  proof: {
    eyebrow: 'Bloc 3',
    title: 'Les Preuves',
    intro:
      'Un assemblage visuel des créations, formats, tableaux de bord et preuves business de la campagne.',
    items: [
      { image: `${assetBase}/proof-social-feed.webp`, label: 'Post sponsorisé', format: 'Social feed', size: 'feed' as const },
      { image: `${assetBase}/proof-story.webp`, label: 'Story sponsorisée', format: 'Story verticale', size: 'story' as const },
      { image: `${assetBase}/proof-banner.webp`, label: 'Bannière inscriptions', format: 'Display', size: 'banner' as const },
      { image: `${assetBase}/proof-dashboard.webp`, label: 'Tableau de bord', format: 'Performance', size: 'dashboard' as const },
      { image: `${assetBase}/proof-event.webp`, label: 'Activation campus', format: 'Terrain', size: 'event' as const },
      { image: `${assetBase}/proof-engineering.webp`, label: 'Ingénierie & sciences', format: 'Format vertical', size: 'engineering' as const },
      { image: `${assetBase}/proof-parcours.webp`, label: 'Parcours différenciants', format: 'Format vertical', size: 'parcours' as const },
      { image: `${assetBase}/proof-ready.png`, label: 'Prêt pour demain', format: 'Format vertical', size: 'ready' as const },
      { image: `${assetBase}/proof-landing.webp`, label: 'Landing page', format: 'Conversion', size: 'landing' as const },
      { image: `${assetBase}/proof-quote-card.webp`, label: 'Témoignage client', format: 'Citation', size: 'quote' as const },
      { image: `${assetBase}/proof-keys-card.png`, label: 'Preuves clés', format: 'Résultats', size: 'keys' as const },
    ],
  },
  quote:
    'Richmedia a dépassé nos objectifs sur toute la ligne. Leur compréhension de nos enjeux et leur agilité ont fait la différence.',
  ctaLabel: 'Lancer un projet similaire',
  ctaHref: '/contact',
  secondaryLabel: 'Retour aux cas clients',
  secondaryHref: '/realisations',
  ui: {
    resultsLabel: 'Résultats du cas client',
    metaLabel: 'Résumé du cas client',
    workLabel: 'Bloc 2',
    workTitle: 'Ce Qu’on A Fait',
    proofLabel: 'Preuves visuelles',
    quoteLabel: 'Enseignement du cas client',
    takeawayLabel: 'Enseignement du cas client',
  },
};

const schema = [
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Cas clients', url: `${SITE.url}/realisations` },
    { name: 'Modèle de cas client', url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Modèle cas client UIR admissions | Richmedia"
  description="Découvrez un modèle de page cas client Richmedia autour des admissions UIR : résultat, méthode et preuves visuelles."
  canonical={pageUrl}
  ogImage={`${SITE.url}${content.heroImage}`}
  schema={schema}
>
  <CaseStudyModel content={content} />
</BaseLayout>
