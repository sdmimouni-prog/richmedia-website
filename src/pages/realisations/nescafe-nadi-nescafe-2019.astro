    'Vous souhaitez transformer votre audience en communauté propriétaire et engagée ?',
  ctaLabel: 'Parler à un expert',
  ctaHref: '/contact',
  secondaryLabel: 'Découvrir nos expertises Phygital',
  secondaryHref: '/expertises/phygital/',
  ui: {
    resultLabel: 'Résultats du cas client',
    metaLabel: 'Résumé du cas client',
    workLabel: 'Bloc 2',
    workTitle: 'Ce Qu’on A Fait',
    proofLabel: 'Preuves visuelles',
    quoteLabel: 'Maillage du cas client',
