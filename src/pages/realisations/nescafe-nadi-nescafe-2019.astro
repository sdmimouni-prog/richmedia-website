      bullets: [
        'Création d’un espace digital propriétaire autour de Nescafé.',
        'Recrutement de membres et animation d’une communauté jeune.',
        'Relation directe entre la marque et ses consommateurs.',
      ],
      icon: 'ph ph-users-three',
    },
    {
      eyebrow: '02',
      title: 'Engagement par le jeu',
      text: 'Gamification pour créer une expérience d’engagement récurrent.',
      bullets: [
        'Jeux intégrés à la plateforme.',
        'Système de points.',
        'Récompenses à débloquer.',
        'Concours pour maintenir l’engagement dans le temps.',
      ],
