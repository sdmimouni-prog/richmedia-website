    { label: 'Zone', value: 'Maroc' },
    { label: 'Cible', value: '18–25 ans / étudiants / jeunes actifs / consommateurs café / hommes & femmes / toutes CSP' },
    { label: 'Dispositif', value: 'Plateforme web / espace membre / social media / gamification / coupons / activation terrain' },
  ],
  metrics: [
