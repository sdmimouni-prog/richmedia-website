---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyModel from '../../components/CaseStudyModel.astro';
import { SITE } from '../../consts';
import { articleSchema, breadcrumbs } from '../../lib/schema';

const pageUrl = `${SITE.url}/realisations/nescafe-nadi-nescafe-2019`;
const heroImage = '/assets/richmedia-realizations/nescafe-nadi-nescafe.webp';
