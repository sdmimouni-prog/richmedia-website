    },
    {
      eyebrow: '04',
      title: 'Digital → terrain',
      text: 'Articulation entre plateforme digitale et expérience produit physique.',
      bullets: [
        'Social Media pour soutenir l’animation de la communauté.',
        'Distribution de coupons.',
        'Stands et sampling.',
        'Articulation entre plateforme digitale et expérience produit physique.',
      ],
      icon: 'ph ph-storefront',
    },
  ],
  proof: {
    eyebrow: 'Bloc 3',
    title: 'Les Preuves',
    intro:
      'Le visuel réel Nadi Nescafé et les indicateurs validés du dispositif, sans interface web, coupon ou dashboard inventé.',
    items: [
      { image: heroImage, label: 'Nadi Nescafé', format: 'Visuel réel campagne', size: 'banner' as const },
    ],
    kpi: {
      value: '100 K',
      label: 'visites plateforme',
      breakdown: ['5 K membres inscrits', '2 500 coupons téléchargés / utilisés'],
      note: 'Les KPI présentés sont limités aux données validées.',
