      { image: bachelorImage, label: 'Bachelor in Management', format: 'Univers créatif TBS', size: 'story' as const },
    ],
    kpi: {
      value: '3 000',
      label: 'leads',
      breakdown: ['40–80 MAD CPL', '70 % leads qualifiés', '4 000 candidatures TBS tous canaux confondus'],
      note: 'Les 4 000 candidatures correspondent aux candidatures totales TBS sur la période, tous canaux confondus.',
