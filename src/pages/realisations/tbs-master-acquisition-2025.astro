const schema = [
  articleSchema({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    author: 'Richmedia',
    authorType: 'Organization',
    datePublished: publishedAt,
    dateModified: publishedAt,
    image: `${SITE.url}${heroImage}`,
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Cas clients', url: `${SITE.url}/realisations` },
    { name: 'TBS Casablanca — Acquisition Master 2025', url: pageUrl },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${heroImage}`}
  schema={schema}
>
  <CaseStudyModel content={content} />
</BaseLayout>
