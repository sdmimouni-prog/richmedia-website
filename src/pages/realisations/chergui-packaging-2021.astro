  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Cas clients', url: `${SITE.url}/realisations` },
    { name: 'Chergui — Conception Packaging 2021', url: pageUrl },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${heroImage}`}
  schema={schema}
>
  <CaseStudyModel content={content} />
</BaseLayout>
