const heroSliderCases = caseStudies.slice(0, 4);
const featuredCase = caseStudies[1];
const caseLoop = [...caseStudies.slice(0, 10), ...caseStudies.slice(0, 10)];
const quickLinks = [
  { href: '#case-proof', label: 'Preuves', value: '14+' },
  { href: '#case-board', label: 'Cas clients', value: String(caseStudies.length) },
  { href: '#case-film', label: 'Film', value: '360°' },
  { href: '#case-method', label: 'Méthode', value: '3 étapes' },
