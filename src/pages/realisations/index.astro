---
<BaseLayout
  title="Réalisations Richmedia — Cas clients, campagnes et dispositifs digitaux"
  description="Découvrez les réalisations Richmedia : campagnes 360, acquisition de leads, social media, brand content, média et expériences phygitales."
  schema={schema}
>
  <div class="realisations-page">
    <section class="works-hero" aria-labelledby="works-title">
      <div class="works-hero-copy">
        <span class="section-kicker">Portfolio Richmedia</span>
        <h1 id="works-title">Nos <span>cas clients.</span></h1>
        <p>
          Une sélection de campagnes, d’activations terrain et de créations de marque conçues pour produire
          des preuves de croissance mesurables et réutilisables.
        </p>
        <div class="works-actions">
          <a class="button button-primary" href="#case-board">
            Explorer les réalisations
            <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/contact">
            Proposer un projet
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-showcase" data-featured-slider aria-label="Aperçu des réalisations Richmedia">
        <article class="featured-work">
          <a data-featured-link href={featuredCase.href ?? `/realisations/${featuredCase.slug}`} aria-label={`Voir le cas client ${featuredCase.client} - ${featuredCase.title}`}>
            <figure>
              <img data-featured-image src={featuredCase.image} alt={`${featuredCase.client} — ${featuredCase.title}`} loading="eager" decoding="async" />
            </figure>
            <div class="featured-work-copy">
              <span>Cas mis en avant</span>
              <h2 data-featured-title>{featuredCase.title}</h2>
              <p data-featured-summary>Un format média urbain transformé en présence de marque visible, mémorable et mesurable.</p>
              <dl>
                <div>
                  <dt>Client</dt>
                  <dd data-featured-client>{featuredCase.client}</dd>
                </div>
                <div>
                  <dt>Visibilité</dt>
                  <dd data-featured-visibility>{featuredCase.visibility}</dd>
                </div>
                <div>
                  <dt>Engagement</dt>
                  <dd data-featured-engagement>{featuredCase.engagement}</dd>
                </div>
              </dl>
            </div>
          </a>
        </article>

        <div class="hero-mini-grid" aria-label="Changer le cas client mis en avant">
          {heroSliderCases.map((item) => (
            <button
              type="button"
              class:list={['hero-mini-card', item.slug === featuredCase.slug && 'is-active']}
              data-featured-thumb
              data-slug={item.slug}
              data-client={item.client}
              data-title={item.title}
              data-summary={`${item.type} pour ${item.client}, pensée pour créer une preuve de croissance visible et mesurable.`}
              data-image={item.image}
              data-href={item.href ?? `/realisations/${item.slug}`}
              data-visibility={item.visibility}
              data-engagement={item.engagement}
              aria-pressed={item.slug === featuredCase.slug ? 'true' : 'false'}
            >
              <img src={item.image} alt="" loading="eager" decoding="async" />
              <span class="hero-mini-caption">
                <strong>{item.client}</strong>
                <span>{item.category}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <nav class="mobile-page-nav" aria-label="Navigation de la page Réalisations">
      {quickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="proof-strip" id="case-proof" aria-label="Indicateurs du portfolio">
      {featuredStats.map((stat) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </section>

    <section class="case-board" id="case-board" aria-labelledby="case-board-title" data-case-board>
      <div class="case-board-head">
        <div>
          <span class="section-kicker">Tableau des cas clients</span>
          <h2 id="case-board-title">Dernières réalisations</h2>
        </div>
        <div class="category-pills" aria-label="Filtrer les réalisations">
          {categories.map((category, index) => (
            <button
              type="button"
              class:list={[index === 0 && 'is-active']}
              data-case-filter={category}
              data-case-filter-all={index === 0 ? 'true' : 'false'}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="work-grid">
        {caseStudies.map((item) => (
          <article
            id={item.slug}
            class:list={['work-card', `work-card-${item.format}`, `work-accent-${item.accent}`]}
            data-case-slug={item.slug}
            data-case-category={item.category}
          >
            <a href={item.href ?? `/realisations/${item.slug}`} aria-label={`Voir le cas client ${item.client} - ${item.title}`}>
              <div class="work-media">
                <img class="media-main" src={item.image} alt={`${item.client} — ${item.title}`} loading="lazy" decoding="async" />
              </div>
              <div class="work-copy">
                <div class="work-topline">
                  <span>{item.category}</span>
                  <small>{item.year}</small>
                </div>
                <h3>{item.client}</h3>
                <p>{item.title}</p>
                <dl>
                  <div>
                    <dt>Type</dt>
                    <dd>{item.type}</dd>
                  </div>
                  <div>
                    <dt>Visibilité</dt>
                    <dd>{item.visibility}</dd>
                  </div>
                  <div>
                    <dt>Engagement</dt>
                    <dd>{item.engagement}</dd>
                  </div>
                </dl>
                <strong class="case-status">{item.status}</strong>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="case-marquee" id="case-film" aria-label="Film des réalisations">
      <div class="case-marquee-head">
        <span class="section-kicker">Film des campagnes</span>
      </div>
      <div class="case-marquee-window">
        <div class="case-marquee-track">
          {caseLoop.map((item) => (
            <figure class:list={['marquee-frame', `marquee-frame-${item.format}`]}>
              <img src={item.image} alt="" loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="case-method" id="case-method" aria-labelledby="case-method-title">
      <div>
        <span class="section-kicker">Format cas client</span>
        <h2 id="case-method-title">Format cas client.</h2>
      </div>
      <div class="method-grid">
        <article>
          <span>01</span>
          <h3>Contexte & objectif</h3>
          <p>Le problème business, l’audience, le timing et les contraintes du client.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Dispositif & canaux</h3>
          <p>Le concept créatif, les formats, les médias, l’activation terrain ou CRM.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Résultats & apprentissages</h3>
          <p>Les chiffres clés, les enseignements et la suite logique pour scaler.</p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  type FeaturedCasePayload = {
    client: string;
    title: string;
    summary: string;
    image: string;
    href: string;
    visibility: string;
    engagement: string;
  };

  const initFeaturedCaseSlider = () => {
    const sliders = document.querySelectorAll('[data-featured-slider]');

    sliders.forEach((slider) => {
      if (!(slider instanceof HTMLElement) || slider.dataset.sliderReady === 'true') return;
      slider.dataset.sliderReady = 'true';

      const link = slider.querySelector('[data-featured-link]');
      const image = slider.querySelector('[data-featured-image]');
      const title = slider.querySelector('[data-featured-title]');
      const summary = slider.querySelector('[data-featured-summary]');
      const client = slider.querySelector('[data-featured-client]');
      const visibility = slider.querySelector('[data-featured-visibility]');
      const engagement = slider.querySelector('[data-featured-engagement]');
      const thumbs = [...slider.querySelectorAll('[data-featured-thumb]')];
      const featured = slider.querySelector('.featured-work');

      const setActiveCase = (button: Element) => {
        if (!(button instanceof HTMLButtonElement)) return;

        const next: FeaturedCasePayload = {
          client: button.dataset.client || '',
          title: button.dataset.title || '',
          summary: button.dataset.summary || '',
          image: button.dataset.image || '',
          href: button.dataset.href || '#',
          visibility: button.dataset.visibility || '',
          engagement: button.dataset.engagement || '',
        };

        featured?.classList.add('is-switching');

        window.setTimeout(() => {
          if (link instanceof HTMLAnchorElement) {
            link.href = next.href;
            link.setAttribute('aria-label', `Voir le cas client ${next.client} - ${next.title}`);
          }

          if (image instanceof HTMLImageElement) {
            image.src = next.image;
            image.alt = `${next.client} — ${next.title}`;
          }

          if (title) title.textContent = next.title;
          if (summary) summary.textContent = next.summary;
          if (client) client.textContent = next.client;
          if (visibility) visibility.textContent = next.visibility;
          if (engagement) engagement.textContent = next.engagement;

          thumbs.forEach((thumb) => {
            const isActive = thumb === button;
            thumb.classList.toggle('is-active', isActive);
            if (thumb instanceof HTMLElement) {
              thumb.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            }
          });

          window.setTimeout(() => featured?.classList.remove('is-switching'), 90);
        }, 120);
      };

      thumbs.forEach((button) => {
        button.addEventListener('click', () => setActiveCase(button));
      });
    });
  };

  const initCaseFilters = () => {
    const boards = document.querySelectorAll('[data-case-board]');

    boards.forEach((board) => {
      if (!(board instanceof HTMLElement) || board.dataset.filtersReady === 'true') return;
      board.dataset.filtersReady = 'true';

      const buttons = [...board.querySelectorAll('[data-case-filter]')];
      const cards = [...board.querySelectorAll('[data-case-category]')];

      const setActiveFilter = (button: Element) => {
        if (!(button instanceof HTMLButtonElement)) return;

        const selectedCategory = button.dataset.caseFilter || '';
        const showAll = button.dataset.caseFilterAll === 'true';

        buttons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle('is-active', isActive);
          if (item instanceof HTMLElement) {
            item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          }
        });

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          card.hidden = !showAll && card.dataset.caseCategory !== selectedCategory;
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => setActiveFilter(button));
      });
    });
  };

  const initRealisationsInteractions = () => {
    initFeaturedCaseSlider();
    initCaseFilters();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRealisationsInteractions, { once: true });
  } else {
    initRealisationsInteractions();
  }
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .realisations-page {
    --container: min(100% - 3rem, 1320px);
    --purple: #7c3cff;
    --purple-soft: #a46cff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.68);
    overflow: hidden;
    background:
      radial-gradient(circle at 14% 12%, rgba(124, 60, 255, 0.22), transparent 26rem),
      radial-gradient(circle at 88% 8%, rgba(124, 60, 255, 0.18), transparent 24rem),
      linear-gradient(180deg, #030407 0%, #050507 56%, #020306 100%);
    color: #fff;
  }

  .realisations-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.014) 1px, transparent 1px);
    background-size: 68px 68px;
    content: "";
    pointer-events: none;
  }

  .works-hero,
  .proof-strip,
  .case-board,
  .case-marquee,
  .case-method {
    position: relative;
    z-index: 1;
    width: var(--container);
    margin-inline: auto;
  }

  .proof-strip,
  .case-board,
  .case-marquee,
  .case-method {
    scroll-margin-top: 6rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-soft);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.1rem;
    height: 1px;
    background: var(--purple);
    content: "";
  }

  .works-hero {
    display: grid;
    grid-template-columns: minmax(340px, 0.78fr) minmax(0, 1fr);
    gap: clamp(2rem, 4.8vw, 4.75rem);
    align-items: center;
    min-height: 760px;
    padding: 8.4rem 0 3.5rem;
  }

  .works-hero-copy {
    min-width: 0;
  }

  .works-hero h1 {
    max-width: 650px;
    margin: 1.15rem 0 0;
    --h1-size: clamp(3.2rem, 5.4vw, 5.9rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 0.92;
  }

  .works-hero h1 span {
    color: var(--purple);
  }

  .works-hero p {
    max-width: 560px;
    margin: 1.35rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.22vw, 1.14rem);
    line-height: 1.58;
  }

  .works-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.05rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1.25rem;
    color: #fff;
    font-weight: 850;
    text-decoration: none;
  }

  .button-primary {
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.5rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-showcase {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .mobile-page-nav {
    display: none;
  }

  .featured-work {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    background:
      radial-gradient(circle at 20% 0%, rgba(124, 60, 255, 0.18), transparent 18rem),
      rgba(255, 255, 255, 0.035);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.45);
    transition: border-color 240ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .featured-work.is-switching {
    border-color: rgba(124, 60, 255, 0.48);
    opacity: 0.82;
    transform: translateY(2px);
  }

  .featured-work a {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
    min-height: 420px;
    color: inherit;
