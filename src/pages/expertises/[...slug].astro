---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import ServiceLandingPage from '../../components/ServiceLandingPage.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Faq from '../../components/Faq.astro';
import { serviceSchema, breadcrumbs, faqSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';
import { serviceLandings } from '../../lib/service-landings';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const staticExpertiseSlugs = new Set(['referencement-seo']);
  const entries = await getCollection('expertises', ({ data, id }) => {
    const slug = data.slug ?? id;
    return !data.draft && !staticExpertiseSlugs.has(slug);
  });
  const expertisePaths = entries.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
  const serviceLandingPaths = serviceLandings.map((landing) => ({
    params: { slug: landing.slug },
    props: { landing },
  }));

  return [...expertisePaths, ...serviceLandingPaths];
}

const { entry, landing } = Astro.props;
const Content = entry ? (await render(entry)).Content : null;
const slug = landing ? landing.slug : entry.data.slug ?? entry.id;
const url = landing ? `${SITE.url}/expertises/${slug}/` : `${SITE.url}/expertises/${slug}`;
const siloConfig = slug === 'media-performance'
  ? {
      title: 'Relier performance, média et conversion',
      intro: 'La performance digitale relie acquisition paid, SEO/GEO, Social Ads, CRM et pages secteurs pour transformer le trafic en résultats.',
      links: frSiloLinks.media,
    }
  : {
      title: 'Relier SEO, contenu et performance',
      intro: 'Le référencement travaille mieux avec un socle web solide, une stratégie claire et des contenus pensés pour les intentions de recherche.',
      links: frSiloLinks.seo,
    };

const schema = landing
  ? [
      serviceSchema({ name: landing.title, description: landing.metaDescription, url }),
      faqSchema(landing.faq.map(({ question, answer }) => ({ question, answer }))),
      breadcrumbs([
        { name: 'Accueil', url: SITE.url },
        { name: 'Expertises', url: `${SITE.url}/expertises` },
        { name: landing.parent.label, url: `${SITE.url}${landing.parent.href}` },
        { name: landing.title, url },
      ]),
    ]
  : [
      serviceSchema({ name: entry.data.title, description: entry.data.metaDescription, url }),
      breadcrumbs([
        { name: 'Accueil', url: SITE.url },
        { name: 'Expertises', url: `${SITE.url}/expertises` },
        { name: entry.data.title, url },
      ]),
    ];
---
{landing ? (
  <BaseLayout
    title={landing.metaTitle}
    description={landing.metaDescription}
    canonical={url}
    ogImage={landing.heroImage}
    schema={schema}
  >
    <ServiceLandingPage landing={landing} />
  </BaseLayout>
) : (
  <BaseLayout
    title={entry.data.metaTitle ?? entry.data.title}
    description={entry.data.metaDescription}
    canonical={url}
    schema={schema}
  >
    <h1>{entry.data.title}</h1>
    <QuickAnswer text={entry.data.quickAnswer} />
    {Content && <Content />}
    <Faq faq={entry.data.faq} />
    <SeoSiloLinks
      title={siloConfig.title}
      intro={siloConfig.intro}
      links={siloConfig.links}
      variant="compact"
    />
  </BaseLayout>
)}
