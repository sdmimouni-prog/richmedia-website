---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import { SITE } from '../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';

const assetBase = '/assets/richmedia-ia-automation';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/expertises/ia-automation`;

const seoTitle = 'Agence IA & automation à Casablanca — CRM, WhatsApp & agents IA | Richmedia';
const seoDescription =
  'Richmedia conçoit vos systèmes IA & automation au Maroc : CRM, WhatsApp Business, agents IA, lead scoring, workflows automatisés, reporting et garde-fous humains.';

const automationTools = [
  { name: 'Zapier', logo: 'zapier.svg', note: 'Workflows & connecteurs' },
  { name: 'Zoho', logo: 'zoho.svg', note: 'CRM & social ops' },
  { name: 'Google Tag Manager', logo: 'google-tag-manager.svg', note: 'Événements & tracking' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Parcours & conversions' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'Dashboards ROI' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'UX & sessions' },
  { name: 'JavaScript', logo: 'javascript.svg', note: 'Scripts & intégrations' },
  { name: 'Meta', logo: 'meta.svg', note: 'Social & messaging' },
];

const proofCards = [
  {
    metric: 'CRM',
    title: 'Des données propres avant les automatisations',
    text: 'Nous structurons sources, propriétés, statuts, scoring, lifecycle stages et règles de qualification pour éviter les workflows inutilisables.',
  },
  {
    metric: 'WhatsApp',
    title: 'Répondre, qualifier et relancer plus vite',
    text: 'WhatsApp devient un canal de conversion : réponses assistées, qualification, prise de rendez-vous, transfert humain et relances mesurables.',
  },
  {
    metric: 'Agents IA',
    title: 'Des agents utiles, cadrés et supervisés',
    text: 'Nous concevons des agents IA reliés à vos données, vos règles, vos outils et vos validations humaines pour exécuter des tâches réelles.',
  },
  {
    metric: 'ROI',
    title: 'Automatiser ce qui améliore vraiment le business',
    text: 'Chaque scénario est relié à un KPI : temps de réponse, qualité des leads, taux de conversion, coût par opportunité et revenu attribuable.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    label: 'Agentic AI',
    title: 'Les agents passent du prototype aux workflows métier',
    text: 'En 2026, les agents IA ne sont plus seulement des assistants : ils planifient, utilisent des outils, suivent des règles et exécutent des tâches multi-étapes.',
  },
  {
    label: 'CRM context',
    title: 'Le contexte devient plus important que le prompt',
    text: 'La performance vient de la donnée accessible : CRM, historique, catalogues, FAQ, consentement, tickets, statut commercial et base de connaissances à jour.',
  },
  {
    label: 'WhatsApp first',
    title: 'Le messaging devient un canal de vente automatisé',
    text: 'Questions, recommandations, prise de rendez-vous, qualification et handoff humain se déplacent vers WhatsApp, Messenger et les conversations mobiles.',
  },
  {
    label: 'Human-in-loop',
    title: 'Les garde-fous font la différence en production',
    text: 'Un agent fiable doit avoir des permissions, des seuils, des logs, des règles d’escalade et des validations humaines pour les décisions sensibles.',
  },
  {
    label: 'Growth engine',
    title: 'Le marketing devient une orchestration continue',
    text: 'Insights, création, personnalisation, commerce conversationnel et optimisation se connectent dans un système qui apprend chaque semaine.',
  },
  {
    label: 'SEO / GEO',
    title: 'Les réponses IA ont besoin de contenus structurés',
    text: 'Pages, FAQ, schémas, sources, preuves et contenus lisibles aident Google et les moteurs génératifs à comprendre et citer votre offre.',
  },
];

const useCases = [
  {
    image: 'crm-automation.webp',
    type: 'CRM & lead scoring',
    title: 'Qualifier les leads sans perdre le signal commercial',
    text: 'Centralisation des formulaires, statuts, scoring, segmentation, alertes sales et relances selon l’intention réelle du prospect.',
    formats: ['CRM', 'Lead scoring', 'Sales alerts'],
  },
  {
    image: 'whatsapp-agent.webp',
    type: 'WhatsApp agent',
    title: 'Répondre 24/7 avec une reprise humaine nette',
    text: 'Agent conversationnel, qualification, FAQ, catalogue, rendez-vous, messages de suivi et règles de transfert vers vos équipes.',
    formats: ['WhatsApp', 'Handoff', 'RDV'],
  },
  {
    image: 'agent-workflows.webp',
    type: 'Parcours automatisés',
    title: 'Relier acquisition, CRM, service et reporting',
    text: 'Un clic devient une conversation, une fiche CRM, une action commerciale, une relance et une mesure dans votre dashboard.',
    formats: ['Workflows', 'Reporting', 'Ops'],
  },
];

const services = [
  {
    kicker: 'Architecture',
    title: 'Audit CRM, données et parcours automatisables',
    text: 'Cartographie des sources, formulaires, inbox, CRM, statuts, messages, tâches manuelles, risques et opportunités d’automatisation.',
    items: ['CRM', 'Data', 'Parcours', 'Risques'],
  },
  {
    kicker: 'Messaging',
    title: 'WhatsApp Business, qualification et support assisté',
    text: 'Scripts, base de connaissances, scénarios conversationnels, handoff humain, tags, consentement, relances et reporting conversationnel.',
    items: ['WhatsApp', 'FAQ', 'Handoff', 'Opt-in'],
  },
  {
    kicker: 'Agents',
    title: 'Agents IA connectés à vos outils métier',
    text: 'Agents pour qualification, support, recherche, résumé, reporting, suivi commercial, création de tickets et préparation de brief.',
    items: ['Agents IA', 'Knowledge base', 'Actions', 'Logs'],
  },
  {
    kicker: 'Pilotage',
    title: 'Dashboards, garde-fous et amélioration continue',
    text: 'Mesure des réponses, délais, erreurs, conversions, escalades, coûts, qualité des leads et recommandations d’optimisation.',
    items: ['Looker', 'KPI', 'QA', 'ROI'],
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Diagnostic',
    text: 'CRM, WhatsApp, formulaires, scripts, volumes de demandes, qualité des données, maturité équipe et points de friction.',
  },
  {
    step: '02',
    title: 'Design',
    text: 'Parcours cible, règles métier, messages, base de connaissances, permissions agent, handoff humain et KPI.',
  },
  {
    step: '03',
    title: 'Build',
    text: 'Connecteurs, automatisations, tableaux de bord, prompts système, scénarios WhatsApp, triggers et tracking.',
  },
  {
    step: '04',
    title: 'Test',
    text: 'Jeux de test, cas limites, qualité des réponses, sécurité, consentement, escalades et validation par les équipes.',
  },
  {
    step: '05',
    title: 'Scale',
    text: 'Déploiement progressif, formation, monitoring, optimisation hebdomadaire et extension à de nouveaux parcours.',
  },
];

const deliverables = [
  'Audit CRM & automation',
  'Cartographie des parcours clients',
  'Architecture de données & statuts',
  'Scénarios WhatsApp Business',
  'Base de connaissances agent IA',
  'Prompts système & garde-fous',
  'Workflows de qualification',
  'Lead scoring & alertes sales',
  'Plan de handoff humain',
  'Tracking événements & conversions',
  'Dashboard automation ROI',
  'Documentation de pilotage',
];

const sources = [
  {
    title: 'Gartner — enterprise AI agents 2026',
    text: 'Gartner prévoit une forte intégration des agents IA task-specific dans les applications d’entreprise d’ici fin 2026.',
    href: 'https://www.gartner.com/en/newsroom/press-releases/2025-08-26-gartner-predicts-40-percent-of-enterprise-apps-will-feature-task-specific-ai-agents-by-2026-up-from-less-than-5-percent-in-2025',
  },
  {
    title: 'McKinsey — State of AI',
    text: 'L’usage de l’IA s’élargit, mais la valeur dépend surtout du passage des pilotes aux workflows réellement redesignés et scalés.',
    href: 'https://www.mckinsey.com/capabilities/quantumblack/our-insights/the-state-of-ai',
  },
  {
    title: 'McKinsey — marketing AI 2026',
    text: 'Le futur marketing relie insights, création, personnalisation, agentic commerce et orchestration dans un moteur de croissance continu.',
    href: 'https://www.mckinsey.com/capabilities/growth-marketing-and-sales/our-insights/from-campaigns-to-continuous-growth-ai-capabilities-shaping-marketing',
  },
  {
    title: 'Meta — Business Agent WhatsApp',
    text: 'Meta présente les agents Business sur WhatsApp pour répondre, recommander, qualifier des leads, vendre et passer la main aux humains.',
    href: 'https://whatsappbusiness.com/blog/introducing-meta-business-agent-ai/',
  },
  {
    title: 'OpenAI — agentic workflows',
    text: 'Les agents peuvent raisonner, agir, se connecter aux outils de l’entreprise et suivre les règles de l’équipe avec les bonnes validations.',
    href: 'https://openai.com/solutions/use-case/agents/',
  },
  {
    title: 'Salesforce — AI agents 2026',
    text: 'Les tendances 2026 mettent l’accent sur context engineering, garde-fous déterministes, CRM headless et fiabilité de production.',
    href: 'https://www.salesforce.com/blog/ai-agent-trends-2026/',
  },
];

const faq = [
  {
    question: 'Qu’est-ce qu’une agence IA & automation ?',
    answer:
      'Une agence IA & automation conçoit des systèmes qui relient CRM, WhatsApp, agents IA, workflows, tracking et dashboards pour automatiser les tâches répétitives tout en gardant des garde-fous humains.',
  },
  {
    question: 'Quels processus peut-on automatiser avec Richmedia ?',
    answer:
      'Nous automatisons notamment la qualification de leads, les réponses WhatsApp, les relances, le scoring, la création de tickets, les alertes commerciales, les résumés, le reporting et certains parcours de nurturing.',
  },
  {
    question: 'Un agent IA peut-il remplacer une équipe commerciale ?',
    answer:
      'Non. Un agent IA bien conçu assiste l’équipe : il traite les demandes répétitives, collecte le contexte, qualifie et prépare les actions. Les décisions sensibles et les opportunités importantes restent supervisées par l’humain.',
  },
  {
    question: 'Comment éviter les erreurs des agents IA ?',
    answer:
      'Nous mettons en place base de connaissances, permissions, prompts système, règles déterministes, logs, tests, seuils d’escalade, validation humaine et monitoring continu.',
  },
  {
    question: 'Pourquoi optimiser une page IA & automation pour le SEO/GEO ?',
    answer:
      'Parce que les moteurs de recherche et les moteurs génératifs privilégient les pages claires, structurées, sourcées et utiles. FAQ, schémas JSON-LD, sources et cas d’usage rendent l’offre plus compréhensible et citable.',
  },
];

const schema = [
  serviceSchema({
    name: 'IA & automation',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Expertises', url: `${SITE.url}/expertises` },
    { name: 'IA & Automation', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: 'IA' },
  { href: '#trends', label: 'Signaux', value: '2026' },
  { href: '#usecases', label: 'Cas', value: 'CRM' },
  { href: '#automation-cta', label: 'Projet', value: 'Brief' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/ia-automation-hero.webp`}
  schema={schema}
>
  <div class="automation-page">
    <section class="automation-hero" aria-labelledby="automation-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="automation-title">IA & automation pour convertir plus vite.</h1>
        <p class="hero-lead">
          Richmedia connecte CRM, WhatsApp, agents IA, workflows et reporting pour transformer vos demandes,
          leads et conversations en parcours automatisés, mesurables et supervisés.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Automatiser vos parcours
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir les cas clients
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual automation-hover-lab" aria-label="Système IA et automation Richmedia">
        <img src={`${assetBase}/ia-automation-hero.webp`} alt="Équipe marketing pilotant un système CRM, WhatsApp et agents IA automatisés" />
        <div class="signal-card signal-card-top">
          <span>CRM</span>
          <strong>Data propre</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>WhatsApp</span>
          <strong>Réponse + qualification</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>Agents IA</span>
          <strong>Actions supervisées</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-automation-nav" aria-label="Navigation de la page IA et automation">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section id="cockpit" class="automation-cockpit" aria-label="Promesses IA et automation Richmedia">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Automation cockpit</strong>
          <small>agents supervisés</small>
        </div>
        <div class="cockpit-zero">
          <span>IA</span>
          <div>
            <p>{proofCards[0].metric} propre</p>
            <h2>Automatiser sans perdre le contrôle des données et des validations humaines.</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 94%">
            <span>Données CRM structurées</span>
            <i></i>
          </div>
          <div style="--value: 88%">
            <span>Réponses WhatsApp assistées</span>
            <i></i>
          </div>
          <div style="--value: 79%">
            <span>Handoff humain cadré</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="answer" class="quick-answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Réponse rapide</span>
        <h2 id="quick-answer-title">En 2026, l’automation performe quand elle relie CRM, IA et humain.</h2>
      </div>
      <p>
        La valeur vient de scénarios utiles, de données propres, d’agents connectés aux bons outils
        et d’un suivi humain clair.
      </p>
    </section>

    <section id="trends" class="trend-section" aria-labelledby="trend-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Tendances IA & automation 2026</span>
          <h2 id="trend-title">Ce que les marques doivent<br />maîtriser maintenant.</h2>
        </div>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="usecases" class="usecase-section" aria-labelledby="usecase-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Cas d’usage</span>
          <h2 id="usecase-title">Des automatisations visibles par vos clients<br />et utiles pour vos équipes.</h2>
        </div>
      </div>
      <div class="usecase-grid">
        {useCases.map((item) => (
          <article>
            <div class="usecase-photo">
              <img src={`${assetBase}/${item.image}`} alt={item.title} loading="lazy" decoding="async" />
            </div>
            <div class="usecase-copy">
              <span>{item.type}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <div>
                {item.formats.map((format) => <small>{format}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="system" class="automation-system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-top">
            <span></span><span></span><span></span>
            <strong>richmedia.ma / ai-automation</strong>
          </div>
          <div class="screen-body">
            <div class="data-card data-card-a">
              <span>input</span>
              <strong>Lead WhatsApp qualifié</strong>
            </div>
            <div class="data-card data-card-b">
              <span>agent_rules</span>
              <strong>Réponse + CRM + handoff</strong>
            </div>
            <div class="automation-flow">
              <span>Ads</span>
              <i></i>
              <span>WhatsApp</span>
              <i></i>
              <span>CRM</span>
              <i></i>
              <span>Sales</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Notre système IA</span>
        <h2 id="system-title">Une stack IA qui exécute, mesure et sait quand passer la main.</h2>
        <p>
          Nous ne vendons pas un chatbot posé sur une page. Nous construisons des parcours d’automation
          connectés à vos objectifs : acquisition, qualification, service, relance, vente et reporting.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="tool-stack" aria-labelledby="tool-title">
      <div class="section-heading compact">
        <span class="eyebrow">Outils & intégrations</span>
        <h2 id="tool-title">La stack automation, CRM et reporting pour piloter vos scénarios.</h2>
      </div>
      <div class="logo-marquee" aria-label="Outils IA automation CRM et reporting">
        <div class="logo-track">
          {[0, 1].map((loopIndex) => (
            <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
              {automationTools.map((tool) => (
                <figure>
                  <span>
                    <img
                      src={`${logoBase}/${tool.logo}`}
                      alt={loopIndex === 0 ? `Logo ${tool.name}` : ''}
                      loading="eager"
                      decoding="async"
                    />
                  </span>
                  <figcaption>{tool.name}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {automationTools.map((tool) => (
          <figure>
            <span>
              <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
            </span>
            <figcaption>
              <strong>{tool.name}</strong>
              <small>{tool.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Méthode Richmedia</span>
          <h2 id="roadmap-title">Du diagnostic au scaling,<br />chaque automatisation est testée.</h2>
        </div>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="deliverables" class="deliverables-section" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Livrables</span>
        <h2 id="deliverables-title">Ce que vous recevez pour piloter sans boîte noire.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section id="sources" class="sources-section" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">Sources 2026</span>
        <h2 id="sources-title">Les signaux qui structurent notre approche IA & automation.</h2>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noreferrer">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Questions fréquentes sur l’IA, le CRM et l’automation.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="automation-cta" class="automation-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Parlons système</span>
        <h2 id="cta-title">Transformons vos conversations et leads en parcours automatisés.</h2>
        <p>
          Audit CRM, WhatsApp, agents IA, scoring, workflows et dashboards : nous cadrons les premières
          automatisations à impact business.
        </p>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact">
          Cadrer votre automation
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Automatiser l’acquisition et la conversion"
    intro="L’automation devient utile lorsqu’elle s’alimente en média, formulaires, WhatsApp, tracking et signaux CRM."
    links={frSiloLinks.conversion}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .automation-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 60, 255, 0.2), transparent 28rem),
      radial-gradient(circle at 12% 30%, rgba(124, 60, 255, 0.12), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
  }

