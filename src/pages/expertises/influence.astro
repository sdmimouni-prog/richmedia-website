---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import { SITE } from '../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';

const assetBase = '/assets/richmedia-influence';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/expertises/influence`;

const seoTitle = 'Agence influence à Casablanca — influenceurs marocains, UGC & ROI | Richmedia';
const seoDescription =
  'Richmedia pilote vos campagnes d’influence au Maroc : casting influenceurs, UGC, micro-créateurs, négociation, amplification paid, reporting ROI et brand safety.';

const influenceTools = [
  { name: 'Meta', logo: 'meta.svg', note: 'Instagram, Reels & paid social' },
  { name: 'TikTok / Social-first', logo: 'later.png', note: 'Formats courts & calendrier' },
  { name: 'Influencer Marketing Hub', logo: 'influencer-marketing-hub.png', note: 'Veille créateurs' },
  { name: 'Google Trends', logo: 'google-trends.png', note: 'Signaux de demande' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Conversions & parcours' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'Reporting ROI' },
  { name: 'Zapier', logo: 'zapier.svg', note: 'Automatisations & leads' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'UX post-clic' },
];

const proofCards = [
  {
    metric: 'Casting',
    title: 'Créateurs marocains qualifiés',
    text: 'Nous sélectionnons des profils alignés avec votre marque, leur audience réelle, leur territoire éditorial et leur capacité à produire du contenu crédible.',
  },
  {
    metric: 'UGC',
    title: 'Des contenus réutilisables',
    text: 'Les créateurs produisent des assets qui vivent sur leurs comptes, vos pages, vos landing pages et vos campagnes paid.',
  },
  {
    metric: 'Brand safety',
    title: 'Droits, briefs et conformité',
    text: 'Briefs, validations, mentions de partenariat, droits d’usage, exclusivité et garde-fous éditoriaux sont cadrés avant production.',
  },
  {
    metric: 'ROI',
    title: 'Mesure au-delà des likes',
    text: 'Nous suivons reach utile, engagement qualitatif, trafic, leads, ventes, codes promo, UTM, CPA et apprentissages créatifs.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    image: 'trends/trend-creator-economy.webp',
    label: 'Creator economy',
    title: 'L’influence devient média',
    text: 'Budgets, droits, brand safety et ROI se structurent.',
  },
  {
    image: 'trends/trend-micro-communautes.webp',
    label: 'Micro-communautés',
    title: 'Le bon créateur vaut mieux',
    text: 'Nano et micro-profils gagnent par proximité et crédibilité.',
  },
  {
    image: 'trends/trend-ugc-flywheel.webp',
    label: 'UGC flywheel',
    title: 'Le contenu nourrit le paid',
    text: 'Hooks, avis, vidéos et photos deviennent des assets ads.',
  },
  {
    image: 'trends/trend-long-term.webp',
    label: 'Long terme',
    title: 'Place aux ambassadeurs',
    text: 'Les séries et collaborations récurrentes créent plus de confiance.',
  },
  {
    image: 'trends/trend-ai-matching.webp',
    label: 'Matching IA',
    title: 'L’IA aide au matching',
    text: 'Le scoring accélère la shortlist, le jugement reste humain.',
  },
  {
    image: 'trends/trend-seo-geo.webp',
    label: 'SEO / GEO',
    title: 'Les campagnes deviennent citables',
    text: 'FAQ, preuves, avis et UGC renforcent Google et les moteurs IA.',
  },
];

const creatorProfiles = [
  {
    image: 'creator-lifestyle.webp',
    type: 'Lifestyle & beauty',
    city: 'Casablanca',
    title: 'Créatrice lifestyle premium',
    text: 'Idéale pour beauté, mode, retail, skincare, lancement produit et contenus Reels avec démonstration naturelle.',
    formats: ['Reels', 'Stories', 'UGC ads'],
  },
  {
    image: 'creator-food.webp',
    type: 'Food & family',
    city: 'Marrakech / Rabat',
    title: 'Créatrice food et quotidien',
    text: 'Parfaite pour FMCG, restauration, tourisme, famille, recettes, expériences locales et narration de proximité.',
    formats: ['Shorts', 'Recettes', 'Avis'],
  },
  {
    image: 'creator-urban.webp',
    type: 'Urban culture',
    city: 'Casablanca',
    title: 'Créateur sport, tech et culture urbaine',
    text: 'Pensé pour télécoms, apps, mobilité, sport, événementiel, jeunesse active et contenus dynamiques en extérieur.',
    formats: ['TikTok', 'Reels', 'Lives'],
  },
];

const services = [
  {
    kicker: 'Stratégie',
    title: 'Plan influence et architecture de campagne',
    text: 'Objectifs, audiences, territoires, messages, formats, calendrier, KPI, budget et rôle de chaque créateur dans le funnel.',
    items: ['Objectifs', 'Audiences', 'KPI', 'Budget'],
  },
  {
    kicker: 'Casting',
    title: 'Sélection d’influenceurs marocains',
    text: 'Shortlist qualifiée par audience, affinité marque, qualité de contenu, historique, tonalité, crédibilité et risque brand safety.',
    items: ['Nano', 'Micro', 'Macro', 'Niche'],
  },
  {
    kicker: 'Production',
    title: 'Briefs, scripts, UGC et validation',
    text: 'Brief créatif, hooks, claims, storytelling, formats verticaux, droits d’usage et contrôle qualité avant publication.',
    items: ['UGC', 'Reels', 'Stories', 'Scripts'],
  },
  {
    kicker: 'Performance',
    title: 'Amplification paid et reporting ROI',
    text: 'Boost des meilleurs contenus, tracking UTM, codes, dashboards, learnings, CPA, ventes et optimisation des prochaines vagues.',
    items: ['Paid boost', 'UTM', 'CPA', 'ROI'],
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Cadrage',
    text: 'Objectif business, audience, offre, contraintes réglementaires, budget, ton de marque et règles de validation.',
  },
  {
    step: '02',
    title: 'Casting',
    text: 'Shortlist, scoring, vérification qualitative, négociation, disponibilité, formats, droits et calendrier.',
  },
  {
    step: '03',
    title: 'Brief créatif',
    text: 'Message, angles, hooks, preuves, CTA, mentions obligatoires, livrables et liberté éditoriale maîtrisée.',
  },
  {
    step: '04',
    title: 'Activation',
    text: 'Production, validation, publication, monitoring temps réel, réponses communautaires et amplification paid.',
  },
  {
    step: '05',
    title: 'Mesure',
    text: 'Reporting reach utile, engagement, trafic, conversions, contenus gagnants, insights audience et recommandations.',
  },
];

const deliverables = [
  'Audit influence & concurrence',
  'Cartographie audiences Maroc',
  'Shortlist influenceurs qualifiés',
  'Scoring brand safety',
  'Brief créatif & angles de contenu',
  'Scripts, hooks et CTA',
  'Négociation & contrats',
  'Droits d’usage UGC',
  'Calendrier de publication',
  'Kit tracking UTM / codes',
  'Amplification paid des meilleurs posts',
  'Dashboard performance & ROI',
];

const sources = [
  {
    title: 'Kantar Marketing Trends 2026',
    text: 'Les créateurs doivent prouver leur impact ROI et marque, avec des plateformes créatives long terme, des garde-fous clairs et des métriques robustes.',
    href: 'https://www.kantar.com/campaigns/marketing-trends',
  },
  {
    title: 'Kantar North America 2026',
    text: 'Une majorité de marketeurs prévoit d’augmenter les investissements créateurs, mais le lien à la marque et la mesure restent le vrai sujet.',
    href: 'https://www.kantar.com/north-america/Company-news/Kantars-2026-Marketing-Trends',
  },
  {
    title: 'IAB Global Creator Week 2026',
    text: 'La creator economy se structure autour de la confiance, de la gouvernance, de l’impact mesurable et de la construction de marque.',
    href: 'https://www.iab.com/news/iab-global-creator-week-launches/',
  },
  {
    title: 'impact.com Influencer Trends 2026',
    text: 'Micro-créateurs, partenariats hybrides, matching IA, contenu réutilisable et responsabilité performance deviennent les standards des programmes influence.',
    href: 'https://impact.com/influencer/influencer-marketing-trends-performance/',
  },
];

const faq = [
  {
    question: 'Qu’est-ce qu’une agence d’influence au Maroc ?',
    answer:
      'Une agence d’influence au Maroc conçoit, sélectionne, négocie, pilote et mesure les collaborations avec des influenceurs marocains pour générer notoriété, contenu, trafic, leads ou ventes.',
  },
  {
    question: 'Comment Richmedia choisit les bons influenceurs ?',
    answer:
      'Nous analysons l’audience, le territoire éditorial, la qualité de contenu, l’engagement réel, la cohérence avec la marque, les risques brand safety, les formats disponibles et le potentiel de réutilisation UGC.',
  },
  {
    question: 'Faut-il travailler avec des nano, micro ou macro-influenceurs ?',
    answer:
      'Le choix dépend de l’objectif. Les nano et micro-créateurs sont utiles pour la confiance et les niches, les profils plus larges pour la portée, et les mix hybrides pour combiner crédibilité, volume et performance.',
  },
  {
    question: 'Comment mesure-t-on le ROI d’une campagne influence ?',
    answer:
      'Nous suivons les impressions utiles, l’engagement qualitatif, le trafic UTM, les codes promo, les leads, les ventes, le coût par résultat, la valeur UGC produite et les contenus qui méritent une amplification paid.',
  },
  {
    question: 'Pourquoi parler de SEO/GEO sur une page influence ?',
    answer:
      'Parce que les moteurs de recherche et les moteurs IA recoupent contenus, mentions, avis, FAQ, pages structurées et signaux sociaux. Une campagne influence bien documentée peut renforcer la découvrabilité de la marque.',
  },
];

const schema = [
  serviceSchema({
    name: 'Influence marketing',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Expertises', url: `${SITE.url}/expertises` },
    { name: 'Influence', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: 'Fit' },
  { href: '#trends', label: 'Signaux', value: '2026' },
  { href: '#creators', label: 'Créa', value: 'Profils' },
  { href: '#influence-cta', label: 'Projet', value: 'Activer' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/influence-hero.webp`}
  schema={schema}
>
  <div class="influence-page">
    <section class="influence-hero" aria-labelledby="influence-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="influence-title">Influence marocaine pensée pour vendre.</h1>
        <p class="hero-lead">
          Richmedia sélectionne, cadre, active et mesure vos campagnes avec des influenceurs marocains
          pertinents : contenu crédible, UGC réutilisable, amplification paid et reporting orienté ROI.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Cadrer une campagne influence
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir les cas clients
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual creator-hover-lab" aria-label="Campagne influence Richmedia au Maroc">
        <img src={`${assetBase}/influence-hero.webp`} alt="Équipe et créateurs marocains fictifs préparant une campagne d’influence" />
        <div class="signal-card signal-card-top">
          <span>Casting</span>
          <strong>Créateurs qualifiés</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>UGC</span>
          <strong>Contenus réutilisables</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>Mesure</span>
          <strong>ROI + brand lift</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-influence-nav" aria-label="Navigation de la page influence">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section id="cockpit" class="influence-cockpit" aria-label="Promesses influence Richmedia">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Creator cockpit</strong>
          <small>brand fit actif</small>
        </div>
        <div class="cockpit-zero">
          <span>FIT</span>
          <div>
            <p>{proofCards[0].metric} qualifié</p>
            <h2>Le bon créateur, les bons droits et les bons indicateurs avant activation.</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 92%">
            <span>Audience réelle vérifiée</span>
            <i></i>
          </div>
          <div style="--value: 86%">
            <span>Droits UGC cadrés</span>
            <i></i>
          </div>
          <div style="--value: 78%">
            <span>Tracking ROI prêt</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="answer" class="quick-answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Réponse rapide</span>
        <h2 id="quick-answer-title">En 2026, l’influence performe mieux quand elle est structurée.</h2>
      </div>
      <p>
        Richmedia transforme l’influence en levier mesurable : bon casting, brief clair, contenus UGC,
        amplification paid et reporting business.
      </p>
    </section>

    <section id="trends" class="trend-section" aria-labelledby="trend-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Tendances influence 2026</span>
          <h2 id="trend-title">Ce que les marques doivent<br />maîtriser maintenant.</h2>
        </div>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <div class="trend-media">
              <img src={`${assetBase}/${trend.image}`} alt={trend.title} loading="eager" decoding="async" />
            </div>
            <div class="trend-copy">
              <span>{trend.label}</span>
              <h3>{trend.title}</h3>
              <p>{trend.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="creators" class="creator-section" aria-labelledby="creator-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Réseau créateurs</span>
          <h2 id="creator-title">Des profils marocains adaptés au message,<br />pas seulement à la portée.</h2>
        </div>
      </div>
      <div class="creator-grid">
        {creatorProfiles.map((creator) => (
          <article>
            <div class="creator-photo">
              <img src={`${assetBase}/${creator.image}`} alt={`${creator.title} à ${creator.city}`} loading="eager" decoding="async" />
            </div>
            <div class="creator-copy">
              <span>{creator.type} · {creator.city}</span>
              <h3>{creator.title}</h3>
              <p>{creator.text}</p>
              <div>
                {creator.formats.map((format) => <small>{format}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="system" class="influence-system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-top">
            <span></span><span></span><span></span>
            <strong>richmedia / creator-growth</strong>
          </div>
          <div class="screen-body">
            <div class="creator-card creator-card-a">
              <span>match_score</span>
              <strong>Audience fit 92%</strong>
              <small>Beauté · Casablanca · Reels</small>
            </div>
            <div class="creator-card creator-card-b">
              <span>ugc_rights</span>
              <strong>Paid boost ready</strong>
              <small>3 hooks · 5 assets · 30 jours</small>
            </div>
            <div class="influence-flow">
              <span>Brief</span>
              <i></i>
              <span>Créateur</span>
              <i></i>
              <span>ROI</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Notre système influence</span>
        <h2 id="system-title">Une agence influence qui relie créateurs, média et données.</h2>
        <p>
          Nous ne livrons pas une liste d’influenceurs. Nous construisons une mécanique complète :
          choix des bons profils, brief, droits, production, publication, amplification et reporting exploitable
          par les équipes marketing, commerce et direction.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="tool-stack" aria-labelledby="tool-title">
      <div class="section-heading compact">
        <span class="eyebrow">Partenaires & outils</span>
        <h2 id="tool-title">La stack pour piloter influence, UGC, tracking et amplification.</h2>
      </div>
      <div class="logo-marquee" aria-label="Outils influence et performance">
        <div class="logo-track">
          {[0, 1].map((loopIndex) => (
            <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
              {influenceTools.map((tool) => (
                <figure>
                  <span>
                    <img
                      src={`${logoBase}/${tool.logo}`}
                      alt={`Logo ${tool.name}`}
                      loading="eager"
                      decoding="async"
                    />
                  </span>
                  <figcaption>{tool.name}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {influenceTools.map((tool) => (
          <figure>
            <span>
              <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
            </span>
            <figcaption>
              <strong>{tool.name}</strong>
              <small>{tool.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Méthode Richmedia</span>
          <h2 id="roadmap-title">Du casting au reporting,<br />chaque décision est pilotée.</h2>
        </div>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="deliverables" class="deliverables-section" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Livrables</span>
        <h2 id="deliverables-title">Ce que vous recevez pour piloter sans zone floue.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section id="sources" class="sources-section" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">Veille 2026</span>
        <h2 id="sources-title">Les signaux de marché intégrés à notre approche.</h2>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noopener">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
            <small>Lire la source <i class="ph ph-arrow-up-right" aria-hidden="true"></i></small>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Questions fréquentes.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="influence-cta" class="influence-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Prêt à activer ?</span>
        <h2 id="cta-title">Lancez une campagne influence avec des créateurs crédibles et une mesure claire.</h2>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact">
          Parler à Richmedia
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Relier influence, contenu et amplification"
    intro="Une campagne influence est plus forte lorsqu’elle s’intègre au brand content, au média paid et aux objectifs sectoriels."
    links={frSiloLinks.influence}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .influence-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 60, 255, 0.18), transparent 28rem),
      radial-gradient(circle at 12% 30%, rgba(124, 60, 255, 0.1), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
  }

  .influence-hero,
  .mobile-influence-nav,
  .influence-cockpit,
  .quick-answer,
  .trend-section,
  .creator-section,
  .influence-system,
  .tool-stack,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .influence-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .influence-cockpit,
  .quick-answer,
  .trend-section,
  .creator-section,
  .influence-system,
  .tool-stack,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
