    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .signal-card strong {
    font-size: clamp(0.96rem, 1.2vw, 1.12rem);
  }

  .signal-card-top {
    top: 8%;
    left: 7%;
  }

  .signal-card-middle {
    right: 7%;
    bottom: 28%;
  }

  .signal-card-bottom {
    bottom: 8%;
    left: 9%;
  }

  .hero-visual:hover .signal-card,
  .hero-visual:focus-within .signal-card {
    border-color: rgba(205, 180, 255, 0.64);
    background: rgba(7, 8, 18, 0.82);
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.4), 0 0 1.6rem rgba(124, 60, 255, 0.14);
  }

  .hero-visual:hover .signal-card-top,
  .hero-visual:focus-within .signal-card-top {
    transform: translate3d(-0.55rem, -0.45rem, 2rem);
  }

  .hero-visual:hover .signal-card-middle,
  .hero-visual:focus-within .signal-card-middle {
    transform: translate3d(0.65rem, -0.35rem, 2rem);
  }

  .hero-visual:hover .signal-card-bottom,
  .hero-visual:focus-within .signal-card-bottom {
    transform: translate3d(0.4rem, 0.55rem, 2rem);
  }

  .influence-cockpit {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 0.9rem;
    align-items: stretch;
    margin-top: -2.7rem;
