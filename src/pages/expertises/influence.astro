  .influence-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    min-height: 94vh;
    padding: clamp(7rem, 11vw, 10rem) 0 5rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-2);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.1rem;
    height: 2px;
    content: "";
    background: var(--purple-2);
  }

  .hero-copy h1 {
    --h1-size: clamp(2.75rem, 5.2vw, 3.125rem);
    max-width: 760px;
    margin-top: 1.1rem;
    font-size: var(--h1-size);
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero-copy p,
  .section-heading p,
  .quick-answer p,
  .system-copy > p,
  .influence-cta p {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.7;
  }

  .hero-lead {
    max-width: 690px;
    margin-top: 1.45rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    border-radius: 8px;
    padding: 0.9rem 1.25rem;
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9655ff, #6425f4);
    box-shadow: 0 1.1rem 2.8rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-visual {
    position: relative;
    isolation: isolate;
    justify-self: end;
    overflow: hidden;
    width: min(100%, 780px);
    min-height: clamp(420px, 35vw, 560px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background: #07080d;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.42);
    transform: perspective(1100px) rotateX(0deg) rotateY(0deg) translateZ(0);
    transform-style: preserve-3d;
    transition:
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 520ms ease,
      box-shadow 520ms ease,
      filter 520ms ease;
    will-change: transform;
  }

  .hero-visual::before,
  .hero-visual::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
  }

  .hero-visual::before {
    background:
      radial-gradient(circle at 68% 20%, rgba(255, 255, 255, 0.2), transparent 14rem),
      radial-gradient(circle at 20% 84%, rgba(169, 119, 255, 0.18), transparent 15rem),
      linear-gradient(115deg, transparent 0 42%, rgba(255, 255, 255, 0.16) 48%, transparent 55%);
    opacity: 0;
    transform: translate3d(-8%, 4%, 0);
    transition: opacity 520ms ease, transform 720ms ease;
    mix-blend-mode: screen;
  }

  .hero-visual::after {
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.13) 1px, transparent 1px),
      linear-gradient(0deg, rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 520ms ease, transform 720ms ease;
    mask-image: radial-gradient(circle at 70% 26%, #000 0 11rem, transparent 17rem);
  }

  .hero-visual:hover,
  .hero-visual:focus-within {
    border-color: rgba(169, 119, 255, 0.48);
    box-shadow:
      0 1.5rem 4.2rem rgba(0, 0, 0, 0.46),
      0 0 4rem rgba(124, 60, 255, 0.14);
    transform: perspective(1100px) rotateX(2deg) rotateY(-4deg) translate3d(0, -0.45rem, 0);
  }

  .hero-visual:hover::before,
  .hero-visual:focus-within::before {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .hero-visual:hover::after,
  .hero-visual:focus-within::after {
    opacity: 0.22;
    transform: scale(1);
  }

  .hero-visual img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center;
    filter: saturate(1.03) contrast(1.02);
    transform: scale(1.01);
    transition: transform 720ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 520ms ease;
  }

  .hero-visual:hover img,
  .hero-visual:focus-within img {
    filter: saturate(1.08) contrast(1.04) brightness(1.04);
    transform: scale(1.045) translate3d(0.35rem, -0.25rem, 0);
  }

  .signal-card {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
    width: min(15rem, 44%);
    border: 1px solid rgba(169, 119, 255, 0.35);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    background: rgba(4, 6, 14, 0.72);
    box-shadow: 0 1rem 2.8rem rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(12px);
    transition:
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 520ms ease,
      background 520ms ease,
      box-shadow 520ms ease;
  }

  .signal-card span {
    color: var(--purple-2);
