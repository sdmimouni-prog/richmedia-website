  .system-copy {
    padding: clamp(1.1rem, 2.4vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 0 0, rgba(124, 60, 255, 0.18), transparent 21rem),
      rgba(255, 255, 255, 0.025);
