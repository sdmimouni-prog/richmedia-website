    .button,
    .hero-visual,
    .hero-visual::before,
    .hero-visual img,
    .signal-card,
    .trend-grid article,
    .roadmap article,
    .service-grid article,
    .cockpit-feed article,
    .activation-grid article,
    .activation-photo img,
    .tool-grid figure,
    .source-grid a,
    .deliverables-grid span {
      transition: none !important;
    }

    .hero-visual:hover,
    .hero-visual:focus-within,
    .hero-visual:hover img,
    .hero-visual:focus-within img,
    .hero-visual:hover .signal-card,
    .hero-visual:focus-within .signal-card {
      transform: none !important;
