  .hero-visual {
    position: relative;
    isolation: isolate;
    justify-self: end;
    overflow: hidden;
    width: min(100%, 780px);
    min-height: clamp(420px, 35vw, 560px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background: #07080d;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.42);
    transform: perspective(1100px) rotateX(0deg) rotateY(0deg) translateZ(0);
    transform-style: preserve-3d;
    transition:
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 520ms ease,
      box-shadow 520ms ease,
      filter 520ms ease;
    will-change: transform;
  }

  .hero-visual::before,
  .hero-visual::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
  }

  .hero-visual::before {
    background:
      radial-gradient(circle at 60% 46%, rgba(255, 255, 255, 0.18), transparent 13rem),
      radial-gradient(circle at 22% 18%, rgba(169, 119, 255, 0.18), transparent 15rem),
      linear-gradient(115deg, transparent 0 42%, rgba(255, 255, 255, 0.16) 48%, transparent 55%);
    opacity: 0;
    transform: translate3d(-8%, 4%, 0);
    transition: opacity 520ms ease, transform 720ms ease;
    mix-blend-mode: screen;
  }

  .hero-visual::after {
    inset: -18% auto -18% -30%;
    width: 26%;
    background:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent),
      linear-gradient(90deg, transparent, rgba(169, 119, 255, 0.24), transparent);
    opacity: 0;
    transform: skewX(-18deg) translateX(0);
  }

  .hero-visual:hover,
  .hero-visual:focus-within {
    border-color: rgba(169, 119, 255, 0.48);
    box-shadow:
      0 1.5rem 4.2rem rgba(0, 0, 0, 0.46),
      0 0 4rem rgba(124, 60, 255, 0.14);
    transform: perspective(1100px) rotateX(2deg) rotateY(-4deg) translate3d(0, -0.45rem, 0);
  }

  .hero-visual:hover::before,
  .hero-visual:focus-within::before {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .hero-visual:hover::after,
  .hero-visual:focus-within::after {
    animation: phygital-scan-pass 980ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-visual img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: 58% center;
    filter: saturate(1.03) contrast(1.02);
    transform: scale(1.01);
    transition: transform 720ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 520ms ease;
  }

  .hero-visual:hover img,
