    padding: 1rem;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .logo-marquee {
    position: relative;
    overflow: hidden;
    margin-top: 1.3rem;
    padding-block: 0.12rem;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .logo-marquee::before,
  .logo-marquee::after {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 2;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, rgba(169, 119, 255, 0.42), transparent);
    pointer-events: none;
  }

  .logo-marquee::before {
    top: 0;
  }

  .logo-marquee::after {
    bottom: 0;
  }

  .logo-track {
    display: flex;
    width: max-content;
    animation: logo-news-ticker 30s linear infinite;
    will-change: transform;
  }

  .logo-track-segment {
    display: flex;
    flex: 0 0 auto;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }

  .logo-marquee figure,
  .tool-grid figure {
    display: grid;
    align-content: center;
    justify-items: center;
    min-width: 0;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 0, rgba(255, 255, 255, 0.08), transparent 50%),
      rgba(5, 7, 15, 0.88);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .logo-marquee figure {
    flex: 0 0 clamp(7.4rem, 8.4vw, 8.8rem);
    min-height: 5.85rem;
    padding: 0.6rem;
  }

  .logo-marquee span,
  .tool-grid span {
    display: grid;
    place-items: center;
    width: 100%;
    border-radius: 7px;
    background: #f7f7fb;
  }

  .logo-marquee span {
    height: 3.1rem;
  }

  .logo-marquee img {
    width: 78%;
    height: 2.1rem;
    object-fit: contain;
  }

  .logo-marquee figcaption {
    margin-top: 0.45rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .tool-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .tool-grid figure {
    grid-template-columns: 4.4rem minmax(0, 1fr);
    align-items: center;
    justify-items: start;
    gap: 1rem;
    min-height: 6.2rem;
    padding: 1rem;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .tool-grid figure:hover {
    border-color: rgba(124, 60, 255, 0.5);
    background: rgba(124, 60, 255, 0.09);
    transform: translateY(-3px);
  }

  .tool-grid span {
    height: 4rem;
  }

  .tool-grid img {
    width: 76%;
    max-height: 2.3rem;
    object-fit: contain;
  }

  .tool-grid figcaption {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .tool-grid strong {
    font-size: 0.96rem;
  }

  .tool-grid small {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .roadmap {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .deliverables-grid {
    counter-reset: deliverable;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 1.2rem;
  }

  .deliverables-grid span {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    counter-increment: deliverable;
    min-height: 3.2rem;
    padding: 0.75rem 3rem 0.75rem 0.9rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.042), rgba(255, 255, 255, 0.018)),
      rgba(255, 255, 255, 0.025);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
    transition:
      transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 260ms ease,
      background 260ms ease,
      box-shadow 260ms ease,
      color 260ms ease,
      opacity 260ms ease;
  }

  .deliverables-grid span::after {
    position: absolute;
    top: 50%;
    right: 0.9rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    content: counter(deliverable, decimal-leading-zero);
    border: 1px solid rgba(169, 119, 255, 0.22);
    border-radius: 50%;
    background: rgba(124, 60, 255, 0.08);
    color: rgba(169, 119, 255, 0.78);
    font-size: 0.58rem;
    font-weight: 900;
    line-height: 1;
    transform: translateY(-50%) scale(0.82);
    transition: transform 260ms ease, border-color 260ms ease, background 260ms ease, color 260ms ease;
  }

  .deliverables-grid:hover span:not(:hover) {
    opacity: 0.62;
  }

  .deliverables-grid span:hover {
    border-color: rgba(169, 119, 255, 0.58);
    background:
      linear-gradient(135deg, rgba(124, 60, 255, 0.16), rgba(255, 255, 255, 0.03)),
      rgba(255, 255, 255, 0.035);
    box-shadow: 0 1rem 2.6rem rgba(0, 0, 0, 0.28), 0 0 2.2rem rgba(124, 60, 255, 0.14);
    color: #fff;
    transform: translateY(-5px);
  }

  .deliverables-grid span:hover::after {
    border-color: rgba(200, 169, 255, 0.68);
    background: rgba(124, 60, 255, 0.24);
    color: #fff;
    transform: translateY(-50%) scale(1);
  }

  .source-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.2rem;
  }

  .source-grid a {
    display: grid;
    align-content: start;
    min-height: 13.5rem;
    padding: 1.1rem;
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .source-grid a:hover {
    border-color: rgba(124, 60, 255, 0.5);
    background: rgba(124, 60, 255, 0.1);
    transform: translateY(-3px);
  }

  .source-grid strong {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .source-grid small {
    align-self: end;
    margin-top: 1rem;
    color: var(--purple-2);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.2rem;
  }

  .faq-list details {
    padding: 1rem 1.1rem;
  }

  .faq-list summary {
    cursor: pointer;
    font-weight: 850;
    line-height: 1.35;
  }

  .phygital-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    margin-bottom: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.4rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at 8% 10%, rgba(124, 60, 255, 0.28), transparent 24rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.022));
  }

  .phygital-cta h2 {
    max-width: 820px;
    margin-top: 0.85rem;
  }

  .phygital-cta .hero-actions {
    justify-content: flex-end;
    margin-top: 0;
  }

  @keyframes panel-sweep {
    from {
      transform: translateX(-48%);
    }

    to {
      transform: translateX(48%);
    }
  }

  @keyframes logo-news-ticker {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes phygital-scan-pass {
    0% {
      opacity: 0;
      transform: skewX(-18deg) translateX(0);
    }

    18% {
      opacity: 0.9;
    }

    100% {
      opacity: 0;
      transform: skewX(-18deg) translateX(520%);
    }
  }

  @keyframes cockpit-scan {
    0%,
    100% {
      transform: translate3d(-1.3rem, 0, 0) rotate(8deg);
      opacity: 0.34;
    }

    50% {
      transform: translate3d(2.8rem, 0, 0) rotate(8deg);
      opacity: 0.88;
    }
  }

  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(159, 107, 255, 0.52);
    }

    70% {
      box-shadow: 0 0 0 0.55rem rgba(159, 107, 255, 0);
    }

    100% {
      box-shadow: 0 0 0 0 rgba(159, 107, 255, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen-frame::after,
    .hero-visual::after,
    .logo-track,
    .cockpit-main::after,
    .cockpit-topline span {
      animation: none !important;
