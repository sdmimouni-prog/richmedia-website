---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import { SITE } from '../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';

const assetBase = '/assets/richmedia-phygital';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/expertises/phygital`;

const seoTitle = 'Agence phygital au Maroc | Richmedia';
const seoDescription =
  'Reliez activation terrain, retail, QR/NFC, sampling, gamification, collecte de leads et reporting pour mesurer l’impact réel.';

const phygitalTools = [
  { name: 'Google Tag Manager', logo: 'google-tag-manager.svg', note: 'QR, événements & tracking' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Parcours & conversions' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'Dashboard activation' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'UX post-scan' },
  { name: 'Zapier', logo: 'zapier.svg', note: 'Leads vers CRM' },
  { name: 'Meta', logo: 'meta.svg', note: 'Amplification sociale' },
  { name: 'Google Trends', logo: 'google-trends.png', note: 'Signaux locaux' },
  { name: 'JavaScript', logo: 'javascript.svg', note: 'Expériences web' },
];

const proofCards = [
  {
    metric: 'Terrain',
    title: 'Des activations qui arrêtent vraiment les passants',
    text: 'Nous concevons des dispositifs street marketing clairs, visibles et humains : ambassadeurs, stands, sampling, démonstrations et parcours rapides.',
  },
  {
    metric: 'QR / NFC',
    title: 'Chaque interaction devient mesurable',
    text: 'Scan, jeu, coupon, formulaire, WhatsApp ou page mobile : le terrain nourrit une donnée exploitable par vos équipes marketing et commerciales.',
  },
  {
    metric: 'Retail',
    title: 'Pop-up, point de vente et commerce connecté',
    text: 'Nous relions activation, disponibilité produit, offre locale, CRM, retargeting et contenus sociaux pour prolonger l’impact après le passage.',
  },
  {
    metric: 'ROI',
    title: 'Reporting terrain, pas seulement photos d’événement',
    text: 'Trafic généré, leads opt-in, scans, participation, coupons, ventes, UGC, coût par contact et insights sont suivis pour décider la suite.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    label: 'Hybrid by design',
    title: 'Le physique doit avoir une extension digitale native',
    text: 'En 2026, une activation terrain performante se pense avec QR, contenus sociaux, CRM, retargeting, coupons et parcours mobile dès le concept.',
  },
  {
    label: 'Participation',
    title: 'Les passants veulent faire, pas seulement regarder',
    text: 'Jeux, défis, essais produit, badges, roue, instant win et contenus partageables augmentent le temps passé, la mémorisation et l’UGC.',
  },
  {
    label: 'First-party data',
    title: 'La donnée consentie devient un livrable majeur',
    text: 'Un dispositif phygital doit collecter des signaux utiles : préférences, opt-in, localisation, participation, intent et qualité des leads.',
  },
  {
    label: 'Unified commerce',
    title: 'Le retail connecté remplace les expériences isolées',
    text: 'Stocks, POS, CRM, e-commerce, service client et campagnes doivent parler ensemble pour que le client passe naturellement du stand à l’achat.',
  },
  {
    label: 'Micro-expériences',
    title: 'Les formats locaux battent souvent les gros dispositifs figés',
    text: 'Tournées, pop-ups légers, campus, malls, plages, gares et quartiers à fort trafic permettent de tester, apprendre et scaler avec précision.',
  },
  {
    label: 'SEO / GEO',
    title: 'L’activation doit laisser une trace citable par les moteurs IA',
    text: 'Landing pages, FAQ, preuves, données structurées, contenus terrain et mentions locales renforcent la découverte Google et les réponses génératives.',
  },
];

const activationFormats = [
  {
    image: 'activation-sampling.webp',
    type: 'Sampling connecté',
    place: 'Rue commerçante',
    title: 'Faire tester, scanner, convertir',
    text: 'Stand mobile, offre instantanée, QR opt-in, coupon, WhatsApp, tracking et relance CRM après l’essai produit.',
    formats: ['Sampling', 'Coupon', 'Lead opt-in'],
  },
  {
    image: 'activation-game.webp',
    type: 'Gamification terrain',
    place: 'Mall / place publique',
    title: 'Transformer l’arrêt en participation',
    text: 'Roue, challenge, badge digital, instant win, leaderboard ou photo moment pour créer engagement et contenus partageables.',
    formats: ['Jeu', 'QR/NFC', 'UGC'],
  },
  {
    image: 'activation-popup.webp',
    type: 'Pop-up retail',
    place: 'Casablanca / Marrakech',
    title: 'Créer un point de contact premium',
    text: 'Booth modulaire, démonstration, écran, check-in, staffing et parcours post-scan pour relier expérience et commerce.',
    formats: ['Pop-up', 'Demo', 'Retail media'],
  },
];

const services = [
  {
    kicker: 'Concept',
    title: 'Stratégie phygital et mécanique d’activation',
    text: 'Objectifs, cible, lieu, message, parcours, incitation, mécanique QR/NFC, plan social et KPI terrain avant toute production.',
    items: ['Parcours', 'Concept', 'KPI', 'Budget'],
  },
  {
    kicker: 'Production',
    title: 'Street marketing, pop-up et logistique terrain',
    text: 'Stands, signalétique, sampling, ambassadeurs, autorisations, planning, fiches mission, coordination et supervision live.',
    items: ['Booth', 'Sampling', 'Staff', 'Ops'],
  },
  {
    kicker: 'Data',
    title: 'QR, NFC, landing pages et CRM',
    text: 'Pages mobiles, formulaires, UTM, tracking, opt-in, WhatsApp, coupons, dashboards et connexion aux outils commerciaux.',
    items: ['QR/NFC', 'CRM', 'UTM', 'Coupons'],
  },
  {
    kicker: 'Amplification',
    title: 'Social, influence et retargeting post-activation',
    text: 'Captation, contenus social-first, influence locale, paid social, retargeting et reporting pour prolonger l’expérience au-delà du terrain.',
    items: ['UGC', 'Paid', 'Influence', 'ROI'],
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Cadrage',
    text: 'Objectif, cible, lieux, flux, offre, saisonnalité, contraintes terrain, données disponibles et règles de marque.',
  },
  {
    step: '02',
    title: 'Concept',
    text: 'Mécanique d’arrêt, story, parcours QR/NFC, incentive, contenus sociaux, architecture de données et KPI mesurables.',
  },
  {
    step: '03',
    title: 'Production',
    text: 'Booth, signalétique, scripts ambassadeurs, autorisations, matériel, landing pages, tracking et répétition terrain.',
  },
  {
    step: '04',
    title: 'Activation',
    text: 'Déploiement, supervision, contrôle qualité, ajustements live, captation, remontées terrain et optimisation des flux.',
  },
  {
    step: '05',
    title: 'Mesure',
    text: 'Dashboard, scans, leads, coupons, ventes, contenu généré, feedback public, coût par interaction et recommandations de scaling.',
  },
];

const deliverables = [
  'Audit terrain & concurrence',
  'Concept d’activation phygital',
  'Parcours QR/NFC ou WhatsApp',
  'Plan de lieux & flux',
  'Brief ambassadeurs',
  'Design du booth & signalétique',
  'Landing page mobile',
  'Formulaires opt-in & coupons',
  'Kit tracking UTM / événements',
  'Plan social & influence locale',
  'Dashboard performance terrain',
  'Bilan ROI & recommandations',
];

const sources = [
  {
    title: 'Shopify Omnichannel Retail 2026',
    text: 'Les parcours clients passent entre canaux physiques et digitaux, avec donnée client, stock, commande et service connectés en coulisse.',
    href: 'https://www.shopify.com/il/enterprise/blog/omni-channel-retail-strategy',
  },
  {
    title: 'Shopify Digital Transformation 2026',
    text: 'Le commerce unifié devient la base du phygital : une seule donnée temps réel pour magasins, e-commerce, POS et nouveaux canaux.',
    href: 'https://www.shopify.com/blog/digital-transformation-trends-in-retail',
  },
  {
    title: 'commercetools Commerce Megatrends',
    text: 'Le commerce unifié transforme les magasins en showrooms immersifs, hubs de service et points de contact personnalisés.',
    href: 'https://commercetools.com/blog/trends-that-define-retail-success',
  },
  {
    title: 'Cvent Experiential Marketing 2026',
    text: 'L’expérientiel gagne en maturité : budget, engagement, formats hybrides, technologie et mesure deviennent des standards.',
    href: 'https://www.cvent.com/en/blog/events/experiential-marketing-statistics',
  },
  {
    title: 'Farias Experiential Trends 2026',
    text: 'Les expériences hybrides, micro-expériences, données en temps réel, durabilité et communauté redéfinissent les activations.',
    href: 'https://farias.co/insights/experiential-marketing-trends-2026',
  },
  {
    title: 'Seeker Experiential Trends 2026',
    text: 'La participation active, la donnée first-party, l’IA, la gamification et les formats hybrides structurent les activations modernes.',
    href: 'https://seeker.io/blog/experiential-marketing-trends/',
  },
];

const faq = [
  {
    question: 'Qu’est-ce qu’une agence phygital ?',
    answer:
      'Une agence phygital conçoit des expériences qui relient terrain et digital : street marketing, pop-up, QR/NFC, landing pages, CRM, données, contenus sociaux et reporting pour transformer une interaction physique en parcours mesurable.',
  },
  {
    question: 'Quelle différence entre street marketing et phygital ?',
    answer:
      'Le street marketing crée le contact physique. Le phygital ajoute une couche digitale mesurable : scan QR, inscription, coupon, WhatsApp, jeu, contenu social, retargeting et suivi CRM.',
  },
  {
    question: 'Comment mesurer le ROI d’une activation phygital ?',
    answer:
      'Nous suivons notamment le trafic, les scans, les participations, les leads opt-in, les coupons utilisés, les ventes, le coût par contact, les contenus générés, la qualité des leads et les insights terrain.',
  },
  {
    question: 'Quels formats phygital sont pertinents au Maroc ?',
    answer:
      'Les formats les plus efficaces incluent sampling connecté, pop-up retail, activation mall, campus, plage, tournée urbaine, jeu QR/NFC, WhatsApp couponing, showroom mobile et contenus social-first.',
  },
  {
    question: 'Pourquoi optimiser une page phygital pour le SEO/GEO ?',
    answer:
      'Parce que les moteurs de recherche et les moteurs IA citent les pages claires, structurées et crédibles. FAQ, données structurées, preuves, sources et contenus locaux renforcent la découvrabilité de l’offre.',
  },
];

const schema = [
  serviceSchema({
    name: 'Phygital et street marketing',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Expertises', url: `${SITE.url}/expertises` },
    { name: 'Phygital', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: 'Live' },
  { href: '#trends', label: 'Signaux', value: '2026' },
  { href: '#formats', label: 'Formats', value: 'Terrain' },
  { href: '#phygital-cta', label: 'Projet', value: 'Activer' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/phygital-hero.webp`}
  schema={schema}
>
  <div class="phygital-page">
    <section class="phygital-hero" aria-labelledby="phygital-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="phygital-title">Phygital & street marketing mesurables.</h1>
        <p class="hero-lead">
          Richmedia crée des activations terrain qui connectent la rue, le retail, le mobile, le CRM et la donnée :
          sampling, pop-up, QR/NFC, gamification, contenus sociaux et reporting ROI.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Concevoir une activation
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir les cas clients
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual phygital-hover-lab" aria-label="Activation street marketing phygital Richmedia">
        <img
          src={`${assetBase}/phygital-hero.webp`}
          alt="Activation street marketing phygital avec stand, QR code et ambassadeurs de marque"
          width="1568"
          height="1003"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="signal-card signal-card-top">
          <span>Street</span>
          <strong>Stand + ambassadeurs</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>Scan</span>
          <strong>QR / NFC / WhatsApp</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>Données</span>
          <strong>Leads + coupons</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-phygital-nav" aria-label="Navigation de la page phygital">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section id="cockpit" class="phygital-cockpit" aria-label="Promesses phygital Richmedia">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Cockpit terrain</strong>
          <small>activation en direct</small>
        </div>
        <div class="cockpit-zero">
          <span>LIVE</span>
          <div>
            <p>{proofCards[0].metric} activé</p>
            <h2>Créer l’arrêt, capter le signal et relier le terrain au CRM.</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 91%">
            <span>Flux terrain qualifié</span>
            <i></i>
          </div>
          <div style="--value: 84%">
            <span>Scans QR / NFC exploitables</span>
            <i></i>
          </div>
          <div style="--value: 76%">
            <span>Leads et coupons suivis</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="answer" class="quick-answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Réponse rapide</span>
        <h2 id="quick-answer-title">En 2026, une activation terrain doit créer de l’attention utile.</h2>
      </div>
      <p>
        Le phygital relie terrain, mobile, CRM et mesure pour transformer une interaction réelle en signal exploitable.
      </p>
    </section>

    <section id="trends" class="trend-section" aria-labelledby="trend-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Tendances phygital 2026</span>
          <h2 id="trend-title">Ce que les marques doivent<br />maîtriser maintenant.</h2>
        </div>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="formats" class="activation-section" aria-labelledby="activation-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Formats terrain</span>
          <h2 id="activation-title">Des activations terrain conçues<br />pour être vécues et partagées.</h2>
        </div>
      </div>
      <div class="activation-grid">
        {activationFormats.map((activation) => (
          <article>
            <div class="activation-photo">
              <img src={`${assetBase}/${activation.image}`} alt={`${activation.title} - ${activation.place}`} loading="lazy" decoding="async" />
            </div>
            <div class="activation-copy">
              <span>{activation.type} · {activation.place}</span>
              <h3>{activation.title}</h3>
              <p>{activation.text}</p>
              <div>
                {activation.formats.map((format) => <small>{format}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="system" class="phygital-system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-top">
            <span></span><span></span><span></span>
            <strong>richmedia / field-growth</strong>
          </div>
          <div class="screen-body">
            <div class="data-card data-card-a">
              <span>live_scan_rate</span>
              <strong>1 248 interactions</strong>
              <small>QR · coupon · WhatsApp · CRM</small>
            </div>
            <div class="data-card data-card-b">
              <span>field_roi</span>
              <strong>Leads qualifiés +32%</strong>
              <small>Tracking UTM · dashboard · retargeting</small>
            </div>
            <div class="phygital-flow">
              <span>Rue</span>
              <i></i>
              <span>Mobile</span>
              <i></i>
              <span>CRM</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Notre système phygital</span>
        <h2 id="system-title">Une agence phygital qui relie production terrain, digital et performance.</h2>
        <p>
          Nous orchestrons la totalité de l’activation : stratégie, concept, production, équipes terrain,
          expérience mobile, tracking, contenus, amplification et reporting. Le résultat : une présence physique
          qui continue à travailler après l’événement.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="tool-stack" aria-labelledby="tool-title">
      <div class="section-heading compact">
        <span class="eyebrow">Outils & mesure</span>
        <h2 id="tool-title">La stack qui transforme une activation terrain en données exploitables.</h2>
      </div>
      <div class="logo-marquee" aria-label="Outils phygital, tracking et reporting">
        <div class="logo-track">
          {[0, 1].map((loopIndex) => (
            <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
              {phygitalTools.map((tool) => (
                <figure>
                  <span>
                    <img
                      src={`${logoBase}/${tool.logo}`}
                      alt={`Logo ${tool.name}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <figcaption>{tool.name}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {phygitalTools.map((tool) => (
          <figure>
            <span>
              <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
            </span>
            <figcaption>
              <strong>{tool.name}</strong>
              <small>{tool.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Méthode Richmedia</span>
          <h2 id="roadmap-title">Du concept terrain au dashboard, chaque étape est maîtrisée.</h2>
        </div>
        <p>
          Notre méthode sécurise le terrain, fluidifie l’expérience utilisateur, équipe les ambassadeurs et donne
          aux équipes marketing une lecture claire de l’impact.
        </p>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="deliverables" class="deliverables-section" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Livrables</span>
        <h2 id="deliverables-title">Ce que vous recevez pour piloter le terrain sans zone floue.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section id="sources" class="sources-section" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">Veille 2026</span>
        <h2 id="sources-title">Les signaux de marché intégrés à notre approche.</h2>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noopener">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
            <small>Lire la source <i class="ph ph-arrow-up-right" aria-hidden="true"></i></small>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Questions fréquentes.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="phygital-cta" class="phygital-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Prêt à activer le terrain ?</span>
        <h2 id="cta-title">Transformez vos contacts physiques en parcours digitaux mesurables.</h2>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact">
          Parler à Richmedia
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Connecter terrain, média et CRM"
    intro="Les activations phygitales performent lorsqu’elles relient trafic, points de vente, QR, WhatsApp et mesure."
    links={frSiloLinks.phygital}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .phygital-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 60, 255, 0.18), transparent 28rem),
      radial-gradient(circle at 12% 30%, rgba(124, 60, 255, 0.1), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
