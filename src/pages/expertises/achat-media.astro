---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import { SITE } from '../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';

const assetBase = '/assets/richmedia-achat-media';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/expertises/achat-media`;

const seoTitle = 'Agence achat média à Casablanca — Google Ads, Meta Ads & performance | Richmedia';
const seoDescription =
  'Richmedia pilote vos campagnes d’achat média à Casablanca : Google Ads, Meta Ads, programmatique, tracking, budgets ouverts, traffic managers certifiés et optimisation ROAS/CPA.';

const mediaTools = [
  { name: 'JavaScript', logo: 'javascript.svg', note: 'Tracking & événements' },
  { name: 'Zapier', logo: 'zapier.svg', note: 'Automatisations' },
  { name: 'Google Trends', logo: 'google-trends.png', note: 'Signaux de demande' },
  { name: 'TrueClicks', logo: 'trueclicks.png', note: 'Audit Google Ads' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'UX & sessions' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'Dashboards' },
  { name: 'Meta', logo: 'meta.svg', note: 'Paid social' },
  { name: 'Microsoft Ads', logo: 'microsoft-ads.png', note: 'Search & audience' },
  { name: 'Google Ads', logo: 'google-ads.svg', note: 'Search, PMax, YouTube' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Mesure & attribution' },
  { name: 'Ahrefs', logo: 'ahrefs.png', note: 'Intentions & concurrence' },
  { name: 'Google Tag Manager', logo: 'google-tag-manager.svg', note: 'Plan de taggage' },
];

const proofCards = [
  {
    metric: '0 blocage',
    title: 'Plus de problème de dotation',
    text: 'Dotation, plafonds, top-ups et validations sont cadrés avant que les campagnes montent en pression.',
  },
  {
    metric: 'Budgets ouverts',
    title: 'Lancer et scaler sans plafond opérationnel',
    text: 'Des budgets évolutifs, pilotés selon l’enveloppe validée et les signaux de performance.',
  },
  {
    metric: 'Certifiés',
    title: 'Traffic managers senior',
    text: 'Des profils certifiés Google Ads, Meta Blueprint, analytics et tracking, avec arbitrages humains.',
  },
  {
    metric: 'ROAS / CPA',
    title: 'Optimisation continue',
    text: 'Budgets, audiences, créas, enchères et landing pages sont optimisés pour convertir mieux.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    label: 'AI buying',
    title: 'L’achat média devient piloté par l’IA, mais pas autonome',
    text: 'PMax, Demand Gen, Advantage+ et AI Max accélèrent l’achat, mais exigent objectifs, signaux et garde-fous.',
  },
  {
    label: 'Budget pacing',
    title: 'Le budget doit suivre la demande',
    text: 'Budgets flexibles, enchères intelligentes et scénarios de scaling doivent capter les pics d’intention.',
  },
  {
    label: 'Data strength',
    title: 'Le tracking devient un avantage compétitif',
    text: 'GA4, GTM, CRM, offline conversions et consentement nourrissent les algorithmes avec de meilleurs signaux.',
  },
  {
    label: 'Creative intelligence',
    title: 'La création se teste comme un levier média',
    text: 'Hooks, formats courts, UGC et landing pages sont testés pour améliorer CPA, ROAS et qualité de lead.',
  },
  {
    label: 'Commerce media',
    title: 'Retail media, search et social captent l’essentiel de la croissance',
    text: 'Les budgets vont vers les environnements où intention, données transactionnelles et mesure business sont fortes.',
  },
  {
    label: 'GEO',
    title: 'Les campagnes doivent aussi nourrir la visibilité IA',
    text: 'Pages, offres, FAQ et preuves doivent être lisibles par Google et les moteurs génératifs.',
  },
];

const visualStories = [
  {
    image: 'media-traffic-manager.webp',
    type: 'Pilotage performance',
    title: 'Un cockpit média lisible au quotidien',
    text: 'Budget pacing, CPA, ROAS, qualité des leads et signaux business dans une même lecture.',
    tags: ['Budget', 'CPA', 'ROAS'],
  },
  {
    image: 'media-creative-tests.webp',
    type: 'Creative intelligence',
    title: 'Des créas testées comme des assets média',
    text: 'Hooks, formats, audiences et landing pages sont challengés pour apprendre plus vite.',
    tags: ['Hooks', 'A/B test', 'UGC'],
  },
  {
    image: 'media-scaling-room.webp',
    type: 'Scaling sécurisé',
    title: 'La dotation suit les opportunités',
    text: 'Les budgets augmentent quand la rentabilité, la capacité commerciale et la qualité suivent.',
    tags: ['Pacing', 'Scaling', 'Qualité'],
  },
];

const services = [
  {
    kicker: 'Search & intent',
    title: 'Google Ads, Microsoft Ads, PMax et AI Max',
    text: 'Search, Performance Max, Demand Gen, YouTube, mots-clés, flux et enchères.',
    items: ['Search', 'PMax', 'Demand Gen', 'YouTube'],
  },
  {
    kicker: 'Paid social',
    title: 'Meta Ads, TikTok, LinkedIn et social commerce',
    text: 'Acquisition, retargeting, lead gen, catalogues, creators et tests créatifs.',
    items: ['Meta', 'TikTok', 'LinkedIn', 'Lead Gen'],
  },
  {
    kicker: 'Programmatique',
    title: 'Programmatique, display, vidéo et DOOH',
    text: 'Audience planning, formats premium, reach qualifié, brand safety et fréquence.',
    items: ['Display', 'Video', 'DOOH', 'Brand safety'],
  },
  {
    kicker: 'Mesure',
    title: 'Tracking, dashboards et lecture business',
    text: 'GA4, GTM, Looker Studio, Clarity, CRM, offline conversions et décisions.',
    items: ['GA4', 'GTM', 'Looker', 'CRM'],
  },
];

const budgetSteps = [
  {
    step: '01',
    title: 'Sécuriser la dotation',
    text: 'Paiement, validations, plafonds et recharges cadrés avant lancement.',
  },
  {
    step: '02',
    title: 'Lancer vite',
    text: 'Campagnes, pixels, UTMs, audiences, créas et dashboards prêts à apprendre.',
  },
  {
    step: '03',
    title: 'Scaler proprement',
    text: 'Augmenter quand la donnée confirme rentabilité, qualité et traction commerciale.',
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Audit',
    text: 'Comptes, historique, tracking, offres, créas, concurrence et CPA.',
  },
  {
    step: '02',
    title: 'Plan média',
    text: 'Canaux, budget, audiences, messages, formats, KPI et scaling.',
  },
  {
    step: '03',
    title: 'Paramétrage',
    text: 'Campagnes, naming, conversions, UTMs, dashboards et QA.',
  },
  {
    step: '04',
    title: 'Optimisation',
    text: 'Lecture des signaux, arbitrages, tests créatifs, enchères et exclusions.',
  },
  {
    step: '05',
    title: 'Reporting',
    text: 'Budget, leads, ventes, CPA, ROAS, qualité et prochaines décisions.',
  },
];

const deliverables = [
  'Audit comptes publicitaires',
  'Plan média par canal',
  'Prévision budget / CPA / ROAS',
  'Plan de tracking GA4 & GTM',
  'Structure campagnes & naming',
  'Paramétrage Search, Social & PMax',
  'Kit UTM & conventions de données',
  'Dashboard Looker Studio',
  'Plan de tests créatifs',
  'Optimisation hebdomadaire',
  'Contrôle qualité landing pages',
  'Reporting business & recommandations',
];

const sources = [
  {
    title: 'Google Marketing Live 2026',
    text: 'IA, PMax, Demand Gen, budgets flexibles et données structurent les standards de performance.',
    href: 'https://business.google.com/us/accelerate/googlemarketinglive/',
  },
  {
    title: 'WARC Systems Planning 2026',
    text: 'Retail media, search et social imposent une planification plus systémique.',
    href: 'https://www.warc.com/en/press/press-releases/26-01-15_systems-planning-a-new-model-for-media-planning-as-traditional-approaches-collapse',
  },
  {
    title: 'IAB mesure & commerce media',
    text: 'Mesure incrémentale, collaboration autour de la donnée et feedback transactionnel deviennent centraux.',
    href: 'https://www.iab.com/blog/is-your-legacy-measurement-sabotaging-growth-in-the-retail-media-era/',
  },
  {
    title: 'Kantar Marketing Trends 2026',
    text: 'GEO, IA, qualité des données, creative intelligence et retail media changent la demande.',
    href: 'https://www.kantar.com/campaigns/marketing-trends',
  },
];

const faq = [
  {
    question: 'Qu’est-ce qu’une agence d’achat média ?',
    answer:
      'Une agence d’achat média planifie, lance, achète, optimise et mesure les campagnes publicitaires sur Google Ads, Meta Ads, YouTube, TikTok, LinkedIn, programmatique, display ou DOOH pour générer des résultats business mesurables.',
  },
  {
    question: 'Comment Richmedia évite les problèmes de dotation média ?',
    answer:
      'Richmedia anticipe les plafonds, moyens de paiement, validations, recharges et rythmes de consommation pour éviter les interruptions de campagnes et permettre un scaling fluide lorsque les performances sont bonnes.',
  },
  {
    question: 'Peut-on lancer avec des budgets média importants ?',
    answer:
      'Oui. L’objectif est de permettre des budgets média ouverts et évolutifs selon l’enveloppe validée, la capacité commerciale, les signaux de performance et les règles de contrôle définies avec le client.',
  },
  {
    question: 'Quels KPI suivez-vous pour optimiser les campagnes ?',
    answer:
      'Nous suivons notamment le CPA, ROAS, coût par lead qualifié, taux de conversion, taux de qualification, chiffre d’affaires attribué, volume, fréquence, qualité d’audience et performance par créa.',
  },
  {
    question: 'Pourquoi le SEO/GEO compte-t-il dans une page achat média ?',
    answer:
      'Parce que les campagnes paid convertissent mieux quand les pages sont claires, rapides, structurées, crédibles et compréhensibles par Google comme par les moteurs IA qui influencent la découverte des marques.',
  },
];

const schema = [
  serviceSchema({
    name: 'Achat média',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Expertises', url: `${SITE.url}/expertises` },
    { name: 'Achat média', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: '0 blocage' },
  { href: '#trends', label: 'Tendances', value: '2026' },
  { href: '#system', label: 'Système', value: 'Média' },
  { href: '#media-cta', label: 'Projet', value: 'Scaler' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/achat-media-hero.webp`}
  schema={schema}
>
  <div class="media-page">
    <section class="media-hero" aria-labelledby="media-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="media-title">Achat média piloté à la performance.</h1>
        <p class="hero-lead">
          Richmedia lance, sécurise et optimise vos campagnes paid avec des traffic managers certifiés,
          des budgets évolutifs et une lecture claire du CPA, du ROAS et de la qualité des leads.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Lancer vos campagnes
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir les cas clients
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual media-hover-lab" aria-label="Pilotage achat média Richmedia">
        <img src={`${assetBase}/achat-media-hero.webp`} alt="Interface premium de pilotage d'achat média et de performance marketing" />
        <div class="signal-card signal-card-top">
          <span>Budget</span>
          <strong>Dotation sécurisée</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>Optimisation</span>
          <strong>CPA / ROAS</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>Scaling</span>
          <strong>Budgets ouverts</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-media-nav" aria-label="Navigation de la page achat média">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="performance-cockpit" id="cockpit" aria-label="Promesses achat média Richmedia">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Media cockpit</strong>
          <small>budget pacing actif</small>
        </div>
        <div class="cockpit-zero">
          <span>0</span>
          <div>
            <p>blocage dotation</p>
            <h2>Plus de coupure média quand les campagnes commencent à performer.</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 96%">
            <span>Dotation sécurisée</span>
            <i></i>
          </div>
          <div style="--value: 82%">
            <span>Scaling disponible</span>
            <i></i>
          </div>
          <div style="--value: 74%">
            <span>Optimisations live</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="quick-answer" id="answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Réponse rapide</span>
        <h2 id="quick-answer-title">En 2026, acheter du média ne suffit plus : il faut piloter un système.</h2>
      </div>
      <p>
        Les plateformes automatisent l’achat. La différence vient du tracking, des créas, des pages,
        du CRM, du pacing budget et de l’arbitrage humain.
      </p>
    </section>

    <section class="visual-section" id="visuals" aria-labelledby="visual-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">En images</span>
          <h2 id="visual-title">Moins de discours, plus de pilotage visible.</h2>
        </div>
      </div>
      <div class="visual-grid">
        {visualStories.map((story) => (
          <article>
            <div class="visual-photo">
              <img src={`${assetBase}/${story.image}`} alt={story.title} loading="eager" decoding="async" />
            </div>
            <div class="visual-copy">
              <span>{story.type}</span>
              <h3>{story.title}</h3>
              <p>{story.text}</p>
              <div>
                {story.tags.map((tag) => <small>{tag}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="trend-section" id="trends" aria-labelledby="trend-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Tendances achat média 2026</span>
          <h2 id="trend-title">Ce que les marques doivent maîtriser maintenant.</h2>
        </div>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="media-system" id="system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-top">
            <span></span><span></span><span></span>
            <strong>richmedia / paid-growth</strong>
          </div>
          <div class="screen-body">
            <div class="curve-card">
              <span>budget_pacing</span>
              <strong>Spend ↑ Conversions ↑</strong>
              <i></i>
            </div>
            <div class="media-flow">
              <span>Audience</span>
              <i></i>
              <span>Créa</span>
              <i></i>
              <span>Conversion</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Notre système média</span>
        <h2 id="system-title">Un pôle achat média qui pense comme une équipe revenue.</h2>
        <p>
          Nous ne livrons pas seulement des impressions ou des clics. Nous pilotons le mix paid avec les
          contraintes réelles de votre business : capacité commerciale, marge, stock, qualité de lead,
          CRM, saisonnalité et vitesse de décision.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="budget-section" id="budget" aria-labelledby="budget-title">
      <div class="budget-copy">
        <span class="eyebrow">Dotation & scaling</span>
        <h2 id="budget-title">Vos campagnes ne doivent pas s’arrêter pour un problème de paiement.</h2>
        <p>
          Nous cadrons la dotation média avant le lancement, puis nous pilotons les budgets selon les
          performances. Résultat : moins d’interruptions, plus de vitesse et un scaling plus propre.
        </p>
      </div>
      <div class="budget-steps">
        {budgetSteps.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="tool-stack" id="tools" aria-labelledby="tool-title">
      <div class="section-heading compact">
        <span class="eyebrow">Partenaires & outils</span>
        <h2 id="tool-title">La stack média, tracking et reporting utilisée pour piloter vos campagnes.</h2>
      </div>
      <div class="logo-marquee" aria-label="Outils achat média et performance">
        <div class="logo-track">
          {[0, 1].map((loopIndex) => (
            <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
              {mediaTools.map((tool) => (
                <figure>
                  <span>
                    <img
                      src={`${logoBase}/${tool.logo}`}
                      alt={`Logo ${tool.name}`}
                      loading="eager"
                      decoding="async"
                    />
                  </span>
                  <figcaption>{tool.name}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {mediaTools.map((tool) => (
          <figure>
            <span>
              <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
            </span>
            <figcaption>
              <strong>{tool.name}</strong>
              <small>{tool.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="roadmap-section" id="roadmap" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Méthode Richmedia</span>
          <h2 id="roadmap-title">De l’audit au scaling, chaque arbitrage est traçable.</h2>
        </div>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="deliverables-section" id="deliverables" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Livrables</span>
        <h2 id="deliverables-title">Ce que vous recevez pour piloter sans zone floue.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="sources-section" id="sources" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">Veille 2026</span>
        <h2 id="sources-title">Les signaux de marché intégrés à notre approche.</h2>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noopener">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
            <small>Lire la source <i class="ph ph-arrow-up-right" aria-hidden="true"></i></small>
          </a>
        ))}
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Questions fréquentes.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="media-cta" id="media-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Prêt à scaler ?</span>
        <h2 id="cta-title">Confiez vos budgets à une équipe qui sait acheter, mesurer et optimiser.</h2>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact">
          Parler à un traffic manager
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Relier média, SEO et conversion"
    intro="Un plan média performe mieux lorsqu’il s’appuie sur une stratégie claire, un socle organique et un CRM activable."
    links={frSiloLinks.media}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .media-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.68);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 10%, rgba(124, 60, 255, 0.2), transparent 28rem),
      radial-gradient(circle at 12% 30%, rgba(124, 60, 255, 0.12), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
  }

  .media-hero,
  .mobile-media-nav,
  .performance-cockpit,
  .quick-answer,
  .visual-section,
  .trend-section,
  .media-system,
  .budget-section,
  .tool-stack,
