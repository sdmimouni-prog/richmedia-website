  .source-grid strong {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .source-grid small {
    align-self: end;
    margin-top: 1rem;
    color: var(--purple-2);
    font-size: 0.78rem;
    font-weight: 850;
