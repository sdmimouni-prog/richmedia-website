  .tool-grid figure:hover {
    border-color: rgba(124, 60, 255, 0.5);
    background: rgba(124, 60, 255, 0.09);
    transform: translateY(-3px);
  }

  .tool-grid span {
    height: 4rem;
  }

  .tool-grid img {
    width: 76%;
    max-height: 2.3rem;
    object-fit: contain;
  }

  .tool-grid figcaption {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
