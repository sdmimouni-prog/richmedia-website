    line-height: 1.7;
  }

  .hero-lead {
    max-width: 690px;
    margin-top: 1.45rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    border-radius: 8px;
    padding: 0.9rem 1.25rem;
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9655ff, #6425f4);
    box-shadow: 0 1.1rem 2.8rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-visual {
    position: relative;
    isolation: isolate;
    justify-self: end;
    overflow: hidden;
    width: min(100%, 780px);
    min-height: clamp(420px, 35vw, 560px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background: #07080d;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.42);
    transform: perspective(1100px) rotateX(0deg) rotateY(0deg) translateZ(0);
    transform-style: preserve-3d;
    transition:
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 520ms ease,
      box-shadow 520ms ease,
      filter 520ms ease;
    will-change: transform;
  }

  .hero-visual::before,
  .hero-visual::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    pointer-events: none;
  }

  .hero-visual::before {
    background:
      radial-gradient(circle at 72% 24%, rgba(169, 119, 255, 0.28), transparent 17rem),
      linear-gradient(115deg, transparent 0 42%, rgba(255, 255, 255, 0.16) 48%, transparent 55%);
    opacity: 0;
    transform: translate3d(-8%, 4%, 0);
    transition: opacity 520ms ease, transform 720ms ease;
    mix-blend-mode: screen;
  }

  .hero-visual::after {
    inset: -18% auto -18% -30%;
    width: 28%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    opacity: 0;
    transform: skewX(-18deg) translateX(0);
  }

  .hero-visual:hover,
  .hero-visual:focus-within {
    border-color: rgba(169, 119, 255, 0.48);
    box-shadow:
      0 1.5rem 4.2rem rgba(0, 0, 0, 0.46),
      0 0 4rem rgba(124, 60, 255, 0.18);
    transform: perspective(1100px) rotateX(2.2deg) rotateY(-4.2deg) translate3d(0, -0.45rem, 0);
  }

  .hero-visual:hover::before,
  .hero-visual:focus-within::before {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .hero-visual:hover::after,
  .hero-visual:focus-within::after {
    animation: hero-light-pass 980ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-visual img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center;
    filter: saturate(1.05) contrast(1.04);
    transform: scale(1.01);
    transition: transform 720ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 520ms ease;
  }

  .hero-visual:hover img,
  .hero-visual:focus-within img {
    filter: saturate(1.12) contrast(1.08) brightness(1.06);
    transform: scale(1.055) translate3d(0.45rem, -0.35rem, 0);
  }

  .signal-card {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
    width: min(15rem, 44%);
    border: 1px solid rgba(169, 119, 255, 0.35);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    background: rgba(4, 6, 14, 0.76);
    box-shadow: 0 1rem 2.8rem rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(12px);
    transition:
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 520ms ease,
      background 520ms ease,
      box-shadow 520ms ease;
  }

  .signal-card span {
    color: var(--purple-2);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .signal-card strong {
    font-size: clamp(0.96rem, 1.2vw, 1.12rem);
  }

  .signal-card-top {
    top: 8%;
    left: 7%;
  }

  .signal-card-middle {
    right: 7%;
    bottom: 28%;
  }

  .signal-card-bottom {
    bottom: 8%;
    left: 9%;
  }

  .hero-visual:hover .signal-card,
  .hero-visual:focus-within .signal-card {
    border-color: rgba(205, 180, 255, 0.64);
    background: rgba(7, 8, 18, 0.86);
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.44), 0 0 1.8rem rgba(124, 60, 255, 0.16);
  }

  .hero-visual:hover .signal-card-top,
  .hero-visual:focus-within .signal-card-top {
    transform: translate3d(-0.55rem, -0.45rem, 2rem);
  }

  .hero-visual:hover .signal-card-middle,
  .hero-visual:focus-within .signal-card-middle {
    transform: translate3d(0.65rem, -0.35rem, 2rem);
  }

  .hero-visual:hover .signal-card-bottom,
  .hero-visual:focus-within .signal-card-bottom {
    transform: translate3d(0.4rem, 0.55rem, 2rem);
  }

