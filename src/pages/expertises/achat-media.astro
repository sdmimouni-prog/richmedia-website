  .logo-marquee::before,
  .logo-marquee::after {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 2;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, rgba(169, 119, 255, 0.42), transparent);
    pointer-events: none;
  }

  .logo-marquee::before {
    top: 0;
  }

  .logo-marquee::after {
    bottom: 0;
  }

  .logo-track {
    display: flex;
    width: max-content;
    animation: logo-news-ticker 36s linear infinite;
    will-change: transform;
  }

  .logo-track-segment {
    display: flex;
    flex: 0 0 auto;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }

  .logo-marquee figure,
  .tool-grid figure {
    display: grid;
    align-content: center;
    justify-items: center;
    min-width: 0;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 0, rgba(255, 255, 255, 0.08), transparent 50%),
      rgba(5, 7, 15, 0.88);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
