    margin-top: 0.85rem;
  }

  .media-cta .hero-actions {
    justify-content: flex-end;
    margin-top: 0;
  }

  @keyframes panel-sweep {
    from {
      transform: translateX(-48%);
    }

    to {
      transform: translateX(48%);
    }
  }

  @keyframes logo-news-ticker {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes hero-light-pass {
    0% {
      opacity: 0;
      transform: skewX(-18deg) translateX(0);
    }

    18% {
      opacity: 0.9;
    }

    100% {
      opacity: 0;
      transform: skewX(-18deg) translateX(520%);
    }
  }

  @keyframes cockpit-scan {
    0%,
    100% {
      transform: translateX(-5rem) rotate(10deg);
      opacity: 0;
    }

    18%,
    74% {
      opacity: 1;
    }

    50% {
      transform: translateX(17rem) rotate(10deg);
    }
  }

  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(159, 107, 255, 0.48);
    }

    76%,
    100% {
      box-shadow: 0 0 0 0.7rem rgba(159, 107, 255, 0);
    }
