  .faq-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.2rem;
  }

  .faq-list details {
    padding: 1rem 1.1rem;
  }

  .faq-list summary {
    cursor: pointer;
    font-weight: 850;
    line-height: 1.35;
  }

  .media-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    margin-bottom: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.4rem, 4vw, 2.5rem);
    background:
      radial-gradient(circle at 8% 10%, rgba(124, 60, 255, 0.28), transparent 24rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.022));
