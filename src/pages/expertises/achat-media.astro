    .button,
    .hero-visual,
    .hero-visual::before,
    .hero-visual img,
    .signal-card,
    .trend-grid article,
    .visual-grid article,
    .roadmap article,
    .service-grid article,
    .cockpit-feed article,
    .budget-steps article,
    .tool-grid figure,
    .source-grid a,
    .deliverables-grid span {
      transition: none !important;
    }

    .hero-visual:hover,
    .hero-visual:focus-within,
    .hero-visual:hover img,
    .hero-visual:focus-within img,
    .visual-grid article:hover,
    .visual-grid article:hover .visual-photo img,
    .hero-visual:hover .signal-card,
    .hero-visual:focus-within .signal-card {
      transform: none !important;
    }
