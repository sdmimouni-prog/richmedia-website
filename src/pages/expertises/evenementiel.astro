---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import { SITE } from '../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';

const assetBase = '/assets/richmedia-evenementiel';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/expertises/evenementiel`;

const seoTitle = 'Agence événementielle au Maroc | Richmedia';
const seoDescription =
  'Concevez des lancements, conférences, conventions et expériences de marque reliés au contenu live, au reporting et à l’impact terrain.';

const eventTools = [
  { name: 'Google Tag Manager', logo: 'google-tag-manager.svg', note: 'Tracking & scans' },
  { name: 'Google Analytics', logo: 'google-analytics.svg', note: 'Parcours & conversions' },
  { name: 'Looker Studio', logo: 'looker-studio.svg', note: 'Dashboard événement' },
  { name: 'Microsoft Clarity', logo: 'microsoft-clarity.png', note: 'UX pages & formulaires' },
  { name: 'Zapier', logo: 'zapier.svg', note: 'Leads vers CRM' },
  { name: 'Meta', logo: 'meta.svg', note: 'Amplification sociale' },
  { name: 'Teamwork', logo: 'teamwork.png', note: 'Production & planning' },
  { name: 'Zoho', logo: 'zoho.svg', note: 'CRM & invités' },
];

const proofCards = [
  {
    metric: 'Concept',
    title: 'Un événement pensé comme une expérience de marque',
    text: 'Nous clarifions l’objectif, l’audience, le récit, la scénographie, les temps forts et les preuves attendues avant la production.',
  },
  {
    metric: 'Production',
    title: 'Scène, régie, contenu et logistique cadrés',
    text: 'Planning, prestataires, AV, décor, staffing, accueil, sécurité, conducteur et coordination live sont pilotés avec des points de contrôle précis.',
  },
  {
    metric: 'Impact',
    title: 'Des moments conçus pour être vécus et partagés',
    text: 'Lancement, convention, gala, conférence, pop-up ou roadshow : chaque format doit créer présence, émotion, contenus et conversations utiles.',
  },
  {
    metric: 'ROI',
    title: 'Un reporting au-delà des photos souvenir',
    text: 'Inscriptions, check-in, engagement, leads, contenus, retombées, satisfaction, coût par contact et actions post-événement sont suivis pour décider la suite.',
  },
];

const commandSignals = proofCards.slice(1);

const trends = [
  {
    label: 'AI operational',
    title: 'L’IA devient utile dans l’organisation événementielle',
    text: 'En 2026, les meilleurs dispositifs utilisent l’IA pour accélérer sourcing, agenda, invitations, personnalisation, analyse des retours et reporting.',
  },
  {
    label: 'Human connection',
    title: 'Le live redevient un avantage de confiance',
    text: 'Dans un monde saturé de contenus générés, l’événement physique crée crédibilité, présence, discussions réelles et décisions plus rapides.',
  },
  {
    label: 'Personalization',
    title: 'La personnalisation se joue pendant l’événement',
    text: 'Les participants attendent des parcours pertinents : contenus adaptés, networking, zones d’échange, démonstrations, check-in fluide et relances utiles.',
  },
  {
    label: 'First-party data',
    title: 'Chaque événement doit produire de la donnée exploitable',
    text: 'Inscription, présence, scans, badges, QR, formulaires, feedback et interactions sponsor deviennent des signaux connectés au CRM.',
  },
  {
    label: 'Sustainability',
    title: 'La durabilité devient un sujet de risque et de résilience',
    text: 'Choix de lieux, transports, énergie, restauration, matériaux, réemploi et mesure d’impact doivent être intégrés tôt dans la conception.',
  },
  {
    label: 'SEO / GEO',
    title: 'L’événement doit aussi être trouvable et citable',
    text: 'Pages d’inscription, FAQ, données structurées, contenus post-événement, photos, vidéos et preuves aident Google et les moteurs IA à comprendre votre dispositif.',
  },
];

const eventFormats = [
  {
    image: 'event-conference.webp',
    type: 'Lancement & conférence',
    title: 'Transformer une annonce en moment mémorable',
    text: 'Scénographie, conducteur, intervenants, régie, captation, diffusion, presse, contenus sociaux et parcours invités.',
    formats: ['Stage', 'AV', 'Live content'],
  },
  {
    image: 'event-experience.webp',
    type: 'Expérience de marque',
    title: 'Faire vivre la marque avant de la raconter',
    text: 'Booth premium, démonstration, accueil, hospitality, QR, capture de leads, contenus social-first et relance CRM.',
    formats: ['Booth', 'Hospitality', 'Leads'],
  },
  {
    image: 'event-control-room.webp',
    type: 'Régie & données',
    title: 'Piloter le live, puis exploiter les signaux',
    text: 'Check-in, flux, planning, coordination prestataires, captation, dashboard, feedback et bilan post-événement actionnable.',
    formats: ['Run-of-show', 'Dashboard', 'ROI'],
  },
];

const services = [
  {
    kicker: 'Stratégie',
    title: 'Concept événementiel et storytelling de marque',
    text: 'Objectif business, cible, message, thème, format, parcours invité, temps forts, KPI, budget et plan d’amplification.',
    items: ['Concept', 'Audience', 'Message', 'KPI'],
  },
  {
    kicker: 'Production',
    title: 'Scénographie, AV, logistique et prestataires',
    text: 'Lieu, scène, son, lumière, vidéo, décor, signalétique, équipes, autorisations, sécurité, planning et conduite opérationnelle.',
    items: ['Lieu', 'Régie', 'Décor', 'Ops'],
  },
  {
    kicker: 'Expérience',
    title: 'Accueil, hospitality et parcours invités',
    text: 'Invitations, RSVP, check-in, badges, flux, zones d’échange, démonstrations, animation, restauration et qualité de présence.',
    items: ['RSVP', 'Check-in', 'Invités', 'Flux'],
  },
  {
    kicker: 'Amplification',
    title: 'Contenus live, social, presse et reporting',
    text: 'Captation photo/vidéo, contenus courts, influence, paid social, retargeting, enquête satisfaction, dashboard et bilan d’impact.',
    items: ['Contenu', 'Social', 'Presse', 'ROI'],
  },
];

const roadmap = [
  {
    step: '01',
    title: 'Cadrage',
    text: 'Objectif, cible, format, jauge, budget, date, lieux possibles, contraintes, partenaires et définition des critères de succès.',
  },
  {
    step: '02',
    title: 'Concept',
    text: 'Story, scénographie, parcours invité, moments clés, mécanique d’engagement, plan de contenu, KPI et architecture de données.',
  },
  {
    step: '03',
    title: 'Production',
    text: 'Prestataires, moodboards, plans, régie, conducteur, invitations, RSVP, check-in, staffing, sécurité et répétitions.',
  },
  {
    step: '04',
    title: 'Live',
    text: 'Supervision terrain, coordination minute par minute, gestion des flux, captation, ajustements, remontées et contrôle qualité.',
  },
  {
    step: '05',
    title: 'Post-événement',
    text: 'Montage contenus, relances CRM, retombées, feedback, dashboard, bilan ROI, recommandations et réutilisation des assets.',
  },
];

const deliverables = [
  'Concept événementiel',
  'Moodboard & direction artistique',
  'Plan de production',
  'Budget détaillé',
  'Sourcing lieu & prestataires',
  'Scénographie & signalétique',
  'Conducteur / run-of-show',
  'Plan invitations & RSVP',
  'Parcours check-in & badges',
  'Plan captation photo/vidéo',
  'Dashboard post-événement',
  'Bilan ROI & recommandations',
];

const sources = [
  {
    title: 'Cvent — Event Trends 2026',
    text: 'Les événements 2026 sont guidés par l’intention : IA opérationnelle, confiance, pertinence, donnée first-party et preuve de valeur.',
    href: 'https://www.cvent.com/en/blog/events/top-event-trends',
  },
  {
    title: 'Bizzabo — Event Industry Trends 2026',
    text: 'Les organisateurs attendent plus d’IA, une croissance plus disciplinée, une personnalisation in-event et une meilleure preuve du ROI.',
    href: 'https://www.bizzabo.com/blog/event-industry-trends-2026',
  },
  {
    title: 'Freeman — Learning Report 2026',
    text: 'Les participants apprennent aussi via expo floor, échanges pairs, démonstrations et interactions, pas seulement en salle de conférence.',
    href: 'https://www.globenewswire.com/news-release/2026/07/23/3332147/0/en/new-freeman-trends-report-finds-attendees-want-more-event-learning-to-happen-outside-the-session-room.html',
  },
  {
    title: 'Cvent — In-person Meetings 2026',
    text: 'Les formats en présentiel redeviennent stratégiques pour accélérer la confiance, la décision, les signaux d’engagement et le suivi commercial.',
    href: 'https://www.cvent.com/en/blog/events/complete-guide-to-in-person-meetings',
  },
  {
    title: 'Cvent — Sustainability Event Strategy 2026',
    text: 'La durabilité événementielle devient une discipline de continuité business : risques, coûts, énergie, transport, restauration et mesure.',
    href: 'https://www.cvent.com/en/blog/events/sustainability-event-strategy',
  },
];

const faq = [
  {
    question: 'Qu’est-ce qu’une agence événementielle en 2026 ?',
    answer:
      'Une agence événementielle conçoit et produit des événements pensés comme des expériences mesurables : concept, scénographie, production, logistique, invitations, contenus live, données, reporting et amplification avant, pendant et après l’événement.',
  },
  {
    question: 'Quels types d’événements Richmedia peut-elle accompagner ?',
    answer:
      'Nous accompagnons les lancements de marque, conférences, conventions, galas, roadshows, activations corporate, expériences de marque, conférences de presse, soirées partenaires et formats hybrides.',
  },
  {
    question: 'Comment mesurer le ROI d’un événement ?',
    answer:
      'Nous suivons inscriptions, taux de présence, check-in, engagement, scans, leads, rendez-vous, satisfaction, retombées presse/social, contenus produits, coût par contact et actions commerciales post-événement.',
  },
  {
    question: 'Richmedia gère-t-elle la production opérationnelle ?',
    answer:
      'Oui. Nous pouvons coordonner concept, lieu, scénographie, son, lumière, vidéo, prestataires, staffing, conducteur, répétitions, supervision live et bilan post-événement.',
  },
  {
    question: 'Pourquoi optimiser une page événementielle pour le SEO/GEO ?',
    answer:
      'Parce que vos clients cherchent des agences et des formats via Google et les moteurs IA. Une page claire, structurée, sourcée et locale augmente la découvrabilité et la crédibilité de l’offre.',
  },
];

const schema = [
  serviceSchema({
    name: 'Événementiel',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Expertises', url: `${SITE.url}/expertises` },
    { name: 'Événementiel', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#cockpit', label: 'Cockpit', value: '360' },
  { href: '#trends', label: 'Signaux', value: '2026' },
  { href: '#formats', label: 'Formats', value: 'Live' },
  { href: '#event-cta', label: 'Projet', value: 'Brief' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/evenementiel-hero.webp`}
  schema={schema}
>
  <div class="event-page">
    <section class="event-hero" aria-labelledby="event-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="event-title">Événementiel pensé pour créer de l’impact.</h1>
        <p class="hero-lead">
          Richmedia conçoit, produit et amplifie vos événements : concept, scénographie, logistique,
          contenus live, expérience invités et reporting pour transformer un moment en actif de marque.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Produire votre événement
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir les cas clients
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual event-hover-lab" aria-label="Production événementielle Richmedia">
        <img
          src={`${assetBase}/evenementiel-hero.webp`}
          alt="Événement corporate premium avec scène, régie et public"
          width="1774"
          height="887"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="signal-card signal-card-top">
          <span>Concept</span>
          <strong>Scénographie + récit</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>Live</span>
          <strong>Régie + coordination</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>Post-événement</span>
          <strong>Contenus + ROI</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-event-nav" aria-label="Navigation de la page événementiel">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section id="cockpit" class="event-cockpit" aria-label="Promesse événementielle Richmedia">
      <div class="cockpit-main">
        <div class="cockpit-topline">
          <span></span>
          <strong>Event cockpit</strong>
          <small>production maîtrisée</small>
        </div>
        <div class="cockpit-zero">
          <span>360</span>
          <div>
            <p>{proofCards[0].metric}</p>
            <h2>{proofCards[0].title}</h2>
          </div>
        </div>
        <div class="cockpit-bars" aria-hidden="true">
          <div style="--value: 94%">
            <span>Concept & narration</span>
            <i></i>
          </div>
          <div style="--value: 88%">
            <span>Production live</span>
            <i></i>
          </div>
          <div style="--value: 81%">
            <span>Reporting post-événement</span>
            <i></i>
          </div>
        </div>
      </div>
      <div class="cockpit-feed">
        {commandSignals.map((card, index) => (
          <article>
            <span>0{index + 1}</span>
            <div>
              <strong>{card.metric}</strong>
              <h2>{card.title}</h2>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="answer" class="quick-answer" aria-labelledby="quick-answer-title">
      <span class="eyebrow">Réponse rapide</span>
      <div>
        <h2 id="quick-answer-title">En 2026, un événement doit être vécu, capté, mesuré et prolongé.</h2>
        <p>
          La réussite ne se limite plus à une salle pleine. Les marques attendent une expérience fluide,
          des contenus exploitables, des données fiables, une amplification digitale et des suites commerciales.
        </p>
      </div>
    </section>

    <section id="trends" class="trend-section" aria-labelledby="trend-title">
      <div class="section-head">
        <span class="eyebrow">Tendances événementiel 2026</span>
        <h2 id="trend-title">Ce que les marques doivent intégrer maintenant.</h2>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="formats" class="usecase-section" aria-labelledby="format-title">
      <div class="section-head section-head-wide">
        <span class="eyebrow">Formats événementiels</span>
        <h2 id="format-title">Des expériences utiles, mémorables et mesurables.</h2>
      </div>
      <div class="usecase-grid">
        {eventFormats.map((event) => (
          <article>
            <div class="usecase-photo">
              <img src={`${assetBase}/${event.image}`} alt={event.title} loading="lazy" decoding="async" />
            </div>
            <div class="usecase-copy">
              <span>{event.type}</span>
              <h3>{event.title}</h3>
              <p>{event.text}</p>
              <div>
                {event.formats.map((format) => <small>{format}</small>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="system" class="system-section" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="screen-frame">
          <div class="screen-bar">
            <span></span><span></span><span></span>
            <strong>richmedia.ma / event-system</strong>
          </div>
          <div class="screen-body">
            <div class="event-node event-node-main">
              <small>input</small>
              <strong>Lancement / convention / gala</strong>
            </div>
            <div class="event-node event-node-mid">
              <small>run_of_show</small>
              <strong>Concept + production + live</strong>
            </div>
            <div class="flow-row">
              <span>Invitations</span>
              <i></i>
              <span>Check-in</span>
              <i></i>
              <span>Contenu</span>
              <i></i>
              <span>CRM</span>
            </div>
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Notre système événementiel</span>
        <h2 id="system-title">Une production qui orchestre l’émotion, les détails et la mesure.</h2>
        <p>
          Nous ne vendons pas seulement une soirée ou une scène. Nous construisons un dispositif complet :
          avant l’événement, live, contenus, données, relances et bilan.
        </p>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span>{service.kicker}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <div>
                {service.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tools" class="tool-section" aria-labelledby="tool-title">
      <div class="section-head section-head-wide">
        <span class="eyebrow">Outils & intégrations</span>
        <h2 id="tool-title">La stack qui transforme l’événement en données, contenus et décisions.</h2>
      </div>
      <div class="logo-marquee" aria-label="Outils Richmedia pour l’événementiel">
        <div class="logo-track">
          {[...eventTools, ...eventTools].map((tool) => (
            <figure>
              <span>
                <img
                  src={`${logoBase}/${tool.logo}`}
                  alt={`Logo ${tool.name}`}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <figcaption>{tool.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="tool-grid">
        {eventTools.map((tool) => (
          <article>
            <img src={`${logoBase}/${tool.logo}`} alt={`Logo ${tool.name}`} loading="lazy" decoding="async" />
            <div>
              <strong>{tool.name}</strong>
              <span>{tool.note}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="roadmap" class="roadmap-section" aria-labelledby="roadmap-title">
      <div class="section-head section-head-wide">
        <span class="eyebrow">Méthode Richmedia</span>
        <h2 id="roadmap-title">Du concept au bilan, chaque détail doit servir l’objectif.</h2>
      </div>
      <div class="roadmap-grid">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="deliverables" class="deliverables-section" aria-labelledby="deliverables-title">
      <span class="eyebrow">Livrables</span>
      <h2 id="deliverables-title">Ce que la production doit rendre maîtrisable.</h2>
      <div class="deliverables-grid">
        {deliverables.map((item) => (
          <div>
            <span>{item}</span>
            <i class="ph ph-check-circle" aria-hidden="true"></i>
          </div>
        ))}
      </div>
    </section>

    <section id="sources" class="sources-section" aria-labelledby="sources-title">
      <span class="eyebrow">Sources 2026</span>
      <h2 id="sources-title">Les signaux qui structurent notre approche événementielle.</h2>
      <div class="sources-grid">
        {sources.map((source) => (
          <a href={source.href} target="_blank" rel="noreferrer">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section" aria-labelledby="faq-title">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq-title">Questions fréquentes sur l’événementiel.</h2>
      <div class="faq-grid">
        {faq.map((item) => (
          <article>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="event-cta" class="cta-section" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Votre prochain événement</span>
        <h2 id="cta-title">Faisons de votre moment un vrai levier de marque.</h2>
      </div>
      <a class="button button-primary" href="/contact">
        Brief événementiel
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </div>

  <SeoSiloLinks
    title="Transformer l’événement en système d’acquisition"
    intro="Un temps fort devient plus rentable lorsqu’il nourrit les contenus, l’influence, le média et la visibilité long terme."
    links={frSiloLinks.event}
    variant="compact"
  />
</BaseLayout>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .event-page {
    --container: min(100% - 3rem, 1360px);
    --h1-size: clamp(32px, 4.3vw, 50px);
    --h2-size: clamp(28px, 3.3vw, 40px);
    background:
      radial-gradient(circle at 90% 8%, rgba(128, 68, 255, 0.2), transparent 28rem),
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      #030407;
    background-size: auto, 120px 120px, 120px 120px, auto;
    color: #fff;
    overflow-x: clip;
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
  }

  .event-hero,
  .mobile-event-nav,
  .event-cockpit,
  .quick-answer,
  .trend-section,
  .usecase-section,
  .system-section,
  .tool-section,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .cta-section {
    width: var(--container);
    margin-inline: auto;
  }

  .event-cockpit,
  .quick-answer,
  .trend-section,
  .usecase-section,
  .system-section,
  .tool-section,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section,
  .cta-section {
    scroll-margin-top: 96px;
  }

  .mobile-event-nav {
    display: none;
  }

  .event-hero {
    min-height: 760px;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 0.95fr);
    align-items: center;
    gap: clamp(46px, 7vw, 104px);
    padding: 130px 0 70px;
  }

  .hero-copy {
    max-width: 720px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: #a970ff;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: '';
    width: 44px;
    height: 2px;
    background: currentColor;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 {
    max-width: 720px;
    margin-top: 28px;
    font-size: clamp(32px, 4.3vw, 50px);
    line-height: 0.98;
    letter-spacing: 0;
  }

  h2 {
    font-size: clamp(28px, 3.3vw, 40px);
    line-height: 1;
    letter-spacing: 0;
  }

  h3 {
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .hero-lead {
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.68);
    font-size: clamp(1.0625rem, 1.35vw, 19px);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .button {
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 7px;
    padding: 0 26px;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9a5cff, #6b22f5);
    box-shadow: 0 18px 42px rgba(117, 52, 255, 0.28);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .button-secondary:hover {
    border-color: rgba(169, 112, 255, 0.62);
  }

  .hero-visual {
    position: relative;
    min-height: 430px;
    max-width: 610px;
    justify-self: end;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    overflow: hidden;
    background: #07070c;
    box-shadow: 0 35px 90px rgba(20, 8, 58, 0.48);
    isolation: isolate;
    transform-style: preserve-3d;
    transform: perspective(1100px) rotateX(0deg) rotateY(0deg) translateZ(0);
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.55s ease, border-color 0.55s ease;
  }

  .hero-visual::before,
  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .hero-visual::before {
    background:
      linear-gradient(115deg, transparent 8%, rgba(255, 255, 255, 0.2) 20%, transparent 31%),
      radial-gradient(circle at 72% 16%, rgba(169, 112, 255, 0.34), transparent 22rem);
    opacity: 0;
    transform: translateX(-26%);
    transition: opacity 0.55s ease, transform 0.75s ease;
  }

  .hero-visual::after {
    border: 1px solid rgba(169, 112, 255, 0.24);
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }

  .hero-visual:hover,
  .hero-visual:focus-within {
    transform: perspective(1100px) rotateX(2deg) rotateY(-4deg) translateY(-8px);
    border-color: rgba(169, 112, 255, 0.55);
    box-shadow: 0 45px 120px rgba(96, 46, 214, 0.42);
  }

  .hero-visual:hover::before,
  .hero-visual:focus-within::before {
    opacity: 1;
    transform: translateX(18%);
  }

  .hero-visual img {
    width: 100%;
    height: 100%;
    min-height: 430px;
    display: block;
    object-fit: cover;
    object-position: 54% 50%;
    transform: scale(1.01);
    transition: transform 0.7s ease, filter 0.55s ease;
  }

  .hero-visual:hover img,
  .hero-visual:focus-within img {
    transform: scale(1.055);
    filter: saturate(1.08) contrast(1.06);
  }

  .signal-card {
    position: absolute;
    z-index: 3;
    width: min(300px, 62%);
    border: 1px solid rgba(169, 112, 255, 0.52);
    border-radius: 7px;
    padding: 18px 20px;
    background: linear-gradient(115deg, rgba(7, 8, 15, 0.92), rgba(24, 22, 31, 0.76));
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
    transition: transform 0.55s ease, background 0.55s ease;
  }

  .signal-card span {
    display: block;
    color: #a970ff;
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .signal-card strong {
    display: block;
    margin-top: 8px;
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.2;
  }

  .signal-card-top {
    top: 44px;
    left: 40px;
  }

  .signal-card-middle {
    right: 34px;
    bottom: 116px;
  }

  .signal-card-bottom {
    left: 48px;
    bottom: 28px;
  }

  .hero-visual:hover .signal-card,
  .hero-visual:focus-within .signal-card {
    background: linear-gradient(115deg, rgba(10, 10, 18, 0.95), rgba(41, 35, 57, 0.82));
  }

  .hero-visual:hover .signal-card-top {
    transform: translate3d(-8px, -8px, 38px);
  }

  .hero-visual:hover .signal-card-middle {
    transform: translate3d(12px, 3px, 46px);
  }

  .hero-visual:hover .signal-card-bottom {
    transform: translate3d(10px, 10px, 42px);
  }

  .event-cockpit {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 14px;
    align-items: stretch;
    margin-top: -24px;
    padding: 0 0 84px;
  }

  .cockpit-main,
  .cockpit-feed article,
  .trend-grid article,
  .usecase-grid article,
  .service-grid article,
  .roadmap-grid article,
  .deliverables-grid div,
  .sources-grid a,
  .faq-grid article,
  .tool-grid article {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 7px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018)),
      rgba(8, 9, 14, 0.84);
  }

  .cockpit-main,
  .cockpit-feed article {
    position: relative;
    overflow: hidden;
    background: rgba(6, 7, 13, 0.84);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045);
  }

  .cockpit-main {
    min-height: 370px;
    padding: clamp(22px, 3vw, 34px);
    background:
      radial-gradient(circle at 18% 12%, rgba(169, 112, 255, 0.3), transparent 16rem),
      linear-gradient(135deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.012)),
      rgba(5, 7, 15, 0.9);
  }

  .cockpit-main::before {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(rgba(255, 255, 255, 0.052) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.044) 1px, transparent 1px);
    background-size: 52px 52px;
    opacity: 0.58;
    pointer-events: none;
  }

  .cockpit-main::after {
    position: absolute;
    inset: -35% auto -35% 18%;
    width: 1px;
    content: '';
    background: linear-gradient(180deg, transparent, rgba(169, 112, 255, 0.8), transparent);
    filter: drop-shadow(0 0 1.6rem rgba(169, 112, 255, 0.58));
    animation: cockpit-scan 5.8s ease-in-out infinite;
    pointer-events: none;
  }

  .cockpit-topline,
  .cockpit-zero,
  .cockpit-bars {
    position: relative;
    z-index: 2;
  }

  .cockpit-topline {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.64);
    font-size: 1.0625rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cockpit-topline span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #a970ff;
    box-shadow: 0 0 0 0 rgba(169, 112, 255, 0.52);
    animation: live-pulse 2.4s ease-out infinite;
  }

  .cockpit-topline small {
    margin-left: auto;
    color: rgba(255, 255, 255, 0.44);
    font-size: 1.0625rem;
  }

  .cockpit-zero {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(18px, 2vw, 28px);
    align-items: end;
    margin-top: clamp(34px, 4vw, 56px);
  }

  .cockpit-zero > span {
    color: #a970ff;
    font-size: clamp(78px, 10vw, 128px);
    font-weight: 950;
    line-height: 0.78;
    letter-spacing: 0;
    text-shadow: 0 16px 48px rgba(124, 60, 255, 0.36);
  }

  .cockpit-zero p {
    margin: 0 0 10px;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .cockpit-zero h2 {
    max-width: 560px;
    font-size: clamp(27px, 3vw, 40px);
    line-height: 1.02;
  }

  .cockpit-bars {
    display: grid;
    gap: 18px;
    margin-top: clamp(38px, 5vw, 64px);
  }

  .cockpit-bars div {
    display: grid;
    gap: 8px;
  }

  .cockpit-bars span {
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.0625rem;
    font-weight: 850;
  }

  .cockpit-bars i {
    position: relative;
    overflow: hidden;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
  }

  .cockpit-bars i::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--value);
    border-radius: inherit;
    content: '';
    background: linear-gradient(90deg, #fff, #a970ff 55%, #6b22f5);
  }

  .cockpit-feed {
    display: grid;
    gap: 14px;
  }

  .cockpit-feed article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(18px, 2vw, 28px);
    align-items: start;
    padding: clamp(22px, 3vw, 34px);
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }

  .cockpit-feed article::before {
    position: absolute;
    inset: 0;
    content: '';
    background: radial-gradient(circle at 12% 22%, rgba(169, 112, 255, 0.2), transparent 18rem);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cockpit-feed article:hover {
    transform: translateY(-4px);
    border-color: rgba(169, 112, 255, 0.5);
    background: rgba(7, 8, 17, 0.94);
  }

  .cockpit-feed article:hover::before {
    opacity: 1;
  }

  .cockpit-feed article > span {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 1px solid rgba(169, 112, 255, 0.42);
    border-radius: 50%;
    color: #a970ff;
    font-weight: 900;
  }

  .cockpit-feed strong,
  .cockpit-feed h2,
  .cockpit-feed p {
    position: relative;
  }

  .cockpit-feed strong {
    display: block;
    color: #a970ff;
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cockpit-feed h2 {
    margin-top: 8px;
    font-size: clamp(24px, 2.8vw, 40px);
    line-height: 1.02;
  }

  .trend-grid span,
  .usecase-copy > span,
  .service-grid span,
  .roadmap-grid span {
    display: inline-block;
    color: #a970ff;
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cockpit-feed p,
  .trend-grid p,
  .usecase-copy p,
  .service-grid p,
  .roadmap-grid p,
  .quick-answer p,
  .section-head p,
  .system-copy > p,
  .faq-grid p,
  .sources-grid span {
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.6;
  }

  .cockpit-feed p {
    margin-top: 14px;
    font-size: 1.0625rem;
  }

  .quick-answer {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 46px;
    margin-bottom: 84px;
    padding: 38px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: linear-gradient(120deg, rgba(169, 112, 255, 0.11), rgba(255, 255, 255, 0.025));
  }

  .quick-answer p {
    margin-top: 18px;
    font-size: 18px;
  }

  .section-head {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: 42px;
    align-items: end;
    margin-bottom: 28px;
  }

  .section-head .eyebrow {
    grid-column: 1 / -1;
  }

  .section-head p {
    font-size: 17px;
  }

  .section-head-wide {
    grid-template-columns: 1fr 0.95fr;
  }

  .trend-section,
  .usecase-section,
  .system-section,
  .tool-section,
  .roadmap-section,
  .deliverables-section,
  .sources-section,
  .faq-section {
    padding-bottom: 92px;
  }

  .trend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .trend-grid article {
    min-height: 208px;
    padding: 24px;
  }

  .trend-grid h3 {
    margin-top: 14px;
    font-size: 22px;
  }

  .trend-grid p {
    margin-top: 14px;
  }

  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .usecase-grid article {
    overflow: hidden;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .usecase-grid article:hover {
    transform: translateY(-8px);
    border-color: rgba(169, 112, 255, 0.55);
    box-shadow: 0 26px 70px rgba(83, 43, 183, 0.24);
  }

  .usecase-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
  }

  .usecase-photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.65s ease, filter 0.45s ease;
  }

  .usecase-grid article:hover .usecase-photo img {
    transform: scale(1.055);
    filter: saturate(1.08) contrast(1.05);
  }

  .usecase-copy {
    padding: 24px;
  }

  .usecase-copy h3,
  .service-grid h3,
  .roadmap-grid h3,
  .faq-grid h3 {
    margin-top: 12px;
  }

  .usecase-copy p,
  .service-grid p {
    margin-top: 14px;
  }

  .usecase-copy div,
  .service-grid div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .usecase-copy small,
  .service-grid small {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    padding: 6px 9px;
    color: rgba(255, 255, 255, 0.76);
    font-weight: 800;
  }

  .system-section {
    display: grid;
    grid-template-columns: 0.9fr 1.45fr;
    gap: 14px;
  }

  .system-visual,
  .system-copy {
    min-height: 540px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(169, 112, 255, 0.13), rgba(255, 255, 255, 0.025));
  }

  .system-visual {
    display: grid;
    place-items: center;
    padding: 26px;
    overflow: hidden;
  }

  .screen-frame {
    width: 100%;
    min-height: 455px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 7px;
    overflow: hidden;
    background:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      radial-gradient(circle at 54% 18%, rgba(169, 112, 255, 0.35), transparent 18rem),
      #07080e;
    background-size: 70px 70px, 70px 70px, auto, auto;
  }

  .screen-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 58px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0 18px;
    color: rgba(255, 255, 255, 0.56);
  }

  .screen-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.34);
  }

  .screen-bar strong {
    margin-left: 8px;
    font-size: 1.0625rem;
  }

  .screen-body {
    position: relative;
    min-height: 395px;
    padding: 42px;
  }

  .event-node {
    position: absolute;
    border: 1px solid rgba(169, 112, 255, 0.5);
    border-radius: 7px;
    padding: 18px;
    background: rgba(5, 6, 12, 0.9);
  }

  .event-node small {
    color: #a970ff;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .event-node strong {
    display: block;
    margin-top: 8px;
    font-size: 19px;
  }

  .event-node-main {
    top: 56px;
    left: 44px;
    right: 44px;
  }

  .event-node-mid {
    left: 70px;
    bottom: 104px;
    width: 72%;
  }

  .flow-row {
    position: absolute;
    left: 42px;
    right: 42px;
    bottom: 42px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 7px;
    align-items: center;
  }

  .flow-row span {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    overflow: hidden;
    padding: 10px 6px;
    text-align: center;
    font-size: 1.0625rem;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.035);
  }

  .flow-row i {
    display: none;
  }

  .system-copy {
    padding: 48px;
  }

  .system-copy h2 {
    margin-top: 20px;
    max-width: 760px;
  }

  .system-copy > p {
    max-width: 760px;
    margin-top: 18px;
    font-size: 17px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 30px;
  }

  .service-grid article {
    padding: 22px;
  }

  .logo-marquee {
    margin-top: 28px;
    overflow: hidden;
    border-inline: 1px solid rgba(255, 255, 255, 0.12);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .logo-track {
    display: flex;
    width: max-content;
    gap: 14px;
    animation: event-marquee 25s linear infinite;
  }

  .logo-track figure {
    width: 124px;
    min-height: 138px;
    display: grid;
    place-items: center;
    gap: 10px;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.045);
  }

  .logo-track span {
    width: 82px;
    height: 82px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #f4f4f7;
  }

  .logo-track img {
    max-width: 66px;
    max-height: 50px;
    object-fit: contain;
  }

  .logo-track figcaption {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.0625rem;
    font-weight: 800;
    text-align: center;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 22px;
  }

  .tool-grid article {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
  }

  .tool-grid img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 7px;
    background: #f4f4f7;
    padding: 8px;
  }

  .tool-grid strong,
  .tool-grid span {
    display: block;
  }

  .tool-grid span {
    margin-top: 3px;
    color: rgba(255, 255, 255, 0.56);
    font-size: 1.0625rem;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .roadmap-grid article {
    min-height: 230px;
    padding: 24px;
  }

  .roadmap-grid p {
    margin-top: 14px;
  }

  .deliverables-section h2,
  .sources-section h2,
  .faq-section h2 {
    max-width: 620px;
    margin-top: 20px;
  }

  .deliverables-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 30px;
  }

  .deliverables-grid div {
    position: relative;
    overflow: hidden;
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 0 18px;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 800;
    transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease, color 260ms ease;
  }

  .deliverables-grid div::before {
    position: absolute;
    inset: 0;
    background:
