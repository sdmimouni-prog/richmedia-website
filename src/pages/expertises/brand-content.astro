---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import ParticleLogoSlide from '../../components/ParticleLogoSlide.astro';
import { SITE } from '../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';

const assetBase = '/assets/richmedia-brand-content';
const homeBase = '/assets/richmedia-home';
const realizationBase = '/assets/richmedia-realizations';
const logoBase = '/assets/richmedia-digital-strategy/logos';
const pageUrl = `${SITE.url}/expertises/brand-content`;

const seoTitle = 'Agence brand content au Maroc | Richmedia';
const seoDescription =
  'Créez des contenus social-first, vidéos courtes, UGC et storytelling de marque pour renforcer préférence, preuve et conversion.';

const trendPillars = [
  {
    label: '01',
    title: 'Contenu citable par l’IA',
    text: 'Des pages, scripts et FAQ structurés pour être compris par Google, les moteurs IA et les assistants conversationnels.',
  },
  {
    label: '02',
    title: 'Vidéo social-first',
    text: 'Des idées pensées d’abord pour les formats courts : reels, stories, hooks, carrousels, lives et cutdowns paid.',
  },
  {
    label: '03',
    title: 'Preuve créateur',
    text: 'UGC, créateurs, témoignages, coulisses et cas clients pour rendre la marque plus humaine et plus crédible.',
  },
  {
    label: '04',
    title: 'Séries éditoriales',
    text: 'Des rendez-vous réutilisables qui donnent un rythme à la marque et transforment une campagne en actif long terme.',
  },
  {
    label: '05',
    title: 'Distribution utile',
    text: 'Chaque contenu est pensé pour vivre sur plusieurs canaux : social, SEO, paid media, email, landing page et sales deck.',
  },
  {
    label: '06',
    title: 'Mesure créative',
    text: 'Les hooks, formats, messages et visuels sont optimisés avec les signaux terrain : vues qualifiées, sauvegardes, leads et ventes.',
  },
];

const contentSystem = [
  {
    kicker: 'Clarifier',
    title: 'Point de vue de marque',
    text: 'Définir le point de vue de marque, les audiences, les tensions culturelles et les angles qui méritent d’être racontés.',
    items: ['Insight', 'Ton', 'Promesse', 'Angles'],
  },
  {
    kicker: 'Créer',
    title: 'Production agile',
    text: 'Transformer les idées en assets prêts à diffuser : KV, stories, reels, shootings, UGC, carrousels et scripts.',
    items: ['Vidéo courte', 'Photo', 'UGC', 'Motion'],
  },
  {
    kicker: 'Amplifier',
    title: 'Moteur éditorial',
    text: 'Organiser la diffusion par moments, canaux, objectifs et réutilisations pour augmenter la durée de vie du contenu.',
    items: ['Social', 'SEO/GEO', 'Paid', 'Email'],
  },
  {
    kicker: 'Apprendre',
    title: 'Boucle créative',
    text: 'Lire les signaux, identifier les formats gagnants et décliner plus vite ce qui génère attention et conversion.',
    items: ['Hooks', 'Saves', 'Watch time', 'Leads'],
  },
];

const formats = [
  'Plateforme éditoriale',
  'Piliers de contenu',
  'Storytelling de marque',
  'Scripts Reels',
  'Stories & carrousels',
  'Shooting photo',
  'UGC briefs',
  'Contenus landing page',
  'FAQ GEO',
  'Calendrier social',
  'Guidelines de ton',
  'Reporting de contenu',
];

const creativeReel = [
  { label: 'UIR - Ouverture des inscriptions', image: `${homeBase}/campaign-wide-uir.webp`, shape: 'wide' },
  { label: 'Amana - Tramway Casablanca', image: `${homeBase}/campaign-wide-amana-tram.webp`, shape: 'wide' },
  { label: 'Don Simon - Saveurs naturelles', image: `${homeBase}/campaign-wide-donsimon.webp`, shape: 'wide' },
  { label: 'Amana - Campagne proximité', image: `${homeBase}/campaign-wide-amana-social.webp`, shape: 'wide' },
  { label: 'ADA - Produits locaux', image: `${homeBase}/campaign-wide-ada.webp`, shape: 'wide' },
  { label: 'Maserati - Push WhatsApp Levante', image: `${realizationBase}/maserati-levante-push-whatsapp.webp`, shape: 'portrait' },
  { label: 'Oreo - KV Back to School', image: `${realizationBase}/oreo-back-to-school-kv.webp`, shape: 'photo' },
  { label: 'Milka - Lancement Back to School', image: `${realizationBase}/milka-back-to-school.webp`, shape: 'photo' },
  { label: 'Nescafé - Campagne Nadi Nescafé', image: `${realizationBase}/nescafe-nadi-nescafe.webp`, shape: 'photo' },
  { label: 'Ryad Al Andalous - Cadre de vie', image: `${realizationBase}/ryad-al-andalous-square.webp`, shape: 'square' },
  { label: 'Tramway - Campagne été', image: `${realizationBase}/tramway-summer-square.webp`, shape: 'portrait' },
  { label: 'Moul Pounj - Coupe du monde', image: `${realizationBase}/moul-pounj-world-cup.webp`, shape: 'wide' },
  { label: 'TBS Casablanca - Masters of Science', image: `${realizationBase}/tbs-casablanca.webp`, shape: 'photo' },
  { label: 'CMR - Retraite digitale', image: `${realizationBase}/cmr-retirement.webp`, shape: 'wide' },
  { label: 'Moul Pounj - Carousel social', image: `${realizationBase}/moul-pounj-carousel.webp`, shape: 'wide' },
  { label: 'Ryad Al Andalous - Format panoramique', image: `${realizationBase}/ryad-al-andalous-wide.webp`, shape: 'wide' },
  { label: 'Rabat Riviera - Golf living', image: `${realizationBase}/rabat-riviera-wide.webp`, shape: 'wide' },
  { label: 'BED - Luxury comfort', image: `${realizationBase}/beed-wide.webp`, shape: 'wide' },
  { label: 'Tramway - Application mobile', image: `${realizationBase}/tramway-mobile-app.webp`, shape: 'wide' },
  { label: 'Amana - Format clean', image: `${homeBase}/campaign-amana-clean.webp`, shape: 'wide' },
  { label: 'Don Simon - Format clean', image: `${homeBase}/campaign-donsimon-clean.webp`, shape: 'wide' },
  { label: 'Moul Pounj - Format clean', image: `${homeBase}/campaign-moul-pounj-clean.webp`, shape: 'wide' },
];

const storyCampaigns = [
  { label: 'SONARGES - Sport & Lifestyle Summer Vibes', image: `${assetBase}/stories/sonarges-sport-lifestyle.webp` },
  { label: 'LC Waikiki - Mode & Tendance Printemps', image: `${assetBase}/stories/lc-waikiki-mode-tendance.webp` },
  { label: 'Bioderma - Photoderm SPF 50+', image: `${assetBase}/stories/bioderma-photoderm-spf.webp` },
  { label: 'Mustela - No Knots Happy Hair', image: `${assetBase}/stories/mustela-happy-hair.webp` },
  { label: 'Uriage - Uriage Day Experience', image: `${assetBase}/stories/uriage-day-experience.webp` },
  { label: 'Filorga - Launch Night', image: `${assetBase}/stories/filorga-launch-night.webp` },
];

const creativeReelMidpoint = Math.ceil(creativeReel.length / 2);
const creativeReelLeft = creativeReel.slice(0, creativeReelMidpoint);
const creativeReelRight = creativeReel.slice(creativeReelMidpoint);

const partnerGroups = [
  {
    title: 'Publication sociale & communauté',
    partners: [
      { name: 'Later', logo: `${logoBase}/later.png` },
      { name: 'Hootsuite', logo: `${logoBase}/hootsuite.svg` },
      { name: 'Buffer', logo: `${logoBase}/buffer.svg` },
      { name: 'Sprout Social', logo: `${logoBase}/sprout-social.png` },
      { name: 'SocialBee', logo: `${logoBase}/socialbee.png` },
      { name: 'Zoho Social', logo: `${logoBase}/zoho.svg` },
    ],
  },
];

const roadmap = [
  {
    number: '01',
    title: 'Trouver l’angle',
    text: 'Ce que la marque peut dire avec légitimité, ce que l’audience attend et ce que la catégorie ne raconte pas encore.',
  },
  {
    number: '02',
    title: 'Construire la série',
    text: 'Un territoire, des rubriques, des formats et une cadence qui rendent la marque reconnaissable.',
  },
  {
    number: '03',
    title: 'Produire les assets',
    text: 'Shooting, scripts, stories, reels, carrousels, déclinaisons paid et contenus SEO/GEO.',
  },
  {
    number: '04',
    title: 'Mesurer et recycler',
    text: 'Analyse des signaux, sélection des meilleurs contenus et nouvelles variations pour prolonger la performance.',
  },
];

const faq = [
  {
    question: 'Qu’est-ce que le brand content ?',
    answer:
      'Le brand content désigne les contenus créés par une marque pour informer, inspirer, divertir ou rassurer une audience, sans se limiter à une logique publicitaire directe.',
  },
  {
    question: 'Pourquoi le brand content est important pour le GEO ?',
    answer:
      'Les moteurs IA privilégient les contenus clairs, utiles, structurés et cohérents avec une expertise identifiable. Un bon brand content aide une marque à être comprise, citée et recommandée.',
  },
  {
    question: 'Quels formats prioriser en 2026 ?',
    answer:
      'Les vidéos courtes, stories, UGC, carrousels, pages FAQ, contenus experts, cas clients et formats réutilisables sont les plus pertinents pour relier attention, preuve et conversion.',
  },
  {
    question: 'Comment mesurer une stratégie brand content ?',
    answer:
      'On mesure la visibilité, la rétention, les sauvegardes, les partages, les conversations, les leads assistés, les conversions et la réutilisation des contenus par les équipes marketing et commerciales.',
  },
];

const schema = [
  serviceSchema({
    name: 'Brand content',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Expertises', url: `${SITE.url}/expertises` },
    { name: 'Brand content', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#answer', label: 'Réponse', value: '2026' },
  { href: '#trends', label: 'Tendances', value: '6 leviers' },
  { href: '#system', label: 'Système', value: '4 modules' },
  { href: '#brand-cta', label: 'Projet', value: 'Créer' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/brand-content-hero.webp`}
  schema={schema}
>
  <div class="brand-content-page">
    <section class="brand-hero" aria-labelledby="brand-content-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="brand-content-title">Brand content social-first et citable.</h1>
        <p>
          Richmedia transforme les idées de marque en contenus utiles, mémorables et réutilisables :
          storytelling, vidéo courte, UGC, SEO/GEO et campagnes prêtes à diffuser.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Construire votre contenu
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir les campagnes
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual" data-brand-visual aria-label="Atelier de brand content Richmedia">
        <img
          src={`${assetBase}/brand-content-hero.webp`}
          alt="Équipe créative préparant des contenus social-first"
          width="1586"
          height="992"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="signal-card signal-card-top">
          <span>Storytelling</span>
          <strong>Angle clair</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>Vidéo courte</span>
          <strong>Social-first</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>SEO + GEO</span>
          <strong>Contenu citable</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-brand-nav" aria-label="Navigation de la page brand content">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="answer-panel" id="answer" aria-labelledby="answer-title">
      <div>
        <span class="eyebrow">Réponse rapide</span>
        <h2 id="answer-title">Le contenu devient un actif de croissance.</h2>
      </div>
      <p>
        En 2026, le brand content performant clarifie une idée, se raconte en formats courts,
        se recycle sur plusieurs canaux et reste assez structuré pour être cité par les moteurs IA.
      </p>
    </section>

    <section class="trend-section" id="trends" aria-labelledby="trend-title">
      <div class="section-heading">
        <span class="eyebrow">Tendances brand content 2026</span>
        <h2 id="trend-title">Les leviers qui créent attention, confiance et citation.</h2>
      </div>
      <div class="trend-grid">
        {trendPillars.map((pillar) => (
          <article class="trend-card">
            <span>{pillar.label}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="story-campaigns" id="stories" aria-label="Campagnes brand content en stories">
      <div class="story-track">
        {storyCampaigns.map((campaign) => (
          <figure class="story-card">
            <img src={campaign.image} alt={campaign.label} loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </section>

    <section class="system-section" id="system" aria-labelledby="system-title">
      <div class="crea-reel" aria-label="Créations Richmedia">
        <div class="crea-lane">
          <div class="crea-stack">
            {creativeReelLeft.map((item) => (
              <figure class:list={['crea-frame', `crea-frame-${item.shape}`]}>
                <img src={item.image} alt={item.label} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
          <div class="crea-stack" aria-hidden="true">
            {creativeReelLeft.map((item) => (
              <figure class:list={['crea-frame', `crea-frame-${item.shape}`]}>
                <img src={item.image} alt={item.label} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
        <div class="crea-lane crea-lane-right">
          <div class="crea-stack">
            {creativeReelRight.map((item) => (
              <figure class:list={['crea-frame', `crea-frame-${item.shape}`]}>
                <img src={item.image} alt={item.label} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
          <div class="crea-stack" aria-hidden="true">
            {creativeReelRight.map((item) => (
              <figure class:list={['crea-frame', `crea-frame-${item.shape}`]}>
                <img src={item.image} alt={item.label} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Le système Richmedia</span>
        <h2 id="system-title">De l’angle de marque aux formats qui circulent.</h2>
        <p>
          Nous organisons le brand content comme une boucle : clarifier, créer, amplifier, apprendre.
          Chaque contenu doit pouvoir servir la marque, la conversion et la mémoire collective.
        </p>
        <div class="system-modules">
          {contentSystem.map((module) => (
            <article>
              <span>{module.kicker}</span>
              <h3>{module.title}</h3>
              <p>{module.text}</p>
              <div>
                {module.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="formats-section" id="formats" aria-labelledby="formats-title">
      <div class="section-heading compact">
        <span class="eyebrow">Formats & livrables</span>
        <h2 id="formats-title">Ce que votre contenu doit produire.</h2>
      </div>
      <div class="formats-grid">
        {formats.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="partner-stack" id="partners" aria-labelledby="partners-title">
      <div class="section-heading compact">
        <span class="eyebrow">Stack contenu</span>
        <h2 id="partners-title">Des outils pour trouver les signaux, publier et mesurer.</h2>
      </div>
      {partnerGroups.map((group) => (
        <div class="partner-row">
          <h3>{group.title}</h3>
          <div class="partner-grid">
            {group.partners.map((partner) => (
              <figure class="partner-card">
                <img src={partner.logo} alt={`Logo ${partner.name}`} loading="lazy" decoding="async" />
                <figcaption>{partner.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="roadmap-section" id="roadmap" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <span class="eyebrow">Méthode</span>
        <h2 id="roadmap-title">Un moteur éditorial simple à piloter.</h2>
      </div>
      <div class="roadmap-grid">
        {roadmap.map((step) => (
          <article>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Questions fréquentes.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="brand-cta" id="brand-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Prêt à produire ?</span>
        <h2 id="cta-title">Créons des contenus que vos audiences retiennent.</h2>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Démarrer un projet
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
        </div>
      </div>
      <div class="particle-field" aria-hidden="true">
        <ParticleLogoSlide />
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Amplifier le contenu avec les bons leviers"
    intro="Le brand content gagne en impact lorsqu’il sert le SEO, l’influence, l’événementiel et les campagnes mesurées."
    links={frSiloLinks.content}
    variant="compact"
  />
</BaseLayout>

<script>
  const visuals = document.querySelectorAll('[data-brand-visual]');

  visuals.forEach((visual) => {
    if (!(visual instanceof HTMLElement) || visual.dataset.ready === 'true') return;
    visual.dataset.ready = 'true';

    const move = (event: PointerEvent) => {
      const bounds = visual.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width;
      const y = (event.clientY - bounds.top) / bounds.height;
      visual.style.setProperty('--mx', `${x * 100}%`);
      visual.style.setProperty('--my', `${y * 100}%`);
      visual.style.setProperty('--rx', `${(0.5 - y) * 5}deg`);
      visual.style.setProperty('--ry', `${(x - 0.5) * 6}deg`);
    };

    const leave = () => {
      visual.style.setProperty('--mx', '62%');
      visual.style.setProperty('--my', '44%');
      visual.style.setProperty('--rx', '0deg');
      visual.style.setProperty('--ry', '0deg');
    };

    visual.addEventListener('pointermove', move);
    visual.addEventListener('pointerleave', leave);
    leave();
  });

</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .brand-content-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-light: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    overflow: hidden;
    min-height: 100vh;
    background:
      radial-gradient(circle at 82% 8%, rgba(124, 60, 255, 0.2), transparent 28rem),
      radial-gradient(circle at 8% 30%, rgba(124, 60, 255, 0.14), transparent 25rem),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
  }

  .brand-hero,
  .mobile-brand-nav,
  .answer-panel,
  .trend-section,
  .story-campaigns,
  .system-section,
  .formats-section,
  .partner-stack,
  .roadmap-section,
  .faq-section,
  .brand-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .answer-panel,
  .trend-section,
  .story-campaigns,
  .system-section,
  .formats-section,
  .partner-stack,
  .roadmap-section,
  .faq-section,
  .brand-cta {
    scroll-margin-top: 6rem;
  }

  .mobile-brand-nav {
    display: none;
  }

  .brand-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(440px, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(8rem, 12vw, 10.5rem) 0 clamp(3rem, 7vw, 5rem);
  }

  .hero-copy {
    width: min(100%, 760px);
    min-width: 0;
    justify-self: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-light);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.6rem;
    height: 2px;
    content: "";
    background: currentColor;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .brand-hero h1 {
    max-width: 760px;
    margin-top: 1.2rem;
    --h1-size: clamp(2.8rem, 6.6vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .brand-hero p,
  .answer-panel p,
  .system-copy > p,
  .roadmap-grid p,
  .faq-list p {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.65;
  }

  .brand-hero p {
    max-width: 660px;
    margin-top: 1.3rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.8rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3rem;
    border-radius: 8px;
    padding: 0.85rem 1.2rem;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
