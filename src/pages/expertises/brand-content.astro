  .hero-visual::after {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(3, 4, 7, 0.18), transparent 42%),
      linear-gradient(180deg, transparent 54%, rgba(3, 4, 7, 0.72));
