---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import { SITE } from '../../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';

const assetBase = '/assets/richmedia-web-si';
const logoBase = `${assetBase}/logos`;
const logoDimensions: Record<string, { width: number; height: number }> = {
  'html5.png': { width: 202, height: 273 },
  'javascript.png': { width: 287, height: 288 },
  'react.png': { width: 390, height: 350 },
  'nodejs.png': { width: 329, height: 366 },
  'php.png': { width: 352, height: 201 },
  'laravel.png': { width: 350, height: 366 },
  'sql.png': { width: 320, height: 184 },
  'github.png': { width: 327, height: 109 },
  'markerio.png': { width: 435, height: 108 },
};

const seoTitle = 'Agence Web & SI à Casablanca — sites, plateformes, CRM & GEO | Richmedia';
const seoDescription =
  'Richmedia conçoit des sites web, plateformes et systèmes connectés à Casablanca : UX/UI, SEO/GEO, CRM, tracking, sécurité et performance.';
const pageUrl = `${SITE.url}/expertises/web-si`;

const trends = [
  {
    label: 'AI search',
    title: 'Des pages lisibles par Google et les moteurs IA',
    text: 'Structure claire, réponses directes, FAQ, JSON-LD, HTML statique et contenus experts pour être compris, repris et cités.',
  },
  {
    label: 'Owned media',
    title: 'Le site redevient le hub de contenu',
    text: 'Les campagnes social, vidéo et créateurs doivent atterrir dans un espace propriétaire rapide, mesurable et réutilisable.',
  },
  {
    label: 'First-party data',
    title: 'Personnalisation sans dépendre des plateformes',
    text: 'Formulaires, CRM, WhatsApp, consentement et scoring transforment les visites en données utiles et activables.',
  },
  {
    label: 'Proof content',
    title: 'La preuve remplace le discours générique',
    text: 'Cas clients, avis, démonstrations, chiffres et contenus terrain donnent aux visiteurs comme aux IA des signaux de confiance.',
  },
  {
    label: 'Composable',
    title: 'Des briques SI connectées plutôt qu’un bloc figé',
    text: 'CMS, API, back-office, dashboards et automatisations sont pensés pour évoluer sans refaire toute la plateforme.',
  },
  {
    label: 'Performance',
    title: 'Vitesse, accessibilité et sécurité dès le cadrage',
    text: 'Un bon dispositif web protège le référencement, la conversion, la conformité et la qualité d’expérience sur mobile.',
  },
];

const systemModules = [
  {
    kicker: 'UX/UI',
    title: 'Sites et interfaces utiles',
    text: 'Architecture de l’information, design system, pages SEO/GEO, landing pages, formulaires et parcours mobile-first.',
    items: ['Site vitrine', 'Landing pages', 'Design system', 'Accessibilité'],
  },
  {
    kicker: 'Plateforme',
    title: 'CMS, back-office et espaces connectés',
    text: 'Des espaces administrables pour publier, piloter des contenus, gérer des leads ou connecter un service métier.',
    items: ['CMS', 'Back-office', 'Portail', 'E-commerce'],
  },
  {
    kicker: 'SI marketing',
    title: 'CRM, WhatsApp, API et automatisation',
    text: 'Le site devient un point d’entrée vers le système commercial : qualification, routing, nurturing et suivi.',
    items: ['CRM', 'API', 'WhatsApp', 'Automation'],
  },
  {
    kicker: 'Mesure',
    title: 'Tracking, dashboards et QA continue',
    text: 'Plan de taggage, événements clés, tests, feedback utilisateur et dashboards pour décider vite et juste.',
    items: ['GTM', 'Analytics', 'Marker.io', 'Reporting'],
  },
];

const deliverables = [
  'Audit UX, SEO/GEO et technique',
  'Architecture de l’information',
  'Wireframes et maquettes UI',
  'Design system web',
  'Pages optimisées SEO/GEO',
  'Développement front-end',
  'Back-office ou CMS',
  'Intégrations CRM & API',
  'Plan de tracking',
  'Tests responsive',
  'Recette sécurité & performance',
  'Documentation de livraison',
];

const toolGroups = [
  {
    title: 'Front-end & expérience',
    tools: [
      { name: 'HTML5', logo: 'html5.png', note: 'Structure sémantique' },
      { name: 'JavaScript', logo: 'javascript.png', note: 'Interactions et tracking' },
      { name: 'React', logo: 'react.png', note: 'Interfaces dynamiques' },
    ],
  },
  {
    title: 'Back-end, données & SI',
    tools: [
      { name: 'Node.js', logo: 'nodejs.png', note: 'API et services' },
      { name: 'PHP', logo: 'php.png', note: 'Écosystèmes CMS' },
      { name: 'Laravel', logo: 'laravel.png', note: 'Applications métier' },
      { name: 'SQL', logo: 'sql.png', note: 'Données structurées' },
    ],
  },
  {
    title: 'Qualité, collaboration & livraison',
    tools: [
      { name: 'GitHub', logo: 'github.png', note: 'Versioning et livraison' },
      { name: 'Marker.io', logo: 'markerio.png', note: 'Recette et feedback' },
    ],
  },
];

const heroTools = toolGroups.flatMap((group) => group.tools);

const roadmap = [
  {
    step: '01',
    title: 'Cadrer',
    text: 'Objectifs business, audiences, contenus, contraintes SI, priorités SEO/GEO et parcours de conversion.',
  },
  {
    step: '02',
    title: 'Architecturer',
    text: 'Plan de pages, structure de données, composants, intégrations, tracking et règles de gouvernance.',
  },
  {
    step: '03',
    title: 'Construire',
    text: 'Design, développement, contenus, CMS, formulaires, API et automatisations avec cycles de validation courts.',
  },
  {
    step: '04',
    title: 'Vérifier',
    text: 'Tests responsive, performance, accessibilité, sécurité, SEO technique, balisage et recette métier.',
  },
  {
    step: '05',
    title: 'Optimiser',
    text: 'Lecture des signaux, corrections, A/B tests, enrichissement contenu, automatisations et reporting continu.',
  },
];

const sourceNotes = [
  {
    title: 'AI search & contenu utile',
    text: 'La visibilité dépend de pages claires, originales, techniquement accessibles et structurées pour les moteurs classiques comme IA.',
    href: 'https://developers.google.com/search/docs/fundamentals/creating-helpful-content',
  },
  {
    title: 'Marketing 2026',
    text: 'Les équipes marketing accélèrent sur l’IA, la personnalisation, la vidéo courte, la mesure et les expériences multi-canales.',
    href: 'https://blog.hubspot.com/marketing/hubspot-blog-marketing-industry-trends-report',
  },
  {
    title: 'Contenu B2B',
    text: 'Les contenus performants combinent expertise, confiance, distribution, owned media et preuves concrètes.',
    href: 'https://contentmarketinginstitute.com/b2b-research/b2b-content-marketing-trends-research/',
  },
  {
    title: 'Créateurs & vidéo',
    text: 'Le contenu créateur devient un canal média suivi comme les autres, avec besoin de landing pages et de preuves mesurables.',
    href: 'https://www.marketingdive.com/news/creator-marketing-now-a-core-media-channel-while-search-slows-iab/817832/',
  },
];

const faq = [
  {
    question: 'Qu’est-ce que l’expertise Web & SI de Richmedia ?',
    answer:
      'Web & SI désigne la conception de sites, plateformes, CMS, back-offices et intégrations qui relient l’expérience utilisateur au CRM, aux données, au tracking et aux systèmes métier.',
  },
  {
    question: 'Pourquoi connecter un site web au système d’information ?',
    answer:
      'Un site connecté qualifie mieux les leads, évite les ressaisies, fiabilise la mesure, automatise les relances et transforme les campagnes en actifs propriétaires.',
  },
  {
    question: 'Comment une page Web & SI peut-elle être optimisée SEO/GEO ?',
    answer:
      'Elle doit répondre clairement aux questions de l’audience, utiliser une structure HTML propre, du JSON-LD, des FAQ, des preuves, des URLs canoniques et des contenus suffisamment précis pour être cités par les moteurs IA.',
  },
  {
    question: 'Richmedia développe-t-elle seulement des sites vitrines ?',
    answer:
      'Non. Richmedia peut créer des sites vitrines premium, landing pages, plateformes web, back-offices, intégrations CRM, parcours WhatsApp, dashboards et systèmes de recette.',
  },
];

const schema = [
  serviceSchema({
    name: 'Web & SI',
    description: seoDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Expertises', url: `${SITE.url}/expertises` },
    { name: 'Web & SI', url: pageUrl },
  ]),
];

const mobileQuickLinks = [
  { href: '#answer', label: 'Réponse', value: '2026' },
  { href: '#trends', label: 'Tendances', value: '6 signaux' },
  { href: '#system', label: 'Système', value: '4 modules' },
  { href: '#web-cta', label: 'Projet', value: 'Cadrer' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${logoBase}/contact-sheet.webp`}
  schema={schema}
>
  <div class="web-si-page">
    <section class="web-hero" aria-labelledby="web-si-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="web-si-title">Web & SI connectés à la croissance.</h1>
        <p class="hero-lead">
          Nous concevons des sites, plateformes et systèmes connectés qui transforment vos contenus,
          campagnes et données en parcours visibles, mesurables et activables par vos équipes.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Cadrer votre projet web
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir nos réalisations
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-system" aria-label="Interface Web & SI Richmedia">
        <div class="browser-shell" data-web-si-hover-card>
          <div class="browser-top" aria-hidden="true">
            <span></span><span></span><span></span>
            <strong>richmedia.ma / web-si</strong>
          </div>
          <div class="browser-body">
            <div class="code-panel">
              <span>&lt;section type="growth-system"&gt;</span>
              <strong>SEO/GEO + CRM + tracking</strong>
              <small>Pages rapides, données propres, intégrations utiles.</small>
            </div>
            <div class="system-flow" aria-hidden="true">
              <span>Contenu</span>
              <i></i>
              <span>Données</span>
              <i></i>
              <span>CRM</span>
            </div>
          </div>
        </div>
        <div class="hero-logo-cloud" aria-label="Technologies utilisées">
          <div class="logo-track">
            {[0, 1].map((loopIndex) => (
              <div class="logo-track-segment" aria-hidden={loopIndex === 1 ? 'true' : undefined}>
                {heroTools.map((tool) => (
                  <figure>
                    <span>
                      <img
                        src={`${logoBase}/${tool.logo}`}
                        alt={`Logo ${tool.name}`}
                        width={logoDimensions[tool.logo].width}
                        height={logoDimensions[tool.logo].height}
                        loading="eager"
                        decoding="async"
                      />
                    </span>
                    <figcaption>{tool.name}</figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <nav class="mobile-web-nav" aria-label="Navigation de la page Web & SI">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="quick-answer" id="answer" aria-labelledby="quick-answer-title">
      <div>
        <span class="eyebrow">Réponse rapide</span>
        <h2 id="quick-answer-title">En 2026, un site web doit être un système d’acquisition.</h2>
      </div>
      <p>
        Un dispositif Web & SI performant relie contenus, SEO/GEO, CRM, tracking, feedback utilisateur
        et automatisations pour créer de la visibilité, convertir les bons prospects et apprendre plus vite.
      </p>
    </section>

    <section class="trend-section" id="trends" aria-labelledby="trend-title">
      <div class="section-heading">
        <span class="eyebrow">Tendances Web & SI 2026</span>
        <h2 id="trend-title">Ce que nous intégrons dans l’architecture web.</h2>
      </div>
      <div class="trend-grid">
        {trends.map((trend) => (
          <article>
            <span>{trend.label}</span>
            <h3>{trend.title}</h3>
            <p>{trend.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="system-section" id="system" aria-labelledby="system-title">
      <div class="system-visual" aria-hidden="true">
        <div class="stack-card stack-card-main">
          <span>Web platform</span>
          <strong>UX, contenu, SEO/GEO</strong>
        </div>
        <div class="stack-card stack-card-left">
          <span>SI marketing</span>
          <strong>CRM · API · WhatsApp</strong>
        </div>
        <div class="stack-card stack-card-right">
          <span>Mesure</span>
          <strong>Tracking · QA · dashboards</strong>
        </div>
        <div class="stack-lines"></div>
      </div>
      <div class="system-copy">
        <span class="eyebrow">Le système Richmedia</span>
        <h2 id="system-title">Des interfaces belles, mais surtout opérables.</h2>
        <p>
          Nous construisons le web comme un actif métier : clair pour les visiteurs, indexable par les moteurs,
          branché aux outils commerciaux et simple à faire évoluer après la mise en ligne.
        </p>
        <div class="module-grid">
          {systemModules.map((module) => (
            <article>
              <span>{module.kicker}</span>
              <h3>{module.title}</h3>
              <p>{module.text}</p>
              <div>
                {module.items.map((item) => <small>{item}</small>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="deliverables-section" id="deliverables" aria-labelledby="deliverables-title">
      <div class="section-heading compact">
        <span class="eyebrow">Livrables</span>
        <h2 id="deliverables-title">Ce que la livraison doit rendre maîtrisable.</h2>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="tool-stack" id="tools" aria-labelledby="tool-stack-title">
      <div class="section-heading compact">
        <span class="eyebrow">Partenaires & outils</span>
        <h2 id="tool-stack-title">Une stack lisible pour concevoir, développer, connecter et recetter.</h2>
      </div>
      {toolGroups.map((group) => (
        <div class="tool-row">
          <h3>{group.title}</h3>
          <div class="tool-grid">
            {group.tools.map((tool) => (
              <figure>
                <span>
                  <img
                    src={`${logoBase}/${tool.logo}`}
                    alt={`Logo ${tool.name}`}
                    width={logoDimensions[tool.logo].width}
                    height={logoDimensions[tool.logo].height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <figcaption>
                  <strong>{tool.name}</strong>
                  <small>{tool.note}</small>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="roadmap-section" id="roadmap" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <span class="eyebrow">Méthode</span>
        <h2 id="roadmap-title">Un projet web cadré comme un produit digital.</h2>
      </div>
      <div class="roadmap">
        {roadmap.map((item) => (
          <article>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sources-section" id="watch" aria-labelledby="sources-title">
      <div class="section-heading compact">
        <span class="eyebrow">Veille 2026</span>
        <h2 id="sources-title">Les signaux utilisés pour cadrer la page.</h2>
      </div>
      <div class="source-grid">
        {sourceNotes.map((source) => (
          <a href={source.href} target="_blank" rel="noopener noreferrer">
            <strong>{source.title}</strong>
            <span>{source.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ SEO/GEO</span>
        <h2 id="faq-title">Questions fréquentes.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="web-cta" id="web-cta" aria-labelledby="cta-title">
      <div>
        <span class="eyebrow">Prêt à connecter ?</span>
        <h2 id="cta-title">Créons un site qui sert vos contenus, vos équipes et vos ventes.</h2>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/contact">
          Démarrer un projet
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Connecter le socle web au SEO et CRM"
    intro="Un site performant devient plus utile lorsqu’il relie visibilité, tracking, contenus et automatisation commerciale."
    links={frSiloLinks.web}
    variant="compact"
  />
</BaseLayout>

<script>
  const webSiHoverCards = document.querySelectorAll('[data-web-si-hover-card]');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canHover && !reduceMotion) {
    webSiHoverCards.forEach((card) => {
      if (!(card instanceof HTMLElement) || card.dataset.hoverReady === 'true') return;
      card.dataset.hoverReady = 'true';

      const resetCard = () => {
        card.style.setProperty('--mouse-x', '72%');
        card.style.setProperty('--mouse-y', '22%');
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
      };

      const moveCard = (event: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        const x = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
        const y = Math.min(Math.max((event.clientY - rect.top) / rect.height, 0), 1);

        card.style.setProperty('--mouse-x', `${(x * 100).toFixed(2)}%`);
        card.style.setProperty('--mouse-y', `${(y * 100).toFixed(2)}%`);
        card.style.setProperty('--tilt-x', `${((0.5 - y) * 7).toFixed(2)}deg`);
        card.style.setProperty('--tilt-y', `${((x - 0.5) * 9).toFixed(2)}deg`);
      };

      resetCard();
      card.addEventListener('pointermove', moveCard);
      card.addEventListener('pointerleave', resetCard);
      card.addEventListener('pointercancel', resetCard);
    });
  }
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .web-si-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-2: #a977ff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.68);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 9%, rgba(124, 60, 255, 0.2), transparent 28rem),
      radial-gradient(circle at 12% 32%, rgba(124, 60, 255, 0.14), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
    color: #fff;
  }

  .web-hero,
  .mobile-web-nav,
  .quick-answer,
  .trend-section,
  .system-section,
  .deliverables-section,
  .tool-stack,
  .roadmap-section,
  .sources-section,
  .faq-section,
  .web-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .quick-answer,
  .trend-section,
  .system-section,
  .deliverables-section,
  .tool-stack,
  .roadmap-section,
  .sources-section,
  .faq-section,
  .web-cta {
    scroll-margin-top: 6rem;
  }

  .mobile-web-nav {
    display: none;
  }

  .web-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(460px, 1.12fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(8rem, 12vw, 10.5rem) 0 clamp(3rem, 7vw, 5.5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--purple-2);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.6rem;
    height: 2px;
    content: "";
    background: currentColor;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .web-hero h1 {
    max-width: 760px;
    margin-top: 1.2rem;
    --h1-size: clamp(2.45rem, 4.8vw, 3.125rem);
    line-height: 1;
    text-wrap: balance;
  }

  .hero-lead,
  .quick-answer p,
  .system-copy > p,
  .roadmap p,
  .faq-list p,
  .source-grid span {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    line-height: 1.7;
  }

  .hero-lead {
    max-width: 680px;
    margin-top: 1.45rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    border-radius: 8px;
    padding: 0.9rem 1.25rem;
    font-size: 0.98rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9655ff, #6425f4);
    box-shadow: 0 1.1rem 2.8rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-system {
    position: relative;
    min-height: clamp(430px, 38vw, 560px);
    perspective: 1200px;
    perspective-origin: 55% 34%;
  }

  .browser-shell {
    --mouse-x: 72%;
    --mouse-y: 22%;
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    position: absolute;
    inset: 0 0 6rem;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background:
      radial-gradient(circle at var(--mouse-x) var(--mouse-y), rgba(169, 119, 255, 0.24), transparent 17rem),
      radial-gradient(circle at 78% 18%, rgba(124, 60, 255, 0.2), transparent 18rem),
      #07080d;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.42);
    transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(0) scale(1);
    transform-style: preserve-3d;
    transition:
      transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 260ms ease,
      box-shadow 260ms ease;
    will-change: transform;
  }

  .browser-shell::before {
    position: absolute;
    inset: 3.8rem 1.15rem 1.15rem;
    z-index: 0;
    content: "";
    border: 1px solid rgba(255, 255, 255, 0.09);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    transition: border-color 260ms ease, filter 260ms ease, opacity 260ms ease;
  }

  .browser-shell::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    background:
      radial-gradient(circle at var(--mouse-x) var(--mouse-y), rgba(169, 119, 255, 0.34), transparent 18rem),
      linear-gradient(115deg, transparent 18%, rgba(255, 255, 255, 0.08) 42%, transparent 62%);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .browser-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
    padding: 0 1rem;
    background: rgba(255, 255, 255, 0.035);
  }

  .browser-top span {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.26);
    transition: background 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .browser-top strong {
    margin-left: 0.6rem;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.78rem;
    font-weight: 700;
    transition: color 220ms ease, transform 220ms ease;
  }

  .browser-body {
    position: relative;
    z-index: 2;
    min-height: calc(100% - 3.25rem);
    transform-style: preserve-3d;
  }

  .code-panel {
    position: absolute;
    top: 16%;
    left: 6%;
    z-index: 2;
    display: grid;
    gap: 0.72rem;
    max-width: 23rem;
    overflow: hidden;
    border: 1px solid rgba(169, 119, 255, 0.42);
    border-radius: 8px;
    padding: clamp(1rem, 2vw, 1.4rem);
    background: rgba(5, 7, 15, 0.84);
    box-shadow: 0 1.25rem 3.4rem rgba(0, 0, 0, 0.34);
    transform: translate3d(0, 0, 34px);
    transition:
      transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 260ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
    will-change: transform;
  }

  .code-panel::before {
    position: absolute;
    inset: -46% -18%;
    content: "";
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(169, 119, 255, 0.06) 42%,
      rgba(255, 255, 255, 0.22) 50%,
      rgba(169, 119, 255, 0.06) 58%,
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
    transform: translateX(-120%) rotate(8deg);
  }

  .code-panel > * {
    position: relative;
    z-index: 1;
  }

  .code-panel span {
    color: #a977ff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    transition: color 220ms ease, text-shadow 220ms ease;
  }

  .code-panel strong {
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.06;
    transition: text-shadow 220ms ease;
  }

  .code-panel small {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .system-flow {
    position: absolute;
    right: 6%;
    bottom: 12%;
    left: 8%;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 0.7rem;
    transform: translateZ(22px);
  }

  .system-flow span {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
    transition: border-color 220ms ease, background 220ms ease, box-shadow 220ms ease;
  }

  .system-flow span::before {
    position: absolute;
    inset: 0;
    content: "";
    background:
      radial-gradient(circle at 50% 0, rgba(169, 119, 255, 0.32), transparent 58%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.1), transparent 62%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .system-flow i {
    position: relative;
    overflow: hidden;
    width: 2rem;
    height: 1px;
    background: linear-gradient(90deg, rgba(169, 119, 255, 0.2), rgba(169, 119, 255, 0.9));
  }

  .system-flow i::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(90deg, transparent, #fff, rgba(169, 119, 255, 0.95));
    opacity: 0;
    transform: translateX(-110%);
  }

  @media (hover: hover) and (pointer: fine) {
    .browser-shell:hover {
      border-color: rgba(169, 119, 255, 0.56);
      box-shadow:
        0 2.4rem 6rem rgba(0, 0, 0, 0.52),
        0 0 0 1px rgba(169, 119, 255, 0.16),
        0 0 4.2rem rgba(124, 60, 255, 0.24);
      transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(-8px) scale(1.015);
    }

    .browser-shell:hover::before {
      border-color: rgba(169, 119, 255, 0.18);
      filter: drop-shadow(0 0 1.6rem rgba(124, 60, 255, 0.18));
      opacity: 0.95;
    }

    .browser-shell:hover::after {
      opacity: 1;
      animation: browser-aurora 4.8s linear infinite;
    }

    .browser-shell:hover .browser-top span {
      background: rgba(169, 119, 255, 0.75);
      box-shadow: 0 0 1.1rem rgba(169, 119, 255, 0.42);
      animation: browser-dot-pop 720ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .browser-shell:hover .browser-top span:nth-child(2) {
      animation-delay: 70ms;
    }

    .browser-shell:hover .browser-top span:nth-child(3) {
      animation-delay: 140ms;
    }

    .browser-shell:hover .browser-top strong {
      color: rgba(255, 255, 255, 0.86);
      transform: translateX(3px);
    }

    .browser-shell:hover .code-panel {
      border-color: rgba(200, 169, 255, 0.82);
      background: rgba(7, 9, 18, 0.92);
      box-shadow:
        0 1.6rem 3.8rem rgba(0, 0, 0, 0.46),
        0 0 2.2rem rgba(124, 60, 255, 0.23);
      transform: translate3d(0, -6px, 58px) scale(1.025);
    }

    .browser-shell:hover .code-panel::before {
      opacity: 1;
      animation: code-panel-scan 1.15s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }

    .browser-shell:hover .code-panel span {
      color: #cbb1ff;
      text-shadow: 0 0 1rem rgba(169, 119, 255, 0.58);
    }

    .browser-shell:hover .code-panel strong {
      text-shadow: 0 0 1.4rem rgba(255, 255, 255, 0.18);
    }

    .browser-shell:hover .system-flow span {
      border-color: rgba(169, 119, 255, 0.45);
      background: rgba(169, 119, 255, 0.12);
      box-shadow: 0 0 1.8rem rgba(124, 60, 255, 0.16);
      animation: flow-node-pulse 860ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .browser-shell:hover .system-flow span::before {
      opacity: 1;
    }

    .browser-shell:hover .system-flow span:nth-of-type(2) {
      animation-delay: 160ms;
    }

    .browser-shell:hover .system-flow span:nth-of-type(3) {
      animation-delay: 320ms;
    }

    .browser-shell:hover .system-flow i::after {
      opacity: 1;
      animation: flow-line-pass 760ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .browser-shell:hover .system-flow i:nth-of-type(2)::after {
      animation-delay: 190ms;
    }
  }

  @keyframes browser-aurora {
    0% {
      filter: hue-rotate(0deg);
      transform: translate3d(-1%, -1%, 0) scale(1);
    }

    50% {
      filter: hue-rotate(16deg);
      transform: translate3d(1.5%, 1%, 0) scale(1.03);
    }

    100% {
      filter: hue-rotate(0deg);
      transform: translate3d(-1%, -1%, 0) scale(1);
    }
  }

  @keyframes browser-dot-pop {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    45% {
      transform: translateY(-2px) scale(1.18);
    }
  }

  @keyframes code-panel-scan {
    0% {
      transform: translateX(-120%) rotate(8deg);
    }

    100% {
      transform: translateX(120%) rotate(8deg);
    }
  }

  @keyframes flow-node-pulse {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    45% {
      transform: translateY(-5px) scale(1.035);
    }
  }

  @keyframes flow-line-pass {
    0% {
      transform: translateX(-110%);
    }

    100% {
      transform: translateX(110%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .browser-shell,
    .browser-shell::before,
    .browser-shell::after,
    .browser-top span,
    .browser-top strong,
    .code-panel,
    .code-panel::before,
    .code-panel span,
    .code-panel strong,
    .system-flow span,
    .system-flow span::before,
    .system-flow i::after,
    .logo-track {
      animation: none !important;
      transition: none !important;
    }

    .browser-shell,
    .code-panel,
    .system-flow span {
      transform: none !important;
    }
  }

  .hero-logo-cloud {
    position: absolute;
    right: 0.9rem;
    bottom: 0;
    left: 0.9rem;
    z-index: 3;
