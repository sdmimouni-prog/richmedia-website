  Zapier: `${logoBase}/zapier.svg`,
  'Google Trends': `${logoBase}/google-trends.png`,
  TrueClicks: `${logoBase}/trueclicks.png`,
  'Microsoft Clarity': `${logoBase}/microsoft-clarity.png`,
  'Looker Studio': `${logoBase}/looker-studio.svg`,
  Meta: `${logoBase}/meta.svg`,
  'Microsoft Ads': `${logoBase}/microsoft-ads.png`,
  'Google Ads': `${logoBase}/google-ads.svg`,
  'Google Analytics': `${logoBase}/google-analytics.svg`,
  Ahrefs: `${logoBase}/ahrefs.png`,
  'Google Tag Manager': `${logoBase}/google-tag-manager.svg`,
  GoDaddy: `${logoBase}/godaddy.svg`,
  'Tech Times': `${logoBase}/tech-times.png`,
