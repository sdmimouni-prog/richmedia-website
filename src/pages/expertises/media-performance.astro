        <span class="eyebrow">Partenaires & outils</span>
        <h2 id="partners-title">Une stack pensée pour acheter, mesurer, comparer et optimiser.</h2>
      </div>
      {partnerGroups.map((group) => (
        <div class="partner-row">
          <h3>{group.title}</h3>
          <div class="partner-grid">
            {group.partners.map((partner) => (
              <figure class={`partner-card partner-${partner.tone}`}>
                <img src={partnerLogos[partner.name]} alt={`Logo ${partner.name}`} loading="lazy" decoding="async" />
                <figcaption>{partner.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="roadmap-section" id="roadmap" aria-labelledby="roadmap-title">
      <div class="section-heading">
        <span class="eyebrow">Méthode</span>
        <h2 id="roadmap-title">Un pilotage clair dès les premières semaines.</h2>
      </div>
      <div class="roadmap">
        <article>
          <span>01</span>
          <h3>Cadrer</h3>
          <p>Objectifs, budget, cible, capacité de traitement, offre et indicateurs de décision.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Structurer</h3>
          <p>Canaux, audiences, campagnes, créas, landing pages, tracking et exclusions.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Tester</h3>
          <p>Angles, formats, messages, enchères, audiences et parcours de conversion.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Piloter</h3>
          <p>Arbitrages budget, optimisation hebdomadaire, lecture CRM et recommandations ROI.</p>
        </article>
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <span class="eyebrow">FAQ performance</span>
        <h2 id="faq-title">Questions fréquentes.</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="strategy-cta" id="strategy-cta" aria-labelledby="cta-title">
      <div class="cta-copy">
        <span class="eyebrow">Prêt à optimiser ?</span>
        <h2 id="cta-title">Transformons votre budget média en moteur d’acquisition mesurable.</h2>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Optimiser mes campagnes
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="mailto:contact@richmedia.ma">contact@richmedia.ma</a>
        </div>
      </div>
      <div class="cta-particle-panel" aria-hidden="true">
        <ParticleLogoSlide />
      </div>
    </section>
  </div>

  <SeoSiloLinks
    title="Continuer le parcours performance"
    intro="Après le cadrage média, les leviers paid, SEO, landing pages et CRM structurent la conversion dans la durée."
    links={frSiloLinks.media}
    variant="compact"
  />
</BaseLayout>

<script>
  const strategyVisuals = document.querySelectorAll('[data-strategy-visual]');

  strategyVisuals.forEach((visual) => {
    if (!(visual instanceof HTMLElement) || visual.dataset.ready === 'true') return;
    visual.dataset.ready = 'true';

    const move = (event: PointerEvent) => {
      const bounds = visual.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width;
      const y = (event.clientY - bounds.top) / bounds.height;
      const rotateX = (0.5 - y) * 5;
      const rotateY = (x - 0.5) * 6;

      visual.style.setProperty('--mx', `${x * 100}%`);
      visual.style.setProperty('--my', `${y * 100}%`);
      visual.style.setProperty('--rx', `${rotateX}deg`);
      visual.style.setProperty('--ry', `${rotateY}deg`);
    };

    const leave = () => {
      visual.style.setProperty('--mx', '62%');
      visual.style.setProperty('--my', '42%');
      visual.style.setProperty('--rx', '0deg');
      visual.style.setProperty('--ry', '0deg');
    };

    visual.addEventListener('pointermove', move);
    visual.addEventListener('pointerleave', leave);
    leave();
  });
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .strategy-page {
    --container: min(100% - 3rem, 1360px);
    --purple: #7c3cff;
    --purple-soft: rgba(124, 60, 255, 0.17);
    --line: rgba(255, 255, 255, 0.13);
    overflow: hidden;
    min-height: 100vh;
    background:
      radial-gradient(circle at 82% 8%, rgba(124, 60, 255, 0.2), transparent 28rem),
      radial-gradient(circle at 8% 30%, rgba(124, 60, 255, 0.14), transparent 25rem),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
  }

  .strategy-hero,
  .mobile-strategy-nav,
  .quick-answer,
  .benchmark-section,
  .system-section,
  .deliverables-section,
  .partner-stack,
  .roadmap-section,
  .faq-section,
  .strategy-cta {
    width: var(--container);
    margin-inline: auto;
  }

  .quick-answer,
  .benchmark-section,
  .system-section,
  .deliverables-section,
  .partner-stack,
  .roadmap-section,
  .faq-section,
  .strategy-cta {
    scroll-margin-top: 6rem;
  }

  .mobile-strategy-nav {
    display: none;
  }

  .strategy-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(440px, 1.12fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(8rem, 12vw, 11rem) 0 clamp(3rem, 7vw, 6rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #a977ff;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 2.6rem;
    height: 2px;
    content: "";
    background: currentColor;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .strategy-hero h1 {
    max-width: 820px;
    margin-top: 1.2rem;
    --h1-size: clamp(3rem, 7.2vw, 6.7rem);
    line-height: 0.94;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .hero-lead,
  .quick-answer p,
  .system-copy > p,
  .roadmap p,
  .faq-list p {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1.0625rem, 1.25vw, 1.18rem);
    line-height: 1.7;
  }

  .hero-lead {
    max-width: 680px;
    margin-top: 1.45rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    border-radius: 8px;
    padding: 0.9rem 1.25rem;
    font-size: 1.0625rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9655ff, #6425f4);
    box-shadow: 0 1.1rem 2.8rem rgba(124, 60, 255, 0.32);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-visual {
    position: relative;
    isolation: isolate;
    min-height: clamp(360px, 34vw, 520px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    background: #07080d;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.42);
    transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition:
      transform 260ms ease,
      border-color 260ms ease,
      box-shadow 260ms ease;
    will-change: transform;
  }

  .hero-visual::before {
    position: absolute;
    inset: 0;
    z-index: 2;
    content: "";
    pointer-events: none;
    background:
      radial-gradient(circle at var(--mx, 62%) var(--my, 42%), rgba(150, 91, 255, 0.42), rgba(150, 91, 255, 0.13) 7rem, transparent 18rem),
      repeating-linear-gradient(0deg, transparent 0 24px, rgba(190, 156, 255, 0.1) 25px 26px),
      repeating-linear-gradient(90deg, transparent 0 24px, rgba(190, 156, 255, 0.1) 25px 26px);
    -webkit-mask-image: radial-gradient(circle at var(--mx, 62%) var(--my, 42%), #000 0 14rem, transparent 22rem);
