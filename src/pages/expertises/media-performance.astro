---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={`${SITE.url}/expertises/media-performance`}
  ogImage={`${SITE.url}${heroImage}`}
  schema={schema}
>
  <div class="strategy-page">
    <section class="strategy-hero" aria-labelledby="strategy-title">
      <div class="hero-copy">
        <span class="eyebrow">Expertise Richmedia</span>
        <h1 id="strategy-title">Media & Performance orienté ROI.</h1>
        <p class="hero-lead">
          Richmedia relie achat média, Social Ads, Google Ads, tracking, landing pages et CRM
          pour transformer vos budgets en leads qualifiés, ventes et résultats mesurables.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">
            Optimiser vos campagnes
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href="/realisations">
            Voir nos cas clients
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual" data-strategy-visual aria-label="Cockpit Media & Performance Richmedia">
        <img
          src={heroImage}
          alt="Dashboard media performance et pilotage de campagnes digitales"
          width="1600"
          height="1000"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="signal-card signal-card-top">
          <span>Paid media</span>
          <strong>Acquisition</strong>
        </div>
        <div class="signal-card signal-card-middle">
          <span>Tracking</span>
          <strong>Mesure fiable</strong>
        </div>
        <div class="signal-card signal-card-bottom">
          <span>ROI</span>
          <strong>Arbitrage</strong>
        </div>
      </div>
    </section>

    <nav class="mobile-strategy-nav" aria-label="Navigation de la page Media & Performance">
      {mobileQuickLinks.map((link) => (
        <a href={link.href}>
          <span>{link.label}</span>
          <strong>{link.value}</strong>
        </a>
      ))}
    </nav>

    <section class="quick-answer" id="quick-answer" aria-labelledby="quick-answer-title">
      <div class="quick-copy">
        <span class="eyebrow">Réponse rapide</span>
        <h2 id="quick-answer-title">La performance digitale, c’est un système de conversion.</h2>
        <p>
          Richmedia relie les audiences, les canaux média, les créations, les landing pages et la donnée
          pour transformer le trafic en demandes qualifiées et décisions business.
        </p>
      </div>
      <div class="quick-flow" aria-label="Étapes d'une stratégie media performance">
        <article data-index="01">
          <span>01</span>
          <strong>Cibler</strong>
          <small>Audiences, intentions, zones, exclusions.</small>
        </article>
        <article data-index="02">
          <span>02</span>
          <strong>Activer</strong>
          <small>Google, Meta, TikTok, LinkedIn, retargeting.</small>
        </article>
        <article data-index="03">
          <span>03</span>
          <strong>Convertir</strong>
          <small>Landing pages, formulaires, WhatsApp, CRM.</small>
        </article>
        <article data-index="04">
          <span>04</span>
          <strong>Optimiser</strong>
          <small>CPA, CPL, ROAS, qualité commerciale.</small>
        </article>
      </div>
    </section>

    <section class="benchmark-section" id="benchmark" aria-labelledby="benchmark-title">
      <div class="section-heading">
        <span class="eyebrow">Leviers performance</span>
        <h2 id="benchmark-title">Les canaux que les meilleures campagnes combinent.</h2>
      </div>
      <div class="benchmark-grid">
        {benchmarkPillars.map((pillar) => (
          <article class="benchmark-card">
            <span>{pillar.label}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="system-section" id="system" aria-labelledby="system-title">
      <div class="system-visual">
        <img src={systemImage} alt="Analyse de reporting et optimisation media performance" loading="lazy" decoding="async" />
      </div>
      <div class="system-copy">
        <span class="eyebrow">Le système Richmedia</span>
        <h2 id="system-title">Du budget média au résultat commercial, sans angle mort.</h2>
        <p>
          Nous pilotons les campagnes à partir de signaux concrets : coût, volume, qualité de lead,
          vitesse de traitement, taux de conversion et retours commerciaux.
        </p>
        <div class="system-modules">
          {systemModules.map((module) => (
            <article>
              <span>{module.kicker}</span>
              <h3>{module.title}</h3>
              <p>{module.text}</p>
              <div>
                {module.items.map((item) => <small>{item}</small>)}
