];

const systemModules = [
  {
    title: 'Diagnostic',
    kicker: 'Auditer',
    text: 'Analyse des campagnes, données, tracking, audiences, offres, tunnels et contraintes commerciales.',
    items: ['CPA', 'CPL', 'ROAS', 'Qualité'],
  },
