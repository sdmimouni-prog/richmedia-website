  'Yahoo Finance': `${logoBase}/yahoo-finance.png`,
  'Business Insider': `${logoBase}/business-insider.png`,
  SocialBee: `${logoBase}/socialbee.png`,
  Later: `${logoBase}/later.png`,
  'Zoho Social': `${logoBase}/zoho.svg`,
