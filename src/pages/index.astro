---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfluenceVideoStrip from '../components/InfluenceVideoStrip.astro';
import { localBusiness } from '../lib/schema';
import { BUSINESS, SITE } from '../consts';

const assetBase = '/assets/richmedia-home';
const realizationAssets = '/assets/richmedia-realizations';
const brochureHref = '/assets/documents/plaquette-richmedia-agency.pdf';
const resolveAsset = (image: string) => image.startsWith('/') ? image : `${assetBase}/${image}`;
const schema = [localBusiness()];

const stats = [
  { icon: 'ph-chart-pie-slice', value: '+156', target: 156, prefix: '+', suffix: '', label: 'Projets réalisés' },
  { icon: 'ph-users-three', value: '+117', target: 117, prefix: '+', suffix: '', label: 'Clients accompagnés' },
  { icon: 'ph-calendar-check', value: '+14 ans', target: 14, prefix: '+', suffix: ' ans', label: "D'expérience digitale" },
  { icon: 'ph-map-pin', value: '4 villes', target: 4, prefix: '', suffix: ' villes', label: 'Casablanca, Dubaï, Montréal, Strasbourg' },
];

const heroFilm = [
  { image: 'optimized/hero-film-01.webp', label: 'Ryad Al Andalous', width: 640, height: 640 },
