    box-shadow: 0 0 0 0.38rem rgba(124, 60, 255, 0.16), 0 0 1.25rem rgba(124, 60, 255, 0.95);
    transition:
      border-color 220ms ease,
      background 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
    will-change: transform;
  }

  .office-label {
    --label-x: 0rem;
    --label-y: 0rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 0.28rem 0.52rem;
    background: rgba(3, 4, 7, 0.76);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1;
    backdrop-filter: blur(12px);
    transform: translate(var(--label-x), var(--label-y)) scale(1);
    transform-origin: left center;
    transition:
      border-color 220ms ease,
      background 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
    will-change: transform;
  }

  .office-marker-montreal .office-label,
  .office-marker-strasbourg .office-label {
    --label-y: -0.75rem;
  }

  .office-marker-casablanca .office-label {
    --label-x: -5.85rem;
    --label-y: 1.25rem;
  }

  .office-marker-dubai .office-label {
    --label-y: 0.9rem;
  }

  .office-marker:hover .office-dot {
    border-color: #fff;
    background: linear-gradient(135deg, #d8c5ff, var(--purple));
    box-shadow:
      0 0 0 0.5rem rgba(124, 60, 255, 0.22),
      0 0 1.8rem rgba(153, 96, 255, 1),
      0 0 3rem rgba(255, 255, 255, 0.28);
    transform: scale(1.38);
  }

  .office-marker:hover .office-label {
    border-color: rgba(174, 124, 255, 0.64);
    background: rgba(8, 7, 18, 0.92);
    box-shadow: 0 0.75rem 1.8rem rgba(0, 0, 0, 0.28), 0 0 1.8rem rgba(124, 60, 255, 0.24);
    transform: translate(var(--label-x), calc(var(--label-y) - 0.22rem)) scale(1.06);
  }

  .map-label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 6;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 0.45rem 0.65rem;
    background: rgba(3, 4, 7, 0.72);
    backdrop-filter: blur(12px);
    transition:
      border-color 220ms ease,
      background 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
    will-change: transform;
  }

  .map-label:hover {
    border-color: rgba(174, 124, 255, 0.58);
    background: rgba(12, 10, 26, 0.88);
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.28), 0 0 1.6rem rgba(124, 60, 255, 0.24);
    transform: translateY(-0.12rem);
