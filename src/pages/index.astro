  .contact-map-panel::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgba(3, 4, 7, 0.1), rgba(3, 4, 7, 0.16)),
      radial-gradient(circle at 48% 38%, rgba(124, 60, 255, 0.16), transparent 16rem);
    content: '';
    pointer-events: none;
  }

  .map-stage {
    position: absolute;
    inset: 3.25rem 0.75rem 3.6rem;
    z-index: 1;
    overflow: hidden;
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 45%, rgba(124, 60, 255, 0.08), transparent 16rem),
      #030407;
  }

  .map-stage::before {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(3, 4, 7, 0.34), transparent 18%, transparent 82%, rgba(3, 4, 7, 0.34)),
      linear-gradient(180deg, rgba(3, 4, 7, 0.16), transparent 28%, rgba(3, 4, 7, 0.18));
    content: '';
    pointer-events: none;
  }

  .world-map-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
    opacity: 0.96;
    filter: saturate(1.12) contrast(1.06) drop-shadow(0 0 1.8rem rgba(124, 60, 255, 0.18));
    transition:
      opacity 260ms ease,
      filter 260ms ease,
      transform 420ms ease;
    will-change: opacity, filter, transform;
