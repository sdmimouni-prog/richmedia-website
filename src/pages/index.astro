const cases = [
  {
    image: `${realizationAssets}/milka-back-to-school.webp`,
    width: 1556,
    height: 1158,
    category: 'FMCG',
    client: 'Milka',
    campaignType: 'KV & lancement Back to School',
    visibility: '24,2M impressions',
    engagement: '7,2%',
  },
  {
    image: `${realizationAssets}/maserati-levante-push-whatsapp.webp`,
    width: 960,
    height: 1200,
    category: 'Automobile',
    client: 'Maserati',
    campaignType: 'Push WhatsApp',
    visibility: '100 000 envois',
    engagement: '80% ouverture',
    objectPosition: 'center 58%',
  },
  {
    image: 'optimized/campaign-wide-donsimon.webp',
    width: 960,
    height: 540,
    category: 'Food & beverage',
    client: 'Don Simon',
    campaignType: 'Campagne réseaux sociaux',
    visibility: '14M vues',
    engagement: '8,1%',
  },
  {
    image: `${realizationAssets}/nescafe-nadi-nescafe.webp`,
    width: 1572,
    height: 1162,
    category: 'Brand content',
    client: 'Nescafé',
    campaignType: 'Campagne Nadi Nescafé',
    visibility: '19,8M impressions',
    engagement: '5,8%',
  },
];

const team = [
  { image: 'optimized/team-carousel-salah.webp', width: 360, height: 450, name: 'Salah-Eddine Mimouni', role: 'CEO & CTO' },
  { image: 'optimized/team-carousel-amal.webp', width: 360, height: 450, name: 'Amal Amazouz', role: 'COO & CDO' },
  { image: 'optimized/team-carousel-tarik.webp', width: 360, height: 450, name: 'Tarik El Abbadi', role: 'Directeur communication & événementiel' },
  { image: 'optimized/team-carousel-elhoussine-bw.webp', width: 360, height: 450, name: 'Elhoussine Essmami', role: 'Planneur stratégique' },
  { image: 'optimized/team-carousel-ikram-bw.webp', width: 360, height: 450, name: 'Ikram Dehiri', role: 'Responsable de compte senior' },
  { image: 'optimized/team-carousel-oussama.webp', width: 360, height: 450, name: 'Oussama TAHTAH', role: 'Senior Account Manager' },
  { image: 'optimized/team-carousel-oumaima-lassri.webp', width: 360, height: 450, name: 'Oumaima LASSRI', role: 'Senior Account Manager' },
  { image: 'optimized/team-carousel-halima-felloui.webp', width: 360, height: 450, name: 'FELLIOUI Halima', role: 'Account Manager' },
  { image: 'optimized/team-carousel-soukaina-sammouni.webp', width: 360, height: 450, name: 'Soukaina SAMMOUNI', role: 'Account Manager' },
  { image: 'optimized/team-carousel-yasmine-ouazzani-touhamy.webp?v=black-yasmine-ab487fe', width: 360, height: 450, name: 'Yasmine Ouazzani Touhamy', role: 'Account Manager' },
  { image: 'optimized/team-carousel-zouhair-bw.webp', width: 360, height: 450, name: 'Zouhair Lyzouli', role: 'Développeur full stack senior' },
  { image: 'optimized/team-carousel-zakaria.webp', width: 360, height: 450, name: 'Zakaria Mouchtati', role: 'Développeur full stack senior' },
  { image: 'optimized/team-carousel-yassmine.webp?v=black-wafaa-1', width: 360, height: 450, name: 'Wafae Lamsabni', role: 'Cheffe de projet' },
  { image: 'optimized/team-carousel-yassine.webp', width: 360, height: 450, name: 'Mohamed Yassine Dargal', role: 'Chef de projet' },
  { image: 'optimized/team-carousel-ayoub.webp', width: 360, height: 450, name: 'Ayoub Es-Samlali', role: 'Chef de projet' },
  { image: 'optimized/team-carousel-wafaa.webp', width: 360, height: 450, name: 'Yassmine Boudial', role: 'Cheffe de projet' },
  { image: 'optimized/team-carousel-safwane.webp', width: 360, height: 450, name: 'Safwane MOUSTAINE', role: 'Senior Traffic Manager' },
  { image: 'optimized/team-carousel-malak-billaore.webp', width: 360, height: 450, name: 'Malak BILLAORE', role: 'Responsable administrative' },
  { image: 'optimized/team-carousel-rachid-oualla.webp?v=black-d71ec18', width: 360, height: 450, name: 'Rachid OUALLA', role: 'Directeur artistique' },
  { image: 'optimized/team-carousel-rachid.webp', width: 360, height: 450, name: 'Rachid Hlalma', role: 'Directeur artistique' },
  { image: 'optimized/team-carousel-abdelkader.webp', width: 360, height: 450, name: 'Abdelkader El Bouhaddouti', role: 'Finaliste graphique' },
  { image: 'optimized/team-carousel-youssef.webp', width: 360, height: 450, name: 'Youssef Amazouz', role: 'Finaliste graphique' },
  { image: 'optimized/team-carousel-wail.webp', width: 360, height: 450, name: 'Wail El Asri', role: 'Finaliste graphique' },
  { image: 'optimized/team-carousel-ghita-mimouni.webp', width: 360, height: 450, name: 'Ghita MIMOUNI', role: 'Junior Design Scout' },
  { image: 'optimized/team-carousel-marwane.webp', width: 360, height: 450, name: 'Marwane Jouay', role: 'Réalisateur & monteur vidéo' },
];

const teamLoop = [...team, ...team];

const referenceLogos = [
  { image: 'logos/references/uir.jpg', width: 640, height: 260, name: 'UIR' },
  { image: 'logos/references/amana.jpg', width: 640, height: 260, name: 'Amana' },
  { image: 'logos/references/don-simon.jpg', width: 640, height: 260, name: 'Don Simon' },
  { image: 'logos/references/terroir-du-maroc.jpg', width: 640, height: 260, name: 'Terroir du Maroc' },
  { image: 'logos/references/electroplanet.jpg', width: 640, height: 260, name: 'Electroplanet' },
  { image: 'logos/references/kitea.jpg', width: 640, height: 260, name: 'KITEA' },
  { image: 'logos/references/carrefour-market.jpg', width: 640, height: 260, name: 'Carrefour Market' },
  { image: 'logos/references/asswak-assalam.jpg', width: 640, height: 260, name: 'Asswak Assalam' },
  { image: 'logos/references/lesieur-cristal.jpg', width: 640, height: 260, name: 'Lesieur Cristal' },
  { image: 'logos/references/maroc-telecom.jpg', width: 640, height: 260, name: 'Maroc Telecom' },
];
const referenceLogoLoop = [...referenceLogos, ...referenceLogos];
const references = referenceLogos.map((logo) => logo.name);
const accreditations = ['Certification Google Ads', 'Certification Google Analytics', 'Certification HubSpot', 'Certification IAB Rich Media', 'Certification Meta Blueprint', 'Certification Semrush'];
const accreditationBadges = [
  { image: 'logos/accreditations-svg/google-ads.svg', width: 251, height: 313, name: 'Google Ads', label: 'Certifié' },
  { image: 'logos/accreditations-svg/google-analytics.svg', width: 192, height: 192, name: 'Google Analytics', label: 'Certifié' },
  { image: 'logos/accreditations-svg/hubspot.svg', width: 106, height: 31, name: 'HubSpot', label: 'Certifié' },
  { image: 'logos/accreditations-svg/iab-rich-media.svg', width: 487, height: 244, name: 'IAB Rich Media', label: 'Certifié' },
  { image: 'logos/accreditations-svg/meta-blueprint.svg', width: 948, height: 191, name: 'Meta Blueprint', label: 'Certifié' },
  { image: 'logos/accreditations-svg/semrush.svg', width: 195, height: 26, name: 'Semrush', label: 'Certifié' },
];
const offices = BUSINESS.areaServed;
const officeMarkers = [
  { city: 'Montréal', x: 33.79, y: 24.44, className: 'office-marker-montreal' },
  { city: 'Strasbourg', x: 51.68, y: 22.8, className: 'office-marker-strasbourg' },
  { city: 'Casablanca', x: 48.24, y: 30.94, className: 'office-marker-casablanca' },
  { city: 'Dubaï', x: 63.15, y: 35.54, className: 'office-marker-dubai' },
];
const formatPhone = (tel: string) => tel.replace(/(\+212)(\d{3})(\d{3})(\d{3})/, '$1 $2 $3 $4');
---
<BaseLayout
  title="Richmedia — Agence de performance digitale au Maroc | Casablanca"
  description={SITE.description}
  schema={schema}
>
  <div class="home-page">
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Nothing is <span>out</span> of reach</h1>
        <p>Une agence de performance pour créer et scaler vos marques, campagnes et revenus.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/reserver-un-audit">
            Démarrer un projet
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href={brochureHref} download="Plaquette Richmedia Agency.pdf">
            Télécharger notre plaquette
            <i class="ph ph-download-simple" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      <div class="hero-visual hero-film" aria-label="Film vertical des réalisations Richmedia">
        <div class="film-lane film-lane-left" aria-hidden="true">
          <div class="film-stack">
            {heroFilmLeft.map((item, index) => (
              <figure class="film-frame">
                <img
                  src={resolveAsset(item.image)}
                  alt={item.label}
                  width={item.width}
                  height={item.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  sizes="(max-width: 720px) 44vw, (max-width: 1060px) 44vw, 24vw"
                />
              </figure>
            ))}
          </div>
          <div class="film-stack">
            {heroFilmLeft.map((item) => (
              <figure class="film-frame">
                <img
                  src={resolveAsset(item.image)}
                  alt={item.label}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  sizes="(max-width: 720px) 44vw, (max-width: 1060px) 44vw, 24vw"
                />
              </figure>
            ))}
          </div>
        </div>
        <div class="film-lane film-lane-right" aria-hidden="true">
          <div class="film-stack">
            {heroFilmRight.map((item, index) => (
              <figure class="film-frame">
                <img
                  src={resolveAsset(item.image)}
                  alt={item.label}
                  width={item.width}
                  height={item.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  sizes="(max-width: 720px) 44vw, (max-width: 1060px) 44vw, 24vw"
                />
              </figure>
            ))}
          </div>
          <div class="film-stack">
            {heroFilmRight.map((item) => (
              <figure class="film-frame">
                <img
                  src={resolveAsset(item.image)}
                  alt={item.label}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  sizes="(max-width: 720px) 44vw, (max-width: 1060px) 44vw, 24vw"
                />
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="stats-strip" aria-label="Chiffres clés">
      {stats.map((stat) => (
        <div class="stat-item">
          <i class={`ph ${stat.icon}`} aria-hidden="true"></i>
          <div>
            <strong data-counter data-target={stat.target} data-prefix={stat.prefix} data-suffix={stat.suffix}>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        </div>
      ))}
    </section>

    <section class="expertise-stories" id="expertises" aria-labelledby="expertise-title">
      <div class="section-heading story-heading">
        <div>
          <h2 id="expertise-title">Nos expertises, <span>en stories.</span></h2>
          <a href="/expertises" class="text-link">Voir tous les services <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="story-controls" aria-label="Contrôles du carrousel expertises">
          <button type="button" class="circle-button" data-story-prev aria-label="Expertise précédente">
            <i class="ph ph-arrow-left" aria-hidden="true"></i>
          </button>
          <button type="button" class="circle-button" data-story-next aria-label="Expertise suivante">
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </button>
          <span data-story-count>01 / {String(stories.length).padStart(2, '0')}</span>
        </div>
      </div>

      <div class="stories-rail" data-stories-rail tabindex="0" aria-label="Expertises en stories défilantes">
        {stories.map((story, index) => (
          <article class:list={['story-card', index === 0 && 'is-active']} data-story-card>
            <div class="phone-shell">
              <div class="story-screen">
                <img
                  src={`${assetBase}/${story.image}`}
                  alt={`${story.category} — ${story.title}`}
                  width={story.width}
                  height={story.height}
                  loading="lazy"
                  decoding="async"
                  sizes="(max-width: 720px) 78vw, 320px"
                />
                <div class="story-progress" aria-hidden="true"><span></span><span></span><span></span></div>
                <div class="story-meta">
                  <span class="story-avatar"><i class={`ph ${story.icon}`} aria-hidden="true"></i></span>
                  <strong>{story.category}</strong>
                  <small>{story.status}</small>
                </div>
                <div class="story-content">
                  <span class="eyebrow">{story.category}</span>
                  <h3>{story.title}</h3>
                  <strong class="outcome"><i class={`ph ${story.icon}`} aria-hidden="true"></i>{story.outcome}</strong>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="work-section" id="realisations" aria-labelledby="work-title">
      <div class="section-heading inline-heading">
        <h2 id="work-title">Nos dernières campagnes</h2>
      </div>
      <div class="case-grid">
        {cases.map((item) => (
          <article class="case-card">
            <img
              src={resolveAsset(item.image)}
              alt={`Campagne ${item.client}`}
              width={item.width}
              height={item.height}
              style={`object-position: ${item.objectPosition ?? 'center'};`}
              loading="lazy"
              decoding="async"
              sizes="(max-width: 720px) 100vw, (max-width: 1060px) 50vw, 33vw"
            />
            <div class="case-overlay">
              <div class="case-panel">
                <div class="case-head">
                  <span class="eyebrow">{item.category}</span>
                  <h3>{item.client}</h3>
                </div>
                <div class="case-metrics">
                  <span class="case-metric case-type">
                    <small>Type</small>
                    <strong>{item.campaignType}</strong>
                  </span>
                  <span class="case-metric">
                    <small>Visibilité</small>
                    <strong>{item.visibility}</strong>
                  </span>
                  <span class="case-metric">
                    <small>Engagement</small>
                    <strong>{item.engagement}</strong>
                  </span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="work-more">
        <a href="/realisations" class="button button-secondary">
          Voir plus
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </section>

    <section class="team-section" aria-labelledby="team-title">
      <div class="section-heading inline-heading">
        <h2 id="team-title">Dream Team</h2>
        <a href="/equipe" class="text-link">Découvrir toute l'équipe <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
      <div class="team-carousel" aria-label="Collaborateurs Richmedia en défilement">
        <div class="team-track">
          {teamLoop.map((member, index) => (
            <article class="team-card" aria-hidden={index >= team.length ? 'true' : 'false'}>
              <img
                src={`${assetBase}/${member.image}`}
                alt={`Portrait de ${member.name}`}
                width={member.width}
                height={member.height}
                loading="lazy"
                decoding="async"
                sizes="(max-width: 720px) 36vw, 140px"
              />
              <div class="team-card-copy">
                <h3>{member.name}</h3>
                <p>{member.role}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-band" aria-labelledby="contact-title">
      <div class="contact-copy">
        <span class="contact-kicker">Prêts à aller plus loin ?</span>
        <h2 id="contact-title">Parlons de votre prochain projet.</h2>
        <p>On cadre vos objectifs, vos canaux et les prochaines actions pour transformer une idée en croissance mesurable.</p>
        <div class="contact-actions">
          <a class="button button-primary" href="/contact">
            Démarrer un projet
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href={brochureHref} download="Plaquette Richmedia Agency.pdf">
            Télécharger notre plaquette
            <i class="ph ph-download-simple" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      <address class="contact-card" aria-label="Coordonnées Richmedia">
        <a class="contact-line" href={`mailto:${BUSINESS.email}`}>
          <span class="contact-icon"><i class="ph ph-envelope" aria-hidden="true"></i></span>
          <span><small>Email direct</small><strong>{BUSINESS.email}</strong></span>
        </a>
        {BUSINESS.tels.map((tel, index) => (
          <a class="contact-line" href={`tel:${tel}`}>
            <span class="contact-icon"><i class="ph ph-phone" aria-hidden="true"></i></span>
            <span><small>{index === 0 ? 'Téléphone' : 'Ligne directe'}</small><strong>{formatPhone(tel)}</strong></span>
          </a>
        ))}
        <p class="contact-line">
          <span class="contact-icon"><i class="ph ph-clock" aria-hidden="true"></i></span>
          <span><small>Horaires</small><strong>Lun. - Ven. : 9 h 00 - 18 h 00<br />Sam. - Dim. : fermé</strong></span>
        </p>
      </address>
      <div class="contact-map-panel">
        <span class="map-label">Présence internationale</span>
        <div class="map-stage" aria-label="Carte du monde avec les bureaux Richmedia">
          <img
            class="world-map-img"
            src={`${assetBase}/optimized/world-map-natural-earth.webp`}
            alt="Carte du monde des implantations Richmedia : Casablanca, Dubaï, Montréal et Strasbourg"
            width="1000"
            height="520"
            loading="lazy"
            decoding="async"
          />
          {officeMarkers.map((office) => (
            <span class:list={['office-marker', office.className]} style={`--x: ${office.x}%; --y: ${office.y}%`}>
              <span class="office-dot"></span>
              <span class="office-label">{office.city}</span>
            </span>
          ))}
        </div>
        <div class="office-pills" aria-label="Bureaux Richmedia">
          {offices.map((office) => <span>{office}</span>)}
        </div>
      </div>
    </section>

    <InfluenceVideoStrip lang="fr" />

    <section class="proof-zone" id="references" aria-labelledby="proof-title">
      <div class="proof-intro">
        <div>
          <span class="proof-kicker">Preuves & partenaires</span>
          <h2 id="proof-title">Références et accréditations.</h2>
        </div>
