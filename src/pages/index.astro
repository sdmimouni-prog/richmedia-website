    line-height: 1;
  }

  .case-overlay p {
    margin: 0.1rem 0 0;
    color: rgba(255, 255, 255, 0.8);
  }

  .case-metrics {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(5.7rem, 0.78fr) minmax(4.2rem, 0.54fr);
    gap: 0.42rem;
  }

  .case-metric {
    min-width: 0;
    border-left: 1px solid rgba(124, 60, 255, 0.62);
    padding-left: 0.45rem;
  }

  .case-metric small {
    display: block;
    margin-bottom: 0.16rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.48rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-metric strong {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.18;
  }

  .case-metric:not(.case-type) strong {
    white-space: nowrap;
  }

  .team-carousel {
    position: relative;
    overflow: hidden;
    padding: 0.35rem 0 0.55rem;
  }

  .team-carousel::before,
  .team-carousel::after {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 3;
    width: 7rem;
    content: '';
    pointer-events: none;
  }

  .team-carousel::before {
    left: 0;
    background: linear-gradient(90deg, #030407, rgba(3, 4, 7, 0));
  }

  .team-carousel::after {
    right: 0;
    background: linear-gradient(270deg, #030407, rgba(3, 4, 7, 0));
  }

  .team-track {
    display: flex;
    width: max-content;
    gap: 0.7rem;
    animation: team-marquee 42s linear infinite;
    will-change: transform;
  }

  .team-carousel:hover .team-track,
  .team-carousel:focus-within .team-track {
    animation-play-state: paused;
  }

  .team-card {
    position: relative;
    flex: 0 0 clamp(108px, 9vw, 140px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    background: #050505;
    box-shadow: 0 0.7rem 1.6rem rgba(0, 0, 0, 0.24);
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .team-card:hover {
    border-color: rgba(124, 60, 255, 0.5);
    box-shadow: 0 0.9rem 2rem rgba(0, 0, 0, 0.36), 0 0 0 1px rgba(124, 60, 255, 0.14);
    transform: translateY(-0.15rem);
  }

  .team-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform-origin: center top;
    filter: grayscale(1) contrast(1.08) brightness(0.94);
    transition: filter 420ms ease, transform 420ms ease;
  }

  .team-card:hover img {
    filter: grayscale(1) contrast(1.14) brightness(1);
    transform: translateY(0.08rem) scale(1.004);
  }

  .team-card::after {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 48%;
    background: linear-gradient(180deg, rgba(5, 5, 5, 0), rgba(5, 5, 5, 0.86) 70%, #050505);
    content: '';
  }

  .team-card-copy {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    left: 0.55rem;
    z-index: 2;
  }

  .team-card-copy h3,
  .team-card-copy p {
    margin: 0;
  }

  .team-card-copy h3 {
    max-width: 13ch;
    color: #fff;
    font-size: 0.68rem;
    line-height: 1.08;
  }

  .team-card-copy p {
    margin-top: 0.26rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.5rem;
    line-height: 1.2;
  }

  .team-card-copy::after {
    display: block;
    width: 1.35rem;
    height: 2px;
    margin-top: 0.42rem;
    border-radius: 999px;
    background: var(--purple);
    content: '';
  }

  @keyframes team-marquee {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  .contact-band {
    position: relative;
    display: grid;
    grid-template-columns: minmax(360px, 1.08fr) minmax(300px, 0.76fr) minmax(360px, 0.9fr);
