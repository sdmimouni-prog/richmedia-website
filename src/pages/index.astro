    height: calc(100% - var(--case-panel-height));
    padding: 0;
    object-fit: cover;
    object-position: center;
    filter: none;
    transform: scale(1.001);
    transition: transform 0.5s ease;
  }

  .case-card-large img {
    object-position: center top;
  }

  .case-card:hover img {
    transform: scale(1.026);
  }

  .case-card::after {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: var(--case-panel-height);
    background: linear-gradient(180deg, rgba(5, 5, 7, 0.34) 0%, rgba(5, 5, 7, 0.98) 100%);
    content: '';
    pointer-events: none;
  }

  .case-overlay {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: stretch;
    height: var(--case-panel-height);
    padding: 0.52rem;
    pointer-events: none;
