  .case-panel {
    display: grid;
    align-content: center;
    gap: 0.42rem;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    padding: 0.52rem 0.62rem;
    background: linear-gradient(135deg, rgba(13, 13, 18, 0.92), rgba(7, 7, 10, 0.94));
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.24);
