    width: 560,
    height: 996,
    category: 'Média & performance',
    status: 'Amplification',
    icon: 'ph-chart-line-up',
    title: "Transformer l'attention en leads qualifiés",
    outcome: 'ROI piloté',
  },
  {
    image: 'optimized/expertise-story-tech.webp',
    width: 560,
    height: 996,
    category: 'Tech, IA & Web',
    status: 'Conversion',
    icon: 'ph-cpu',
    title: "Fluidifier le parcours jusqu'à la conversion",
    outcome: 'Conversion',
  },
  {
