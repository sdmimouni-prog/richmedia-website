---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema, breadcrumbs } from '../../lib/schema';
import { SITE } from '../../consts';

const pageUrl = `${SITE.url}/insights/barometre-marketing-digital-maroc-2026/`;
const pageTitle = 'Baromètre du Marketing Digital au Maroc 2026';
const metaTitle = 'Baromètre Marketing Digital Maroc 2026 | Richmedia';
const metaDescription =
  '400 campagnes, 25 M MAD de média et 553 000 leads analysés. Découvrez les benchmarks Meta, Google, WhatsApp et acquisition au Maroc.';
const image = '/assets/richmedia-case-study/proof-dashboard.webp';
const absoluteImage = `${SITE.url}${image}`;
const publishedDate = new Date('2026-08-23');
const modifiedDate = new Date('2026-08-23');

const keyStats = [
  { value: '400', label: 'campagnes analysées' },
  { value: '82', label: 'clients & marques' },
  { value: '25 M MAD', label: 'de budget média géré' },
  { value: '1,6 Md', label: 'd’impressions générées' },
  { value: '16 M', label: 'de clics' },
  { value: '553 000', label: 'leads générés' },
];

const sectors = [
  { label: 'Éducation', campaigns: 88, share: '22 %', value: 22 },
  { label: 'Immobilier', campaigns: 72, share: '18 %', value: 18 },
  { label: 'Automobile', campaigns: 53, share: '13,3 %', value: 13.3 },
  { label: 'Retail / GMS', campaigns: 52, share: '13 %', value: 13 },
  { label: 'FMCG', campaigns: 42, share: '10,5 %', value: 10.5 },
  { label: 'Tourisme', campaigns: 33, share: '8,3 %', value: 8.3 },
  { label: 'Banque / Assurance', campaigns: 24, share: '6 %', value: 6 },
  { label: 'Autres', campaigns: 36, share: '9 %', value: 9 },
];

const channels = [
  { label: 'Meta Ads', campaigns: 320, share: '80 %', value: 80 },
  { label: 'Google Ads', campaigns: 160, share: '40 %', value: 40 },
  { label: 'WhatsApp', campaigns: 130, share: '32,5 %', value: 32.5 },
  { label: 'TikTok Ads', campaigns: 80, share: '20 %', value: 20 },
  { label: 'Influence', campaigns: 50, share: '12,5 %', value: 12.5 },
  { label: 'Programmatic', campaigns: 49, share: '12,3 %', value: 12.3 },
  { label: 'LinkedIn Ads', campaigns: 44, share: '11 %', value: 11 },
  { label: 'Autres', campaigns: 33, share: '8,3 %', value: 8.3 },
  { label: 'Emailing', campaigns: 10, share: '2,5 %', value: 2.5 },
];

const globalPerformance = [
  { label: 'CTR global agrégé', value: '≈ 1,0 %', detail: '16 M de clics pour 1,6 milliard d’impressions.' },
  { label: 'CPC global agrégé', value: '≈ 1,56 MAD', detail: '25 M MAD investis / 16 M de clics.' },
  { label: 'CPL global agrégé', value: '≈ 45 MAD', detail: '25 M MAD investis / 553 000 leads.' },
  { label: 'Conversion clic → lead', value: '≈ 3,46 %', detail: '553 000 leads pour 16 M de clics.' },
];

const metaRanges = [
  { label: 'CPM', value: '5 à 18 MAD', low: 5, high: 18, max: 180 },
  { label: 'CPC', value: '0,4 à 2,5 MAD', low: 4, high: 25, max: 180 },
  { label: 'CTR', value: '0,8 à 3,2 %', low: 8, high: 32, max: 180 },
  { label: 'CPL', value: '8 à 180 MAD', low: 8, high: 180, max: 180 },
];

const googleRanges = [
  { label: 'CPC', value: '2 à 8 MAD', low: 2, high: 8, max: 150 },
  { label: 'CTR', value: '3 à 7 %', low: 3, high: 7, max: 150 },
  { label: 'CPL', value: '18 à 150 MAD', low: 18, high: 150, max: 150 },
  { label: 'Taux de conversion', value: '3 à 10 %', low: 3, high: 10, max: 150 },
];

const cplBySector = [
  { label: 'Éducation', value: '8 à 220 MAD', low: 8, high: 220, max: 220 },
  { label: 'Immobilier', value: '25 à 220 MAD', low: 25, high: 220, max: 220 },
  { label: 'Automobile', value: '30 à 100 MAD', low: 30, high: 100, max: 220 },
  { label: 'Retail / GMS', value: '8 à 35 MAD', low: 8, high: 35, max: 220 },
  { label: 'Tourisme', value: '20 à 70 MAD', low: 20, high: 70, max: 220 },
  { label: 'Banque / Assurance', value: '40 à 120 MAD', low: 40, high: 120, max: 220 },
];

const lessons = [
  ['01', 'Meta reste la machine à volume', 'Facebook et Instagram demeurent les principaux générateurs de leads dans l’échantillon Richmedia.'],
  ['02', 'Search capte les intentions les plus chaudes', 'Google Search produit généralement les leads les plus qualifiés.'],
  ['03', 'Le CPL seul est insuffisant', 'La qualité du lead et la transformation commerciale doivent être mesurées.'],
  ['04', 'Plus l’audience est premium, plus son acquisition coûte cher', 'Le niveau socio-professionnel ciblé influence fortement le CPL.'],
  ['05', 'Les Lead Ads nécessitent une couche de qualification', 'Un formulaire facile augmente le volume, mais pas nécessairement la valeur.'],
  ['06', 'Le retargeting reste décisif en e-commerce', '45 % des conversions analysées proviennent du retargeting.'],
  ['07', 'Les lookalikes prolongent efficacement les audiences existantes', '30 % des conversions e-commerce observées proviennent des audiences similaires.'],
  ['08', 'Le drive-to-store devient un levier de performance locale', 'Le digital permet de piloter des activations au niveau du point de vente.'],
  ['09', 'WhatsApp rapproche média et conversion', 'Le canal combine reach, interaction, conversation et relance dans un même environnement.'],
];

const measurementFunnel = [
  { label: 'Média', items: ['CPM', 'CTR', 'CPC'] },
  { label: 'Acquisition', items: ['CPL', 'CPA', 'conversion rate'] },
  { label: 'Qualité', items: ['taux de contact', 'lead qualifié', 'MQL', 'SQL'] },
  { label: 'Business', items: ['vente', 'CAC', 'revenu', 'ROAS', 'LTV'] },
];

const serviceLinks = [
  { href: '/expertises/google-ads-maroc', label: 'Google Ads Maroc' },
  { href: '/expertises/meta-ads-maroc', label: 'Meta Ads Maroc' },
  { href: '/expertises/generation-leads-maroc', label: 'Génération de leads Maroc' },
  { href: '/expertises/whatsapp-marketing-maroc', label: 'WhatsApp Marketing Maroc' },
  { href: '/expertises/influence-marketing-maroc', label: 'Influence Marketing Maroc' },
  { href: '/expertises/geofencing-drive-to-store-maroc', label: 'Géofencing / Drive-to-store Maroc' },
  { href: '/expertises/marketing-automation-crm-maroc', label: 'Marketing Automation & CRM' },
  { href: '/expertises/social-listening-maroc', label: 'Social Listening' },
];

const insightLinks = [
  { href: '/insights/cout-campagne-google-ads-maroc', label: 'Combien coûte une campagne Google Ads au Maroc ?' },
  { href: '/insights/campagnes-meta-2026-bonnes-pratiques', label: 'Campagnes Meta 2026 : bonnes pratiques' },
  { href: '/insights/whatsapp-business-canal-conversion', label: 'WhatsApp Business : canal de conversion' },
  { href: '/insights/crm-automation-aligner-marketing-sales', label: 'CRM & automation' },
  { href: '/insights/data-decision-strategie-performance', label: 'Data & stratégie de performance' },
  { href: '/insights/plan-acquisition-digital-2026', label: 'Plan d’acquisition digital 2026' },
];

const schema = [
  articleSchema({
    title: pageTitle,
    description: metaDescription,
    url: pageUrl,
    author: SITE.name,
    datePublished: publishedDate,
    dateModified: modifiedDate,
    image: absoluteImage,
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Insights', url: `${SITE.url}/insights` },
    { name: pageTitle, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={pageUrl}
  ogImage={absoluteImage}
  ogType="article"
  articlePublishedTime={publishedDate}
  articleModifiedTime={modifiedDate}
  articleAuthor={SITE.name}
  articleSection="Benchmark marketing digital"
  schema={schema}
>
  <article class="benchmark-page">
    <nav class="benchmark-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <a href="/insights">Insights</a>
      <span>/</span>
      <strong>Baromètre 2026</strong>
    </nav>

    <section class="benchmark-hero" id="top">
      <div class="hero-copy">
        <span class="section-kicker">Richmedia Digital Benchmark 2026</span>
        <h1>{pageTitle}</h1>
        <p class="hero-lead">400 campagnes. 82 marques. 25 millions de MAD de budget média analysés.</p>
        <p>
          Richmedia partage les principaux enseignements issus de quatre années de campagnes digitales au Maroc :
          coûts d’acquisition, performance média, génération de leads, WhatsApp, e-commerce, influence et drive-to-store.
        </p>
        <div class="hero-actions">
          <a href="#donnees" class="primary-action">Explorer les données <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          <a href="/contact" class="secondary-action">Parler à un expert</a>
        </div>
        <small>Données agrégées et anonymisées issues de campagnes pilotées par Richmedia entre 2022 et 2026.</small>
      </div>

      <figure class="hero-visual">
        <img src={image} alt="Dashboard de performance média Richmedia pour le baromètre marketing digital Maroc 2026" width="1180" height="820" loading="eager" decoding="async" fetchpriority="high" />
        <figcaption>
          <span>Échantillon Richmedia</span>
          <strong>2022–2026</strong>
        </figcaption>
      </figure>
    </section>

    <section class="stat-grid" id="donnees" aria-label="Chiffres clés du baromètre">
      {keyStats.map((stat) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </section>

    <section class="intro-note">
      <p>
        Ce baromètre ne repose pas sur des données déclaratives ou une enquête d’opinion. Il agrège les performances
        réellement observées sur les campagnes digitales pilotées par Richmedia au Maroc sur la période 2022–2026.
      </p>
    </section>

    <section class="split-section">
      <div class="section-heading">
        <span class="section-kicker">Échantillon</span>
        <h2>Un benchmark construit sur plusieurs secteurs et plusieurs leviers.</h2>
        <p>
          Les 400 campagnes analysées couvrent aussi bien des stratégies d’acquisition que de notoriété,
          de lead generation, de conversion, de drive-to-store ou de relation client.
        </p>
      </div>
      <div class="bar-panel">
        <h3>Répartition des campagnes par secteur</h3>
        {sectors.map((item) => (
          <div class="bar-row" style={`--bar:${item.value}%`}>
            <span>{item.label}</span>
            <div><i></i></div>
            <strong>{item.campaigns} · {item.share}</strong>
          </div>
        ))}
      </div>
    </section>

    <aside class="insight-callout">
      <strong>Insight Richmedia</strong>
      <p>Éducation et immobilier représentent à eux seuls 40 % des campagnes analysées, deux secteurs dans lesquels la génération de leads et la qualité des prospects constituent des enjeux particulièrement importants.</p>
    </aside>

    <section class="split-section reverse">
      <div class="section-heading">
        <span class="section-kicker">Canaux</span>
        <h2>Meta reste le premier levier activé par les marques.</h2>
        <p>
          Une même campagne pouvant utiliser plusieurs plateformes, les chiffres ci-dessous représentent le nombre
          de campagnes ayant activé chaque canal et ne doivent pas être additionnés.
        </p>
        <blockquote>Instagram et Facebook restent les principaux générateurs de volume de leads dans les campagnes analysées par Richmedia.</blockquote>
        <p>
          Google est activé moins fréquemment que Meta, mais joue un rôle différent : capter une demande déjà exprimée
          et généralement plus proche de la conversion.
        </p>
      </div>
      <div class="bar-panel">
        <h3>Part des 400 campagnes ayant utilisé chaque canal</h3>
        {channels.map((item) => (
          <div class="bar-row" style={`--bar:${item.value}%`}>
            <span>{item.label}</span>
            <div><i></i></div>
            <strong>{item.campaigns} · {item.share}</strong>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">Vue globale</span>
        <h2>Ce que représentent 25 M MAD de média activé.</h2>
        <p>
          Ces indicateurs globaux donnent un ordre de grandeur de l’échantillon mais ne doivent pas être utilisés
          comme benchmark universel. Les performances varient fortement selon le secteur, l’objectif, la plateforme,
          l’audience, le format, la landing page, la période et le niveau de concurrence.
        </p>
      </div>
      <div class="metric-grid">
        {globalPerformance.map((item) => (
          <article>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="two-columns">
      <article class="benchmark-card">
        <span class="section-kicker">Media performance</span>
        <h2>Meta Ads : le canal qui génère le plus de volume.</h2>
        <p>Sur les 400 campagnes analysées, Meta Ads a été utilisé dans 320 campagnes, soit 80 % de l’échantillon.</p>
        <div class="range-stack">
          {metaRanges.map((item) => (
            <div class="range-row" style={`--low:${(item.low / item.max) * 100}%; --high:${(item.high / item.max) * 100}%`}>
              <span>{item.label}</span>
              <div><i></i></div>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
        <p class="muted">La fourchette de CPL est volontairement large : un lead retail simple et un prospect immobilier haut de gamme ne représentent pas le même niveau d’intention.</p>
      </article>

      <article class="benchmark-card">
        <span class="section-kicker">Search intent</span>
        <h2>Google Search : moins de volume, mais une intention plus forte.</h2>
        <p>Google Ads a été utilisé dans 160 campagnes, soit 40 % de l’échantillon analysé.</p>
        <div class="range-stack">
          {googleRanges.map((item) => (
            <div class="range-row" style={`--low:${(item.low / item.max) * 100}%; --high:${(item.high / item.max) * 100}%`}>
              <span>{item.label}</span>
              <div><i></i></div>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
        <p class="muted">Parmi les leviers analysés, Google Search génère généralement les leads présentant le niveau d’intention le plus élevé.</p>
      </article>
    </section>

    <section class="comparison-section">
      <div class="section-heading">
        <span class="section-kicker">Meta vs Google</span>
        <h2>Deux rôles différents dans le parcours d’acquisition.</h2>
      </div>
      <div class="comparison-table" role="table" aria-label="Comparaison Meta Ads et Google Search">
        {[
          ['Logique', 'Créer / stimuler la demande', 'Capter une demande existante'],
          ['Volume', 'Très élevé', 'Plus limité'],
          ['CPC', 'Généralement plus faible', 'Généralement plus élevé'],
          ['Qualité des leads', 'Variable', 'Généralement plus forte'],
          ['Créatif', 'Déterminant', 'Important mais secondaire'],
          ['Intention', 'Faible → moyenne', 'Moyenne → très forte'],
          ['Usage idéal', 'Acquisition, découverte, volume', 'Conversion, intention chaude'],
        ].map(([label, meta, google]) => (
          <div role="row">
            <strong role="cell">{label}</strong>
            <span role="cell">{meta}</span>
            <span role="cell">{google}</span>
          </div>
        ))}
      </div>
      <blockquote>La question n’est généralement pas : Meta ou Google ? Mais : quel rôle attribuer à chaque canal dans le parcours d’acquisition ?</blockquote>
    </section>

    <section class="split-section">
      <div class="section-heading">
        <span class="section-kicker">CPL par secteur</span>
        <h2>Le coût d’un lead dépend d’abord de ce que l’on cherche à vendre.</h2>
        <p>
          Les campagnes FMCG analysées sont davantage orientées reach, engagement, trafic, considération et drive-to-store.
          La catégorie “autres” regroupe des secteurs trop hétérogènes pour produire une fourchette représentative.
        </p>
      </div>
      <div class="range-panel">
        {cplBySector.map((item) => (
          <div class="range-row" style={`--low:${(item.low / item.max) * 100}%; --high:${(item.high / item.max) * 100}%`}>
            <span>{item.label}</span>
            <div><i></i></div>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">Lecture qualité</span>
        <h2>Plus l’audience est sélective, plus l’acquisition coûte cher.</h2>
        <p>
          Sur les campagnes analysées, Richmedia observe une relation récurrente entre le niveau socio-professionnel ciblé
          et le coût d’acquisition. Les audiences à forte CSP sont généralement plus restreintes, davantage sollicitées,
          associées à des produits à valeur élevée et plus difficiles à qualifier.
        </p>
      </div>
      <aside class="insight-callout compact">
        <strong>Message important</strong>
        <p>Un CPL de 120 MAD peut être meilleur business qu’un CPL de 15 MAD si la valeur et la probabilité de conversion du prospect sont supérieures.</p>
      </aside>
    </section>

    <section class="two-columns">
      <article class="benchmark-card">
        <span class="section-kicker">Conversational marketing</span>
        <h2>WhatsApp transforme le push en conversation.</h2>
        <p>130 campagnes du benchmark ont intégré WhatsApp. Le canal permet de prolonger immédiatement le message par une interaction : message, clic, réponse, chatbot ou conseiller, puis conversion.</p>
        <div class="mini-metrics">
          {[
            ['Lecture / ouverture', '80 à 95 %'],
            ['Clic', '8 à 25 %'],
            ['Réponse', '3 à 25 %'],
            ['Opt-out', '0,2 à 2 %'],
            ['Conversion', '5 à 8 %'],
          ].map(([label, value]) => (
            <div><span>{label}</span><strong>{value}</strong></div>
          ))}
        </div>
      </article>

      <article class="benchmark-card">
        <span class="section-kicker">E-commerce</span>
        <h2>75 % des conversions observées proviennent d’audiences déjà connectées ou similaires.</h2>
        <div class="donut-wrap" aria-label="Répartition des conversions e-commerce">
          <div class="donut" aria-hidden="true"></div>
          <div>
            <strong>45 %</strong><span>retargeting</span>
            <strong>30 %</strong><span>audiences lookalike</span>
            <strong>25 %</strong><span>autres signaux</span>
          </div>
        </div>
        <p>Le prospecting reste indispensable pour alimenter le funnel, mais la performance finale repose fortement sur la capacité de la marque à recibler et réengager.</p>
      </article>
    </section>

    <section class="two-columns">
      <article class="benchmark-card">
        <h2>Du SMS à WhatsApp : du message reçu au message interactif.</h2>
        <p>Dans les campagnes comparables observées par Richmedia, WhatsApp génère des niveaux d’interaction très supérieurs au push SMS traditionnel.</p>
        <div class="comparison-list">
          <span>SMS : texte, lien, push, mesure limitée.</span>
          <span>WhatsApp : texte, image, vidéo, boutons, personnalisation, clics, réponses et interactions.</span>
        </div>
      </article>

      <article class="benchmark-card">
        <h2>LinkedIn génère les CPL les plus élevés de notre mix média.</h2>
        <p>44 campagnes analysées ont utilisé LinkedIn Ads. Parmi les plateformes utilisées pour la génération de leads, LinkedIn est généralement celle qui produit le lead le plus coûteux dans notre échantillon.</p>
        <p>Ce coût peut rester pertinent lorsque la cible repose sur la fonction, l’entreprise, le secteur, le niveau hiérarchique ou l’environnement B2B.</p>
      </article>
    </section>

    <section class="split-section reverse">
      <div class="section-heading">
        <span class="section-kicker">Local performance</span>
        <h2>Le digital se rapproche du point de vente.</h2>
        <p>
          Le drive-to-store prend une place croissante dans les dispositifs activés pour le retail, la GMS,
          l’automobile, la restauration et les réseaux de points de vente.
        </p>
      </div>
      <div class="flow-panel">
        {['Point de vente', 'Zone de chalandise', 'Audience locale', 'Contenu localisé', 'Paid media / influence', 'Visite en magasin'].map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section class="two-columns">
      <article class="benchmark-card">
        <h2>Nano pour convertir. Macro pour amplifier.</h2>
        <p>Les campagnes analysées montrent deux usages très différents de l’influence. Les nano et micro-influenceurs sont utiles pour la proximité, la crédibilité, les communautés locales, le drive-to-store et la conversion.</p>
        <p>Les macro-influenceurs et célébrités sont plus adaptés au reach, à la notoriété, au lancement, à la couverture nationale et à la mémorisation.</p>
        <blockquote>Le nombre d’abonnés n’est pas un objectif média.</blockquote>
      </article>

      <article class="benchmark-card">
        <span class="section-kicker">Meta Lead Ads</span>
        <h2>Plus de volume ne signifie pas toujours plus de valeur.</h2>
        <p>Les formulaires natifs Meta Lead Ads génèrent généralement un volume important de prospects, mais la qualité moyenne observée est souvent inférieure à celle obtenue sur des parcours demandant davantage d’engagement.</p>
        <p class="muted">Ne pas piloter uniquement au CPL : ajouter taux de contact, lead qualifié, opportunité et vente.</p>
      </article>
    </section>

    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">Enseignements 2022–2026</span>
        <h2>9 enseignements Richmedia à retenir.</h2>
      </div>
      <div class="lesson-grid">
        {lessons.map(([number, title, text]) => (
          <article>
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading">
        <span class="section-kicker">Reporting 2026</span>
        <h2>Sortir du reporting média pour mesurer la vraie performance.</h2>
      </div>
      <div class="funnel-grid">
        {measurementFunnel.map((step) => (
          <article>
            <h3>{step.label}</h3>
            <ul>
              {step.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <blockquote>Le reporting le plus utile n’est pas celui qui montre combien de leads ont été générés, mais combien de valeur ces leads ont réellement créée.</blockquote>
    </section>

    <section class="method-note">
      <div>
        <span class="section-kicker">Méthodologie</span>
        <h2>Comment lire ce baromètre.</h2>
      </div>
      <div class="method-grid">
        <p><strong>Période :</strong> 2022 à 2026</p>
        <p><strong>Échantillon :</strong> 400 campagnes</p>
        <p><strong>Clients :</strong> 82 marques et organisations</p>
        <p><strong>Budget média :</strong> 25 M MAD</p>
        <p><strong>Volumétrie :</strong> 1,6 milliard d’impressions, 16 millions de clics, 553 000 leads</p>
        <p><strong>Canaux :</strong> Meta Ads, Google Ads, TikTok Ads, WhatsApp, LinkedIn Ads, influence, programmatic, emailing et autres leviers</p>
      </div>
      <p>
        Les chiffres de ce baromètre constituent des points de comparaison issus de l’expérience Richmedia.
        Ils ne constituent ni des garanties de performance ni des standards universels du marché marocain.
      </p>
    </section>

    <section class="related-section">
      <div class="section-heading">
