<script is:inline>
  (() => {
    const form = document.querySelector('[data-barometer-download-form]');
    if (!form) return;

    const freeEmailDomains = new Set([
      'gmail.com',
      'googlemail.com',
      'hotmail.com',
      'hotmail.fr',
      'outlook.com',
      'outlook.fr',
      'live.com',
      'live.fr',
      'msn.com',
      'yahoo.com',
      'yahoo.fr',
      'icloud.com',
      'me.com',
      'mac.com',
      'aol.com',
      'proton.me',
      'protonmail.com',
      'mail.com',
      'gmx.com',
      'gmx.fr',
      'wanadoo.fr',
      'orange.fr',
      'laposte.net',
    ]);

    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');
    const emailInput = form.querySelector('[data-business-email]');
    const companyInput = form.querySelector('[data-company-input]');
    const downloadLink = form.querySelector('[data-download-link]');
    const pdfHref = form.dataset.pdfHref;
    const pdfName = form.dataset.pdfName || 'Barometre Richmedia 2026.pdf';

    const setStatus = (state, message) => {
      if (!status) return;
      status.dataset.state = state;
      status.textContent = message;
    };

    const getEmailDomain = (email) => {
      const parts = String(email || '').trim().toLowerCase().split('@');
      return parts.length === 2 ? parts[1] : '';
    };

    const isProfessionalEmail = (email) => {
      const domain = getEmailDomain(email);
      return domain && domain.includes('.') && !freeEmailDomains.has(domain);
    };

    const triggerDownload = () => {
      if (!pdfHref) return;
      const link = document.createElement('a');
      link.href = pdfHref;
      link.download = pdfName;
      link.rel = 'noopener';
      document.body.appendChild(link);
      link.click();
      link.remove();
      if (downloadLink) downloadLink.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      setStatus('', '');

      if (!companyInput.value.trim()) {
        companyInput.setCustomValidity('Merci de renseigner votre société.');
      } else {
        companyInput.setCustomValidity('');
      }

      if (!isProfessionalEmail(emailInput.value)) {
        emailInput.setCustomValidity('Merci d’utiliser une adresse email professionnelle, pas Gmail ni email personnel.');
      } else {
        emailInput.setCustomValidity('');
      }

      if (!form.reportValidity()) return;

      const formData = new FormData(form);
      if (String(formData.get('company_url') || '').trim()) {
        form.reset();
        setStatus('success', 'Merci, le téléchargement commence.');
        triggerDownload();
        return;
      }

      const body = new URLSearchParams();
      formData.forEach((value, key) => {
        body.append(key, String(value));
      });
      body.set('_page', window.location.href);
      body.set('_replyto', String(emailInput.value || '').trim());

      form.classList.add('is-submitting');
      if (submit) {
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
      }
      setStatus('loading', 'Validation en cours...');

      try {
        const response = await fetch(form.dataset.contactEndpoint || form.action, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          },
          body,
        });
        const contentType = response.headers.get('content-type') || '';
        const result = contentType.includes('application/json') ? await response.json().catch(() => ({})) : {};
        const failed = !response.ok || response.redirected || result.error || result.success === false || result.success === 'false';

        if (failed) {
          throw new Error(result.message || 'Le formulaire n’a pas pu être envoyé. Merci de réessayer.');
        }

        form.reset();
        emailInput.setCustomValidity('');
        companyInput.setCustomValidity('');
        setStatus('success', 'Merci, le téléchargement commence.');
        triggerDownload();
      } catch (error) {
        setStatus('error', error.message || 'Le formulaire n’a pas pu être envoyé. Merci de réessayer.');
      } finally {
        form.classList.remove('is-submitting');
        if (submit) {
          submit.disabled = false;
          submit.removeAttribute('aria-busy');
        }
      }
    });
  })();
</script>

