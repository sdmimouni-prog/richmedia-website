---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDetailPage from '../../components/ArticleDetailPage.astro';
import { articleSchema, authorCanonicalUrl, authorPersonId, breadcrumbs } from '../../lib/schema';
import { CONTACT_FORM, getEditorialAuthor, getEditorialAuthorPath, SITE } from '../../consts';

const pageUrl = `${SITE.url}/insights/barometre-marketing-digital-maroc-2026/`;
const pageTitle = 'Baromètre du Marketing Digital au Maroc 2026';
const metaTitle = 'Baromètre Marketing Digital Maroc 2026 | Richmedia';
const metaDescription =
  '400 campagnes, 25 M MAD de média et 553 000 leads analysés. Benchmarks Meta, Google, WhatsApp et acquisition au Maroc.';
const image = '/assets/richmedia-barometre/barometre-2026-book-render.webp';
const absoluteImage = `${SITE.url}${image}`;
const barometerPdfHref = '/downloads/barometre-marketing-digital-maroc-2026-richmedia.pdf';
const barometerPdfFilename = 'Barometre Marketing Digital Maroc 2026 - Richmedia.pdf';
const publishedDate = new Date('2026-08-23');
const modifiedDate = new Date('2026-08-23');
const authorProfile = getEditorialAuthor('Salah Eddine MIMOUNI');
const authorImage = authorProfile.image.startsWith('/') ? `${SITE.url}${authorProfile.image}` : authorProfile.image;

const keyStats = [
  { value: '400', label: 'campagnes analysées' },
  { value: '82', label: 'clients & marques' },
  { value: '25 M MAD', label: 'budget média géré' },
  { value: '1,6 Md', label: 'impressions générées' },
  { value: '16 M', label: 'clics mesurés' },
  { value: '553 000', label: 'leads générés' },
];

const sectors = [
  { label: 'Éducation', campaigns: 88, share: '22 %', value: 22 },
  { label: 'Immobilier', campaigns: 72, share: '18 %', value: 18 },
  { label: 'Automobile', campaigns: 53, share: '13,3 %', value: 13.3 },
  { label: 'Retail / GMS', campaigns: 52, share: '13 %', value: 13 },
  { label: 'FMCG', campaigns: 42, share: '10,5 %', value: 10.5 },
  { label: 'Tourisme', campaigns: 33, share: '8,3 %', value: 8.3 },
  { label: 'Banque / Assurance', campaigns: 24, share: '6 %', value: 6 },
  { label: 'Autres', campaigns: 36, share: '9 %', value: 9 },
];

const channels = [
  { label: 'Meta Ads', campaigns: 320, share: '80 %', value: 80 },
  { label: 'Google Ads', campaigns: 160, share: '40 %', value: 40 },
  { label: 'WhatsApp', campaigns: 130, share: '32,5 %', value: 32.5 },
  { label: 'TikTok Ads', campaigns: 80, share: '20 %', value: 20 },
  { label: 'Influence', campaigns: 50, share: '12,5 %', value: 12.5 },
  { label: 'Programmatic', campaigns: 49, share: '12,3 %', value: 12.3 },
  { label: 'LinkedIn Ads', campaigns: 44, share: '11 %', value: 11 },
  { label: 'Autres', campaigns: 33, share: '8,3 %', value: 8.3 },
  { label: 'Emailing', campaigns: 10, share: '2,5 %', value: 2.5 },
];

const globalPerformance = [
  { label: 'CTR global agrégé', value: '≈ 1,0 %', detail: '16 M de clics pour 1,6 milliard d’impressions.' },
  { label: 'CPC global agrégé', value: '≈ 1,56 MAD', detail: '25 M MAD investis / 16 M de clics.' },
  { label: 'CPL global agrégé', value: '≈ 45 MAD', detail: '25 M MAD investis / 553 000 leads.' },
  { label: 'Conversion clic → lead', value: '≈ 3,46 %', detail: '553 000 leads pour 16 M de clics.' },
];

const metaRanges = [
  { label: 'CPM', value: '5 à 18 MAD', low: 5, high: 18, max: 180 },
  { label: 'CPC', value: '0,4 à 2,5 MAD', low: 4, high: 25, max: 180 },
  { label: 'CTR', value: '0,8 à 3,2 %', low: 8, high: 32, max: 180 },
  { label: 'CPL', value: '8 à 180 MAD', low: 8, high: 180, max: 180 },
];

const googleRanges = [
  { label: 'CPC', value: '2 à 8 MAD', low: 2, high: 8, max: 150 },
  { label: 'CTR', value: '3 à 7 %', low: 3, high: 7, max: 150 },
  { label: 'CPL', value: '18 à 150 MAD', low: 18, high: 150, max: 150 },
  { label: 'Taux de conversion', value: '3 à 10 %', low: 3, high: 10, max: 150 },
];

const cplBySector = [
  { label: 'Éducation', value: '8 à 220 MAD', low: 8, high: 220, max: 220 },
  { label: 'Immobilier', value: '25 à 220 MAD', low: 25, high: 220, max: 220 },
  { label: 'Automobile', value: '30 à 100 MAD', low: 30, high: 100, max: 220 },
  { label: 'Retail / GMS', value: '8 à 35 MAD', low: 8, high: 35, max: 220 },
  { label: 'Tourisme', value: '20 à 70 MAD', low: 20, high: 70, max: 220 },
  { label: 'Banque / Assurance', value: '40 à 120 MAD', low: 40, high: 120, max: 220 },
];

const lessons = [
  ['01', 'Meta reste la machine à volume', 'Facebook et Instagram demeurent les principaux générateurs de leads dans l’échantillon Richmedia.'],
  ['02', 'Search capte les intentions les plus chaudes', 'Google Search produit généralement les leads les plus qualifiés.'],
  ['03', 'Le CPL seul est insuffisant', 'La qualité du lead et la transformation commerciale doivent aussi être mesurées.'],
  ['04', 'Plus l’audience est premium, plus son acquisition coûte cher', 'Le niveau socio-professionnel ciblé influence fortement le CPL.'],
  ['05', 'Les Lead Ads nécessitent une couche de qualification', 'Un formulaire facile augmente le volume, pas toujours la valeur.'],
  ['06', 'Le retargeting reste décisif en e-commerce', '45 % des conversions analysées proviennent du retargeting.'],
];

const measurementFunnel = [
  { label: 'Média', items: ['CPM', 'CTR', 'CPC'] },
  { label: 'Acquisition', items: ['CPL', 'CPA', 'conversion rate'] },
  { label: 'Qualité', items: ['taux de contact', 'lead qualifié', 'MQL', 'SQL'] },
  { label: 'Business', items: ['vente', 'CAC', 'revenu', 'ROAS', 'LTV'] },
];

const relatedArticles = [
  {
    href: '/insights/plan-acquisition-digital-2026',
    title: "Guide 2026 : construire un plan d'acquisition digital performant",
    description: "Canaux, budget, tracking et conversion pour mieux piloter l'acquisition.",
    category: 'Stratégie',
    image: '/assets/richmedia-digital-strategy/strategy-hero.webp',
    readingTime: 10,
    date: new Date('2026-04-18'),
  },
  {
    href: '/insights/cout-lead-maroc-benchmarks-cpl',
    title: 'Quel est le coût d’un lead au Maroc ?',
    description: 'Benchmarks CPL 2026 par secteur issus de 400 campagnes analysées.',
    category: 'Média & performance',
    image: '/assets/richmedia-tools/hero-dashboard.webp',
    readingTime: 12,
    date: new Date('2026-08-31'),
  },
  {
    href: '/insights/cout-campagne-google-ads-maroc',
    title: 'Combien coûte une campagne Google Ads au Maroc ?',
    description: 'Budget, enchères et facteurs de coût pour comprendre Google Ads.',
    category: 'Média & performance',
    image: '/assets/richmedia-achat-media/achat-media-hero.webp',
    readingTime: 10,
    date: new Date('2026-02-01'),
  },
  {
    href: '/insights/campagnes-meta-2026-bonnes-pratiques',
    title: 'Campagnes Meta 2026 : les bonnes pratiques',
    description: 'Structure de campagnes, ciblages, créations et mesure.',
    category: 'Média & performance',
    image: '/assets/richmedia-achat-media/media-creative-tests.webp',
    readingTime: 7,
    date: new Date('2026-05-12'),
  },
  {
    href: '/insights/whatsapp-business-canal-conversion',
    title: 'WhatsApp Business : un canal de conversion sous-exploité',
    description: 'Cas d’usage, automation et bonnes pratiques pour transformer les conversations.',
    category: 'WhatsApp & automation',
    image: '/assets/richmedia-ia-automation/whatsapp-agent.webp',
    readingTime: 8,
    date: new Date('2026-05-03'),
  },
];

const recentArticles = relatedArticles;

const serviceLinks = [
  { href: '/expertises/media-performance', label: 'Média & Performance' },
  { href: '/expertises/referencement-seo', label: 'SEO / GEO' },
  { href: '/expertises/influence', label: 'Influence & social media' },
  { href: '/produits/whatsapp', label: 'Solution WhatsApp Business Richmedia' },
  { href: '/outils', label: 'Outils & ressources' },
  { href: '/outils/calculateur-budget-media-leads', label: 'Calculateur Budget Média & Leads' },
  { href: '/outils/estimateur-campagne-whatsapp', label: 'Estimateur campagne WhatsApp' },
  { href: '/outils/template-plan-media-digital', label: 'Template Plan Média Digital' },
];

const faq = [
  {
    question: 'Ce baromètre est-il un benchmark officiel du marché marocain ?',
    answer:
      'Non. Il s’appuie sur les campagnes digitales pilotées par Richmedia entre 2022 et 2026. Les chiffres donnent des ordres de grandeur utiles, mais ils ne remplacent pas une analyse par secteur, offre, cible et qualité commerciale.',
  },
  {
    question: 'Quel indicateur faut-il suivre en priorité ?',
    answer:
      'Le bon indicateur dépend de l’objectif. Pour l’acquisition, le CPL doit être croisé avec le taux de contact, la qualification, les rendez-vous et les ventes. Un lead moins cher peut coûter plus cher s’il ne transforme pas.',
  },
  {
    question: 'Comment utiliser ces chiffres pour préparer un budget 2026 ?',
    answer:
      'Il faut partir de l’objectif business, choisir le rôle de chaque canal, estimer les volumes nécessaires puis garder une marge de test. Le budget doit produire des apprentissages, pas seulement des impressions ou des clics.',
  },
];

const schema = [
  articleSchema({
    title: pageTitle,
    description: metaDescription,
    url: pageUrl,
    author: {
      '@type': 'Person',
      '@id': authorPersonId(authorProfile.slug),
      name: authorProfile.name,
      url: authorCanonicalUrl(authorProfile.slug),
      image: authorImage,
    },
    datePublished: publishedDate,
    dateModified: modifiedDate,
    image: absoluteImage,
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Insights', url: `${SITE.url}/insights` },
    { name: pageTitle, url: pageUrl },
  ]),
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={pageUrl}
  ogImage={absoluteImage}
  ogType="article"
  articlePublishedTime={publishedDate}
  articleModifiedTime={modifiedDate}
  articleAuthor={authorProfile.name}
  articleSection="Benchmark marketing digital"
  schema={schema}
>
  <ArticleDetailPage
    breadcrumbLabel="Insights"
    breadcrumbHref="/insights"
    categoryLabel="Benchmark marketing digital"
    title={pageTitle}
    description={metaDescription}
    author={authorProfile.name}
    authorRole={authorProfile.role.fr}
    authorBio={authorProfile.bio.fr}
    authorImage={authorProfile.image}
    authorUrl={getEditorialAuthorPath(authorProfile.name, 'fr')}
    date={publishedDate}
    readingTime={12}
    image={image}
    imageFit="contain"
    heroCtaLabel="Télécharger le baromètre"
    heroCtaHref="#barometer-download"
    quickAnswer="Le Baromètre du Marketing Digital au Maroc 2026 synthétise 400 campagnes pilotées par Richmedia entre 2022 et 2026. Il donne des repères concrets sur les budgets, les canaux, les coûts d’acquisition, les leads, WhatsApp, Google Ads, Meta Ads et la mesure de performance."
    tags={['baromètre marketing digital Maroc', 'benchmark acquisition', 'Meta Ads Maroc', 'Google Ads Maroc']}
    recentArticles={recentArticles}
    relatedArticles={relatedArticles}
    faq={faq}
    ctaTitle="Comparez vos campagnes au benchmark Richmedia."
    ctaPrimary="Demander un audit"
    ctaPrimaryHref="/reserver-un-audit"
    ctaSecondary="Découvrir nos expertises"
    ctaSecondaryHref="/expertises"
    newsletterTitle="Restez à la page"
    newsletterDescription="Recevez nos derniers insights, tendances et études de cas."
    newsletterButton="S’abonner"
    relatedTitle="À lire ensuite"
    recentTitle="Articles récents"
    authorTitle="À propos de l’auteur"
  >
    <p>
      Ce baromètre ne repose pas sur une enquête déclarative. Il agrège les performances réellement observées sur des
      campagnes digitales pilotées par Richmedia au Maroc : acquisition, notoriété, génération de leads, WhatsApp,
      e-commerce, influence, drive-to-store et reporting.
    </p>

    <figure class="article-visual">
      <img
        src="/assets/richmedia-achat-media/media-scaling-room.webp"
        alt="Équipe marketing analysant les performances média d'une campagne digitale"
        loading="lazy"
      />
      <figcaption>Un benchmark utile doit relier média, tracking, qualité commerciale et décisions d’optimisation.</figcaption>
    </figure>

    <div class="benchmark-stat-grid" aria-label="Chiffres clés du baromètre">
      {keyStats.map((stat) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </div>

    <section class="barometer-download" id="barometer-download" aria-labelledby="barometer-download-title">
      <div class="barometer-download-copy">
        <span>Téléchargement PDF</span>
        <h2 id="barometer-download-title">Recevoir le Baromètre 2026 complet</h2>
        <p>
          Remplissez le formulaire avec une adresse email professionnelle et le nom de votre société. Le PDF se
          téléchargera automatiquement après validation.
        </p>
        <ul>
          <li>Benchmarks média et acquisition au Maroc</li>
          <li>Repères CPL, CPC, CTR et conversion</li>
          <li>Données observées sur les campagnes Richmedia 2022-2026</li>
        </ul>
      </div>

      <form
        class="barometer-download-form"
        action={CONTACT_FORM.action}
        method="post"
        data-contact-endpoint={CONTACT_FORM.ajaxAction}
        data-barometer-download-form
        data-pdf-href={barometerPdfHref}
        data-pdf-name={barometerPdfFilename}
        novalidate
      >
        <input type="hidden" name="_form" value="Téléchargement Baromètre Marketing Digital Maroc 2026" />
        <input type="hidden" name="_subject" value="[Richmedia] Téléchargement Baromètre Marketing Digital Maroc 2026" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="Source" value={pageUrl} />
        <label class="form-honeypot" aria-hidden="true">
          Site web
          <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
        </label>
        <label>
          <span>Nom et prénom</span>
          <input type="text" name="Nom et prénom" autocomplete="name" required />
        </label>
        <label>
          <span>Email professionnel</span>
          <input type="email" name="Email professionnel" autocomplete="email" required data-business-email />
          <small>Les adresses Gmail et emails personnels ne sont pas acceptés.</small>
        </label>
        <label>
          <span>Société</span>
          <input type="text" name="Société" autocomplete="organization" required data-company-input />
        </label>
        <button type="submit">
          Télécharger le PDF
          <i class="ph ph-download-simple" aria-hidden="true"></i>
        </button>
        <p class="barometer-form-status" data-form-status role="status" aria-live="polite"></p>
        <a class="barometer-download-link" href={barometerPdfHref} download={barometerPdfFilename} hidden data-download-link>
          Télécharger à nouveau le PDF
        </a>
      </form>
    </section>

    <h2>Répartition de l’échantillon</h2>
    <p>
      Les 400 campagnes analysées couvrent plusieurs secteurs et plusieurs objectifs. Éducation et immobilier pèsent
      fortement dans l’échantillon, car ces secteurs activent beaucoup de dispositifs de génération de leads au Maroc.
    </p>

    <div class="insight-chart" role="img" aria-label="Répartition des campagnes par secteur">
      <strong>Part des campagnes analysées par secteur</strong>
      {sectors.map((sector) => (
        <div class="chart-row">
          <span>{sector.label}</span>
          <i style={`width: ${sector.value * 3.6}%`}></i>
          <span>{sector.campaigns} · {sector.share}</span>
        </div>
      ))}
    </div>

    <div class="article-table">
      <table>
        <thead>
          <tr>
            <th>Secteur</th>
            <th>Campagnes</th>
            <th>Poids dans l’échantillon</th>
            <th>Lecture business</th>
          </tr>
        </thead>
        <tbody>
          {sectors.map((sector) => (
            <tr>
              <td>{sector.label}</td>
              <td>{sector.campaigns}</td>
              <td>{sector.share}</td>
              <td>{sector.value >= 13 ? 'Secteur fortement représenté dans les campagnes d’acquisition.' : 'Secteur présent mais plus hétérogène dans les objectifs analysés.'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Canaux activés : Meta domine le volume, Google capte l’intention</h2>
    <p>
      Une même campagne peut activer plusieurs plateformes. Les parts ci-dessous indiquent donc la fréquence d’usage
      de chaque canal dans les 400 campagnes, pas une addition de parts de marché.
    </p>

    <div class="insight-chart" role="img" aria-label="Canaux activés dans les campagnes Richmedia">
      <strong>Part des campagnes ayant activé chaque canal</strong>
      {channels.map((channel) => (
        <div class="chart-row">
          <span>{channel.label}</span>
          <i style={`width: ${channel.value}%`}></i>
          <span>{channel.campaigns} · {channel.share}</span>
        </div>
      ))}
    </div>

    <div class="article-table">
      <table>
        <thead>
          <tr>
            <th>Canal</th>
            <th>Campagnes</th>
            <th>Fréquence</th>
            <th>Rôle principal observé</th>
          </tr>
        </thead>
        <tbody>
          {channels.map((channel) => (
            <tr>
              <td>{channel.label}</td>
              <td>{channel.campaigns}</td>
              <td>{channel.share}</td>
              <td>{channel.label === 'Google Ads' ? 'Capter une demande active.' : channel.label === 'WhatsApp' ? 'Transformer le push en conversation.' : channel.label === 'Meta Ads' ? 'Créer du volume et tester les messages.' : 'Compléter le mix selon l’objectif.'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <blockquote>
      La question n’est généralement pas : Meta ou Google ? La vraie question est : quel rôle attribuer à chaque canal
      dans le parcours d’acquisition ?
    </blockquote>

    <h2>Lecture globale des performances</h2>
    <p>
      Ces moyennes donnent un ordre de grandeur. Elles ne doivent pas être utilisées comme benchmark universel : le
      secteur, l’offre, l’audience, la landing page et le niveau de qualification changent fortement la lecture.
    </p>

    <div class="benchmark-metric-grid">
      {globalPerformance.map((item) => (
        <article>
          <span>{item.label}</span>
          <strong>{item.value}</strong>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>

    <div class="article-table">
      <table>
        <thead>
          <tr>
            <th>Indicateur</th>
            <th>Résultat agrégé</th>
            <th>Comment l’interpréter</th>
          </tr>
        </thead>
        <tbody>
          {globalPerformance.map((item) => (
            <tr>
              <td>{item.label}</td>
              <td>{item.value}</td>
              <td>{item.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <figure class="article-visual">
      <img
        src="/assets/richmedia-case-study/proof-social-feed.webp"
        alt="Reporting social media et performance de contenus dans un dispositif digital"
        loading="lazy"
      />
      <figcaption>Le média seul ne suffit pas : les créations, les preuves et la page de conversion modifient la performance.</figcaption>
    </figure>

    <h2>Benchmarks Meta Ads et Google Search</h2>
    <p>
      Meta Ads génère le plus grand volume dans l’échantillon. Google Ads apparaît moins souvent, mais intervient plus
      près de l’intention exprimée, notamment sur les recherches liées à un besoin concret.
    </p>

    <div class="range-grid">
      <article class="range-card">
        <h3>Meta Ads</h3>
        <p>Un levier de volume, très dépendant de la création, du ciblage et de la qualification post-lead.</p>
        {metaRanges.map((item) => (
          <div class="range-row" style={`--low:${(item.low / item.max) * 100}%; --high:${(item.high / item.max) * 100}%`}>
            <span>{item.label}</span>
            <div><i></i></div>
            <strong>{item.value}</strong>
          </div>
        ))}
      </article>

      <article class="range-card">
        <h3>Google Search</h3>
        <p>Un levier d’intention, plus cher au clic mais souvent plus lisible pour les demandes actives.</p>
        {googleRanges.map((item) => (
          <div class="range-row" style={`--low:${(item.low / item.max) * 100}%; --high:${(item.high / item.max) * 100}%`}>
            <span>{item.label}</span>
            <div><i></i></div>
            <strong>{item.value}</strong>
          </div>
        ))}
      </article>
    </div>

    <div class="article-table">
      <table>
        <thead>
          <tr>
            <th>Critère</th>
            <th>Meta Ads</th>
            <th>Google Search</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Logique</td><td>Créer ou stimuler la demande.</td><td>Capter une demande existante.</td></tr>
          <tr><td>Volume</td><td>Très élevé.</td><td>Plus limité.</td></tr>
          <tr><td>CPC</td><td>Généralement plus faible.</td><td>Généralement plus élevé.</td></tr>
          <tr><td>Qualité des leads</td><td>Variable selon formulaire et relance.</td><td>Souvent plus forte sur intention chaude.</td></tr>
          <tr><td>Usage idéal</td><td>Acquisition, découverte, volume.</td><td>Conversion, intention chaude, arbitrage.</td></tr>
        </tbody>
      </table>
    </div>

    <h2>CPL par secteur : le coût dépend de ce que l’on vend</h2>
    <p>
      Un lead retail simple, un prospect immobilier, un dossier d’inscription et une demande automobile ne portent pas
      la même valeur commerciale. Comparer les CPL sans regarder la qualification crée de mauvaises décisions.
    </p>

    <div class="range-card wide">
      {cplBySector.map((item) => (
        <div class="range-row" style={`--low:${(item.low / item.max) * 100}%; --high:${(item.high / item.max) * 100}%`}>
          <span>{item.label}</span>
          <div><i></i></div>
          <strong>{item.value}</strong>
        </div>
      ))}
    </div>

    <h2>WhatsApp, retargeting et qualité commerciale</h2>
    <p>
      130 campagnes du benchmark ont intégré WhatsApp. Le canal prolonge le média par une interaction : message,
      clic, réponse, chatbot, conseiller, relance puis conversion.
    </p>

    <figure class="article-visual">
      <img
        src="/assets/richmedia-ia-automation/crm-automation.webp"
        alt="Scénarios CRM et automation WhatsApp pour convertir les leads"
        loading="lazy"
      />
      <figcaption>WhatsApp et le CRM réduisent la distance entre clic, qualification et décision commerciale.</figcaption>
    </figure>

    <div class="conversion-panel">
      <article>
        <h3>WhatsApp dans les campagnes analysées</h3>
        <div class="mini-metrics">
          <span><strong>80 à 95 %</strong> Lecture / ouverture</span>
          <span><strong>8 à 25 %</strong> Clic</span>
          <span><strong>3 à 25 %</strong> Réponse</span>
          <span><strong>5 à 8 %</strong> Conversion observée</span>
        </div>
      </article>
      <article>
        <h3>Conversions e-commerce observées</h3>
        <div class="donut-wrap" aria-label="45 % retargeting, 30 % audiences similaires, 25 % autres signaux">
