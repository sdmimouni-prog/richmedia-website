---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDetailPage from '../../components/ArticleDetailPage.astro';
import { articleSchema, breadcrumbs } from '../../lib/schema';
import { EDITORIAL_AUTHOR, SITE } from '../../consts';

const categoryLabels: Record<string, string> = {
  Growth: 'Stratégie',
  Media: 'Média & performance',
  SEO: 'SEO / GEO',
  Social: 'Influence & social media',
  Secteur: 'Secteurs',
};

const articleImages: Record<string, string> = {
  'priorites-digitales-2026-croissance-rentable': '/assets/richmedia-digital-strategy/strategy-workshop.webp',
  'data-decision-strategie-performance': '/assets/richmedia-achat-media/media-traffic-manager.webp',
  'seo-vs-geo-enjeux-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'campagnes-meta-2026-bonnes-pratiques': '/assets/richmedia-achat-media/media-creative-tests.webp',
  'whatsapp-business-canal-conversion': '/assets/richmedia-ia-automation/whatsapp-agent.webp',
  'createurs-marques-collaborations-durables': '/assets/richmedia-influence/creator-lifestyle.webp',
  'plan-acquisition-digital-2026': '/assets/richmedia-digital-strategy/strategy-hero.webp',
  'marque-employeur-attractivite-digitale': '/assets/richmedia-agence/agence-collaboration.webp',
  'cout-campagne-google-ads-maroc': '/assets/richmedia-achat-media/achat-media-hero.webp',
  'contenu-qualite-seo-perenne': '/assets/richmedia-brand-content/brand-content-hero.webp',
  'crm-automation-aligner-marketing-sales': '/assets/richmedia-ia-automation/crm-automation.webp',
};

const toArticleCard = (entry: any) => {
  const slug = entry.data.slug ?? entry.id;
  return {
    href: `/insights/${slug}`,
    title: entry.data.title,
    description: entry.data.metaDescription,
    category: categoryLabels[entry.data.categorie] ?? entry.data.categorie,
    image: articleImages[slug] ?? entry.data.ogImage ?? '/og-default.jpg',
    readingTime: entry.data.tempsLecture ?? 6,
    date: entry.data.datePublication,
  };
};

export async function getStaticPaths() {
  const englishInsightAliases: Record<string, string> = {
    'creators-brands-durable-collaborations': '/en/insights/creators-brands-durable-collaborations/',
    'crm-automation-marketing-sales-alignment': '/en/insights/crm-automation-marketing-sales-alignment/',
    'data-for-decisions-performance-strategy': '/en/insights/data-for-decisions-performance-strategy/',
    'digital-acquisition-plan-2026': '/en/insights/digital-acquisition-plan-2026/',
    'digital-priorities-2026-profitable-growth': '/en/insights/digital-priorities-2026-profitable-growth/',
    'employer-brand-digital-attractiveness': '/en/insights/employer-brand-digital-attractiveness/',
    'google-ads-campaign-cost-morocco': '/en/insights/google-ads-campaign-cost-morocco/',
    'meta-campaigns-2026-best-practices': '/en/insights/meta-campaigns-2026-best-practices/',
    'quality-content-durable-seo': '/en/insights/quality-content-durable-seo/',
    'seo-vs-geo-2026': '/en/insights/seo-vs-geo-2026/',
    'whatsapp-business-conversion-channel': '/en/insights/whatsapp-business-conversion-channel/',
  };
  const entries = await getCollection('articles', ({ data }) => !data.draft && data.lang === 'fr');
  return [
    ...entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry } })),
    ...Object.entries(englishInsightAliases).map(([slug, redirectTo]) => ({
      params: { slug },
      props: { redirectTo },
    })),
  ];
}

const { entry, redirectTo } = Astro.props;
const pageEntry = entry!;
const redirectUrl = redirectTo ? `${SITE.url}${redirectTo}` : undefined;

let Content: any;
let slug = '';
let url = '';
let image = '';
let recentArticles: ReturnType<typeof toArticleCard>[] = [];
let fallbackRelated: ReturnType<typeof toArticleCard>[] = [];
let categoryLabel = '';
let schemaImage = '';
let schema: object[] = [];

if (!redirectTo) {
  if (!pageEntry) throw new Error('Missing article entry');
  const rendered = await render(pageEntry);
  Content = rendered.Content;
  slug = pageEntry.data.slug ?? pageEntry.id;
  url = `${SITE.url}/insights/${slug}`;
  image = articleImages[slug] ?? pageEntry.data.ogImage ?? '/og-default.jpg';
  const allEntries = (await getCollection('articles', ({ data }) => !data.draft && data.lang === 'fr'))
    .sort((a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime());
  const otherEntries = allEntries.filter((article) => (article.data.slug ?? article.id) !== slug);
  recentArticles = otherEntries.slice(0, 4).map(toArticleCard);
  const relatedArticles = otherEntries
    .filter((article) => article.data.categorie === pageEntry.data.categorie)
    .slice(0, 4)
    .map(toArticleCard);
  fallbackRelated = relatedArticles.length > 0 ? relatedArticles : recentArticles.slice(0, 4);
  categoryLabel = categoryLabels[pageEntry.data.categorie] ?? pageEntry.data.categorie;
  schemaImage = image.startsWith('/') ? `${SITE.url}${image}` : image;
  const authorImage = EDITORIAL_AUTHOR.image.startsWith('/') ? `${SITE.url}${EDITORIAL_AUTHOR.image}` : EDITORIAL_AUTHOR.image;
  schema = [
    articleSchema({
      title: pageEntry.data.title,
      description: pageEntry.data.metaDescription,
      url,
      author: EDITORIAL_AUTHOR.name,
      authorType: 'Person',
      authorImage,
      datePublished: pageEntry.data.datePublication,
      dateModified: pageEntry.data.dateModification,
      image: schemaImage,
    }),
    breadcrumbs([
      { name: 'Accueil', url: SITE.url },
      { name: 'Insights', url: `${SITE.url}/insights` },
      { name: pageEntry.data.title, url },
    ]),
  ];
}
---

{redirectTo ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta name="robots" content="noindex, follow" />
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
      <link rel="canonical" href={redirectUrl} />
      <title>Redirecting to English insight | Richmedia</title>
      <script is:inline define:vars={{ redirectTo }}>
        window.location.replace(redirectTo);
      </script>
    </head>
    <body>
      <p>Redirecting to <a href={redirectTo}>the English insight</a>.</p>
    </body>
  </html>
) : (
  <BaseLayout
    title={pageEntry.data.metaTitle ?? pageEntry.data.title}
    description={pageEntry.data.metaDescription}
    canonical={url}
    ogImage={schemaImage}
    ogType="article"
    articlePublishedTime={pageEntry.data.datePublication}
    articleModifiedTime={pageEntry.data.dateModification}
    articleAuthor={EDITORIAL_AUTHOR.name}
    articleSection={pageEntry.data.categorie}
    schema={schema}
  >
    <ArticleDetailPage
      breadcrumbLabel="Insights"
      breadcrumbHref="/insights"
      categoryLabel={categoryLabel}
      title={pageEntry.data.title}
      description={pageEntry.data.metaDescription}
      author={EDITORIAL_AUTHOR.name}
      authorRole={EDITORIAL_AUTHOR.role.fr}
      authorBio={EDITORIAL_AUTHOR.bio.fr}
      authorImage={EDITORIAL_AUTHOR.image}
      date={pageEntry.data.datePublication}
      readingTime={pageEntry.data.tempsLecture ?? 6}
      image={image}
      quickAnswer={pageEntry.data.quickAnswer}
      tags={[pageEntry.data.keywordPrincipal, ...pageEntry.data.keywordsSecondaires].slice(0, 4)}
      recentArticles={recentArticles}
      relatedArticles={fallbackRelated}
      faq={pageEntry.data.faq}
      ctaTitle="Des questions sur votre stratégie digitale ? Échangeons avec nos experts."
      ctaPrimary="Discuter d'un projet"
      ctaPrimaryHref="/contact"
      ctaSecondary="Découvrir nos expertises"
      ctaSecondaryHref="/expertises"
      newsletterTitle="Restez à la page"
      newsletterDescription="Recevez nos derniers insights, tendances et études de cas."
      newsletterButton="S’abonner"
      relatedTitle="Articles associés"
      recentTitle="Articles récents"
      authorTitle="À propos de l’auteur"
    >
      <Content />
    </ArticleDetailPage>
  </BaseLayout>
)}
