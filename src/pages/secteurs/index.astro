---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import { breadcrumbs, collectionPageSchema } from '../../lib/schema';
import { frSiloLinks } from '../../lib/seo-silos';
import { SITE } from '../../consts';

const pageUrl = `${SITE.url}/secteurs`;
const pageTitle = 'Secteurs accompagnés par Richmedia';
const pageDescription =
  'Secteurs accompagnés par Richmedia : cas clients, chiffres, preuves et FAQ pour éducation, immobilier, retail, GMS, tourisme, automobile et FMCG.';
const sectorOrder = [
  'education',
  'immobilier',
  'retail-ecommerce',
  'gms',
  'institutionnel',
  'tourisme-hotellerie',
  'automobile',
  'fmcg',
];
const sectorLabels: Record<string, string> = {
  education: 'Éducation',
  immobilier: 'Immobilier',
  'retail-ecommerce': 'Retail & e-commerce',
  gms: 'GMS',
  institutionnel: 'Institutionnel',
  'tourisme-hotellerie': 'Tourisme / hôtellerie',
  automobile: 'Automobile',
  fmcg: 'FMCG',
};

const sectorImages: Record<string, string> = {
  education: '/assets/richmedia-sector-education/education-hero-campus.webp',
  immobilier: '/assets/richmedia-sector-immobilier/hero-real-estate-premium.webp',
  'retail-ecommerce': '/assets/richmedia-sector-retail/case-moul-pounj-commerce-connected.webp',
  gms: '/assets/richmedia-sector-gms/hero-gms-retail.webp',
  institutionnel: '/assets/richmedia-sector-institutionnel/hero-building-ministere-maroc.webp',
  'tourisme-hotellerie': '/assets/richmedia-sector-hotellerie/hero-hotellerie-resort.webp',
  automobile: '/assets/richmedia-sector-automobile/hero-premium-showroom.webp',
  fmcg: '/assets/richmedia-sector-fmcg/hero-fmcg-products.webp',
};

const sectors = (await getCollection('secteurs', ({ data }) => !data.draft))
  .map((entry) => ({
    slug: entry.data.slug ?? entry.id,
    title: sectorLabels[entry.data.slug ?? entry.id] ?? entry.data.title,
    image: sectorImages[entry.data.slug ?? entry.id],
  }))
  .sort((a, b) => sectorOrder.indexOf(a.slug) - sectorOrder.indexOf(b.slug));

const schema = [
  collectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'fr-MA',
    items: sectors.map((sector) => ({
      name: sector.title,
      url: `${SITE.url}/secteurs/${sector.slug}`,
    })),
  }),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Secteurs', url: pageUrl },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  schema={schema}
>
  <div class="sectors-page">
    <section class="sectors-hero" aria-labelledby="sectors-title">
      <span class="section-kicker">Secteurs</span>
      <h1 id="sectors-title">Des dispositifs digitaux adaptés à chaque marché.</h1>
      <p>
        Richmedia relie stratégie, création, média, web, data et IA pour répondre aux logiques propres à chaque
        secteur avec des cas clients, chiffres, preuves, FAQ, cycles de décision, saisonnalité, acquisition et conversion.
      </p>
    </section>

    <section class="sectors-grid" aria-label="Liste des secteurs Richmedia">
      {sectors.map((sector) => (
        <a href={`/secteurs/${sector.slug}`} class="sector-card" aria-label={`Voir le secteur ${sector.title}`}>
          <img src={sector.image} alt={`${sector.title} - marketing digital sectoriel Richmedia`} loading="lazy" decoding="async" />
          <h2>{sector.title}</h2>
        </a>
      ))}
    </section>

    <SeoSiloLinks
      title="Explorer les silos secteur"
      intro="Chaque marché renvoie vers les expertises, preuves et campagnes les plus utiles pour créer un parcours SEO cohérent."
      links={frSiloLinks.sectorsHub}
    />

    <section class="sectors-cta" aria-labelledby="sectors-cta-title">
      <div>
        <h2 id="sectors-cta-title">Chaque secteur connecte les expertises, les preuves et les offres.</h2>
      </div>
      <a class="button button-primary" href="/contact">
        Parler à l’équipe
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .sectors-page {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .sectors-hero {
    display: grid;
    max-width: 780px;
    gap: 1rem;
    padding-top: clamp(1rem, 4vw, 3rem);
  }

  .sectors-hero h1,
  .sectors-cta h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.7rem, 6.6vw, 5.8rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.96;
  }

  .sectors-hero p {
    max-width: 62ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.7;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .sector-card {
    position: relative;
    display: block;
    min-height: 19rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: #090a10;
    color: #fff;
    isolation: isolate;
    text-decoration: none;
    transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }

  .sector-card::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, transparent 22%, rgba(3, 3, 6, 0.18) 48%, rgba(3, 3, 6, 0.92) 100%),
      radial-gradient(circle at 18% 12%, rgba(124, 60, 255, 0.18), transparent 18rem);
    content: "";
    pointer-events: none;
  }

  .sector-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transform: scale(1.01);
    transition: opacity 260ms ease, transform 420ms ease;
  }

  .sector-card h2 {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 2;
    margin: 0;
    color: #fff;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.05;
    text-shadow: 0 0.9rem 1.8rem rgba(0, 0, 0, 0.72);
    text-wrap: balance;
  }

  .sector-card:hover,
  .sector-card:focus-visible {
    border-color: rgba(156, 109, 255, 0.64);
    box-shadow: 0 1.4rem 3rem rgba(0, 0, 0, 0.28);
    outline: 0;
    transform: translateY(-4px);
  }

  .sector-card:hover img,
  .sector-card:focus-visible img {
    opacity: 1;
    transform: scale(1.06);
  }

  .sectors-cta {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  .sectors-cta h2 {
    max-width: 780px;
    font-size: clamp(2rem, 4.4vw, 4.2rem);
  }

  @media (max-width: 980px) {
    .sectors-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sectors-cta {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .sectors-grid {
      grid-template-columns: 1fr;
    }

    .sector-card {
      min-height: 14rem;
    }
  }
</style>
