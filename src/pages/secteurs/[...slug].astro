<BaseLayout title={entry.data.metaTitle ?? entry.data.title} description={entry.data.metaDescription} canonical={url} schema={schema}>
  {isEducation ? (
    <article class="education-sector">
      <section class="education-hero" aria-labelledby="education-title">
        <div class="education-hero-copy">
          <span class="education-kicker">Secteur / Éducation</span>
          <h1 id="education-title"><strong>Marketing digital</strong> pour écoles, universités et organismes de formation</h1>
          <div class="education-underline" aria-hidden="true"></div>
          <p>
            Richmedia accompagne les acteurs de l’éducation dans leurs campagnes d’inscription, notoriété,
            génération de leads et conversion candidats.
          </p>
          <div class="education-actions">
            <a class="education-button education-button-primary" href="/contact">
              Parler de votre projet
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
            <a class="education-button education-button-secondary" href="/realisations/uir-campagnes-digitales">
              Nos réalisations éducation
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
        <figure class="education-hero-visual">
          <img
            src="/assets/richmedia-sector-education/education-hero-campus.webp"
            alt="Étudiante sur un campus, campagne digitale éducation"
            width="1100"
            height="1074"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption class="education-trust-panel">
            <div class="education-trust-heading">
              <span>Ils nous font confiance</span>
              <strong>
                5
                <small>références</small>
              </strong>
            </div>
            <div class="education-trust-grid" aria-label="Références éducation">
              {trustBrands.map((brand, index) => (
                <strong class="education-trust-logo" style={`--logo-index: ${index + 1}`}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <img
                    src={brand.logo}
                    alt={`Logo ${brand.name} - ${brand.detail}`}
                    width={brand.width}
                    height={brand.height}
                    loading="lazy"
                    decoding="async"
                  />
                </strong>
              ))}
            </div>
          </figcaption>
        </figure>
      </section>

      <section class="education-section" aria-labelledby="education-challenges-title">
        <h2 id="education-challenges-title">Les enjeux du secteur</h2>
        <div class="education-challenge-grid">
          {educationChallenges.map((challenge) => (
            <article>
              <i class={challenge.icon} aria-hidden="true"></i>
              <h3>{challenge.title}</h3>
              <p>{challenge.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="education-section education-method" aria-labelledby="education-method-title">
        <h2 id="education-method-title">Notre méthode pour l’éducation</h2>
        <div class="education-method-layout">
          <div class="education-timeline" aria-label="Méthode en quatre étapes">
            {educationMethod.map((step) => (
              <article>
                <span>{step.step}</span>
                <i class={step.icon} aria-hidden="true"></i>
                <h3>{step.title}</h3>
                <ul>
                  {step.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </article>
            ))}
          </div>
          <aside class="education-levers" aria-label="Nos leviers clés">
            <h3>Nos leviers clés</h3>
            <ul>
              {keyLevers.map((lever) => (
                <li>
                  <i class="ph ph-check-circle" aria-hidden="true"></i>
                  {lever}
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </section>

      <section class="education-section" aria-labelledby="education-campaigns-title">
        <h2 id="education-campaigns-title">Campagnes que nous savons piloter</h2>
        <div class="education-campaign-grid">
          {educationCampaigns.map((campaign) => (
            <article style={`--campaign-image: url('${campaign.image}')`}>
              <i class={campaign.icon} aria-hidden="true"></i>
              <h3>{campaign.title}</h3>
              <p>{campaign.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="education-trust-case" aria-labelledby="education-trust-title">
        <div class="education-trust-copy">
          <h2 id="education-trust-title">Ils nous font confiance</h2>
          <div class="education-logo-row" aria-label="Références éducation">
            {trustBrands.map((brand) => (
              <span class="education-logo-item">
                <img
                  src={brand.logo}
                  alt={`Logo ${brand.name} - ${brand.detail}`}
                  width={brand.width}
                  height={brand.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            ))}
          </div>
        </div>
        <article class="education-case-card">
          <img src="/assets/richmedia-sector-education/campaigns/notoriete-institutionnelle.webp" alt="Campus universitaire moderne pour campagne admissions" width="1280" height="720" loading="lazy" decoding="async" />
          <div class="education-case-content">
            <div class="education-case-main">
              <span>Cas client</span>
              <h3>UIR - Campagne d’inscriptions 2024</h3>
              <p>
                Un dispositif admissions full-funnel pour générer des demandes qualifiées,
                relancer les candidats et mesurer la performance jusqu’à l’inscription.
              </p>
              <a class="education-button education-button-primary" href="/realisations/uir-campagnes-digitales">
                Voir le case study UIR
                <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
              </a>
            </div>
            <div class="education-case-metrics" aria-label="Résultats de la campagne">
              <strong>
                20,1M
                <span>impressions</span>
              </strong>
              <strong>
                34 287
                <span>leads qualifiés</span>
              </strong>
              <strong>
                18,7%
                <span>taux d’inscription</span>
              </strong>
            </div>
          </div>
        </article>
      </section>

      <section class="education-section education-faq-section" aria-labelledby="education-faq-title">
        <h2 id="education-faq-title">FAQ - Éducation</h2>
        <div class="education-faq-grid">
          {entry.data.faq.map((item, index) => (
            <details>
              <summary>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {item.question}
                <i class="ph ph-caret-down" aria-hidden="true"></i>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="education-bottom-cta" aria-labelledby="education-cta-title">
        <i class="ph ph-graduation-cap" aria-hidden="true"></i>
        <div>
          <h2 id="education-cta-title">Prêt à booster vos inscriptions ?</h2>
        </div>
        <a class="education-button education-button-primary" href="/contact">
          Parler de votre projet
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </section>
    </article>
  ) : isRetailEcommerce ? (
    <article class="education-sector retail-sector">
      <section class="education-hero" aria-labelledby="retail-title">
        <div class="education-hero-copy">
          <span class="education-kicker">Secteur / Retail & E-commerce</span>
          <h1 id="retail-title"><strong>Marketing digital</strong> pour retail, commerce en ligne et réseaux de vente</h1>
          <div class="education-underline" aria-hidden="true"></div>
          <p>
            Richmedia accompagne les enseignes retail, marques e-commerce et acteurs du commerce connecté dans leurs
            campagnes d’acquisition, trafic magasin, conversion, fidélisation et visibilité géolocalisée au Maroc.
          </p>
          <div class="education-actions">
            <a class="education-button education-button-primary" href="/contact">
              Parler de votre projet
