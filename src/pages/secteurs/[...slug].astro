import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoSiloLinks from '../../components/SeoSiloLinks.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbs, faqSchema, serviceSchema } from '../../lib/schema';
import { frSiloLinks, sectorSiloLinksFr } from '../../lib/seo-silos';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('secteurs', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.data.slug ?? entry.id;
const url = `${SITE.url}/secteurs/${slug}`;
const isEducation = slug === 'education';
const isRetailEcommerce = slug === 'retail-ecommerce';
const isInstitutionnel = slug === 'institutionnel';
const isAutomobile = slug === 'automobile';
const isImmobilier = slug === 'immobilier';
const isGms = slug === 'gms';
const isFmcg = slug === 'fmcg';
const isTourismeHotellerie = slug === 'tourisme-hotellerie';
const sectorSiloLinks = sectorSiloLinksFr[slug as keyof typeof sectorSiloLinksFr] ?? frSiloLinks.sectorsHub;
const schema = [
  {
    ...serviceSchema({
      name: entry.data.title,
      description: entry.data.quickAnswer || entry.data.metaDescription,
      url,
    }),
    '@id': `${url}#service`,
    inLanguage: 'fr-MA',
    serviceType: entry.data.keywordPrincipal,
    category: 'Marketing digital sectoriel',
    keywords: [entry.data.keywordPrincipal, ...entry.data.keywordsSecondaires],
  },
  faqSchema(entry.data.faq),
  breadcrumbs([
    { name: 'Accueil', url: SITE.url },
    { name: 'Secteurs', url: `${SITE.url}/secteurs` },
    { name: entry.data.title, url },
  ]),
];

