  .education-method-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.3fr);
    gap: 1rem;
    align-items: end;
    perspective: 1000px;
  }

  .education-timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding-top: 2.8rem;
  }

  .education-timeline::before {
    position: absolute;
    top: 1.25rem;
    right: 12.5%;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, rgba(157, 91, 255, 0.25), #9a5dff);
    content: "";
  }

  .education-timeline article {
    position: relative;
    display: grid;
    gap: 0.75rem;
    min-height: 14.5rem;
    padding: 1.1rem 1rem;
  }

  .education-timeline article > span {
    position: absolute;
    top: -3.15rem;
    left: 50%;
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border: 1px solid #9a5dff;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(124, 60, 255, 0.42), rgba(18, 10, 38, 0.96));
    box-shadow: 0 0 1.8rem rgba(124, 60, 255, 0.42);
    color: #fff;
    font-family: var(--font-numeric);
    font-size: 1rem;
    font-weight: 900;
    transform: translateX(-50%);
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .education-timeline article:hover > span,
  .education-timeline article:focus-within > span {
    border-color: rgba(255, 255, 255, 0.42);
    box-shadow:
      0 0 2.2rem rgba(124, 60, 255, 0.62),
      0 0 0 0.45rem rgba(124, 60, 255, 0.1);
    transform: translateX(-50%) scale(1.07);
  }

  .education-timeline ul,
  .education-levers ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education-timeline li {
    position: relative;
    padding-left: 0.75rem;
  }

  .education-timeline li::before {
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: #fff;
    content: "";
  }

  .education-levers {
    display: grid;
    gap: 0.9rem;
    padding: 1.05rem;
  }

  .education-levers h3 {
    color: #fff;
    font-size: 0.98rem;
  }

  .education-levers li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 0.5rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.78rem;
  }

  .education-levers li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .education-levers i {
    color: #9a5dff;
  }

  .education-campaign-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .education-campaign-grid article {
    position: relative;
    display: grid;
    min-height: 11.2rem;
    align-content: end;
    gap: 0.55rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 1rem;
    background: var(--campaign-image) center / cover no-repeat;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .education-campaign-grid article::before {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 58%;
    background:
      linear-gradient(180deg, rgba(3, 4, 7, 0), rgba(3, 4, 7, 0.18) 48%, rgba(3, 4, 7, 0.36)),
      linear-gradient(90deg, rgba(3, 4, 7, 0.34), rgba(3, 4, 7, 0.08) 72%);
    content: "";
  }

  .education-campaign-grid article > * {
    position: relative;
    z-index: 1;
    text-shadow: 0 0.18rem 0.9rem rgba(0, 0, 0, 0.72);
  }

  .education-campaign-grid article:hover,
  .education-campaign-grid article:focus-within {
    border-color: rgba(154, 93, 255, 0.54);
    box-shadow: 0 1rem 2.4rem rgba(0, 0, 0, 0.3);
    transform: translateY(-3px);
  }

  .education-trust-case {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(420px, 1.25fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: center;
  }

  .education-trust-copy {
    display: grid;
    gap: 1.6rem;
  }

  .education-logo-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    max-width: 27rem;
  }

  .education-logo-row span {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    width: 100%;
    height: 4.1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
    opacity: 0.9;
    transform: translateZ(0);
    transition: transform 280ms cubic-bezier(.2,.8,.2,1), border-color 280ms ease, box-shadow 280ms ease, background 280ms ease, opacity 280ms ease;
    will-change: transform;
  }

  .education-logo-row span::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, transparent 0%, rgba(255, 255, 255, 0.16) 42%, transparent 72%),
      radial-gradient(circle at 50% 100%, rgba(154, 93, 255, 0.18), transparent 54%);
    content: "";
    opacity: 0;
    transform: translateX(-28%);
    transition: opacity 240ms ease, transform 460ms ease;
  }

  .education-logo-row span:hover,
  .education-logo-row span:focus-within {
    border-color: rgba(174, 112, 255, 0.72);
    background:
      radial-gradient(circle at 50% 0%, rgba(154, 93, 255, 0.16), transparent 58%),
      rgba(154, 93, 255, 0.075);
    box-shadow:
      0 1.1rem 2.35rem rgba(0, 0, 0, 0.3),
      0 0 2.2rem rgba(124, 60, 255, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    opacity: 1;
    transform: translateY(-7px) scale(1.025);
  }

  .education-logo-row span:hover::before,
  .education-logo-row span:focus-within::before {
    opacity: 1;
    transform: translateX(0);
  }

  .education-logo-row img {
    position: relative;
    z-index: 1;
    width: 8.25rem;
    height: 2.35rem;
    max-width: 78%;
    object-fit: contain;
    object-position: center;
    filter: drop-shadow(0 0 0.55rem rgba(255, 255, 255, 0.08));
    transition: transform 240ms ease, filter 240ms ease;
  }

  .education-logo-row span:hover img,
  .education-logo-row span:focus-within img {
    filter: drop-shadow(0 0 1rem rgba(255, 255, 255, 0.24)) drop-shadow(0 0 1.35rem rgba(154, 93, 255, 0.22));
    transform: scale(1.1) rotate(-0.8deg);
  }

