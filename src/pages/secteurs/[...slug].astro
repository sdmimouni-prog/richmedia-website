---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbs } from '../../lib/schema';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('secteurs', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug ?? entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const url = `${SITE.url}/secteurs/${entry.data.slug ?? entry.id}`;
const schema = [breadcrumbs([
  { name: 'Accueil', url: SITE.url },
  { name: 'Secteurs', url: `${SITE.url}/secteurs` },
  { name: entry.data.title, url },
])];
---
<BaseLayout title={entry.data.metaTitle ?? entry.data.title} description={entry.data.metaDescription} canonical={url} schema={schema}>
  <h1>{entry.data.title}</h1>
  <QuickAnswer text={entry.data.quickAnswer} />
  <Content />
  <Faq faq={entry.data.faq} />
</BaseLayout>
