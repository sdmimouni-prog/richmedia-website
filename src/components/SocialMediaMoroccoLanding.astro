---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSiloLinks from './SeoSiloLinks.astro';
import { SITE } from '../consts';
import { breadcrumbs, faqSchema, localBusiness, serviceSchema } from '../lib/schema';

interface Props {
  lang: 'fr' | 'en';
}

const { lang: pageLang } = Astro.props as Props;
const isEnglish = pageLang === 'en';

const pagePath = isEnglish ? '/social-media-management-morocco' : '/gestion-reseaux-sociaux-maroc';
const pageUrl = `${SITE.url}${pagePath}`;
const contactHref = isEnglish ? '/en/contact' : '/contact';
const workHref = isEnglish ? '/en/case-studies' : '/realisations';
const socialMediaHref = isEnglish ? '/en/expertises/social-media-morocco' : '/expertises/social-media-maroc';
const brandContentHref = isEnglish ? '/en/expertises/brand-content' : '/expertises/brand-content';
const influenceHref = isEnglish ? '/influencer-marketing-morocco' : '/marketing-influence-maroc';
const socialListeningHref = isEnglish ? '/en/expertises/social-listening-morocco' : '/expertises/social-listening-maroc';
const mediaHref = isEnglish ? '/en/expertises/media-performance' : '/expertises/media-performance';
const heroImage = '/assets/richmedia-home/campaign-wide-amana-social.webp';
const heroPortrait = '/assets/richmedia-home/optimized/expertise-story-social.webp';

const copy = isEnglish
  ? {
      title: 'Social Media Management in Morocco | Richmedia',
      description:
        'Richmedia manages social media for brands in Morocco through strategy, content creation, community management, moderation, reporting and performance optimisation.',
      h1: 'Social Media Management in Morocco',
      eyebrow: 'Social media management Morocco',
      lead:
        'Richmedia helps brands build stronger social media presence in Morocco through strategy, content creation, community management, moderation and performance optimisation.',
      line: 'Strategy · Content · Community Management · Moderation · Reporting',
      primaryCta: 'Contact the Richmedia team',
      secondaryCta: 'View case studies',
      introTitle: 'Being present on social media is no longer enough',
      introText:
        'Posting regularly is not a strategy. A strong social presence needs audience understanding, an editorial position, platform-native formats, consistency, community engagement, measurement and continuous optimisation.',
      introQuote: 'Every post should have a role: attract, engage, inform, convert or strengthen the brand.',
      approachTitle: 'From social strategy to measurable performance',
      contentTitle: 'Platform-native content, not one-size-fits-all publishing',
      communityTitle: 'Social media is a conversation, not a broadcast channel',
      communityText:
        'Community management covers publishing, moderation, replies, useful interactions, customer feedback and escalation when the scope requires it. The goal is to make the brand present, clear and responsive without promising unrealistic 24/7 support.',
      listeningTitle: 'Listen to the market, not just your own channels',
      listeningText:
        'Social listening can support social media management by monitoring mentions, conversations, emerging topics, competitor signals, reputation and content opportunities.',
      marketTitle: 'Social media in Morocco requires local relevance',
      marketText:
        'Brands operating in Morocco need more than translated content. Social media must respect local culture, multilingual audiences, platform behaviours, Moroccan creators, city-level realities and the expectations people have from brands on mobile-first channels.',
      ugcTitle: 'From brand content to creator content',
      ugcText:
        'Depending on the objective, social media management can connect brand-owned content, creator collaborations, UGC assets and paid media amplification. The point is not to duplicate influencer marketing, but to make each content source play the right role.',
      casesTitle: 'Social content built for real brands',
      whyTitle: 'Why work with Richmedia for social media management in Morocco?',
      internationalTitle: 'Your local social media partner in Morocco',
      internationalText:
        'For international brands operating in Morocco, Richmedia provides local content strategy, platform management, community understanding and campaign execution while respecting global brand guidelines.',
      workflowTitle: 'How we work',
      faqTitle: 'Frequently asked questions about social media management in Morocco',
      finalTitle: 'Looking for a social media agency in Morocco?',
      finalText:
        'Let’s build a social presence designed around your brand, your audience and your business objectives.',
      finalCta: 'Contact the Richmedia team',
      serviceName: 'Social media management in Morocco',
      breadcrumbHome: 'Home',
      breadcrumbName: 'Social Media Management in Morocco',
      siloTitle: 'Connect social media, content and performance',
      siloIntro:
        'Social media management performs better when content, creators, paid media, listening and case studies work together.',
    }
  : {
      title: 'Gestion des réseaux sociaux au Maroc | Richmedia',
      description:
        'Richmedia accompagne les marques dans la gestion de leurs réseaux sociaux au Maroc : stratégie, contenu, community management, modération, reporting et social media performance.',
      h1: 'Gestion des réseaux sociaux au Maroc',
      eyebrow: 'Gestion réseaux sociaux Maroc',
      lead:
        'Richmedia accompagne les marques dans la stratégie, la création de contenu et la gestion quotidienne de leurs réseaux sociaux afin de construire des communautés actives et renforcer leur performance digitale.',
      line: 'Stratégie · Contenu · Community Management · Modération · Reporting',
      primaryCta: 'Contacter l’équipe Richmedia',
      secondaryCta: 'Voir nos cas clients',
      introTitle: 'Être présent sur les réseaux sociaux ne suffit plus',
      introText:
        'Publier régulièrement n’est pas une stratégie. Une présence social media performante repose sur un positionnement éditorial, une compréhension des audiences, des formats adaptés, de la régularité, de l’interaction, de la mesure et une optimisation continue.',
      introQuote: 'Chaque publication doit avoir un rôle : attirer, engager, informer, convertir ou renforcer la marque.',
      approachTitle: 'Une gestion social media de la stratégie à la performance',
      contentTitle: 'Des contenus pensés pour chaque plateforme',
      communityTitle: 'Une marque qui publie. Mais surtout une marque qui répond.',
      communityText:
        'Le community management couvre la publication, les réponses, la modération, les conversations utiles, les retours clients et les remontées d’alertes lorsque le périmètre le prévoit. L’objectif est de rendre la marque présente, claire et réactive, sans promettre un service client 24/7.',
      listeningTitle: 'Écouter les conversations pour mieux piloter la marque',
      listeningText:
        'Le social listening peut compléter la gestion des réseaux sociaux en suivant mentions, conversations, sujets émergents, signaux concurrents, réputation et opportunités de contenu.',
      marketTitle: 'Les réseaux sociaux au Maroc : des usages qui évoluent vite',
      marketText:
        'Au Maroc, les marques doivent adapter leurs contenus aux audiences, aux langues, aux villes, aux références culturelles, aux formats et aux plateformes. Le mobile impose des contenus plus lisibles, plus directs et plus contextualisés, capables de parler aux usages locaux sans perdre la cohérence de marque.',
      ugcTitle: 'Du contenu de marque au contenu créateur',
      ugcText:
        'Selon l’objectif, une stratégie social media peut combiner contenus produits par la marque, influenceurs, créateurs UGC et amplification paid media. L’enjeu n’est pas de dupliquer l’influence, mais de donner à chaque source de contenu le bon rôle.',
      casesTitle: 'Des marques, des contenus, des communautés',
      whyTitle: 'Pourquoi confier vos réseaux sociaux à Richmedia ?',
      internationalTitle: '',
      internationalText: '',
      workflowTitle: 'Comment travaillons-nous ?',
      faqTitle: 'Questions fréquentes sur la gestion des réseaux sociaux au Maroc',
      finalTitle: 'Besoin de mieux gérer vos réseaux sociaux ?',
      finalText:
        'Construisons une présence social media cohérente, créative et orientée performance.',
      finalCta: 'Contacter l’équipe Richmedia',
      serviceName: 'Gestion des réseaux sociaux au Maroc',
      breadcrumbHome: 'Accueil',
      breadcrumbName: 'Gestion des réseaux sociaux au Maroc',
      siloTitle: 'Relier social media, contenu et performance',
      siloIntro:
        'La gestion social media fonctionne mieux lorsqu’elle relie contenu, communautés, influence, média paid et écoute du marché.',
    };

const approachSteps = isEnglish
  ? [
      ['01', 'Strategy', 'Objectives, audiences, positioning, platforms, editorial territories, tone of voice and KPIs.'],
      ['02', 'Editorial planning', 'Content pillars, calendar, key moments, campaigns and relevant activations.'],
      ['03', 'Content creation', 'Posts, carousels, Reels, stories, videos, motion, UGC and brand content.'],
      ['04', 'Community management', 'Publishing, community animation, replies, interactions, moderation and useful alerts.'],
      ['05', 'Paid social amplification', 'Selected content can be amplified to increase reach, engagement, traffic, leads or conversions.'],
      ['06', 'Reporting & optimisation', 'Measurement by objective: reach, impressions, engagement, views, clicks, growth, traffic or leads.'],
    ]
  : [
      ['01', 'Stratégie', 'Objectifs, audiences, positionnement, plateformes, territoires éditoriaux, tonalité et KPI.'],
      ['02', 'Planning éditorial', 'Piliers de contenu, calendrier, temps forts, marronniers pertinents, campagnes et activations.'],
      ['03', 'Création de contenu', 'Posts, carrousels, Reels, stories, vidéos, motion, UGC et contenus de marque.'],
      ['04', 'Community management', 'Publication, animation, réponses, interactions, modération et remontée des signaux utiles.'],
      ['05', 'Amplification paid social', 'Certains contenus peuvent être amplifiés pour augmenter reach, engagement, trafic, leads ou conversions.'],
      ['06', 'Reporting & optimisation', 'Mesure selon les objectifs : reach, impressions, engagement, vues, clics, croissance, trafic ou leads.'],
    ];

const platforms = isEnglish
  ? [
      ['Instagram', 'Brand identity, Reels, stories, carousels and community engagement.'],
      ['TikTok', 'Native formats, rhythm, creators, relevant trends and short storytelling.'],
      ['Facebook', 'Community, brand content, information, activation and paid social.'],
      ['LinkedIn', 'Corporate communication, employer brand, expertise, B2B and thought leadership.'],
      ['YouTube', 'Video, long and short formats, evergreen content when relevant.'],
    ]
  : [
      ['Instagram', 'Identité de marque, Reels, stories, carrousels et engagement communautaire.'],
      ['TikTok', 'Formats natifs, rythme, créateurs, tendances pertinentes et storytelling court.'],
      ['Facebook', 'Communauté, contenus de marque, information, activation et paid social.'],
      ['LinkedIn', 'Communication corporate, marque employeur, expertise, B2B et thought leadership.'],
      ['YouTube', 'Vidéo, formats longs ou courts et contenus evergreen lorsque pertinent.'],
    ];

const workflow = isEnglish
  ? [
      ['01', 'Immersion', 'Brand, market, audiences and business objectives.'],
      ['02', 'Strategy', 'Positioning, platforms, content pillars and KPIs.'],
      ['03', 'Production', 'Planning, creation, review and validation.'],
      ['04', 'Publishing & animation', 'Distribution, community management and moderation.'],
      ['05', 'Measurement', 'Reporting, learnings and optimisation.'],
    ]
  : [
      ['01', 'Immersion', 'Marque, marché, audiences et objectifs.'],
      ['02', 'Stratégie', 'Positionnement, plateformes, piliers de contenu et KPI.'],
      ['03', 'Production', 'Planning, création et validation.'],
      ['04', 'Publication & animation', 'Diffusion, communauté et modération.'],
      ['05', 'Mesure', 'Reporting, apprentissages et optimisation.'],
    ];

const whyCards = isEnglish
  ? [
      ['Strategy-first approach', 'Every content piece belongs to a brand logic, audience need and business objective.'],
      ['Integrated content capabilities', 'Social media, video, creator content, influence and paid media can work together.'],
      ['Moroccan market knowledge', 'We adapt to local audiences, platform behaviours, cities and cultural nuances.'],
      ['Measurable performance', 'Reporting focuses on the KPIs that matter for the objective, not vanity metrics alone.'],
    ]
  : [
      ['Stratégie avant publication', 'Chaque contenu s’inscrit dans une logique de marque, d’audience et d’objectif.'],
      ['Création intégrée', 'Social media, création, vidéo, influence et media peuvent travailler ensemble.'],
      ['Connaissance du marché marocain', 'Nous tenons compte des audiences, usages, villes et spécificités locales.'],
      ['Performance mesurable', 'Le reporting suit les KPI définis, sans réduire le social media aux vanity metrics.'],
    ];

const cases = isEnglish
  ? [
      {
        client: 'Tramway Rabat-Salé',
        image: '/assets/richmedia-realizations/tramway-rabat-sale-community-management-2026-blassty.webp',
        width: 3600,
        height: 1388,
        mission: 'Content creation & Community Management',
        text: 'Editorial planning, Reels, stories, carousels, social care, moderation and reputation monitoring.',
        result: '500K video views, 339K interactions and more than 5K new followers.',
        href: '/en/case-studies/tramway-rabat-sale-community-management-2026',
      },
      {
        client: 'Don Simon',
        image: '/assets/richmedia-home/campaign-wide-donsimon.webp',
        width: 1600,
        height: 900,
        mission: 'Social media campaign',
        text: 'Back-to-school campaign combining social content, video, influence, display and measurable traffic.',
        result: '25M impressions, 2M video views, 200K engagements and 30K clicks.',
        href: '/en/case-studies/don-simon-back-to-school-2025',
      },
      {
        client: 'Nescafé',
        image: '/assets/richmedia-realizations/nescafe-nadi-nescafe.webp',
        width: 1572,
        height: 1162,
        mission: 'Community platform & social activation',
        text: 'Social media, gamification, coupons and field activation connected digital engagement to offline action.',
        result: '100K platform visits, 5K members and 2,500 downloaded or used coupons.',
        href: '/en/case-studies/nescafe-nadi-nescafe-2019',
      },
    ]
  : [
      {
        client: 'Tramway Rabat-Salé',
        image: '/assets/richmedia-realizations/tramway-rabat-sale-community-management-2026-blassty.webp',
        width: 3600,
        height: 1388,
        mission: 'Création de contenu & Community Management',
        text: 'Planning éditorial, Reels, stories, carrousels, social care, modération et veille réputationnelle.',
        result: '500 K vues vidéo, 339 K interactions et plus de 5 K nouveaux abonnés.',
        href: '/realisations/tramway-rabat-sale-community-management-2026',
      },
      {
        client: 'Don Simon',
        image: '/assets/richmedia-home/campaign-wide-donsimon.webp',
        width: 1600,
        height: 900,
        mission: 'Campagne réseaux sociaux',
        text: 'Campagne Back to School combinant social content, vidéo, influence, display et trafic mesurable.',
        result: '25 M impressions, 2 M vues vidéo, 200 K engagements et 30 K clics.',
        href: '/realisations/don-simon-back-to-school-2025',
      },
      {
        client: 'Nescafé',
        image: '/assets/richmedia-realizations/nescafe-nadi-nescafe.webp',
        width: 1572,
        height: 1162,
        mission: 'Plateforme communautaire & activation social media',
        text: 'Social media, gamification, coupons et activation terrain reliaient engagement digital et action offline.',
        result: '100 K visites plateforme, 5 K membres et 2 500 coupons téléchargés ou utilisés.',
        href: '/realisations/nescafe-nadi-nescafe-2019',
      },
    ];

const faq = isEnglish
  ? [
      {
        question: 'What does social media management include?',
        answer:
          'It can include strategy, editorial planning, content creation, publishing, community management, moderation, reporting, optimisation and coordination with paid media or creators depending on the scope.',
      },
      {
        question: 'How much does social media management cost in Morocco?',
        answer:
          'Cost depends on the number of platforms, posting frequency, content volume, video production, moderation scope, languages, paid media, reporting and the level of support required. A useful quote needs a brief.',
      },
      {
        question: 'Which social platforms should brands use in Morocco?',
        answer:
          'The choice depends on the audience, brand role, content resources and objective. Instagram, TikTok, Facebook, LinkedIn and YouTube do not serve the same purpose or require the same format.',
      },
      {
        question: 'What is the difference between social media management and community management?',
        answer:
          'Social media management covers the broader strategy, content and performance system. Community management focuses more specifically on publishing, replies, interactions, moderation and community signals.',
      },
      {
        question: 'Can Richmedia create and publish social content?',
        answer:
          'Yes. Richmedia can work on editorial strategy, content creation, visuals, Reels, stories, carousels, calendars, validation workflows and publishing according to the agreed scope.',
      },
      {
        question: 'How is social media performance measured?',
        answer:
          'Measurement can include reach, impressions, engagement quality, video views, clicks, traffic, follower growth, messages, assisted conversions, leads and creative learnings depending on the objective.',
      },
    ]
  : [
      {
        question: 'Que comprend la gestion des réseaux sociaux ?',
        answer:
          'Elle peut inclure stratégie, planning éditorial, création de contenu, publication, community management, modération, reporting, optimisation et coordination avec le paid media ou les créateurs selon le périmètre.',
      },
      {
        question: 'Combien coûte la gestion des réseaux sociaux au Maroc ?',
        answer:
          'Le coût dépend du nombre de plateformes, de la fréquence, du volume de contenus, de la production vidéo, de la modération, des langues, du paid media, du reporting et du niveau d’accompagnement. Un prix utile nécessite un brief.',
      },
      {
        question: 'Quels réseaux sociaux faut-il privilégier pour une marque au Maroc ?',
        answer:
          'Le choix dépend de la cible, du rôle de la marque, des ressources de contenu et de l’objectif. Instagram, TikTok, Facebook, LinkedIn et YouTube n’ont pas le même rôle ni les mêmes formats.',
      },
      {
        question: 'Quelle est la différence entre social media management et community management ?',
        answer:
          'Le social media management couvre la stratégie, le contenu et la performance globale. Le community management se concentre davantage sur publication, réponses, interactions, modération et signaux communautaires.',
      },
      {
        question: 'Richmedia peut-elle créer les contenus et gérer leur publication ?',
        answer:
          'Oui. Richmedia peut travailler la stratégie éditoriale, les visuels, Reels, stories, carrousels, calendriers, workflows de validation et publication selon le périmètre défini.',
      },
      {
        question: 'Comment mesurer les performances des réseaux sociaux ?',
        answer:
          'La mesure peut inclure reach, impressions, qualité d’engagement, vues vidéo, clics, trafic, croissance, messages, conversions assistées, leads et apprentissages créatifs selon l’objectif.',
      },
    ];

const schema = [
  localBusiness(),
  serviceSchema({
    name: copy.serviceName,
    description: copy.description,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: copy.breadcrumbHome, url: isEnglish ? `${SITE.url}/en` : SITE.url },
    { name: isEnglish ? 'Expertise' : 'Expertises', url: isEnglish ? `${SITE.url}/en/expertises` : `${SITE.url}/expertises` },
    { name: copy.breadcrumbName, url: pageUrl },
  ]),
];

const siloLinks = isEnglish
  ? [
      { href: socialMediaHref, label: 'Social Media Morocco', text: 'Explore the service page for social strategy and community management.' },
      { href: brandContentHref, label: 'Brand content', text: 'Build social-first content, short-form video and creative assets.' },
      { href: influenceHref, label: 'Influencer marketing in Morocco', text: 'Connect social content to creators, UGC and amplification.' },
      { href: socialListeningHref, label: 'Social listening', text: 'Turn public conversations into useful market signals.' },
      { href: mediaHref, label: 'Media & Performance', text: 'Amplify content through paid social and performance campaigns.' },
      { href: workHref, label: 'Case studies', text: 'See real social and content campaigns.' },
      { href: contactHref, label: 'Contact Richmedia', text: 'Frame your social media management scope.' },
    ]
  : [
      { href: socialMediaHref, label: 'Social Media Maroc', text: 'Explorer la page service stratégie social media et community management.' },
      { href: brandContentHref, label: 'Brand content', text: 'Créer des contenus social-first, vidéos courtes et assets créatifs.' },
      { href: influenceHref, label: 'Marketing d’influence au Maroc', text: 'Relier social content, créateurs, UGC et amplification.' },
      { href: socialListeningHref, label: 'Social Listening Maroc', text: 'Transformer les conversations publiques en signaux utiles.' },
      { href: mediaHref, label: 'Media & Performance', text: 'Amplifier les contenus via paid social et campagnes de performance.' },
      { href: workHref, label: 'Réalisations', text: 'Voir des campagnes social media et contenu réelles.' },
      { href: contactHref, label: 'Contacter Richmedia', text: 'Cadrer votre périmètre de gestion social media.' },
    ];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={pageUrl}
  ogImage={`${SITE.url}${heroImage}`}
  schema={schema}
  lang={pageLang}
>
  <div class="social-market-page">
    <section class="social-hero" aria-labelledby="social-hero-title">
      <div class="hero-copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1 id="social-hero-title">{copy.h1}</h1>
        <p>{copy.lead}</p>
        <div class="hero-line" aria-label={isEnglish ? 'Social media scope' : 'Périmètre social media'}>
          {copy.line.split(' · ').map((item) => <span>{item}</span>)}
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href={contactHref}>
            {copy.primaryCta}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href={workHref}>
            {copy.secondaryCta}
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-board" aria-label={isEnglish ? 'Richmedia social media visuals' : 'Visuels social media Richmedia'}>
        <figure class="hero-main-card">
          <img
            src={heroImage}
            alt={isEnglish ? 'Richmedia social media campaign visual for Amana' : 'Visuel campagne social media Amana par Richmedia'}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
        <figure class="hero-portrait-card">
          <img
            src={heroPortrait}
            alt={isEnglish ? 'Social-first content story visual' : 'Visuel story de contenu social-first'}
            width="560"
            height="996"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="hero-signal signal-a">
          <span>{isEnglish ? 'Planning' : 'Planning'}</span>
          <strong>{isEnglish ? 'Editorial rhythm' : 'Rythme éditorial'}</strong>
        </div>
        <div class="hero-signal signal-b">
          <span>{isEnglish ? 'Community' : 'Communauté'}</span>
          <strong>{isEnglish ? 'Replies, care, alerts' : 'Réponses, care, alertes'}</strong>
        </div>
        <div class="social-mini-feed" aria-hidden="true">
          {[
            ['/assets/richmedia-case-study/proof-social-feed.webp', '369', '444'],
            ['/assets/richmedia-home/optimized/influence-reels-reel-01.webp', '255', '404'],
            ['/assets/richmedia-home/optimized/influence-reels-reel-02.webp', '255', '404'],
          ].map(([src, width, height]) => (
            <img src={src} alt="" width={width} height={height} loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
    </section>

    <section class="market-intro" aria-labelledby="intro-title">
      <div>
        <span class="eyebrow">{isEnglish ? 'Point of view' : 'Point de vue'}</span>
        <h2 id="intro-title">{copy.introTitle}</h2>
      </div>
      <div>
        <p>{copy.introText}</p>
        <blockquote>{copy.introQuote}</blockquote>
      </div>
    </section>

    <section class="process-section" aria-labelledby="approach-title">
      <div class="section-heading">
        <span class="eyebrow">{isEnglish ? 'Method' : 'Méthode'}</span>
        <h2 id="approach-title">{copy.approachTitle}</h2>
      </div>
      <div class="process-grid">
        {approachSteps.map(([step, title, text]) => (
          <article>
            <span>{step}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="visual-strip" aria-label={isEnglish ? 'Social content examples' : 'Exemples de contenus social media'}>
      {[
        ['/assets/richmedia-realizations/tramway-rabat-sale-community-management-2026-summer.webp', 'Tramway Rabat-Salé', '1080', '1350'],
        ['/assets/richmedia-case-study/don-simon-back-to-school-2025/don-simon-proof-social-feed.webp', 'Don Simon', '1254', '1254'],
        ['/assets/richmedia-realizations/moul-pounj-carousel.webp', 'Moul Pounj', '1133', '513'],
        ['/assets/richmedia-sector-fmcg/campaigns/brand-content-social-first.webp', 'Brand content social-first', '1280', '720'],
      ].map(([src, label, width, height]) => (
        <figure>
          <img src={src} alt={label} width={width} height={height} loading="lazy" decoding="async" />
          <figcaption>{label}</figcaption>
        </figure>
      ))}
    </section>

    <section class="platform-section" aria-labelledby="platform-title">
      <div class="section-heading">
        <span class="eyebrow">{isEnglish ? 'Content creation' : 'Création de contenu'}</span>
        <h2 id="platform-title">{copy.contentTitle}</h2>
      </div>
      <div class="platform-grid">
        {platforms.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="split-section" aria-labelledby="community-title">
      <article class="split-card">
        <span class="eyebrow">Community management</span>
