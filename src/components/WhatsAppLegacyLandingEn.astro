              <article class="story-card story-card-04">
                <div class="story-progress" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                <div class="story-meta">
                  <img src="/assets/richmedia-whatsapp-lp/story-avatar.png" alt="" width="36" height="36" loading="lazy" decoding="async" />
