---
import '../styles/whatsapp-legacy.css';
---

<div class="page whatsapp-legacy-scope">
  <section class="hero" aria-label="Richmedia WhatsApp Marketing">
          <div class="hero-frame">
            <div class="hero-bg"></div>
            <div class="purple-glow glow-left"></div>
            <div class="purple-glow glow-right"></div>
            <div class="light-lines"></div>
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
  
            <div class="hero-kicker">WhatsApp Marketing Platform</div>
  
            <h1 class="hero-title">
              <span>Reach.</span>
              <span>Engage.</span>
              <span class="purple-text">Convert.</span>
            </h1>
  
            <p class="hero-copy">
              The most powerful WhatsApp marketing channel in Morocco,<br />
              powered by Richmedia data.
            </p>
  
            <div class="benefits" aria-label="Benefits">
              <div class="benefit"><span>✓</span>+18M qualified profiles</div>
              <div class="benefit"><span>✓</span>Chatbots &amp; conversations</div>
              <div class="benefit"><span>✓</span>+90% open rate</div>
              <div class="benefit"><span>✓</span>CNDP compliant</div>
              <div class="benefit"><span>✓</span>Up to 42% click-through rate</div>
              <div class="benefit"><span>✓</span>Real-time statistics</div>
            </div>
  
            <div class="hero-actions">
              <a class="primary-btn" href="#references">
                Discover our offers
                <span aria-hidden="true">→</span>
              </a>
              <a
                class="secondary-btn"
                href="tel:+212661172885"
                aria-label="Call Richmedia at +212 661 17 28 85 to request a demo"
              >Request a demo</a>
            </div>
  
            <div class="phone-mockup" aria-label="Preview of a Marjane Morocco WhatsApp conversation">
              <img
                class="phone"
                src="/assets/richmedia-whatsapp-lp/phone-marjane-nobadge.webp"
                alt="" width="370" height="789" loading="eager" decoding="async" fetchpriority="high" />
              <div class="phone-chat-layer" aria-hidden="true">
                <div class="phone-chat-stack">
                  <div class="phone-date-chip phone-chat-item">Yesterday</div>
                  <article class="phone-message-card phone-chat-item">
                    <img src="/assets/richmedia-whatsapp-lp/hero-whatsapp-promo.webp" alt="" width="285" height="170" loading="eager" decoding="async" />
                    <div class="phone-message-copy">
                      <strong>🔥 Summer sales are here!</strong>
                      <p>
                        Up to -50% on a selection of products
                        just for your <span>Marjane</span> store.
                      </p>
                      <a href="#offers">🛒 Find the nearest store</a>
                      <b>⭐ View offers <small>11:30</small></b>
                    </div>
                  </article>
                  <div class="phone-reply phone-chat-item">I want to benefit!</div>
                  <div class="phone-reply phone-chat-item">View catalog <small>11:30</small></div>
                  <div class="phone-reply phone-chat-item">Find a store <small>11:30</small></div>
                </div>
              </div>
              <img class="whatsapp-badge" src="/assets/richmedia-whatsapp-lp/whatsapp-official-clean.svg" alt="" width="175" height="176" loading="eager" decoding="async" />
            </div>
  
            <article class="stat-card stat-open">
              <div class="stat-icon">◉</div>
              <div class="stat-label">Open rate</div>
              <div class="stat-value metric-number" data-count-to="90" data-prefix="+" data-suffix="%">+90%</div>
              <svg class="stat-chart" viewBox="0 0 74 52" aria-hidden="true">
                <path d="M4 45 C14 43 14 19 24 19 C34 19 34 33 44 31 C54 29 60 10 70 6" />
                <circle cx="70" cy="6" r="4" />
              </svg>
            </article>
  
            <article class="stat-card stat-clicks">
              <div class="stat-icon">⌁</div>
              <div class="stat-label">Click-through rate</div>
              <div class="stat-sub">up to</div>
              <div class="stat-value metric-number" data-count-to="42" data-suffix="%">42%</div>
              <svg class="stat-chart purple-chart" viewBox="0 0 74 52" aria-hidden="true">
                <path d="M4 45 C14 43 14 19 24 19 C34 19 34 33 44 31 C54 29 60 10 70 6" />
                <circle cx="70" cy="6" r="4" />
              </svg>
            </article>
  
            <article class="stat-card stat-profiles">
              <div class="profiles-icon">♙</div>
              <div class="profiles-value metric-number" data-count-to="18" data-suffix="M+">18M+</div>
              <div class="profiles-label">Qualified profiles</div>
            </article>
          </div>
        </section>
  
        <span id="offers" class="legacy-anchor" aria-hidden="true"></span>
        <section id="references" class="references-block" aria-label="Richmedia references">
          <div class="references-shell">
            <div class="references-intro">
              <img class="references-people" src="/assets/richmedia-whatsapp-lp/ref-people.png" alt="" width="44" height="45" loading="lazy" decoding="async" />
              <span class="references-divider" aria-hidden="true"></span>
              <p>Already adopted by <strong>+250 brands</strong> in Morocco</p>
            </div>
  
            <div class="references-logo-window" aria-label="Client brands">
              <div class="references-logo-track">
                <div class="reference-logo-item">
                  <img class="reference-logo logo-carrefour" src="/assets/richmedia-whatsapp-lp/logo-carrefour.png" alt="Carrefour" width="205" height="50" loading="lazy" decoding="async" />
                </div>
                <div class="reference-logo-item">
                  <img class="reference-logo logo-marjane" src="/assets/richmedia-whatsapp-lp/logo-marjane.png" alt="Marjane" width="170" height="54" loading="lazy" decoding="async" />
                </div>
                <div class="reference-logo-item">
                  <img class="reference-logo logo-electroplanet" src="/assets/richmedia-whatsapp-lp/logo-electroplanet.png" alt="Electroplanet" width="160" height="64" loading="lazy" decoding="async" />
                </div>
                <div class="reference-logo-item">
                  <img class="reference-logo logo-dolidol" src="/assets/richmedia-whatsapp-lp/logo-dolidol.png" alt="Dolidol" width="155" height="52" loading="lazy" decoding="async" />
                </div>
                <div class="reference-logo-item">
                  <img class="reference-logo logo-afriquia" src="/assets/richmedia-whatsapp-lp/logo-afriquia.png" alt="Afriquia" width="155" height="67" loading="lazy" decoding="async" />
                </div>
                <div class="reference-logo-item reference-brand-lockup">
                  <img class="reference-logo-symbol" src="/assets/richmedia-whatsapp-lp/logo-maserati.svg" alt="" width="24" height="24" loading="lazy" decoding="async" />
                  <span>Maserati</span>
                </div>
                <div class="reference-logo-item reference-brand-lockup">
                  <img class="reference-logo-symbol" src="/assets/richmedia-whatsapp-lp/logo-glovo.svg" alt="" width="24" height="24" loading="lazy" decoding="async" />
                  <span>Glovo</span>
                </div>
              </div>
            </div>
  
          </div>
