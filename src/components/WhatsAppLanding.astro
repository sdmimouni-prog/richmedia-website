  }

  .kpi-pill {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.3rem 0.8rem;
    min-width: 12rem;
    padding: 0.85rem;
  }

  .kpi-pill span,
  .message-orbit > span,
  .message-orbit small {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .kpi-pill strong {
    color: #fff;
    font-size: 1.85rem;
    line-height: 1;
  }

  .kpi-pill i {
    align-self: end;
    color: var(--green);
    font-size: 1.75rem;
  }

  .kpi-open {
    top: 18%;
    right: 1%;
  }

  .kpi-click {
    bottom: 18%;
    left: 2%;
  }

  .message-orbit {
    right: 12%;
    bottom: 7%;
    display: grid;
    gap: 0.45rem;
    width: 17rem;
    padding: 0.75rem;
  }

  .message-orbit article {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
    border-radius: 7px;
    padding: 0.48rem;
    background: rgba(255, 255, 255, 0.055);
  }

  .message-orbit i {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(17, 200, 120, 0.14);
    color: var(--green);
  }

  .message-orbit strong {
    overflow: hidden;
    color: #fff;
    font-size: 0.86rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-band {
    padding-block: 3.8rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .section-intro {
    display: grid;
    gap: 0.75rem;
    max-width: 720px;
  }

  .section-intro.compact {
    max-width: 640px;
  }

  .section-intro h2,
  .use-case-band h2,
  .dashboard-copy h2,
  .final-cta h2 {
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.04;
  }

  .section-intro p,
  .dashboard-copy p,
  .final-cta p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .benefits-band {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 0.85rem;
  }

  .benefits-band::before {
    position: absolute;
    inset: 1.4rem 0 auto;
    height: 17rem;
    content: '';
    background:
      radial-gradient(circle at 14% 28%, rgba(124, 60, 255, 0.24), transparent 18rem),
      radial-gradient(circle at 78% 18%, rgba(17, 200, 120, 0.18), transparent 16rem);
    pointer-events: none;
  }

  .benefit-impact,
  .benefit-grid {
    position: relative;
    z-index: 1;
  }

  .benefit-impact {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 1.08fr);
    gap: 1rem;
    align-items: stretch;
  }

  .benefit-copy {
    max-width: none;
    min-height: 22rem;
    align-content: center;
    border: 1px solid rgba(169, 133, 255, 0.2);
    border-radius: 8px;
    padding: clamp(1rem, 3vw, 2rem);
    background:
      linear-gradient(135deg, rgba(124, 60, 255, 0.18), transparent 62%),
      rgba(255, 255, 255, 0.035);
  }

  .benefit-scoreboard {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .benefit-scoreboard article {
    min-height: 6.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.85rem;
    background: rgba(3, 4, 7, 0.58);
  }

  .benefit-scoreboard strong {
    display: block;
    color: #fff;
    font-size: clamp(1.45rem, 2.5vw, 2.15rem);
    line-height: 1;
  }

  .benefit-scoreboard span {
    display: block;
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.25;
  }

  .benefit-cockpit {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
    display: grid;
    align-content: space-between;
    gap: 0.9rem;
    border: 1px solid rgba(17, 200, 120, 0.18);
    border-radius: 8px;
    padding: clamp(1rem, 2vw, 1.35rem);
    background:
      radial-gradient(circle at 14% 22%, rgba(17, 200, 120, 0.25), transparent 11rem),
      radial-gradient(circle at 82% 4%, rgba(124, 60, 255, 0.34), transparent 16rem),
      linear-gradient(145deg, rgba(17, 200, 120, 0.1), rgba(124, 60, 255, 0.08) 52%, transparent),
      rgba(255, 255, 255, 0.028);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.035);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .benefit-cockpit::before {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(140deg, rgba(0, 0, 0, 0.78), transparent 82%);
    pointer-events: none;
  }

  .benefit-cockpit::after {
    position: absolute;
    top: 16%;
    right: -6rem;
    width: 18rem;
    height: 18rem;
    content: '';
    border: 1px solid rgba(124, 60, 255, 0.28);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 60, 255, 0.13), transparent 64%);
  }

  .cockpit-topline,
  .cockpit-funnel,
  .cockpit-chat,
  .cockpit-bars {
    position: relative;
    z-index: 1;
  }

  .cockpit-topline {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .cockpit-topline span {
    color: var(--green);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .cockpit-topline strong {
    color: #fff;
    font-size: clamp(2.35rem, 5vw, 4.4rem);
    line-height: 0.86;
    text-shadow: 0 0 2rem rgba(17, 200, 120, 0.18);
  }

  .cockpit-funnel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .cockpit-funnel article {
    display: grid;
    gap: 0.35rem;
    min-height: 5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.72rem;
    background: rgba(3, 4, 7, 0.62);
    box-shadow: 0 1rem 2.2rem rgba(0, 0, 0, 0.18);
    transform: translateY(calc(var(--step) * 0.28rem));
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .cockpit-funnel span,
  .cockpit-chat span,
  .cockpit-bars span {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cockpit-funnel strong {
    color: #fff;
    font-size: 1.28rem;
    line-height: 1;
  }

  .cockpit-chat {
    display: grid;
    gap: 0.55rem;
    max-width: 70%;
    margin-left: auto;
  }

  .cockpit-chat article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    min-height: 3.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.62rem 0.75rem;
    background: rgba(3, 4, 7, 0.7);
    box-shadow: 0 1rem 2.4rem rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(16px);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .cockpit-chat article:nth-child(1) {
    margin-right: 2.4rem;
  }

  .cockpit-chat article:nth-child(3) {
    margin-right: 4.8rem;
  }

  .cockpit-chat .is-highlight {
    margin-left: -2.6rem;
    border-color: rgba(17, 200, 120, 0.34);
    background: rgba(17, 200, 120, 0.11);
  }

  .cockpit-chat i {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 8px;
    background: rgba(17, 200, 120, 0.13);
    color: var(--green);
    font-size: 1.05rem;
  }

  .cockpit-chat strong {
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
  }

  .cockpit-bars {
    display: grid;
    gap: 0.5rem;
    width: min(100%, 24rem);
  }

  .cockpit-bars article {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr) 3.2rem;
    gap: 0.55rem;
    align-items: center;
  }

  .cockpit-bars i {
    display: block;
    height: 0.42rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }

  .cockpit-bars i::before {
    display: block;
    width: var(--bar);
    height: 100%;
    content: '';
    border-radius: inherit;
    background: linear-gradient(90deg, var(--green), var(--purple-2));
  }

  .cockpit-bars strong {
    color: #fff;
    font-size: 0.92rem;
    line-height: 1;
    text-align: right;
  }

  .benefit-cockpit:hover,
  .benefit-cockpit:focus-within {
    border-color: rgba(17, 200, 120, 0.34);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.045),
      0 1.4rem 3rem rgba(0, 0, 0, 0.22);
    transform: translateY(-0.25rem);
  }

  .benefit-cockpit:hover .cockpit-funnel article,
  .benefit-cockpit:focus-within .cockpit-funnel article {
    border-color: rgba(17, 200, 120, 0.28);
    background: rgba(17, 200, 120, 0.09);
    transform: translateY(calc(var(--step) * 0.28rem - 0.24rem));
  }

  .benefit-cockpit:hover .cockpit-chat article,
  .benefit-cockpit:focus-within .cockpit-chat article {
    transform: translateX(-0.25rem);
  }

  .benefit-cockpit:hover .cockpit-chat .is-highlight,
  .benefit-cockpit:focus-within .cockpit-chat .is-highlight {
    transform: translateX(-0.65rem);
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .benefit-grid article {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-height: 15rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    padding: 1rem;
    background:
      linear-gradient(180deg, rgba(17, 200, 120, 0.1), transparent 58%),
      rgba(255, 255, 255, 0.04);
    transform: translateY(calc(var(--index) * 0.35rem));
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .benefit-grid article::after {
    position: absolute;
    right: -2rem;
    bottom: -2.5rem;
    width: 9rem;
    height: 9rem;
    content: '';
    border-radius: 50%;
    background: rgba(124, 60, 255, 0.18);
    filter: blur(18px);
  }

  .benefit-grid article:hover,
  .benefit-grid article:focus-within {
    transform: translateY(calc(var(--index) * 0.35rem - 0.35rem));
    border-color: rgba(17, 200, 120, 0.36);
    background:
      linear-gradient(180deg, rgba(17, 200, 120, 0.15), transparent 58%),
      rgba(255, 255, 255, 0.06);
    box-shadow: 0 1.3rem 3rem rgba(0, 0, 0, 0.24);
  }

  .benefit-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .benefit-card-top i {
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgba(17, 200, 120, 0.34);
    border-radius: 8px;
    background: rgba(17, 200, 120, 0.1);
    color: var(--green);
    font-size: 1.35rem;
  }

  .benefit-card-top span {
    color: rgba(255, 255, 255, 0.28);
    font-size: 2.15rem;
    font-weight: 900;
    line-height: 1;
  }

  .benefit-grid h3,
  .offer-grid h3 {
    color: #fff;
    font-size: 1.05rem;
    line-height: 1.16;
  }

  .benefit-grid p,
  .offer-grid p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .benefit-meter {
    height: 0.44rem;
    overflow: hidden;
    align-self: end;
    margin-top: auto;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }

  .benefit-meter i {
    display: block;
    width: var(--level);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--green), var(--purple-2));
  }

  .offers-band {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .offers-band::before {
    position: absolute;
    top: 4rem;
    right: -12rem;
    width: 32rem;
    height: 32rem;
    content: '';
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(17, 200, 120, 0.16), transparent 58%),
      radial-gradient(circle, rgba(124, 60, 255, 0.12), transparent 70%);
    pointer-events: none;
  }

  .offers-head,
  .offer-grid {
    position: relative;
    z-index: 1;
  }

  .offers-head {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(420px, 1.18fr);
    gap: 1rem;
    align-items: end;
  }

  .offers-route {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.55rem;
    background:
      linear-gradient(135deg, rgba(17, 200, 120, 0.09), rgba(124, 60, 255, 0.08)),
      rgba(255, 255, 255, 0.032);
  }

  .offers-route article {
    position: relative;
    display: grid;
    gap: 0.3rem;
    min-height: 5.6rem;
    align-content: space-between;
    border-radius: 8px;
    padding: 0.8rem;
    background: rgba(3, 4, 7, 0.62);
  }

  .offers-route article:not(:last-child)::after {
    position: absolute;
    top: 50%;
    right: -0.72rem;
    z-index: 2;
    width: 0.9rem;
    height: 1px;
    content: '';
    background: var(--green);
  }

  .offers-route span,
  .offer-index {
    color: rgba(255, 255, 255, 0.32);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .offers-route strong {
    color: #fff;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .offers-route em {
    color: var(--green);
    font-size: 1.35rem;
    font-style: normal;
    font-weight: 900;
    line-height: 1;
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .offer-card {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: start;
    gap: 0.85rem;
    min-height: 22rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 1rem;
    background:
      radial-gradient(circle at 18% 18%, rgba(17, 200, 120, 0.16), transparent 12rem),
      radial-gradient(circle at 100% 0%, rgba(124, 60, 255, 0.2), transparent 13rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.025));
    transform: translateY(calc(var(--offer-index) * 0.45rem));
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .offer-card::before {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.86), transparent 78%);
    pointer-events: none;
  }

  .offer-card:hover,
  .offer-card:focus-within {
    border-color: rgba(17, 200, 120, 0.34);
    box-shadow: 0 1.3rem 3rem rgba(0, 0, 0, 0.24);
    transform: translateY(calc(var(--offer-index) * 0.45rem - 0.35rem));
  }

  .offer-card > * {
    position: relative;
    z-index: 1;
  }

  .offer-index {
    position: absolute;
    top: 0.7rem;
    left: 0.85rem;
    z-index: 0;
    color: rgba(255, 255, 255, 0.055);
    font-size: 7.4rem;
    line-height: 1;
  }

  .offer-card-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .offer-badge {
    border: 1px solid rgba(169, 133, 255, 0.42);
    border-radius: 999px;
    padding: 0.32rem 0.55rem;
    color: var(--purple-2);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .offer-card-top strong {
    display: grid;
    gap: 0.24rem;
    color: var(--green);
    font-size: 1.65rem;
    line-height: 1;
    text-align: right;
  }

  .offer-card-top small {
    max-width: 9rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .offer-visual {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    min-height: 5.1rem;
  }

  .offer-visual > i {
    display: inline-grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 1px solid rgba(17, 200, 120, 0.34);
    border-radius: 8px;
    background: rgba(17, 200, 120, 0.12);
    color: var(--green);
    font-size: 1.65rem;
    box-shadow: 0 0 2rem rgba(17, 200, 120, 0.12);
  }

  .offer-visual div {
    display: grid;
    gap: 0.45rem;
  }

  .offer-visual span {
    display: block;
    height: 0.52rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
  }

  .offer-visual span::before {
    display: block;
    width: var(--offer-level);
    height: 100%;
    content: '';
    border-radius: inherit;
    background: linear-gradient(90deg, var(--green), var(--purple-2));
  }

  .offer-visual span:nth-child(2)::before {
    width: calc(var(--offer-level) - 14%);
  }

  .offer-visual span:nth-child(3)::before {
    width: calc(var(--offer-level) - 26%);
  }

  .offer-card h3 {
    color: #fff;
    font-size: clamp(1.18rem, 2vw, 1.55rem);
    line-height: 1.08;
  }

  .offer-card p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .offer-sequence {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .offer-sequence span {
    display: grid;
    gap: 0.3rem;
    min-height: 4.2rem;
    align-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.62rem;
    background: rgba(3, 4, 7, 0.42);
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.72rem;
    font-weight: 850;
    line-height: 1.15;
  }

  .offer-sequence small {
    color: var(--green);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .offer-grid ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding: 0;
    list-style: none;
  }

  .offer-grid li {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.38rem 0.58rem;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .offer-grid li i {
    color: var(--green);
  }

  .offer-progress {
    height: 0.48rem;
    overflow: hidden;
    align-self: end;
    margin-top: auto;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
  }

  .offer-progress i {
    display: block;
    width: var(--offer-level);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--green), var(--purple-2));
  }

  .use-case-band {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    align-items: start;
    padding-block: 3.8rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .use-case-band > div:first-child {
    display: grid;
    gap: 0.75rem;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .case-grid span {
    display: flex;
