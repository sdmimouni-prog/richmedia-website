---
import ProductLogo from './ProductLogo.astro';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

const platformUrl = 'https://richmedia-whatsapp.vercel.app/#offers';
const phoneUrl = 'tel:+212661172885';

const content = {
  fr: {
    eyebrow: 'Plateforme WhatsApp Marketing',
    title: ['Touchez.', 'Engagez.', 'Convertissez.'],
    intro:
      'La solution Richmedia WhatsApp pour diffuser vos offres, qualifier vos leads et piloter la performance en temps réel.',
    primaryCta: 'Demander une démo',
    secondaryCta: 'Voir les cas d’usage',
    platformCta: 'Visiter la plateforme',
    highlights: [
      '+18M de profils qualifiés',
      '+90% de taux d’ouverture',
      'Jusqu’à 42% de taux de clics',
      'Chatbots & conversations',
      'Conforme CNDP',
      'Statistiques en temps réel',
    ],
    stats: [
      { value: '+90%', label: 'taux d’ouverture' },
      { value: '42%', label: 'taux de clics possible' },
      { value: '18M+', label: 'profils activables' },
      { value: '250+', label: 'marques accompagnées' },
    ],
    visualLabel: 'Campagne WhatsApp',
    visualTitle: 'Du push à la conversation.',
    visualText:
      'Chaque message devient une porte d’entrée vers une offre, un conseiller, un catalogue ou un scénario automatisé.',
    benefitsTitle: 'Pourquoi WhatsApp performe',
    benefitsText: 'Un canal direct, mesurable et pensé pour l’action rapide.',
    benefits: [
      {
        icon: 'ph-chart-line-up',
        title: 'Performance immédiate',
        text: 'Vos offres arrivent dans un canal consulté plusieurs fois par jour.',
      },
      {
        icon: 'ph-users-three',
        title: 'Ciblage data',
        text: 'Segmentation par audience, intérêt, zone et intention commerciale.',
      },
      {
        icon: 'ph-chat-circle-dots',
        title: 'Conversation utile',
        text: 'Réponses, boutons, qualification et scénarios chatbot dans le même parcours.',
      },
      {
        icon: 'ph-shield-check',
        title: 'Cadre maîtrisé',
        text: 'Activation conforme, suivi des consentements et reporting clair.',
      },
    ],
    offersTitle: 'Trois façons d’activer WhatsApp',
    offersText: 'Des formats lisibles pour lancer, amplifier ou automatiser.',
    offers: [
      {
        badge: 'Launch',
        title: 'Campagne push',
        text: 'Diffusion d’une offre à une audience qualifiée avec tracking complet.',
        metric: '48h',
        items: ['Ciblage', 'Créa message', 'Reporting'],
      },
      {
        badge: 'Boost',
        title: 'Push + relances',
        text: 'Séquences courtes pour transformer l’intérêt en clic, lead ou visite.',
        metric: '+ROAS',
        items: ['Relance', 'A/B test', 'Optimisation'],
      },
      {
        badge: 'Flow',
        title: 'Conversation & chatbot',
        text: 'Scénarios automatisés pour qualifier, orienter et réengager.',
        metric: '24/7',
        items: ['Bot', 'CRM', 'Conseiller'],
      },
    ],
    casesTitle: 'Cas d’usage prêts à lancer',
    cases: [
      'Retail & e-commerce',
      'Banques & assurance',
      'Automobile',
      'Immobilier',
      'Événementiel',
      'Tourisme & loisirs',
    ],
    dashboardTitle: 'Suivez ce qui compte',
    dashboardText:
      'Ouvertures, clics, réponses, audience et coût par action sont visibles dans une lecture simple pour décider vite.',
    dashboard: [
      { label: 'Ouvertures', value: '91%', tone: 'green' },
      { label: 'Clics', value: '38%', tone: 'purple' },
      { label: 'Réponses', value: '12K', tone: 'cyan' },
      { label: 'CPA', value: '-24%', tone: 'amber' },
    ],
    finalTitle: 'Explorez la plateforme WhatsApp complète.',
    finalText:
      'Découvrez les offres, les fonctionnalités et les exemples de campagnes sur la plateforme dédiée Richmedia WhatsApp.',
  },
  en: {
    eyebrow: 'WhatsApp Marketing Platform',
    title: ['Reach.', 'Engage.', 'Convert.'],
    intro:
      'The Richmedia WhatsApp solution to broadcast offers, qualify leads and monitor performance in real time.',
    primaryCta: 'Request a demo',
    secondaryCta: 'View use cases',
    platformCta: 'Visit the platform',
    highlights: [
      '18M+ qualified profiles',
      '90%+ open rate',
      'Up to 42% click-through rate',
      'Chatbots & conversations',
      'CNDP compliant',
      'Real-time statistics',
    ],
    stats: [
      { value: '90%+', label: 'open rate' },
      { value: '42%', label: 'possible click rate' },
      { value: '18M+', label: 'activable profiles' },
      { value: '250+', label: 'brands supported' },
    ],
    visualLabel: 'WhatsApp campaign',
    visualTitle: 'From push to conversation.',
    visualText:
      'Every message becomes an entry point to an offer, advisor, catalogue or automated journey.',
    benefitsTitle: 'Why WhatsApp performs',
    benefitsText: 'A direct, measurable channel built for fast action.',
    benefits: [
      {
        icon: 'ph-chart-line-up',
        title: 'Immediate performance',
        text: 'Your offers land in a channel people check several times a day.',
      },
      {
        icon: 'ph-users-three',
        title: 'Data targeting',
        text: 'Segment by audience, interest, location and commercial intent.',
      },
      {
        icon: 'ph-chat-circle-dots',
        title: 'Useful conversations',
        text: 'Replies, buttons, qualification and chatbot journeys in one path.',
      },
      {
        icon: 'ph-shield-check',
        title: 'Controlled framework',
        text: 'Compliant activation, consent tracking and clear reporting.',
      },
    ],
    offersTitle: 'Three ways to activate WhatsApp',
    offersText: 'Clear formats to launch, amplify or automate.',
    offers: [
      {
        badge: 'Launch',
        title: 'Push campaign',
        text: 'Broadcast an offer to a qualified audience with complete tracking.',
        metric: '48h',
        items: ['Targeting', 'Message creative', 'Reporting'],
      },
      {
        badge: 'Boost',
        title: 'Push + follow-ups',
        text: 'Short sequences to turn interest into clicks, leads or visits.',
        metric: '+ROAS',
        items: ['Follow-up', 'A/B test', 'Optimization'],
      },
      {
        badge: 'Flow',
        title: 'Conversation & chatbot',
        text: 'Automated journeys to qualify, route and re-engage.',
        metric: '24/7',
        items: ['Bot', 'CRM', 'Handoff'],
      },
    ],
    casesTitle: 'Ready-to-launch use cases',
    cases: [
      'Retail & e-commerce',
      'Banking & insurance',
      'Automotive',
      'Real estate',
      'Events',
      'Tourism & leisure',
    ],
    dashboardTitle: 'Track what matters',
    dashboardText:
      'Opens, clicks, replies, audience and cost per action are shown in a simple view built for quick decisions.',
    dashboard: [
      { label: 'Opens', value: '91%', tone: 'green' },
      { label: 'Clicks', value: '38%', tone: 'purple' },
      { label: 'Replies', value: '12K', tone: 'cyan' },
      { label: 'CPA', value: '-24%', tone: 'amber' },
    ],
    finalTitle: 'Explore the complete WhatsApp platform.',
    finalText:
      'Discover offers, features and campaign examples on the dedicated Richmedia WhatsApp platform.',
  },
};

const t = content[lang];
const cockpitFunnel =
  lang === 'fr'
    ? [
        { label: 'Audience', value: t.stats[2].value },
        { label: 'Push', value: '48h' },
        { label: 'Clic', value: t.stats[1].value },
        { label: 'Lead', value: 'Live' },
      ]
    : [
        { label: 'Audience', value: t.stats[2].value },
        { label: 'Push', value: '48h' },
        { label: 'Click', value: t.stats[1].value },
        { label: 'Lead', value: 'Live' },
      ];
const cockpitSignals =
  lang === 'fr'
    ? [
        { icon: 'ph-paper-plane-tilt', label: 'Offre envoyée', value: '+24K' },
        { icon: 'ph-chat-circle-dots', label: 'Réponse client', value: '+12K' },
        { icon: 'ph-check-circle', label: 'Lead qualifié', value: '38%' },
      ]
    : [
        { icon: 'ph-paper-plane-tilt', label: 'Offer sent', value: '+24K' },
        { icon: 'ph-chat-circle-dots', label: 'Customer reply', value: '+12K' },
        { icon: 'ph-check-circle', label: 'Qualified lead', value: '38%' },
      ];
const cockpitBars = t.dashboard.slice(0, 3).map((item, index) => ({
  ...item,
  level: `${88 - index * 14}%`,
}));
const offerVisuals =
  lang === 'fr'
    ? [
        {
          icon: 'ph-paper-plane-tilt',
          caption: 'Activation rapide',
          stages: ['Ciblage', 'Push', 'Reporting'],
        },
        {
          icon: 'ph-arrows-clockwise',
          caption: 'Optimisation continue',
          stages: ['Relance', 'Test', 'ROAS'],
        },
        {
          icon: 'ph-robot',
          caption: 'Parcours automatisé',
          stages: ['Bot', 'CRM', 'Conseiller'],
        },
      ]
    : [
        {
          icon: 'ph-paper-plane-tilt',
          caption: 'Fast activation',
          stages: ['Target', 'Push', 'Report'],
        },
        {
          icon: 'ph-arrows-clockwise',
          caption: 'Always optimizing',
          stages: ['Follow-up', 'Test', 'ROAS'],
        },
        {
          icon: 'ph-robot',
          caption: 'Automated journey',
          stages: ['Bot', 'CRM', 'Advisor'],
        },
      ];
const offerCards = t.offers.map((offer, index) => ({
  ...offer,
  ...offerVisuals[index],
  index,
  level: `${92 - index * 13}%`,
}));
const phoneDemo =
  lang === 'fr'
    ? {
        account: 'CIH Bank',
        subtitle: 'Compte professionnel',
        intro: 'Bonjour',
        message: [
          'Avec CODE 212, transférez vers le Maroc simplement.',
          'Compte gratuit 100% en ligne depuis CIH Mobile.',
          'Envie d’ouvrir votre compte ?',
        ],
        buttons: ['Ouvrir un compte', 'Télécharger l’app', 'Parler à un conseiller'],
        reply: 'Bonjour, je veux en savoir plus.',
        advisor: 'Avec plaisir. Un conseiller vous rappelle.',
      }
    : {
        account: 'CIH Bank',
        subtitle: 'Business account',
        intro: 'Hello',
        message: [
          'With CODE 212, transfer to Morocco simply.',
          'Free online account from CIH Mobile.',
          'Ready to open your account?',
        ],
        buttons: ['Open account', 'Download app', 'Talk to advisor'],
        reply: 'Hello, I want to know more.',
        advisor: 'Sure. An advisor will call you back.',
      };
---

<div class="whatsapp-page">
  <section class="whatsapp-hero" aria-labelledby="whatsapp-title">
    <div class="whatsapp-copy">
      <ProductLogo
        src="/assets/product-logos/richmedia-whatsapp-logo.png"
        alt="Richmedia WhatsApp"
        width={240}
        height={72}
        logoWidth="10.8rem"
        logoHeight="2.6rem"
      />
      <span class="whatsapp-kicker">{t.eyebrow}</span>
      <h1 id="whatsapp-title">
        {t.title.map((line, index) => (
          <span class={index === 2 ? 'accent-line' : ''}>{line}</span>
        ))}
      </h1>
      <p>{t.intro}</p>
      <div class="whatsapp-actions">
        <a class="button button-primary" href={phoneUrl}>
          {t.primaryCta}
          <i class="ph ph-phone" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="#use-cases">
          {t.secondaryCta}
          <i class="ph ph-arrow-down" aria-hidden="true"></i>
        </a>
      </div>
      <div class="hero-highlights" aria-label={lang === 'fr' ? 'Points clés' : 'Highlights'}>
        {t.highlights.map((item) => (
          <span>
            <i class="ph ph-check" aria-hidden="true"></i>
            {item}
          </span>
        ))}
      </div>
    </div>

    <div class="whatsapp-visual" aria-label={t.visualLabel}>
      <div class="phone-stage">
        <div class="hero-phone" aria-hidden="true">
          <span class="phone-side side-left top"></span>
          <span class="phone-side side-left middle"></span>
          <span class="phone-side side-right"></span>
          <div class="phone-screen">
            <div class="phone-status">
              <span>9:41</span>
              <span class="status-icons">
                <i class="ph ph-cell-signal-full" aria-hidden="true"></i>
                <i class="ph ph-wifi-high" aria-hidden="true"></i>
                <i class="ph ph-battery-full" aria-hidden="true"></i>
              </span>
            </div>
            <header class="phone-chat-header">
              <i class="ph ph-arrow-left" aria-hidden="true"></i>
              <img src="/assets/richmedia-realizations/whatsapp-animation/cih-logo.png" alt="" loading="eager" decoding="async" />
              <div>
                <strong>{phoneDemo.account}</strong>
                <span>{phoneDemo.subtitle}</span>
              </div>
              <i class="ph ph-seal-check-fill verified" aria-hidden="true"></i>
              <i class="ph ph-dots-three-vertical menu" aria-hidden="true"></i>
            </header>
            <div class="phone-chat-body">
              <article class="wa-message wa-card wa-step step-1">
                <img src="/assets/richmedia-realizations/whatsapp-animation/cih-code-212-card.png" alt="" loading="eager" decoding="async" />
              </article>
              <article class="wa-message wa-in wa-text wa-step step-2">
                <p>{phoneDemo.intro} <span aria-hidden="true">👋</span></p>
                {phoneDemo.message.map((line) => <p>{line}</p>)}
                <time>10:30</time>
              </article>
              <div class="wa-buttons wa-step step-3">
                {phoneDemo.buttons.map((button, index) => (
                  <span>
                    <i class:list={['ph', index === 0 ? 'ph-user-plus' : index === 1 ? 'ph-download-simple' : 'ph-headset']} aria-hidden="true"></i>
                    {button}
                  </span>
                ))}
              </div>
              <article class="wa-message wa-out wa-step step-4">
                <p>{phoneDemo.reply}</p>
                <time>10:31 <span aria-hidden="true">✓✓</span></time>
              </article>
              <article class="wa-typing wa-step step-5" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </article>
              <article class="wa-message wa-in wa-step step-6">
                <p>{phoneDemo.advisor}</p>
                <time>10:32</time>
              </article>
            </div>
            <div class="phone-composer">
              <i class="ph ph-smiley" aria-hidden="true"></i>
              <span>Message</span>
              <i class="ph ph-paperclip" aria-hidden="true"></i>
              <i class="ph ph-camera" aria-hidden="true"></i>
              <strong><i class="ph ph-microphone" aria-hidden="true"></i></strong>
            </div>
          </div>
        </div>
      </div>
      <div class="floating-metric metric-top">
        <span>{t.stats[0].label}</span>
        <strong>{t.stats[0].value}</strong>
        <i class="ph ph-trend-up" aria-hidden="true"></i>
      </div>
      <div class="floating-metric metric-mid">
        <span>{t.stats[1].label}</span>
        <strong>{t.stats[1].value}</strong>
        <i class="ph ph-cursor-click" aria-hidden="true"></i>
      </div>
      <div class="floating-metric metric-bottom">
        <span>{t.stats[2].label}</span>
        <strong>{t.stats[2].value}</strong>
        <i class="ph ph-database" aria-hidden="true"></i>
      </div>
    </div>
  </section>

  <section class="stats-strip" aria-label={lang === 'fr' ? 'Indicateurs clés' : 'Key metrics'}>
    {t.stats.map((stat) => (
      <article>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </article>
    ))}
  </section>

  <section class="visual-band" aria-labelledby="visual-title">
    <div class="showcase-copy">
      <span class="whatsapp-kicker">{t.visualLabel}</span>
      <h2 id="visual-title">{t.visualTitle}</h2>
      <p>{t.visualText}</p>
      <div class="flow-track" aria-label={lang === 'fr' ? 'Parcours campagne' : 'Campaign journey'}>
        {(lang === 'fr' ? ['Push', 'Clic', 'Lead'] : ['Push', 'Click', 'Lead']).map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{step}</strong>
          </article>
        ))}
      </div>
      <div class="showcase-metrics">
        {t.stats.slice(0, 3).map((stat) => (
          <article>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>

    <div class="showcase-stage" aria-label={lang === 'fr' ? 'Exemples campagnes WhatsApp' : 'WhatsApp campaign examples'}>
      <div class="stage-glow" aria-hidden="true"></div>
      <img class="campaign-phone phone-left" src="/assets/richmedia-realizations/whatsapp-jaguar-maroc.png" alt="" loading="lazy" decoding="async" />
      <img class="campaign-phone phone-right" src="/assets/richmedia-realizations/whatsapp-moul-pounj-cutout.png" alt="" loading="lazy" decoding="async" />
      <article class="kpi-pill kpi-open">
        <span>{t.stats[0].label}</span>
        <strong>{t.stats[0].value}</strong>
        <i class="ph ph-trend-up" aria-hidden="true"></i>
      </article>
      <article class="kpi-pill kpi-click">
        <span>{t.stats[1].label}</span>
        <strong>{t.stats[1].value}</strong>
        <i class="ph ph-cursor-click" aria-hidden="true"></i>
      </article>
      <div class="message-orbit">
        <span>{lang === 'fr' ? 'Scénario actif' : 'Active journey'}</span>
        <article>
          <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
          <strong>{lang === 'fr' ? 'Push offre' : 'Offer push'}</strong>
          <small>Live</small>
        </article>
        <article>
          <i class="ph ph-chat-circle-dots" aria-hidden="true"></i>
          <strong>{lang === 'fr' ? 'Réponse client' : 'Customer reply'}</strong>
          <small>+12K</small>
        </article>
      </div>
    </div>
  </section>

  <section class="section-band benefits-band" aria-labelledby="benefits-title">
    <div class="benefit-impact">
      <div class="section-intro benefit-copy">
        <span class="whatsapp-kicker">{lang === 'fr' ? 'Avantages' : 'Benefits'}</span>
        <h2 id="benefits-title">{t.benefitsTitle}</h2>
        <p>{t.benefitsText}</p>
        <div class="benefit-scoreboard" aria-label={lang === 'fr' ? 'Indicateurs WhatsApp' : 'WhatsApp indicators'}>
          {t.stats.slice(0, 3).map((stat) => (
            <article>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </article>
          ))}
        </div>
      </div>
      <div class="benefit-cockpit" aria-hidden="true">
        <div class="cockpit-topline">
          <span>{lang === 'fr' ? 'Campagne active' : 'Active campaign'}</span>
          <strong>{t.stats[0].value}</strong>
        </div>
        <div class="cockpit-funnel">
          {cockpitFunnel.map((step, index) => (
            <article style={`--step: ${index}`}>
              <span>{step.label}</span>
              <strong>{step.value}</strong>
            </article>
          ))}
        </div>
        <div class="cockpit-chat">
          {cockpitSignals.map((signal, index) => (
            <article class={index === 1 ? 'is-highlight' : ''}>
              <i class:list={['ph', signal.icon]} aria-hidden="true"></i>
              <span>{signal.label}</span>
              <strong>{signal.value}</strong>
            </article>
          ))}
        </div>
        <div class="cockpit-bars">
          {cockpitBars.map((metric) => (
            <article>
              <span>{metric.label}</span>
              <i style={`--bar: ${metric.level}`}></i>
              <strong>{metric.value}</strong>
            </article>
          ))}
        </div>
      </div>
    </div>
    <div class="benefit-grid">
      {t.benefits.map((benefit, index) => (
        <article style={`--index: ${index}; --level: ${92 - index * 11}%`}>
          <div class="benefit-card-top">
            <i class:list={['ph', benefit.icon]} aria-hidden="true"></i>
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
          <div class="benefit-meter" aria-hidden="true">
            <i></i>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-band offers-band" aria-labelledby="offers-title">
    <div class="offers-head">
      <div class="section-intro compact">
        <span class="whatsapp-kicker">{lang === 'fr' ? 'Offres' : 'Offers'}</span>
        <h2 id="offers-title">{t.offersTitle}</h2>
        <p>{t.offersText}</p>
      </div>
      <div class="offers-route" aria-hidden="true">
        {offerCards.map((offer) => (
          <article>
            <span>{String(offer.index + 1).padStart(2, '0')}</span>
            <strong>{offer.badge}</strong>
            <em>{offer.metric}</em>
          </article>
        ))}
      </div>
    </div>
    <div class="offer-grid">
      {offerCards.map((offer) => (
        <article class="offer-card" style={`--offer-level: ${offer.level}; --offer-index: ${offer.index}`}>
          <span class="offer-index">{String(offer.index + 1).padStart(2, '0')}</span>
          <div class="offer-card-top">
            <span class="offer-badge">{offer.badge}</span>
            <strong>
              {offer.metric}
              <small>{offer.caption}</small>
            </strong>
          </div>
          <div class="offer-visual" aria-hidden="true">
            <i class:list={['ph', offer.icon]}></i>
            <div>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
          <h3>{offer.title}</h3>
          <p>{offer.text}</p>
          <div class="offer-sequence" aria-hidden="true">
            {offer.stages.map((stage, stageIndex) => (
              <span>
                <small>{String(stageIndex + 1).padStart(2, '0')}</small>
                {stage}
              </span>
            ))}
          </div>
          <ul>
            {offer.items.map((item) => (
              <li>
                <i class="ph ph-check" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
          <div class="offer-progress" aria-hidden="true">
            <i></i>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="use-cases" class="use-case-band" aria-labelledby="use-cases-title">
    <div>
      <span class="whatsapp-kicker">{lang === 'fr' ? 'Secteurs' : 'Industries'}</span>
      <h2 id="use-cases-title">{t.casesTitle}</h2>
    </div>
    <div class="case-grid">
      {t.cases.map((item) => (
        <span>
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          {item}
        </span>
      ))}
    </div>
  </section>

  <section class="dashboard-band" aria-labelledby="dashboard-title">
    <div class="dashboard-copy">
      <span class="whatsapp-kicker">Dashboard</span>
      <h2 id="dashboard-title">{t.dashboardTitle}</h2>
      <p>{t.dashboardText}</p>
    </div>
    <div class="dashboard-panel">
      {t.dashboard.map((item) => (
        <article class:list={['dashboard-tile', item.tone]}>
          <span>{item.label}</span>
          <strong>{item.value}</strong>
          <i class="ph ph-wave-sine" aria-hidden="true"></i>
        </article>
      ))}
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div>
