---
import { SITE } from '../consts';
type OgType = 'website' | 'article';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: 'fr' | 'en';
  noindex?: boolean;
  ogType?: OgType;
  articlePublishedTime?: Date | string;
  articleModifiedTime?: Date | string;
  articleAuthor?: string;
  articleSection?: string;
}
const {
  title,
  description,
  canonical,
  ogImage,
  lang = 'fr',
  noindex = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const defaultImage = import.meta.env.PUBLIC_OG_IMAGE_URL ?? `${SITE.url}/og-default.jpg`;
const image = ogImage ?? defaultImage;
const toIsoString = (value?: Date | string) => {
  if (!value) return null;
  if (value instanceof Date) return value.toISOString();
  const parsedDate = new Date(value);
  return Number.isNaN(parsedDate.getTime()) ? value : parsedDate.toISOString();
};
const articlePublishedTimeIso = toIsoString(articlePublishedTime);
const articleModifiedTimeIso = toIsoString(articleModifiedTime);
const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const bilingualRoutes = [
  ['/', '/en'],
  ['/agence', '/en/agency'],
  ['/carrieres', '/en/careers'],
  ['/confidentialite', '/en/privacy'],
  ['/contact', '/en/contact'],
  ['/cookies', '/en/cookies'],
  ['/equipe', '/en/team'],
  ['/expertises', '/en/expertises'],
  ['/expertises/achat-media', '/en/expertises/achat-media'],
  ['/expertises/brand-content', '/en/expertises/brand-content'],
  ['/expertises/evenementiel', '/en/expertises/evenementiel'],
  ['/expertises/ia-automation', '/en/expertises/ia-automation'],
  ['/expertises/influence', '/en/expertises/influence'],
  ['/expertises/media-performance', '/en/expertises/media-performance'],
  ['/expertises/phygital', '/en/expertises/phygital'],
  ['/expertises/referencement-seo', '/en/expertises/seo-geo'],
  ['/expertises/strategie-digitale', '/en/expertises/strategie-digitale'],
  ['/expertises/web-si', '/en/expertises/web-si'],
  ['/insights', '/en/insights'],
  ['/insights/priorites-digitales-2026-croissance-rentable', '/en/insights/digital-priorities-2026-profitable-growth'],
  ['/insights/plan-acquisition-digital-2026', '/en/insights/digital-acquisition-plan-2026'],
  ['/insights/campagnes-meta-2026-bonnes-pratiques', '/en/insights/meta-campaigns-2026-best-practices'],
  ['/insights/seo-vs-geo-enjeux-2026', '/en/insights/seo-vs-geo-2026'],
  ['/insights/whatsapp-business-canal-conversion', '/en/insights/whatsapp-business-conversion-channel'],
  ['/insights/createurs-marques-collaborations-durables', '/en/insights/creators-brands-durable-collaborations'],
  ['/insights/data-decision-strategie-performance', '/en/insights/data-for-decisions-performance-strategy'],
  ['/insights/marque-employeur-attractivite-digitale', '/en/insights/employer-brand-digital-attractiveness'],
  ['/insights/contenu-qualite-seo-perenne', '/en/insights/quality-content-durable-seo'],
  ['/insights/crm-automation-aligner-marketing-sales', '/en/insights/crm-automation-marketing-sales-alignment'],
  ['/insights/cout-campagne-google-ads-maroc', '/en/insights/google-ads-campaign-cost-morocco'],
  ['/mentions-legales', '/en/legal-notice'],
  ['/produits/carter-blake', '/en/products/carter-blake'],
  ['/produits/hypeo', '/en/products/hypeo'],
  ['/produits/in-talks', '/en/products/in-talks'],
  ['/produits/whatsapp', '/en/products/whatsapp'],
  ['/realisations', '/en/case-studies'],
  ['/realisations/modele-case-study', '/en/case-studies/model-case-study'],
  ['/realisations/uir-campagnes-digitales', '/en/case-studies/uir-digital-campaigns'],
  ['/references', '/en/references'],
  ['/reserver-un-audit', '/en/book-audit'],
  ['/secteurs', '/en/sectors'],
  ['/secteurs/automobile', '/en/sectors/automotive'],
  ['/secteurs/education', '/en/sectors/education'],
  ['/secteurs/fmcg', '/en/sectors/fmcg'],
  ['/secteurs/gms', '/en/sectors/grocery-retail'],
  ['/secteurs/immobilier', '/en/sectors/real-estate'],
  ['/secteurs/institutionnel', '/en/sectors/institutional'],
  ['/secteurs/retail-ecommerce', '/en/sectors/retail-ecommerce'],
  ['/secteurs/tourisme-hotellerie', '/en/sectors/tourism-hospitality'],
  ['/sitemap', '/en/sitemap'],
] as const;
const absoluteUrl = (pathname: string) => (pathname === '/' ? SITE.url : `${SITE.url}${pathname}`);
const routePair = bilingualRoutes.find(([frPath, enPath]) => normalizedPath === frPath || normalizedPath === enPath);
const frAlternate = routePair ? absoluteUrl(routePair[0]) : lang === 'fr' ? url : null;
const enAlternate = routePair ? absoluteUrl(routePair[1]) : lang === 'en' ? url : null;
const defaultAlternate = routePair ? absoluteUrl(routePair[0]) : frAlternate ?? enAlternate ?? url;
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={url} />

{frAlternate && <link rel="alternate" hreflang="fr" href={frAlternate} />}
{enAlternate && <link rel="alternate" hreflang="en" href={enAlternate} />}
<link rel="alternate" hreflang="x-default" href={defaultAlternate} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:locale" content={lang === 'fr' ? 'fr_MA' : 'en_US'} />
{ogType === 'article' && articlePublishedTimeIso && <meta property="article:published_time" content={articlePublishedTimeIso} />}
{ogType === 'article' && articleModifiedTimeIso && <meta property="article:modified_time" content={articleModifiedTimeIso} />}
{ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
{ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
<meta name="twitter:card" content="summary_large_image" />
