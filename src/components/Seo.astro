  ['/insights/contenu-qualite-seo-perenne', '/en/insights/quality-content-durable-seo'],
  ['/insights/crm-automation-aligner-marketing-sales', '/en/insights/crm-automation-marketing-sales-alignment'],
  ['/insights/cout-campagne-google-ads-maroc', '/en/insights/google-ads-campaign-cost-morocco'],
  ['/insights/cout-lead-maroc-benchmarks-cpl', '/en/insights/cost-per-lead-morocco-industry-benchmarks'],
