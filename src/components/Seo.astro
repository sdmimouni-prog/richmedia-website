  ['/expertises/geofencing-drive-to-store-maroc', '/en/expertises/geofencing-drive-to-store-morocco'],
  ['/glossaire', '/en/glossary'],
  ...glossaryRoutePairs,
  ['/mentions-legales', '/en/legal-notice'],
  ['/produits/carter-blake', '/en/products/carter-blake'],
  ['/produits/hypeo', '/en/products/hypeo'],
  ['/produits/in-talks', '/en/products/in-talks'],
  ['/produits/whatsapp', '/en/products/whatsapp'],
  ['/realisations', '/en/case-studies'],
  ['/realisations/maserati-levante-whatsapp-leads-2025', '/en/case-studies/maserati-levante-whatsapp-leads-2025'],
  ['/realisations/chergui-packaging-2021', '/en/case-studies/chergui-packaging-2021'],
  ['/realisations/don-simon-back-to-school-2025', '/en/case-studies/don-simon-back-to-school-2025'],
  ['/realisations/amana-tramway-phygital-2022', '/en/case-studies/amana-tramway-phygital-2022'],
  ['/realisations/nescafe-nadi-nescafe-2019', '/en/case-studies/nescafe-nadi-nescafe-2019'],
  ['/realisations/universite-euromed-refonte-site-web-2025', '/en/case-studies/euromed-university-drupal-website-redesign-2025'],
  ['/realisations/prestigia-riad-al-andalous-acquisition-2026', '/en/case-studies/prestigia-riad-al-andalous-acquisition-2026'],
  ['/realisations/tramway-rabat-sale-community-management-2026', '/en/case-studies/tramway-rabat-sale-community-management-2026'],
  ['/realisations/tbs-master-acquisition-2025', '/en/case-studies/tbs-master-acquisition-2025'],
  ['/realisations/uir-campagnes-digitales', '/en/case-studies/uir-digital-campaigns'],
  ['/realisations/uir-campagne-acquisition-2023-2024', '/en/case-studies/uir-acquisition-campaign-2023-2024'],
  ['/references', '/en/references'],
  ['/reserver-un-audit', '/en/book-audit'],
  ['/secteurs', '/en/sectors'],
  ['/secteurs/automobile', '/en/sectors/automotive'],
  ['/secteurs/education', '/en/sectors/education'],
  ['/secteurs/fmcg', '/en/sectors/fmcg'],
  ['/secteurs/gms', '/en/sectors/grocery-retail'],
  ['/secteurs/immobilier', '/en/sectors/real-estate'],
  ['/secteurs/institutionnel', '/en/sectors/institutional'],
  ['/secteurs/retail-ecommerce', '/en/sectors/retail-ecommerce'],
  ['/secteurs/tourisme-hotellerie', '/en/sectors/tourism-hospitality'],
  ['/sitemap', '/en/sitemap'],
] as const;
const absoluteUrl = (pathname: string) => (pathname === '/' ? SITE.url : `${SITE.url}${pathname}`);
const glossaryRoutePair =
  normalizedPath === '/glossaire' || normalizedPath === '/en/glossary'
    ? (['/glossaire', '/en/glossary'] as const)
    : normalizedPath.startsWith('/glossaire/')
    ? ([normalizedPath, normalizedPath.replace('/glossaire/', '/en/glossary/')] as const)
    : normalizedPath.startsWith('/en/glossary/')
    ? ([normalizedPath.replace('/en/glossary/', '/glossaire/'), normalizedPath] as const)
    : null;
const routePair = bilingualRoutes.find(([frPath, enPath]) => normalizedPath === frPath || normalizedPath === enPath) ?? glossaryRoutePair;
const frAlternate = routePair ? absoluteUrl(routePair[0]) : lang === 'fr' ? url : null;
const enAlternate = routePair ? absoluteUrl(routePair[1]) : lang === 'en' ? url : null;
const defaultAlternate = routePair ? absoluteUrl(routePair[0]) : frAlternate ?? enAlternate ?? url;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={url} />

{frAlternate && <link rel="alternate" hreflang="fr" href={frAlternate} />}
{enAlternate && <link rel="alternate" hreflang="en" href={enAlternate} />}
<link rel="alternate" hreflang="x-default" href={defaultAlternate} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={lang === 'fr' ? 'fr_MA' : 'en_US'} />
<meta property="og:site_name" content={SITE.name} />
{ogType === 'article' && articlePublishedTimeIso && <meta property="article:published_time" content={articlePublishedTimeIso} />}
{ogType === 'article' && articleModifiedTimeIso && <meta property="article:modified_time" content={articleModifiedTimeIso} />}
{ogType === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
{ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
