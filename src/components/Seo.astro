  attribution: 'attribution',
  audience: 'audience',
  'brand-content': 'brand-content',
  cpc: 'cpc',
  cpl: 'cpl',
  cpm: 'cpm',
  crm: 'crm',
  cro: 'cro',
  cta: 'cta',
  ctr: 'ctr',
  'donnees-structurees': 'structured-data',
  'e-e-a-t': 'e-e-a-t',
  'featured-snippet': 'featured-snippet',
  'first-party-data': 'first-party-data',
  funnel: 'funnel',
  geo: 'geo',
  'google-ads': 'google-ads',
  'influence-marketing': 'influencer-marketing',
