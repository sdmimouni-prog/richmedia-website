---
import { existsSync, readFileSync } from 'node:fs';
import { join, normalize } from 'node:path';
import { SITE } from '../consts';
type OgType = 'website' | 'article';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  lang?: 'fr' | 'en';
  noindex?: boolean;
  ogType?: OgType;
  articlePublishedTime?: Date | string;
  articleModifiedTime?: Date | string;
  articleAuthor?: string;
  articleSection?: string;
}
const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  lang = 'fr',
  noindex = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const defaultImage = import.meta.env.PUBLIC_OG_IMAGE_URL ?? `${SITE.url}/og-default.jpg`;
const makeAbsoluteUrl = (source: string) => (source.startsWith('/') ? `${SITE.url}${source}` : source);
const image = makeAbsoluteUrl(ogImage ?? defaultImage);
const imageAlt = ogImageAlt ?? title;
const readUInt24LE = (buffer: Buffer, offset: number) => buffer[offset] + (buffer[offset + 1] << 8) + (buffer[offset + 2] << 16);
const readImageDimensions = (buffer: Buffer) => {
  if (buffer.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) {
    return { width: buffer.readUInt32BE(16), height: buffer.readUInt32BE(20) };
  }
  if (buffer[0] === 0xff && buffer[1] === 0xd8) {
    for (let offset = 2; offset < buffer.length;) {
      if (buffer[offset] !== 0xff) {
        offset += 1;
        continue;
      }
      const marker = buffer[offset + 1];
      const length = buffer.readUInt16BE(offset + 2);
      if ((marker >= 0xc0 && marker <= 0xc3) || (marker >= 0xc5 && marker <= 0xc7) || (marker >= 0xc9 && marker <= 0xcb) || (marker >= 0xcd && marker <= 0xcf)) {
        return { width: buffer.readUInt16BE(offset + 7), height: buffer.readUInt16BE(offset + 5) };
      }
      offset += 2 + length;
    }
  }
  if (buffer.toString('ascii', 0, 4) === 'RIFF' && buffer.toString('ascii', 8, 12) === 'WEBP') {
    const format = buffer.toString('ascii', 12, 16);
    if (format === 'VP8X') return { width: readUInt24LE(buffer, 24) + 1, height: readUInt24LE(buffer, 27) + 1 };
    if (format === 'VP8L') {
      const bits = buffer.readUInt32LE(21);
      return { width: (bits & 0x3fff) + 1, height: ((bits >> 14) & 0x3fff) + 1 };
    }
    if (format === 'VP8 ') return { width: buffer.readUInt16LE(26) & 0x3fff, height: buffer.readUInt16LE(28) & 0x3fff };
  }
  return null;
};
const getLocalImageDimensions = (source: string) => {
  try {
    const parsedImage = new URL(source);
    const siteUrl = new URL(SITE.url);
    if (parsedImage.origin !== siteUrl.origin) return null;
    const publicDir = normalize(join(process.cwd(), 'public'));
    const imagePath = normalize(join(publicDir, decodeURIComponent(parsedImage.pathname).replace(/^\/+/, '')));
    if (!imagePath.startsWith(publicDir) || !existsSync(imagePath)) return null;
    return readImageDimensions(readFileSync(imagePath));
  } catch {
    return null;
  }
};
const imageDimensions = getLocalImageDimensions(image);
const imageWidth = String(ogImageWidth ?? imageDimensions?.width ?? 1200);
const imageHeight = String(ogImageHeight ?? imageDimensions?.height ?? 630);
const toIsoString = (value?: Date | string) => {
  if (!value) return null;
  if (value instanceof Date) return value.toISOString();
  const parsedDate = new Date(value);
  return Number.isNaN(parsedDate.getTime()) ? value : parsedDate.toISOString();
};
const articlePublishedTimeIso = toIsoString(articlePublishedTime);
const articleModifiedTimeIso = toIsoString(articleModifiedTime);
const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const glossarySlugPairs: Record<string, string> = {
