  ['/outils/checklist-tracking-digital', '/en/tools/pre-launch-tracking-checklist'],
  ['/outils/checklist-landing-page-conversion', '/en/tools/landing-page-conversion-checklist'],
  ['/outils/checklist-meta-ads-2026', '/en/tools/meta-ads-2026-checklist'],
  ['/expertises/google-ads-maroc', '/en/expertises/google-ads-morocco'],
