  'seo-local': 'local-seo',
  'seo-technique': 'technical-seo',
  seo: 'seo',
  serp: 'serp',
  'taux-de-conversion': 'conversion-rate',
  tracking: 'tracking',
  ugc: 'ugc',
  'whatsapp-business': 'whatsapp-business',
