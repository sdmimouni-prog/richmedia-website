---
interface Props {
  lang?: 'fr' | 'en';
}

const isEnglish = Astro.props.lang === 'en' || Astro.url.pathname.startsWith('/en/');

const labels = isEnglish
  ? {
      href: '/en/insights/morocco-digital-marketing-barometer-2026/',
      kicker: 'Richmedia Barometer 2026',
      title: 'Download the Morocco Digital Marketing Barometer',
      summary:
        'Richmedia benchmarks on budgets, CPL, channels, WhatsApp, Meta Ads and Google Ads to frame your campaigns with concrete reference points.',
      cta: 'Access the barometer',
      alt: 'Cover of the Morocco Digital Marketing Barometer 2026',
    }
  : {
      href: '/insights/barometre-marketing-digital-maroc-2026/',
      kicker: 'Baromètre Richmedia 2026',
      title: 'Télécharger le Baromètre Marketing Digital au Maroc',
      summary:
        'Benchmarks Richmedia sur les budgets, CPL, canaux, WhatsApp, Meta Ads et Google Ads pour cadrer vos campagnes avec des repères concrets.',
      cta: 'Accéder au baromètre',
      alt: 'Couverture du Baromètre Marketing Digital au Maroc 2026',
    };
---

<section class="barometer-download-band" aria-labelledby="barometer-download-title">
  <a href={labels.href} class="barometer-download-card">
    <div class="barometer-download-copy">
      <span class="barometer-download-kicker">{labels.kicker}</span>
      <h2 id="barometer-download-title">{labels.title}</h2>
      <p class="barometer-download-summary">{labels.summary}</p>
      <span class="barometer-download-cta">
        {labels.cta}
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </span>
    </div>
    <div class="barometer-download-visual">
      <img
        class="barometer-book-image"
        src="/assets/richmedia-barometre/barometre-2026-book-render.webp"
        alt={labels.alt}
        width="1122"
        height="1402"
        loading="lazy"
        decoding="async"
        sizes="(max-width: 720px) 46vw, 215px"
      />
    </div>
  </a>
</section>

<style>
  .barometer-download-band {
    --container: min(100% - 3rem, 1320px);
    --purple: #7c3cff;
    width: var(--container);
    margin: clamp(1.5rem, 3vw, 2.5rem) auto 0;
  }

  .barometer-download-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(190px, 0.34fr);
    gap: clamp(0.75rem, 2vw, 1.4rem);
    align-items: center;
    min-height: 140px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 8px;
    padding: clamp(0.48rem, 0.75vw, 0.64rem);
    padding-left: 60px;
    padding-right: 25px;
    background:
      radial-gradient(circle at 15% 24%, rgba(124, 60, 255, 0.28), transparent 24rem),
      linear-gradient(135deg, rgba(26, 16, 55, 0.92), rgba(5, 6, 10, 0.98) 55%, rgba(12, 8, 28, 0.94));
    box-shadow: 0 1.6rem 4.8rem rgba(0, 0, 0, 0.32);
    color: #fff;
    isolation: isolate;
    text-decoration: none;
    transition:
      border-color 240ms ease,
      box-shadow 240ms ease,
      transform 240ms ease;
  }

  .barometer-download-card::before,
  .barometer-download-card::after {
    position: absolute;
    content: '';
    pointer-events: none;
  }

  .barometer-download-card::before {
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 7.5rem 7.5rem;
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.78), transparent 70%);
    opacity: 0.55;
  }

  .barometer-download-card::after {
    right: -7rem;
    bottom: -9rem;
    z-index: -1;
    width: 23rem;
    height: 23rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(124, 60, 255, 0.38), transparent 70%);
    opacity: 0.72;
    filter: blur(12px);
    transition: opacity 240ms ease, transform 360ms ease;
  }

  .barometer-download-card:hover {
    border-color: rgba(164, 111, 255, 0.46);
    box-shadow:
      0 1.8rem 5.5rem rgba(0, 0, 0, 0.38),
      0 0 3rem rgba(124, 60, 255, 0.16);
    transform: translateY(-0.18rem);
  }

  .barometer-download-card:hover::after {
    opacity: 0.95;
    transform: scale(1.08) translate(-0.8rem, -0.55rem);
  }

  .barometer-download-copy {
    position: relative;
    z-index: 2;
    max-width: 960px;
  }

  .barometer-download-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: #b58cff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .barometer-download-kicker::before {
    width: 3rem;
    height: 2px;
    border-radius: 999px;
    background: var(--purple);
    content: '';
  }

  .barometer-download-copy h2 {
    max-width: none;
    margin: 0.42rem 0 0;
    font-size: clamp(1.45rem, 2.25vw, 1.98rem);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .barometer-download-summary {
    max-width: 900px;
    margin: 0.32rem 0 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(0.76rem, 0.92vw, 0.88rem);
    line-height: 1.28;
  }

  .barometer-download-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    min-height: 2.28rem;
    margin-top: 0.52rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 0 1rem;
    background: linear-gradient(135deg, #8c52ff, #6224ec);
    box-shadow: 0 1rem 2.4rem rgba(124, 60, 255, 0.3);
    color: #fff;
    font-weight: 800;
    transition: box-shadow 220ms ease, transform 220ms ease;
  }

  .barometer-download-card:hover .barometer-download-cta {
    box-shadow: 0 1.1rem 3rem rgba(124, 60, 255, 0.42);
    transform: translateX(0.18rem);
  }

  .barometer-download-visual {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 140px;
    place-items: center;
    transform: translateX(-1.35rem);
  }

  .barometer-download-visual::before {
    position: absolute;
    inset: 4% -4% -2%;
    border-radius: 999px;
    background:
      radial-gradient(circle at 52% 42%, rgba(166, 114, 255, 0.33), transparent 46%),
      radial-gradient(circle at 70% 74%, rgba(54, 24, 138, 0.52), transparent 58%);
    content: '';
    filter: blur(30px);
    opacity: 0.85;
    transition: opacity 240ms ease, transform 320ms ease;
  }

  .barometer-download-visual::after {
    position: absolute;
    right: 0;
    bottom: 2%;
    width: min(88%, 300px);
    height: 1.75rem;
    border-radius: 999px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.58), transparent 72%);
    content: '';
    filter: blur(11px);
    opacity: 0.88;
    transform: rotate(-2deg);
    transition: opacity 240ms ease, transform 320ms ease;
  }

  .barometer-book-image {
    position: relative;
    z-index: 1;
    display: block;
    width: min(100%, 164px);
    height: auto;
    filter: drop-shadow(0 1.1rem 2.4rem rgba(0, 0, 0, 0.48));
    transform: translateX(-0.2rem);
    transition: filter 260ms ease, transform 360ms ease;
    will-change: transform;
  }

  .barometer-download-card:hover .barometer-download-visual::before {
    opacity: 1;
    transform: scale(1.08);
  }

  .barometer-download-card:hover .barometer-download-visual::after {
    opacity: 1;
    transform: translateY(0.2rem) rotate(-2deg) scale(1.08);
  }

  .barometer-download-card:hover .barometer-book-image {
    filter: drop-shadow(0 1.35rem 2.8rem rgba(0, 0, 0, 0.54));
    transform: translate(-0.15rem, -0.16rem) scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .barometer-download-card,
    .barometer-download-card::after,
    .barometer-download-cta,
    .barometer-download-visual::before,
    .barometer-download-visual::after,
    .barometer-book-image {
      transition: none;
    }

    .barometer-download-card:hover,
    .barometer-download-card:hover::after,
    .barometer-download-card:hover .barometer-download-cta,
    .barometer-download-card:hover .barometer-download-visual::before,
    .barometer-download-card:hover .barometer-download-visual::after,
    .barometer-download-card:hover .barometer-book-image {
      transform: none;
    }
  }

  @media (max-width: 1060px) {
    .barometer-download-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .barometer-download-copy {
      max-width: 760px;
    }

    .barometer-download-visual {
      min-height: 150px;
      place-items: center;
      transform: translateX(0);
    }

    .barometer-book-image {
      width: min(42vw, 170px);
    }
  }

  @media (max-width: 720px) {
    .barometer-download-band {
      --container: min(100% - 1rem, 1320px);
      margin-top: 1.25rem;
    }

    .barometer-download-card {
      padding: 0.78rem;
    }

    .barometer-download-copy h2 {
      font-size: clamp(1.28rem, 6.4vw, 1.72rem);
      white-space: normal;
    }

    .barometer-download-cta {
      width: 100%;
      min-height: 2.45rem;
      margin-top: 0.75rem;
      justify-content: center;
      padding-inline: 0.9rem;
    }

    .barometer-download-visual {
      min-height: 128px;
      margin-top: 0;
    }

    .barometer-book-image {
      width: min(40vw, 128px);
      transform: translateY(0.1rem);
    }
  }
</style>
