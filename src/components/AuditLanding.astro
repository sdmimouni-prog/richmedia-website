      {
        channel: 'Instagram, TikTok, LinkedIn',
        score: '82',
        risk: 'Strong visibility, conversion still weak.',
        impact: 'High',
        action: 'Editorial pillars + CTAs.',
      },
      {
        channel: 'Mobile website',
        score: '64',
        risk: 'Clear message, incomplete tracking.',
        impact: 'Very high',
        action: 'Simplify CTAs + forms.',
      },
      {
        channel: 'SEO & AI answers',
        score: '51',
        risk: 'Business queries underused.',
        impact: 'High',
        action: 'Service pages + FAQ.',
      },
      {
        channel: 'Reviews, mentions, reputation',
        score: '74',
        risk: 'Positive proof not visible enough.',
        impact: 'Medium',
        action: 'Surface reviews + references.',
      },
      {
        channel: 'Media & acquisition',
        score: '69',
        risk: 'Active budgets, unclear arbitration.',
        impact: 'Very high',
        action: 'Compare CPA + lead quality.',
      },
    ],
    deliverablesTitle: 'You leave with a clear plan',
    deliverables: [
      'Digital maturity scorecard',
      'Competitive and market benchmark',
      'Priority dashboard by channel',
      'Actionable quick wins in 7 days',
      '30/60/90-day roadmap',
      'Readout call with recommendations',
    ],
    processTitle: 'Our method',
    process: [
      { step: '01', title: 'Frame', text: 'Goals, audience, channels, markets, competitors and business priorities.' },
      { step: '02', title: 'Measure', text: 'Review available data, content, pages, campaigns and reviews.' },
      { step: '03', title: 'Benchmark', text: 'Compare with market and performance standards by channel.' },
      { step: '04', title: 'Prioritize', text: 'A concrete action plan ranked by impact, effort and urgency.' },
    ],
    formLabel: 'Book your audit',
    formTitle: 'Tell us about your digital presence.',
    formText: 'Leave your details and we will come back with the first scoping questions.',
    fields: {
      name: 'Full name',
      email: 'Work email',
      phone: 'Phone',
      company: 'Company',
      website: 'Website or main link',
      objective: 'Current priority',
      select: 'Select',
      objectives: ['More leads', 'Better visibility', 'Improve the website', 'Audit social media', 'Online reputation', 'Full digital system'],
      message: 'Message',
      placeholder: 'Your social channels, competitors, goals, timing...',
      submit: 'Send request',
      callPrefix: 'Need to move fast?',
      call: `Call ${phoneDisplay}`,
    },
  },
} as const;

const t = content[lang];
---

<div class="audit-page">
  <section class="audit-hero" aria-labelledby="audit-title">
    <div class="hero-shell">
      <div class="hero-copy">
        <span class="section-kicker">{t.pageLabel}</span>
        <h1 id="audit-title">{t.title}</h1>
        <p>{t.intro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#audit-form">
            {t.primaryCta}
            <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href={`tel:${phone}`}>
            {t.secondaryCta}
            <i class="ph ph-phone" aria-hidden="true"></i>
          </a>
        </div>
        <div class="hero-pills" aria-label={lang === 'fr' ? 'Points clés de l’audit' : 'Audit highlights'}>
          {t.heroBullets.map((item) => (
            <span>
              <i class="ph ph-check-circle" aria-hidden="true"></i>
              {item}
            </span>
          ))}
        </div>
      </div>

      <aside class="audit-console" aria-label={t.dashboardLabel}>
        <div class="console-top">
          <div>
            <span>{t.maturity}</span>
            <strong>{t.sample}</strong>
          </div>
          <span class="priority-pill">{t.pulse}</span>
        </div>

        <div class="score-layout">
          <div class="score-ring" style={`--score: ${t.score};`}>
            <span>{t.score}</span>
            <small>/100</small>
          </div>
          <div class="score-copy">
            <strong>{t.scoreLabel}</strong>
            <p>{t.dashboardNote}</p>
          </div>
        </div>

        <div class="channel-bars">
          {t.channels.map((item) => (
            <div class:list={['channel-row', `tone-${item.tone}`]} style={`--value: ${item.value}%;`}>
              <span>{item.label}</span>
              <div aria-hidden="true"><span></span></div>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>

        <div class="mini-chart" aria-hidden="true">
          <span style="--height: 42%;"></span>
          <span style="--height: 58%;"></span>
          <span style="--height: 46%;"></span>
          <span style="--height: 78%;"></span>
          <span style="--height: 64%;"></span>
          <span style="--height: 88%;"></span>
          <span style="--height: 70%;"></span>
        </div>
        <div class="floating-card floating-card-top" aria-hidden="true">
          <i class="ph ph-trend-up"></i>
          <strong>+34%</strong>
          <span>{lang === 'fr' ? 'signaux à activer' : 'signals to activate'}</span>
        </div>
        <div class="floating-card floating-card-bottom" aria-hidden="true">
          <i class="ph ph-star"></i>
          <strong>4.6/5</strong>
          <span>{lang === 'fr' ? 'confiance & réputation' : 'trust & reputation'}</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="audit-kpis" aria-label={lang === 'fr' ? 'Chiffres clés de l’audit' : 'Audit key figures'}>
    {t.kpis.map((item) => (
      <article>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </article>
    ))}
  </section>

  <section class="visual-strip" aria-labelledby="visual-title">
    <div class="visual-strip-head">
      <span class="section-kicker">{lang === 'fr' ? 'Scan visuel' : 'Visual scan'}</span>
      <h2 id="visual-title">{t.visualTitle}</h2>
    </div>
    <div class="visual-cards">
      {t.visualCards.map((item) => (
        <article>
          <img src={item.image} alt="" loading="lazy" decoding="async" />
          <div>
            <span>{item.label}</span>
            <strong>{item.title}</strong>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="offers-band" aria-labelledby="offers-title">
    <div class="section-intro">
      <span class="section-kicker">{t.offersLabel}</span>
      <h2 id="offers-title">{t.offersTitle}</h2>
    </div>
    <div class="offer-grid">
      {t.offers.map((offer) => (
        <article class="offer-card">
          <div class="offer-media">
            <img src={offer.image} alt="" loading="lazy" decoding="async" />
            <span>{offer.badge}</span>
          </div>
          <div class="offer-copy">
            <div>
              <h3>{offer.title}</h3>
              <strong>{offer.value}</strong>
            </div>
            <p>{offer.text}</p>
            <ul>
              {offer.bullets.map((item) => (
                <li>
                  <i class="ph ph-check" aria-hidden="true"></i>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-band coverage-band" aria-labelledby="coverage-title">
    <div class="section-intro">
      <span class="section-kicker">{t.pageLabel}</span>
      <h2 id="coverage-title">{t.coverageTitle}</h2>
      <p>{t.coverageText}</p>
    </div>

    <div class="coverage-grid">
      {t.coverage.map((item) => (
        <article class="coverage-card">
          <i class:list={['ph', item.icon]} aria-hidden="true"></i>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <div>
            {item.metrics.map((metric) => <span>{metric}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-band benchmark-band" aria-labelledby="benchmark-title">
    <div class="section-intro compact">
      <span class="section-kicker">Benchmark</span>
      <h2 id="benchmark-title">{t.benchmarkTitle}</h2>
      <p>{t.benchmarkText}</p>
    </div>

    <div class="benchmark-dashboard">
      {t.rows.map((row) => (
        <article class="benchmark-card" style={`--score: ${row.score};`}>
          <div class="benchmark-score">
            <strong>{row.score}</strong>
            <span>/100</span>
          </div>
          <div>
            <span>{row.channel}</span>
            <h3>{row.risk}</h3>
            <p>{row.action}</p>
          </div>
          <small>{row.impact}</small>
        </article>
      ))}
    </div>
  </section>

  <section class="split-band" aria-labelledby="deliverables-title">
    <div class="deliverable-panel">
      <span class="section-kicker">{lang === 'fr' ? 'Livrables' : 'Deliverables'}</span>
      <h2 id="deliverables-title">{t.deliverablesTitle}</h2>
      <div class="deliverable-grid">
        {t.deliverables.map((item) => (
          <span>
            <i class="ph ph-check-circle" aria-hidden="true"></i>
            {item}
          </span>
        ))}
      </div>
    </div>

    <div class="process-panel">
      <span class="section-kicker">{lang === 'fr' ? 'Méthode' : 'Method'}</span>
      <h2>{t.processTitle}</h2>
      <div class="process-list">
        {t.process.map((item) => (
          <article>
            <span>{item.step}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="audit-form-section" id="audit-form" aria-labelledby="audit-form-title">
    <div class="form-copy">
      <span class="section-kicker">{t.formLabel}</span>
      <h2 id="audit-form-title">{t.formTitle}</h2>
      <p>{t.formText}</p>
      <a class="phone-cta" href={`tel:${phone}`}>
        <small>{t.fields.callPrefix}</small>
        <strong>{t.fields.call}</strong>
        <i class="ph ph-phone-call" aria-hidden="true"></i>
      </a>
    </div>

    <form
      class="audit-form"
      action={CONTACT_FORM.action}
      method="post"
      data-contact-endpoint={CONTACT_FORM.ajaxAction}
      data-contact-form
      data-sending-message={lang === 'fr' ? 'Envoi de votre demande...' : 'Sending your request...'}
      data-success-message={lang === 'fr' ? 'Votre demande a bien été envoyée. Nous revenons vers vous rapidement.' : 'Your request has been sent. We will get back to you shortly.'}
      data-error-message={lang === 'fr' ? 'L’envoi n’a pas abouti. Appelez-nous ou écrivez-nous directement.' : 'The request could not be sent. Please call us or write to us directly.'}
    >
      <input type="hidden" name="_form" value={lang === 'fr' ? 'Audit FR' : 'Audit EN'} />
      <label class="form-honeypot" aria-hidden="true">
        <span>Website</span>
        <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
      </label>
      <label>
        <span>{t.fields.name}</span>
        <input type="text" name={t.fields.name} autocomplete="name" required />
      </label>
      <label>
        <span>{t.fields.email}</span>
        <input type="email" name={t.fields.email} autocomplete="email" required />
      </label>
      <label>
        <span>{t.fields.phone}</span>
        <input type="tel" name={t.fields.phone} autocomplete="tel" />
      </label>
      <label>
        <span>{t.fields.company}</span>
        <input type="text" name={t.fields.company} autocomplete="organization" />
      </label>
      <label>
        <span>{t.fields.website}</span>
        <input type="url" name={t.fields.website} inputmode="url" placeholder="https://" />
      </label>
      <label>
        <span>{t.fields.objective}</span>
        <select name={t.fields.objective} required>
          <option value="">{t.fields.select}</option>
          {t.fields.objectives.map((objective) => <option value={objective}>{objective}</option>)}
        </select>
      </label>
      <label class="field-wide">
        <span>{t.fields.message}</span>
        <textarea name={t.fields.message} rows="4" placeholder={t.fields.placeholder}></textarea>
      </label>
      <button class="button button-primary field-wide" type="submit">
        {t.fields.submit}
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </button>
