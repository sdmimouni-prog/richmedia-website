      },
    ],
    benchmarkTitle: 'Benchmark : ce qui se fait chez les marques performantes',
    benchmarkText:
      'Une lecture courte : score, risque, action prioritaire.',
    rows: [
      {
        channel: 'Instagram, TikTok, LinkedIn',
        score: '82',
