  },
  en: {
    pageLabel: '360 digital audit',
    title: 'Your digital audit, as a dashboard.',
    intro:
      'In 48 hours, we turn your digital presence into a score, visual benchmark and 30/60/90 action plan.',
    primaryCta: 'Request an audit',
    secondaryCta: 'Call now',
    heroBullets: ['Score by channel', 'Business priorities', 'Readout call'],
    dashboardLabel: 'Audit dashboard preview',
    maturity: 'Maturity score',
    sample: 'Sample view',
    score: '72',
    scoreLabel: 'activation potential',
    pulse: 'High priority',
    dashboardNote: 'Consolidated view: visibility, trust, conversion, data.',
    channels: [
      { label: 'Social', value: 82, tone: 'purple' },
      { label: 'Website', value: 64, tone: 'cyan' },
      { label: 'SEO/GEO', value: 51, tone: 'amber' },
      { label: 'Reputation', value: 74, tone: 'green' },
    ],
    kpis: [
      { value: '48h', label: 'to frame the first signals' },
      { value: '6', label: 'channels reviewed together' },
      { value: '30/60/90', label: 'action roadmap' },
    ],
    visualTitle: 'We audit the points that actually move growth.',
    visualCards: [
      {
        image: '/assets/richmedia-home/campaign-portfolio-uir.webp',
        label: 'Social media',
        title: 'Content, formats, engagement',
      },
      {
        image: '/assets/richmedia-ia-automation/ia-automation-hero.webp',
        label: 'Data & CRM',
        title: 'Tracking, leads, follow-up',
      },
      {
        image: '/assets/richmedia-home/contact-map.webp',
        label: 'Reputation',
        title: 'Reviews, local search, trust',
      },
    ],
    offersLabel: 'Audit formats',
    offersTitle: 'Three formats, one actionable view.',
    offers: [
      {
        badge: 'Starter',
        title: 'Express audit',
        value: '48h',
        text: 'A fast scan to prioritize social, website and first conversions.',
        image: '/assets/richmedia-home/campaign-wide-uir.webp',
        bullets: ['Fast score', 'Quick wins', '30-min call'],
      },
      {
        badge: '360',
        title: 'Full audit',
        value: '30/60/90',
        text: 'Complete benchmark: social, website, SEO/GEO, campaigns and reputation.',
        image: '/assets/richmedia-ia-automation/ia-automation-hero.webp',
        bullets: ['Dashboard', 'Benchmark', 'Roadmap'],
      },
      {
        badge: 'War room',
        title: 'Growth sprint',
        value: 'Sprint',
        text: 'Prioritization workshop with actions, owners and first tests.',
        image: '/assets/richmedia-ia-automation/agent-workflows.webp',
        bullets: ['Workshop', 'Media', 'CRM'],
      },
    ],
    coverageTitle: 'What we audit',
    coverageText:
      'Each channel is scored, benchmarked and linked to a concrete action.',
    coverage: [
      {
        icon: 'ph-share-network',
        title: 'Social media',
        text: 'Formats, cadence, engagement, UGC, influence and community quality.',
        metrics: ['Engagement', 'Formats', 'Community'],
      },
      {
        icon: 'ph-browser',
        title: 'Website & UX',
        text: 'Journeys, speed, offer clarity, mobile conversion and tracking.',
        metrics: ['Mobile UX', 'Conversion', 'Tracking'],
      },
      {
        icon: 'ph-magnifying-glass',
        title: 'SEO & AI visibility',
        text: 'Structure, business queries, content, FAQs and AI answer presence.',
        metrics: ['SEO', 'GEO', 'Content'],
      },
      {
        icon: 'ph-star',
        title: 'Online reputation',
        text: 'Reviews, mentions, comments, profiles and trust signals.',
        metrics: ['Reviews', 'Mentions', 'Trust'],
      },
      {
        icon: 'ph-chart-line-up',
        title: 'Media performance',
        text: 'Budgets, targeting, landing pages, CPA, ROAS and reporting.',
        metrics: ['CPA', 'ROAS', 'Attribution'],
      },
      {
        icon: 'ph-database',
        title: 'Data, CRM & follow-up',
        text: 'Lead capture, CRM, WhatsApp, automations and dashboards.',
