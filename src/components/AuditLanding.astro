---
import { BUSINESS, CONTACT_FORM } from '../consts';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const phone = BUSINESS.tels[0];
const phoneDisplay = phone.replace(/(\+212)(\d{3})(\d{3})(\d{3})/, '$1 $2 $3 $4');

const content = {
