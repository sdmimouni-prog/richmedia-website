        title: 'Avis, recherche locale, confiance',
      },
    ],
    offersLabel: 'Formats d’audit',
    offersTitle: 'Trois formats, une lecture actionnable.',
    offers: [
      {
        badge: 'Starter',
        title: 'Audit express',
        value: '48h',
