---
// Injecte un ou plusieurs blocs JSON-LD. Les valeurs null sont ignorées.
type JsonLdItem = object;
interface Props {
  schema: JsonLdItem | (JsonLdItem | null)[];
}
const { schema } = Astro.props;
const items = (Array.isArray(schema) ? schema : [schema]).filter((item): item is JsonLdItem => item !== null);
---
{items.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
