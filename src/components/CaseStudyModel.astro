---
interface Metric {
  value: string;
  label: string;
  note: string;
}

interface Chapter {
  eyebrow: string;
  title: string;
  text: string;
}

interface SystemStep {
  label: string;
  text: string;
}

interface GalleryItem {
  image: string;
  label: string;
  format: string;
  size?: 'wide';
}

interface CaseStudyContent {
  backHref: string;
  backLabel: string;
  eyebrow: string;
  client: string;
  clientLong: string;
  category: string;
  period: string;
  scope: string;
  title: string;
  subtitle: string;
  heroImage: string;
  video: {
    poster: string;
    title: string;
    label: string;
    meta: string;
    src?: string;
  };
  metrics: Metric[];
  chapters: Chapter[];
  system: {
    eyebrow: string;
    title: string;
    text: string;
    steps: SystemStep[];
  };
  gallery: {
    eyebrow: string;
    title: string;
    items: GalleryItem[];
  };
  quote: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  ui?: {
    snapshotLabel?: string;
    scopeLabel?: string;
    sectorLabel?: string;
    periodLabel?: string;
    resultsLabel?: string;
    storylineKicker?: string;
    storylineTitle?: string;
    takeawayLabel?: string;
  };
}

interface Props {
  content: CaseStudyContent;
}

const { content } = Astro.props;
---

<article class="case-study-model">
  <section class="case-hero" aria-labelledby="case-title">
    <div class="case-copy">
      <a class="back-link" href={content.backHref}>
        <i class="ph ph-arrow-left" aria-hidden="true"></i>
        {content.backLabel}
      </a>

      <p class="case-eyebrow">{content.eyebrow}</p>
      <h1 id="case-title">{content.title}</h1>
      <p class="case-lead">{content.subtitle}</p>

      <div class="case-actions">
        <a class="button button-primary" href={content.ctaHref}>
          {content.ctaLabel}
          <i class="ph ph-play" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href={content.secondaryHref}>
          {content.secondaryLabel}
          <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <aside class="case-snapshot" aria-label={content.ui?.snapshotLabel ?? `${content.client} snapshot`}>
      <span>Client</span>
      <strong>{content.client}</strong>
      <p>{content.clientLong}</p>
      <dl>
        <div>
          <dt>{content.ui?.scopeLabel ?? 'Scope'}</dt>
          <dd>{content.scope}</dd>
        </div>
        <div>
          <dt>{content.ui?.sectorLabel ?? 'Sector'}</dt>
          <dd>{content.category}</dd>
        </div>
        <div>
          <dt>{content.ui?.periodLabel ?? 'Period'}</dt>
          <dd>{content.period}</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="case-video-layout" id="case-video" aria-label={content.video.title}>
    <div class="video-panel">
      {content.video.src ? (
        <video poster={content.video.poster} controls preload="metadata">
          <source src={content.video.src} type="video/mp4" />
        </video>
      ) : (
        <figure>
          <img src={content.video.poster} alt="" loading="eager" decoding="async" />
          <span class="play-mark" aria-hidden="true">
            <i class="ph ph-play" aria-hidden="true"></i>
          </span>
          <figcaption>
            <small>{content.video.label}</small>
            <strong>{content.video.title}</strong>
            <span>{content.video.meta}</span>
          </figcaption>
        </figure>
      )}
    </div>

    <div class="metric-rail" aria-label={content.ui?.resultsLabel ?? 'Case study results'}>
      {content.metrics.map((metric) => (
        <article>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
          <small>{metric.note}</small>
        </article>
      ))}
    </div>
  </section>

  <section class="case-story" aria-labelledby="story-title">
    <div class="section-heading">
      <span class="section-kicker">{content.ui?.storylineKicker ?? 'Storyline'}</span>
      <h2 id="story-title">{content.ui?.storylineTitle ?? 'Brief. Move. Proof.'}</h2>
    </div>

    <div class="story-line">
      {content.chapters.map((chapter, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <small>{chapter.eyebrow}</small>
          <h3>{chapter.title}</h3>
          <p>{chapter.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="case-system" aria-labelledby="system-title">
    <div class="system-copy">
      <span class="section-kicker">{content.system.eyebrow}</span>
      <h2 id="system-title">{content.system.title}</h2>
      <p>{content.system.text}</p>
    </div>

    <div class="system-board">
      {content.system.steps.map((step, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{step.label}</strong>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="asset-gallery" aria-labelledby="gallery-title">
    <div class="gallery-head">
      <span class="section-kicker">{content.gallery.eyebrow}</span>
      <h2 id="gallery-title">{content.gallery.title}</h2>
    </div>

    <div class="gallery-grid">
      {content.gallery.items.map((item) => (
        <article class:list={['asset-card', item.size === 'wide' && 'asset-card-wide']}>
          <img src={item.image} alt={`${item.label} — ${content.client}`} loading="lazy" decoding="async" />
          <div>
            <span>{item.format}</span>
            <strong>{item.label}</strong>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="case-close" aria-label={content.ui?.takeawayLabel ?? 'Case study takeaway'}>
    <p>{content.quote}</p>
    <a href={content.secondaryHref}>
      {content.secondaryLabel}
      <i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  </section>
</article>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .case-study-model {
    --container: min(100% - 3rem, 1240px);
    --purple: #7c3cff;
    --purple-soft: #a977ff;
    --blue: #2f6bff;
    --yellow: #d8e21a;
    --line: rgba(255, 255, 255, 0.14);
    --muted: rgba(255, 255, 255, 0.68);
    min-height: 100vh;
    overflow: hidden;
    background:
      linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      linear-gradient(135deg, rgba(124, 60, 255, 0.14), transparent 32rem),
      #030407;
    background-size: 78px 78px, 78px 78px, auto, auto;
    color: #fff;
  }

  .case-hero,
  .case-video-layout,
  .case-story,
  .case-system,
  .asset-gallery,
  .case-close {
    position: relative;
    z-index: 1;
    width: var(--container);
    margin-inline: auto;
  }

  .case-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: 2rem;
    align-items: center;
    min-height: 640px;
    padding: 7.2rem 0 2.2rem;
  }

  .back-link,
  .button,
  .case-close a {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    text-decoration: none;
  }

  .back-link {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .back-link:hover {
    color: #fff;
  }

  .case-eyebrow,
  .section-kicker,
  .case-snapshot > span,
  .story-line small,
  .asset-card span,
  .video-panel small {
    color: var(--purple-soft);
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .case-eyebrow {
    margin: 2.3rem 0 1rem;
  }

  .case-copy h1 {
    max-width: 850px;
    margin: 0;
    font-size: 3.125rem;
    font-weight: 900;
    line-height: 0.98;
    text-wrap: balance;
  }

  .case-lead {
    max-width: 650px;
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.75rem;
  }

  .button {
    min-height: 3rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1rem;
    color: #fff;
    font-weight: 900;
  }

  .button-primary {
    background: linear-gradient(135deg, #8e54ff, #6324f0);
    box-shadow: 0 1rem 2.2rem rgba(124, 60, 255, 0.28);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.035);
  }

  .case-snapshot {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.15rem;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.018)),
      rgba(4, 5, 9, 0.9);
  }

  .case-snapshot strong {
    display: block;
    margin-top: 0.5rem;
    color: var(--yellow);
    font-size: 4rem;
    font-weight: 950;
    line-height: 0.85;
  }

  .case-snapshot p {
    margin: 0.9rem 0 1.2rem;
    color: rgba(255, 255, 255, 0.78);
    font-weight: 850;
    line-height: 1.35;
  }

  .case-snapshot dl {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .case-snapshot div {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 0.75rem;
  }

  .case-snapshot dt {
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-snapshot dd {
    margin: 0.25rem 0 0;
    color: #fff;
    font-weight: 850;
    line-height: 1.25;
  }

  .case-video-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 1rem;
    align-items: stretch;
  }

  .video-panel figure,
  .video-panel video {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 510px;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background: #06132d;
  }

  .video-panel img,
  .video-panel video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-panel figure::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(180deg, transparent 46%, rgba(3, 4, 7, 0.82));
    pointer-events: none;
  }

  .play-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 4.7rem;
    height: 4.7rem;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 50%;
    background: rgba(124, 60, 255, 0.92);
    color: #fff;
    font-size: 1.45rem;
    transform: translate(-50%, -50%);
  }

  .video-panel figcaption {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    left: 1.1rem;
    z-index: 2;
    display: grid;
    gap: 0.32rem;
  }

  .video-panel figcaption strong {
    font-size: 1.75rem;
    line-height: 1.05;
  }

  .video-panel figcaption span {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .metric-rail {
    display: grid;
    gap: 0.75rem;
  }

  .metric-rail article {
    display: grid;
    align-content: end;
    min-height: 9rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.035);
  }

  .metric-rail strong {
    color: #fff;
    font-size: 2.55rem;
    font-weight: 950;
    line-height: 0.9;
  }

  .metric-rail span {
    margin-top: 0.55rem;
    color: #fff;
    font-weight: 900;
    line-height: 1.15;
  }

  .metric-rail small {
    margin-top: 0.42rem;
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.78rem;
  }

  .case-story,
  .case-system,
  .asset-gallery,
  .case-close {
    margin-top: 4.7rem;
  }

  .section-heading,
  .gallery-head {
    max-width: 660px;
  }

  .section-heading h2,
  .system-copy h2,
  .gallery-head h2 {
    margin: 0.8rem 0 0;
    font-size: 2.5rem;
    line-height: 1;
    text-wrap: balance;
  }

  .story-line {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .story-line article {
    position: relative;
    padding-top: 1.3rem;
  }

  .story-line article::before {
    position: absolute;
    top: -0.28rem;
    left: 0;
    width: 0.56rem;
    height: 0.56rem;
    border-radius: 999px;
    background: var(--purple-soft);
    content: "";
    box-shadow: 0 0 1rem rgba(124, 60, 255, 0.55);
  }

  .story-line article > span {
    color: rgba(255, 255, 255, 0.28);
    font-size: 2.1rem;
    font-weight: 950;
    line-height: 1;
  }

  .story-line h3 {
    margin: 0.75rem 0 0;
    font-size: 1.4rem;
    line-height: 1.05;
  }

  .story-line p,
  .system-copy p,
  .system-board p {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.62;
  }

  .story-line p {
    margin: 0.65rem 0 0;
  }

  .case-system {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 1rem;
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.25rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.02));
  }

  .system-copy {
    display: grid;
    align-content: center;
    min-width: 0;
  }

  .system-copy p {
    max-width: 32rem;
    margin: 1rem 0 0;
  }

  .system-board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .system-board article {
    border-left: 1px solid rgba(169, 119, 255, 0.45);
    padding: 0.2rem 0 0.2rem 0.85rem;
  }

  .system-board span {
    color: var(--purple-soft);
    font-size: 0.82rem;
    font-weight: 950;
  }

  .system-board strong {
    display: block;
    margin-top: 0.9rem;
    font-size: 1.05rem;
    line-height: 1.12;
  }

  .system-board p {
    margin: 0.55rem 0 0;
    font-size: 0.82rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr 0.85fr;
    gap: 0.85rem;
    margin-top: 1.4rem;
  }

  .asset-card {
    position: relative;
    min-height: 17rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: #050507;
  }

  .asset-card-wide {
    grid-row: span 2;
    min-height: 35rem;
  }

  .asset-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .asset-card:hover img {
    transform: scale(1.035);
  }

  .asset-card div {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.26rem;
    padding: 0.95rem;
    background: linear-gradient(180deg, transparent, rgba(3, 4, 7, 0.9));
  }

  .asset-card strong {
    font-size: 1.08rem;
    line-height: 1.1;
  }

  .case-close {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: end;
    margin-bottom: 4.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: 1.4rem;
  }

  .case-close p {
    max-width: 820px;
    margin: 0;
    font-size: 1.7rem;
    font-weight: 850;
    line-height: 1.18;
    text-wrap: balance;
  }

  .case-close a {
    min-height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 7px;
    padding: 0 1rem;
    color: #fff;
    font-weight: 900;
  }

  @media (max-width: 1080px) {
    .case-hero,
    .case-video-layout,
    .case-system,
    .case-close {
      grid-template-columns: 1fr;
    }

    .case-snapshot {
      align-self: stretch;
    }

    .metric-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .system-board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .asset-card-wide {
      grid-row: auto;
      grid-column: span 2;
      min-height: 28rem;
    }
  }

  @media (max-width: 720px) {
    .case-study-model {
      --container: min(100% - 1.25rem, 420px);
      width: 100vw;
      max-width: 100vw;
      overflow-x: hidden;
    }

    .case-hero {
      min-height: auto;
      padding-top: 7rem;
    }

    .case-eyebrow {
      margin-top: 2.25rem;
    }

    .case-copy h1 {
      font-size: 2.2rem;
      line-height: 1.02;
    }

    .case-lead {
      font-size: 1rem;
    }

    .case-snapshot strong {
      font-size: 3.2rem;
    }

    .video-panel figure,
    .video-panel video {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .video-panel figcaption strong {
      font-size: 1.25rem;
    }

    .metric-rail,
    .story-line,
    .system-board,
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .section-heading h2,
    .system-copy h2,
    .gallery-head h2 {
      font-size: 1.9rem;
    }

    .story-line {
      gap: 1.4rem;
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.16);
      padding-left: 1rem;
    }

    .story-line article {
      padding-top: 0;
    }

    .story-line article::before {
      top: 0.2rem;
      left: -1.3rem;
    }

    .case-system {
      padding: 1rem;
    }

    .asset-card,
    .asset-card-wide {
      grid-column: auto;
      min-height: 16rem;
    }

    .case-close p {
      font-size: 1.28rem;
    }

    .case-close a {
      width: fit-content;
    }
  }
</style>
