<script is:inline>
  (() => {
    const root = document.querySelector('[data-result-metrics]');

    if (!root) {
      return;
    }

    const counters = [...root.querySelectorAll('[data-case-counter]')];
    const cards = [...root.querySelectorAll('[data-result-metric-card]')];
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const formatCounter = (counter, value) => {
      const prefix = counter.dataset.prefix || '';
      const suffix = counter.dataset.suffix || '';
      const decimals = Number(counter.dataset.decimals || 0);
      const formatted = decimals > 0 ? value.toFixed(decimals) : String(Math.round(value));
      counter.textContent = `${prefix}${formatted}${suffix}`;
    };

    const animateCounter = (counter) => {
      const target = Number(counter.dataset.target || 0);
      const duration = Number(counter.dataset.duration || 1250);
      const startTime = performance.now();

      formatCounter(counter, 0);

      const tick = (now) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        formatCounter(counter, target * eased);

        if (progress < 1) {
          window.requestAnimationFrame(tick);
          return;
        }

        formatCounter(counter, target);
      };

      window.requestAnimationFrame(tick);
    };

    const revealCounters = () => {
      root.classList.add('is-counting');

      counters.forEach((counter) => {
        if (counter.dataset.counted === 'true') {
          return;
        }

        counter.dataset.counted = 'true';

        if (prefersReducedMotion) {
          formatCounter(counter, Number(counter.dataset.target || 0));
          return;
        }

        animateCounter(counter);
      });
    };

    cards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const bounds = card.getBoundingClientRect();
        const x = event.clientX - bounds.left;
        const y = event.clientY - bounds.top;
        const tiltY = ((x / bounds.width) - 0.5) * 7;
        const tiltX = ((0.5 - y / bounds.height) * 5).toFixed(2);

        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
        card.style.setProperty('--tilt-x', `${tiltX}deg`);
        card.style.setProperty('--tilt-y', `${tiltY.toFixed(2)}deg`);
      });

      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--tilt-x');
        card.style.removeProperty('--tilt-y');
      });
    });

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      revealCounters();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          revealCounters();
          observer.disconnect();
        }
      },
      { threshold: 0.34 },
    );

    observer.observe(root);
  })();
</script>
