---
import BarometerDownloadBox from './BarometerDownloadBox.astro';

interface Metric {
  value: string;
  label: string;
  note?: string;
  noteTrend?: boolean;
  qualitative?: boolean;
  icon?: string;
}

interface MetaItem {
  label: string;
  value: string;
}

interface WorkItem {
  eyebrow: string;
  title: string;
  text: string;
  icon?: string;
  bullets?: string[];
}

interface ProofItem {
  image: string;
  label: string;
  format: string;
  size?: 'feed' | 'story' | 'banner' | 'dashboard' | 'event' | 'engineering' | 'parcours' | 'ready' | 'landing' | 'quote' | 'keys';
}

interface CaseStudyContent {
  backHref: string;
  backLabel: string;
  eyebrow: string;
  client: string;
  clientLong: string;
  category: string;
  period: string;
  scope: string;
  title: string;
  subtitle: string;
  heroImage: string;
  heroAlt?: string;
  heroCompact?: boolean;
  metrics: Metric[];
  metaItems?: MetaItem[];
  deliverables?: string[];
  work: WorkItem[];
  proof: {
    eyebrow: string;
    title: string;
    intro: string;
    items: ProofItem[];
    kpi?: {
      value: string;
      label: string;
      breakdown: string[];
      note?: string;
    };
    funnel?: {
      items: {
        value: string;
        label: string;
      }[];
      note?: string;
    };
    conclusion?: string;
    links?: {
      href: string;
      label: string;
    }[];
  };
  quote: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  ui?: {
    resultLabel?: string;
    metaLabel?: string;
    workLabel?: string;
    workTitle?: string;
    proofLabel?: string;
    quoteLabel?: string;
    deliverablesTitle?: string;
  };
}

interface Props {
  content: CaseStudyContent;
}

const { content } = Astro.props;

const assetBase = '/assets/richmedia-case-study';
const metaItems =
  content.metaItems ??
  [
    { label: 'Client', value: content.client },
    { label: 'Secteur', value: content.category },
    { label: 'Période', value: content.period },
    { label: 'Canal', value: content.scope },
  ];
const deliverables =
  content.deliverables ??
  ['Stratégie & plan média', 'Identité créative', 'Kits formats (15+)', 'Landing page', 'Tracking & dashboards', 'Rapport de performance'];

const parseCounter = (raw: string, mustStartWithNumber = false) => {
  const value = raw.trim();

  if (mustStartWithNumber && !/^[+-]?\d/.test(value)) {
    return undefined;
  }

  const match = value.match(/^([^0-9]*?)(-?\d+(?:[.,]\d+)?)(.*)$/);

  if (!match) return undefined;

  const [, prefix, numeric, suffix] = match;
  const normalized = numeric.replace(',', '.');
  const decimals = normalized.includes('.') ? normalized.split('.')[1]?.length ?? 0 : 0;

  return {
    prefix,
    target: Number(normalized),
    suffix,
    decimals,
  };
};

const animatedMetrics = content.metrics.map((metric, index) => ({
  ...metric,
  count: metric.qualitative ? undefined : parseCounter(metric.value),
  noteCount: metric.note ? parseCounter(metric.note, true) : undefined,
  delay: index * 105,
  duration: 1120 + index * 95,
}));
const isProofCompact = content.proof.items.length <= 4 && !content.proof.funnel;
---

<article class:list={['case-study-model', content.heroCompact && 'is-hero-compact']}>
  <section class="case-section case-result-block" aria-labelledby="case-title">
    <div class="section-rail" aria-hidden="true">
      <strong>01</strong>
      <span></span>
    </div>

    <div class="result-grid">
      <div class="result-copy">
        <span class="block-kicker">Bloc 1</span>
        <h1 id="case-title">{content.title}</h1>
        <img class="heading-stroke" src={`${assetBase}/purple-underline.png`} alt="" width="270" height="38" loading="eager" decoding="async" />
        <p>{content.subtitle}</p>

        <dl class="case-meta" aria-label={content.ui?.metaLabel ?? 'Résumé du cas client'}>
          {metaItems.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="result-visual">
        <img
          src={content.heroImage}
          alt={content.heroAlt ?? `${content.client} - campagne Richmedia`}
          width="2154"
          height="1338"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="result-metrics" data-result-metrics aria-label={content.ui?.resultLabel ?? 'Résultats du cas client'}>
          {animatedMetrics.map((metric) => (
            <article class:list={['result-metric-card', !metric.count && 'is-qualitative']} data-result-metric-card style={`--metric-delay: ${metric.delay}ms;`}>
              <i class:list={['result-metric-icon', metric.icon ?? 'ph ph-chart-line-up']} aria-hidden="true"></i>
              <div class="result-metric-copy">
                {metric.count ? (
                  <strong
                    class="result-metric-value"
                    data-counter
                    data-case-counter
                    data-target={metric.count.target}
                    data-prefix={metric.count.prefix}
                    data-suffix={metric.count.suffix}
                    data-decimals={metric.count.decimals}
                    data-duration={metric.duration}
                  >
                    {metric.value}
                  </strong>
                ) : (
                  <strong class="result-metric-value is-qualitative-value">{metric.value}</strong>
                )}
                <span class="result-metric-label">{metric.label}</span>
                {metric.note && (
                  <small class="result-metric-note">
                    {metric.noteTrend !== false && <span class="trend-arrow" aria-hidden="true">▲</span>}
                    {metric.noteCount ? (
                      <span
                        data-counter
                        data-case-counter
                        data-target={metric.noteCount.target}
                        data-prefix={metric.noteCount.prefix}
                        data-suffix={metric.noteCount.suffix}
                        data-decimals={metric.noteCount.decimals}
                        data-duration={metric.duration + 180}
                      >
                        {metric.note}
                      </span>
                    ) : (
                      <span>{metric.note}</span>
                    )}
                  </small>
                )}
              </div>
            </article>
          ))}
        </div>
        <figcaption class="sr-only">
          {content.metrics.map((metric) => `${metric.value} ${metric.label} ${metric.note ?? ''}`).join(', ')}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="case-section case-work-block" aria-labelledby="work-title">
    <div class="section-rail" aria-hidden="true">
      <strong>02</strong>
      <span></span>
    </div>

    <div class="work-shell">
      <div class="work-head">
        <span class="block-kicker">{content.ui?.workLabel ?? 'Bloc 2'}</span>
        <h2 id="work-title">{content.ui?.workTitle ?? 'Ce Qu’on A Fait'}</h2>
        <img class="heading-stroke heading-stroke-small" src={`${assetBase}/purple-underline-large.png`} alt="" loading="lazy" decoding="async" />
        <p>{content.eyebrow}</p>
      </div>

      <div class="process-area">
        <div class="process-track" aria-hidden="true">
          {content.work.map((_, index) => (
            <span>{String(index + 1).padStart(2, '0')}</span>
          ))}
          <i class="ph ph-arrow-right"></i>
        </div>

        <div class="process-grid">
          {content.work.map((item) => (
            <article class="process-card">
              <i class={item.icon ?? 'ph ph-arrow-up-right'} aria-hidden="true"></i>
              <h3>{item.title}</h3>
              <span class="card-rule" aria-hidden="true"></span>
              <ul>
                {(item.bullets ?? [item.text]).map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}

          <aside class="deliverables-card">
            <header>
              <i class="ph ph-briefcase" aria-hidden="true"></i>
              <h3>{content.ui?.deliverablesTitle ?? 'Livrables'}</h3>
            </header>
            <ul>
              {deliverables.map((item) => (
                <li>
                  <i class="ph ph-check-circle" aria-hidden="true"></i>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="case-section case-proof-block" aria-labelledby="proof-title">
    <div class="section-rail" aria-hidden="true">
      <strong>03</strong>
      <span></span>
    </div>

    <div class:list={['proof-shell', `proof-count-${content.proof.items.length}`, content.proof.funnel && 'is-proof-funnel', isProofCompact && 'is-proof-compact']}>
      <header class="proof-head">
        <span class="block-kicker">{content.proof.eyebrow}</span>
        <h2 id="proof-title">{content.proof.title}</h2>
        <img class="heading-stroke heading-stroke-proof" src={`${assetBase}/purple-underline-large.png`} alt="" loading="lazy" decoding="async" />
        <p class="sr-only">{content.proof.intro}</p>
      </header>

      <div class="proof-stage" aria-label={content.ui?.proofLabel ?? 'Preuves visuelles'}>
        {content.proof.items.map((item) => (
          <article class:list={['proof-asset', item.size && `proof-${item.size}`]}>
            <img src={item.image} alt={`${item.label} - ${item.format}`} loading="lazy" decoding="async" />
          </article>
        ))}
      </div>

      {(content.proof.kpi || content.proof.funnel || content.proof.conclusion || content.proof.links?.length) && (
        <div class:list={['proof-insight-row', content.proof.funnel && 'has-funnel']}>
          {content.proof.kpi && (
            <aside class="proof-kpi-card">
              <strong>{content.proof.kpi.value}</strong>
              <span>{content.proof.kpi.label}</span>
              <ul>
                {content.proof.kpi.breakdown.map((item) => <li>{item}</li>)}
              </ul>
              {content.proof.kpi.note && <small>{content.proof.kpi.note}</small>}
            </aside>
          )}

          {content.proof.funnel && (
            <aside class="proof-funnel-card">
              <ol>
                {content.proof.funnel.items.map((item, index) => (
                  <li>
                    <strong>{item.value}</strong>
                    <span>{item.label}</span>
                    {index < content.proof.funnel!.items.length - 1 && <i class="ph ph-arrow-down" aria-hidden="true"></i>}
                  </li>
                ))}
              </ol>
              {content.proof.funnel.note && <small>{content.proof.funnel.note}</small>}
            </aside>
          )}

          {(content.proof.conclusion || content.proof.links?.length) && (
            <div class="proof-conclusion-card">
              {content.proof.conclusion && <p>{content.proof.conclusion}</p>}
              {content.proof.links?.length && (
                <nav aria-label={content.ui?.quoteLabel ?? 'Liens associés'}>
                  {content.proof.links.map((link) => <a href={link.href}>{link.label}</a>)}
                </nav>
              )}
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <BarometerDownloadBox />
</article>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  :global(body:has(.case-study-model) .primary-nav > a[href="/realisations"]) {
    position: relative;
    color: #fff;
  }

  :global(body:has(.case-study-model) .primary-nav > a[href="/realisations"]::after) {
    position: absolute;
    right: 0;
    bottom: -1.05rem;
    left: 0;
    height: 2px;
    border-radius: 999px;
    content: "";
    background: #a85cff;
    box-shadow: 0 0 1.2rem rgba(168, 92, 255, 0.6);
  }

  :global(body:has(.case-study-model) .site-footer) {
    position: relative;
    width: min(100% - 10rem, 1500px);
    padding-top: 2.55rem;
    background: transparent;
  }

  :global(body:has(.case-study-model) .site-header) {
    padding-inline: clamp(5.4rem, 5.35vw, 5.6rem);
  }

  .case-study-model {
    --bg: #02050d;
    --panel: rgba(11, 9, 23, 0.78);
    --purple: #a65cff;
    --line: rgba(168, 92, 255, 0.34);
    --muted: rgba(255, 255, 255, 0.72);
    --left-pad: clamp(4.7rem, 5.25vw, 5.6rem);
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 2% 77%, rgba(111, 40, 255, 0.22), transparent 16rem),
      radial-gradient(circle at 92% 2%, rgba(106, 47, 255, 0.14), transparent 18rem),
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      var(--bg);
    background-size: auto, auto, 48px 48px, 48px 48px, auto;
    color: #fff;
  }

  .case-section {
    position: relative;
  }

  .section-rail {
    position: absolute;
    top: 6.2rem;
    left: clamp(1.35rem, 2.15vw, 3.2rem);
    z-index: 5;
    display: grid;
    justify-items: center;
    width: 3rem;
    color: var(--purple);
    pointer-events: none;
  }

  .section-rail strong {
    font-family: var(--font-numeric);
    font-size: clamp(1.75rem, 2.4vw, 2.3rem);
    font-weight: 800;
    line-height: 0.92;
  }

  .section-rail strong::after {
    display: block;
    width: 2.45rem;
    height: 1px;
    margin: 0.72rem auto 0;
    content: "";
    background: var(--line);
  }

  .section-rail span {
    position: relative;
    display: block;
    width: 1px;
    height: calc(100vh - 10rem);
    margin-top: 0.58rem;
    background: linear-gradient(180deg, rgba(166, 92, 255, 0.85), rgba(255, 255, 255, 0.18));
  }

  .section-rail span::before {
    position: absolute;
    top: -0.23rem;
    left: 50%;
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 999px;
    content: "";
    background: var(--purple);
    box-shadow: 0 0 1.1rem rgba(166, 92, 255, 0.9);
    transform: translateX(-50%);
  }

  .block-kicker {
    display: inline-block;
    color: var(--purple);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.32em;
    line-height: 1;
    text-transform: uppercase;
  }

  .heading-stroke {
    width: 16.9rem;
    height: auto;
    margin-top: 1.15rem;
    margin-left: -0.35rem;
  }

  .case-result-block {
    min-height: 54.7rem;
    margin-top: 40px;
    padding-top: calc(7.85rem + 20px);
  }

  .case-result-block .section-rail {
    top: calc(6.05rem + 20px);
  }

  .result-grid {
    display: grid;
    grid-template-columns: minmax(23rem, 26.8rem) minmax(0, 1fr);
    gap: clamp(3.5rem, 4.7vw, 5rem);
    align-items: start;
    padding-left: var(--left-pad);
  }

	  .result-copy {
	    max-width: 27.3rem;
	    padding-top: 2.65rem;
	  }

  .result-copy h1,
  .work-head h2,
  .proof-head h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 900;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .result-copy h1 {
    margin-top: 1.6rem;
    font-size: clamp(3.85rem, 4.55vw, 4.75rem) !important;
    line-height: 0.95;
    white-space: nowrap;
  }

	  .result-copy p {
	    max-width: 26.8rem;
	    margin: 1.55rem 0 0;
	    color: rgba(255, 255, 255, 0.78);
	    font-size: clamp(1.0625rem, 1.04vw, 1.1rem);
	    font-weight: 400;
	    line-height: 1.58;
	  }

	  .case-meta {
	    display: grid;
	    gap: 0;
	    max-width: 26.2rem;
	    margin: 2.55rem 0 0;
	  }

	  .case-meta div {
	    display: grid;
	    grid-template-columns: 7.45rem minmax(0, 1fr);
	    gap: 0.85rem;
	    min-height: 2.18rem;
	    align-items: start;
	    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	    padding: 0.2rem 0 0.45rem;
	  }

  .case-meta dt,
  .case-meta dd {
    margin: 0;
  }

	  .case-meta dt {
	    color: var(--purple);
	    font-size: 1.0625rem;
	    font-weight: 900;
	    letter-spacing: 0.2em;
	    text-transform: uppercase;
	  }

	  .case-meta dd {
	    color: #fff;
	    font-size: 1.0625rem;
	    font-weight: 800;
	    line-height: 1.18;
	    letter-spacing: 0.02em;
	  }

  .result-visual {
    position: relative;
    z-index: 1;
    min-width: 0;
    margin: 0;
    filter: drop-shadow(0 2.2rem 4.2rem rgba(0, 0, 0, 0.46));
  }

  .result-visual::before {
    position: absolute;
    top: 0.15rem;
    bottom: 1.2rem;
    left: -2.45rem;
    width: 1px;
    content: "";
    background: linear-gradient(180deg, rgba(167, 91, 255, 0.55), rgba(255, 255, 255, 0.12));
    transform: skewX(-5deg);
    transform-origin: top;
  }

  .result-visual img {
    width: 100%;
    min-height: 41.8rem;
    object-fit: cover;
  }

  .result-metrics {
    position: absolute;
    top: 2.38%;
    right: 4.2%;
    z-index: 3;
    display: grid;
    width: min(32.5%, 20.75rem);
    gap: clamp(0.58rem, 0.78vw, 0.82rem);
    perspective: 980px;
  }

  .result-metric-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(2.65rem, 3.55rem) minmax(0, 1fr);
    gap: clamp(0.5rem, 0.82vw, 0.78rem);
    align-items: center;
    min-height: clamp(5.85rem, 7.62vw, 8.68rem);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 15px;
    padding: clamp(0.82rem, 1.16vw, 1.14rem) clamp(0.85rem, 1.36vw, 1.38rem);
    background:
      radial-gradient(circle at var(--mouse-x, 12%) var(--mouse-y, 20%), rgba(124, 54, 255, 0.22), transparent 34%),
      linear-gradient(145deg, rgba(29, 16, 61, 0.95), rgba(3, 6, 16, 0.985) 62%),
      rgba(5, 6, 17, 0.98);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 1.2rem 2.4rem rgba(0, 0, 0, 0.42);
    opacity: 0.995;
    transform: translate3d(0, 0, 0);
    transform-style: preserve-3d;
    transition:
      transform 420ms cubic-bezier(0.18, 1, 0.24, 1),
      border-color 280ms ease,
      box-shadow 280ms ease,
      background 280ms ease;
  }

  .result-metrics.is-counting .result-metric-card {
    animation: resultMetricIn 720ms cubic-bezier(0.18, 1, 0.24, 1) backwards;
    animation-delay: var(--metric-delay);
  }

  .result-metric-card::before,
  .result-metric-card::after {
    position: absolute;
    content: "";
    pointer-events: none;
  }

  .result-metric-card::before {
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background:
      radial-gradient(circle at var(--mouse-x, 20%) var(--mouse-y, 20%), rgba(176, 99, 255, 0.46), transparent 31%),
      linear-gradient(135deg, rgba(166, 92, 255, 0.68), transparent 36%, rgba(87, 255, 147, 0.26));
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .result-metric-card::after {
    top: -42%;
    bottom: -42%;
    left: -58%;
    width: 38%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    filter: blur(1px);
    transform: rotate(18deg) translateX(0);
  }

  .result-metric-card:hover {
    border-color: rgba(181, 105, 255, 0.82);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.13),
      0 1.2rem 2.7rem rgba(0, 0, 0, 0.48),
      0 0 2.2rem rgba(153, 82, 255, 0.38);
    transform: translate3d(-0.55rem, -0.1rem, 1.5rem) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)) scale(1.025);
  }

  .result-metric-card:hover::before {
    opacity: 1;
  }

  .result-metric-card:hover::after {
    animation: resultMetricSweep 760ms ease both;
  }

  .result-metric-card:hover .result-metric-icon {
    animation: resultMetricIcon 1120ms ease-in-out infinite;
  }

  .result-metric-card.is-qualitative {
    grid-template-columns: minmax(2.35rem, 3rem) minmax(0, 1fr);
  }

  .result-metric-icon {
    color: var(--purple);
    font-size: clamp(1.85rem, 2.55vw, 2.55rem);
    line-height: 1;
    text-shadow: 0 0 1rem rgba(166, 92, 255, 0.68);
    transform: translateZ(2.2rem);
  }

  .result-metric-copy {
    min-width: 0;
    transform: translateZ(2.8rem);
  }

  .result-metric-value {
    display: block;
    color: #fff;
    font-family: var(--font-numeric);
    font-size: clamp(1.9rem, 2.68vw, 2.92rem);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.92;
    white-space: nowrap;
    text-shadow: 0 0 1.45rem rgba(255, 255, 255, 0.14);
  }

  .result-metric-value.is-qualitative-value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.5vw, 1.62rem);
    line-height: 1.02;
    white-space: normal;
  }

  .result-metric-label {
    display: block;
    margin-top: 0.48rem;
    color: rgba(255, 255, 255, 0.93);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.16;
  }

  .result-metric-note {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    margin-top: 0.5rem;
    color: #51f18a;
    font-family: var(--font-numeric);
    font-size: 1.0625rem;
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 0 0.9rem rgba(81, 241, 138, 0.28);
  }

  .result-metric-card.is-qualitative .result-metric-note {
    display: block;
    color: rgba(81, 241, 138, 0.88);
    font-family: inherit;
    font-size: 0.84rem;
    line-height: 1.25;
    white-space: normal;
  }

  .case-study-model.is-hero-compact .case-result-block {
    min-height: min(100vh, 45rem);
    padding-top: calc(clamp(4.7rem, 5vw, 5.45rem) + 20px);
    padding-bottom: 1.2rem;
  }

  .case-study-model.is-hero-compact .case-result-block .section-rail {
