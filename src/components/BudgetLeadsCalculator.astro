---
import { CONTACT_FORM, SITE } from '../consts';

type Lang = 'fr' | 'en';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;

const isEnglish = lang === 'en';

const t = isEnglish
  ? {
      eyebrow: 'Richmedia tools',
      title: 'Media Budget & Leads Calculator',
      intro:
        'Estimate a media budget or expected lead volume using ranges from the Richmedia 2026 Digital Marketing Barometer.',
      primaryCta: 'Start calculating',
      secondaryCta: 'See methodology',
      calculatorTitle: 'Calculator settings',
      calculatorText: 'Choose a mode, a sector, a channel and enter your target. Results stay visible while you request a tailored estimate.',
      budgetMode: 'Budget → estimated leads',
      leadsMode: 'Lead target → estimated budget',
      sector: 'Sector',
      educationSegment: 'Education segment',
      channel: 'Channel',
      budgetLabel: 'Media budget in MAD',
      budgetHelp: 'Example: 50000',
      leadsLabel: 'Target number of leads',
      leadsHelp: 'Example: 450',
      calculate: 'Calculate',
      resultsTitle: 'Estimated result',
      resultReady: 'Your range is ready',
      cplUsed: 'CPL range used',
      leadsMin: 'Minimum leads',
      leadsMax: 'Maximum leads',
      budgetMin: 'Minimum budget',
      budgetMax: 'Maximum budget',
      methodologyTitle: 'Method used',
      budgetFormula: 'Minimum leads = budget ÷ maximum CPL. Maximum leads = budget ÷ minimum CPL.',
      leadsFormula: 'Minimum budget = leads × minimum CPL. Maximum budget = leads × maximum CPL.',
      googleNote: 'Leads generally more qualified',
      linkedinNote: 'LinkedIn coefficient applied: minimum CPL ×2 and maximum CPL ×3.',
      mixNote: 'Sector reference range used without coefficient.',
      metaNote: 'Sector reference range used.',
      disclaimer:
        'Estimate based on ranges observed in Richmedia campaigns from 2022 to 2026. Actual performance depends on the offer, target, creative assets, conversion journey and tracking quality.',
      barometer: 'Read the 2026 Barometer',
      ctaEyebrow: 'Custom benchmark',
      ctaTitle: 'Receive a tailored Richmedia estimate',
      ctaText:
        'Share your details and we will use your calculator result as a starting point for a sharper estimate.',
      name: 'Name',
      email: 'Work email',
      company: 'Company',
      phone: 'Phone, optional',
      send: 'Request my estimate',
      sending: 'Sending...',
      success: 'Your request has been sent.',
      error: 'The request could not be sent. Please contact us directly.',
      consent: 'I agree to be contacted by Richmedia about this estimate.',
      hiddenForm: 'Media budget calculator EN',
      resultMode: 'Mode',
      resultSector: 'Sector',
      resultChannel: 'Channel',
      resultInput: 'Input',
      resultOutput: 'Estimated output',
      requiredError: 'Please enter a positive value to calculate.',
      categoriesEyebrow: 'Benchmarks',
      categoriesTitle: 'Ranges by business context',
      categoriesText:
        'The calculator avoids generic averages. Education segments and acquisition channels change the CPL range automatically.',
    }
  : {
      eyebrow: 'Outils Richmedia',
      title: 'Calculateur Budget Média & Leads',
      intro:
        'Estimez un budget média ou un volume de leads attendu à partir des fourchettes du Baromètre Richmedia 2026.',
      primaryCta: 'Lancer le calcul',
      secondaryCta: 'Voir la méthode',
      calculatorTitle: 'Paramètres du calcul',
      calculatorText:
        'Choisissez un mode, un secteur, un canal et entrez votre objectif. Le résultat reste visible pendant la demande d’estimation personnalisée.',
      budgetMode: 'Budget → leads estimés',
      leadsMode: 'Objectif leads → budget estimé',
      sector: 'Secteur',
      educationSegment: 'Segment éducation',
      channel: 'Canal',
      budgetLabel: 'Budget média en MAD',
      budgetHelp: 'Exemple : 50000',
      leadsLabel: 'Nombre de leads visé',
      leadsHelp: 'Exemple : 450',
      calculate: 'Calculer',
      resultsTitle: 'Résultat estimé',
      resultReady: 'Votre fourchette est prête',
      cplUsed: 'Fourchette CPL utilisée',
      leadsMin: 'Leads minimum',
      leadsMax: 'Leads maximum',
      budgetMin: 'Budget minimum',
      budgetMax: 'Budget maximum',
      methodologyTitle: 'Méthode utilisée',
      budgetFormula: 'Leads minimum = budget ÷ CPL maximum. Leads maximum = budget ÷ CPL minimum.',
      leadsFormula: 'Budget minimum = leads × CPL minimum. Budget maximum = leads × CPL maximum.',
      googleNote: 'Leads généralement plus qualifiés',
      linkedinNote: 'Coefficient LinkedIn appliqué : CPL minimum ×2 et CPL maximum ×3.',
      mixNote: 'Fourchette sectorielle utilisée sans coefficient.',
      metaNote: 'Fourchette sectorielle de référence utilisée.',
      disclaimer:
        'Estimation basée sur les fourchettes observées dans les campagnes Richmedia 2022–2026. Les performances réelles dépendent notamment de l’offre, de la cible, des créations, du parcours de conversion et de la qualité du tracking.',
      barometer: 'Lire le Baromètre 2026',
      ctaEyebrow: 'Benchmark sur-mesure',
      ctaTitle: 'Recevoir une estimation personnalisée Richmedia',
      ctaText:
        'Laissez vos coordonnées : on repart du résultat calculé pour affiner l’estimation selon votre offre, votre cible et votre tunnel.',
      name: 'Nom',
      email: 'Email professionnel',
      company: 'Entreprise',
      phone: 'Téléphone facultatif',
      send: 'Demander mon estimation',
      sending: 'Envoi en cours...',
      success: 'Votre demande a bien été envoyée.',
      error: "L'envoi n'a pas abouti. Merci de nous contacter directement.",
      consent: 'J’accepte d’être contacté(e) par Richmedia au sujet de cette estimation.',
      hiddenForm: 'Calculateur budget media FR',
      resultMode: 'Mode',
      resultSector: 'Secteur',
      resultChannel: 'Canal',
      resultInput: 'Saisie',
      resultOutput: 'Sortie estimée',
      requiredError: 'Entrez une valeur positive pour lancer le calcul.',
      categoriesEyebrow: 'Benchmarks',
      categoriesTitle: 'Fourchettes par contexte business',
      categoriesText:
        'Le calculateur évite la moyenne générique. Les segments éducation et les canaux d’acquisition ajustent automatiquement la fourchette CPL.',
    };

const formSubject = `[Richmedia] ${t.hiddenForm}`;
const formRedirect = isEnglish
  ? `${SITE.url}/en/tools/media-budget-leads-calculator/?sent=1`
  : `${SITE.url}/outils/calculateur-budget-media-leads/?sent=1`;

const sectors = isEnglish
  ? [
      { value: 'education', label: 'Education' },
      { value: 'real_estate', label: 'Real estate' },
      { value: 'automotive', label: 'Automotive' },
      { value: 'retail_gms', label: 'Retail / grocery retail' },
      { value: 'tourism', label: 'Tourism' },
      { value: 'banking_insurance', label: 'Banking / Insurance' },
    ]
  : [
      { value: 'education', label: 'Éducation' },
      { value: 'real_estate', label: 'Immobilier' },
      { value: 'automotive', label: 'Automobile' },
      { value: 'retail_gms', label: 'Retail / GMS' },
      { value: 'tourism', label: 'Tourisme' },
      { value: 'banking_insurance', label: 'Banque / Assurance' },
    ];

const educationSegments = isEnglish
  ? [
      { value: 'bachelier', label: 'High-school graduate', min: 20, max: 40 },
      { value: 'master', label: 'Master', min: 20, max: 50 },
      { value: 'mba', label: 'Executive education / MBA', min: 60, max: 120 },
    ]
  : [
      { value: 'bachelier', label: 'Bachelier', min: 20, max: 40 },
      { value: 'master', label: 'Master', min: 20, max: 50 },
      { value: 'mba', label: 'Formation continue / MBA', min: 60, max: 120 },
    ];

const channels = [
  { value: 'meta', label: 'Meta Ads' },
  { value: 'google', label: 'Google Ads' },
  { value: 'linkedin', label: 'LinkedIn Ads' },
  { value: 'mix', label: 'Mix Meta + Google' },
];

const calculatorConfig = {
  lang,
  labels: {
    budgetMode: t.budgetMode,
    leadsMode: t.leadsMode,
    cplUsed: t.cplUsed,
    leadsMin: t.leadsMin,
    leadsMax: t.leadsMax,
    budgetMin: t.budgetMin,
    budgetMax: t.budgetMax,
    resultReady: t.resultReady,
    budgetFormula: t.budgetFormula,
    leadsFormula: t.leadsFormula,
    googleNote: t.googleNote,
    linkedinNote: t.linkedinNote,
    mixNote: t.mixNote,
    metaNote: t.metaNote,
    resultMode: t.resultMode,
    resultSector: t.resultSector,
    resultChannel: t.resultChannel,
    resultInput: t.resultInput,
    resultOutput: t.resultOutput,
    budgetLabel: t.budgetLabel,
    leadsLabel: t.leadsLabel,
    requiredError: t.requiredError,
  },
  ranges: {
    education: {
      segments: Object.fromEntries(educationSegments.map(({ value, min, max }) => [value, { min, max }])),
    },
    real_estate: { min: 25, max: 220 },
    automotive: { min: 30, max: 100 },
    retail_gms: { min: 8, max: 35 },
    tourism: { min: 20, max: 70 },
    banking_insurance: { min: 40, max: 120 },
  },
};

const benchmarkCards = isEnglish
  ? [
      { label: 'Education', note: 'High-school, master and executive programs.', range: '20–120 MAD', meter: '55%' },
      { label: 'Real estate', note: 'Lead cost varies strongly by ticket and intent.', range: '25–220 MAD', meter: '100%' },
      { label: 'Automotive', note: 'Useful for test drives, financing and model demand.', range: '30–100 MAD', meter: '45%' },
      { label: 'Retail / grocery', note: 'Lower CPL when offer and stock are clear.', range: '8–35 MAD', meter: '18%' },
      { label: 'Tourism', note: 'Seasonality and destination intent move the range.', range: '20–70 MAD', meter: '32%' },
      { label: 'Banking / Insurance', note: 'Qualification and compliance raise CPL levels.', range: '40–120 MAD', meter: '55%' },
    ]
  : [
      { label: 'Éducation', note: 'Bachelier, master et formation continue.', range: '20–120 MAD', meter: '55%' },
      { label: 'Immobilier', note: 'CPL très variable selon ticket et intention.', range: '25–220 MAD', meter: '100%' },
      { label: 'Automobile', note: 'Essais, financement et demande par modèle.', range: '30–100 MAD', meter: '45%' },
      { label: 'Retail / GMS', note: 'CPL plus bas si offre et stock sont lisibles.', range: '8–35 MAD', meter: '18%' },
      { label: 'Tourisme', note: 'Saisonnalité et intention destination pèsent fort.', range: '20–70 MAD', meter: '32%' },
      { label: 'Banque / Assurance', note: 'Qualification et conformité élèvent la fourchette.', range: '40–120 MAD', meter: '55%' },
    ];
---

<div class="budget-tool" data-budget-tool>
  <section class="tool-hero" aria-labelledby="calculator-title">
    <div class="tool-hero-copy">
      <span class="section-kicker">{t.eyebrow}</span>
      <h1 id="calculator-title">{t.title}</h1>
      <p>{t.intro}</p>
      <div class="tool-actions">
        <a class="tool-button tool-button-primary" href="#calculator-panel">
          {t.primaryCta}
          <i class="ph ph-calculator" aria-hidden="true"></i>
        </a>
        <a class="tool-button tool-button-secondary" href="#methodology">
          {t.secondaryCta}
          <i class="ph ph-arrow-down" aria-hidden="true"></i>
        </a>
      </div>
    </div>
    <aside class="tool-console dashboard-console" aria-label={isEnglish ? 'Media performance dashboard preview' : 'Aperçu du tableau de bord média'}>
      <div class="dashboard-hidden-preview" aria-hidden="true" hidden>
        <span data-preview-cpl>20–40 MAD</span>
        <span data-preview-leads>1 250–2 500</span>
      </div>
      <div class="dashboard-header">
        <div class="console-top" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <h2>{isEnglish ? 'Dashboard — 2026 admissions campaign' : 'Tableau de bord — Campagne inscriptions 2026'}</h2>
      </div>

      <div class="dashboard-kpis" aria-label={isEnglish ? 'Key campaign indicators' : 'Indicateurs clés de campagne'}>
        <article>
          <span>{isEnglish ? 'Qualified leads' : 'Leads qualifiés'}</span>
          <strong data-dashboard-count data-count-to="38756" data-count-format="number">0</strong>
          <small class="is-up">▲ 164%</small>
        </article>
        <article>
          <span>{isEnglish ? 'Impressions' : 'Impressions'}</span>
          <strong data-dashboard-count data-count-to="22.4" data-count-format="million" data-count-decimals="1">0</strong>
          <small>-17,5%</small>
        </article>
        <article>
          <span>CTR</span>
          <strong data-dashboard-count data-count-to="1.68" data-count-format="percent" data-count-decimals="2">0%</strong>
          <small class="is-up">▲ 28%</small>
        </article>
        <article>
          <span>{isEnglish ? 'Registration rate' : 'Taux d’inscription'}</span>
          <strong data-dashboard-count data-count-to="20.3" data-count-format="percent" data-count-decimals="1">0%</strong>
          <small class="is-up">▲ 25%</small>
        </article>
      </div>

      <div class="dashboard-chart">
        <div class="dashboard-chart-head">
          <strong>{isEnglish ? 'Qualified leads growth' : 'Évolution des leads qualifiés'}</strong>
          <span>{isEnglish ? 'May — Oct.' : 'Mai — Oct.'}</span>
        </div>
        <div class="dashboard-chart-wrap">
          <div class="dashboard-y-axis" aria-hidden="true">
            <span>40K</span>
            <span>20K</span>
            <span>10K</span>
            <span>0</span>
          </div>
          <svg class="dashboard-svg" viewBox="0 0 620 250" role="img" aria-label={isEnglish ? 'Line chart showing growth in qualified leads' : 'Courbe de progression des leads qualifiés'}>
            <defs>
              <linearGradient id="budgetDashboardArea" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="#8b4cff" stop-opacity="0.48" />
                <stop offset="100%" stop-color="#8b4cff" stop-opacity="0.02" />
              </linearGradient>
              <filter id="budgetDashboardGlow" x="-20%" y="-60%" width="140%" height="220%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>
            <path class="dashboard-area" d="M28 214 L78 186 L132 187 L184 162 L238 138 L292 165 L348 136 L404 101 L458 108 L512 126 L566 101 L604 50 L604 220 L28 220 Z"></path>
            <path class="dashboard-line" d="M28 214 L78 186 L132 187 L184 162 L238 138 L292 165 L348 136 L404 101 L458 108 L512 126 L566 101 L604 50"></path>
            {[
              [28, 214],
              [78, 186],
              [132, 187],
              [184, 162],
              [238, 138],
              [292, 165],
              [348, 136],
              [404, 101],
              [458, 108],
              [512, 126],
              [566, 101],
              [604, 50],
            ].map(([cx, cy], index) => (
              <circle class="dashboard-dot" cx={cx} cy={cy} r="7" style={`--dot-delay:${index * 55}ms`}></circle>
            ))}
          </svg>
        </div>
        <div class="dashboard-months" aria-hidden="true">
          <span>{isEnglish ? 'May' : 'Mai'}</span>
          <span>{isEnglish ? 'June' : 'Juin'}</span>
          <span>{isEnglish ? 'July' : 'Juil.'}</span>
          <span>{isEnglish ? 'Aug.' : 'Août'}</span>
          <span>{isEnglish ? 'Sept.' : 'Sept.'}</span>
          <span>{isEnglish ? 'Oct.' : 'Oct.'}</span>
        </div>
      </div>
    </aside>
  </section>

  <section class="context-strip" aria-labelledby="benchmarks-title">
    <div class="context-copy">
      <span class="section-kicker">{t.categoriesEyebrow}</span>
      <h2 id="benchmarks-title">{t.categoriesTitle}</h2>
      <p>{t.categoriesText}</p>
      <div class="benchmark-signals" aria-label={isEnglish ? 'Benchmark signals' : 'Signaux benchmark'}>
        <span><strong>6</strong>{isEnglish ? ' sectors' : ' secteurs'}</span>
        <span><strong>4</strong>{isEnglish ? ' channels' : ' canaux'}</span>
        <span><strong>2</strong>{isEnglish ? ' modes' : ' modes'}</span>
      </div>
    </div>
    <div class="benchmark-board" aria-label={isEnglish ? 'CPL ranges by sector' : 'Fourchettes CPL par secteur'}>
      {
        benchmarkCards.map((item, index) => (
          <article class="benchmark-card" style={`--meter: ${item.meter}; --delay: ${index * 70}ms`}>
            <div class="benchmark-card-head">
              <span>{item.label}</span>
              <strong>{item.range}</strong>
            </div>
            <p>{item.note}</p>
            <div class="benchmark-meter" aria-hidden="true">
              <span></span>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="calculator-shell" id="calculator-panel" aria-labelledby="settings-title">
    <div class="settings-panel">
      <div class="panel-heading">
        <span class="section-kicker">{isEnglish ? 'Inputs' : 'Paramètres'}</span>
        <h2 id="settings-title">{t.calculatorTitle}</h2>
        <p>{t.calculatorText}</p>
      </div>

      <div class="mode-tabs" role="tablist" aria-label={isEnglish ? 'Calculation mode' : 'Mode de calcul'}>
        <button class="is-active" type="button" role="tab" aria-selected="true" data-mode-button="budget">
          {t.budgetMode}
        </button>
        <button type="button" role="tab" aria-selected="false" data-mode-button="leads">
          {t.leadsMode}
        </button>
      </div>

      <div class="field-grid">
        <label>
          <span>{t.sector}</span>
          <select data-sector-select>
            {sectors.map((sector) => <option value={sector.value}>{sector.label}</option>)}
          </select>
        </label>

        <label data-education-field>
          <span>{t.educationSegment}</span>
          <select data-segment-select>
            {educationSegments.map((segment) => <option value={segment.value}>{segment.label}</option>)}
          </select>
        </label>

        <label>
          <span>{t.channel}</span>
          <select data-channel-select>
            {channels.map((channel) => <option value={channel.value}>{channel.label}</option>)}
          </select>
        </label>

        <label data-budget-field>
          <span>{t.budgetLabel}</span>
          <input type="number" min="1" step="100" value="50000" inputmode="numeric" data-budget-input />
          <small>{t.budgetHelp}</small>
        </label>

        <label data-leads-field hidden>
          <span>{t.leadsLabel}</span>
          <input type="number" min="1" step="1" value="450" inputmode="numeric" data-leads-input />
          <small>{t.leadsHelp}</small>
        </label>
      </div>

      <button class="calculate-button" type="button" data-calculate>
        {t.calculate}
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </button>
      <p class="calculator-error" data-calculator-error role="alert"></p>
    </div>

    <aside class="result-panel" aria-labelledby="result-title" aria-live="polite">
      <div class="result-head">
        <span class="section-kicker">{t.resultReady}</span>
        <h2 id="result-title">{t.resultsTitle}</h2>
        <p class="channel-note" data-channel-note></p>
      </div>

      <div class="result-kpis">
        <article class="kpi-card kpi-cpl">
          <span>{t.cplUsed}</span>
          <strong data-cpl-output>20&nbsp;MAD&nbsp;–&nbsp;40&nbsp;MAD</strong>
        </article>
        <article class="kpi-card">
          <span data-primary-label>{t.leadsMin}</span>
          <strong data-primary-output>1 250</strong>
        </article>
        <article class="kpi-card">
          <span data-secondary-label>{t.leadsMax}</span>
          <strong data-secondary-output>2 500</strong>
        </article>
      </div>

      <div class="method-card" id="methodology">
        <div>
          <i class="ph ph-calculator" aria-hidden="true"></i>
          <h3>{t.methodologyTitle}</h3>
        </div>
        <p data-methodology-output>{t.budgetFormula}</p>
      </div>

      <div class="disclaimer">
        <i class="ph ph-warning-circle" aria-hidden="true"></i>
        <p>
          {t.disclaimer}
          <a href={isEnglish ? '/en/insights/morocco-digital-marketing-barometer-2026/' : '/insights/barometre-marketing-digital-maroc-2026/'}>{t.barometer}</a>
        </p>
      </div>

      <nav class="tool-related-links" aria-label={isEnglish ? 'Related resources' : 'Ressources liées'}>
        <a href={isEnglish ? '/en/insights/google-ads-campaign-cost-morocco/' : '/insights/cout-campagne-google-ads-maroc/'}>
          {isEnglish ? 'Google Ads cost guide' : 'Guide coût Google Ads'}
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a href={isEnglish ? '/en/insights/digital-acquisition-plan-2026/' : '/insights/plan-acquisition-digital-2026/'}>
          {isEnglish ? 'Acquisition plan' : 'Plan d’acquisition'}
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a href={isEnglish ? '/en/tools/digital-media-plan-template/' : '/outils/template-plan-media-digital/'}>
          {isEnglish ? 'Digital media plan template' : 'Template plan média'}
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a href={isEnglish ? '/en/tools/whatsapp-campaign-estimator/' : '/outils/estimateur-campagne-whatsapp/'}>
          {isEnglish ? 'WhatsApp estimator' : 'Estimateur WhatsApp'}
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </nav>
    </aside>
  </section>

  <section class="estimate-section" aria-labelledby="estimate-title">
    <div>
      <span class="section-kicker">{t.ctaEyebrow}</span>
      <h2 id="estimate-title">{t.ctaTitle}</h2>
      <p>{t.ctaText}</p>
    </div>
    <form
      class="estimate-form"
      action={CONTACT_FORM.action}
      method="post"
      data-contact-endpoint={CONTACT_FORM.ajaxAction}
      data-contact-form
      data-sending-message={t.sending}
      data-success-message={t.success}
      data-error-message={t.error}
    >
      <input type="hidden" name="_form" value={t.hiddenForm} />
      <input type="hidden" name="_subject" value={formSubject} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value={formRedirect} />
      <input type="hidden" name="Mode de calcul" data-hidden-mode />
      <input type="hidden" name="Secteur" data-hidden-sector />
      <input type="hidden" name="Canal" data-hidden-channel />
      <input type="hidden" name="Valeur saisie" data-hidden-input />
      <input type="hidden" name="Résultat calculé" data-hidden-output />
      <label class="form-honeypot" aria-hidden="true">
        Website
        <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
      </label>
      <label>
        <span>{t.name}</span>
        <input type="text" name={t.name} autocomplete="name" required />
      </label>
      <label>
        <span>{t.email}</span>
        <input type="email" name={t.email} autocomplete="email" required />
      </label>
      <label>
        <span>{t.company}</span>
        <input type="text" name={t.company} autocomplete="organization" required />
      </label>
      <label>
        <span>{t.phone}</span>
        <input type="tel" name={t.phone} autocomplete="tel" />
      </label>
      <label class="consent">
        <input type="checkbox" name="Consentement" value="Oui" required />
        <span>{t.consent}</span>
      </label>
      <button type="submit">
        {t.send}
        <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
      </button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </section>
</div>

<script is:inline define:vars={{ calculatorConfig }}>
  (() => {
    const root = document.querySelector('[data-budget-tool]');
    if (!root) return;

    const config = calculatorConfig;
    const labels = config.labels;
    const state = { mode: 'budget' };

    const modeButtons = [...root.querySelectorAll('[data-mode-button]')];
    const sectorSelect = root.querySelector('[data-sector-select]');
    const segmentSelect = root.querySelector('[data-segment-select]');
    const educationField = root.querySelector('[data-education-field]');
    const channelSelect = root.querySelector('[data-channel-select]');
    const budgetField = root.querySelector('[data-budget-field]');
    const leadsField = root.querySelector('[data-leads-field]');
    const budgetInput = root.querySelector('[data-budget-input]');
    const leadsInput = root.querySelector('[data-leads-input]');
    const error = root.querySelector('[data-calculator-error]');
    const cplOutput = root.querySelector('[data-cpl-output]');
    const primaryLabel = root.querySelector('[data-primary-label]');
    const primaryOutput = root.querySelector('[data-primary-output]');
    const secondaryLabel = root.querySelector('[data-secondary-label]');
    const secondaryOutput = root.querySelector('[data-secondary-output]');
    const methodologyOutput = root.querySelector('[data-methodology-output]');
    const channelNote = root.querySelector('[data-channel-note]');
    const toolConsole = root.querySelector('.tool-console');
    const previewCpl = root.querySelector('[data-preview-cpl]');
    const previewLeads = root.querySelector('[data-preview-leads]');
    const dashboardCounters = [...root.querySelectorAll('[data-dashboard-count]')];
    const hiddenMode = root.querySelector('[data-hidden-mode]');
    const hiddenSector = root.querySelector('[data-hidden-sector]');
    const hiddenChannel = root.querySelector('[data-hidden-channel]');
    const hiddenInput = root.querySelector('[data-hidden-input]');
    const hiddenOutput = root.querySelector('[data-hidden-output]');

    const formatter = new Intl.NumberFormat(config.lang === 'en' ? 'en-US' : 'fr-FR');
    const moneyFormatter = new Intl.NumberFormat(config.lang === 'en' ? 'en-US' : 'fr-FR', {
      maximumFractionDigits: 0,
    });

    const keepTogether = (value) => String(value).replace(/[\s\u00a0\u202f]+/g, '\u202f');
    const formatNumber = (value) => keepTogether(formatter.format(Math.max(0, Math.round(value))));
    const formatMad = (value) => `${keepTogether(moneyFormatter.format(Math.max(0, Math.round(value))))}\u00a0MAD`;
    const currentOptionLabel = (select) => select.options[select.selectedIndex]?.textContent?.trim() || '';
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let previewAnimationFrame;
    let dashboardAnimationFrames = [];

    const animatePreviewValue = ({ duration = 820, leadsMode = 'range' } = {}) => {
      if (prefersReducedMotion) return;

      window.cancelAnimationFrame(previewAnimationFrame);

      const cplMin = Number(previewCpl.dataset.min || 0);
      const cplMax = Number(previewCpl.dataset.max || 0);
      const leadsMin = Number(previewLeads.dataset.min || 0);
      const leadsMax = Number(previewLeads.dataset.max || leadsMin);
      const start = performance.now();
      const easeOut = (progress) => 1 - Math.pow(1 - progress, 3);

      const frame = (now) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = easeOut(progress);
        previewCpl.textContent = `${formatMad(cplMin * eased)} – ${formatMad(cplMax * eased)}`;
        previewLeads.textContent =
          leadsMode === 'single'
            ? formatNumber(leadsMin * eased)
            : `${formatNumber(leadsMin * eased)}–${formatNumber(leadsMax * eased)}`;

        if (progress < 1) {
          previewAnimationFrame = window.requestAnimationFrame(frame);
          return;
        }

        previewCpl.textContent = `${formatMad(cplMin)} – ${formatMad(cplMax)}`;
        previewLeads.textContent =
          leadsMode === 'single' ? formatNumber(leadsMin) : `${formatNumber(leadsMin)}–${formatNumber(leadsMax)}`;
      };

      previewAnimationFrame = window.requestAnimationFrame(frame);
    };

    const formatDashboardValue = (value, format, decimals = 0) => {
      if (format === 'million') {
        return `${value.toLocaleString(config.lang === 'en' ? 'en-US' : 'fr-FR', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        })}\u00a0M`;
      }

      if (format === 'percent') {
        return `${value.toLocaleString(config.lang === 'en' ? 'en-US' : 'fr-FR', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        })}%`;
      }

      return keepTogether(formatter.format(Math.round(value)));
    };

    const animateDashboardCounters = ({ duration = 980 } = {}) => {
      dashboardAnimationFrames.forEach((frame) => window.cancelAnimationFrame(frame));
      dashboardAnimationFrames = [];

      dashboardCounters.forEach((counter, index) => {
        const target = Number(counter.dataset.countTo || 0);
        const format = counter.dataset.countFormat || 'number';
        const decimals = Number(counter.dataset.countDecimals || 0);

        if (prefersReducedMotion) {
          counter.textContent = formatDashboardValue(target, format, decimals);
          return;
        }

        const start = performance.now() + index * 70;
        const easeOut = (progress) => 1 - Math.pow(1 - progress, 3);

        const frame = (now) => {
          const elapsed = Math.max(0, now - start);
          const progress = Math.min(elapsed / duration, 1);
          const value = target * easeOut(progress);
          counter.textContent = formatDashboardValue(value, format, decimals);

          if (progress < 1) {
            dashboardAnimationFrames[index] = window.requestAnimationFrame(frame);
            return;
          }

          counter.textContent = formatDashboardValue(target, format, decimals);
        };

        dashboardAnimationFrames[index] = window.requestAnimationFrame(frame);
      });
    };

    const replayConsoleAnimation = () => {
      if (!toolConsole) return;
      toolConsole.classList.remove('is-animating');
      void toolConsole.offsetWidth;
      toolConsole.classList.add('is-animating');
      animatePreviewValue({ leadsMode: previewLeads.dataset.mode || 'range' });
      animateDashboardCounters();
      window.setTimeout(() => toolConsole.classList.remove('is-animating'), 1250);
    };

    const getBaseRange = () => {
      const sector = sectorSelect.value;
      if (sector === 'education') {
        return config.ranges.education.segments[segmentSelect.value];
      }
      return config.ranges[sector];
    };

    const getAdjustedRange = () => {
      const base = getBaseRange();
      if (channelSelect.value === 'linkedin') {
        return { min: base.min * 2, max: base.max * 3 };
      }
      return base;
    };

    const getChannelNote = () => {
      if (channelSelect.value === 'google') return labels.googleNote;
      if (channelSelect.value === 'linkedin') return labels.linkedinNote;
      if (channelSelect.value === 'mix') return labels.mixNote;
      return labels.metaNote;
    };

    const updateMode = (mode) => {
      state.mode = mode;
      modeButtons.forEach((button) => {
        const active = button.dataset.modeButton === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      budgetField.hidden = mode !== 'budget';
      leadsField.hidden = mode !== 'leads';
      calculate();
    };

    const updateEducationVisibility = () => {
      educationField.hidden = sectorSelect.value !== 'education';
    };

    const setError = (message = '') => {
      error.textContent = message;
    };

    const setHiddenSummary = ({ modeLabel, sectorLabel, channelLabel, inputLabel, inputValue, outputText }) => {
      hiddenMode.value = modeLabel;
      hiddenSector.value = sectorLabel;
      hiddenChannel.value = channelLabel;
      hiddenInput.value = `${inputLabel}: ${inputValue}`;
      hiddenOutput.value = outputText;
    };

    const calculate = () => {
      updateEducationVisibility();
      const range = getAdjustedRange();
      const cplText = `${formatMad(range.min)} – ${formatMad(range.max)}`;
      const channelText = currentOptionLabel(channelSelect);
      const sectorText =
        sectorSelect.value === 'education'
          ? `${currentOptionLabel(sectorSelect)} · ${currentOptionLabel(segmentSelect)}`
          : currentOptionLabel(sectorSelect);
      const modeLabel = state.mode === 'budget' ? labels.budgetMode : labels.leadsMode;

      cplOutput.textContent = cplText;
      previewCpl.textContent = cplText;
      previewCpl.dataset.min = String(range.min);
      previewCpl.dataset.max = String(range.max);
      channelNote.textContent = getChannelNote();

      if (state.mode === 'budget') {
        const budget = Number(budgetInput.value);
        if (!Number.isFinite(budget) || budget <= 0) {
          setError(labels.requiredError);
          return;
        }
        setError();
        const leadsMin = Math.floor(budget / range.max);
        const leadsMax = Math.floor(budget / range.min);
        primaryLabel.textContent = labels.leadsMin;
        primaryOutput.textContent = formatNumber(leadsMin);
        secondaryLabel.textContent = labels.leadsMax;
        secondaryOutput.textContent = formatNumber(leadsMax);
        methodologyOutput.textContent = labels.budgetFormula;
        previewLeads.textContent = `${formatNumber(leadsMin)}–${formatNumber(leadsMax)}`;
        previewLeads.dataset.mode = 'range';
        previewLeads.dataset.min = String(leadsMin);
        previewLeads.dataset.max = String(leadsMax);
        setHiddenSummary({
          modeLabel,
          sectorLabel: sectorText,
          channelLabel: channelText,
          inputLabel: labels.budgetLabel,
          inputValue: formatMad(budget),
          outputText: `${labels.cplUsed}: ${cplText} | ${labels.leadsMin}: ${formatNumber(leadsMin)} | ${labels.leadsMax}: ${formatNumber(leadsMax)}`,
        });
        return;
      }

      const leads = Number(leadsInput.value);
      if (!Number.isFinite(leads) || leads <= 0) {
        setError(labels.requiredError);
        return;
      }
      setError();
      const budgetMin = leads * range.min;
      const budgetMax = leads * range.max;
      primaryLabel.textContent = labels.budgetMin;
      primaryOutput.textContent = formatMad(budgetMin);
      secondaryLabel.textContent = labels.budgetMax;
      secondaryOutput.textContent = formatMad(budgetMax);
      methodologyOutput.textContent = labels.leadsFormula;
      previewLeads.textContent = formatNumber(leads);
      previewLeads.dataset.mode = 'single';
      previewLeads.dataset.min = String(leads);
      previewLeads.dataset.max = String(leads);
      setHiddenSummary({
        modeLabel,
        sectorLabel: sectorText,
        channelLabel: channelText,
        inputLabel: labels.leadsLabel,
        inputValue: formatNumber(leads),
        outputText: `${labels.cplUsed}: ${cplText} | ${labels.budgetMin}: ${formatMad(budgetMin)} | ${labels.budgetMax}: ${formatMad(budgetMax)}`,
      });
    };

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => updateMode(button.dataset.modeButton));
    });
    [sectorSelect, segmentSelect, channelSelect, budgetInput, leadsInput].forEach((field) => {
      field.addEventListener('input', calculate);
      field.addEventListener('change', calculate);
    });
    root.querySelector('[data-calculate]')?.addEventListener('click', calculate);
    toolConsole?.addEventListener('pointerenter', replayConsoleAnimation);

    calculate();
    window.setTimeout(replayConsoleAnimation, 280);
  })();
</script>

