    action: isEnglish ? 'View all sectors' : 'Voir tous les secteurs',
    links: sectorLinks,
    kind: 'chips',
  },
  {
    href: isEnglish ? '/en/insights' : '/insights',
    label: labels.insights,
    kicker: isEnglish ? 'Ideas' : 'Idées',
    icon: 'ph ph-lightbulb',
    action: isEnglish ? 'View all insights' : 'Voir tous les insights',
    links: insightLinks,
    kind: 'chips',
  },
  {
    href: agencyHref,
    label: labels.agency,
    kicker: isEnglish ? 'Agency' : 'Agence',
    icon: 'ph ph-users-three',
    action: isEnglish ? 'Discover the agency' : "Découvrir l’agence",
    links: agencyLinks,
    kind: 'chips',
  },
  {
    href: isEnglish ? '/en/book-audit' : '/contact',
    label: labels.products,
    kicker: isEnglish ? 'Tools' : 'Outils',
    icon: 'ph ph-package',
    action: labels.productCta,
    links: productLinks,
    kind: 'products',
  },
];
---
<header class="site-header" data-site-header>
  <a href={homeHref} class="brand-lockup" aria-label={labels.brandHome}>
    <img
      class="brand-logo-image"
      src="/assets/richmedia-brand/logo-richmedia-wordmark.png"
      width="1248"
      height="232"
      alt=""
      loading="eager"
      decoding="async"
    />
    <span class="brand-tagline">WE BUILD <strong>DIGITAL</strong> GROWTH</span>
  </a>

  <nav class="primary-nav" aria-label={labels.mainNav}>
    <a href={homeHref}>{labels.home}</a>
    <div class="nav-dropdown">
      <a class="nav-dropdown-trigger" href={expertiseHref()} aria-haspopup="true">
        {isEnglish ? 'Expertise' : 'Expertises'}
        <i class="ph ph-caret-down" aria-hidden="true"></i>
      </a>
      <div class="expertise-submenu" aria-label="Mega menu expertises">
        <div class="expertise-menu-intro">
          <span>{isEnglish ? 'Our expertise' : 'Nos expertises'}</span>
          <strong>{labels.expertiseIntro}</strong>
          <a href={expertiseHref()}>
            {labels.allExpertise}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="expertise-menu-grid">
          {expertiseColumns.map((column) => (
            <section>
              <h2>{column.title}</h2>
              <div>
                {column.items.map((item) => (
                  <a href={item.href}>
                    <span>{item.label}</span>
                    <small>{item.text}</small>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
    <div class="nav-dropdown sector-dropdown">
        <a class="nav-dropdown-trigger" href={isEnglish ? '/en/sectors' : '/secteurs'} aria-haspopup="true">
          {labels.sectors}
          <i class="ph ph-caret-down" aria-hidden="true"></i>
        </a>
        <div class="sector-submenu" aria-label={labels.sectorMenu}>
          <div class="sector-menu-grid">
            {sectorLinks.map((item) => (
              <a href={item.href}>
                <span>{item.label}</span>
                <small>{item.text}</small>
                <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
              </a>
            ))}
          </div>
        </div>
      </div>
    {navItems.slice(0, 1).map((item) => <a href={item.href}>{item.label}</a>)}
    <div class="nav-dropdown insight-dropdown">
        <a class="nav-dropdown-trigger" href={isEnglish ? '/en/insights' : '/insights'} aria-haspopup="true">
          {labels.insights}
          <i class="ph ph-caret-down" aria-hidden="true"></i>
        </a>
        <div class="insight-submenu" aria-label={labels.insightMenu}>
          <div class="insight-menu-grid">
            {insightLinks.map((item) => (
              <a href={item.href}>
                <span>{item.label}</span>
                <small>{item.text}</small>
                <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
              </a>
            ))}
          </div>
      </div>
    </div>
    <div class="nav-dropdown agency-dropdown">
      <a class="nav-dropdown-trigger" href={agencyHref} aria-haspopup="true">
        {labels.agency}
        <i class="ph ph-caret-down" aria-hidden="true"></i>
      </a>
      <div class="agency-submenu" aria-label={labels.agencyMenu}>
        <div class="agency-menu-grid">
          {agencyLinks.map((item) => (
            <a href={item.href}>
              <span>{item.label}</span>
              <small>{item.text}</small>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="nav-dropdown product-dropdown">
      <button class="nav-dropdown-trigger" type="button" aria-haspopup="true">
        {labels.products}
        <i class="ph ph-caret-down" aria-hidden="true"></i>
      </button>
      <div class="products-submenu" aria-label={labels.productMenu}>
        <div class="product-menu-head">
          <div>
            <span>{labels.products}</span>
            <strong>{labels.productIntro}</strong>
          </div>
          <a href={isEnglish ? '/en/book-audit' : '/contact'}>
            {labels.productCta}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="product-menu-grid">
          {productLinks.map((item) => (
            <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
              <span>{item.label}</span>
              <small>{item.text}</small>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </div>
    {navItems.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="header-actions">
    <a class="lang-switch" href={languageHref} aria-label={labels.langLabel}>
      <span class="flag flag-fr" aria-hidden="true"></span>
      <span class="flag-separator" aria-hidden="true"></span>
      <span class="flag flag-en" aria-hidden="true"></span>
      <span class="sr-only">{labels.langLabel}</span>
    </a>
    <a href={ctaHref} class="header-cta" data-mobile-label={labels.ctaMobile}>
      {labels.cta}
      <i class={isEnglish ? 'ph ph-arrow-up-right' : 'ph ph-phone'} aria-hidden="true"></i>
    </a>
    <button class="mobile-menu-toggle" type="button" aria-label={labels.menu} aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-toggle>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-menu-backdrop" data-mobile-menu-backdrop></div>
  <nav id="mobile-menu" class="mobile-menu" aria-label={labels.mobileNav} aria-hidden="true" data-mobile-menu inert>
    <div class="mobile-menu-top">
      <span>{labels.mobileNav}</span>
      <button class="mobile-menu-close" type="button" aria-label={labels.closeMenu} data-mobile-menu-close>
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
    </div>

    <div class="mobile-menu-links">
      {mobileNavItems.map((item) => (
        <a class="mobile-menu-link" href={item.href}>
          <span class="mobile-dropdown-icon" aria-hidden="true">
            <i class={item.icon}></i>
          </span>
          <span class="mobile-dropdown-title">
            <small>{item.kicker}</small>
            <strong>{item.label}</strong>
          </span>
          <i class="ph ph-arrow-up-right mobile-link-chevron" aria-hidden="true"></i>
        </a>
      ))}
    </div>

    <div class="mobile-dropdown-stack">
      {mobileSubmenus.map((section) => (
        <details class="mobile-menu-section mobile-menu-dropdown" data-mobile-dropdown>
          <summary>
            <span class="mobile-dropdown-icon" aria-hidden="true">
              <i class={section.icon}></i>
            </span>
            <span class="mobile-dropdown-title">
              <small>{section.kicker}</small>
              <strong>{section.label}</strong>
            </span>
            <span class="mobile-dropdown-count">{section.links.length}</span>
            <i class="ph ph-caret-down mobile-dropdown-chevron" aria-hidden="true"></i>
          </summary>
          <div class="mobile-dropdown-panel">
            <a class="mobile-dropdown-main" href={section.href}>
              <span>{section.action}</span>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
            {section.kind === 'products' ? (
              <div class="mobile-product-list">
                {section.links.map((item) => (
                  <a
                    href={item.href}
                    target={'external' in item && item.external ? '_blank' : undefined}
                    rel={'external' in item && item.external ? 'noopener' : undefined}
                  >
                    <span>{item.label}</span>
                    <small>{item.text}</small>
                    <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                  </a>
                ))}
              </div>
            ) : (
              <div class="mobile-menu-chip-grid">
                {section.links.map((item) => (
                  <a class="mobile-menu-chip" href={item.href}>{item.label}</a>
                ))}
              </div>
            )}
          </div>
        </details>
      ))}
    </div>

    <div class="mobile-menu-actions">
      <a href={languageHref}>{labels.langLabel}</a>
      <a href={ctaHref}>{labels.cta}</a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const toggle = header?.querySelector('[data-mobile-menu-toggle]');
    const closeButton = header?.querySelector('[data-mobile-menu-close]');
    const menu = header?.querySelector('[data-mobile-menu]');
    const backdrop = header?.querySelector('[data-mobile-menu-backdrop]');
    const focusableSelector = 'a[href], button:not([disabled])';

    if (!header || !toggle || !menu || !backdrop) return;

    const mobileDropdowns = [...menu.querySelectorAll('[data-mobile-dropdown]')];

    const setMenuState = (open, restoreFocus = true) => {
      header.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
      menu.toggleAttribute('inert', !open);
      document.documentElement.classList.toggle('mobile-menu-lock', open);

      if (open) {
        window.requestAnimationFrame(() => {
          menu.querySelector(focusableSelector)?.focus();
        });
      } else if (restoreFocus) {
        mobileDropdowns.forEach((dropdown) => dropdown.removeAttribute('open'));
        toggle.focus();
      } else {
        mobileDropdowns.forEach((dropdown) => dropdown.removeAttribute('open'));
      }
    };

    toggle.addEventListener('click', () => {
      setMenuState(toggle.getAttribute('aria-expanded') !== 'true');
    });

    closeButton?.addEventListener('click', () => setMenuState(false));
    backdrop.addEventListener('click', () => setMenuState(false));

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false, false));
    });

    mobileDropdowns.forEach((dropdown) => {
      dropdown.addEventListener('toggle', () => {
        if (!dropdown.open) return;
        mobileDropdowns.forEach((item) => {
          if (item !== dropdown) item.removeAttribute('open');
        });
      });
    });

    const desktopQuery = window.matchMedia('(min-width: 1241px)');
    const dropdowns = [...header.querySelectorAll('.nav-dropdown')];
    const closeDelay = 460;

    const setDropdownState = (dropdown, open) => {
      dropdown.classList.toggle('is-open', open);
      dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', String(open));
    };

    const openDropdown = (dropdown) => {
      if (!desktopQuery.matches) return;

      dropdowns.forEach((item) => {
        if (item !== dropdown) {
          window.clearTimeout(item.closeTimer);
          setDropdownState(item, false);
        }
      });

      window.clearTimeout(dropdown.closeTimer);
      setDropdownState(dropdown, true);
    };

    const closeDropdown = (dropdown, delay = closeDelay) => {
      window.clearTimeout(dropdown.closeTimer);
      dropdown.closeTimer = window.setTimeout(() => {
        setDropdownState(dropdown, false);
      }, delay);
    };

    dropdowns.forEach((dropdown) => {
      dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');

      dropdown.addEventListener('pointerenter', () => openDropdown(dropdown));
      dropdown.addEventListener('pointerleave', () => closeDropdown(dropdown));
      dropdown.addEventListener('focusin', () => openDropdown(dropdown));
      dropdown.addEventListener('focusout', (event) => {
        if (!dropdown.contains(event.relatedTarget)) closeDropdown(dropdown, 0);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        dropdowns.forEach((dropdown) => {
          window.clearTimeout(dropdown.closeTimer);
          setDropdownState(dropdown, false);
        });
      }

      if (!header.classList.contains('is-menu-open')) return;

      if (event.key === 'Escape') {
        setMenuState(false);
        return;
      }

      if (event.key === 'Tab') {
        const focusableItems = [...menu.querySelectorAll(focusableSelector)].filter(
          (item) => item instanceof HTMLElement && item.offsetParent !== null
        );
        const firstItem = focusableItems[0];
        const lastItem = focusableItems[focusableItems.length - 1];

        if (!firstItem || !lastItem) return;

        if (event.shiftKey && document.activeElement === firstItem) {
          event.preventDefault();
          lastItem.focus();
        } else if (!event.shiftKey && document.activeElement === lastItem) {
          event.preventDefault();
          firstItem.focus();
        }
      }
    });

    desktopQuery.addEventListener?.('change', (event) => {
      if (event.matches) setMenuState(false, false);
      if (!event.matches) {
        dropdowns.forEach((dropdown) => {
          window.clearTimeout(dropdown.closeTimer);
          setDropdownState(dropdown, false);
        });
      }
    });
  })();
</script>
