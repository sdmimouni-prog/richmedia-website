---
const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const homeHref = isEnglish ? '/en' : '/';
const englishDetailExpertiseSlugs = ['strategie-digitale', 'brand-content', 'web-si', 'achat-media', 'influence', 'phygital', 'evenementiel', 'ia-automation'];
const expertiseHref = (slug?: string) => {
  if (!slug) return isEnglish ? '/en/expertises' : '/expertises';
  if (isEnglish && englishDetailExpertiseSlugs.includes(slug)) return `/en/expertises/${slug}`;
  return isEnglish ? `/en/expertises#${slug}` : `/expertises/${slug}`;
};
const languageHref = isEnglish
  ? normalizedPath === '/en/team'
    ? '/equipe'
    : normalizedPath === '/en/case-studies'
    ? '/realisations'
    : normalizedPath === '/en/case-studies/model-case-study'
    ? '/realisations/modele-case-study'
    : normalizedPath === '/en/contact'
    ? '/contact'
    : normalizedPath === '/en/book-audit'
    ? '/reserver-un-audit'
    : normalizedPath === '/en/products/whatsapp'
    ? '/produits/whatsapp'
    : normalizedPath === '/en/products/hypeo'
    ? '/produits/hypeo'
    : normalizedPath === '/en/products/in-talks'
    ? '/produits/in-talks'
    : normalizedPath === '/en/expertises/strategie-digitale'
    ? '/expertises/strategie-digitale'
    : normalizedPath === '/en/expertises/brand-content'
    ? '/expertises/brand-content'
    : normalizedPath === '/en/expertises/web-si'
    ? '/expertises/web-si'
    : normalizedPath === '/en/expertises/achat-media'
    ? '/expertises/achat-media'
    : normalizedPath === '/en/expertises/influence'
    ? '/expertises/influence'
    : normalizedPath === '/en/expertises/phygital'
    ? '/expertises/phygital'
    : normalizedPath === '/en/expertises/evenementiel'
    ? '/expertises/evenementiel'
    : normalizedPath === '/en/expertises/ia-automation'
    ? '/expertises/ia-automation'
    : Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/'
  : normalizedPath === '/equipe'
    ? '/en/team'
    : normalizedPath === '/realisations/modele-case-study'
    ? '/en/case-studies/model-case-study'
    : normalizedPath === '/realisations' || Astro.url.pathname.startsWith('/realisations/')
    ? '/en/case-studies'
    : normalizedPath === '/expertises/strategie-digitale'
    ? '/en/expertises/strategie-digitale'
    : normalizedPath === '/expertises/brand-content'
    ? '/en/expertises/brand-content'
    : normalizedPath === '/expertises/web-si'
    ? '/en/expertises/web-si'
    : normalizedPath === '/expertises/achat-media'
    ? '/en/expertises/achat-media'
    : normalizedPath === '/expertises/influence'
    ? '/en/expertises/influence'
    : normalizedPath === '/expertises/phygital'
    ? '/en/expertises/phygital'
    : normalizedPath === '/expertises/evenementiel'
    ? '/en/expertises/evenementiel'
    : normalizedPath === '/expertises/ia-automation'
    ? '/en/expertises/ia-automation'
    : normalizedPath === '/expertises' || Astro.url.pathname.startsWith('/expertises/')
    ? '/en/expertises'
    : normalizedPath === '/contact'
    ? '/en/contact'
    : normalizedPath === '/reserver-un-audit'
    ? '/en/book-audit'
    : normalizedPath === '/produits/whatsapp'
    ? '/en/products/whatsapp'
    : normalizedPath === '/produits/hypeo'
    ? '/en/products/hypeo'
    : normalizedPath === '/produits/in-talks'
    ? '/en/products/in-talks'
    : '/en';

const labels = isEnglish
  ? {
      home: 'Home',
      team: 'Team',
      products: 'Our products',
      mainNav: 'Primary navigation',
      mobileNav: 'Mobile navigation',
      brandHome: 'Richmedia — Home',
      expertiseIntro: 'A complete system to create, amplify and convert.',
      allExpertise: 'View all expertise',
      productIntro: 'Partner tools ready to activate.',
      productCta: 'Book a demo',
      productMenu: 'Our products menu',
      langLabel: 'Version française',
      caseStudies: 'Case studies',
      menu: 'Open menu',
      closeMenu: 'Close menu',
      cta: 'Book a call',
      ctaMobile: 'Call',
    }
  : {
      home: 'Accueil',
      team: 'Équipe',
      products: 'Nos produits',
      mainNav: 'Navigation principale',
      mobileNav: 'Navigation mobile',
      brandHome: 'Richmedia — Accueil',
      expertiseIntro: 'Un système complet pour créer, amplifier et convertir.',
      allExpertise: 'Voir toutes les expertises',
      productIntro: 'Des outils partenaires prêts à activer.',
      productCta: 'Demander une démo',
      productMenu: 'Menu nos produits',
      langLabel: 'English version',
      caseStudies: 'Réalisations',
      menu: 'Ouvrir le menu',
      closeMenu: 'Fermer le menu',
      cta: 'Appelez-nous',
      ctaMobile: 'Appeler',
    };

const ctaHref = isEnglish ? '/en/book-audit' : 'tel:+212661172885';

const navItems = [
  { href: isEnglish ? '/en/case-studies' : '/realisations', label: labels.caseStudies },
  { href: isEnglish ? '/en/team' : '/equipe', label: labels.team },
  { href: isEnglish ? '/en/contact' : '/contact', label: 'Contact' },
];

const productLinks = [
  {
    href: isEnglish ? '/en/products/whatsapp' : '/produits/whatsapp',
    label: isEnglish ? 'WhatsApp push' : 'Push WhatsApp',
    text: isEnglish ? 'Campaigns and follow-ups' : 'Campagnes et relances',
    external: false,
  },
  {
    href: 'https://www.carterandblake.ma/expertise-political-marketing.html',
    label: isEnglish ? 'Political marketing' : 'Marketing politique',
    text: isEnglish ? 'Carter & Blake' : 'Carter & Blake',
    external: true,
  },
  {
    href: isEnglish ? '/en/products/hypeo' : '/produits/hypeo',
    label: 'Influence',
    text: isEnglish ? 'Creator campaigns' : 'Campagnes créateurs',
    external: false,
  },
  {
    href: isEnglish ? '/en/products/in-talks' : '/produits/in-talks',
    label: 'Social listening',
    text: isEnglish ? 'Monitoring and reputation' : 'Veille et réputation',
    external: false,
  },
];

const expertiseColumns = [
  {
    title: isEnglish ? 'Build' : 'Construire',
    items: [
      {
        href: expertiseHref('strategie-digitale'),
        label: isEnglish ? 'Digital Strategy' : 'Stratégie digitale',
        text: isEnglish ? 'Positioning, targeting and action plan.' : 'Positionnement, ciblage et plan d’action.',
      },
      {
        href: expertiseHref('brand-content'),
        label: isEnglish ? 'Brand Content' : 'Brand content',
        text: isEnglish ? 'Concepts, social-first content and storytelling.' : 'Concepts, contenus social-first et storytelling.',
      },
      {
        href: expertiseHref('web-si'),
        label: isEnglish ? 'Web & IS' : 'Web & SI',
        text: isEnglish ? 'Websites, platforms, tracking and connected systems.' : 'Sites, plateformes, tracking et systèmes connectés.',
      },
    ],
  },
  {
    title: 'Amplifier',
    items: [
      {
        href: expertiseHref('achat-media'),
        label: isEnglish ? 'Media Buying' : 'Achat média',
        text: isEnglish ? 'Paid social, search, programmatic and DOOH.' : 'Paid social, search, programmatique et DOOH.',
      },
      {
        href: expertiseHref('influence'),
        label: 'Influence',
        text: isEnglish ? 'Selection, activation and performance tracking.' : 'Sélection, activation et suivi des performances.',
      },
      {
        href: expertiseHref('phygital'),
        label: 'Phygital',
        text: isEnglish ? 'Field activation, retail and connected experiences.' : 'Activation terrain, retail et expériences connectées.',
      },
    ],
  },
  {
    title: isEnglish ? 'Convert' : 'Convertir',
    items: [
      {
        href: expertiseHref('evenementiel'),
        label: isEnglish ? 'Events' : 'Événementiel',
        text: isEnglish ? 'Brand setups, launches and field presence.' : 'Dispositifs de marque, lancement et présence terrain.',
      },
      {
        href: expertiseHref('ia-automation'),
        label: isEnglish ? 'AI & Automation' : 'IA & Automation',
        text: isEnglish ? 'CRM, WhatsApp, AI agents and automated journeys.' : 'CRM, WhatsApp, agents IA et parcours automatisés.',
      },
    ],
  },
];

const mobileNavItems = [
  {
    href: homeHref,
    label: labels.home,
    kicker: isEnglish ? 'Start' : 'Départ',
    icon: 'ph ph-house-line',
  },
  {
    href: expertiseHref(),
    label: isEnglish ? 'Expertise' : 'Expertises',
    kicker: 'Services',
    icon: 'ph ph-sparkle',
  },
  {
    href: isEnglish ? '/en/case-studies' : '/realisations',
    label: labels.caseStudies,
    kicker: isEnglish ? 'Proof' : 'Preuves',
    icon: 'ph ph-images-square',
  },
  {
    href: isEnglish ? '/en/team' : '/equipe',
    label: labels.team,
    kicker: isEnglish ? 'People' : 'Talents',
    icon: 'ph ph-users-three',
  },
  {
    href: isEnglish ? '/en/contact' : '/contact',
    label: 'Contact',
    kicker: isEnglish ? 'Brief' : 'Brief',
    icon: 'ph ph-chat-circle-text',
  },
];

const mobileExpertiseLinks = expertiseColumns.flatMap((column) => column.items);
---
<header class="site-header" data-site-header>
  <a href={homeHref} class="brand-lockup" aria-label={labels.brandHome}>
    <span class="brand-word">richmedia</span>
    <span class="brand-tagline">WE BUILD <strong>DIGITAL</strong> GROWTH</span>
  </a>

  <nav class="primary-nav" aria-label={labels.mainNav}>
    <a href={homeHref}>{labels.home}</a>
    <div class="nav-dropdown">
      <a class="nav-dropdown-trigger" href={expertiseHref()} aria-haspopup="true">
        {isEnglish ? 'Our expertise' : 'Nos expertises'}
        <i class="ph ph-caret-down" aria-hidden="true"></i>
      </a>
      <div class="expertise-submenu" aria-label="Mega menu expertises">
        <div class="expertise-menu-intro">
          <span>{isEnglish ? 'Our expertise' : 'Nos expertises'}</span>
          <strong>{labels.expertiseIntro}</strong>
          <a href={expertiseHref()}>
            {labels.allExpertise}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="expertise-menu-grid">
          {expertiseColumns.map((column) => (
            <section>
              <h2>{column.title}</h2>
              <div>
                {column.items.map((item) => (
                  <a href={item.href}>
                    <span>{item.label}</span>
                    <small>{item.text}</small>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
    {navItems.slice(0, 2).map((item) => <a href={item.href}>{item.label}</a>)}
    <div class="nav-dropdown product-dropdown">
      <button class="nav-dropdown-trigger" type="button" aria-haspopup="true">
        {labels.products}
        <i class="ph ph-caret-down" aria-hidden="true"></i>
      </button>
      <div class="products-submenu" aria-label={labels.productMenu}>
        <div class="product-menu-head">
          <div>
            <span>{labels.products}</span>
            <strong>{labels.productIntro}</strong>
          </div>
          <a href={isEnglish ? '/en/book-audit' : '/contact'}>
            {labels.productCta}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="product-menu-grid">
          {productLinks.map((item) => (
            <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
              <span>{item.label}</span>
              <small>{item.text}</small>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </div>
    {navItems.slice(2).map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="header-actions">
    <a class="lang-switch" href={languageHref} aria-label={labels.langLabel}>
      <span class="flag flag-fr" aria-hidden="true"></span>
      <span class="flag-separator" aria-hidden="true"></span>
      <span class="flag flag-en" aria-hidden="true"></span>
      <span class="sr-only">{labels.langLabel}</span>
    </a>
    <a href={ctaHref} class="header-cta" data-mobile-label={labels.ctaMobile}>
      {labels.cta}
      <i class={isEnglish ? 'ph ph-arrow-up-right' : 'ph ph-phone'} aria-hidden="true"></i>
    </a>
    <button class="mobile-menu-toggle" type="button" aria-label={labels.menu} aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-toggle>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-menu-backdrop" data-mobile-menu-backdrop></div>
  <nav id="mobile-menu" class="mobile-menu" aria-label={labels.mobileNav} aria-hidden="true" data-mobile-menu inert>
    <div class="mobile-menu-top">
      <span>{labels.mobileNav}</span>
      <button class="mobile-menu-close" type="button" aria-label={labels.closeMenu} data-mobile-menu-close>
        <i class="ph ph-x" aria-hidden="true"></i>
      </button>
    </div>

    <div class="mobile-menu-links">
      {mobileNavItems.map((item) => (
        <a class="mobile-menu-link" href={item.href}>
          <small>{item.kicker}</small>
          <span>{item.label}</span>
          <i class={item.icon} aria-hidden="true"></i>
        </a>
      ))}
    </div>

    <section class="mobile-menu-section">
      <span>{isEnglish ? 'Expertise' : 'Expertises'}</span>
      <div class="mobile-menu-chip-grid">
        {mobileExpertiseLinks.map((item) => (
          <a class="mobile-menu-chip" href={item.href}>{item.label}</a>
        ))}
      </div>
    </section>

    <section class="mobile-menu-section">
      <span>{labels.products}</span>
      <div class="mobile-product-list">
        {productLinks.map((item) => (
          <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
            <span>{item.label}</span>
            <small>{item.text}</small>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </section>

    <div class="mobile-menu-actions">
      <a href={languageHref}>{labels.langLabel}</a>
      <a href={ctaHref}>{labels.cta}</a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const toggle = header?.querySelector('[data-mobile-menu-toggle]');
    const closeButton = header?.querySelector('[data-mobile-menu-close]');
    const menu = header?.querySelector('[data-mobile-menu]');
    const backdrop = header?.querySelector('[data-mobile-menu-backdrop]');
    const focusableSelector = 'a[href], button:not([disabled])';

    if (!header || !toggle || !menu || !backdrop) return;

    const setMenuState = (open, restoreFocus = true) => {
      header.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
      menu.toggleAttribute('inert', !open);
      document.documentElement.classList.toggle('mobile-menu-lock', open);

      if (open) {
        window.requestAnimationFrame(() => {
          menu.querySelector(focusableSelector)?.focus();
        });
      } else if (restoreFocus) {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => {
      setMenuState(toggle.getAttribute('aria-expanded') !== 'true');
    });

    closeButton?.addEventListener('click', () => setMenuState(false));
    backdrop.addEventListener('click', () => setMenuState(false));

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false, false));
    });

    document.addEventListener('keydown', (event) => {
      if (!header.classList.contains('is-menu-open')) return;

      if (event.key === 'Escape') {
        setMenuState(false);
        return;
      }

      if (event.key === 'Tab') {
        const focusableItems = [...menu.querySelectorAll(focusableSelector)].filter(
          (item) => item instanceof HTMLElement && item.offsetParent !== null
        );
        const firstItem = focusableItems[0];
        const lastItem = focusableItems[focusableItems.length - 1];

        if (!firstItem || !lastItem) return;

        if (event.shiftKey && document.activeElement === firstItem) {
          event.preventDefault();
          lastItem.focus();
        } else if (!event.shiftKey && document.activeElement === lastItem) {
          event.preventDefault();
          firstItem.focus();
        }
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 1081px)');
    desktopQuery.addEventListener?.('change', (event) => {
      if (event.matches) setMenuState(false, false);
    });
  })();
</script>
