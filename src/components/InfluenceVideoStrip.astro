---
interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

const copy = {
  fr: {
    aria: "Campagnes d'influence réussies",
  },
  en: {
    aria: 'Successful influence campaigns',
  },
};

const t = copy[lang];

const reels = [
  {
    video: '/videos/influence/lc-waikik.mp4',
    poster: '/assets/richmedia-home/optimized/influence-reels-reel-01.webp',
    width: 255,
    height: 404,
    label: 'LC Waikiki',
  },
  {
    video: '/videos/influence/amana.mp4',
    poster: '/assets/richmedia-home/optimized/influence-reels-reel-02.webp',
    width: 255,
    height: 404,
    label: 'Amana',
  },
  {
    video: '/videos/influence/6.mp4',
    poster: '/assets/richmedia-home/optimized/influence-reels-reel-03.webp',
    width: 276,
    height: 404,
    label: 'Lifestyle creator',
  },
  {
    video: '/videos/influence/lc-waikik-3.mp4',
    poster: '/assets/richmedia-home/optimized/influence-reels-reel-04.webp',
    width: 251,
    height: 404,
    label: 'Beauty content',
  },
  {
    video: '/videos/influence/5.mp4',
    poster: '/assets/richmedia-home/optimized/influence-reels-reel-05.webp',
    width: 250,
    height: 404,
    label: 'Creator portrait',
  },
];
---

<section class="influence-video-section" aria-label={t.aria}>
  <div class="influence-video-strip" aria-label={t.aria}>
    {reels.map((reel) => (
      <article class="influence-video-card">
        <video
          data-influence-video
          data-video-src={reel.video}
          data-poster-src={reel.poster}
          autoplay
          muted
          loop
          playsinline
          preload="none"
          width={reel.width}
          height={reel.height}
          aria-label={reel.label}
        />
      </article>
    ))}
  </div>
</section>

<script>
  const motionIsReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-influence-video]'));

  const applyInfluencePoster = (video: HTMLVideoElement) => {
    if (video.dataset.posterApplied === 'true') return;

    const posterUrl = video.dataset.posterSrc;
    if (!posterUrl) return;

    video.poster = posterUrl;
    video.dataset.posterApplied = 'true';
  };

  const loadInfluenceVideo = (video: HTMLVideoElement) => {
    if (video.dataset.loaded === 'true') return;

    const sourceUrl = video.dataset.videoSrc;
    if (!sourceUrl) return;

    const source = document.createElement('source');
    source.src = sourceUrl;
    source.type = 'video/mp4';
    video.appendChild(source);
    video.dataset.loaded = 'true';
    video.load();
  };

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target;

          if (!(video instanceof HTMLVideoElement)) {
            return;
          }

          if (entry.isIntersecting) {
            applyInfluencePoster(video);

            if (motionIsReduced) {
              video.pause();
            } else {
              loadInfluenceVideo(video);
              video.play().catch(() => undefined);
            }
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '420px 0px', threshold: 0.16 }
    );

    videos.forEach((video) => observer.observe(video));
  } else {
    videos.forEach((video) => {
      applyInfluencePoster(video);

      if (motionIsReduced) {
        video.pause();
      } else {
        loadInfluenceVideo(video);
        video.play().catch(() => undefined);
      }
    });
  }
</script>

<style>
  .influence-video-section {
    position: relative;
    width: 100%;
    content-visibility: auto;
    contain-intrinsic-size: auto 35rem;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0;
    background:
      radial-gradient(circle at 78% 100%, rgba(111, 48, 255, 0.24), transparent 24rem),
      linear-gradient(180deg, #050508 0%, #07060c 68%, #130623 100%);
  }

  .influence-video-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: 100%;
    min-height: 35rem;
    overflow: hidden;
  }

  .influence-video-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: #09090d;
    isolation: isolate;
  }

  .influence-video-card::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    content: '';
    background:
      linear-gradient(180deg, rgba(3, 4, 7, 0.04), transparent 42%, rgba(3, 4, 7, 0.22)),
      linear-gradient(90deg, rgba(0, 0, 0, 0.08), transparent 18%, transparent 82%, rgba(0, 0, 0, 0.08));
    opacity: 0.9;
    transition: opacity 220ms ease;
  }

  .influence-video-card video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 35rem;
    object-fit: cover;
    filter: saturate(1.02) contrast(1.03);
    transform: scale(1.001);
    transition: transform 420ms ease, filter 420ms ease;
  }

  .influence-video-card:hover::after,
  .influence-video-card:focus-within::after {
    opacity: 0.45;
  }

  .influence-video-card:hover video,
  .influence-video-card:focus-within video {
    filter: saturate(1.14) contrast(1.08);
    transform: scale(1.045);
  }

  @media (max-width: 1060px) {
    .influence-video-strip {
      min-height: 31rem;
    }

    .influence-video-card video {
      min-height: 31rem;
    }
  }

  @media (max-width: 720px) {
    .influence-video-strip {
      display: grid;
      grid-auto-columns: minmax(17rem, 78vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      gap: 0.7rem;
      min-height: 30rem;
      overflow-x: auto;
      padding: 0 0.7rem 0.65rem;
      scroll-padding-inline: 0.7rem;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .influence-video-strip::-webkit-scrollbar {
      display: none;
    }

    .influence-video-card {
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 8px;
      scroll-snap-align: center;
    }

    .influence-video-card video {
      min-height: 30rem;
    }
  }

  @media (max-width: 380px) {
    .influence-video-strip {
      grid-auto-columns: minmax(15.5rem, 82vw);
      min-height: 27rem;
    }

    .influence-video-card video {
      min-height: 27rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .influence-video-card::after,
    .influence-video-card video {
      transition: none;
    }

    .influence-video-card:hover video,
    .influence-video-card:focus-within video {
      transform: none;
    }
  }
</style>
