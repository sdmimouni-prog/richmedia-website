    color: #fff;
  }

  .download-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(360px, 0.62fr);
    gap: clamp(1.2rem, 3vw, 2rem);
    align-items: start;
    scroll-margin-top: 7rem;
  }

  .download-copy h2,
