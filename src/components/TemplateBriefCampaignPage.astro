---

<div class="brief-template-page">
  <section class="brief-hero" aria-labelledby="brief-template-title">
    <div class="hero-copy">
      <span class="section-kicker">{t.eyebrow}</span>
      <h1 id="brief-template-title">{t.title}</h1>
      <p class="positioning">{t.positioning}</p>
      <p>{t.subtitle}</p>
      <span class="file-badge">{t.badge}</span>
      <div class="hero-actions">
        <a class="button button-primary" href="#download-brief">
          {t.primaryCta}
          <i class="ph ph-download-simple" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href={t.secondaryHref}>
          {t.secondaryCta}
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <figure class="hero-visual">
      <img
        src={`${assetBase}/hero-brief-campagne.webp`}
        alt={t.heroAlt}
        width="1600"
        height="920"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="preview-section" aria-labelledby="brief-preview-title">
    <div class="section-heading">
      <span class="section-kicker">{t.previewEyebrow}</span>
      <h2 id="brief-preview-title">{t.previewTitle}</h2>
      <p>{t.previewText}</p>
    </div>
    <div class="preview-grid">
      {t.previews.map((preview) => (
        <article class="preview-card">
          <figure>
            <img src={preview.image} alt={preview.alt} width="1020" height="660" loading="lazy" decoding="async" />
          </figure>
          <h3>{preview.title}</h3>
        </article>
      ))}
    </div>
  </section>

  <section class="scope-section" aria-labelledby="brief-scope-title">
    <div class="section-heading">
      <span class="section-kicker">{t.cardsEyebrow}</span>
      <h2 id="brief-scope-title">{t.cardsTitle}</h2>
      <p>{t.keyMessage}</p>
    </div>
    <div class="scope-grid">
      {t.scopeCards.map((card) => (
        <article>{card}</article>
      ))}
    </div>
  </section>

  <section class="workflow-section" aria-labelledby="brief-workflow-title">
    <div class="section-heading">
      <span class="section-kicker">{t.workflowEyebrow}</span>
      <h2 id="brief-workflow-title">{t.workflowTitle}</h2>
    </div>
    <div class="workflow-list">
      {t.workflow.map((step, index) => (
        <div class="workflow-step">
          <strong>{step}</strong>
          {index < t.workflow.length - 1 && <i class="ph ph-arrow-down" aria-hidden="true"></i>}
        </div>
      ))}
    </div>
    <nav class="internal-links" aria-label={t.internalLabel}>
      {t.relatedLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </section>

  <section class="download-section" id="download-brief" aria-labelledby="brief-download-title">
    <div class="download-copy">
      <span class="section-kicker">{t.downloadEyebrow}</span>
      <h2 id="brief-download-title">{t.downloadTitle}</h2>
      <p>{t.downloadText}</p>
    </div>

    <form
      class="download-form"
      action={CONTACT_FORM.action}
      method="post"
      data-brief-download-form
      data-download-url={downloadHref}
      data-contact-endpoint={CONTACT_FORM.ajaxAction}
      data-file-name={downloadFilename}
      data-subject={t.subject}
      data-email-field={t.fieldNames.email}
      data-loading-message={t.loading}
      data-success-message={t.success}
      data-error-message={t.error}
      data-trap-success-message={t.trapSuccess}
    >
      <input type="hidden" name="_form" value={t.formName} />
      <input type="hidden" name={isEnglish ? 'Requested resource' : 'Ressource demandée'} value={t.requestedResource} />
      <input type="hidden" name={isEnglish ? 'CRM preparation' : 'Préparation CRM'} value={t.crmMarker} />
      <input type="hidden" name="resource_slug" value="template-brief-campagne-digitale" />
      <input type="hidden" name="hubspot_ready" value="true" />
      <label class="form-honeypot" aria-hidden="true">
        Website
        <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
      </label>
      <label>
        <span>{t.fields.name}</span>
        <input type="text" name={t.fieldNames.name} autocomplete="name" required />
      </label>
      <label>
        <span>{t.fields.email}</span>
        <input type="email" name={t.fieldNames.email} autocomplete="email" required />
      </label>
      <label>
        <span>{t.fields.company}</span>
        <input type="text" name={t.fieldNames.company} autocomplete="organization" required />
      </label>
      <label>
        <span>{t.fields.job}</span>
        <input type="text" name={t.fieldNames.job} autocomplete="organization-title" required />
      </label>
      <button type="submit">
        {t.submit}
        <i class="ph ph-download-simple" aria-hidden="true"></i>
      </button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </section>
</div>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-brief-download-form]');
    if (!form) return;

    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');
    const setStatus = (state, message) => {
      status.textContent = message;
      status.dataset.state = state;
    };

    const triggerDownload = () => {
      const link = document.createElement('a');
      link.href = form.dataset.downloadUrl;
      link.download = form.dataset.fileName || '';
      document.body.appendChild(link);
      link.click();
      link.remove();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      if (String(formData.get('company_url') || '').trim()) {
        form.reset();
        triggerDownload();
        setStatus('success', form.dataset.trapSuccessMessage || '');
        return;
      }

      const body = new URLSearchParams();
      formData.forEach((value, key) => body.append(key, String(value)));
      body.set('_page', window.location.href);
      body.set('_subject', form.dataset.subject || '');
      body.set('_template', 'table');
      body.set('_captcha', 'false');
      const emailField = form.dataset.emailField || '';
      const email = String(formData.get(emailField) || '').trim();
      if (email) body.set('_replyto', email);

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      setStatus('loading', form.dataset.loadingMessage || '');

      try {
        const response = await fetch(form.dataset.contactEndpoint, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          },
          body,
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.error || result.success === false || result.success === 'false') {
          throw new Error(result.message || form.dataset.errorMessage || '');
        }

        triggerDownload();
        form.reset();
        setStatus('success', form.dataset.successMessage || '');
      } catch (error) {
        setStatus('error', error.message || form.dataset.errorMessage || '');
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
      }
    });
  })();
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  .brief-template-page {
    --purple: #7c3cff;
    --purple-soft: #aa7cff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.66);
    width: min(100% - 3rem, 1240px);
    margin: 0 auto;
    padding: clamp(7rem, 10vw, 9rem) 0 clamp(3rem, 6vw, 5.5rem);
    color: #fff;
    overflow-x: hidden;
  }

  .brief-template-page,
  .brief-template-page * {
    box-sizing: border-box;
  }

  .brief-template-page::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 72% 8%, rgba(124, 60, 255, 0.15), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
    background-size: auto, 84px 84px, 84px 84px;
    content: '';
    pointer-events: none;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .section-kicker {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.65rem;
    color: var(--purple-soft);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.1rem;
    height: 2px;
    background: linear-gradient(90deg, var(--purple), var(--purple-soft));
    content: '';
  }

  .brief-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(430px, 1.04fr);
    gap: clamp(1.4rem, 4vw, 4rem);
    align-items: center;
    min-height: 560px;
  }

  .hero-copy,
  .section-heading,
  .download-copy {
    display: grid;
    gap: 1rem;
  }

  .hero-copy h1 {
    max-width: 770px;
    font-size: clamp(3rem, 5.4vw, 5.1rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .hero-copy p,
  .section-heading p,
  .download-copy p {
    max-width: 66ch;
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.62;
  }

  .hero-copy .positioning {
    max-width: 48ch;
    color: #fff;
    font-size: clamp(1.08rem, 1.55vw, 1.32rem);
    font-weight: 900;
    line-height: 1.32;
  }

  .file-badge {
    width: fit-content;
    border: 1px solid rgba(170, 124, 255, 0.38);
    border-radius: 999px;
    padding: 0.52rem 0.72rem;
    background: rgba(124, 60, 255, 0.12);
    color: #dfd3ff;
    font-size: 0.84rem;
    font-weight: 900;
  }

  .hero-actions,
  .internal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .button,
  .download-form button {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1.15rem;
    color: #fff;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
    cursor: pointer;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .button:hover,
  .button:focus-visible,
  .download-form button:hover,
  .download-form button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary,
  .download-form button {
    background: linear-gradient(135deg, #9c5cff, #6729ef);
    box-shadow: 0 1.2rem 2.8rem rgba(124, 60, 255, 0.28);
  }

  .button-secondary {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.035);
  }

  .hero-visual,
  .preview-card,
  .scope-section,
  .workflow-section,
  .download-section {
    border: 1px solid var(--line);
    border-radius: 8px;
    background:
      radial-gradient(circle at 16% 0%, rgba(124, 60, 255, 0.13), transparent 14rem),
      linear-gradient(145deg, rgba(20, 21, 31, 0.92), rgba(7, 8, 12, 0.92));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045);
  }

  .hero-visual {
    overflow: hidden;
    margin: 0;
    aspect-ratio: 1.68;
    background: #05060a;
    box-shadow: 0 2rem 5.5rem rgba(0, 0, 0, 0.34);
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-section,
  .scope-section,
  .workflow-section,
  .download-section {
    margin-top: clamp(1.7rem, 4vw, 3.4rem);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .preview-card {
    display: grid;
    gap: 0.85rem;
    padding: 0.85rem;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .preview-card:hover {
    transform: translateY(-4px);
    border-color: rgba(170, 124, 255, 0.56);
    box-shadow: 0 1.2rem 3rem rgba(75, 38, 180, 0.18);
  }

  .preview-card figure {
    display: grid;
    overflow: hidden;
    min-height: 10.5rem;
    margin: 0;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #fff;
  }

  .preview-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .preview-card h3 {
    font-size: 1rem;
    line-height: 1.16;
  }

  .scope-section,
