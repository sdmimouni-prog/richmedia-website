---
import { BUSINESS, SITE } from '../consts';

const englishRootPaths = ['/rich-media-agency-morocco', '/influencer-marketing-morocco', '/social-media-management-morocco', '/seo-agency-morocco', '/online-advertising-morocco', '/website-development-morocco'];
const isEnglish = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/') || englishRootPaths.includes(Astro.url.pathname.replace(/\/$/, ''));
const homeHref = isEnglish ? '/en' : '/';
const currentYear = new Date().getFullYear();

const expertiseLinks = isEnglish
  ? [
      { label: 'Strategy & Branding', href: '/en/expertises/strategie-digitale' },
      { label: 'Social, Influence & UGC', href: '/en/expertises/influence' },
      { label: 'Social Media Management Morocco', href: '/social-media-management-morocco' },
      { label: 'Influencer Marketing Morocco', href: '/influencer-marketing-morocco' },
      { label: 'Media & Performance', href: '/en/expertises/media-performance' },
      { label: 'Online Advertising Morocco', href: '/online-advertising-morocco' },
      { label: 'SEO Agency Morocco', href: '/seo-agency-morocco' },
      { label: 'Website Development Morocco', href: '/website-development-morocco' },
      { label: 'Tech, AI & Experience', href: '/en/expertises/ia-automation' },
      { label: 'AI Agency Morocco', href: '/en/ai-agency-morocco' },
    ]
  : [
      { label: 'Stratégie & Branding', href: '/expertises/strategie-digitale' },
      { label: 'Social, Influence & UGC', href: '/expertises/influence' },
      { label: 'Gestion des réseaux sociaux au Maroc', href: '/gestion-reseaux-sociaux-maroc' },
      { label: 'Marketing d’influence au Maroc', href: '/marketing-influence-maroc' },
      { label: 'Media & Performance', href: '/expertises/media-performance' },
      { label: 'Publicité en ligne au Maroc', href: '/publicite-en-ligne-maroc' },
      { label: 'Agence SEO au Maroc', href: '/agence-seo-maroc' },
      { label: 'Création de site web au Maroc', href: '/creation-site-web-maroc' },
      { label: 'Tech, IA & Expérience', href: '/expertises/ia-automation' },
      { label: 'Agence IA au Maroc', href: '/agence-ia-maroc' },
    ];
const agencyLinks = isEnglish
  ? [
      { label: 'Rich Media Agency Morocco', href: '/rich-media-agency-morocco' },
      { label: 'Agency', href: '/en/agency' },
      { label: 'Team', href: '/en/team' },
      { label: 'Case studies', href: '/en/case-studies' },
      { label: 'Careers', href: '/en/careers' },
      { label: 'Contact', href: '/en/contact' },
    ]
  : [
      { label: 'Agence de communication au Maroc', href: '/agence-de-communication-maroc' },
      { label: 'Agence de communication à Casablanca', href: '/agence-de-communication-casablanca' },
      { label: 'Équipe', href: '/equipe' },
      { label: 'Réalisations', href: '/realisations' },
      { label: 'Carrières', href: '/carrieres' },
    ];

const expertiseColumnSize = Math.ceil(expertiseLinks.length / 2);
const expertiseLinkColumns = [
  expertiseLinks.slice(0, expertiseColumnSize),
  expertiseLinks.slice(expertiseColumnSize),
];

const footerDescription = isEnglish
  ? 'Digital marketing and performance agency in Casablanca: strategy, media performance, web development and AI. We generate measurable growth.'
  : SITE.description;

const labels = isEnglish
  ? {
      brandHome: 'Richmedia — Home',
      agency: 'Agency',
      contact: 'Contact',
      socials: 'Social media',
      offices: 'Our offices',
      rights: 'All rights reserved.',
      legal: 'Legal notice',
      privacy: 'Privacy',
      cookies: 'Cookies',
      sitemap: 'Sitemap',
    }
  : {
      brandHome: 'Richmedia — Accueil',
      agency: 'Agence',
      contact: 'Contact',
      socials: 'Réseaux sociaux',
      offices: 'Nos bureaux',
      rights: 'Tous droits réservés.',
      legal: 'Mentions légales',
      privacy: 'Confidentialité',
      cookies: 'Cookies',
      sitemap: 'Sitemap',
    };
---
<footer class="site-footer">
  <div class="footer-brand">
    <a href={homeHref} class="brand-lockup" aria-label={labels.brandHome}>
      <img
        class="brand-logo-image"
        src="/assets/richmedia-brand/logo-richmedia-wordmark.png"
        width="1248"
        height="232"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="brand-tagline">WE BUILD <strong>DIGITAL</strong> GROWTH</span>
    </a>
    <p>{footerDescription}</p>
  </div>

  <nav class="footer-expertise" aria-label={isEnglish ? 'Expertise' : 'Expertises'}>
    <h2>Expertise</h2>
    <div class="footer-link-columns">
      {expertiseLinkColumns.map((column) => (
        <div class="footer-link-column">
          {column.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      ))}
    </div>
  </nav>

  <nav aria-label={labels.agency}>
    <h2>{labels.agency}</h2>
    {agencyLinks.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <address>
    <h2>{labels.contact}</h2>
    <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
    {BUSINESS.tels.map((tel) => <a href={`tel:${tel.replaceAll(' ', '')}`}>{tel}</a>)}
    <div class="footer-socials" aria-label={labels.socials}>
      <a href={BUSINESS.sameAs[0]} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a>
      <a href={BUSINESS.sameAs[1]} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="ph ph-instagram-logo" aria-hidden="true"></i></a>
      <a href={BUSINESS.sameAs[2]} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="ph ph-facebook-logo" aria-hidden="true"></i></a>
    </div>
  </address>

  <div class="footer-offices">
    <h2>{labels.offices}</h2>
    <p>{isEnglish ? 'Casablanca, Morocco' : 'Casablanca, Maroc'}</p>
    <p>Dubai, UAE</p>
    <p>{isEnglish ? 'Montreal, Canada' : 'Montréal, Canada'}</p>
    <p>Strasbourg, France</p>
  </div>

  <div class="footer-bottom">
    <small>© {currentYear} {SITE.name}. {labels.rights}</small>
    <a href={isEnglish ? '/en/legal-notice' : '/mentions-legales'}>{labels.legal}</a>
    <a href={isEnglish ? '/en/privacy' : '/confidentialite'}>{labels.privacy}</a>
    <a href={isEnglish ? '/en/cookies' : '/cookies'}>{labels.cookies}</a>
    <a href={isEnglish ? '/en/sitemap' : '/sitemap'}>{labels.sitemap}</a>
  </div>
</footer>
