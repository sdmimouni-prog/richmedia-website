---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSiloLinks from './SeoSiloLinks.astro';
import { SITE } from '../consts';
import { breadcrumbs, faqSchema, localBusiness, serviceSchema } from '../lib/schema';

type Lang = 'fr' | 'en';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const isEnglish = lang === 'en';
const pagePath = isEnglish ? '/website-development-morocco' : '/creation-site-web-maroc';
const pageUrl = `${SITE.url}${pagePath}`;

const links = isEnglish
  ? {
      contact: '/en/contact',
      work: '/en/case-studies',
      web: '/en/expertises/web-si',
      seo: '/seo-agency-morocco',
      media: '/en/expertises/media-performance',
      crm: '/en/expertises/crm-marketing-automation-morocco',
      whatsapp: '/en/products/whatsapp',
      strategy: '/en/expertises/strategie-digitale',
      euromed: '/en/case-studies/euromed-university-drupal-website-redesign-2025',
      nescafe: '/en/case-studies/nescafe-nadi-nescafe-2019',
      amana: '/en/case-studies/amana-tramway-phygital-2022',
      insight: '/en/insights/quality-content-durable-seo',
    }
  : {
      contact: '/contact',
      work: '/realisations',
      web: '/expertises/web-si',
      seo: '/agence-seo-maroc',
      media: '/expertises/media-performance',
      crm: '/expertises/marketing-automation-crm-maroc',
      whatsapp: '/produits/whatsapp',
      strategy: '/expertises/strategie-digitale',
      euromed: '/realisations/universite-euromed-refonte-site-web-2025',
      nescafe: '/realisations/nescafe-nadi-nescafe-2019',
      amana: '/realisations/amana-tramway-phygital-2022',
      insight: '/insights/contenu-qualite-seo-perenne',
    };

const meta = isEnglish
  ? {
      title: 'Website Development in Morocco | Richmedia',
      description:
        'Richmedia designs and develops websites in Morocco combining strategy, UX/UI, web design, development, SEO, performance, mobile experience and conversion.',
      h1: 'Website Development in Morocco',
      eyebrow: 'Web agency Morocco',
      hero:
        'Richmedia designs and develops modern, fast and conversion-focused websites, from strategy and UX to design, development, SEO and performance optimisation.',
      signature: 'Strategy · UX/UI · Design · Development · SEO · Performance',
      primaryCta: 'Contact the Richmedia team',
      secondaryCta: 'View case studies',
    }
  : {
      title: 'Création de site web au Maroc | Richmedia',
      description:
        'Richmedia conçoit des sites web au Maroc combinant stratégie, UX/UI, design, développement, SEO, performance, mobile et conversion. Découvrez notre approche.',
      h1: 'Création de site web au Maroc',
      eyebrow: 'Agence web au Maroc',
      hero:
        'Richmedia conçoit des sites web modernes, rapides et orientés conversion, de la stratégie et l’UX jusqu’au design, au développement et à l’optimisation SEO.',
      signature: 'Stratégie · UX/UI · Design · Développement · SEO · Performance',
      primaryCta: 'Contacter l’équipe Richmedia',
      secondaryCta: 'Voir nos cas clients',
    };

const intro = isEnglish
  ? {
      title: 'A website should do more than look good',
      text:
        'A high-performing website communicates the brand clearly, helps visitors understand the offer, works smoothly on mobile, loads quickly, supports SEO and gives each audience a clear next step. Design attracts attention. Experience, content and technology turn that attention into action.',
      bullets: ['Clarity', 'Trust', 'Mobile UX', 'Speed', 'Search visibility', 'Conversion', 'Scalability'],
    }
  : {
      title: 'Un site web ne doit pas seulement être beau. Il doit servir le business.',
      text:
        'Un site performant présente clairement la marque, rassure, reste simple à utiliser, fonctionne parfaitement sur mobile, charge vite, soutient le SEO et guide chaque visiteur vers une action. Le design attire l’attention. L’expérience, le contenu et la technologie transforment cette attention en action.',
      bullets: ['Clarté', 'Confiance', 'UX mobile', 'Vitesse', 'Visibilité Google', 'Conversion', 'Évolution'],
    };

const approach = isEnglish
  ? [
      { step: '01', title: 'Discovery & strategy', text: 'Business goals, audiences, journeys, competitors, content, features, KPIs and technical constraints.' },
      { step: '02', title: 'Architecture & UX', text: 'Sitemap, navigation, user journeys, content hierarchy, wireframes and SEO-aware conversion logic.' },
      { step: '03', title: 'UI design', text: 'Visual direction, design system, components, responsive interfaces and interactions aligned with the brand.' },
      { step: '04', title: 'Development', text: 'Corporate websites, landing pages, CMS, forms, CRM links, APIs or e-commerce blocks according to the project.' },
      { step: '05', title: 'QA, SEO & performance', text: 'Responsive QA, forms, links, accessibility, technical SEO, image performance, Core Web Vitals and analytics.' },
      { step: '06', title: 'Launch & optimisation', text: 'Deployment, monitoring, fixes, analysis and continuous improvements after launch.' },
    ]
  : [
      { step: '01', title: 'Cadrage & stratégie', text: 'Objectifs business, audiences, parcours, concurrence, contenus, fonctionnalités, KPI et contraintes techniques.' },
      { step: '02', title: 'Architecture & UX', text: 'Arborescence, navigation, parcours utilisateurs, hiérarchie de l’information, wireframes et logique SEO/conversion.' },
      { step: '03', title: 'UI design', text: 'Direction visuelle, design system, composants, responsive et interactions cohérentes avec l’identité de marque.' },
      { step: '04', title: 'Développement', text: 'Sites corporate, landing pages, CMS, formulaires, CRM, APIs ou briques e-commerce selon le périmètre réel du projet.' },
      { step: '05', title: 'QA, SEO & performance', text: 'Recette responsive, formulaires, liens, accessibilité, SEO technique, images, Core Web Vitals et analytics.' },
      { step: '06', title: 'Mise en ligne & optimisation', text: 'Déploiement, monitoring, corrections, analyse et évolutions après lancement.' },
    ];

const siteTypes = isEnglish
  ? [
      { title: 'Corporate websites', text: 'For companies, institutions, groups and brands that need credibility, information, recruitment and acquisition.' },
      { title: 'Lead generation websites', text: 'Offer pages, forms, WhatsApp paths and contact journeys designed to capture qualified requests.' },
      { title: 'E-commerce', text: 'Product catalogues, purchase journeys, analytics and integrations when commerce is part of the project scope.' },
      { title: 'Landing pages', text: 'Campaign pages for acquisition, real estate, education, product launches and measurable lead generation.' },
      { title: 'Digital platforms', text: 'Client spaces, portals, dashboards or web applications connected to operational and marketing systems.' },
    ]
  : [
      { title: 'Site corporate', text: 'Pour entreprises, institutions, groupes et marques qui doivent informer, rassurer, recruter et renforcer leur crédibilité.' },
      { title: 'Site vitrine / génération de leads', text: 'Pages d’offre, formulaires, parcours WhatsApp et prises de contact pensés pour capter des demandes qualifiées.' },
      { title: 'E-commerce', text: 'Catalogue, parcours produit, analytics et intégrations lorsque la vente en ligne fait partie du périmètre.' },
      { title: 'Landing pages', text: 'Pages de campagne pour acquisition, immobilier, éducation, lancement produit et génération de leads mesurable.' },
      { title: 'Plateformes digitales', text: 'Espaces clients, portails, dashboards ou applications web connectés aux systèmes marketing et métier.' },
    ];

const focusBlocks = isEnglish
  ? [
      {
        kicker: 'UX/UI',
        title: 'User experience before decoration',
        text:
          'A good interface helps visitors understand where they are, what the brand offers, why it matters and what to do next. Navigation, hierarchy, readability, responsive design and accessibility reduce friction before conversion.',
        href: links.web,
        label: 'Explore Web & IS',
      },
      {
        kicker: 'Mobile & performance',
        title: 'Designed for every screen',
        text:
          'Mobile journeys need readable content, touch-friendly actions, short forms, fast images and stable layouts. Performance also depends on scripts, fonts, caching, tracking, hosting and third-party tools.',
        href: links.media,
        label: 'Connect media and landing pages',
      },
      {
        kicker: 'SEO by design',
        title: 'SEO should be built into the website, not added afterwards',
        text:
          'Architecture, UX, content, development, technical SEO and indexation must be considered before launch to avoid weak URLs, duplication, poor hierarchy, slow pages or migration issues.',
        href: links.seo,
        label: 'See SEO agency approach',
      },
      {
        kicker: 'Conversion',
        title: 'Built to turn visits into action',
        text:
          'A website should help visitors understand, trust and act: contact request, lead, call, WhatsApp, download, appointment, purchase or application. CTAs, forms, proof and content work together.',
        href: links.crm,
        label: 'Connect CRM and automation',
      },
    ]
  : [
      {
        kicker: 'UX/UI',
        title: 'L’expérience utilisateur avant la décoration',
        text:
          'Une bonne interface permet de comprendre où l’on est, ce que propose la marque, pourquoi elle est pertinente et où cliquer. Navigation, hiérarchie, lisibilité, responsive et accessibilité réduisent la friction avant la conversion.',
        href: links.web,
        label: 'Explorer Web & SI',
      },
      {
        kicker: 'Mobile & performance',
        title: 'Pensé pour le mobile dès le départ',
        text:
          'Les parcours mobiles exigent contenus lisibles, boutons tactiles, formulaires courts, images rapides et stabilité visuelle. La performance dépend aussi des scripts, fonts, cache, tracking, hébergement et outils tiers.',
        href: links.media,
        label: 'Relier média et landing pages',
      },
      {
        kicker: 'SEO by design',
        title: 'Le SEO doit être pensé avant la mise en ligne',
        text:
          'Architecture, UX, contenu, développement, SEO technique et indexation doivent être cadrés avant le lancement pour éviter URLs faibles, duplication, mauvaise hiérarchie, pages lentes ou pertes de migration.',
        href: links.seo,
        label: 'Voir l’approche SEO',
      },
      {
        kicker: 'Conversion',
        title: 'Transformer les visites en actions',
        text:
          'Un site doit aider à comprendre, faire confiance et agir : demande de contact, lead, appel, WhatsApp, téléchargement, rendez-vous, achat ou candidature. CTA, formulaires, preuves et contenus travaillent ensemble.',
        href: links.crm,
        label: 'Connecter CRM et automation',
      },
    ];

const connectedBlocks = isEnglish
  ? [
      { title: 'Editable content', text: 'Pages, news, media, SEO fields, forms and user permissions can be framed around team autonomy.' },
      { title: 'Digital ecosystem', text: 'CRM, analytics, pixels, WhatsApp, automation, APIs, payments or business tools can be connected when relevant.' },
      { title: 'Website redesign', text: 'A redesign can modernize UX, speed and conversion, but SEO can drop if redirects, content and indexing are not handled carefully.' },
    ]
  : [
      { title: 'Un site administrable', text: 'Pages, actualités, médias, champs SEO, formulaires et droits utilisateurs peuvent être cadrés pour donner de l’autonomie aux équipes.' },
      { title: 'Écosystème digital connecté', text: 'CRM, analytics, pixels, WhatsApp, automation, APIs, paiement ou outils métier peuvent être reliés lorsque le projet le nécessite.' },
      { title: 'Refonte maîtrisée', text: 'Une refonte peut moderniser l’UX, la vitesse et la conversion, mais le SEO peut chuter si redirections, contenus et indexation sont mal gérés.' },
    ];

const marketText = isEnglish
  ? 'For international companies launching or expanding in Morocco, a website often has to balance global brand standards with local usage. Content, UX, languages, forms, WhatsApp journeys, points of sale, local SEO and market-specific landing pages can change how people understand and contact the brand. Richmedia frames these elements without forcing a generic recipe: the right structure depends on the audience, the offer, the business model and the operational follow-up available after each request.'
  : 'Créer un site adapté au marché marocain demande parfois de relier standards de marque, usages locaux et parcours commerciaux réels. Selon le secteur, il faut prendre en compte les audiences, le mobile, les langues, les formulaires, WhatsApp, les points de vente, le contenu, le SEO local et les chemins de conversion. Richmedia cadre ces sujets sans généralisation artificielle : la bonne structure dépend de l’audience, de l’offre, du modèle business et de la capacité opérationnelle à traiter chaque demande après le formulaire ou le clic.';

const projects = isEnglish
  ? [
      {
        client: 'Euromed University',
        type: 'Drupal website redesign',
        image: '/assets/richmedia-realizations/euromed-refonte-site-web-2025.webp',
        width: 1920,
        height: 1080,
        alt: 'Real screenshot of the Euromed University website redesigned by Richmedia',
        text: 'Multilingual institutional website with UX/UI, Drupal CMS, technical SEO, performance and tracking.',
        result: '+40% organic traffic, +80% loading time improvement and +20% applications.',
        href: links.euromed,
      },
      {
        client: 'Nescafé',
        type: 'Community platform',
        image: '/assets/richmedia-realizations/nescafe-nadi-nescafe.webp',
        width: 1572,
        height: 1162,
        alt: 'Nadi Nescafé community platform campaign visual',
        text: 'Digital platform and community experience with gamification, coupons and member acquisition.',
        result: '100K platform visits, 5K members and 2,500 downloaded or used coupons.',
        href: links.nescafe,
      },
      {
        client: 'Amana',
        type: 'Campaign landing page',
        image: '/assets/richmedia-home/campaign-wide-amana-tram.webp',
        width: 1600,
        height: 900,
        alt: 'Amana tramway phygital campaign with QR and landing page journey',
        text: 'Phygital activation connecting outdoor visibility, QR code, dedicated landing page and acquisition form.',
        result: '14,881 landing page visits, 8,418 QR scans and 4,183 leads.',
        href: links.amana,
      },
    ]
  : [
      {
        client: 'Université Euromed',
        type: 'Refonte site Drupal',
        image: '/assets/richmedia-realizations/euromed-refonte-site-web-2025.webp',
        width: 1920,
        height: 1080,
        alt: 'Screenshot réel du site Université Euromed refondu par Richmedia',
        text: 'Site institutionnel multilingue avec UX/UI, CMS Drupal, SEO technique, performance et tracking.',
        result: '+40 % trafic organique, +80 % amélioration du temps de chargement et +20 % candidatures.',
        href: links.euromed,
      },
      {
        client: 'Nescafé',
        type: 'Plateforme communautaire',
        image: '/assets/richmedia-realizations/nescafe-nadi-nescafe.webp',
        width: 1572,
        height: 1162,
        alt: 'Visuel de la plateforme communautaire Nadi Nescafé',
        text: 'Plateforme digitale et expérience communautaire avec gamification, coupons et acquisition de membres.',
        result: '100 K visites plateforme, 5 K membres et 2 500 coupons téléchargés ou utilisés.',
        href: links.nescafe,
      },
      {
        client: 'Amana',
        type: 'Landing page campagne',
        image: '/assets/richmedia-home/campaign-wide-amana-tram.webp',
        width: 1600,
        height: 900,
        alt: 'Campagne phygitale Amana avec QR code et landing page',
        text: 'Activation phygitale reliant visibilité terrain, QR code, landing page dédiée et formulaire d’acquisition.',
        result: '14 881 visites landing page, 8 418 scans QR et 4 183 leads.',
        href: links.amana,
      },
    ];

const why = isEnglish
  ? [
      { title: 'Strategy + UX', text: 'The project starts with goals and users, not with a decorative mockup.' },
      { title: 'Design + technology', text: 'Creative and technical teams work around the same user experience.' },
      { title: 'SEO + performance', text: 'Architecture, speed and search visibility are integrated from the design phase.' },
      { title: 'Business focus', text: 'The website is framed as a communication, acquisition or conversion tool.' },
    ]
  : [
      { title: 'Stratégie + UX', text: 'Le projet commence par les objectifs et les utilisateurs, pas par une maquette décorative.' },
      { title: 'Design + technologie', text: 'Les équipes créatives et techniques travaillent autour de la même expérience.' },
      { title: 'SEO + performance', text: 'Architecture, vitesse et visibilité sont intégrées dès la conception.' },
      { title: 'Vision business', text: 'Le site est pensé comme un outil de communication, d’acquisition ou de conversion.' },
    ];

const collaboration = isEnglish
  ? [
      { step: '01', title: 'Discovery', text: 'Goals, audiences, scope and constraints.' },
      { step: '02', title: 'UX', text: 'Architecture, journeys and wireframes.' },
      { step: '03', title: 'Design', text: 'UI, components and responsive states.' },
      { step: '04', title: 'Development & QA', text: 'Development, integrations, technical SEO and testing.' },
      { step: '05', title: 'Launch', text: 'Deployment, monitoring and optimisation.' },
    ]
  : [
      { step: '01', title: 'Cadrage', text: 'Objectifs, audiences, périmètre et contraintes.' },
      { step: '02', title: 'UX', text: 'Architecture, parcours et wireframes.' },
      { step: '03', title: 'Design', text: 'UI, composants et responsive.' },
      { step: '04', title: 'Développement & QA', text: 'Développement, intégrations, SEO technique et tests.' },
      { step: '05', title: 'Mise en ligne', text: 'Déploiement, monitoring et optimisation.' },
    ];

const faq = isEnglish
  ? [
      {
        question: 'How much does website development cost in Morocco?',
        answer:
          'There is no useful standard package. Budget depends on the number of pages, UX/UI depth, features, CMS, languages, content, e-commerce, integrations, animations, customisation level and maintenance needs.',
      },
      {
        question: 'How long does it take to build a website?',
        answer:
          'Timing depends on scope, content readiness, technical complexity and validation cycles. A clear discovery phase helps define a realistic schedule before design and development start.',
      },
      {
        question: 'What is the difference between a corporate website and an e-commerce website?',
        answer:
          'A corporate website mainly informs, reassures and generates contact or application requests. An e-commerce website adds product catalogue, cart, payment, stock or operational integrations.',
      },
      {
        question: 'Does Richmedia handle both design and development?',
        answer:
          'Yes, when the project scope requires it. Richmedia can frame strategy, UX, UI design, development, content structure, tracking, SEO foundations and launch QA.',
      },
      {
        question: 'Is SEO included in website development?',
        answer:
          'SEO should be considered from the start: structure, URLs, headings, performance, internal links, schema and migration rules. The depth depends on the project and may connect with a dedicated SEO mission.',
      },
      {
        question: 'Can a website be redesigned without losing SEO performance?',
        answer:
          'Yes, but the migration must be planned carefully. Existing pages, content, metadata, redirects, indexing signals and performance must be audited before launch to reduce SEO risk.',
      },
    ]
  : [
      {
        question: 'Combien coûte la création d’un site web au Maroc ?',
        answer:
          'Il n’existe pas de forfait standard utile. Le budget dépend du nombre de pages, de l’UX/UI, des fonctionnalités, du CMS, des langues, des contenus, de l’e-commerce, des intégrations, des animations, du niveau de personnalisation et de la maintenance.',
      },
      {
        question: 'Combien de temps faut-il pour créer un site web ?',
        answer:
          'Le délai dépend du périmètre, de la disponibilité des contenus, de la complexité technique et du processus de validation. Un cadrage clair permet de définir un planning réaliste avant le design et le développement.',
      },
      {
        question: 'Quelle est la différence entre un site vitrine et un site e-commerce ?',
        answer:
          'Un site vitrine présente l’entreprise, rassure et génère des demandes de contact. Un site e-commerce ajoute catalogue produit, panier, paiement, stock ou intégrations opérationnelles.',
      },
      {
        question: 'Richmedia prend-elle en charge le design et le développement ?',
        answer:
          'Oui, lorsque le périmètre le nécessite. Richmedia peut cadrer la stratégie, l’UX, l’UI design, le développement, la structure de contenu, le tracking, les fondations SEO et la recette de lancement.',
      },
      {
        question: 'Le SEO est-il inclus dans la création du site ?',
        answer:
          'Le SEO doit être intégré dès le départ : structure, URLs, titres, performance, maillage, schema et règles de migration. La profondeur dépend du projet et peut être reliée à une mission SEO dédiée.',
      },
      {
        question: 'Peut-on refaire un site existant sans perdre son référencement ?',
        answer:
          'Oui, mais la migration doit être préparée. Pages existantes, contenus, métadonnées, redirections, signaux d’indexation et performance doivent être audités avant la mise en ligne pour limiter le risque SEO.',
      },
    ];

const siloLinks = isEnglish
  ? [
      { href: links.web, label: 'Web & IS expertise', text: 'Understand Richmedia capabilities around websites, platforms and connected systems.' },
      { href: links.seo, label: 'SEO Agency Morocco', text: 'Connect website architecture with SEO, content and technical visibility.' },
      { href: links.media, label: 'Media & Performance', text: 'Build campaign landing pages that support acquisition and measurement.' },
      { href: links.crm, label: 'CRM automation agency Morocco', text: 'Connect forms, leads, qualification and commercial follow-up.' },
      { href: links.whatsapp, label: 'WhatsApp Business Morocco', text: 'Add conversational paths when WhatsApp is the right conversion channel.' },
      { href: links.euromed, label: 'Euromed web redesign case study', text: 'See a real Drupal website redesign with validated UX, SEO and performance results.' },
      { href: links.insight, label: 'Durable SEO content', text: 'Read how useful content supports search visibility over time.' },
      { href: links.contact, label: isEnglish ? 'Contact the Richmedia team' : 'Contacter l’équipe Richmedia', text: 'Frame a website creation or redesign project with Richmedia.' },
    ]
  : [
      { href: links.web, label: 'Expertise Web & SI', text: 'Comprendre les capacités Richmedia autour des sites, plateformes et systèmes connectés.' },
      { href: links.seo, label: 'Agence SEO au Maroc', text: 'Relier architecture du site, contenu et visibilité technique.' },
      { href: links.media, label: 'Média & Performance', text: 'Créer des landing pages de campagne utiles à l’acquisition et à la mesure.' },
      { href: links.crm, label: 'Expertise CRM & automation Maroc', text: 'Connecter formulaires, leads, qualification et suivi commercial.' },
      { href: links.whatsapp, label: 'WhatsApp Business Maroc', text: 'Ajouter des parcours conversationnels lorsque WhatsApp est le bon canal de conversion.' },
      { href: links.euromed, label: 'Case study refonte web Euromed', text: 'Voir une refonte Drupal réelle avec résultats UX, SEO et performance validés.' },
      { href: links.insight, label: 'Contenu SEO durable', text: 'Lire comment les contenus utiles soutiennent la visibilité organique.' },
      { href: links.contact, label: 'Contacter l’équipe Richmedia', text: 'Cadrer un projet de création ou de refonte de site avec Richmedia.' },
    ];

const schema = [
  localBusiness(),
  serviceSchema({
    name: isEnglish ? 'Website development in Morocco' : 'Création de site web au Maroc',
    description: meta.description,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs([
    { name: isEnglish ? 'Home' : 'Accueil', url: isEnglish ? `${SITE.url}/en` : SITE.url },
    { name: isEnglish ? 'Website Development in Morocco' : 'Création de site web au Maroc', url: pageUrl },
  ]),
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={pageUrl}
  ogImage={`${SITE.url}/assets/richmedia-realizations/euromed-refonte-site-web-2025.webp`}
  lang={lang}
  schema={schema}
>
  <article class="website-dev-page">
    <section class="web-dev-hero" aria-labelledby="website-dev-title">
      <div class="hero-copy">
        <span class="section-kicker">{meta.eyebrow}</span>
        <h1 id="website-dev-title">{meta.h1}</h1>
        <p>{meta.hero}</p>
        <strong>{meta.signature}</strong>
        <div class="hero-actions">
          <a class="button button-primary" href={links.contact}>
            {meta.primaryCta}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="button button-secondary" href={links.work}>
            {meta.secondaryCta}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-label={isEnglish ? 'Real Richmedia web project screens' : 'Écrans réels de projets web Richmedia'}>
        <figure class="browser-frame">
          <div class="browser-top" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src="/assets/richmedia-realizations/euromed-refonte-site-web-2025.webp"
            alt={isEnglish ? 'Real Euromed University website homepage redesigned by Richmedia' : 'Homepage réelle du site Université Euromed refondu par Richmedia'}
            width="1920"
            height="1080"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            <span>{isEnglish ? 'Real project' : 'Projet réel'}</span>
            <strong>{isEnglish ? 'Euromed University website' : 'Site Université Euromed'}</strong>
          </figcaption>
        </figure>
        <figure class="mobile-screen">
          <img
            src="/assets/richmedia-case-study/proof-parcours.webp"
            alt={isEnglish ? 'Real mobile journey proof screen from a Richmedia case study' : 'Écran réel de parcours mobile issu d’un case study Richmedia'}
            width="202"
            height="282"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="dashboard-screen">
          <img
            src="/assets/richmedia-case-study/proof-dashboard.webp"
