---
import ProductLogo from './ProductLogo.astro';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

const platformUrl = 'https://www.in-talks.ma/';
const phoneUrl = 'tel:+212661172885';

const content = {
  fr: {
    eyebrow: 'Social listening',
    title: ['Écoutez.', 'Analysez.', 'Réagissez.'],
    intro:
      'In Talks transforme les conversations sociales, les avis, les mentions et les signaux de réputation en tableaux de bord lisibles pour décider vite.',
    primaryCta: 'Demander une démo',
    secondaryCta: 'Voir le cockpit',
    platformCta: 'Visiter la plateforme',
    highlights: [
      'Mentions en temps réel',
      'Sentiment & tonalité',
      'Veille concurrents',
      'Alertes crise',
      'Rapports automatisés',
      'Recommandations IA',
    ],
    stats: [
      { value: '24/7', label: 'veille marque et concurrents' },
      { value: '<10 min', label: 'détection des signaux sensibles' },
      { value: '360°', label: 'réputation, social, web et avis' },
      { value: '1', label: 'cockpit pour prioriser les actions' },
    ],
    visualTitle: 'Tout ce qui se dit, rangé par priorité.',
    visualText:
      'Mentions positives, risques, influenceurs, hashtags, campagnes concurrentes : chaque signal devient une action claire.',
    benefitsTitle: 'Pourquoi brancher In Talks avec Richmedia',
    benefitsText: 'La plateforme détecte. L’équipe transforme les signaux en décisions, contenus et plans d’action.',
    benefits: [
      {
        icon: 'ph-ear',
        title: 'Écoute sociale continue',
        text: 'Suivez marque, produits, dirigeants, concurrents, hashtags et sujets sensibles.',
      },
      {
        icon: 'ph-smiley',
        title: 'Analyse de sentiment',
        text: 'Repérez les pics positifs, irritants, questions fréquentes et signaux faibles.',
      },
      {
        icon: 'ph-siren',
        title: 'Alertes réputation',
        text: 'Recevez les signaux à risque avant qu’ils ne deviennent une crise publique.',
      },
      {
        icon: 'ph-chart-line-up',
        title: 'Pilotage de contenu',
        text: 'Transformez les conversations en angles éditoriaux, FAQ, preuves et campagnes.',
      },
    ],
    useCasesTitle: 'Ce que vos équipes peuvent suivre',
    useCasesText: 'Des vues courtes pour la direction, le marketing, le service client et la communication.',
    useCases: [
      {
        badge: 'Brand',
        title: 'Réputation de marque',
        text: 'Volume de mentions, perception, avis, sujets chauds et recommandations de réponse.',
        metric: 'Score 82',
        items: ['Marque', 'Avis', 'Crise'],
      },
      {
        badge: 'Market',
        title: 'Benchmark concurrents',
        text: 'Part de voix, campagnes actives, messages qui performent et opportunités non couvertes.',
        metric: '+18%',
        items: ['SOV', 'Campagnes', 'Tendances'],
      },
      {
        badge: 'Social',
        title: 'Réseaux sociaux',
        text: 'Hashtags, créateurs, commentaires, signaux UGC et sujets à amplifier.',
        metric: 'Live',
        items: ['Instagram', 'TikTok', 'LinkedIn'],
      },
    ],
    dashboardTitle: 'Un dashboard conçu pour l’action',
    dashboardText:
      'La lecture est simple : intensité du sujet, tonalité, niveau de risque et prochaine action à lancer.',
    dashboard: [
      { label: 'Sentiment positif', value: '71%', tone: 'green', level: 71 },
      { label: 'Part de voix', value: '42%', tone: 'cyan', level: 42 },
      { label: 'Risque réputation', value: 'Modéré', tone: 'amber', level: 56 },
      { label: 'Opportunités contenu', value: '18', tone: 'purple', level: 82 },
    ],
    topics: ['Prix & offres', 'Expérience client', 'Nouveaux besoins', 'Avis Google', 'Campagnes concurrentes'],
    finalTitle: 'Passez de la veille manuelle à une écoute sociale pilotée.',
    finalText:
      'Explorez In Talks pour découvrir la plateforme marocaine de social listening, ses vues, ses alertes et ses rapports.',
  },
  en: {
    eyebrow: 'Social listening',
    title: ['Listen.', 'Analyze.', 'Act.'],
    intro:
      'In Talks turns social conversations, reviews, mentions and reputation signals into clear dashboards built for fast decisions.',
    primaryCta: 'Request a demo',
    secondaryCta: 'View cockpit',
    platformCta: 'Visit the platform',
    highlights: [
      'Real-time mentions',
      'Sentiment & tone',
      'Competitor monitoring',
      'Crisis alerts',
      'Automated reports',
      'AI recommendations',
    ],
    stats: [
      { value: '24/7', label: 'brand and competitor monitoring' },
      { value: '<10 min', label: 'sensitive signal detection' },
      { value: '360°', label: 'reputation, social, web and reviews' },
      { value: '1', label: 'cockpit to prioritize actions' },
    ],
    visualTitle: 'Everything people say, ranked by priority.',
    visualText:
      'Positive mentions, risks, influencers, hashtags and competitor campaigns become clear next actions.',
    benefitsTitle: 'Why connect In Talks with Richmedia',
    benefitsText: 'The platform detects signals. The team turns them into decisions, content and action plans.',
    benefits: [
      {
        icon: 'ph-ear',
        title: 'Continuous social listening',
        text: 'Monitor brand, products, executives, competitors, hashtags and sensitive topics.',
      },
      {
        icon: 'ph-smiley',
        title: 'Sentiment analysis',
        text: 'Spot positive peaks, irritants, common questions and weak signals.',
      },
      {
        icon: 'ph-siren',
        title: 'Reputation alerts',
        text: 'Receive risk signals before they turn into a public issue.',
      },
      {
        icon: 'ph-chart-line-up',
        title: 'Content steering',
        text: 'Turn conversations into editorial angles, FAQs, proof points and campaigns.',
      },
    ],
    useCasesTitle: 'What your teams can track',
    useCasesText: 'Short views for leadership, marketing, customer care and communications.',
    useCases: [
      {
        badge: 'Brand',
        title: 'Brand reputation',
        text: 'Mention volume, perception, reviews, hot topics and response recommendations.',
        metric: 'Score 82',
        items: ['Brand', 'Reviews', 'Crisis'],
      },
      {
        badge: 'Market',
        title: 'Competitor benchmark',
        text: 'Share of voice, active campaigns, high-performing messages and white-space opportunities.',
        metric: '+18%',
        items: ['SOV', 'Campaigns', 'Trends'],
      },
      {
        badge: 'Social',
        title: 'Social networks',
        text: 'Hashtags, creators, comments, UGC signals and topics to amplify.',
        metric: 'Live',
        items: ['Instagram', 'TikTok', 'LinkedIn'],
      },
    ],
    dashboardTitle: 'A dashboard designed for action',
    dashboardText:
      'The reading is simple: topic intensity, tone, risk level and the next action to launch.',
    dashboard: [
      { label: 'Positive sentiment', value: '71%', tone: 'green', level: 71 },
      { label: 'Share of voice', value: '42%', tone: 'cyan', level: 42 },
      { label: 'Reputation risk', value: 'Moderate', tone: 'amber', level: 56 },
      { label: 'Content opportunities', value: '18', tone: 'purple', level: 82 },
    ],
    topics: ['Pricing & offers', 'Customer experience', 'Emerging needs', 'Google reviews', 'Competitor campaigns'],
    finalTitle: 'Move from manual monitoring to managed social listening.',
    finalText:
      'Explore In Talks to discover the Moroccan social listening platform, its views, alerts and reports.',
  },
};

const t = content[lang];
---

<div class="intalks-page">
  <section class="intalks-hero" aria-labelledby="intalks-title">
    <div class="intalks-copy">
      <ProductLogo
        src="/assets/product-logos/intalks-logo.png"
        alt="In Talks"
        width={816}
        height={243}
        logoWidth="12.6rem"
        logoHeight="2.8rem"
      />
      <span class="intalks-kicker">{t.eyebrow}</span>
      <h1 id="intalks-title">
        {t.title.map((line, index) => (
          <span class={index === 2 ? 'accent-line' : ''}>{line}</span>
        ))}
      </h1>
      <p>{t.intro}</p>
      <div class="intalks-actions">
        <a class="button button-primary" href={phoneUrl}>
          {t.primaryCta}
          <i class="ph ph-phone" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="#cockpit">
          {t.secondaryCta}
          <i class="ph ph-arrow-down" aria-hidden="true"></i>
        </a>
      </div>
      <div class="hero-highlights" aria-label={lang === 'fr' ? 'Points clés' : 'Highlights'}>
        {t.highlights.map((item) => (
          <span>
            <i class="ph ph-check" aria-hidden="true"></i>
            {item}
          </span>
        ))}
      </div>
    </div>

    <div class="intalks-console" aria-label={lang === 'fr' ? 'Aperçu In Talks' : 'In Talks preview'}>
      <img class="hero-image" src="/assets/richmedia-digital-strategy/strategy-hero.webp" alt="" loading="eager" decoding="async" />
      <div class="console-overlay"></div>
      <article class="signal-card signal-live">
        <span>{lang === 'fr' ? 'Mentions live' : 'Live mentions'}</span>
        <strong>1.8K</strong>
        <small>+24%</small>
      </article>
      <article class="signal-card signal-risk">
        <span>{lang === 'fr' ? 'Risque' : 'Risk'}</span>
        <strong>{lang === 'fr' ? 'Moyen' : 'Medium'}</strong>
        <small>{lang === 'fr' ? '3 sujets' : '3 topics'}</small>
      </article>
      <article class="sentiment-card">
        <div>
          <span>{lang === 'fr' ? 'Sentiment' : 'Sentiment'}</span>
          <strong>71%</strong>
        </div>
        <div class="sentiment-ring" aria-hidden="true"></div>
      </article>
      <div class="mention-feed">
        <span>{lang === 'fr' ? 'Flux prioritaire' : 'Priority feed'}</span>
        {t.topics.slice(0, 3).map((topic, index) => (
          <article>
            <i class:list={['ph', index === 1 ? 'ph-warning-circle' : 'ph-chat-circle-text']} aria-hidden="true"></i>
            <strong>{topic}</strong>
            <small>{index === 1 ? (lang === 'fr' ? 'à traiter' : 'review') : 'ok'}</small>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="stats-strip" aria-label={lang === 'fr' ? 'Indicateurs clés' : 'Key metrics'}>
    {t.stats.map((stat) => (
      <article>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </article>
    ))}
  </section>

  <section id="cockpit" class="visual-band" aria-labelledby="visual-title">
    <div class="visual-card large">
      <img src="/assets/richmedia-ia-automation/agent-workflows.webp" alt="" loading="lazy" decoding="async" />
      <div>
        <span>{lang === 'fr' ? 'Cockpit réputation' : 'Reputation cockpit'}</span>
        <h2 id="visual-title">{t.visualTitle}</h2>
        <p>{t.visualText}</p>
      </div>
    </div>
    <div class="signal-stack" aria-label={lang === 'fr' ? 'Signaux suivis' : 'Tracked signals'}>
      {t.topics.map((topic, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{topic}</strong>
          <div aria-hidden="true">
            <i style={`--level: ${48 + index * 10}%`}></i>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-band benefits-band" aria-labelledby="benefits-title">
    <div class="section-intro">
      <span class="intalks-kicker">{lang === 'fr' ? 'Avantages' : 'Benefits'}</span>
      <h2 id="benefits-title">{t.benefitsTitle}</h2>
      <p>{t.benefitsText}</p>
    </div>
    <div class="benefit-grid">
      {t.benefits.map((benefit) => (
        <article>
          <i class:list={['ph', benefit.icon]} aria-hidden="true"></i>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="formats" class="section-band use-cases-band" aria-labelledby="use-cases-title">
    <div class="section-intro compact">
      <span class="intalks-kicker">{lang === 'fr' ? 'Cas d’usage' : 'Use cases'}</span>
      <h2 id="use-cases-title">{t.useCasesTitle}</h2>
      <p>{t.useCasesText}</p>
    </div>
    <div class="use-case-grid">
      {t.useCases.map((useCase) => (
        <article>
          <div>
            <span>{useCase.badge}</span>
            <strong>{useCase.metric}</strong>
          </div>
          <h3>{useCase.title}</h3>
          <p>{useCase.text}</p>
          <ul>
            {useCase.items.map((item) => (
              <li>
                <i class="ph ph-check" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="dashboard-band" aria-labelledby="dashboard-title">
    <div class="dashboard-copy">
      <span class="intalks-kicker">Dashboard</span>
      <h2 id="dashboard-title">{t.dashboardTitle}</h2>
      <p>{t.dashboardText}</p>
    </div>
    <div class="dashboard-panel">
      {t.dashboard.map((item) => (
        <article class:list={['dashboard-tile', item.tone]}>
          <div>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </div>
          <div class="bar" style={`--level: ${item.level}%`} aria-hidden="true">
            <i></i>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div>
      <span class="intalks-kicker">In Talks</span>
      <h2 id="final-cta-title">{t.finalTitle}</h2>
      <p>{t.finalText}</p>
    </div>
    <a class="button button-primary" href={platformUrl} target="_blank" rel="noopener">
      {t.platformCta}
      <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
    </a>
  </section>
</div>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .intalks-page {
    --purple: #7c3cff;
    --purple-2: #aa8cff;
    --green: #39e58f;
    --cyan: #39d7ff;
    --amber: #ffc857;
    --ink: #030407;
    --line: rgba(255, 255, 255, 0.12);
    --muted: rgba(255, 255, 255, 0.68);
    overflow-x: clip;
    color: #fff;
    background:
      radial-gradient(circle at 80% 9%, rgba(57, 229, 143, 0.18), transparent 28rem),
      radial-gradient(circle at 13% 38%, rgba(124, 60, 255, 0.24), transparent 32rem),
      linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 84px 84px, 84px 84px, auto;
  }

  .intalks-hero,
  .stats-strip,
  .visual-band,
  .section-band,
  .dashboard-band,
  .final-cta {
    width: min(100% - 3rem, 1320px);
    margin-inline: auto;
  }

  .intalks-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(440px, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    min-height: 720px;
    padding: 8.5rem 0 3rem;
  }

  .intalks-copy {
    display: grid;
    gap: 1.25rem;
  }

  .intalks-kicker {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.55rem;
    color: var(--green);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .intalks-kicker::before {
    width: 2rem;
    height: 2px;
    content: '';
    background: var(--green);
  }

  .intalks-copy h1 {
    display: grid;
    gap: 0.08em;
    max-width: 760px;
    --h1-size: clamp(3.15rem, 7vw, 6.15rem);
    color: #fff;
    font-size: var(--h1-size);
    line-height: 0.9;
  }

  .intalks-copy h1 span {
    display: block;
  }

  .accent-line {
    color: var(--cyan);
  }

  .intalks-copy p {
    max-width: 650px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .intalks-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 7px;
    padding: 0 1.25rem;
    color: #fff;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    border: 1px solid transparent;
    background: linear-gradient(135deg, #7c3cff, #0dbd8b);
    box-shadow: 0 1rem 2.6rem rgba(57, 229, 143, 0.16);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.035);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    border-color: rgba(57, 229, 143, 0.42);
    background: rgba(57, 229, 143, 0.08);
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 0.7rem 1.1rem;
    margin-top: 0.35rem;
  }

  .hero-highlights span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .hero-highlights i {
    display: inline-grid;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: var(--green);
    color: #031111;
    font-size: 0.85rem;
  }

  .intalks-console {
    position: relative;
    min-height: 590px;
  }

  .hero-image {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100%, 620px);
    height: 430px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    object-fit: cover;
    transform: translate(-50%, -50%);
    filter: saturate(1.04) drop-shadow(0 2rem 4rem rgba(0, 0, 0, 0.48));
  }

  .console-overlay {
    position: absolute;
    inset: 8% 0 8%;
    border: 1px solid rgba(57, 215, 255, 0.16);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, rgba(57, 229, 143, 0.16), transparent 34%),
      radial-gradient(circle at 50% 50%, rgba(124, 60, 255, 0.2), transparent 64%);
  }

  .signal-card,
  .sentiment-card,
  .mention-feed {
    position: absolute;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.28);
  }

  .signal-card,
  .sentiment-card {
    display: grid;
    gap: 0.25rem;
    min-width: 10.6rem;
    padding: 0.85rem;
    background: rgba(248, 250, 255, 0.97);
    color: #07080d;
  }

  .signal-card span,
  .signal-card small,
  .sentiment-card span,
  .mention-feed > span,
  .mention-feed small {
    color: rgba(7, 8, 13, 0.68);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .signal-card strong,
  .sentiment-card strong {
    color: #07080d;
    font-size: 1.8rem;
    line-height: 1;
  }

  .signal-live {
    top: 13%;
    right: 0;
  }

  .signal-live small,
  .sentiment-card strong {
    color: #0c9f75;
  }

  .signal-risk {
    right: 7%;
    bottom: 10%;
  }

  .signal-risk small {
    color: #b27a00;
  }

  .sentiment-card {
    bottom: 18%;
    left: -1%;
    grid-template-columns: minmax(0, 1fr) 4.3rem;
    align-items: center;
    width: 15rem;
  }

  .sentiment-ring {
    width: 4.1rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, #fff 0 52%, transparent 53%),
      conic-gradient(var(--green) 0 71%, rgba(7, 8, 13, 0.12) 71% 100%);
  }

  .mention-feed {
    top: 9%;
    left: 0;
    display: grid;
    gap: 0.45rem;
    width: 16.5rem;
    padding: 0.75rem;
    background: rgba(248, 250, 255, 0.97);
    color: #07080d;
  }

  .mention-feed article {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr) auto;
    gap: 0.45rem;
    align-items: center;
    border-radius: 7px;
    padding: 0.42rem;
    background: rgba(7, 8, 13, 0.045);
  }

  .mention-feed i {
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(57, 229, 143, 0.16);
    color: #0c9f75;
  }

  .mention-feed strong {
    overflow: hidden;
    color: #07080d;
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding-bottom: 3rem;
  }

  .stats-strip article {
    min-height: 7.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .stats-strip strong {
    display: block;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
  }

  .stats-strip span {
    display: block;
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .visual-band,
  .section-band,
  .dashboard-band {
    padding-block: 3.8rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .visual-band {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
    gap: 0.85rem;
  }

  .visual-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
  }

  .visual-card.large {
    position: relative;
    min-height: 430px;
  }

  .visual-card.large img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-card.large::after {
    position: absolute;
    inset: 0;
