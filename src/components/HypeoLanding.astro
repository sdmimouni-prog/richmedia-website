---
import ProductLogo from './ProductLogo.astro';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;

const platformUrl = 'https://hypeo.ai';
const phoneUrl = 'tel:+212661172885';

const content = {
  fr: {
    eyebrow: 'Plateforme influence IA',
    title: ['Trouvez.', 'Briefez.', 'Mesurez.'],
    intro:
      'Hypeo.ai connecte les marques aux bons créateurs avec matching IA, briefs assistés, workflow campagne et dashboard performance.',
    primaryCta: 'Demander une démo',
    secondaryCta: 'Voir les formats',
    platformCta: 'Visiter la plateforme',
    highlights: [
      'Matching créateurs par IA',
      'Briefs & scripts assistés',
      'Marketplace campagnes',
      'Estimation de prix',
      'Suivi des livrables',
      'KPIs performance',
    ],
    stats: [
      { value: '5 min', label: 'pour cadrer une campagne' },
      { value: '2M+', label: 'créateurs activables' },
      { value: '80%', label: 'temps de préparation économisé' },
      { value: '3x', label: 'engagement potentiel' },
    ],
    visualTitle: 'Un cockpit pour orchestrer vos créateurs.',
    visualText:
      'Sélection, brief, validation, contenu, reporting : tout le cycle influence est centralisé dans une lecture simple.',
    benefitsTitle: 'Pourquoi Hypeo accélère l’influence',
    benefitsText: 'Moins de recherche manuelle, plus de collaborations pertinentes.',
    benefits: [
      {
        icon: 'ph-magic-wand',
        title: 'Matching IA',
        text: 'Identifiez les profils qui collent à votre cible, vos valeurs et votre budget.',
      },
      {
        icon: 'ph-note-pencil',
        title: 'Briefs prêts à envoyer',
        text: 'Générez des scripts, angles créatifs et consignes adaptées à chaque campagne.',
      },
      {
        icon: 'ph-storefront',
        title: 'Marketplace créateurs',
        text: 'Activez des talents vérifiés et suivez les opportunités en continu.',
      },
      {
        icon: 'ph-chart-donut',
        title: 'Performance lisible',
        text: 'Pilotez reach, engagement, livrables, coût et ROI dans un seul dashboard.',
      },
    ],
    offersTitle: 'Trois modes d’activation',
    offersText: 'Des formats simples pour tester, scaler ou industrialiser l’influence.',
    offers: [
      {
        badge: 'Scout',
        title: 'Recherche créateurs',
        text: 'Shortlist qualifiée par audience, affinité marque et potentiel d’engagement.',
        metric: '48h',
        items: ['Matching', 'Score', 'Budget'],
      },
      {
        badge: 'Campaign',
        title: 'Campagne pilotée',
        text: 'Brief, sélection, coordination, livrables et validation dans un workflow clair.',
        metric: 'Live',
        items: ['Brief', 'Livrables', 'Suivi'],
      },
      {
        badge: 'Scale',
        title: 'Programme créateurs',
        text: 'Dispositif long terme avec ambassadeurs, UGC, reporting et optimisation.',
        metric: 'Always-on',
        items: ['UGC', 'CRM', 'ROI'],
      },
    ],
    audienceTitle: 'Pensé pour les marques et les créateurs',
    audiences: [
      {
        label: 'Marques & agences',
        title: 'Trouvez les bons profils plus vite',
        text: 'Matching IA, estimation de prix, scripts, workflow et KPIs pour professionnaliser chaque campagne.',
      },
      {
        label: 'Créateurs',
        title: 'Recevez des opportunités pertinentes',
        text: 'Accès marques, campagnes compatibles, scripts adaptables et suivi de performance.',
      },
    ],
    dashboardTitle: 'Un reporting fait pour décider',
    dashboardText:
      'Audience, engagement, qualité créative, coût par contenu et ROI sont suivis dans un tableau clair.',
    dashboard: [
      { label: 'Affinité', value: '92%', tone: 'purple' },
      { label: 'Engagement', value: '7.8%', tone: 'green' },
      { label: 'UGC livrés', value: '124', tone: 'cyan' },
      { label: 'Coût optimisé', value: '-31%', tone: 'amber' },
    ],
    finalTitle: 'Passez de la recherche manuelle au matching IA.',
    finalText:
      'Explorez Hypeo.ai pour découvrir la plateforme, les fonctionnalités et les accès marques/créateurs.',
  },
  en: {
    eyebrow: 'AI influencer platform',
    title: ['Match.', 'Brief.', 'Measure.'],
    intro:
      'Hypeo.ai connects brands with the right creators through AI matching, assisted briefs, campaign workflow and performance dashboards.',
    primaryCta: 'Request a demo',
    secondaryCta: 'View formats',
    platformCta: 'Visit the platform',
    highlights: [
      'AI creator matching',
      'Assisted briefs & scripts',
      'Campaign marketplace',
      'Price estimation',
      'Deliverable tracking',
      'Performance KPIs',
    ],
    stats: [
      { value: '5 min', label: 'to frame a campaign' },
      { value: '2M+', label: 'activable creators' },
      { value: '80%', label: 'prep time saved' },
      { value: '3x', label: 'potential engagement' },
    ],
    visualTitle: 'A cockpit to orchestrate your creators.',
    visualText:
      'Selection, brief, approval, content and reporting: the full influencer cycle is centralized in one simple view.',
    benefitsTitle: 'Why Hypeo accelerates influence',
    benefitsText: 'Less manual research, more relevant collaborations.',
    benefits: [
      {
        icon: 'ph-magic-wand',
        title: 'AI matching',
        text: 'Identify creators aligned with your target, values and budget.',
      },
      {
        icon: 'ph-note-pencil',
        title: 'Ready-to-send briefs',
        text: 'Generate scripts, creative angles and instructions adapted to each campaign.',
      },
      {
        icon: 'ph-storefront',
        title: 'Creator marketplace',
        text: 'Activate verified talent and track opportunities continuously.',
      },
      {
        icon: 'ph-chart-donut',
        title: 'Readable performance',
        text: 'Manage reach, engagement, deliverables, cost and ROI in one dashboard.',
      },
    ],
    offersTitle: 'Three activation modes',
    offersText: 'Simple formats to test, scale or industrialize creator marketing.',
    offers: [
      {
        badge: 'Scout',
        title: 'Creator discovery',
        text: 'Qualified shortlist by audience, brand fit and engagement potential.',
        metric: '48h',
        items: ['Matching', 'Score', 'Budget'],
      },
      {
        badge: 'Campaign',
        title: 'Managed campaign',
        text: 'Brief, selection, coordination, deliverables and approvals in a clear workflow.',
        metric: 'Live',
        items: ['Brief', 'Assets', 'Tracking'],
      },
      {
        badge: 'Scale',
        title: 'Creator program',
        text: 'Long-term system with ambassadors, UGC, reporting and optimization.',
        metric: 'Always-on',
        items: ['UGC', 'CRM', 'ROI'],
      },
    ],
    audienceTitle: 'Built for brands and creators',
    audiences: [
      {
        label: 'Brands & agencies',
        title: 'Find the right profiles faster',
        text: 'AI matching, price estimation, scripts, workflow and KPIs to professionalize every campaign.',
      },
      {
        label: 'Creators',
        title: 'Receive relevant opportunities',
        text: 'Brand access, compatible campaigns, adaptable scripts and performance tracking.',
      },
    ],
    dashboardTitle: 'Reporting built for decisions',
    dashboardText:
      'Audience, engagement, creative quality, cost per asset and ROI are tracked in a clear dashboard.',
    dashboard: [
      { label: 'Fit score', value: '92%', tone: 'purple' },
      { label: 'Engagement', value: '7.8%', tone: 'green' },
      { label: 'UGC delivered', value: '124', tone: 'cyan' },
      { label: 'Cost optimized', value: '-31%', tone: 'amber' },
    ],
    finalTitle: 'Move from manual search to AI matching.',
    finalText:
      'Explore Hypeo.ai to discover the platform, features and access for brands and creators.',
  },
};

const t = content[lang];
---

<div class="hypeo-page">
  <section class="hypeo-hero" aria-labelledby="hypeo-title">
    <div class="hypeo-copy">
      <ProductLogo
        src="/assets/product-logos/hypeo-logo.png"
        alt="Hypeo.ai"
        width={888}
        height={164}
        logoWidth="12.8rem"
        logoHeight="2.35rem"
      />
      <span class="hypeo-kicker">{t.eyebrow}</span>
      <h1 id="hypeo-title">
        {t.title.map((line, index) => (
          <span class={index === 2 ? 'accent-line' : ''}>{line}</span>
        ))}
      </h1>
      <p>{t.intro}</p>
      <div class="hypeo-actions">
        <a class="button button-primary" href={phoneUrl}>
          {t.primaryCta}
          <i class="ph ph-phone" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href="#formats">
          {t.secondaryCta}
          <i class="ph ph-arrow-down" aria-hidden="true"></i>
        </a>
      </div>
      <div class="hero-highlights" aria-label={lang === 'fr' ? 'Points clés' : 'Highlights'}>
        {t.highlights.map((item) => (
          <span>
            <i class="ph ph-check" aria-hidden="true"></i>
            {item}
          </span>
        ))}
      </div>
    </div>

    <div class="hypeo-visual" aria-label={lang === 'fr' ? 'Aperçu Hypeo' : 'Hypeo preview'}>
      <img class="hero-image" src="/assets/richmedia-influence/influence-hero.webp" alt="" width="1586" height="992" loading="eager" decoding="async" fetchpriority="high" />
      <div class="creator-card card-one">
        <img src="/assets/richmedia-influence/creator-lifestyle.webp" alt="" width="1122" height="1402" loading="eager" decoding="async" />
        <div>
          <span>Beauty creator</span>
          <strong>94%</strong>
        </div>
      </div>
      <div class="creator-card card-two">
        <img src="/assets/richmedia-influence/creator-urban.webp" alt="" width="1122" height="1402" loading="eager" decoding="async" />
        <div>
          <span>Urban creator</span>
          <strong>88%</strong>
        </div>
      </div>
      <div class="match-panel">
        <span>{lang === 'fr' ? 'Score de matching' : 'Matching score'}</span>
        <strong>92%</strong>
        <small>AI fit</small>
      </div>
    </div>
  </section>

  <section class="stats-strip" aria-label={lang === 'fr' ? 'Indicateurs clés' : 'Key metrics'}>
    {t.stats.map((stat) => (
      <article>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </article>
    ))}
  </section>

  <section class="visual-band" aria-labelledby="visual-title">
    <div class="visual-card large">
      <img src="/assets/richmedia-influence/trends/trend-ai-matching.webp" alt="" loading="lazy" decoding="async" width="1672" height="941" />
      <div>
        <span>{lang === 'fr' ? 'Matching IA' : 'AI matching'}</span>
        <h2 id="visual-title">{t.visualTitle}</h2>
        <p>{t.visualText}</p>
      </div>
    </div>
    <div class="visual-card stack">
      <img src="/assets/richmedia-influence/trends/trend-ugc-flywheel.webp" alt="" loading="lazy" decoding="async" width="1672" height="941" />
      <img src="/assets/richmedia-influence/creator-food.webp" alt="" loading="lazy" decoding="async" width="1122" height="1402" />
    </div>
  </section>

  <section class="section-band benefits-band" aria-labelledby="benefits-title">
    <div class="section-intro">
      <span class="hypeo-kicker">{lang === 'fr' ? 'Avantages' : 'Benefits'}</span>
      <h2 id="benefits-title">{t.benefitsTitle}</h2>
      <p>{t.benefitsText}</p>
    </div>
    <div class="benefit-grid">
      {t.benefits.map((benefit) => (
        <article>
          <i class:list={['ph', benefit.icon]} aria-hidden="true"></i>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="formats" class="section-band offers-band" aria-labelledby="offers-title">
    <div class="section-intro compact">
      <span class="hypeo-kicker">{lang === 'fr' ? 'Formats' : 'Formats'}</span>
      <h2 id="offers-title">{t.offersTitle}</h2>
      <p>{t.offersText}</p>
    </div>
    <div class="offer-grid">
      {t.offers.map((offer) => (
        <article>
          <div>
            <span>{offer.badge}</span>
            <strong>{offer.metric}</strong>
          </div>
          <h3>{offer.title}</h3>
          <p>{offer.text}</p>
          <ul>
            {offer.items.map((item) => (
              <li>
                <i class="ph ph-check" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="audience-band" aria-labelledby="audience-title">
    <div>
      <span class="hypeo-kicker">{lang === 'fr' ? 'Deux côtés' : 'Two-sided'}</span>
      <h2 id="audience-title">{t.audienceTitle}</h2>
    </div>
    <div class="audience-grid">
      {t.audiences.map((item) => (
        <article>
          <span>{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="dashboard-band" aria-labelledby="dashboard-title">
    <div class="dashboard-copy">
      <span class="hypeo-kicker">Dashboard</span>
      <h2 id="dashboard-title">{t.dashboardTitle}</h2>
      <p>{t.dashboardText}</p>
    </div>
    <div class="dashboard-panel">
      {t.dashboard.map((item) => (
        <article class:list={['dashboard-tile', item.tone]}>
          <span>{item.label}</span>
          <strong>{item.value}</strong>
          <i class="ph ph-wave-sine" aria-hidden="true"></i>
        </article>
      ))}
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div>
      <span class="hypeo-kicker">Hypeo.ai</span>
      <h2 id="final-cta-title">{t.finalTitle}</h2>
      <p>{t.finalText}</p>
    </div>
    <a class="button button-primary" href={platformUrl} target="_blank" rel="noopener">
      {t.platformCta}
      <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
    </a>
  </section>
</div>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .hypeo-page {
    --purple: #7c3cff;
    --purple-2: #a985ff;
    --teal: #23d6c8;
    --green: #38e38c;
    --amber: #ffca66;
    --cyan: #38d8ff;
    --line: rgba(255, 255, 255, 0.12);
    --muted: rgba(255, 255, 255, 0.68);
    overflow-x: clip;
    color: #fff;
    background:
      radial-gradient(circle at 78% 12%, rgba(35, 214, 200, 0.16), transparent 28rem),
      radial-gradient(circle at 14% 40%, rgba(124, 60, 255, 0.27), transparent 32rem),
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      #030407;
    background-size: auto, auto, 88px 88px, 88px 88px, auto;
  }

  .hypeo-hero,
  .stats-strip,
  .visual-band,
  .section-band,
  .audience-band,
  .dashboard-band,
  .final-cta {
    width: min(100% - 3rem, 1320px);
    margin-inline: auto;
  }

  .hypeo-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(440px, 0.98fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    min-height: 720px;
    padding: 8.5rem 0 3rem;
  }

  .hypeo-copy {
    display: grid;
    gap: 1.3rem;
  }

  .hypeo-kicker {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.55rem;
    color: var(--purple-2);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .hypeo-kicker::before {
    width: 2rem;
    height: 2px;
    content: '';
    background: var(--purple);
  }

  .hypeo-copy h1 {
    display: grid;
    gap: 0.08em;
    max-width: 720px;
    --h1-size: clamp(3.2rem, 7vw, 6.3rem);
    color: #fff;
    font-size: var(--h1-size);
    line-height: 0.9;
  }

  .hypeo-copy h1 span {
    display: block;
  }

  .accent-line {
    color: var(--teal);
  }

  .hypeo-copy p {
    max-width: 630px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .hypeo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 7px;
    padding: 0 1.25rem;
    color: #fff;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button-primary {
    border: 1px solid transparent;
    background: linear-gradient(135deg, #8c52ff, #23b8c8);
    box-shadow: 0 1rem 2.6rem rgba(35, 214, 200, 0.18);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.035);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    border-color: rgba(35, 214, 200, 0.42);
    background: rgba(35, 214, 200, 0.08);
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 0.7rem 1.1rem;
    margin-top: 0.35rem;
  }

  .hero-highlights span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.0625rem;
    font-weight: 800;
  }

  .hero-highlights i {
    display: inline-grid;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: var(--teal);
    color: #031111;
    font-size: 1.0625rem;
  }

  .hypeo-visual {
    position: relative;
    min-height: 590px;
  }

  .hero-image {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100%, 560px);
    height: 430px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    object-fit: cover;
    transform: translate(-50%, -50%);
    filter: saturate(1.02) drop-shadow(0 2rem 4rem rgba(0, 0, 0, 0.45));
  }

  .hypeo-visual::before {
    position: absolute;
    inset: 9% 0 6%;
    content: '';
    border: 1px solid rgba(35, 214, 200, 0.18);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, rgba(35, 214, 200, 0.16), transparent 36%),
      radial-gradient(circle at 50% 50%, rgba(124, 60, 255, 0.2), transparent 62%);
  }

  .creator-card,
  .match-panel {
    position: absolute;
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: rgba(246, 246, 255, 0.96);
    color: #07080d;
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.25);
  }

  .creator-card {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    width: 15rem;
    padding: 0.55rem;
  }

  .creator-card img {
    width: 4rem;
    height: 4rem;
    border-radius: 7px;
    object-fit: cover;
  }

  .creator-card div {
    display: grid;
    gap: 0.12rem;
  }

  .creator-card span,
  .match-panel span,
  .match-panel small {
    color: rgba(7, 8, 13, 0.68);
    font-size: 1.0625rem;
    font-weight: 900;
  }

  .creator-card strong,
  .match-panel strong {
    color: #07080d;
    font-size: 1.8rem;
    line-height: 1;
  }

  .card-one {
    top: 17%;
    right: -1%;
  }

  .card-two {
    bottom: 16%;
    left: -1%;
  }

  .match-panel {
    right: 5%;
    bottom: 9%;
    display: grid;
    gap: 0.25rem;
    min-width: 10.5rem;
    padding: 0.9rem;
  }

  .match-panel strong {
    color: var(--teal);
    font-size: 2.25rem;
  }

  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    padding-bottom: 3rem;
  }

  .stats-strip article {
    min-height: 7.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .stats-strip strong {
    display: block;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
  }

  .stats-strip span {
    display: block;
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.25;
  }

  .visual-band,
  .section-band,
  .audience-band,
  .dashboard-band {
    padding-block: 3.8rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .visual-band {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    gap: 0.85rem;
  }

  .visual-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
  }

  .visual-card.large {
    position: relative;
    min-height: 390px;
  }

  .visual-card.large img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-card.large::after {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(90deg, rgba(3, 4, 7, 0.92), rgba(3, 4, 7, 0.48) 58%, rgba(3, 4, 7, 0.08)),
      linear-gradient(0deg, rgba(3, 4, 7, 0.48), transparent 50%);
  }

  .visual-card.large div {
    position: absolute;
    bottom: 1.4rem;
    left: 1.4rem;
    z-index: 1;
    display: grid;
    gap: 0.55rem;
    max-width: 450px;
  }

  .visual-card.large span,
  .audience-grid span {
    color: var(--teal);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .visual-card.large h2,
  .section-intro h2,
  .audience-band h2,
  .dashboard-copy h2,
  .final-cta h2 {
