---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSiloLinks from './SeoSiloLinks.astro';
import { SITE } from '../consts';
import { breadcrumbs, faqSchema, serviceSchema } from '../lib/schema';
import { enSiloLinks, frSiloLinks } from '../lib/seo-silos';

type Lang = 'fr' | 'en';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const isEnglish = lang === 'en';
const assetBase = '/assets/richmedia-ia-automation';
const pagePath = isEnglish ? '/en/ai-agency-morocco' : '/agence-ia-maroc';
const pageUrl = `${SITE.url}${pagePath}`;

const links = isEnglish
  ? {
      contact: '/en/contact',
      tech: '/en/expertises/ia-automation',
      whatsapp: '/en/products/whatsapp',
      crm: '/en/glossary/crm',
      automation: '/en/expertises/crm-marketing-automation-morocco',
      web: '/website-development-morocco',
      cases: '/en/case-studies',
    }
  : {
      contact: '/contact',
      tech: '/expertises/ia-automation',
      whatsapp: '/produits/whatsapp',
      crm: '/glossaire/crm',
      automation: '/expertises/marketing-automation-crm-maroc',
      web: '/creation-site-web-maroc',
      cases: '/realisations',
    };

const copy = isEnglish
  ? {
      metaTitle: 'AI Agency in Morocco | AI Agents & Automation | Richmedia',
      metaDescription:
        'Richmedia helps companies in Morocco deploy AI agents, chatbots, intelligent automation and AI solutions connected to CRM, data, websites and business tools.',
      serviceName: 'AI Agency in Morocco',
      eyebrow: 'AI · Marketing · CRM',
      h1: 'AI Agency in Morocco',
      heroTitle: 'AI that actually works for your business.',
      heroText:
        'Richmedia designs and deploys AI agents, automations and intelligent solutions connected to your tools, data and business processes.',
      signature: 'AI Agents · Automation · Chatbots · CRM · WhatsApp · Data',
      primaryCta: 'Talk to an AI expert',
      secondaryCta: 'Explore Tech, AI & Experience',
      problemTitle: 'AI should not become another gadget',
      problemIntro:
        'A useful AI project starts with operational friction: slow response, scattered data, repetitive tasks and time lost by teams.',
      responseTitle: 'The right role for AI',
      responses: ['Automate', 'Reply', 'Qualify', 'Analyze'],
      solutionTitle: 'AI solutions designed around your processes',
      useCaseTitle: 'Where can AI create value in your company?',
      ecosystemTitle: 'AI connected to your digital ecosystem',
      ecosystemText:
        'Richmedia does not treat AI as an isolated technology. It can be connected to acquisition, the website, CRM, WhatsApp and data.',
      comparisonTitle: 'Chatbot, automation or AI agent: what is the difference?',
      comparisonNote: 'The best solution is not necessarily the most complex one.',
      methodTitle: 'From idea to an AI solution people actually use',
      safetyTitle: 'Automate without losing control',
      safetyIntro:
        'Every AI project needs rules, responsibilities and human supervision before it reaches customers or business-critical workflows.',
      safetyNote: 'Not every task should be automated.',
      faqTitle: 'Frequently asked questions about AI agencies and automation',
      linkTitle: 'Connect the rest of the system',
      ctaTitle: 'Which process could AI improve first?',
      ctaText:
        'Let’s identify the use cases that can create real value for your marketing, sales, customer service or operations.',
      finalCta: 'Talk to an AI expert',
      breadcrumb: [
        { name: 'Home', url: `${SITE.url}/en` },
        { name: 'AI Agency in Morocco', url: pageUrl },
      ],
    }
  : {
      metaTitle: 'Agence IA au Maroc | Agents IA & Automatisation | Richmedia',
      metaDescription:
        'Richmedia accompagne les entreprises au Maroc dans le déploiement d’agents IA, chatbots, automatisations, CRM intelligents et solutions d’intelligence artificielle connectées à leurs outils.',
      serviceName: 'Agence IA au Maroc',
      eyebrow: 'IA · Marketing · CRM',
      h1: 'Agence IA au Maroc',
      heroTitle: 'L’intelligence artificielle qui travaille réellement pour votre entreprise.',
      heroText:
        'Richmedia conçoit et déploie des agents IA, automatisations et solutions intelligentes connectés à vos outils, vos données et vos processus métier.',
      signature: 'Agents IA · Automation · Chatbots · CRM · WhatsApp · Data',
      primaryCta: 'Parler à un expert IA',
      secondaryCta: 'Explorer Tech, IA & Expérience',
      problemTitle: 'L’IA ne doit pas être un gadget de plus',
      problemIntro:
        'Un projet IA utile part des frictions opérationnelles : réponse lente, données dispersées, tâches répétitives et temps perdu par les équipes.',
      responseTitle: 'Le bon rôle de l’IA',
      responses: ['Automatiser', 'Répondre', 'Qualifier', 'Analyser'],
      solutionTitle: 'Des solutions IA conçues autour de vos processus',
      useCaseTitle: 'Où l’IA peut-elle créer de la valeur dans votre entreprise ?',
      ecosystemTitle: 'L’IA connectée à votre écosystème digital',
      ecosystemText:
        'Richmedia ne traite pas l’IA comme une technologie isolée. Elle peut être connectée à l’acquisition, au site web, au CRM, à WhatsApp et aux données.',
      comparisonTitle: 'Chatbot, automatisation ou agent IA : quelle différence ?',
      comparisonNote: 'La meilleure solution n’est pas nécessairement la plus complexe.',
      methodTitle: 'De l’idée à une solution IA réellement utilisée',
      safetyTitle: 'Automatiser sans perdre le contrôle',
      safetyIntro:
        'Chaque projet IA doit définir des règles, des responsabilités et une supervision humaine avant de toucher les clients ou les processus sensibles.',
      safetyNote: 'Toutes les tâches ne doivent pas être automatisées.',
      faqTitle: 'Questions fréquentes sur les agences IA et l’automatisation',
      linkTitle: 'Relier le reste du système',
      ctaTitle: 'Quel processus pourriez-vous améliorer avec l’IA ?',
      ctaText:
        'Identifions ensemble les cas d’usage capables de créer une vraie valeur pour votre marketing, vos ventes, votre service client ou vos opérations.',
      finalCta: 'Parler à un expert IA',
      breadcrumb: [
        { name: 'Accueil', url: SITE.url },
        { name: 'Agence IA au Maroc', url: pageUrl },
      ],
    };

const problems = isEnglish
  ? [
      { title: 'Repetitive tasks', text: 'Teams spend time copying, sorting, replying or updating the same information.' },
      { title: 'Leads handled too slowly', text: 'A lead loses value when it waits before being qualified, routed or followed up.' },
      { title: 'Scattered data', text: 'Forms, inboxes, CRM, WhatsApp and dashboards do not always share the same context.' },
      { title: 'Team time lost', text: 'People handle low-value coordination instead of focusing on decisions and relationships.' },
    ]
  : [
      { title: 'Tâches répétitives', text: 'Les équipes passent du temps à copier, trier, répondre ou mettre à jour les mêmes informations.' },
      { title: 'Leads traités trop lentement', text: 'Un lead perd de la valeur lorsqu’il attend avant d’être qualifié, orienté ou relancé.' },
      { title: 'Données dispersées', text: 'Formulaires, inbox, CRM, WhatsApp et dashboards ne partagent pas toujours le même contexte.' },
      { title: 'Temps perdu par les équipes', text: 'Les personnes gèrent de la coordination faible valeur au lieu de se concentrer sur la décision et la relation.' },
    ];

const solutions = isEnglish
  ? [
      {
        label: '01',
        title: 'AI agents',
        text: 'Supervised agents for lead qualification, sales assistance, support and document search.',
        items: ['Lead qualification', 'Sales assistant', 'Support', 'Document search'],
      },
      {
        label: '02',
        title: 'AI chatbots & WhatsApp',
        text: 'Conversational journeys that reply, qualify, book appointments, transfer to humans and update CRM context.',
        items: ['Replies', 'Qualification', 'Appointments', 'Human handoff', 'CRM'],
      },
      {
        label: '03',
        title: 'Process automation',
        text: 'Workflows connecting forms, CRM, email, WhatsApp, APIs and dashboards around clear business rules.',
        items: ['Forms', 'CRM', 'Email', 'WhatsApp', 'APIs', 'Dashboards'],
      },
      {
        label: '04',
        title: 'AI marketing & CRM',
        text: 'Segmentation, scoring, personalization, reporting, campaign analysis and follow-up scenarios.',
        items: ['Segmentation', 'Scoring', 'Personalization', 'Reporting', 'Campaign analysis', 'Follow-ups'],
      },
      {
        label: '05',
        title: 'AI consulting & integration',
        text: 'Audit, prioritization, prototype, integration and measurement to move from idea to a usable system.',
        items: ['Audit', 'Prioritization', 'Prototype', 'Integration', 'Measurement'],
      },
    ]
  : [
      {
        label: '01',
        title: 'Agents IA',
        text: 'Agents supervisés pour qualifier les leads, assister les commerciaux, soutenir le support et rechercher dans la documentation.',
        items: ['Qualification de leads', 'Assistant commercial', 'Support', 'Recherche documentaire'],
      },
      {
        label: '02',
        title: 'Chatbots IA & WhatsApp',
        text: 'Parcours conversationnels capables de répondre, qualifier, prendre rendez-vous, transférer à l’humain et enrichir le CRM.',
        items: ['Réponse', 'Qualification', 'Prise de rendez-vous', 'Transfert humain', 'CRM'],
      },
      {
        label: '03',
        title: 'Automatisation des processus',
        text: 'Workflows reliant formulaires, CRM, email, WhatsApp, APIs et dashboards autour de règles métier claires.',
        items: ['Formulaires', 'CRM', 'Email', 'WhatsApp', 'APIs', 'Dashboards'],
      },
      {
        label: '04',
        title: 'IA Marketing & CRM',
        text: 'Segmentation, scoring, personnalisation, reporting, analyse de campagnes et scénarios de relance.',
        items: ['Segmentation', 'Scoring', 'Personnalisation', 'Reporting', 'Analyse de campagnes', 'Relances'],
      },
      {
        label: '05',
        title: 'Conseil & intégration IA',
        text: 'Audit, priorisation, prototype, intégration et mesure pour passer d’une idée à un système réellement utilisé.',
        items: ['Audit', 'Priorisation', 'Prototype', 'Intégration', 'Mesure'],
      },
    ];

const useCases = isEnglish
  ? [
      { title: 'Marketing', text: 'Campaign analysis, segmentation, content support, landing page signals and reporting.' },
      { title: 'Sales', text: 'Lead qualification, routing, appointment preparation, CRM updates and follow-up alerts.' },
      { title: 'Customer service', text: 'First replies, FAQ, ticket preparation, human handoff and quality tracking.' },
      { title: 'Operations', text: 'Document search, internal requests, task creation, approvals and process dashboards.' },
    ]
  : [
      { title: 'Marketing', text: 'Analyse de campagnes, segmentation, aide au contenu, signaux landing page et reporting.' },
      { title: 'Commercial', text: 'Qualification de leads, routing, préparation de rendez-vous, mise à jour CRM et alertes de relance.' },
      { title: 'Service client', text: 'Premières réponses, FAQ, préparation de tickets, transfert humain et suivi qualité.' },
      { title: 'Opérations', text: 'Recherche documentaire, demandes internes, création de tâches, validations et dashboards process.' },
    ];

const ecosystem = isEnglish
  ? ['Acquisition', 'Website / Landing Page', 'AI Agent', 'CRM', 'WhatsApp / Email', 'Sales team', 'Data & Reporting']
  : ['Acquisition', 'Site / Landing Page', 'Agent IA', 'CRM', 'WhatsApp / Email', 'Équipe commerciale', 'Data & Reporting'];

const comparisons = isEnglish
  ? [
      { solution: 'Classic chatbot', role: 'Follows predefined scenarios' },
      { solution: 'AI chatbot', role: 'Understands and generates responses' },
      { solution: 'Automation', role: 'Executes a defined workflow' },
      { solution: 'AI agent', role: 'Analyzes context and uses authorized tools or actions' },
    ]
  : [
      { solution: 'Chatbot classique', role: 'Scénarios prédéfinis' },
      { solution: 'Chatbot IA', role: 'Comprend et génère des réponses' },
      { solution: 'Automatisation', role: 'Exécute un workflow défini' },
      { solution: 'Agent IA', role: 'Analyse un contexte et utilise des outils/actions autorisés' },
    ];

const method = isEnglish
  ? [
      { step: '01', title: 'Identify', text: 'Map processes, recurring requests, data sources and manual friction.' },
      { step: '02', title: 'Prioritize', text: 'Choose use cases by usefulness, feasibility, risk and operational ownership.' },
      { step: '03', title: 'Prototype', text: 'Build a controlled version before exposing the system to real users.' },
      { step: '04', title: 'Integrate', text: 'Connect the agent or workflow to the right tools, content and CRM data.' },
      { step: '05', title: 'Test and secure', text: 'Validate answers, edge cases, permissions, logs, escalation and fallback rules.' },
      { step: '06', title: 'Measure and improve', text: 'Track usage, quality, errors, response time and business contribution.' },
    ]
  : [
      { step: '01', title: 'Identifier', text: 'Cartographier les processus, demandes récurrentes, sources de données et frictions manuelles.' },
      { step: '02', title: 'Prioriser', text: 'Choisir les cas d’usage selon utilité, faisabilité, risque et responsabilité opérationnelle.' },
      { step: '03', title: 'Prototyper', text: 'Créer une version contrôlée avant d’exposer le système à de vrais utilisateurs.' },
      { step: '04', title: 'Intégrer', text: 'Connecter l’agent ou le workflow aux bons outils, contenus et données CRM.' },
      { step: '05', title: 'Tester et sécuriser', text: 'Valider réponses, cas limites, permissions, logs, escalade et fallback humain.' },
      { step: '06', title: 'Mesurer et améliorer', text: 'Suivre usage, qualité, erreurs, délai de réponse et contribution business.' },
    ];

const safety = isEnglish
  ? ['Permissions', 'Data', 'Human validation', 'Human fallback', 'Quality control', 'Confidentiality']
  : ['Permissions', 'Données', 'Validation humaine', 'Fallback humain', 'Contrôle qualité', 'Confidentialité'];

const faq = isEnglish
  ? [
      {
        question: 'What is an AI agency?',
        answer:
          'An AI agency helps companies identify, design, integrate and manage AI solutions such as AI agents, chatbots, process automation and connected workflows. The goal is to connect AI to real tools, data and business processes.',
      },
      {
        question: 'What can AI automate in a company?',
        answer:
          'AI can assist repetitive tasks, lead qualification, first replies, CRM updates, reporting, document search or follow-up scenarios. The scope depends on the available data, tools, risk level and human supervision required.',
      },
      {
        question: 'What is the difference between a chatbot and an AI agent?',
        answer:
          'A chatbot mainly manages conversation. An AI agent can analyze context and use authorized tools or actions, for example qualifying a request, preparing a CRM update or escalating to a person under defined rules.',
      },
      {
        question: 'How much does an AI project cost in Morocco?',
        answer:
          'The cost depends on the use case, data quality, integrations, security requirements, interfaces, testing and support. Richmedia frames the scope before discussing budget so the project stays realistic.',
      },
      {
        question: 'How long does it take to deploy an AI solution?',
        answer:
          'Timing depends on the complexity of the workflow, the tools to connect, the validation process and the testing required. A controlled prototype is usually the safest way to clarify effort before deployment.',
      },
      {
        question: 'Can an AI agent connect to WhatsApp or a CRM?',
        answer:
          'Yes, when the tools, permissions and data flows allow it. Richmedia can design journeys that connect WhatsApp, CRM, forms, email, dashboards and human handoff rules.',
      },
    ]
  : [
      {
        question: 'Qu’est-ce qu’une agence IA ?',
        answer:
          'Une agence IA aide les entreprises à identifier, concevoir, intégrer et piloter des solutions d’intelligence artificielle : agents IA, chatbots, automatisations et workflows connectés. L’objectif est de relier l’IA aux outils, aux données et aux processus réels.',
      },
      {
        question: 'Que peut automatiser l’IA dans une entreprise ?',
        answer:
          'L’IA peut assister les tâches répétitives, la qualification de leads, les premières réponses, les mises à jour CRM, le reporting, la recherche documentaire ou certains scénarios de relance. Le périmètre dépend des données, des outils, du risque et de la supervision humaine nécessaire.',
      },
      {
        question: 'Quelle différence entre chatbot et agent IA ?',
        answer:
          'Un chatbot gère principalement une conversation. Un agent IA peut analyser un contexte et utiliser des outils ou actions autorisés, par exemple qualifier une demande, préparer une mise à jour CRM ou escalader vers une personne selon des règles définies.',
      },
      {
        question: 'Combien coûte un projet IA au Maroc ?',
        answer:
          'Le coût dépend du cas d’usage, de la qualité des données, des intégrations, des exigences de sécurité, des interfaces, des tests et du support. Richmedia cadre le périmètre avant de parler budget pour garder un projet réaliste.',
      },
      {
        question: 'Combien de temps faut-il pour déployer une solution IA ?',
        answer:
          'Le délai dépend de la complexité du workflow, des outils à connecter, du processus de validation et des tests nécessaires. Un prototype contrôlé est souvent la meilleure manière de clarifier l’effort avant le déploiement.',
      },
      {
        question: 'Peut-on connecter un agent IA à WhatsApp ou à un CRM ?',
        answer:
          'Oui, lorsque les outils, permissions et flux de données le permettent. Richmedia peut concevoir des parcours reliant WhatsApp, CRM, formulaires, email, dashboards et règles de transfert humain.',
      },
    ];

const outboundLinks = isEnglish
  ? [
      { href: links.tech, label: 'Tech, AI & Experience', text: 'The global expertise page for AI, CRM, data and automation.' },
      { href: links.whatsapp, label: 'WhatsApp Business', text: 'Campaigns, messages, follow-ups and conversational conversion.' },
      { href: links.crm, label: 'CRM', text: 'Understand the role of CRM in qualification and follow-up.' },
      { href: links.automation, label: 'CRM & Marketing Automation', text: 'Workflows, scoring, routing and commercial follow-up.' },
      { href: links.web, label: 'Website Development Morocco', text: 'Websites, landing pages, forms and connected experiences.' },
      { href: links.contact, label: 'Contact', text: 'Frame a first AI use case with Richmedia.' },
    ]
  : [
      { href: links.tech, label: 'Tech, IA & Expérience', text: 'La page expertise globale sur IA, CRM, data et automation.' },
      { href: links.whatsapp, label: 'WhatsApp Business', text: 'Campagnes, messages, relances et conversion conversationnelle.' },
      { href: links.crm, label: 'CRM', text: 'Comprendre le rôle du CRM dans la qualification et la relance.' },
      { href: links.automation, label: 'Marketing Automation & CRM', text: 'Workflows, scoring, routing et suivi commercial.' },
      { href: links.web, label: 'Création de site web', text: 'Sites, landing pages, formulaires et expériences connectées.' },
      { href: links.contact, label: 'Contact', text: 'Cadrer un premier cas d’usage IA avec Richmedia.' },
    ];

const schema = [
  serviceSchema({
    name: copy.serviceName,
    description: copy.metaDescription,
    url: pageUrl,
  }),
  faqSchema(faq),
  breadcrumbs(copy.breadcrumb),
];
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonical={pageUrl}
  ogImage={`${SITE.url}${assetBase}/ia-automation-hero.webp`}
  lang={lang}
  schema={schema}
>
  <article class="ai-agency-page">
    <section class="ai-hero" aria-labelledby="ai-agency-title">
      <div class="ai-hero-copy">
        <span class="ai-kicker">{copy.eyebrow}</span>
        <h1 id="ai-agency-title">{copy.h1}</h1>
        <h2>{copy.heroTitle}</h2>
        <p>{copy.heroText}</p>
        <div class="ai-signature" aria-label={copy.signature}>
          {copy.signature.split(' · ').map((item) => <span>{item}</span>)}
        </div>
        <div class="ai-actions">
          <a class="ai-button ai-button-primary" href={links.contact}>
            {copy.primaryCta}
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="ai-button ai-button-secondary" href={links.tech}>
            {copy.secondaryCta}
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <figure class="ai-hero-visual">
        <img
          src={`${assetBase}/ia-automation-hero.webp`}
          alt={isEnglish ? 'Marketing and CRM team managing AI agents and automation workflows' : 'Équipe marketing et CRM pilotant des agents IA et des workflows automatisés'}
          width="1713"
          height="918"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption>
          <span>{isEnglish ? 'Growth system' : 'Système de croissance'}</span>
          <strong>{isEnglish ? 'Acquisition to automation' : 'De l’acquisition à l’automatisation'}</strong>
        </figcaption>
      </figure>
    </section>

    <section class="ai-problem ai-section" aria-labelledby="ai-problem-title">
      <div class="ai-section-heading">
        <span class="ai-kicker">{isEnglish ? 'Problem' : 'Problème'}</span>
        <h2 id="ai-problem-title">{copy.problemTitle}</h2>
        <p>{copy.problemIntro}</p>
      </div>
      <div class="problem-grid">
        {problems.map((problem) => (
          <article>
            <i class="ph ph-warning-circle" aria-hidden="true"></i>
            <h3>{problem.title}</h3>
            <p>{problem.text}</p>
          </article>
        ))}
      </div>
      <div class="response-strip" aria-label={copy.responseTitle}>
        <strong>{copy.responseTitle}</strong>
        {copy.responses.map((response) => <span>{response}</span>)}
      </div>
    </section>

    <section class="ai-section" aria-labelledby="ai-solutions-title">
      <div class="ai-section-heading split">
        <div>
          <span class="ai-kicker">{isEnglish ? 'Solutions' : 'Solutions IA'}</span>
          <h2 id="ai-solutions-title">{copy.solutionTitle}</h2>
        </div>
        <p>
          {isEnglish
            ? 'The scope is chosen after understanding the process, the tools already in place and the level of human control needed.'
            : 'Le périmètre se choisit après avoir compris le processus, les outils déjà en place et le niveau de contrôle humain nécessaire.'}
        </p>
      </div>
      <div class="solution-grid">
        {solutions.map((solution) => (
          <article>
            <span>{solution.label}</span>
            <h3>{solution.title}</h3>
            <p>{solution.text}</p>
            <ul>
              {solution.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ai-section usecase-section" aria-labelledby="ai-usecases-title">
      <div class="ai-section-heading">
        <span class="ai-kicker">{isEnglish ? 'Use cases' : 'Cas d’usage'}</span>
        <h2 id="ai-usecases-title">{copy.useCaseTitle}</h2>
      </div>
      <div class="usecase-grid">
        {useCases.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ai-section ecosystem-section" aria-labelledby="ai-ecosystem-title">
      <div class="ecosystem-copy">
        <span class="ai-kicker">{isEnglish ? 'Differentiation' : 'Différenciation Richmedia'}</span>
        <h2 id="ai-ecosystem-title">{copy.ecosystemTitle}</h2>
        <p>{copy.ecosystemText}</p>
        <a href={links.cases}>
          {isEnglish ? 'See connected case studies' : 'Voir les cas clients connectés'}
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>
      <ol class="ecosystem-flow">
        {ecosystem.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="ai-section compare-section" aria-labelledby="ai-comparison-title">
      <div class="ai-section-heading compact">
        <span class="ai-kicker">GEO</span>
        <h2 id="ai-comparison-title">{copy.comparisonTitle}</h2>
      </div>
      <div class="comparison-table" role="table" aria-label={copy.comparisonTitle}>
        <div role="row" class="comparison-head">
          <span role="columnheader">{isEnglish ? 'Solution' : 'Solution'}</span>
          <span role="columnheader">{isEnglish ? 'Function' : 'Fonction'}</span>
        </div>
        {comparisons.map((row) => (
          <div role="row">
            <strong role="cell">{row.solution}</strong>
            <span role="cell">{row.role}</span>
          </div>
        ))}
      </div>
      <p class="comparison-note">{copy.comparisonNote}</p>
    </section>

    <section class="ai-section method-section" aria-labelledby="ai-method-title">
      <div class="ai-section-heading split">
        <div>
          <span class="ai-kicker">{isEnglish ? 'Method' : 'Méthode'}</span>
          <h2 id="ai-method-title">{copy.methodTitle}</h2>
        </div>
        <p>
          {isEnglish
            ? 'Richmedia starts with focused use cases, then extends the system only when the process is clear and measurable.'
            : 'Richmedia démarre par des cas d’usage ciblés, puis étend le système lorsque le processus est clair et mesurable.'}
        </p>
      </div>
      <div class="method-rail">
        {method.map((step) => (
          <article>
            <span>{step.step}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

