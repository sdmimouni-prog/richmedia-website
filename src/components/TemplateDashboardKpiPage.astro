    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .preview-card h3 {
    font-size: 1.0625rem;
    line-height: 1.16;
  }

  .tabs-section,
  .audience-section,
  .download-section {
    padding: clamp(1.15rem, 3vw, 2rem);
  }

  .tabs-and-funnel {
    display: grid;
