---

<div class="template-dashboard-page" data-dashboard-download-page>
  <section class="template-hero" aria-labelledby="dashboard-template-title">
    <div class="hero-copy">
      <span class="section-kicker">{t.eyebrow}</span>
      <h1 id="dashboard-template-title">{t.title}</h1>
      <p>{t.subtitle}</p>
      <span class="file-badge">{t.badge}</span>
      <div class="hero-actions">
        <a class="button button-primary" href="#download-dashboard">
          {t.primaryCta}
          <i class="ph ph-download-simple" aria-hidden="true"></i>
        </a>
        <a class="button button-secondary" href={t.secondaryHref}>
          {t.secondaryCta}
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <figure class="hero-visual">
      <img
        src={`${assetBase}/hero-dashboard-kpi.webp`}
        alt={t.heroAlt}
        width="1600"
        height="920"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="preview-section" aria-labelledby="dashboard-preview-title">
    <div class="section-heading">
      <span class="section-kicker">{t.previewEyebrow}</span>
      <h2 id="dashboard-preview-title">{t.previewTitle}</h2>
      <p>{t.previewText}</p>
    </div>
    <div class="preview-grid">
      {t.previews.map((preview) => (
        <article class="preview-card">
          <figure>
            <img src={preview.image} alt={preview.alt} width="980" height="660" loading="lazy" decoding="async" />
          </figure>
          <h3>{preview.title}</h3>
        </article>
      ))}
    </div>
  </section>

  <section class="tabs-section" aria-labelledby="dashboard-tabs-title">
    <div class="section-heading">
      <span class="section-kicker">{t.tabsEyebrow}</span>
      <h2 id="dashboard-tabs-title">{t.tabsTitle}</h2>
      <p>{t.tabsText}</p>
    </div>
    <div class="tabs-and-funnel">
      <div class="tab-grid">
        {t.tabs.map((tab) => (
          <article>
            <span>{tab.name}</span>
            <p>{tab.text}</p>
          </article>
        ))}
      </div>
      <aside class="funnel-panel" aria-labelledby="dashboard-funnel-title">
        <span class="section-kicker">{t.funnelEyebrow}</span>
        <div class="funnel-list">
          {t.funnel.map((step, index) => (
            <div class="funnel-step">
              <strong>{step.title}</strong>
              <span>{step.text}</span>
              {index < t.funnel.length - 1 && <i class="ph ph-arrow-down" aria-hidden="true"></i>}
            </div>
          ))}
        </div>
        <p id="dashboard-funnel-title">{t.keyMessage}</p>
      </aside>
    </div>
  </section>

  <section class="audience-section" aria-labelledby="dashboard-audience-title">
    <div class="section-heading">
      <span class="section-kicker">{t.audienceEyebrow}</span>
      <h2 id="dashboard-audience-title">{t.audienceTitle}</h2>
    </div>
    <div class="audience-grid">
      {t.audiences.map((audience) => (
        <article>
          <i class="ph ph-users" aria-hidden="true"></i>
          <span>{audience}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="download-section" id="download-dashboard" aria-labelledby="dashboard-download-title">
    <div class="download-copy">
      <span class="section-kicker">{t.downloadEyebrow}</span>
      <h2 id="dashboard-download-title">{t.downloadTitle}</h2>
      <p>{t.downloadText}</p>
      <nav class="internal-links" aria-label={t.internalLabel}>
        {t.internalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>

    <form
      class="download-form"
      action={CONTACT_FORM.action}
      method="post"
      data-dashboard-download-form
      data-download-url={downloadHref}
      data-contact-endpoint={CONTACT_FORM.ajaxAction}
      data-file-name={downloadFilename}
      data-subject={t.subject}
      data-email-field={t.fieldNames.email}
      data-loading-message={t.loading}
      data-success-message={t.success}
      data-error-message={t.error}
      data-trap-success-message={t.trapSuccess}
    >
      <input type="hidden" name="_form" value={t.formName} />
      <input type="hidden" name={isEnglish ? 'Requested resource' : 'Ressource demandée'} value={t.requestedResource} />
      <input type="hidden" name={isEnglish ? 'CRM preparation' : 'Préparation CRM'} value={t.crmMarker} />
      <input type="hidden" name="resource_slug" value="template-dashboard-kpi-marketing-2026" />
      <input type="hidden" name="hubspot_ready" value="true" />
      <label class="form-honeypot" aria-hidden="true">
        Website
        <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
      </label>
      <label>
        <span>{t.fields.name}</span>
        <input type="text" name={t.fieldNames.name} autocomplete="name" required />
      </label>
      <label>
        <span>{t.fields.email}</span>
        <input type="email" name={t.fieldNames.email} autocomplete="email" required />
      </label>
      <label>
        <span>{t.fields.company}</span>
        <input type="text" name={t.fieldNames.company} autocomplete="organization" required />
      </label>
      <label>
        <span>{t.fields.job}</span>
        <input type="text" name={t.fieldNames.job} autocomplete="organization-title" required />
      </label>
      <button type="submit">
        {t.submit}
        <i class="ph ph-download-simple" aria-hidden="true"></i>
      </button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </section>
</div>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-dashboard-download-form]');
    if (!form) return;

    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');
    const setStatus = (state, message) => {
      status.textContent = message;
      status.dataset.state = state;
    };

    const triggerDownload = () => {
      const link = document.createElement('a');
      link.href = form.dataset.downloadUrl;
      link.download = form.dataset.fileName || '';
      document.body.appendChild(link);
      link.click();
      link.remove();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      if (String(formData.get('company_url') || '').trim()) {
        form.reset();
        triggerDownload();
        setStatus('success', form.dataset.trapSuccessMessage || '');
        return;
      }

      const body = new URLSearchParams();
      formData.forEach((value, key) => body.append(key, String(value)));
      body.set('_page', window.location.href);
      body.set('_subject', form.dataset.subject || '');
      body.set('_template', 'table');
      body.set('_captcha', 'false');
      const emailField = form.dataset.emailField || '';
      const email = String(formData.get(emailField) || '').trim();
      if (email) body.set('_replyto', email);

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      setStatus('loading', form.dataset.loadingMessage || '');

      try {
        const response = await fetch(form.dataset.contactEndpoint, {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
          },
          body,
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.error || result.success === false || result.success === 'false') {
          throw new Error(result.message || form.dataset.errorMessage || '');
        }

        triggerDownload();
        form.reset();
        setStatus('success', form.dataset.successMessage || '');
      } catch (error) {
        setStatus('error', error.message || form.dataset.errorMessage || '');
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
      }
    });
  })();
</script>

<style>
  :global(main) {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .template-dashboard-page {
    --purple: #7c3cff;
    --purple-soft: #aa7cff;
    --line: rgba(255, 255, 255, 0.13);
    --muted: rgba(255, 255, 255, 0.66);
    width: min(100% - 3rem, 1240px);
    margin: 0 auto;
    padding: clamp(7rem, 10vw, 9rem) 0 clamp(3rem, 6vw, 5.5rem);
    color: #fff;
    overflow-x: hidden;
  }

  .template-dashboard-page,
  .template-dashboard-page * {
    box-sizing: border-box;
  }

  .template-dashboard-page::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 72% 8%, rgba(124, 60, 255, 0.15), transparent 26rem),
      linear-gradient(rgba(255, 255, 255, 0.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
    background-size: auto, 84px 84px, 84px 84px;
    content: '';
    pointer-events: none;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  .section-kicker {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.65rem;
    color: var(--purple-soft);
    font-size: 1.0625rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-kicker::before {
    width: 2.1rem;
    height: 2px;
    background: linear-gradient(90deg, var(--purple), var(--purple-soft));
    content: '';
  }

  .template-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(430px, 1.04fr);
    gap: clamp(1.4rem, 4vw, 4rem);
    align-items: center;
    min-height: 560px;
  }

  .hero-copy,
  .section-heading,
  .download-copy {
    display: grid;
    gap: 1rem;
  }

  .hero-copy h1 {
    max-width: 790px;
    font-size: clamp(3rem, 5.8vw, 5.45rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .hero-copy p,
  .section-heading p,
  .download-copy p,
  .funnel-panel p {
    max-width: 66ch;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.3vw, 1.15rem);
    line-height: 1.62;
  }

  .file-badge {
    width: fit-content;
    border: 1px solid rgba(170, 124, 255, 0.38);
    border-radius: 999px;
    padding: 0.52rem 0.72rem;
    background: rgba(124, 60, 255, 0.12);
    color: #dfd3ff;
    font-size: 1.0625rem;
    font-weight: 900;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.25rem;
  }

  .button,
  .download-form button {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0 1.15rem;
    color: #fff;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
    cursor: pointer;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .button:hover,
  .button:focus-visible,
  .download-form button:hover,
  .download-form button:focus-visible {
    transform: translateY(-2px);
