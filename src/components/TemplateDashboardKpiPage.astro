  .tabs-section,
  .audience-section,
  .download-section {
    margin-top: clamp(1.7rem, 4vw, 3.4rem);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .preview-card {
    display: grid;
    gap: 0.9rem;
    padding: 0.85rem;
  }

  .preview-card figure {
    display: grid;
    overflow: hidden;
    min-height: 9.8rem;
