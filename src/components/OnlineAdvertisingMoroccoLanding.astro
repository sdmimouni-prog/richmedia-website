<script>
  const dashboards = document.querySelectorAll('[data-media-dashboard]');

  dashboards.forEach((dashboard) => {
    if (!(dashboard instanceof HTMLElement) || dashboard.dataset.ready === 'true') return;
    dashboard.dataset.ready = 'true';

    const reset = () => {
      dashboard.style.setProperty('--mx', '62%');
      dashboard.style.setProperty('--my', '38%');
      dashboard.style.setProperty('--rx', '0deg');
      dashboard.style.setProperty('--ry', '0deg');
    };

    const move = (event: PointerEvent) => {
      const bounds = dashboard.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width;
      const y = (event.clientY - bounds.top) / bounds.height;

      dashboard.style.setProperty('--mx', `${x * 100}%`);
      dashboard.style.setProperty('--my', `${y * 100}%`);
      dashboard.style.setProperty('--rx', `${(0.5 - y) * 4}deg`);
      dashboard.style.setProperty('--ry', `${(x - 0.5) * 5}deg`);
    };

    dashboard.addEventListener('pointermove', move);
    dashboard.addEventListener('pointerleave', reset);
    reset();
  });
</script>

