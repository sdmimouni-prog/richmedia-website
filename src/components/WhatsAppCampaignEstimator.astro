---
import { CONTACT_FORM } from '../consts';

type Lang = 'fr' | 'en';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const isEnglish = lang === 'en';
const locale = isEnglish ? 'en-US' : 'fr-FR';
const WHATSAPP_PUSH_PRICE = 0.8;

const benchmarks = {
  campaigns: 130,
  reading: { min: 0.8, max: 0.95 },
  clicks: { min: 0.08, max: 0.25 },
  replies: { min: 0.03, max: 0.25 },
  conversions: { min: 0.05, max: 0.08 },
  optOut: { min: 0.002, max: 0.02 },
};

const priceLabel = WHATSAPP_PUSH_PRICE.toLocaleString(locale, {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const t = isEnglish
  ? {
      heroEyebrow: 'Richmedia tool',
      title: 'WhatsApp Campaign Estimator',
      intro: 'Estimate your budget, push volume and potential performance for your next WhatsApp campaign.',
      benchmarkNote: `Based on ${benchmarks.campaigns} WhatsApp campaigns analyzed by Richmedia between 2022 and 2026.`,
      start: 'Start estimating',
      methodCta: 'See the method',
      phonePreview: 'WhatsApp campaign preview',
      mediaType: 'Image + video',
      offer: 'Personalized offer',
      button: 'Button',
      offerCta: 'Request an offer',
      crm: 'CRM',
      followUp: 'Tracked reply',
      reading: 'Read',
      click: 'Click',
      benchmarkAria: 'Richmedia WhatsApp benchmarks',
      campaignsAnalyzed: 'campaigns analyzed',
      readOpen: 'read / open',
      perPush: 'per WhatsApp push',
      settingsEyebrow: 'Inputs',
      scenario: 'Your scenario',
      scenarioText: 'Choose your starting point: available budget or audience size.',
      tabAria: 'Calculation mode',
      budgetMode: 'I have a budget',
      audienceMode: 'I have an audience',
      budgetLabel: 'Available budget in MAD',
      audienceLabel: 'Number of contacts to reach',
      budgetHelp: 'Example: 80000',
      audienceHelp: 'Example: 100000',
      priceCaption: 'Richmedia rate',
      calculate: 'Estimate my campaign',
      linksAria: 'Useful links',
      links: [
        { href: '/en/tools/', label: 'Tools & resources' },
        { href: '/en/tools/media-budget-leads-calculator/', label: 'Media Budget & Leads Calculator' },
        { href: '/en/products/whatsapp/', label: 'WhatsApp product' },
        { href: '/en/insights/morocco-digital-marketing-barometer-2026/', label: '2026 Barometer' },
      ],
      resultEyebrow: 'Estimate',
      resultTitle: 'Campaign potential',
      resultText: 'Ranges are independent and applied to the estimated total audience.',
      budgetEstimated: 'Estimated budget',
      pushesEstimated: 'Estimated pushes',
      readings: 'Estimated reads',
      clicks: 'Estimated clicks',
      replies: 'Estimated replies',
      conversions: 'Estimated conversions',
      optOut: 'Estimated opt-out',
      audience: 'Audience',
      methodEyebrow: 'Why WhatsApp',
      methodTitle: 'Why does WhatsApp perform differently from a classic push?',
      methodText:
        'In comparable campaigns observed by Richmedia, WhatsApp generates interaction levels far above traditional SMS pushes.',
      workflowAria: 'WhatsApp journey',
      capabilities: ['Text', 'Images', 'Videos', 'Buttons', 'Location', 'Chatbot', 'Advisor', 'CRM', 'Reporting'],
      requestEyebrow: 'Recommendation',
      requestTitle: 'Preparing a WhatsApp campaign?',
      requestText: 'Receive a personalized recommendation based on your audience, objective and budget.',
      disclaimer: `This estimate uses a rate of ${priceLabel} MAD per WhatsApp push. Projections are based on ranges observed in ${benchmarks.campaigns} Richmedia campaigns between 2022 and 2026. Actual performance depends on audience, message, offer, targeting and conversion journey. The definition of a conversion may vary depending on the campaign objective.`,
      summaryLabel: 'Budget or audience size',
      name: 'Name',
      email: 'Professional email',
      company: 'Company',
      phone: 'Optional phone',
      submit: 'Receive a personalized proposal',
      sending: 'Sending...',
      success: 'Your request has been sent.',
      error: 'Submission failed. Please contact us directly.',
      requiredError: 'Enter a positive value to launch the estimate.',
      inputBudget: 'Entered budget',
      inputAudience: 'Entered audience',
      outputSummary: 'Estimated projection',
      contacts: 'contacts',
    }
  : {
      heroEyebrow: 'Outil Richmedia',
      title: 'Estimateur de campagne WhatsApp',
      intro:
        'Estimez votre budget, votre volume de pushes et les performances potentielles de votre prochaine campagne WhatsApp.',
      benchmarkNote: `Basé sur ${benchmarks.campaigns} campagnes WhatsApp Richmedia analysées entre 2022 et 2026.`,
      start: 'Lancer l’estimation',
      methodCta: 'Voir la méthode',
      phonePreview: 'Aperçu de campagne WhatsApp',
      mediaType: 'Image + vidéo',
      offer: 'Offre personnalisée',
      button: 'Bouton',
      offerCta: 'Demander une offre',
      crm: 'CRM',
      followUp: 'Réponse suivie',
      reading: 'Lecture',
      click: 'Clic',
      benchmarkAria: 'Benchmarks WhatsApp Richmedia',
      campaignsAnalyzed: 'campagnes analysées',
      readOpen: 'lecture / ouverture',
      perPush: 'par push WhatsApp',
      settingsEyebrow: 'Paramètres',
      scenario: 'Votre scénario',
      scenarioText: 'Choisissez votre point de départ : budget disponible ou audience à toucher.',
      tabAria: 'Mode de calcul',
      budgetMode: 'J’ai un budget',
      audienceMode: 'J’ai une audience',
      budgetLabel: 'Budget disponible en MAD',
      audienceLabel: 'Nombre de contacts à toucher',
      budgetHelp: 'Exemple : 80000',
      audienceHelp: 'Exemple : 100000',
      priceCaption: 'Tarif Richmedia',
      calculate: 'Estimer ma campagne',
      linksAria: 'Liens utiles',
      links: [
        { href: '/outils/', label: 'Outils & ressources' },
        { href: '/outils/calculateur-budget-media-leads/', label: 'Calculateur Budget Média & Leads' },
        { href: '/expertises/whatsapp-marketing-maroc/', label: 'Expertise WhatsApp' },
        { href: '/produits/whatsapp/', label: 'Produit WhatsApp' },
        { href: '/insights/barometre-marketing-digital-maroc-2026/', label: 'Baromètre 2026' },
      ],
      resultEyebrow: 'Estimation',
      resultTitle: 'Potentiel de campagne',
      resultText: 'Les fourchettes sont indépendantes et appliquées à l’audience totale estimée.',
      budgetEstimated: 'Budget estimé',
      pushesEstimated: 'Pushes estimés',
      readings: 'Lectures estimées',
      clicks: 'Clics estimés',
      replies: 'Réponses estimées',
      conversions: 'Conversions estimées',
      optOut: 'Opt-out estimé',
      audience: 'Audience',
      methodEyebrow: 'Pourquoi WhatsApp',
      methodTitle: 'Pourquoi WhatsApp performe différemment d’un push classique ?',
      methodText:
        'Dans les campagnes comparables observées par Richmedia, WhatsApp génère des niveaux d’interaction très supérieurs aux pushes SMS traditionnels.',
      workflowAria: 'Parcours WhatsApp',
      capabilities: ['Texte', 'Images', 'Vidéos', 'Boutons', 'Localisation', 'Chatbot', 'Conseiller', 'CRM', 'Reporting'],
      requestEyebrow: 'Recommandation',
      requestTitle: 'Vous préparez une campagne WhatsApp ?',
      requestText: 'Recevez une recommandation personnalisée selon votre audience, votre objectif et votre budget.',
      disclaimer: `Le tarif utilisé pour cette estimation est de ${priceLabel} MAD par push WhatsApp. Les projections sont basées sur les fourchettes observées dans ${benchmarks.campaigns} campagnes Richmedia entre 2022 et 2026. Les performances réelles dépendent notamment de l’audience, du message, de l’offre, du ciblage et du parcours de conversion. La définition d’une conversion peut varier selon l’objectif de la campagne.`,
      summaryLabel: 'Budget ou taille d’audience',
      name: 'Nom',
      email: 'Email professionnel',
      company: 'Entreprise',
      phone: 'Téléphone facultatif',
      submit: 'Recevoir une proposition personnalisée',
      sending: 'Envoi en cours...',
      success: 'Votre demande a bien été envoyée.',
      error: 'L’envoi n’a pas abouti. Merci de nous contacter directement.',
      requiredError: 'Entrez une valeur positive pour lancer l’estimation.',
      inputBudget: 'Budget saisi',
      inputAudience: 'Audience saisie',
      outputSummary: 'Projection estimée',
      contacts: 'contacts',
    };

const workflowSteps = isEnglish
  ? [
      { label: 'Message', icon: 'ph-chat-circle-text' },
      { label: 'Rich media', icon: 'ph-images-square' },
      { label: 'Button', icon: 'ph-cursor-click' },
      { label: 'Interaction', icon: 'ph-sparkle' },
      { label: 'Conversation', icon: 'ph-chat-circle-dots' },
      { label: 'Conversion', icon: 'ph-check-circle' },
    ]
  : [
      { label: 'Message', icon: 'ph-chat-circle-text' },
      { label: 'Média riche', icon: 'ph-images-square' },
      { label: 'Bouton', icon: 'ph-cursor-click' },
      { label: 'Interaction', icon: 'ph-sparkle' },
      { label: 'Conversation', icon: 'ph-chat-circle-dots' },
      { label: 'Conversion', icon: 'ph-check-circle' },
    ];

const estimatorConfig = {
  lang,
  locale,
  price: WHATSAPP_PUSH_PRICE,
  benchmarks,
  labels: {
    budgetMode: t.budgetMode,
    audienceMode: t.audienceMode,
    budgetLabel: t.budgetLabel,
    audienceLabel: t.audienceLabel,
    budgetHelp: t.budgetHelp,
    audienceHelp: t.audienceHelp,
    calculate: t.calculate,
    budgetEstimated: t.budgetEstimated,
    pushesEstimated: t.pushesEstimated,
    readings: t.readings,
    clicks: t.clicks,
    replies: t.replies,
    conversions: t.conversions,
    optOut: t.optOut,
    audience: t.audience,
    requiredError: t.requiredError,
    inputBudget: t.inputBudget,
    inputAudience: t.inputAudience,
    outputSummary: t.outputSummary,
    contacts: t.contacts,
  },
};
---

<div class="whatsapp-estimator" data-whatsapp-estimator lang={lang}>
  <section class="tool-hero" aria-labelledby="whatsapp-estimator-title">
    <div class="hero-copy">
      <span class="section-kicker">{t.heroEyebrow}</span>
      <h1 id="whatsapp-estimator-title">{t.title}</h1>
      <p>{t.intro}</p>
      <small>{t.benchmarkNote}</small>
      <div class="hero-actions">
        <a class="tool-button tool-button-primary" href="#estimation">
          {t.start}
          <i class="ph ph-whatsapp-logo" aria-hidden="true"></i>
        </a>
        <a class="tool-button tool-button-secondary" href="#whatsapp-method">
          {t.methodCta}
          <i class="ph ph-arrow-down" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <aside class="hero-phone" aria-label={t.phonePreview}>
      <div class="phone-shell">
        <div class="phone-top">
          <span></span>
          <strong>WhatsApp Push</strong>
          <i class="ph ph-dots-three-vertical" aria-hidden="true"></i>
        </div>
        <div class="message-stack">
          <div class="chat-card media-card">
            <span>{t.mediaType}</span>
            <strong>{t.offer}</strong>
          </div>
          <div class="chat-card">
            <span>{t.button}</span>
            <strong>{t.offerCta}</strong>
          </div>
          <div class="chat-card compact">
            <span>{t.crm}</span>
            <strong>{t.followUp}</strong>
          </div>
        </div>
        <div class="phone-metrics">
          <article>
            <span>{t.reading}</span>
            <strong>80–95%</strong>
          </article>
          <article>
            <span>{t.click}</span>
            <strong>8–25%</strong>
          </article>
        </div>
      </div>
    </aside>
  </section>

  <section class="benchmark-strip" aria-label={t.benchmarkAria}>
    <article>
      <strong>{benchmarks.campaigns}</strong>
      <span>{t.campaignsAnalyzed}</span>
    </article>
    <article>
      <strong>80–95%</strong>
      <span>{t.readOpen}</span>
    </article>
    <article>
      <strong>8–25%</strong>
      <span>{t.click}</span>
    </article>
    <article>
      <strong>{priceLabel} MAD</strong>
      <span>{t.perPush}</span>
    </article>
  </section>

  <section class="estimator-shell" id="estimation" aria-labelledby="estimator-panel-title">
    <div class="settings-panel">
      <div class="panel-heading">
        <span class="section-kicker">{t.settingsEyebrow}</span>
        <h2 id="estimator-panel-title">{t.scenario}</h2>
        <p>{t.scenarioText}</p>
      </div>

      <div class="mode-tabs" role="tablist" aria-label={t.tabAria}>
        <button class="is-active" type="button" role="tab" aria-selected="true" data-mode-button="budget">
          {t.budgetMode}
        </button>
        <button type="button" role="tab" aria-selected="false" data-mode-button="audience">
          {t.audienceMode}
        </button>
      </div>

      <div class="field-grid">
        <label data-budget-field>
          <span>{t.budgetLabel}</span>
          <input type="number" min="1" step="100" value="80000" inputmode="numeric" data-budget-input />
          <small>{t.budgetHelp}</small>
        </label>

        <label data-audience-field hidden>
          <span>{t.audienceLabel}</span>
          <input type="number" min="1" step="1" value="100000" inputmode="numeric" data-audience-input />
          <small>{t.audienceHelp}</small>
        </label>
      </div>

      <div class="price-card">
        <i class="ph ph-tag" aria-hidden="true"></i>
        <div>
          <strong>{priceLabel} MAD / push</strong>
          <span>{t.priceCaption}</span>
        </div>
      </div>

      <button class="calculate-button" type="button" data-calculate>
        {t.calculate}
        <i class="ph ph-arrow-right" aria-hidden="true"></i>
      </button>
      <p class="calculator-error" data-calculator-error role="alert"></p>

      <nav class="internal-links" aria-label={t.linksAria}>
        {t.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>

    <aside class="result-panel" aria-labelledby="result-title" aria-live="polite">
      <div class="result-head">
        <span class="section-kicker">{t.resultEyebrow}</span>
        <h2 id="result-title">{t.resultTitle}</h2>
        <p>{t.resultText}</p>
      </div>

      <div class="result-topline">
        <article>
          <span>{t.budgetEstimated}</span>
          <strong data-budget-output>80 000 MAD</strong>
        </article>
        <article>
          <span>{t.pushesEstimated}</span>
          <strong data-pushes-output>100 000</strong>
        </article>
      </div>

      <div class="metric-grid">
        <article>
          <i class="ph ph-eye" aria-hidden="true"></i>
          <span>{t.readings}</span>
          <strong data-reading-output>80 000 – 95 000</strong>
        </article>
        <article>
          <i class="ph ph-cursor-click" aria-hidden="true"></i>
          <span>{t.clicks}</span>
          <strong data-clicks-output>8 000 – 25 000</strong>
        </article>
        <article>
          <i class="ph ph-chat-circle-dots" aria-hidden="true"></i>
          <span>{t.replies}</span>
          <strong data-replies-output>3 000 – 25 000</strong>
        </article>
        <article>
          <i class="ph ph-check-circle" aria-hidden="true"></i>
          <span>{t.conversions}</span>
          <strong data-conversions-output>5 000 – 8 000</strong>
        </article>
        <article>
          <i class="ph ph-warning-circle" aria-hidden="true"></i>
          <span>{t.optOut}</span>
          <strong data-optout-output>200 – 2 000</strong>
        </article>
      </div>

      <div class="funnel-visual" aria-label={isEnglish ? 'Campaign potential visualization' : 'Visualisation du potentiel de campagne'}>
        <article>
          <span>{t.audience}</span>
          <strong data-funnel-audience>100 000</strong>
        </article>
        <i class="ph ph-arrow-down" aria-hidden="true"></i>
        <article>
          <span>{t.reading}</span>
          <strong data-funnel-reading>80–95K</strong>
        </article>
        <i class="ph ph-arrow-down" aria-hidden="true"></i>
        <article>
          <span>{t.clicks}</span>
          <strong data-funnel-clicks>8–25K</strong>
        </article>
        <i class="ph ph-arrow-down" aria-hidden="true"></i>
        <article>
          <span>{t.replies}</span>
          <strong data-funnel-replies>3–25K</strong>
        </article>
      </div>
    </aside>
  </section>

  <section class="method-section" id="whatsapp-method" aria-labelledby="method-title">
    <div>
      <span class="section-kicker">{t.methodEyebrow}</span>
      <h2 id="method-title">{t.methodTitle}</h2>
      <p>{t.methodText}</p>
    </div>

    <div class="workflow" aria-label={t.workflowAria}>
      {workflowSteps.map((step) => (
        <article>
          <i class={`ph ${step.icon}`} aria-hidden="true"></i>
          <span>{step.label}</span>
        </article>
      ))}
    </div>

    <div class="capability-grid">
      {t.capabilities.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="estimate-request" aria-labelledby="request-title">
    <div>
      <span class="section-kicker">{t.requestEyebrow}</span>
      <h2 id="request-title">{t.requestTitle}</h2>
      <p>{t.requestText}</p>
      <div class="disclaimer">
        <i class="ph ph-warning-circle" aria-hidden="true"></i>
        <p>{t.disclaimer}</p>
      </div>
    </div>

    <form
      class="estimate-form"
      action={CONTACT_FORM.action}
      method="post"
      data-contact-endpoint={CONTACT_FORM.ajaxAction}
      data-contact-form
      data-sending-message={t.sending}
      data-success-message={t.success}
      data-error-message={t.error}
    >
      <input type="hidden" name="_form" value={isEnglish ? 'WhatsApp Campaign Estimator' : 'Estimateur campagne WhatsApp'} />
      <input type="hidden" name={isEnglish ? 'Calculation mode' : 'Mode de calcul'} data-hidden-mode />
      <input type="hidden" name={isEnglish ? 'Estimated result' : 'Résultat estimé'} data-hidden-result />
      <label class="form-honeypot" aria-hidden="true">
        Website
        <input type="text" name="company_url" tabindex="-1" autocomplete="off" />
      </label>
      <label class="full-field">
        <span>{t.summaryLabel}</span>
        <input type="text" name={isEnglish ? 'Budget or audience' : 'Budget ou audience'} readonly data-summary-input />
      </label>
      <label>
        <span>{t.name}</span>
        <input type="text" name={isEnglish ? 'Name' : 'Nom'} autocomplete="name" required />
      </label>
      <label>
        <span>{t.email}</span>
        <input type="email" name={isEnglish ? 'Professional email' : 'Email professionnel'} autocomplete="email" required />
      </label>
      <label>
        <span>{t.company}</span>
        <input type="text" name={isEnglish ? 'Company' : 'Entreprise'} autocomplete="organization" required />
      </label>
      <label>
        <span>{t.phone}</span>
        <input type="tel" name={isEnglish ? 'Phone' : 'Téléphone'} autocomplete="tel" />
      </label>
      <button type="submit">
        {t.submit}
        <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
      </button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </section>
</div>

<script is:inline define:vars={{ estimatorConfig }}>
  (() => {
    const root = document.querySelector('[data-whatsapp-estimator]');
    if (!root) return;

    const config = estimatorConfig;
    const labels = config.labels;
    const state = { mode: 'budget' };

    const modeButtons = [...root.querySelectorAll('[data-mode-button]')];
    const budgetField = root.querySelector('[data-budget-field]');
    const audienceField = root.querySelector('[data-audience-field]');
    const budgetInput = root.querySelector('[data-budget-input]');
    const audienceInput = root.querySelector('[data-audience-input]');
    const error = root.querySelector('[data-calculator-error]');
    const budgetOutput = root.querySelector('[data-budget-output]');
    const pushesOutput = root.querySelector('[data-pushes-output]');
    const readingOutput = root.querySelector('[data-reading-output]');
    const clicksOutput = root.querySelector('[data-clicks-output]');
    const repliesOutput = root.querySelector('[data-replies-output]');
    const conversionsOutput = root.querySelector('[data-conversions-output]');
    const optOutOutput = root.querySelector('[data-optout-output]');
    const funnelAudience = root.querySelector('[data-funnel-audience]');
    const funnelReading = root.querySelector('[data-funnel-reading]');
    const funnelClicks = root.querySelector('[data-funnel-clicks]');
    const funnelReplies = root.querySelector('[data-funnel-replies]');
    const summaryInput = root.querySelector('[data-summary-input]');
    const hiddenMode = root.querySelector('[data-hidden-mode]');
    const hiddenResult = root.querySelector('[data-hidden-result]');

    const formatter = new Intl.NumberFormat(config.locale || 'fr-FR', { maximumFractionDigits: 0 });
    const keepTogether = (value) => String(value).replace(/[\s\u00a0\u202f]+/g, '\u202f');
    const formatNumber = (value) => keepTogether(formatter.format(Math.max(0, Math.round(value))));
    const formatMad = (value) => `${formatNumber(value)}\u00a0MAD`;
    const formatRange = (min, max) => `${formatNumber(min)} – ${formatNumber(max)}`;
    const formatShort = (value) => {
      const rounded = Math.max(0, Math.round(value));
      return rounded >= 1000 ? `${formatter.format(Math.round(rounded / 1000))}K` : formatter.format(rounded);
    };
    const calculateRange = (audience, range) => ({
      min: audience * range.min,
      max: audience * range.max,
    });

    const setError = (message = '') => {
      error.textContent = message;
    };

    const updateMode = (mode) => {
      state.mode = mode;
      modeButtons.forEach((button) => {
        const active = button.dataset.modeButton === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      budgetField.hidden = mode !== 'budget';
      audienceField.hidden = mode !== 'audience';
      calculate();
    };

    const calculate = () => {
      const enteredBudget = Number(budgetInput.value);
      const enteredAudience = Number(audienceInput.value);
      const sourceValue = state.mode === 'budget' ? enteredBudget : enteredAudience;

      if (!Number.isFinite(sourceValue) || sourceValue <= 0) {
        setError(labels.requiredError);
        return;
      }

      setError();
      const budget = state.mode === 'budget' ? enteredBudget : enteredAudience * config.price;
      const audience = state.mode === 'budget' ? Math.floor(enteredBudget / config.price) : Math.floor(enteredAudience);
      const readings = calculateRange(audience, config.benchmarks.reading);
      const clicks = calculateRange(audience, config.benchmarks.clicks);
      const replies = calculateRange(audience, config.benchmarks.replies);
      const conversions = calculateRange(audience, config.benchmarks.conversions);
      const optOut = calculateRange(audience, config.benchmarks.optOut);

      budgetOutput.textContent = formatMad(budget);
      pushesOutput.textContent = formatNumber(audience);
      readingOutput.textContent = formatRange(readings.min, readings.max);
      clicksOutput.textContent = formatRange(clicks.min, clicks.max);
      repliesOutput.textContent = formatRange(replies.min, replies.max);
      conversionsOutput.textContent = formatRange(conversions.min, conversions.max);
      optOutOutput.textContent = formatRange(optOut.min, optOut.max);
      funnelAudience.textContent = formatNumber(audience);
      funnelReading.textContent = `${formatShort(readings.min)}–${formatShort(readings.max)}`;
      funnelClicks.textContent = `${formatShort(clicks.min)}–${formatShort(clicks.max)}`;
      funnelReplies.textContent = `${formatShort(replies.min)}–${formatShort(replies.max)}`;

      const modeLabel = state.mode === 'budget' ? labels.budgetMode : labels.audienceMode;
      const inputSummary =
        state.mode === 'budget'
          ? `${labels.inputBudget}: ${formatMad(enteredBudget)}`
          : `${labels.inputAudience}: ${formatNumber(enteredAudience)} ${labels.contacts}`;
      const outputSummary = [
        `${labels.budgetEstimated}: ${formatMad(budget)}`,
        `${labels.pushesEstimated}: ${formatNumber(audience)}`,
        `${labels.readings}: ${formatRange(readings.min, readings.max)}`,
        `${labels.clicks}: ${formatRange(clicks.min, clicks.max)}`,
        `${labels.replies}: ${formatRange(replies.min, replies.max)}`,
        `${labels.conversions}: ${formatRange(conversions.min, conversions.max)}`,
        `${labels.optOut}: ${formatRange(optOut.min, optOut.max)}`,
      ].join(' | ');

      summaryInput.value = inputSummary;
      hiddenMode.value = modeLabel;
      hiddenResult.value = outputSummary;
    };

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => updateMode(button.dataset.modeButton));
    });
    [budgetInput, audienceInput].forEach((field) => {
      field.addEventListener('input', calculate);
      field.addEventListener('change', calculate);
    });
    root.querySelector('[data-calculate]')?.addEventListener('click', calculate);

    calculate();
  })();
</script>

