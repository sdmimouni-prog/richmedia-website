const benchmarks = [
  { label: 'CPM', value: '5-18 MAD' },
  { label: 'CPC', value: isEnglish ? '0.4-2.5 MAD' : '0,4-2,5 MAD' },
  { label: 'CTR', value: isEnglish ? '0.8-3.2%' : '0,8-3,2 %' },
